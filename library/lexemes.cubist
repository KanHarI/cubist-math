import nat;
import lists;
use nat;

// Literals read by the library (L2.10c). A numeric token, as 1/2, 2.3 or
// 5i, reaches a notation's literal rule as a Lexeme, the list of its
// characters, and the rule's parser answers with a Parsed value: the
// literal's value, or the position of the character it refuses. The
// translator evaluates the parser; the term it emits holds the lexeme and
// tt as evidence that the parse succeeded, which the kernel checks by
// evaluating the parse itself.

// A literal's characters: a digit by its value, a letter by its place in
// the alphabet, lower or upper case, and . (period), /, _, + and -.
inductive Glyph : U0 {
  digit(value : Nat);
  lower(place : Nat);
  upper(place : Nat);
  period;
  slash;
  underscore;
  plus;
  minus;
}

def Lexeme : U0 := List(U0, Glyph);

// A parse's answer: a value, or the position, from 0, of the character it
// refuses.
inductive Parsed(U < UU0, A : U) : U {
  ok(value : A);
  error(position : Nat);
}

// That a parse succeeded: Unit when it did, Void when it refused, so tt is
// evidence exactly when the parse, evaluated, answers ok.
computable def Succeeded{{U < UU0, A : U}}(p : Parsed(U, A)) : U0 := match p {
    ok(a) => Unit;
    error(k) => Void;
  };

// A parse's answer as a number: 0 when it succeeded, and k + 1 when it
// refused the character at position k. The translator evaluates it, which
// reduces the parse only to its answer, never its value.
computable def parse_answer{{U < UU0, A : U}}(p : Parsed(U, A)) : Nat := match p {
    ok(a) => 0;
    error(k) => succ(k);
  };

// A successful parse's value.
computable def parsed_value{{U < UU0, A : U}}(p : Parsed(U, A), succeeded : Succeeded(p)) :
  A := (match p as q return Succeeded(q) -> A {
      ok(a) => fun (s : Unit) => a;
      error(k) => fun (s : Void) => typed(A, absurd(s));
    })(succeeded);

// The digits at a lexeme's start, _ between them ignored: their value, how
// many there were, and the rest of the lexeme. `value` and `count` hold
// what was read before.
computable def leading_digits(s : Lexeme, value, count : Nat) :
  (Nat and Nat) and Lexeme := match s {
    nil => ((value, count), nil);
    cons(g, rest) => match g {
      digit(d) => leading_digits(rest, add(mul(value, 10), d), succ(count));
      underscore => leading_digits(rest, value, count);
      lower(n) => ((value, count), cons(lower(n), rest));
      upper(n) => ((value, count), cons(upper(n), rest));
      period => ((value, count), cons(period, rest));
      slash => ((value, count), cons(slash, rest));
      plus => ((value, count), cons(plus, rest));
      minus => ((value, count), cons(minus, rest));
    };
  };

// 10^k.
computable def power_of_ten(k : Nat) : Nat := match k {
    zero => 1;
    succ(j) => mul(10, power_of_ten(j));
  };

// A natural number written in decimal digits, 1_000 included.
computable def natural_literal(s : Lexeme) : Parsed(U0, Nat) {
  let read : (Nat and Nat) and Lexeme := leading_digits(s, 0, 0);
  exact match read.2 return Parsed(U0, Nat) {
    nil => ok(read.1.1);
    cons(g, rest) => error(read.1.2);
  };
}
