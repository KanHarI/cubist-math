// Natural-number arithmetic: addition, multiplication and order, with the
// basic laws of addition. The notation `+`, `*`, `<` and `<=` stands for
// `add`, `mul`, `isLt` and `le`, so importing this module enables it.

// Addition, by recursion on the first argument.
// 0 + b = b; succ(a) + b = succ(a + b).
def add(x y : Nat) := induction x as k return Nat {
    zero => y;
    succ h => succ(h);
  };

// Multiplication, by recursion on the first argument.
// 0 * b = 0; succ(a) * b = b + a * b.
def mul(x y : Nat) := induction x as k return Nat {
    zero => 0;
    succ h => (y + h);
  };

// Order, computed: 0 <= b is Unit; succ(a) <= 0 is Void;
// succ(a) <= succ(b) is a <= b.
def le(x : Nat) := induction x as k return (Nat -> U0) {
    zero => (fun (x2 : Nat) => Unit);
    succ h => (fun (y : Nat) => induction y as j return U0 {
        zero => Void;
        succ ignored => h(j);
      });
  };

// Strict order: n < p is succ(n) <= p.
def isLt(n p : Nat) := le(succ(n), p);

// n + 0 = n. Not true by computation, since addition recurses on its first
// argument; proved by induction.
def nat_add_zero(x : Nat) := induction x as k return ((k + 0) = k) {
    zero => refl(0);
    succ h => cong((fun (n : Nat) => succ(n)), h);
  };

// n + succ(m) = succ(n + m).
def nat_add_succ(x : Nat) :=
  induction x as k return (forall y : Nat, ((k + succ(y)) = succ((k + y)))) {
    zero => (fun (y : Nat) => refl(succ(y)));
    succ h => (fun (y : Nat) => cong((fun (n : Nat) => succ(n)), h(y)));
  };

// Addition is associative.
def nat_add_assoc(x : Nat) :=
  induction x as k return (forall y : Nat, (forall z : Nat, (((k + y) + z) = (k + (y + z))))) {
    zero => (fun (y : Nat) => (fun (z : Nat) => refl((y + z))));
    succ h => (fun (y : Nat) => (fun (z : Nat) => cong((fun (n : Nat) => succ(n)), h(y, z))));
  };

// Addition is commutative.
def nat_add_comm(x : Nat) := induction x as k return (forall y : Nat, ((k + y) = (y + k))) {
    zero => (fun (y : Nat) => sym(nat_add_zero(y)));
    succ h => (
      fun (y : Nat) => trans(cong((fun (n : Nat) => succ(n)), h(y)), sym(nat_add_succ(y, k)))
    );
  };

// Order is reflexive.
def nat_le_refl(n : Nat) := induction n as k return (k <= k) {
    zero => tt;
    succ h => h;
  };
