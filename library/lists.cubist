import naturals;

// Lists: finite sequences of elements of a type, in any universe below UU0,
// with their length and concatenation. Concatenation is associative with
// the empty list as its unit, and length turns it into addition.

inductive List(U < UU0, A : U) : U {
  nil;
  cons(head : A, tail : List(U, A));
}

// The number of elements.
computable def length(U < UU0, A : U, xs : List(U, A)) : Nat := induction xs return Nat {
    nil => 0;
    cons(head, tail, n) => succ(n);
  };

// The elements of xs, then those of ys; by recursion on xs.
computable def append(U < UU0, A : U, xs, ys : List(U, A)) :
  List(U, A) := induction xs return List(U, A) {
    nil => ys;
    cons(head, tail, rest) => cons(head, rest);
  };

// nil is a unit on the left by computation, and on the right by induction.
computable def nil_append(U < UU0, A : U, ys : List(U, A)) : append(U, A, nil, ys) = ys := refl(ys);

computable def append_nil(U < UU0, A : U, xs : List(U, A)) : append(U, A, xs, nil) = xs {
  induction xs {
    nil => {
      rfl;
    }
    cons(head, tail, ih) => {
      exact cong(fun (rest : List(U, A)) => typed(List(U, A), cons(head, rest)), ih);
    }
  }
}

computable def append_assoc(U < UU0, A : U, xs, ys, zs : List(U, A)) :
  append(U, A, append(U, A, xs, ys), zs) = append(U, A, xs, append(U, A, ys, zs)) {
  induction xs {
    nil => {
      rfl;
    }
    cons(head, tail, ih) => {
      exact cong(fun (rest : List(U, A)) => typed(List(U, A), cons(head, rest)), ih);
    }
  }
}

computable def length_append(U < UU0, A : U, xs, ys : List(U, A)) :
  length(U, A, append(U, A, xs, ys)) = length(U, A, xs) + length(U, A, ys) {
  induction xs {
    nil => {
      rfl;
    }
    cons(head, tail, ih) => {
      exact cong(succ, ih);
    }
  }
}
