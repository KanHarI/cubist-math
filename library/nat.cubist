// The natural numbers: Nat, its addition, multiplication and order, and
// the laws of addition and multiplication. A module that uses them,
// numerals included, imports nat. `+`, `*`, `<` and `<=` stand for `add`,
// `mul`, `isLt` and `le`.
inductive Nat : U0 {
  zero;
  succ(n : Nat);
}

// Addition, by recursion on the first argument: 0 + b = b and
// succ(a) + b = succ(a + b).
computable def add(x, y : Nat) : Nat := match x {
    zero => y;
    succ(k) => succ(add(k, y));
  };

// Multiplication: 0 * b = 0 and succ(a) * b = b + a * b.
computable def mul(x, y : Nat) : Nat := match x {
    zero => 0;
    succ(k) => y + mul(k, y);
  };

// Order, computed: 0 <= b holds, succ(a) <= 0 does not, and
// succ(a) <= succ(b) is a <= b.
computable def le(x, y : Nat) : U0 := match x, y {
    zero, _ => Unit;
    succ(a), zero => Void;
    succ(a), succ(b) => le(a, b);
  };

// Strict order: n < p is succ(n) <= p.
computable def isLt(n, p : Nat) : U0 := le(succ(n), p);

// The natural numbers' notation (L2.10a): use nat; or nat.(e) selects it.
notation nat {
  x + y := add(x, y);
  x * y := mul(x, y);
  x <= y := le(x, y);
  x < y := isLt(x, y);
}

// 0 + n = n, by computation.
computable def nat_zero_add(n : Nat) : 0 + n = n := refl(n);

// n + 0 = n, by induction, since addition recurses on its first argument.
computable def nat_add_zero(n : Nat) : n + 0 = n := match n {
    zero => refl(0);
    succ(k) => cong(fun (m : Nat) => succ(m), nat_add_zero(k));
  };

// n + succ(m) = succ(n + m).
computable def nat_add_succ(x, y : Nat) : x + succ(y) = succ(x + y) := match x {
    zero => refl(succ(y));
    succ(k) => cong(fun (m : Nat) => succ(m), nat_add_succ(k, y));
  };

// Addition is associative.
computable def nat_add_assoc(x, y, z : Nat) : (x + y) + z = x + (y + z) := match x {
    zero => refl(y + z);
    succ(k) => cong(fun (m : Nat) => succ(m), nat_add_assoc(k, y, z));
  };

// Addition is commutative.
computable def nat_add_comm(x, y : Nat) : x + y = y + x := match x {
    zero => sym(nat_add_zero(y));
    succ(k) => trans(cong(fun (m : Nat) => succ(m), nat_add_comm(k, y)), sym(nat_add_succ(y, k)));
  };

// a + (b + c) = b + (a + c).
computable def nat_add_left_comm(a, b, c : Nat) : a + (b + c) = b + (a + c) {
  calc {
    a + (b + c) = (a + b) + c by sym(nat_add_assoc(a, b, c));
    _ = (b + a) + c by cong(fun (m : Nat) => m + c, nat_add_comm(a, b));
    _ = b + (a + c) by nat_add_assoc(b, a, c);
  }
}

// (a + b) + (c + d) = (a + c) + (b + d): the middle two trade places.
computable def nat_add_interchange(a, b, c, d : Nat) : (a + b) + (c + d) = (a + c) + (b + d) {
  calc {
    (a + b) + (c + d) = a + (b + (c + d)) by nat_add_assoc(a, b, c + d);
    _ = a + (c + (b + d)) by cong(fun (m : Nat) => a + m, nat_add_left_comm(b, c, d));
    _ = (a + c) + (b + d) by sym(nat_add_assoc(a, c, b + d));
  }
}

// The predecessor: pred(0) = 0 and pred(succ(n)) = n.
computable def pred(n : Nat) : Nat := match n {
    zero => 0;
    succ(k) => k;
  };

// succ is injective: equal successors have equal predecessors.
computable def nat_succ_injective(x, y : Nat, p : succ(x) = succ(y)) : x = y := cong(pred, p);

// 0 is no successor: nat_is_zero holds at 0 and fails at every successor,
// so a path from 0 to a successor carries tt to an element of Void.
computable def nat_is_zero(n : Nat) : U0 := match n {
    zero => Unit;
    succ(k) => Void;
  };

computable def nat_zero_ne_succ(n : Nat, p : 0 = succ(n)) :
  Void := comp(fun (i : Interval) => nat_is_zero(p @ i), tt);

// Addition cancels: k + x = k + y gives x = y.
computable def nat_add_cancel(k, x, y : Nat, p : k + x = k + y) : x = y := match k {
    zero => p;
    succ(j) => nat_add_cancel(j, x, y, nat_succ_injective(j + x, j + y, p));
  };

// n * 0 = 0, since 0 * b = 0 and succ(a) * 0 = 0 + a * 0.
computable def nat_mul_zero(n : Nat) : n * 0 = 0 := match n {
    zero => refl(0);
    succ(k) => nat_mul_zero(k);
  };

// n * succ(m) = n + n * m: both are succ(m) added n times, regrouped.
computable def nat_mul_succ(x, y : Nat) : x * succ(y) = x + x * y {
  match x {
    zero => {
      rfl;
    }
    succ(k) => {
      calc {
        succ(y + k * succ(y)) = succ(y + (k + k * y)) by cong(
          fun (m : Nat) => succ(y + m), nat_mul_succ(k, y)
        );
        _ = succ((y + k) + k * y) by cong(fun (m : Nat) => succ(m), sym(nat_add_assoc(y, k, k * y)));
        _ = succ((k + y) + k * y) by cong(fun (m : Nat) => succ(m + k * y), nat_add_comm(y, k));
        _ = succ(k + (y + k * y)) by cong(fun (m : Nat) => succ(m), nat_add_assoc(k, y, k * y));
      }
    }
  }
}

// 1 is a unit for multiplication on both sides.
computable def nat_one_mul(n : Nat) : 1 * n = n := nat_add_zero(n);

computable def nat_mul_one(n : Nat) : n * 1 = n {
  calc {
    n * 1 = n + n * 0 by nat_mul_succ(n, 0);
    _ = n + 0 by cong(fun (m : Nat) => n + m, nat_mul_zero(n));
    _ = n by nat_add_zero(n);
  }
}

// Multiplication is commutative.
computable def nat_mul_comm(x, y : Nat) : x * y = y * x := match x {
    zero => sym(nat_mul_zero(y));
    succ(k) => trans(cong(fun (m : Nat) => y + m, nat_mul_comm(k, y)), sym(nat_mul_succ(y, k)));
  };

// Multiplication distributes over addition, on the right and on the left.
computable def nat_add_mul(x, y, z : Nat) : (x + y) * z = x * z + y * z {
  match x {
    zero => {
      rfl;
    }
    succ(k) => {
      calc {
        z + (k + y) * z = z + (k * z + y * z) by cong(fun (m : Nat) => z + m, nat_add_mul(k, y, z));
        _ = (z + k * z) + y * z by sym(nat_add_assoc(z, k * z, y * z));
      }
    }
  }
}

computable def nat_mul_add(x, y, z : Nat) : x * (y + z) = x * y + x * z {
  calc {
    x * (y + z) = (y + z) * x by nat_mul_comm(x, y + z);
    _ = y * x + z * x by nat_add_mul(y, z, x);
    _ = x * y + z * x by cong(fun (m : Nat) => m + z * x, nat_mul_comm(y, x));
    _ = x * y + x * z by cong(fun (m : Nat) => x * y + m, nat_mul_comm(z, x));
  }
}

// Multiplication is associative.
computable def nat_mul_assoc(x, y, z : Nat) : (x * y) * z = x * (y * z) {
  match x {
    zero => {
      rfl;
    }
    succ(k) => {
      calc {
        (y + k * y) * z = y * z + (k * y) * z by nat_add_mul(y, k * y, z);
        _ = y * z + k * (y * z) by cong(fun (m : Nat) => y * z + m, nat_mul_assoc(k, y, z));
      }
    }
  }
}

// Multiplication by a successor cancels.
computable def nat_mul_cancel(k, x, y : Nat, p : x * succ(k) = y * succ(k)) : x = y := match x, y {
    zero, zero => refl(0);
    zero, succ(j) => absurd(nat_zero_ne_succ(k + j * succ(k), p));
    succ(i), zero => absurd(nat_zero_ne_succ(k + i * succ(k), sym(p)));
    succ(i),
    succ(j) => cong(
      fun (m : Nat) => succ(m),
      nat_mul_cancel(k, i, j, nat_add_cancel(succ(k), i * succ(k), j * succ(k), p))
    );
  };

// Of two naturals, the first exceeds the second, they are equal, or the
// second exceeds the first, each by a successor that the evidence names.
def Trichotomy(a, b : Nat) :
  U0 := (exists t : Nat. a = b + succ(t)) or ((a = b) or (exists t : Nat. b = a + succ(t)));

computable def nat_trichotomy(a, b : Nat) : Trichotomy(a, b) := match a, b {
    zero, zero => right(left(refl(0)));
    zero, succ(j) => right(right((j, refl(succ(j)))));
    succ(i), zero => left((i, refl(succ(i))));
    succ(i), succ(j) => match nat_trichotomy(i, j) return Trichotomy(succ(i), succ(j)) {
      left above => left((above.1, cong(fun (m : Nat) => succ(m), above.2)));
      right rest => match rest return Trichotomy(succ(i), succ(j)) {
        left same => right(left(cong(fun (m : Nat) => succ(m), same)));
        right below => right(right((below.1, cong(fun (m : Nat) => succ(m), below.2))));
      };
    };
  };

// Order is reflexive.
computable def nat_le_refl(n : Nat) : n <= n := match n {
    zero => tt;
    succ(k) => nat_le_refl(k);
  };
