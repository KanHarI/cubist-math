// Public natural numbers use the canonical binary carrier. Structural
// zero/successor clients import unat explicitly; dependent numerical
// recursion uses the checked Peano or strong-recursion views below.
import bnat_notation;
import bnat_recursion;

def Nat : U0 := BNat;

computable def zero : Nat := b_zero;

computable def succ(n : Nat) : Nat := bnat_succ(n);

computable def pred(n : Nat) : Nat := bnat_pred(n);

computable def add(a, b : Nat) : Nat := bnat_add(a, b);

computable def mul(a, b : Nat) : Nat := bnat_mul(a, b);

computable def le(a, b : Nat) : U0 := bnat_le(a, b);

computable def isLt(a, b : Nat) : U0 := bnat_lt(a, b);

notation nat {
  x + y := add(x, y);
  x * y := mul(x, y);
  x <= y := le(x, y);
  x < y := isLt(x, y);
  literal(s : Lexeme) := bnat_literal(s);
}

use nat;

// State public laws in this notation so rewriting sees the same heads and
// literals as a user's goal. Their binary proofs check by conversion.
computable def nat_zero_add(n : Nat) : 0 + n = n := bnat_zero_add(n);

computable def nat_add_zero(n : Nat) : n + 0 = n := bnat_add_zero(n);

computable def nat_add_assoc(a, b, c : Nat) : (a + b) + c = a + (b + c) := bnat_add_assoc(a, b, c);

computable def nat_add_comm(a, b : Nat) : a + b = b + a := bnat_add_comm(a, b);

computable def nat_add_cancel(k, a, b : Nat, p : k + a = k + b) :
  a = b := bnat_add_cancel(k, a, b, p);

computable def nat_mul_zero(n : Nat) : n * 0 = 0 := bnat_mul_zero(n);

computable def nat_one_mul(n : Nat) : 1 * n = n := bnat_one_mul(n);

computable def nat_mul_one(n : Nat) : n * 1 = n := bnat_mul_one(n);

computable def nat_mul_comm(a, b : Nat) : a * b = b * a := bnat_mul_comm(a, b);

computable def nat_mul_assoc(a, b, c : Nat) : (a * b) * c = a * (b * c) := bnat_mul_assoc(a, b, c);

computable def nat_mul_add(a, b, c : Nat) : a * (b + c) = a * b + a * c := bnat_mul_add(a, b, c);

computable def nat_add_mul(a, b, c : Nat) : (a + b) * c = a * c + b * c {
  calc {
    (a + b) * c = c * (a + b) by nat_mul_comm(a + b, c);
    _ = c * a + c * b by nat_mul_add(c, a, b);
    _ = a * c + c * b by cong(fun (x : Nat) => x + c * b, nat_mul_comm(c, a));
    _ = a * c + b * c by cong(fun (x : Nat) => a * c + x, nat_mul_comm(c, b));
  }
}

// succ(a) * b = a * b + b.
computable def nat_succ_mul(a, b : Nat) : succ(a) * b = a * b + b {
  calc {
    succ(a) * b = (a + 1) * b by cong(fun (x : Nat) => x * b, bnat_succ_offset(a));
    _ = a * b + 1 * b by nat_add_mul(a, 1, b);
    _ = a * b + b by cong(fun (x : Nat) => a * b + x, nat_one_mul(b));
  }
}

// Sums regroup: (a + b) + (c + d) = (a + c) + (b + d).
computable def nat_add_interchange(a, b, c, d : Nat) : (a + b) + (c + d) = (a + c) + (b + d) {
  calc {
    (a + b) + (c + d) = a + (b + (c + d)) by nat_add_assoc(a, b, c + d);
    _ = a + ((b + c) + d) by cong(fun (x : Nat) => a + x, sym(nat_add_assoc(b, c, d)));
    _ = a + ((c + b) + d) by cong(fun (x : Nat) => a + (x + d), nat_add_comm(b, c));
    _ = a + (c + (b + d)) by cong(fun (x : Nat) => a + x, nat_add_assoc(c, b, d));
    _ = (a + c) + (b + d) by sym(nat_add_assoc(a, c, b + d));
  }
}

computable def nat_zero_ne_succ(n : Nat, p : 0 = succ(n)) : Void := bnat_zero_ne_succ(n, p);

computable def nat_succ_injective(a, b : Nat, p : succ(a) = succ(b)) :
  a = b := trans(sym(bnat_pred_succ(a)), trans(cong(bnat_pred, p), bnat_pred_succ(b)));

computable def nat_mul_cancel(k, a, b : Nat, nz : k = 0 -> Void, p : a * k = b * k) :
  a = b := bnat_mul_cancel(k, a, b, nz, p);

computable def nat_decide := bnat_decide;

computable def nat_is_set := bnat_is_set;

computable def nat_peano := bnat_peano;

computable def nat_peano_zero(
  U < UU0, P : Nat -> U, z : P(zero), step : (forall n : Nat. P(n) -> P(succ(n)))
) :
  nat_peano(U, P, z, step, zero) = z := bnat_peano_zero(U, P, z, step);

computable def nat_peano_succ(
  U < UU0, P : Nat -> U, z : P(zero), step : (forall n : Nat. P(n) -> P(succ(n))), n : Nat
) :
  nat_peano(U, P, z, step, succ(n)) = step(n, nat_peano(U, P, z, step, n)) := bnat_peano_succ(
    U, P, z, step, n
  );

computable def NatBelow := BNatBelow;

computable def nat_strong_recursion := bnat_strong_recursion;

computable def nat_strong_recursion_equation(
  U < UU0, P : Nat -> U, step : (forall n : Nat. NatBelow(U, P, n) -> P(n)), n : Nat
) :
  nat_strong_recursion(U, P, step, n) = step(
    n, fun (m : Nat, smaller : m < n) => nat_strong_recursion(U, P, step, m)
  ) := bnat_strong_recursion_equation(U, P, step, n);

computable def factorial := bnat_factorial;

computable def nat_factorial_zero : factorial(0) = 1 := bnat_factorial_zero;

computable def nat_factorial_succ(n : Nat) :
  factorial(succ(n)) = succ(n) * factorial(n) := bnat_factorial_succ(n);

hlevel_rule nat_is_set;
