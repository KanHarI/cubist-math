// Public natural numbers use the canonical binary carrier. Structural
// zero/successor clients import unat explicitly; dependent numerical
// recursion uses the checked Peano or strong-recursion views below.
import bnat_notation;
import bnat_recursion;

def Nat : U0 := BNat;

computable def zero : Nat := b_zero;

computable def succ(n : Nat) : Nat := bnat_succ(n);

computable def pred(n : Nat) : Nat := bnat_pred(n);

computable def add(a, b : Nat) : Nat := bnat_add(a, b);

computable def mul(a, b : Nat) : Nat := bnat_mul(a, b);

computable def le(a, b : Nat) : U0 := bnat_le(a, b);

computable def isLt(a, b : Nat) : U0 := bnat_lt(a, b);

notation nat {
  x + y := add(x, y);
  x * y := mul(x, y);
  x <= y := le(x, y);
  x < y := isLt(x, y);
  literal(s : Lexeme) := bnat_literal(s);
}

computable def nat_zero_add := bnat_zero_add;

computable def nat_add_zero := bnat_add_zero;

computable def nat_add_assoc := bnat_add_assoc;

computable def nat_add_comm := bnat_add_comm;

computable def nat_add_cancel := bnat_add_cancel;

computable def nat_mul_zero := bnat_mul_zero;

computable def nat_one_mul := bnat_one_mul;

computable def nat_mul_one := bnat_mul_one;

computable def nat_mul_comm := bnat_mul_comm;

computable def nat_mul_assoc := bnat_mul_assoc;

computable def nat_mul_add := bnat_mul_add;

computable def nat_zero_ne_succ := bnat_zero_ne_succ;

computable def nat_mul_cancel := bnat_mul_cancel;

computable def nat_decide := bnat_decide;

computable def nat_is_set := bnat_is_set;

computable def nat_peano := bnat_peano;

computable def nat_peano_zero := bnat_peano_zero;

computable def nat_peano_succ := bnat_peano_succ;

computable def NatBelow := BNatBelow;

computable def nat_strong_recursion := bnat_strong_recursion;

computable def nat_strong_recursion_equation := bnat_strong_recursion_equation;

computable def factorial := bnat_factorial;

computable def nat_factorial_zero := bnat_factorial_zero;

computable def nat_factorial_succ := bnat_factorial_succ;

hlevel_rule nat_is_set;
