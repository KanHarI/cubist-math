import finite_sets;
use nat;

def Binary : U0 := Fin(2);

// Both bounds compute to Unit, so tt proves 0 < 2 and 1 < 2.
computable def False : Binary := (0, tt);

computable def True : Binary := (1, tt);

// A Binary's natural-number component is either zero or positive.
// Its bound excludes every positive value except one.
computable def Not(x : Binary) : Binary := match x.1 {
    b_zero => True;
    b_positive(p) => False;
  };

computable def And(x, y : Binary) : Binary := match x.1 {
    b_zero => False;
    b_positive(p) => y;
  };

computable def Or(x, y : Binary) : Binary := match x.1 {
    b_zero => y;
    b_positive(p) => True;
  };

computable def Xor(x, y : Binary) : Binary := match x.1 {
    b_zero => y;
    b_positive(p) => Not(y);
  };

computable def Nor(x, y : Binary) : Binary := Not(Or(x, y));

// False and True are different, and every Binary is one of them.
computable def false_ne_true(p : False = True) :
  Void := nat_zero_ne_succ(0, cong(fun (x : Binary) => x.1, p));

computable def binary_cases(x : Binary) :
  (x = True)
  or (x = False) := match bnat_lt_succ_cases(x.1, 1, x.2) return ((x = True) or (x = False)) {
    left below => match bnat_lt_succ_cases(x.1, 0, below) return ((x = True) or (x = False)) {
      left none => absurd(bnat_lt_zero(x.1, none));
      right zero_ => right(fin_path(2, x, False, zero_));
    };
    right one => left(fin_path(2, x, True, one));
  };
