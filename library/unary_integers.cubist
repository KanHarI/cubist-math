import differences;
import unat_models;
use unat;

// The unary compatibility integers instantiate the shared difference ring
// over UNat. The public integers are binary; structural unary clients
// import this module and use UInt and its uint_ names.

def UIntSameDifference(p, q : UNat and UNat) :
  U0 := DifferenceRelation{{U0}}(unat_semiring, unat_decide, unat_add_cancel, p, q);

computable def uint_same_difference_props(p, q : UNat and UNat) :
  IsProp(U0, UIntSameDifference(p, q)) := difference_same_difference_props{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q
  );

computable def uint_same_difference_refl(p : UNat and UNat) :
  UIntSameDifference(p, p) := difference_same_difference_refl{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p
  );

computable def uint_same_difference_sym(p, q : UNat and UNat, r : UIntSameDifference(p, q)) :
  UIntSameDifference(q, p) := difference_same_difference_sym{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, r
  );

computable def uint_same_difference_trans(
  p, q, s : UNat and UNat, r : UIntSameDifference(p, q), t : UIntSameDifference(q, s)
) :
  UIntSameDifference(p, s) := difference_same_difference_trans{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, s, r, t
  );

def UInt : U0 := Difference{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def uint_is_set :
  IsSet(U0, UInt) := difference_is_set{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def uint(a, b : UNat) :
  UInt := difference{{U0}}(unat_semiring, unat_decide, unat_add_cancel, a, b);

computable def uint_path(p, q : UNat and UNat, r : UIntSameDifference(p, q)) :
  typed(UInt, class(p)) = typed(UInt, class(q)) := difference_path{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, r
  );

computable def uint_pairs(p, q : UNat and UNat, e : p = q) :
  typed(UInt, class(p)) = typed(UInt, class(q)) := difference_pairs{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, e
  );

computable def uint_induction(
  P : UInt -> U0, props : (forall z : UInt. IsProp(U0, P(z))),
  f : (forall p : UNat and UNat. P(class(p))), z : UInt
) :
  P(z) := difference_induction{{U0}}(unat_semiring, unat_decide, unat_add_cancel, P, props, f, z);

computable def uint_zero :
  UInt := difference_zero{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def uint_one : UInt := difference_one{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def uint_neg(x : UInt) :
  UInt := difference_neg{{U0}}(unat_semiring, unat_decide, unat_add_cancel, x);

computable def uint_add_pairs(p, q : UNat and UNat) :
  UNat and UNat := difference_add_pairs{{U0}}(unat_semiring, unat_decide, unat_add_cancel, p, q);

computable def uint_add_pairs_left(p, s, q : UNat and UNat, r : UIntSameDifference(p, s)) :
  UIntSameDifference(uint_add_pairs(p, q), uint_add_pairs(s, q)) := difference_add_pairs_left{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, s, q, r
  );

computable def uint_add_pairs_comm(p, q : UNat and UNat) :
  uint_add_pairs(p, q) = uint_add_pairs(q, p) := difference_add_pairs_comm{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q
  );

computable def uint_add(x, y : UInt) :
  UInt := difference_add{{U0}}(unat_semiring, unat_decide, unat_add_cancel, x, y);

computable def uint_mul_pairs(p, q : UNat and UNat) :
  UNat and UNat := difference_mul_pairs{{U0}}(unat_semiring, unat_decide, unat_add_cancel, p, q);

computable def uint_mul_pairs_left(p, s, q : UNat and UNat, r : UIntSameDifference(p, s)) :
  UIntSameDifference(uint_mul_pairs(p, q), uint_mul_pairs(s, q)) := difference_mul_pairs_left{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, s, q, r
  );

computable def uint_mul_pairs_comm(p, q : UNat and UNat) :
  uint_mul_pairs(p, q) = uint_mul_pairs(q, p) := difference_mul_pairs_comm{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q
  );

computable def uint_mul(x, y : UInt) :
  UInt := difference_mul{{U0}}(unat_semiring, unat_decide, unat_add_cancel, x, y);

computable def uint_equation(
  f, g : UInt -> UInt, e : (forall p : UNat and UNat. f(class(p)) = g(class(p))), x : UInt
) :
  f(x) = g(x) := difference_equation{{U0}}(unat_semiring, unat_decide, unat_add_cancel, f, g, e, x);

computable def uint_equation2(
  f, g : UInt -> UInt -> UInt,
  e : (forall p, q : UNat and UNat. f(class(p), class(q)) = g(class(p), class(q))), x, y : UInt
) :
  f(x, y) = g(x, y) := difference_equation2{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, f, g, e, x, y
  );

computable def uint_equation3(
  f, g : UInt -> UInt -> UInt -> UInt,
  e : (
    forall p, q, s : UNat and UNat.
    f(class(p), class(q), class(s)) = g(class(p), class(q), class(s))
  ), x, y, z : UInt
) :
  f(x, y, z) = g(x, y, z) := difference_equation3{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, f, g, e, x, y, z
  );

computable def uint_add_assoc(x, y, z : UInt) :
  uint_add(uint_add(x, y), z) = uint_add(x, uint_add(y, z)) := difference_add_assoc{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y, z
  );

computable def uint_add_comm(x, y : UInt) :
  uint_add(x, y) = uint_add(y, x) := difference_add_comm{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y
  );

computable def uint_zero_add(x : UInt) : uint_add(uint_zero, x) = x := difference_zero_add{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def uint_add_zero(x : UInt) : uint_add(x, uint_zero) = x := difference_add_zero{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def uint_neg_add(x : UInt) :
  uint_add(uint_neg(x), x) = uint_zero := difference_neg_add{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x
  );

computable def uint_add_neg(x : UInt) :
  uint_add(x, uint_neg(x)) = uint_zero := difference_add_neg{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x
  );

computable def uint_pairs_mul_assoc(a, b, c, d, e, f : UNat) :
  (a * c + b * d) * e + (a * d + b * c) * f = a * (c * e + d * f) + b * (c * f + d * e) := difference_pairs_mul_assoc{{
    U0
  }}(unat_semiring, unat_decide, unat_add_cancel, a, b, c, d, e, f);

computable def uint_pairs_mul_add(a, b, c, d, e, f : UNat) :
  a * (c + e) + b * (d + f) = (a * c + b * d) + (a * e + b * f) := difference_pairs_mul_add{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, a, b, c, d, e, f
  );

computable def uint_mul_assoc(x, y, z : UInt) :
  uint_mul(uint_mul(x, y), z) = uint_mul(x, uint_mul(y, z)) := difference_mul_assoc{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y, z
  );

computable def uint_mul_comm(x, y : UInt) :
  uint_mul(x, y) = uint_mul(y, x) := difference_mul_comm{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y
  );

computable def uint_one_mul(x : UInt) : uint_mul(uint_one, x) = x := difference_one_mul{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def uint_mul_one(x : UInt) : uint_mul(x, uint_one) = x := difference_mul_one{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def uint_mul_add(x, y, z : UInt) :
  uint_mul(x, uint_add(y, z)) = uint_add(uint_mul(x, y), uint_mul(x, z)) := difference_mul_add{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y, z
  );

computable def uint_decide(x, y : UInt) : Decidable(U0, x = y) := difference_decide{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x, y
);

def unary_integers :
  CommRing(U0) := difference_ring{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

// Supply the natural-semiring hypotheses for the shared domain proof.
computable def uint_natural_mul_cancel(k, a, b : UNat, nonzero : k = 0 -> Void, p : a * k = b * k) :
  a = b := match k {
    zero => absurd(nonzero(refl(0)));
    succ(s) => unat_mul_cancel(s, a, b, p);
  };

computable def uint_natural_trichotomy(a, b : UNat) :
  DifferenceTrichotomy{{U0}}(unat_semiring, unat_decide, unat_add_cancel, a, b) := match unat_trichotomy(
    a, b
  ) return DifferenceTrichotomy{{U0}}(unat_semiring, unat_decide, unat_add_cancel, a, b) {
    left above => left(
      (succ(above.1), above.2, fun (p : succ(above.1) = 0) => unat_zero_ne_succ(above.1, sym(p)))
    );
    right rest => match rest return DifferenceTrichotomy{{U0}}(
      unat_semiring, unat_decide, unat_add_cancel, a, b
    ) {
      left same => right(left(same));
      right below => right(
        right(
          (
            succ(below.1), below.2,
            fun (p : succ(below.1) = 0) => unat_zero_ne_succ(below.1, sym(p))
          )
        )
      );
    };
  };

// The unary domain statements are instances of the shared proof.
computable def uint_pairs_product_cancel(
  b, s, c, d : UNat, h : (b + succ(s)) * c + b * d = (b + succ(s)) * d + b * c
) :
  c = d := difference_pairs_product_cancel{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, uint_natural_mul_cancel, b, succ(s), c, d,
    fun (p : succ(s) = 0) => unat_zero_ne_succ(s, sym(p)), h
  );

computable def uint_zero_divisors(
  p, q : UNat and UNat, np : typed(UInt, class(p)) = uint_zero -> Void,
  nq : typed(UInt, class(q)) = uint_zero -> Void,
  r : UIntSameDifference(uint_mul_pairs(p, q), (0, 0))
) :
  Void := difference_zero_divisors{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, uint_natural_mul_cancel, uint_natural_trichotomy,
    p, q, np, nq, r
  );

computable def uint_mul_nonzero(
  x, y : UInt, nx : x = uint_zero -> Void, ny : y = uint_zero -> Void,
  p : uint_mul(x, y) = uint_zero
) :
  Void := difference_mul_nonzero{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, uint_natural_mul_cancel, uint_natural_trichotomy,
    x, y, nx, ny, p
  );

// The shared construction keeps zero and one distinct.
computable def uint_zero_ne_one(p : uint_zero = uint_one) : Void := difference_zero_ne_one{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, fun (e : 0 = 1) => unat_zero_ne_succ(0, e), p
);

// The unary integers' numerals (L2.10c): unary_integers.(2) is uint(2, 0).
notation unary_integers {
  numeral(n : UNat) := uint(n, 0);
}
