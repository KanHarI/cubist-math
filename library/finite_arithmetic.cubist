// Sums and products of finite types. Fin(a) or Fin(b) is equivalent to
// Fin(a + b), with the second summand's j at a + j; Fin(a) and Fin(b) is
// equivalent to Fin(a * b), with the pair (i, j) at i * b + j. Both by
// Peano recursion, adding one top element at a time; so finite types are
// closed under sums and products, with the sizes adding and multiplying.
import finite_cardinality;
import nat;
use nat;

computable def FinSum(a, b : Nat) : U0 := ContrEquiv(U0, Fin(a) or Fin(b), Fin(a + b));

computable def fin_sum_zero(a : Nat) : FinSum(a, 0) := equiv_compose(
  U0, Fin(a) or Fin(0), Fin(a), Fin(a + 0), sum_empty_right(U0, Fin(a), Fin(0), fin_zero_empty),
  fin_cast(a, a + 0, sym(nat_add_zero(a)))
);

// Fin(a) or Fin(b + 1), as (Fin(a) or Fin(b)) with one more point, the
// top element a + b.
computable def fin_sum_succ(a, b : Nat, previous : FinSum(a, b)) : FinSum(a, succ(b)) {
  let split := sum_equiv(
    U0, Fin(a), Fin(succ(b)), Fin(a), Fin(b) or Unit, id_contr_equiv(U0, Fin(a)),
    equiv_symm(U0, Fin(b) or Unit, Fin(succ(b)), fin_succ_equiv(b))
  );
  let regroup := equiv_symm(
    U0, (Fin(a) or Fin(b)) or Unit, Fin(a) or (Fin(b) or Unit),
    sum_associativity(U0, Fin(a), Fin(b), Unit)
  );
  let inner :=
    sum_equiv(U0, Fin(a) or Fin(b), Unit, Fin(a + b), Unit, previous, id_contr_equiv(U0, Unit));
  exact equiv_compose(
    U0, Fin(a) or Fin(succ(b)), Fin(a) or (Fin(b) or Unit), Fin(a + succ(b)), split,
    equiv_compose(
      U0, Fin(a) or (Fin(b) or Unit), (Fin(a) or Fin(b)) or Unit, Fin(a + succ(b)), regroup,
      equiv_compose(
        U0, (Fin(a) or Fin(b)) or Unit, Fin(a + b) or Unit, Fin(a + succ(b)), inner,
        equiv_compose(
          U0, Fin(a + b) or Unit, Fin(succ(a + b)), Fin(a + succ(b)), fin_succ_equiv(a + b),
          fin_cast(succ(a + b), a + succ(b), bnat_succ_add(a, b))
        )
      )
    )
  );
}

computable def fin_sum(a, b : Nat) : ContrEquiv(U0, Fin(a) or Fin(b), Fin(a + b)) := nat_peano(
  U0, FinSum(a), fin_sum_zero(a), fin_sum_succ(a), b
);

computable def FinProduct(b, a : Nat) : U0 := ContrEquiv(U0, Fin(a) and Fin(b), Fin(a * b));

computable def fin_product_zero(b : Nat) : FinProduct(b, 0) := empty_equiv(
  U0, Fin(0) and Fin(b), Fin(0 * b), fun (p : Fin(0) and Fin(b)) => fin_zero_empty(p.1),
  fun (x : Fin(0 * b)) => fin_zero_empty(
    fin_cast(0 * b, 0, trans(nat_mul_comm(0, b), nat_mul_zero(b))).1(x)
  )
);

// Fin(a + 1) and Fin(b): the pairs below a, then the row of a, after them.
computable def fin_product_succ(b, a : Nat, previous : FinProduct(b, a)) : FinProduct(b, succ(a)) {
  let split := product_equiv(
    U0, Fin(succ(a)), Fin(b), Fin(a) or Unit, Fin(b),
    equiv_symm(U0, Fin(a) or Unit, Fin(succ(a)), fin_succ_equiv(a)), id_contr_equiv(U0, Fin(b))
  );
  let rows := sum_equiv(
    U0, Fin(a) and Fin(b), Unit and Fin(b), Fin(a * b), Fin(b), previous, unit_product(U0, Fin(b))
  );
  exact equiv_compose(
    U0, Fin(succ(a)) and Fin(b), (Fin(a) or Unit) and Fin(b), Fin(succ(a) * b), split,
    equiv_compose(
      U0, (Fin(a) or Unit) and Fin(b), (Fin(a) and Fin(b)) or (Unit and Fin(b)), Fin(succ(a) * b),
      product_sum_distribute(U0, Fin(a), Unit, Fin(b)),
      equiv_compose(
        U0, (Fin(a) and Fin(b)) or (Unit and Fin(b)), Fin(a * b) or Fin(b), Fin(succ(a) * b), rows,
        equiv_compose(
          U0, Fin(a * b) or Fin(b), Fin(a * b + b), Fin(succ(a) * b), fin_sum(a * b, b),
          fin_cast(a * b + b, succ(a) * b, sym(nat_succ_mul(a, b)))
        )
      )
    )
  );
}

computable def fin_product(a, b : Nat) : ContrEquiv(U0, Fin(a) and Fin(b), Fin(a * b)) := nat_peano(
  U0, FinProduct(b), fin_product_zero(b), fin_product_succ(b), a
);

// The sizes of finite types add under sums and multiply under products.
computable def sum_cardinality(
  A, B : U0, a, b : Nat, count_a : HasCardinality(A, a), count_b : HasCardinality(B, b)
) :
  HasCardinality(A or B, a + b) := mere_eliminate(
    U0, U0, ContrEquiv(U0, Fin(a), A), HasCardinality(A or B, a + b),
    has_cardinality_is_prop(A or B, a + b),
    fun (e : ContrEquiv(U0, Fin(a), A)) => mere_map(
      U0, U0, ContrEquiv(U0, Fin(b), B), ContrEquiv(U0, Fin(a + b), A or B),
      fun (d : ContrEquiv(U0, Fin(b), B)) => equiv_compose(
        U0, Fin(a + b), Fin(a) or Fin(b), A or B,
        equiv_symm(U0, Fin(a) or Fin(b), Fin(a + b), fin_sum(a, b)),
        sum_equiv(U0, Fin(a), Fin(b), A, B, e, d)
      ), count_b
    ), count_a
  );

computable def product_cardinality(
  A, B : U0, a, b : Nat, count_a : HasCardinality(A, a), count_b : HasCardinality(B, b)
) :
  HasCardinality(A and B, a * b) := mere_eliminate(
    U0, U0, ContrEquiv(U0, Fin(a), A), HasCardinality(A and B, a * b),
    has_cardinality_is_prop(A and B, a * b),
    fun (e : ContrEquiv(U0, Fin(a), A)) => mere_map(
      U0, U0, ContrEquiv(U0, Fin(b), B), ContrEquiv(U0, Fin(a * b), A and B),
      fun (d : ContrEquiv(U0, Fin(b), B)) => equiv_compose(
        U0, Fin(a * b), Fin(a) and Fin(b), A and B,
        equiv_symm(U0, Fin(a) and Fin(b), Fin(a * b), fin_product(a, b)),
        product_equiv(U0, Fin(a), Fin(b), A, B, e, d)
      ), count_b
    ), count_a
  );
