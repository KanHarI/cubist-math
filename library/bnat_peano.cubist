import bnat_recursion;

// Dependent Peano recursion over binary naturals: zero, and at a positive
// p the step from its predecessor, by the strong recursion, which retypes
// no value. The step gives its value at bnat_succ(bpositive_pred(p)), read
// at p through bpositive_succ_pred_cast, which recurses on the bits and
// transports nothing.
computable def bnat_peano_step(
  U < UU0, P : BNat -> U, z : P(b_zero), step : (forall n : BNat. P(n) -> P(bnat_succ(n))),
  n : BNat, below : BNatBelow(U, P, n)
) :
  P(n) := match n {
    b_zero => z;
    b_positive(p) => bpositive_succ_pred_cast(
      U, P, p, step(bpositive_pred(p), below(bpositive_pred(p), bpositive_pred_lt(p)))
    );
  };

computable def bnat_peano(
  U < UU0, P : BNat -> U, z : P(b_zero), step : (forall n : BNat. P(n) -> P(bnat_succ(n))), n : BNat
) :
  P(n) := bnat_strong_recursion(U, P, bnat_peano_step(U, P, z, step), n);

// A path of total values with one index determines a path in that fiber.
// Setness is used only for the binary index, never for the result family.
computable def bnat_total_same_index(
  U < UU0, P : BNat -> U, n : BNat, x, y : P(n), q : typed(BNatFamilyTotal(U, P), (n, x)) = (n, y)
) :
  x = y {
  let r := cong(fun (z : BNatFamilyTotal(U, P)) => z.1, q);
  exact trans(
    sym(path_to_transport(fun (i : Interval) => P(n), x, x, refl(x))),
    trans(
      cong(
        fun (p : n = n) => comp(fun (i : Interval) => P(p @ i), x), bnat_is_set(n, n, refl(n), r)
      ),
      path_to_transport(
        fun (i : Interval) => P(r @ i), x, y, apd_path(fun (z : BNatFamilyTotal(U, P)) => z.2, q)
      )
    )
  );
}

// The casts move a value along their equations, as paths of total values.
computable def bnat_succ_twice_succ_cast_total(
  U < UU0, Q : BNat -> U, n : BNat, x : Q(bnat_succ(bnat_twice_succ(n)))
) :
  typed(BNatFamilyTotal(U, Q), (bnat_succ(bnat_twice_succ(n)), x)) = (
    bnat_twice(bnat_succ(n)), bnat_succ_twice_succ_cast(U, Q, n, x)
  ) := match n {
    b_zero => refl(typed(BNatFamilyTotal(U, Q), (b_positive(bp_even(bp_one)), x)));
    b_positive(p) => refl(typed(BNatFamilyTotal(U, Q), (b_positive(bp_even(bpositive_succ(p))), x)));
  };

computable def bpositive_succ_pred_cast_total(
  U < UU0, Q : BNat -> U, p : BPositive, x : Q(bnat_succ(bpositive_pred(p)))
) :
  typed(BNatFamilyTotal(U, Q), (bnat_succ(bpositive_pred(p)), x)) = (
    b_positive(p), bpositive_succ_pred_cast(U, Q, p, x)
  ) := match p {
    bp_one => refl(typed(BNatFamilyTotal(U, Q), (b_positive(bp_one), x)));
    bp_even(q) => trans(
      bnat_succ_twice_succ_cast_total(U, Q, bpositive_pred(q), x),
      cong(
        fun (z : BNatFamilyTotal(U, fun (m : BNat) => Q(bnat_twice(m)))) => typed(
          BNatFamilyTotal(U, Q), (bnat_twice(z.1), z.2)
        ),
        bpositive_succ_pred_cast_total(
          U, fun (m : BNat) => Q(bnat_twice(m)), q,
          bnat_succ_twice_succ_cast(U, Q, bpositive_pred(q), x)
        )
      )
    );
    bp_odd(q) => refl(typed(BNatFamilyTotal(U, Q), (b_positive(bp_odd(q)), x)));
  };

// Zero computes directly. The successor equation is a checked path, valid
// for arbitrary dependent P in every finite universe.
computable def bnat_peano_zero(
  U < UU0, P : BNat -> U, z : P(b_zero), step : (forall n : BNat. P(n) -> P(bnat_succ(n)))
) :
  bnat_peano(U, P, z, step, b_zero) = z := refl(z);

computable def bnat_peano_succ(
  U < UU0, P : BNat -> U, z : P(b_zero), step : (forall n : BNat. P(n) -> P(bnat_succ(n))), n : BNat
) :
  bnat_peano(U, P, z, step, bnat_succ(n)) = step(n, bnat_peano(U, P, z, step, n)) {
  match n {
    b_zero => {
      exact bnat_strong_recursion_equation(U, P, bnat_peano_step(U, P, z, step), b_positive(bp_one));
    }
    b_positive(q) => {
      exact trans(
        bnat_strong_recursion_equation(
          U, P, bnat_peano_step(U, P, z, step), b_positive(bpositive_succ(q))
        ),
        bnat_total_same_index(
          U, P, b_positive(bpositive_succ(q)),
          bpositive_succ_pred_cast(
            U, P, bpositive_succ(q),
            step(
              bpositive_pred(bpositive_succ(q)),
              bnat_peano(U, P, z, step, bpositive_pred(bpositive_succ(q)))
            )
          ), step(b_positive(q), bnat_peano(U, P, z, step, b_positive(q))),
          trans(
            sym(
              bpositive_succ_pred_cast_total(
                U, P, bpositive_succ(q),
                step(
                  bpositive_pred(bpositive_succ(q)),
                  bnat_peano(U, P, z, step, bpositive_pred(bpositive_succ(q)))
                )
              )
            ),
            cong(
              fun (m : BNat) => typed(
                BNatFamilyTotal(U, P), (bnat_succ(m), step(m, bnat_peano(U, P, z, step, m)))
              ), bpositive_pred_succ(q)
            )
          )
        )
      );
    }
  }
}
