import differences;
import unat_models;
use unat;

// The unary compatibility integers instantiate the shared difference ring.
// Public names and their stated types stay available to existing clients.

def SameDifference(p, q : UNat and UNat) :
  U0 := DifferenceRelation{{U0}}(unat_semiring, unat_decide, unat_add_cancel, p, q);

computable def same_difference_props(p, q : UNat and UNat) :
  IsProp(U0, SameDifference(p, q)) := difference_same_difference_props{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q
  );

computable def same_difference_refl(p : UNat and UNat) :
  SameDifference(p, p) := difference_same_difference_refl{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p
  );

computable def same_difference_sym(p, q : UNat and UNat, r : SameDifference(p, q)) :
  SameDifference(q, p) := difference_same_difference_sym{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, r
  );

computable def same_difference_trans(
  p, q, s : UNat and UNat, r : SameDifference(p, q), t : SameDifference(q, s)
) :
  SameDifference(p, s) := difference_same_difference_trans{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, s, r, t
  );

def Z : U0 := Difference{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def int_is_set :
  IsSet(U0, Z) := difference_is_set{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def int(a, b : UNat) :
  Z := difference{{U0}}(unat_semiring, unat_decide, unat_add_cancel, a, b);

computable def int_path(p, q : UNat and UNat, r : SameDifference(p, q)) :
  typed(Z, class(p)) = typed(Z, class(q)) := difference_path{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, r
  );

computable def int_pairs(p, q : UNat and UNat, e : p = q) :
  typed(Z, class(p)) = typed(Z, class(q)) := difference_pairs{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q, e
  );

computable def int_induction(
  P : Z -> U0, props : (forall z : Z. IsProp(U0, P(z))),
  f : (forall p : UNat and UNat. P(class(p))), z : Z
) :
  P(z) := difference_induction{{U0}}(unat_semiring, unat_decide, unat_add_cancel, P, props, f, z);

computable def int_zero : Z := difference_zero{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def int_one : Z := difference_one{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

computable def int_neg(x : Z) :
  Z := difference_neg{{U0}}(unat_semiring, unat_decide, unat_add_cancel, x);

computable def add_pairs(p, q : UNat and UNat) :
  UNat and UNat := difference_add_pairs{{U0}}(unat_semiring, unat_decide, unat_add_cancel, p, q);

computable def add_pairs_left(p, s, q : UNat and UNat, r : SameDifference(p, s)) :
  SameDifference(add_pairs(p, q), add_pairs(s, q)) := difference_add_pairs_left{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, s, q, r
  );

computable def add_pairs_comm(p, q : UNat and UNat) :
  add_pairs(p, q) = add_pairs(q, p) := difference_add_pairs_comm{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q
  );

computable def int_add(x, y : Z) :
  Z := difference_add{{U0}}(unat_semiring, unat_decide, unat_add_cancel, x, y);

computable def mul_pairs(p, q : UNat and UNat) :
  UNat and UNat := difference_mul_pairs{{U0}}(unat_semiring, unat_decide, unat_add_cancel, p, q);

computable def mul_pairs_left(p, s, q : UNat and UNat, r : SameDifference(p, s)) :
  SameDifference(mul_pairs(p, q), mul_pairs(s, q)) := difference_mul_pairs_left{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, s, q, r
  );

computable def mul_pairs_comm(p, q : UNat and UNat) :
  mul_pairs(p, q) = mul_pairs(q, p) := difference_mul_pairs_comm{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, p, q
  );

computable def int_mul(x, y : Z) :
  Z := difference_mul{{U0}}(unat_semiring, unat_decide, unat_add_cancel, x, y);

computable def int_equation(
  f, g : Z -> Z, e : (forall p : UNat and UNat. f(class(p)) = g(class(p))), x : Z
) :
  f(x) = g(x) := difference_equation{{U0}}(unat_semiring, unat_decide, unat_add_cancel, f, g, e, x);

computable def int_equation2(
  f, g : Z -> Z -> Z,
  e : (forall p, q : UNat and UNat. f(class(p), class(q)) = g(class(p), class(q))), x, y : Z
) :
  f(x, y) = g(x, y) := difference_equation2{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, f, g, e, x, y
  );

computable def int_equation3(
  f, g : Z -> Z -> Z -> Z,
  e : (
    forall p, q, s : UNat and UNat.
    f(class(p), class(q), class(s)) = g(class(p), class(q), class(s))
  ), x, y, z : Z
) :
  f(x, y, z) = g(x, y, z) := difference_equation3{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, f, g, e, x, y, z
  );

computable def int_add_assoc(x, y, z : Z) :
  int_add(int_add(x, y), z) = int_add(x, int_add(y, z)) := difference_add_assoc{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y, z
  );

computable def int_add_comm(x, y : Z) : int_add(x, y) = int_add(y, x) := difference_add_comm{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x, y
);

computable def int_zero_add(x : Z) : int_add(int_zero, x) = x := difference_zero_add{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def int_add_zero(x : Z) : int_add(x, int_zero) = x := difference_add_zero{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def int_neg_add(x : Z) : int_add(int_neg(x), x) = int_zero := difference_neg_add{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def int_add_neg(x : Z) : int_add(x, int_neg(x)) = int_zero := difference_add_neg{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def pairs_mul_assoc(a, b, c, d, e, f : UNat) :
  (a * c + b * d) * e + (a * d + b * c) * f = a * (c * e + d * f) + b * (c * f + d * e) := difference_pairs_mul_assoc{{
    U0
  }}(unat_semiring, unat_decide, unat_add_cancel, a, b, c, d, e, f);

computable def pairs_mul_add(a, b, c, d, e, f : UNat) :
  a * (c + e) + b * (d + f) = (a * c + b * d) + (a * e + b * f) := difference_pairs_mul_add{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, a, b, c, d, e, f
  );

computable def int_mul_assoc(x, y, z : Z) :
  int_mul(int_mul(x, y), z) = int_mul(x, int_mul(y, z)) := difference_mul_assoc{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y, z
  );

computable def int_mul_comm(x, y : Z) : int_mul(x, y) = int_mul(y, x) := difference_mul_comm{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x, y
);

computable def int_one_mul(x : Z) : int_mul(int_one, x) = x := difference_one_mul{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def int_mul_one(x : Z) : int_mul(x, int_one) = x := difference_mul_one{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x
);

computable def int_mul_add(x, y, z : Z) :
  int_mul(x, int_add(y, z)) = int_add(int_mul(x, y), int_mul(x, z)) := difference_mul_add{{U0}}(
    unat_semiring, unat_decide, unat_add_cancel, x, y, z
  );

computable def int_decide(x, y : Z) : Decidable(U0, x = y) := difference_decide{{U0}}(
  unat_semiring, unat_decide, unat_add_cancel, x, y
);

def integers : CommRing(U0) := difference_ring{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

// With c and d unequal by a successor's multiple on each side, the
// multiples are equal: from (b + S) * c + b * d = (b + S) * d + b * c,
// S * c = S * d, and so c = d.
computable def pairs_product_cancel(
  b, s, c, d : UNat, h : (b + succ(s)) * c + b * d = (b + succ(s)) * d + b * c
) :
  c = d {
  let shifted : (b * c + b * d) + succ(s) * c = (b * c + b * d) + succ(s) * d {
    calc {
      (b * c + b * d) + succ(s) * c = (b * c + succ(s) * c) + b * d by mul_right_comm(
        nat_additive, b * c, b * d, succ(s) * c
      );
      _ = (b + succ(s)) * c + b * d by cong(
        fun (m : UNat) => m + b * d, sym(unat_add_mul(b, succ(s), c))
      );
      _ = (b + succ(s)) * d + b * c by h;
      _ = (b * d + succ(s) * d) + b * c by cong(
        fun (m : UNat) => m + b * c, unat_add_mul(b, succ(s), d)
      );
      _ = (b * c + b * d) + succ(s) * d by trans(
        unat_add_comm(b * d + succ(s) * d, b * c), sym(unat_add_assoc(b * c, b * d, succ(s) * d))
      );
    }
  }
  let multiples : c * succ(s) = d * succ(s) := trans(
    unat_mul_comm(c, succ(s)),
    trans(
      unat_add_cancel(b * c + b * d, succ(s) * c, succ(s) * d, shifted), unat_mul_comm(succ(s), d)
    )
  );
  exact unat_mul_cancel(s, c, d, multiples);
}

// At pairs: if the product of p and q is zero, p's components or q's are
// equal, by trichotomy on p's and cancellation, so p or q is zero.
computable def int_zero_divisors(
  p, q : UNat and UNat, np : typed(Z, class(p)) = int_zero -> Void,
  nq : typed(Z, class(q)) = int_zero -> Void, r : SameDifference(mul_pairs(p, q), (0, 0))
) :
  Void {
  let products : p.1 * q.1 + p.2 * q.2 = p.1 * q.2 + p.2 * q.1 :=
    trans(sym(unat_add_zero(p.1 * q.1 + p.2 * q.2)), r);
  let q_zero := fun (e : q.1 = q.2) => nq(int_path(q, (0, 0), trans(unat_add_zero(q.1), e)));
  match unat_trichotomy(p.1, p.2) {
    left(above) => {
      let shifted :
        (p.2 + succ(above.1)) * q.1 + p.2 * q.2 = (p.2 + succ(above.1)) * q.2 + p.2 * q.1 {
        calc {
          (p.2 + succ(above.1)) * q.1 + p.2 * q.2 = p.1 * q.1 + p.2 * q.2 by cong(
            fun (m : UNat) => m * q.1 + p.2 * q.2, sym(above.2)
          );
          _ = p.1 * q.2 + p.2 * q.1 by products;
          _ = (p.2 + succ(above.1)) * q.2 + p.2 * q.1 by cong(
            fun (m : UNat) => m * q.2 + p.2 * q.1, above.2
          );
        }
      }
      exact q_zero(pairs_product_cancel(p.2, above.1, q.1, q.2, shifted));
    }
    right(rest) => {
      match rest {
        left(same) => {
          exact np(int_path(p, (0, 0), trans(unat_add_zero(p.1), same)));
        }
        right(below) => {
          let shifted :
            (p.1 + succ(below.1)) * q.2 + p.1 * q.1 = (p.1 + succ(below.1)) * q.1 + p.1 * q.2 {
            calc {
              (p.1 + succ(below.1)) * q.2 + p.1 * q.1 = p.1 * q.1 + (p.1 + succ(below.1)) * q.2 by unat_add_comm(
                (p.1 + succ(below.1)) * q.2, p.1 * q.1
              );
              _ = p.1 * q.1 + p.2 * q.2 by cong(fun (m : UNat) => p.1 * q.1 + m * q.2, sym(below.2));
              _ = p.1 * q.2 + p.2 * q.1 by products;
              _ = p.1 * q.2 + (p.1 + succ(below.1)) * q.1 by cong(
                fun (m : UNat) => p.1 * q.2 + m * q.1, below.2
              );
              _ = (p.1 + succ(below.1)) * q.1 + p.1 * q.2 by unat_add_comm(
                p.1 * q.2, (p.1 + succ(below.1)) * q.1
              );
            }
          }
          exact q_zero(sym(pairs_product_cancel(p.1, below.1, q.2, q.1, shifted)));
        }
      }
    }
  }
}

// The integers have no zero divisors: a product of integers other than
// zero is not zero.
computable def int_mul_nonzero(
  x, y : Z, nx : x = int_zero -> Void, ny : y = int_zero -> Void, p : int_mul(x, y) = int_zero
) :
  Void := int_induction(
    fun (a : Z) => forall b : Z. (a = int_zero -> Void) -> (b = int_zero -> Void)
    -> int_mul(a, b) = int_zero -> Void,
    fun (a : Z) => pi_is_prop(
      U0, Z, fun (b : Z) => (a = int_zero -> Void) -> (b = int_zero -> Void)
      -> int_mul(a, b) = int_zero -> Void,
      fun (b : Z) => pi_is_prop(
        U0, a = int_zero -> Void, fun (na : a = int_zero -> Void) => (b = int_zero -> Void)
        -> int_mul(a, b) = int_zero -> Void,
        fun (na : a = int_zero -> Void) => pi_is_prop(
          U0, b = int_zero -> Void, fun (nb : b = int_zero -> Void) => int_mul(a, b) = int_zero
          -> Void, fun (nb : b = int_zero -> Void) => not_is_prop(U0, int_mul(a, b) = int_zero)
        )
      )
    ),
    fun (p1 : UNat and UNat) => fun (b : Z) => int_induction(
      fun (c : Z) => (typed(Z, class(p1)) = int_zero -> Void) -> (c = int_zero -> Void)
      -> int_mul(class(p1), c) = int_zero -> Void,
      fun (c : Z) => pi_is_prop(
        U0, typed(Z, class(p1)) = int_zero -> Void,
        fun (na : typed(Z, class(p1)) = int_zero -> Void) => (c = int_zero -> Void)
        -> int_mul(class(p1), c) = int_zero -> Void,
        fun (na : typed(Z, class(p1)) = int_zero -> Void) => pi_is_prop(
          U0, c = int_zero -> Void,
          fun (nc : c = int_zero -> Void) => int_mul(class(p1), c) = int_zero -> Void,
          fun (nc : c = int_zero -> Void) => not_is_prop(U0, int_mul(class(p1), c) = int_zero)
        )
      ),
      fun (q : UNat and UNat) => fun (na : typed(Z, class(p1)) = int_zero -> Void) => fun (
        nc : typed(Z, class(q)) = int_zero -> Void
      ) => fun (zero_product : int_mul(class(p1), class(q)) = int_zero) => int_zero_divisors(
        p1, q, na, nc,
        quotient_effective(
          U0, UNat and UNat, SameDifference, same_difference_props, same_difference_refl,
          same_difference_sym, same_difference_trans, mul_pairs(p1, q), (0, 0), zero_product
        )
      ), b
    ), x
  )(y, nx, ny, p);

// Zero is not one: (0, 0) and (1, 0) do not have the same difference.
computable def int_zero_ne_one(p : int_zero = int_one) : Void := unat_zero_ne_succ(
  0, difference_embed_injective{{U0}}(unat_semiring, unat_decide, unat_add_cancel, 0, 1, p)
);

// The integers' numerals (L2.10c): integers.(2) is int(2, 0).
notation integers {
  numeral(n : UNat) := int(n, 0);
}
