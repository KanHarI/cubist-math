// The public integers are the binary-backed BInt: pairs of public binary
// naturals, (a, b) standing for a - b, with the same difference.
import ring_numerals;
import binary_integers;
import nat;
use nat;

def SameDifference(p, q : Nat and Nat) : U0 := BIntSameDifference(p, q);

def Z : U0 := BInt;

computable def int_is_set : IsSet(U0, Z) := bint_is_set;

computable def int(a, b : Nat) : Z := bint(a, b);

computable def int_path(p, q : Nat and Nat, r : SameDifference(p, q)) :
  typed(Z, class(p)) = typed(Z, class(q)) := bint_path(p, q, r);

computable def int_pairs(p, q : Nat and Nat, e : p = q) :
  typed(Z, class(p)) = typed(Z, class(q)) := bint_pairs(p, q, e);

computable def int_induction(
  P : Z -> U0, props : (forall z : Z. IsProp(U0, P(z))), f : (forall p : Nat and Nat. P(class(p))),
  z : Z
) :
  P(z) := bint_induction(P, props, f, z);

computable def int_zero : Z := bint_zero;

computable def int_one : Z := bint_one;

computable def int_neg(x : Z) : Z := bint_neg(x);

computable def int_add(x, y : Z) : Z := bint_add(x, y);

computable def int_mul(x, y : Z) : Z := bint_mul(x, y);

computable def int_equation(
  f, g : Z -> Z, e : (forall p : Nat and Nat. f(class(p)) = g(class(p))), x : Z
) :
  f(x) = g(x) := bint_equation(f, g, e, x);

computable def int_equation2(
  f, g : Z -> Z -> Z,
  e : (forall p, q : Nat and Nat. f(class(p), class(q)) = g(class(p), class(q))), x, y : Z
) :
  f(x, y) = g(x, y) := bint_equation2(f, g, e, x, y);

computable def int_equation3(
  f, g : Z -> Z -> Z -> Z,
  e : (
    forall p, q, s : Nat and Nat. f(class(p), class(q), class(s)) = g(class(p), class(q), class(s))
  ), x, y, z : Z
) :
  f(x, y, z) = g(x, y, z) := bint_equation3(f, g, e, x, y, z);

computable def int_add_assoc(x, y, z : Z) :
  int_add(int_add(x, y), z) = int_add(x, int_add(y, z)) := bint_add_assoc(x, y, z);

computable def int_add_comm(x, y : Z) : int_add(x, y) = int_add(y, x) := bint_add_comm(x, y);

computable def int_zero_add(x : Z) : int_add(int_zero, x) = x := bint_zero_add(x);

computable def int_add_zero(x : Z) : int_add(x, int_zero) = x := bint_add_zero(x);

computable def int_neg_add(x : Z) : int_add(int_neg(x), x) = int_zero := bint_neg_add(x);

computable def int_add_neg(x : Z) : int_add(x, int_neg(x)) = int_zero := bint_add_neg(x);

computable def int_mul_assoc(x, y, z : Z) :
  int_mul(int_mul(x, y), z) = int_mul(x, int_mul(y, z)) := bint_mul_assoc(x, y, z);

computable def int_mul_comm(x, y : Z) : int_mul(x, y) = int_mul(y, x) := bint_mul_comm(x, y);

computable def int_one_mul(x : Z) : int_mul(int_one, x) = x := bint_one_mul(x);

computable def int_mul_one(x : Z) : int_mul(x, int_one) = x := bint_mul_one(x);

computable def int_mul_add(x, y, z : Z) :
  int_mul(x, int_add(y, z)) = int_add(int_mul(x, y), int_mul(x, z)) := bint_mul_add(x, y, z);

computable def int_decide(x, y : Z) : Decidable(U0, x = y) := bint_decide(x, y);

// A zero decision with a compact certificate for nonzero values.
computable def int_decide_zero(x : Z) : Decidable(U0, x = int_zero) := bint_decide_zero(x);

def integers : CommRing(U0) := binary_integers;

computable def int_mul_nonzero(
  x, y : Z, nx : x = int_zero -> Void, ny : y = int_zero -> Void, p : int_mul(x, y) = int_zero
) :
  Void := bint_mul_nonzero(x, y, nx, ny, p);

computable def int_zero_ne_one(p : int_zero = int_one) : Void := bint_zero_ne_one(p);

// A natural number is an integer: the cast keeps its binary magnitude.
computable def int_of_nat(n : Nat) : Z := bint_of_nat(n);

computable def int_of_nat_zero : int_of_nat(0) = int_zero := bint_of_nat_zero;

computable def int_of_nat_one : int_of_nat(1) = int_one := bint_of_nat_one;

computable def int_of_nat_add(a, b : Nat) :
  int_of_nat(a + b) = int_add(int_of_nat(a), int_of_nat(b)) := bint_of_nat_add(a, b);

computable def int_of_nat_mul(a, b : Nat) :
  int_of_nat(a * b) = int_mul(int_of_nat(a), int_of_nat(b)) := bint_of_nat_mul(a, b);

computable def int_of_nat_injective(a, b : Nat, p : int_of_nat(a) = int_of_nat(b)) :
  a = b := bint_of_nat_injective(a, b, p);

// The cast, which the literal rule reads into, agrees with the ring's
// generic numeral.
computable def int_of_nat_numeral(n : Nat) : int_of_nat(n) = integers.of_nat(n) := of_nat_map(
  integers.ring, int_of_nat, int_of_nat_zero, int_of_nat_one, int_of_nat_add, int_of_nat_mul, n
);

// Decimal and 0b literals enter binary magnitudes directly.
computable def int_literal(s : Lexeme) : Parsed(U0, Z) := bint_literal(s);

notation integers {
  literal(s : Lexeme) := int_literal(s);
}
