import nat;
import hlevels;
import h1_truncation;
import lists;
import lexemes;
import quotients;
import algebra;
import integers;
use nat;

// The field of fractions of a commutative ring with decidable equality, no
// zero divisors and zero not one: fractions x / d with d not zero, two of
// them equal when x * d' = x' * d. The rationals are the integers' field of
// fractions, and every operation on them computes.

section {{U < UU0}}(
  A : CommRing(U), decide : (forall x, y : A.R. Decidable(U, x = y)),
  domain : (
    forall x, y : A.R. (x = A.zero -> Void) -> (y = A.zero -> Void) -> A.mul(x, y) = A.zero -> Void
  ), nontrivial : A.zero = A.one -> Void
) {
  // A fraction: a numerator, and a denominator that is not zero.
  def Fraction : U := R and (exists d : R. d = zero -> Void);

  def SameRatio(f, g : Fraction) : U := f.1 * g.2.1 = g.1 * f.2.1;

  computable def same_ratio_props(f, g : Fraction) :
    IsProp(U, SameRatio(f, g)) := R_is_set(f.1 * g.2.1, g.1 * f.2.1);

  computable def same_ratio_refl(f : Fraction) : SameRatio(f, f) := refl(f.1 * f.2.1);

  computable def same_ratio_sym(f, g : Fraction, r : SameRatio(f, g)) : SameRatio(g, f) := sym(r);

  // Multiplication by an element other than zero cancels: otherwise
  // (x - y) * z would be zero with neither factor zero.
  computable def cancel_nonzero(x, y, z : R, nz : z = zero -> Void, p : x * z = y * z) : x = y {
    match decide(x, y) {
      left(same) => {
        exact same;
      }
      right(different) => {
        let difference : (x + neg(y)) * z = zero {
          calc {
            (x + neg(y)) * z = x * z + neg(y) * z by add_mul(A, x, neg(y), z);
            _ = y * z + neg(y) * z by cong(fun (w : R) => w + neg(y) * z, p);
            _ = (y + neg(y)) * z by sym(add_mul(A, y, neg(y), z));
            _ = zero * z by cong(fun (w : R) => w * z, add_neg(y));
            _ = zero by zero_mul(A, z);
          }
        }
        let nonzero : x + neg(y) = zero
        -> Void :=
          fun (e : x + neg(y) = zero) => different(
            trans(inv_unique(A.additive.group, neg(y), x, e), inv_inv(A.additive.group, y))
          );
        exact absurd(domain(x + neg(y), z, nonzero, nz, difference));
      }
    }
  }

  // From f.1 * g.2 = g.1 * f.2 and g.1 * h.2 = h.1 * g.2: both sides of
  // f.1 * h.2 = h.1 * f.2, times g.2, agree.
  computable def same_ratio_trans(f, g, h : Fraction, r : SameRatio(f, g), t : SameRatio(g, h)) :
    SameRatio(f, h) {
    let scaled : (f.1 * h.2.1) * g.2.1 = (h.1 * f.2.1) * g.2.1 {
      calc {
        (f.1 * h.2.1) * g.2.1 = (f.1 * g.2.1) * h.2.1 by mul_right_comm(
          A.multiplicative, f.1, h.2.1, g.2.1
        );
        _ = (g.1 * f.2.1) * h.2.1 by cong(fun (w : R) => w * h.2.1, r);
        _ = (g.1 * h.2.1) * f.2.1 by mul_right_comm(A.multiplicative, g.1, f.2.1, h.2.1);
        _ = (h.1 * g.2.1) * f.2.1 by cong(fun (w : R) => w * f.2.1, t);
        _ = (h.1 * f.2.1) * g.2.1 by mul_right_comm(A.multiplicative, h.1, g.2.1, f.2.1);
      }
    }
    exact cancel_nonzero(f.1 * h.2.1, h.1 * f.2.1, g.2.1, g.2.2, scaled);
  }

  // Fractions with equal numerators and equal denominators, or both scaled
  // by one element, have the same ratio.
  computable def same_ratio_equal(f, g : Fraction, num : f.1 = g.1, den : f.2.1 = g.2.1) :
    SameRatio(f, g) := trans(
      cong(fun (w : R) => w * g.2.1, num), cong(fun (w : R) => g.1 * w, sym(den))
    );

  computable def same_ratio_scaled(
    f, g : Fraction, k : R, num : g.1 = k * f.1, den : g.2.1 = k * f.2.1
  ) :
    SameRatio(f, g) {
    calc {
      f.1 * g.2.1 = f.1 * (k * f.2.1) by cong(fun (w : R) => f.1 * w, den);
      _ = k * (f.1 * f.2.1) by mul_left_comm(A.multiplicative, f.1, k, f.2.1);
      _ = (k * f.1) * f.2.1 by sym(mul_assoc(k, f.1, f.2.1));
      _ = g.1 * f.2.1 by cong(fun (w : R) => w * f.2.1, sym(num));
    }
  }

  // The operations on fractions.
  computable def one_nonzero(e : one = zero) : Void := nontrivial(sym(e));

  computable def frac_zero : Fraction := (zero, one, one_nonzero);

  computable def frac_one : Fraction := (one, one, one_nonzero);

  computable def frac_add(f, g : Fraction) :
    Fraction := (f.1 * g.2.1 + g.1 * f.2.1, f.2.1 * g.2.1, domain(f.2.1, g.2.1, f.2.2, g.2.2));

  computable def frac_mul(f, g : Fraction) :
    Fraction := (f.1 * g.1, f.2.1 * g.2.1, domain(f.2.1, g.2.1, f.2.2, g.2.2));

  computable def frac_neg(f : Fraction) : Fraction := (neg(f.1), f.2.1, f.2.2);

  // The inverse, given whether the numerator is zero: the fraction turned
  // over, or zero.
  computable def frac_inv_by(f : Fraction, zero_or_not : Decidable(U, f.1 = zero)) :
    Fraction := match zero_or_not return Fraction {
      left z => frac_zero;
      right nz => (f.2.1, f.1, nz);
    };

  computable def frac_inv(f : Fraction) : Fraction := frac_inv_by(f, decide(f.1, zero));

  // The field of fractions: fractions, quotiented by having the same ratio.
  def Frac : U := Quotient(U, Fraction, SameRatio);

  computable def frac_is_set : IsSet(U, Frac) := quotient_is_set(U, Fraction, SameRatio);

  computable def frac_path(f, g : Fraction, r : SameRatio(f, g)) :
    typed(Frac, class(f)) = typed(Frac, class(g)) := class_path(U, Fraction, SameRatio, f, g, r);

  computable def frac_effective(f, g : Fraction, p : typed(Frac, class(f)) = typed(Frac, class(g))) :
    SameRatio(f, g) := quotient_effective(
      U, Fraction, SameRatio, same_ratio_props, same_ratio_refl, same_ratio_sym, same_ratio_trans,
      f, g, p
    );

  // Each operation respects the ratio, so it descends: on the left, by the
  // ratio, regrouped; on the right, through the operation's commutativity.
  computable def frac_add_left(f, f2, g : Fraction, r : SameRatio(f, f2)) :
    SameRatio(frac_add(f, g), frac_add(f2, g)) {
    calc {
      (f.1 * g.2.1 + g.1 * f.2.1) * (f2.2.1 * g.2.1) = (f.1 * g.2.1) * (f2.2.1 * g.2.1) + (
        g.1 * f.2.1
      ) * (f2.2.1 * g.2.1) by add_mul(A, f.1 * g.2.1, g.1 * f.2.1, f2.2.1 * g.2.1);
      _ = (f.1 * f2.2.1) * (g.2.1 * g.2.1) + (g.1 * f2.2.1) * (f.2.1 * g.2.1) by trans(
        cong(
          fun (w : R) => w + (g.1 * f.2.1) * (f2.2.1 * g.2.1),
          mul_interchange(A.multiplicative, f.1, g.2.1, f2.2.1, g.2.1)
        ),
        cong(
          fun (w : R) => (f.1 * f2.2.1) * (g.2.1 * g.2.1) + w,
          mul_interchange(A.multiplicative, g.1, f.2.1, f2.2.1, g.2.1)
        )
      );
      _ = (f2.1 * f.2.1) * (g.2.1 * g.2.1) + (g.1 * f2.2.1) * (f.2.1 * g.2.1) by cong(
        fun (w : R) => w * (g.2.1 * g.2.1) + (g.1 * f2.2.1) * (f.2.1 * g.2.1), r
      );
      _ = (f2.1 * g.2.1) * (f.2.1 * g.2.1) + (g.1 * f2.2.1) * (f.2.1 * g.2.1) by cong(
        fun (w : R) => w + (g.1 * f2.2.1) * (f.2.1 * g.2.1),
        sym(mul_interchange(A.multiplicative, f2.1, g.2.1, f.2.1, g.2.1))
      );
      _ = (f2.1 * g.2.1 + g.1 * f2.2.1) * (f.2.1 * g.2.1) by sym(
        add_mul(A, f2.1 * g.2.1, g.1 * f2.2.1, f.2.1 * g.2.1)
      );
    }
  }

  computable def frac_add_comm_ratio(f, g : Fraction) :
    SameRatio(frac_add(f, g), frac_add(g, f)) := same_ratio_equal(
      frac_add(f, g), frac_add(g, f), add_comm(f.1 * g.2.1, g.1 * f.2.1), mul_comm(f.2.1, g.2.1)
    );

  computable def frac_mul_left(f, f2, g : Fraction, r : SameRatio(f, f2)) :
    SameRatio(frac_mul(f, g), frac_mul(f2, g)) {
    calc {
      (f.1 * g.1) * (f2.2.1 * g.2.1) = (f.1 * f2.2.1) * (g.1 * g.2.1) by mul_interchange(
        A.multiplicative, f.1, g.1, f2.2.1, g.2.1
      );
      _ = (f2.1 * f.2.1) * (g.1 * g.2.1) by cong(fun (w : R) => w * (g.1 * g.2.1), r);
      _ = (f2.1 * g.1) * (f.2.1 * g.2.1) by mul_interchange(
        A.multiplicative, f2.1, f.2.1, g.1, g.2.1
      );
    }
  }

  computable def frac_mul_comm_ratio(f, g : Fraction) :
    SameRatio(frac_mul(f, g), frac_mul(g, f)) := same_ratio_equal(
      frac_mul(f, g), frac_mul(g, f), mul_comm(f.1, g.1), mul_comm(f.2.1, g.2.1)
    );

  computable def frac_neg_ratio(f, g : Fraction, r : SameRatio(f, g)) :
    SameRatio(frac_neg(f), frac_neg(g)) := trans(
      neg_mul(A, f.1, g.2.1), trans(cong(fun (w : R) => neg(w), r), sym(neg_mul(A, g.1, f.2.1)))
    );

  // Inverses of fractions with the same ratio have the same ratio: if one
  // numerator is zero, so is the other; otherwise the ratio turned over.
  computable def frac_inv_ratio(
    f, g : Fraction, r : SameRatio(f, g), df : Decidable(U, f.1 = zero),
    dg : Decidable(U, g.1 = zero)
  ) :
    SameRatio(frac_inv_by(f, df), frac_inv_by(g, dg)) {
    match df {
      left(fz) => {
        match dg {
          left(gz) => {
            exact same_ratio_refl(frac_zero);
          }
          right(gn) => {
            let product : g.1 * f.2.1 = zero :=
              trans(sym(r), trans(cong(fun (w : R) => w * g.2.1, fz), zero_mul(A, g.2.1)));
            exact absurd(domain(g.1, f.2.1, gn, f.2.2, product));
          }
        }
      }
      right(fn) => {
        match dg {
          left(gz) => {
            let product : f.1 * g.2.1 = zero :=
              trans(r, trans(cong(fun (w : R) => w * f.2.1, gz), zero_mul(A, f.2.1)));
            exact absurd(domain(f.1, g.2.1, fn, g.2.2, product));
          }
          right(gn) => {
            exact trans(mul_comm(f.2.1, g.1), trans(sym(r), mul_comm(f.1, g.2.1)));
          }
        }
      }
    }
  }

  computable def q_add(x, y : Frac) :
    Frac := descend2(
      U, U, Fraction, SameRatio, Frac, frac_is_set,
      fun (f, g : Fraction) => typed(Frac, class(frac_add(f, g))),
      fun (f, f2, g : Fraction, r : SameRatio(f, f2)) => frac_path(
        frac_add(f, g), frac_add(f2, g), frac_add_left(f, f2, g, r)
      ),
      fun (f, g, g2 : Fraction, r : SameRatio(g, g2)) => trans(
        frac_path(frac_add(f, g), frac_add(g, f), frac_add_comm_ratio(f, g)),
        trans(
          frac_path(frac_add(g, f), frac_add(g2, f), frac_add_left(g, g2, f, r)),
          frac_path(frac_add(g2, f), frac_add(f, g2), frac_add_comm_ratio(g2, f))
        )
      ), x, y
    );

  computable def q_mul(x, y : Frac) :
    Frac := descend2(
      U, U, Fraction, SameRatio, Frac, frac_is_set,
      fun (f, g : Fraction) => typed(Frac, class(frac_mul(f, g))),
      fun (f, f2, g : Fraction, r : SameRatio(f, f2)) => frac_path(
        frac_mul(f, g), frac_mul(f2, g), frac_mul_left(f, f2, g, r)
      ),
      fun (f, g, g2 : Fraction, r : SameRatio(g, g2)) => trans(
        frac_path(frac_mul(f, g), frac_mul(g, f), frac_mul_comm_ratio(f, g)),
        trans(
          frac_path(frac_mul(g, f), frac_mul(g2, f), frac_mul_left(g, g2, f, r)),
          frac_path(frac_mul(g2, f), frac_mul(f, g2), frac_mul_comm_ratio(g2, f))
        )
      ), x, y
    );

  computable def q_neg(x : Frac) :
    Frac := descend(
      U, U, Fraction, SameRatio, Frac, frac_is_set,
      fun (f : Fraction) => typed(Frac, class(frac_neg(f))),
      fun (f, g : Fraction, r : SameRatio(f, g)) => frac_path(
        frac_neg(f), frac_neg(g), frac_neg_ratio(f, g, r)
      ), x
    );

  computable def q_inv(x : Frac) :
    Frac := descend(
      U, U, Fraction, SameRatio, Frac, frac_is_set,
      fun (f : Fraction) => typed(Frac, class(frac_inv(f))),
      fun (f, g : Fraction, r : SameRatio(f, g)) => frac_path(
        frac_inv(f), frac_inv(g), frac_inv_ratio(f, g, r, decide(f.1, zero), decide(g.1, zero))
      ), x
    );

  computable def q_zero : Frac := class(frac_zero);

  computable def q_one : Frac := class(frac_one);

  // An equation in the field of fractions holds when it holds at classes.
  computable def frac_equation(
    F, G : Frac -> Frac, e : (forall f : Fraction. F(class(f)) = G(class(f))), x : Frac
  ) :
    F(x) = G(x) := quotient_induction_prop(
      U, U, Fraction, SameRatio, fun (z : Frac) => F(z) = G(z),
      fun (z : Frac) => frac_is_set(F(z), G(z)), e, x
    );

  computable def frac_equation2(
    F, G : Frac -> Frac -> Frac,
    e : (forall f, g : Fraction. F(class(f), class(g)) = G(class(f), class(g))), x, y : Frac
  ) :
    F(x, y) = G(x, y) := frac_equation(
      fun (a : Frac) => F(a, y), fun (a : Frac) => G(a, y),
      fun (f : Fraction) => frac_equation(
        fun (b : Frac) => F(class(f), b), fun (b : Frac) => G(class(f), b),
        fun (g : Fraction) => e(f, g), y
      ), x
    );

  computable def frac_equation3(
    F, G : Frac -> Frac -> Frac -> Frac,
    e : (
      forall f, g, h : Fraction. F(class(f), class(g), class(h)) = G(class(f), class(g), class(h))
    ), x, y, z : Frac
  ) :
    F(x, y, z) = G(x, y, z) := frac_equation(
      fun (a : Frac) => F(a, y, z), fun (a : Frac) => G(a, y, z),
      fun (f : Fraction) => frac_equation2(
        fun (b, c : Frac) => F(class(f), b, c), fun (b, c : Frac) => G(class(f), b, c),
        fun (g, h : Fraction) => e(f, g, h), y, z
      ), x
    );

  // Addition: associative, commutative, with zero a unit and negation an
  // inverse.
  computable def frac_add_assoc_ratio(f, g, h : Fraction) :
    SameRatio(frac_add(frac_add(f, g), h), frac_add(f, frac_add(g, h))) {
    let numerators :
      (f.1 * g.2.1 + g.1 * f.2.1) * h.2.1 + h.1 * (f.2.1 * g.2.1) = f.1 * (g.2.1 * h.2.1) + (
        g.1 * h.2.1 + h.1 * g.2.1
      ) * f.2.1 {
      calc {
        (f.1 * g.2.1 + g.1 * f.2.1) * h.2.1 + h.1 * (f.2.1 * g.2.1) = (
          (f.1 * g.2.1) * h.2.1 + (g.1 * f.2.1) * h.2.1
        ) + h.1 * (f.2.1 * g.2.1) by cong(
          fun (w : R) => w + h.1 * (f.2.1 * g.2.1), add_mul(A, f.1 * g.2.1, g.1 * f.2.1, h.2.1)
        );
        _ = (f.1 * g.2.1) * h.2.1 + ((g.1 * f.2.1) * h.2.1 + h.1 * (f.2.1 * g.2.1)) by add_assoc(
          (f.1 * g.2.1) * h.2.1, (g.1 * f.2.1) * h.2.1, h.1 * (f.2.1 * g.2.1)
        );
        _ = f.1 * (g.2.1 * h.2.1) + ((g.1 * h.2.1) * f.2.1 + (h.1 * g.2.1) * f.2.1) by trans(
          cong(
            fun (w : R) => w + ((g.1 * f.2.1) * h.2.1 + h.1 * (f.2.1 * g.2.1)),
            mul_assoc(f.1, g.2.1, h.2.1)
          ),
          trans(
            cong(
              fun (w : R) => f.1 * (g.2.1 * h.2.1) + (w + h.1 * (f.2.1 * g.2.1)),
              mul_right_comm(A.multiplicative, g.1, f.2.1, h.2.1)
            ),
            cong(
              fun (w : R) => f.1 * (g.2.1 * h.2.1) + ((g.1 * h.2.1) * f.2.1 + w),
              trans(
                cong(fun (v : R) => h.1 * v, mul_comm(f.2.1, g.2.1)),
                sym(mul_assoc(h.1, g.2.1, f.2.1))
              )
            )
          )
        );
        _ = f.1 * (g.2.1 * h.2.1) + (g.1 * h.2.1 + h.1 * g.2.1) * f.2.1 by cong(
          fun (w : R) => f.1 * (g.2.1 * h.2.1) + w, sym(add_mul(A, g.1 * h.2.1, h.1 * g.2.1, f.2.1))
        );
      }
    }
    exact same_ratio_equal(
      frac_add(frac_add(f, g), h), frac_add(f, frac_add(g, h)), numerators,
      mul_assoc(f.2.1, g.2.1, h.2.1)
    );
  }

  computable def q_add_assoc(x, y, z : Frac) :
    q_add(q_add(x, y), z) = q_add(x, q_add(y, z)) := frac_equation3(
      fun (a, b, c : Frac) => q_add(q_add(a, b), c), fun (a, b, c : Frac) => q_add(a, q_add(b, c)),
      fun (f, g, h : Fraction) => frac_path(
        frac_add(frac_add(f, g), h), frac_add(f, frac_add(g, h)), frac_add_assoc_ratio(f, g, h)
      ), x, y, z
    );

  computable def q_add_comm(x, y : Frac) :
    q_add(x, y) = q_add(y, x) := frac_equation2(
      fun (a, b : Frac) => q_add(a, b), fun (a, b : Frac) => q_add(b, a),
      fun (f, g : Fraction) => frac_path(frac_add(f, g), frac_add(g, f), frac_add_comm_ratio(f, g)),
      x, y
    );

  computable def q_zero_add(x : Frac) :
    q_add(q_zero, x) = x := frac_equation(
      fun (a : Frac) => q_add(q_zero, a), fun (a : Frac) => a,
      fun (f : Fraction) => frac_path(
        frac_add(frac_zero, f), f,
        same_ratio_equal(
          frac_add(frac_zero, f), f,
          trans(
            cong(fun (w : R) => w + f.1 * one, zero_mul(A, f.2.1)),
            trans(zero_add(f.1 * one), mul_one(f.1))
          ), one_mul(f.2.1)
        )
      ), x
    );

  computable def q_add_zero(x : Frac) :
    q_add(x, q_zero) = x := trans(q_add_comm(x, q_zero), q_zero_add(x));

  computable def q_neg_add(x : Frac) :
    q_add(q_neg(x), x) = q_zero := frac_equation(
      fun (a : Frac) => q_add(q_neg(a), a), fun (a : Frac) => q_zero,
      fun (f : Fraction) => frac_path(
        frac_add(frac_neg(f), f), frac_zero,
        trans(
          trans(
            mul_one(neg(f.1) * f.2.1 + f.1 * f.2.1),
            trans(
              sym(add_mul(A, neg(f.1), f.1, f.2.1)),
              trans(cong(fun (w : R) => w * f.2.1, neg_add(f.1)), zero_mul(A, f.2.1))
            )
          ), sym(zero_mul(A, f.2.1 * f.2.1))
        )
      ), x
    );

  computable def q_add_neg(x : Frac) :
    q_add(x, q_neg(x)) = q_zero := trans(q_add_comm(x, q_neg(x)), q_neg_add(x));

  // Multiplication: associative, commutative, with one a unit, and
  // distributing over addition.
  computable def q_mul_assoc(x, y, z : Frac) :
    q_mul(q_mul(x, y), z) = q_mul(x, q_mul(y, z)) := frac_equation3(
      fun (a, b, c : Frac) => q_mul(q_mul(a, b), c), fun (a, b, c : Frac) => q_mul(a, q_mul(b, c)),
      fun (f, g, h : Fraction) => frac_path(
        frac_mul(frac_mul(f, g), h), frac_mul(f, frac_mul(g, h)),
        same_ratio_equal(
          frac_mul(frac_mul(f, g), h), frac_mul(f, frac_mul(g, h)), mul_assoc(f.1, g.1, h.1),
          mul_assoc(f.2.1, g.2.1, h.2.1)
        )
      ), x, y, z
    );

  computable def q_mul_comm(x, y : Frac) :
    q_mul(x, y) = q_mul(y, x) := frac_equation2(
      fun (a, b : Frac) => q_mul(a, b), fun (a, b : Frac) => q_mul(b, a),
      fun (f, g : Fraction) => frac_path(frac_mul(f, g), frac_mul(g, f), frac_mul_comm_ratio(f, g)),
      x, y
    );

  computable def q_one_mul(x : Frac) :
    q_mul(q_one, x) = x := frac_equation(
      fun (a : Frac) => q_mul(q_one, a), fun (a : Frac) => a,
      fun (f : Fraction) => frac_path(
        frac_mul(frac_one, f), f,
        same_ratio_equal(frac_mul(frac_one, f), f, one_mul(f.1), one_mul(f.2.1))
      ), x
    );

  computable def q_mul_one(x : Frac) :
    q_mul(x, q_one) = x := trans(q_mul_comm(x, q_one), q_one_mul(x));

  // f * (g + h) and f * g + f * h: the second's numerator and denominator
  // are the first's, times f's denominator.
  computable def frac_mul_add_ratio(f, g, h : Fraction) :
    SameRatio(frac_mul(f, frac_add(g, h)), frac_add(frac_mul(f, g), frac_mul(f, h))) {
    let numerators :
      (f.1 * g.1) * (f.2.1 * h.2.1) + (f.1 * h.1) * (f.2.1 * g.2.1) = f.2.1 * (
        f.1 * (g.1 * h.2.1 + h.1 * g.2.1)
      ) {
      calc {
        (f.1 * g.1) * (f.2.1 * h.2.1) + (f.1 * h.1) * (f.2.1 * g.2.1) = f.2.1 * (
          f.1 * (g.1 * h.2.1)
        ) + f.2.1 * (f.1 * (h.1 * g.2.1)) by trans(
          cong(
            fun (w : R) => w + (f.1 * h.1) * (f.2.1 * g.2.1),
            trans(
              mul_interchange(A.multiplicative, f.1, g.1, f.2.1, h.2.1),
              trans(
                cong(fun (v : R) => v * (g.1 * h.2.1), mul_comm(f.1, f.2.1)),
                mul_assoc(f.2.1, f.1, g.1 * h.2.1)
              )
            )
          ),
          cong(
            fun (w : R) => f.2.1 * (f.1 * (g.1 * h.2.1)) + w,
            trans(
              mul_interchange(A.multiplicative, f.1, h.1, f.2.1, g.2.1),
              trans(
                cong(fun (v : R) => v * (h.1 * g.2.1), mul_comm(f.1, f.2.1)),
                mul_assoc(f.2.1, f.1, h.1 * g.2.1)
              )
            )
          )
        );
        _ = f.2.1 * (f.1 * (g.1 * h.2.1) + f.1 * (h.1 * g.2.1)) by sym(
          mul_add(f.2.1, f.1 * (g.1 * h.2.1), f.1 * (h.1 * g.2.1))
        );
        _ = f.2.1 * (f.1 * (g.1 * h.2.1 + h.1 * g.2.1)) by cong(
          fun (w : R) => f.2.1 * w, sym(mul_add(f.1, g.1 * h.2.1, h.1 * g.2.1))
        );
      }
    }
    let denominators : (f.2.1 * g.2.1) * (f.2.1 * h.2.1) = f.2.1 * (f.2.1 * (g.2.1 * h.2.1)) :=
      trans(
        mul_interchange(A.multiplicative, f.2.1, g.2.1, f.2.1, h.2.1),
        mul_assoc(f.2.1, f.2.1, g.2.1 * h.2.1)
      );
    exact same_ratio_scaled(
      frac_mul(f, frac_add(g, h)), frac_add(frac_mul(f, g), frac_mul(f, h)), f.2.1, numerators,
      denominators
    );
  }

  computable def q_mul_add(x, y, z : Frac) :
    q_mul(x, q_add(y, z)) = q_add(q_mul(x, y), q_mul(x, z)) := frac_equation3(
      fun (a, b, c : Frac) => q_mul(a, q_add(b, c)),
      fun (a, b, c : Frac) => q_add(q_mul(a, b), q_mul(a, c)),
      fun (f, g, h : Fraction) => frac_path(
        frac_mul(f, frac_add(g, h)), frac_add(frac_mul(f, g), frac_mul(f, h)),
        frac_mul_add_ratio(f, g, h)
      ), x, y, z
    );

  // Every fraction but zero times its inverse is one; zero is not one.
  computable def frac_mul_inv_ratio(
    f : Fraction, zero_or_not : Decidable(U, f.1 = zero), nz : typed(Frac, class(f)) = q_zero
    -> Void
  ) :
    SameRatio(frac_mul(f, frac_inv_by(f, zero_or_not)), frac_one) {
    match zero_or_not {
      left(fz) => {
        exact absurd(
          nz(frac_path(f, frac_zero, trans(trans(mul_one(f.1), fz), sym(zero_mul(A, f.2.1)))))
        );
      }
      right(fn) => {
        exact trans(mul_one(f.1 * f.2.1), trans(mul_comm(f.1, f.2.1), sym(one_mul(f.2.1 * f.1))));
      }
    }
  }

  computable def q_mul_inv(x : Frac, nz : x = q_zero -> Void) :
    q_mul(x, q_inv(x)) = q_one := quotient_induction_prop(
      U, U, Fraction, SameRatio, fun (z : Frac) => (z = q_zero -> Void)
      -> q_mul(z, q_inv(z)) = q_one,
      fun (z : Frac) => pi_is_prop(
        U, z = q_zero -> Void, fun (n : z = q_zero -> Void) => q_mul(z, q_inv(z)) = q_one,
        fun (n : z = q_zero -> Void) => frac_is_set(q_mul(z, q_inv(z)), q_one)
      ),
      fun (f : Fraction) => fun (n : typed(Frac, class(f)) = q_zero -> Void) => frac_path(
        frac_mul(f, frac_inv(f)), frac_one, frac_mul_inv_ratio(f, decide(f.1, zero), n)
      ), x
    )(nz);

  computable def q_zero_ne_one(p : q_zero = q_one) :
    Void := nontrivial(
      trans(sym(mul_one(zero)), trans(frac_effective(frac_zero, frac_one, p), mul_one(one)))
    );

  // Equality in the field of fractions is decidable: fractions have the
  // same ratio or not, and equal classes have related fractions.
  computable def q_decide(x, y : Frac) :
    Decidable(U, x = y) := quotient_induction_prop(
      U, U, Fraction, SameRatio, fun (a : Frac) => forall b : Frac. Decidable(U, a = b),
      fun (a : Frac) => pi_is_prop(
        U, Frac, fun (b : Frac) => Decidable(U, a = b),
        fun (b : Frac) => decision_is_prop(U, a = b, frac_is_set(a, b))
      ),
      fun (f : Fraction) => fun (b : Frac) => quotient_induction_prop(
        U, U, Fraction, SameRatio, fun (c : Frac) => Decidable(U, typed(Frac, class(f)) = c),
        fun (c : Frac) => decision_is_prop(U, typed(Frac, class(f)) = c, frac_is_set(class(f), c)),
        fun (g : Fraction) => match decide(f.1 * g.2.1, g.1 * f.2.1) return (
          Decidable(U, typed(Frac, class(f)) = typed(Frac, class(g)))
        ) {
          left r => left(frac_path(f, g, r));
          right n => right(
            fun (same : typed(Frac, class(f)) = typed(Frac, class(g))) => n(
              frac_effective(f, g, same)
            )
          );
        }, b
      ), x
    )(y);

  // The field of fractions.
  def fraction_field :
    Field(U) := Field.make(
      R := Frac, R_is_set := frac_is_set, add := q_add, add_assoc := q_add_assoc, zero := q_zero,
      zero_add := q_zero_add, add_zero := q_add_zero, neg := q_neg, neg_add := q_neg_add,
      add_neg := q_add_neg, add_comm := q_add_comm, mul := q_mul, mul_assoc := q_mul_assoc,
      one := q_one, one_mul := q_one_mul, mul_one := q_mul_one, mul_comm := q_mul_comm,
      mul_add := q_mul_add,
      inverses := fun (x : Frac, nonzero : x = q_zero -> Void) => merely(
        U, exists y : Frac. q_mul(x, y) = q_one, (q_inv(x), q_mul_inv(x, nonzero))
      ),
      zero_ne_one := q_zero_ne_one
    );
}

// The rationals: the integers' field of fractions.
def rationals :
  Field(U0) := fraction_field(integers, int_decide, int_mul_nonzero, int_zero_ne_one);

def Q : U0 := rationals.R;

// k + 1 is not zero.
computable def int_succ_nonzero(k : Nat, p : int(succ(k), 0) = int_zero) :
  Void := nat_zero_ne_succ(
    k + 0,
    sym(
      quotient_effective(
        U0, Nat and Nat, SameDifference, same_difference_props, same_difference_refl,
        same_difference_sym, same_difference_trans, (succ(k), 0), (0, 0), p
      )
    )
  );

// The rational a / (k + 1).
computable def rat(a : Z, k : Nat) : Q := class((a, int(succ(k), 0), int_succ_nonzero(k)));

computable def rat_decide(x, y : Q) :
  Decidable(U0, x = y) := q_decide(integers, int_decide, int_mul_nonzero, int_zero_ne_one, x, y);

// The rationals' literals (L2.10c): an integer, n/d with d not zero, or a
// decimal, a.b, read from their characters, so rationals.(1/2 + 0.75) needs
// no evidence. 1/0 is refused at its denominator.
computable def rational_fraction(numerator, at : Nat, s : Lexeme) : Parsed(U0, Q) {
  let read : (Nat and Nat) and Lexeme := leading_digits(s, 0, 0);
  exact match read.2 return Parsed(U0, Q) {
    nil => match read.1.1 return Parsed(U0, Q) {
      zero => error(at);
      succ(d) => ok(rat(int(numerator, 0), d));
    };
    cons(g, rest) => error(add(at, read.1.2));
  };
}

computable def rational_decimal(whole, at : Nat, s : Lexeme) : Parsed(U0, Q) {
  let read : (Nat and Nat) and Lexeme := leading_digits(s, 0, 0);
  exact match read.2 return Parsed(U0, Q) {
    nil => match power_of_ten(read.1.2) return Parsed(U0, Q) {
      zero => error(at);
      succ(d) => match read.1.2 return Parsed(U0, Q) {
        zero => error(at);
        succ(k) => ok(rat(int(add(mul(whole, power_of_ten(read.1.2)), read.1.1), 0), d));
      };
    };
    cons(g, rest) => error(add(at, read.1.2));
  };
}

computable def rational_literal(s : Lexeme) : Parsed(U0, Q) {
  let read : (Nat and Nat) and Lexeme := leading_digits(s, 0, 0);
  exact match read.2 return Parsed(U0, Q) {
    nil => ok(rat(int(read.1.1, 0), 0));
    cons(g, rest) => match g return Parsed(U0, Q) {
      slash => rational_fraction(read.1.1, succ(read.1.2), rest);
      period => rational_decimal(read.1.1, succ(read.1.2), rest);
      digit(d) => error(read.1.2);
      lower(n) => error(read.1.2);
      upper(n) => error(read.1.2);
      underscore => error(read.1.2);
      plus => error(read.1.2);
      minus => error(read.1.2);
    };
  };
}

notation rationals {
  literal(s : Lexeme) := rational_literal(s);
}
