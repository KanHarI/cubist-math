import nat;
import hlevels;

// The algebraic hierarchy as theories (L2.4): semigroups, monoids, groups,
// their commutative kinds, commutative rings and fields, each a theory of
// one set with its operations and laws. A model of a theory is a structure
// of its kind, Monoid(U), and a theory's homomorphisms and
// isomorphisms come with it. The natural numbers are a commutative monoid
// for addition and for multiplication.

theory Semigroup(U < UU0) {
  M : set U;
  mul(x, y : M) : M notation x * y;
  law mul_assoc(x, y, z : M) : (x * y) * z = x * (y * z);
}

theory Monoid(U < UU0) extends Semigroup {
  one : M;
  law one_mul(x : M) : one * x = x;
  law mul_one(x : M) : x * one = x;
}

theory CommMonoid(U < UU0) extends Monoid {
  law mul_comm(x, y : M) : x * y = y * x;
}

theory Group(U < UU0) extends Monoid {
  inv(x : M) : M;
  law inv_mul(x : M) : inv(x) * x = one;
  law mul_inv(x : M) : x * inv(x) = one;
}

// An abelian group: a group whose monoid is commutative. Monoid comes once,
// through both parents.
theory AbelianGroup(U < UU0) extends Group, CommMonoid {

}

// A commutative ring: an abelian group for addition, written +, with zero
// and neg, and a commutative monoid for multiplication on the same set,
// over which multiplication distributes.
theory CommRing(U < UU0) extends additive : AbelianGroup(
  M := R, mul := add notation x + y, mul_assoc := add_assoc, one := zero, one_mul := zero_add,
  mul_one := add_zero, inv := neg, inv_mul := neg_add, mul_inv := add_neg, mul_comm := add_comm
), multiplicative : CommMonoid(M := R) {
  law mul_add(x, y, z : R) : x * (y + z) = x * y + x * z;
}

// A field: a commutative ring in which zero is not one and every element
// but zero has a multiplicative inverse. inv is total; its value at zero
// is not constrained.
theory Field(U < UU0) extends CommRing {
  inv(x : R) : R;
  law mul_inv(x : R) : (x = zero -> Void) -> x * inv(x) = one;
  law zero_ne_one : zero = one -> Void;
}

// The natural numbers under addition, with 0, and under multiplication,
// with 1.
def nat_additive :
  CommMonoid(U0) := CommMonoid.make(
    M := Nat, M_is_set := nat_is_set, mul := add, mul_assoc := nat_add_assoc, one := 0,
    one_mul := nat_zero_add, mul_one := nat_add_zero, mul_comm := nat_add_comm
  );

def nat_multiplicative :
  CommMonoid(U0) := CommMonoid.make(
    M := Nat, M_is_set := nat_is_set, mul := mul, mul_assoc := nat_mul_assoc, one := 1,
    one_mul := nat_one_mul, mul_one := nat_mul_one, mul_comm := nat_mul_comm
  );

// In any commutative monoid, products regroup freely; for a ring, at its
// multiplicative monoid, A.multiplicative, and its additive one,
// A.additive.comm_monoid.
section {{U < UU0}}(G : CommMonoid(U)) {
  computable def mul_left_comm(x, y, z : M) : x * (y * z) = y * (x * z) {
    calc {
      x * (y * z) = (x * y) * z by sym(mul_assoc(x, y, z));
      _ = (y * x) * z by cong(fun (w : M) => w * z, mul_comm(x, y));
      _ = y * (x * z) by mul_assoc(y, x, z);
    }
  }

  computable def mul_right_comm(x, y, z : M) : (x * y) * z = (x * z) * y {
    calc {
      (x * y) * z = x * (y * z) by mul_assoc(x, y, z);
      _ = x * (z * y) by cong(fun (w : M) => x * w, mul_comm(y, z));
      _ = (x * z) * y by sym(mul_assoc(x, z, y));
    }
  }

  // (w * x) * (y * z) = (w * y) * (x * z): the middle two trade places.
  computable def mul_interchange(w, x, y, z : M) : (w * x) * (y * z) = (w * y) * (x * z) {
    calc {
      (w * x) * (y * z) = w * (x * (y * z)) by mul_assoc(w, x, y * z);
      _ = w * (y * (x * z)) by cong(fun (v : M) => w * v, mul_left_comm(x, y, z));
      _ = (w * y) * (x * z) by sym(mul_assoc(w, y, x * z));
    }
  }
}

// In any group: cancellation on both sides, and inverses are unique.
section {{U < UU0}}(G : Group(U)) {
  computable def left_cancel(x, y, z : M, p : x * y = x * z) : y = z {
    calc {
      y = one * y by sym(one_mul(y));
      _ = (inv(x) * x) * y by cong(fun (w : M) => w * y, sym(inv_mul(x)));
      _ = inv(x) * (x * y) by mul_assoc(inv(x), x, y);
      _ = inv(x) * (x * z) by cong(fun (w : M) => inv(x) * w, p);
      _ = (inv(x) * x) * z by sym(mul_assoc(inv(x), x, z));
      _ = one * z by cong(fun (w : M) => w * z, inv_mul(x));
      _ = z by one_mul(z);
    }
  }

  computable def right_cancel(x, y, z : M, p : y * x = z * x) : y = z {
    calc {
      y = y * one by sym(mul_one(y));
      _ = y * (x * inv(x)) by cong(fun (w : M) => y * w, sym(mul_inv(x)));
      _ = (y * x) * inv(x) by sym(mul_assoc(y, x, inv(x)));
      _ = (z * x) * inv(x) by cong(fun (w : M) => w * inv(x), p);
      _ = z * (x * inv(x)) by mul_assoc(z, x, inv(x));
      _ = z * one by cong(fun (w : M) => z * w, mul_inv(x));
      _ = z by mul_one(z);
    }
  }

  // An element that multiplies x to one on the left is x's inverse.
  computable def inv_unique(x, y : M, p : y * x = one) :
    y = inv(x) := right_cancel(x, y, inv(x), trans(p, sym(inv_mul(x))));

  computable def inv_inv(x : M) : inv(inv(x)) = x := sym(inv_unique(inv(x), x, mul_inv(x)));

  computable def inv_one : inv(one) = one := sym(inv_unique(one, one, one_mul(one)));
}

// In any commutative ring, zero absorbs: x * zero = zero, since
// x * zero + x * zero = x * zero = zero + x * zero, and addition cancels.
section {{U < UU0}}(A : CommRing(U)) {
  computable def mul_zero(x : R) : x * zero = zero {
    let doubled : (x * zero) + (x * zero) = zero + (x * zero) {
      calc {
        (x * zero) + (x * zero) = x * (zero + zero) by sym(mul_add(x, zero, zero));
        _ = x * zero by cong(fun (w : R) => x * w, zero_add(zero));
        _ = zero + (x * zero) by sym(zero_add(x * zero));
      }
    }
    exact right_cancel(A.additive.group, x * zero, x * zero, zero, doubled);
  }

  computable def zero_mul(x : R) : zero * x = zero := trans(mul_comm(zero, x), mul_zero(x));

  // Multiplication distributes over addition on the right too.
  computable def add_mul(x, y, z : R) : (x + y) * z = x * z + y * z {
    calc {
      (x + y) * z = z * (x + y) by mul_comm(x + y, z);
      _ = z * x + z * y by mul_add(z, x, y);
      _ = x * z + z * y by cong(fun (w : R) => w + z * y, mul_comm(z, x));
      _ = x * z + y * z by cong(fun (w : R) => x * z + w, mul_comm(z, y));
    }
  }

  // neg(x) * y is the additive inverse of x * y.
  computable def neg_mul(x, y : R) : neg(x) * y = neg(x * y) {
    let inverse : neg(x) * y + x * y = zero {
      calc {
        neg(x) * y + x * y = (neg(x) + x) * y by sym(add_mul(neg(x), x, y));
        _ = zero * y by cong(fun (w : R) => w * y, neg_add(x));
        _ = zero by zero_mul(y);
      }
    }
    exact inv_unique(A.additive.group, x * y, neg(x) * y, inverse);
  }
}
