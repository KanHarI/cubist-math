import nat;
import hlevels;
import h1_truncation;
use nat;

// The algebraic hierarchy as theories (L2.4): the magma, quasigroup and
// monoid lattice, groups, their commutative kinds, rings and fields. Each is a theory of
// one set with its operations and laws. A model of a theory is a structure
// of its kind, Monoid(U), and a theory's homomorphisms and
// isomorphisms come with it. The natural numbers are a commutative monoid
// for addition and for multiplication.

// A magma has only a multiplication. Identity, associativity and unique
// left/right division are independent extensions of this common ancestor.
theory Magma(U < UU0) {
  M : set U;
  mul(x, y : M) : M notation x * y;
}

theory UnitalMagma(U < UU0) extends Magma {
  one : M;
  law one_mul(x : M) : one * x = x;
  law mul_one(x : M) : x * one = x;
}

theory Semigroup(U < UU0) extends Magma {
  law mul_assoc(x, y, z : M) : (x * y) * z = x * (y * z);
}

// x * left_div(x, y) = y; right_div(x, y) * y = x. The reverse
// equations express uniqueness, without assuming associativity or a unit.
theory Quasigroup(U < UU0) extends Magma {
  left_div(x, y : M) : M;
  right_div(x, y : M) : M;
  law mul_left_div(x, y : M) : x * left_div(x, y) = y;
  law left_div_mul(x, y : M) : left_div(x, x * y) = y;
  law right_div_mul(x, y : M) : right_div(x, y) * y = x;
  law mul_right_div(x, y : M) : right_div(x * y, y) = x;
}

theory Loop(U < UU0) extends Quasigroup, UnitalMagma {}

theory AssociativeQuasigroup(U < UU0) extends Quasigroup, Semigroup {}

theory Monoid(U < UU0) extends Semigroup, UnitalMagma {}

theory CommMonoid(U < UU0) extends Monoid {
  law mul_comm(x, y : M) : x * y = y * x;
}

// The three routes share one multiplication, unit and division structure.
// Keep the existing inverse interface; the division laws force it to agree
// with division of the unit. No commutativity is required.
theory Group(U < UU0) extends Loop, AssociativeQuasigroup, Monoid {
  inv(x : M) : M;
  law inv_mul(x : M) : inv(x) * x = one;
  law mul_inv(x : M) : x * inv(x) = one;
}

section {{U < UU0}}(Q : Quasigroup(U)) {
  computable def quasigroup_left_cancel(x, y, z : M, p : x * y = x * z) : y = z := trans(
    sym(left_div_mul(x, y)), trans(cong(fun (w : M) => left_div(x, w), p), left_div_mul(x, z))
  );

  computable def quasigroup_right_cancel(x, y, z : M, p : y * x = z * x) : y = z := trans(
    sym(mul_right_div(y, x)), trans(cong(fun (w : M) => right_div(w, x), p), mul_right_div(z, x))
  );
}

// Adding associativity to a loop already supplies a group's inverse. Its
// explicit inverse interface imposes no extra mathematical requirement.
computable def group_from_associative_loop{{U < UU0}}(
  L : Loop(U), assoc : forall x, y, z : L.M. L.mul(L.mul(x, y), z) = L.mul(x, L.mul(y, z))
) :
  Group(U) {
  use L;
  let inverse_op := fun (x : M) => left_div(x, one);
  let left_inverse : forall x : M. inverse_op(x) * x = one := fun (x : M) => quasigroup_left_cancel(
    L.quasigroup, x, inverse_op(x) * x, one,
    trans(
      sym(assoc(x, inverse_op(x), x)),
      trans(cong(fun (w : M) => w * x, mul_left_div(x, one)), trans(one_mul(x), sym(mul_one(x))))
    )
  );
  exact Group.make(
    M := M, M_is_set := M_is_set, mul := mul, mul_assoc := assoc, one := one, one_mul := one_mul,
    mul_one := mul_one, left_div := left_div, right_div := right_div, mul_left_div := mul_left_div,
    left_div_mul := left_div_mul, right_div_mul := right_div_mul, mul_right_div := mul_right_div,
    inv := inverse_op, inv_mul := left_inverse, mul_inv := fun (x : M) => mul_left_div(x, one)
  );
}

// Construct the division structure from the usual group operations and
// inverse laws. This keeps existing integer and rational operations intact.
computable def group_from_inverse(
  U < UU0, M : U, set_ : IsSet(U, M), op : M -> M -> M, assoc : forall x, y, z : M.
  op(op(x, y), z) = op(x, op(y, z)), unit : M, left_unit : forall x : M. op(unit, x) = x,
  right_unit : forall x : M. op(x, unit) = x, inverse_op : M -> M, left_inverse : forall x : M.
  op(inverse_op(x), x) = unit, right_inverse : forall x : M. op(x, inverse_op(x)) = unit
) :
  Group(U) := Group.make(
    M := M, M_is_set := set_, mul := op, mul_assoc := assoc, one := unit, one_mul := left_unit,
    mul_one := right_unit, inv := inverse_op, inv_mul := left_inverse, mul_inv := right_inverse,
    left_div := fun (x, y : M) => op(inverse_op(x), y),
    right_div := fun (x, y : M) => op(x, inverse_op(y)),
    mul_left_div := fun (x, y : M) => trans(
      sym(assoc(x, inverse_op(x), y)),
      trans(cong(fun (w : M) => op(w, y), right_inverse(x)), left_unit(y))
    ),
    left_div_mul := fun (x, y : M) => trans(
      sym(assoc(inverse_op(x), x, y)),
      trans(cong(fun (w : M) => op(w, y), left_inverse(x)), left_unit(y))
    ),
    right_div_mul := fun (x, y : M) => trans(
      assoc(x, inverse_op(y), y),
      trans(cong(fun (w : M) => op(x, w), left_inverse(y)), right_unit(x))
    ),
    mul_right_div := fun (x, y : M) => trans(
      assoc(x, y, inverse_op(y)),
      trans(cong(fun (w : M) => op(x, w), right_inverse(y)), right_unit(x))
    )
  );

// An abelian group: a group whose monoid is commutative. Monoid comes once,
// through both parents.
theory AbelianGroup(U < UU0) extends Group, CommMonoid {}

// A ring: an abelian group for addition and a monoid for multiplication
// on the same set. Both distributive laws are needed without commutativity.
// Subtraction, x - y, is derived: x + -y.
theory Ring(U < UU0) extends additive_ : AbelianGroup(
  M := R, mul := add notation x + y, mul_assoc := add_assoc, one := zero, one_mul := zero_add,
  mul_one := add_zero, inv := neg notation - x, inv_mul := neg_add, mul_inv := add_neg,
  mul_comm := add_comm, left_div := add_left_div, right_div := add_right_div,
  mul_left_div := add_left_div_cancel, left_div_mul := add_left_cancel,
  right_div_mul := add_right_div_cancel, mul_right_div := add_right_cancel
), multiplicative : Monoid(M := R) {
  law mul_add(x, y, z : R) : x * (y + z) = x * y + x * z;
  law distrib_right(x, y, z : R) : (x + y) * z = x * z + y * z;
  def sub(x, y : R) : R := x + -y notation x - y;
  // A natural number in the ring, which reads plain numerals in its
  // notation: one added to itself n times (L2.10c).
  def of_nat(n : Nat) : R := match n {
    zero => zero;
    succ(k) => one + of_nat(k);
  }
  notation numeral;
}

// A commutative ring shares Ring's operations and adds commutativity of
// multiplication. The direct additive parent retains A.additive_; its
// fields are the same ancestor's fields already inherited through Ring.
theory CommRing(U < UU0) extends Ring,
additive_ : AbelianGroup(
  M := R, mul := add notation x + y, mul_assoc := add_assoc, one := zero, one_mul := zero_add,
  mul_one := add_zero, inv := neg notation - x, inv_mul := neg_add, mul_inv := add_neg,
  mul_comm := add_comm, left_div := add_left_div, right_div := add_right_div,
  mul_left_div := add_left_div_cancel, left_div_mul := add_left_cancel,
  right_div_mul := add_right_div_cancel, mul_right_div := add_right_cancel
), multiplicative : CommMonoid(M := R) {}

// A field: a commutative ring in which zero is not one and every element
// but zero merely has a multiplicative inverse (L2.10k). Being a field is a
// property of a ring, so a field's homomorphisms are its ring's. The
// inverse, inv(F, x, nonzero), is derived below by unique choice.
theory Field(U < UU0) extends CommRing {
  law inverses(x : R, nonzero : x = zero -> Void) : Trunc(U, exists y : R. x * y = one);
  law zero_ne_one : zero = one -> Void;
}

// The natural numbers under addition, with 0, and under multiplication,
// with 1.
def nat_additive : CommMonoid(U0) := CommMonoid.make(
  M := Nat, M_is_set := nat_is_set, mul := add, mul_assoc := nat_add_assoc, one := 0,
  one_mul := nat_zero_add, mul_one := nat_add_zero, mul_comm := nat_add_comm
);

def nat_multiplicative : CommMonoid(U0) := CommMonoid.make(
  M := Nat, M_is_set := nat_is_set, mul := mul, mul_assoc := nat_mul_assoc, one := 1,
  one_mul := nat_one_mul, mul_one := nat_mul_one, mul_comm := nat_mul_comm
);

// In any commutative monoid, products regroup freely; for a ring, at its
// multiplicative monoid, A.multiplicative, and its additive one,
// A.additive_.comm_monoid.
section {{U < UU0}}(G : CommMonoid(U)) {
  computable def mul_left_comm(x, y, z : M) : x * (y * z) = y * (x * z) {
    calc {
      x * (y * z) = (x * y) * z by sym(mul_assoc(x, y, z));
      _ = (y * x) * z by cong(fun (w : M) => w * z, mul_comm(x, y));
      _ = y * (x * z) by mul_assoc(y, x, z);
    }
  }

  computable def mul_right_comm(x, y, z : M) : (x * y) * z = (x * z) * y {
    calc {
      (x * y) * z = x * (y * z) by mul_assoc(x, y, z);
      _ = x * (z * y) by cong(fun (w : M) => x * w, mul_comm(y, z));
      _ = (x * z) * y by sym(mul_assoc(x, z, y));
    }
  }

  // (w * x) * (y * z) = (w * y) * (x * z): the middle two trade places.
  computable def mul_interchange(w, x, y, z : M) : (w * x) * (y * z) = (w * y) * (x * z) {
    calc {
      (w * x) * (y * z) = w * (x * (y * z)) by mul_assoc(w, x, y * z);
      _ = w * (y * (x * z)) by cong(fun (v : M) => w * v, mul_left_comm(x, y, z));
      _ = (w * y) * (x * z) by sym(mul_assoc(w, y, x * z));
    }
  }
}

// In any group: cancellation on both sides, and inverses are unique.
section {{U < UU0}}(G : Group(U)) {
  computable def left_cancel(x, y, z : M, p : x * y = x * z) : y = z {
    calc {
      y = one * y by sym(one_mul(y));
      _ = (inv(x) * x) * y by cong(fun (w : M) => w * y, sym(inv_mul(x)));
      _ = inv(x) * (x * y) by mul_assoc(inv(x), x, y);
      _ = inv(x) * (x * z) by cong(fun (w : M) => inv(x) * w, p);
      _ = (inv(x) * x) * z by sym(mul_assoc(inv(x), x, z));
      _ = one * z by cong(fun (w : M) => w * z, inv_mul(x));
      _ = z by one_mul(z);
    }
  }

  computable def right_cancel(x, y, z : M, p : y * x = z * x) : y = z {
    calc {
      y = y * one by sym(mul_one(y));
      _ = y * (x * inv(x)) by cong(fun (w : M) => y * w, sym(mul_inv(x)));
      _ = (y * x) * inv(x) by sym(mul_assoc(y, x, inv(x)));
      _ = (z * x) * inv(x) by cong(fun (w : M) => w * inv(x), p);
      _ = z * (x * inv(x)) by mul_assoc(z, x, inv(x));
      _ = z * one by cong(fun (w : M) => z * w, mul_inv(x));
      _ = z by mul_one(z);
    }
  }

  // An element that multiplies x to one on the left is x's inverse.
  computable def inv_unique(x, y : M, p : y * x = one) :
    y = inv(x) := right_cancel(x, y, inv(x), trans(p, sym(inv_mul(x))));

  computable def inv_inv(x : M) : inv(inv(x)) = x := sym(inv_unique(inv(x), x, mul_inv(x)));

  computable def inv_one : inv(one) = one := sym(inv_unique(one, one, one_mul(one)));

  // The retained inverse is the unique division of the unit on either side.
  computable def inv_as_left_div(x : M) : inv(x) = left_div(x, one) := left_cancel(
    x, inv(x), left_div(x, one), trans(mul_inv(x), sym(mul_left_div(x, one)))
  );

  computable def inv_as_right_div(x : M) : inv(x) = right_div(one, x) := right_cancel(
    x, inv(x), right_div(one, x), trans(inv_mul(x), sym(right_div_mul(one, x)))
  );
}

// In any commutative ring, zero absorbs: x * zero = zero, since
// x * zero + x * zero = x * zero = zero + x * zero, and addition cancels.
section {{U < UU0}}(A : CommRing(U)) {
  computable def mul_zero(x : R) : x * zero = zero {
    let doubled : (x * zero) + (x * zero) = zero + (x * zero) {
      calc {
        (x * zero) + (x * zero) = x * (zero + zero) by sym(mul_add(x, zero, zero));
        _ = x * zero by cong(fun (w : R) => x * w, zero_add(zero));
        _ = zero + (x * zero) by sym(zero_add(x * zero));
      }
    }
    exact right_cancel(A.additive_.group, x * zero, x * zero, zero, doubled);
  }

  computable def zero_mul(x : R) : zero * x = zero := trans(mul_comm(zero, x), mul_zero(x));

  // Keep the existing section lemma at a commutative ring.
  computable def add_mul(x, y, z : R) : (x + y) * z = x * z + y * z := distrib_right(x, y, z);

  // neg(x) * y is the additive inverse of x * y.
  computable def neg_mul(x, y : R) : neg(x) * y = neg(x * y) {
    let inverse_ : neg(x) * y + x * y = zero {
      calc {
        neg(x) * y + x * y = (neg(x) + x) * y by sym(add_mul(neg(x), x, y));
        _ = zero * y by cong(fun (w : R) => w * y, neg_add(x));
        _ = zero by zero_mul(y);
      }
    }
    exact inv_unique(A.additive_.group, x * y, neg(x) * y, inverse_);
  }
}

// In a commutative ring an element has at most one inverse: y = y * (x * z)
// = (x * y) * z = z. So having an inverse is a proposition, which a field's
// truncated law gives without choice.
section {{U < UU0}}(A : CommRing(U)) {
  computable def inverse_unique(x, y, z : R, p : x * y = one, q : x * z = one) : y = z {
    calc {
      y = y * one by sym(mul_one(y));
      _ = y * (x * z) by cong(fun (w : R) => y * w, sym(q));
      _ = (y * x) * z by sym(mul_assoc(y, x, z));
      _ = (x * y) * z by cong(fun (w : R) => w * z, mul_comm(y, x));
      _ = one * z by cong(fun (w : R) => w * z, p);
      _ = z by one_mul(z);
    }
  }

  computable def inverse_is_prop(x : R) :
    IsProp(U, exists y : R. x * y = one) := fun (a, b : exists y : R. x * y = one) => path i => (
      inverse_unique(x, a.1, b.1, a.2, b.2) @ i,
      prop_over(
        U, R, fun (y : R) => x * y = one, fun (y : R) => R_is_set(x * y, one), a.1, b.1,
        inverse_unique(x, a.1, b.1, a.2, b.2), a.2, b.2
      ) @ i
    );
}

// A field's inverse of an element but zero, by unique choice: its
// truncated law eliminates into the proposition of having an inverse. On a
// model whose law is merely of an inverse, as the rationals', it computes.
section {{U < UU0}}(F : Field(U)) {
  computable def inverse_(x : R, nonzero : x = zero -> Void) :
    exists y : R.
    x * y = one := mere_eliminate(
      U, U, exists y : R. x * y = one, exists y : R. x * y = one, inverse_is_prop(F.comm_ring, x),
      fun (w : exists y : R. x * y = one) => w, inverses(x, nonzero)
    );

  computable def inv(x : R, nonzero : x = zero -> Void) : R := inverse_(x, nonzero).1;

  computable def mul_inv(x : R, nonzero : x = zero -> Void) :
    x * inv(x, nonzero) = one := inverse_(x, nonzero).2;
}
