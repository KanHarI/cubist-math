// Classical logic from the library's excluded middle, over Trunc: double
// negation elimination, decidability and resizing of propositions.
import classical_axioms;

def double_negation(U < UU0, P : U, prop_ : IsProp(U, P), h : (P -> Void) -> Void) :
  P := mere_eliminate(U, U, P, P, prop_, fun (p : P) => p, LEM(U, P, h));

def decide_prop(U < UU0, P : U, prop_ : IsProp(U, P)) : P or (P -> Void) := double_negation(
  U, P or (P -> Void), decision_is_prop(U, P, prop_),
  fun (no : (P or (P -> Void)) -> Void) => no(
    typed(P or (P -> Void), right(fun (p : P) => no(typed(P or (P -> Void), left(p)))))
  )
);

// G6: excluded middle resizes a proposition, classical_axioms' PropResize:
// a small proposition with maps in both directions. The hypothesis prop
// prevents its use on an arbitrary witness type.
def resize_prop(P : U1, prop_ : IsProp(U1, P)) :
  PropResize(P) := match decide_prop(U1, P, prop_) return PropResize(P) {
    left p => (Unit, unit_is_prop, fun (q : P) => tt, fun (u : Unit) => p);
    right no => (Void, void_is_prop, no, fun (v : Void) => typed(P, absurd(v)));
  };
