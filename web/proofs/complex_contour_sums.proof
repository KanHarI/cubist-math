import complex_algebra;
import complex_contour_samples;
import contour_examples;
import contour_sums;

// Specialization of the finite quadrature laws to complex coordinates.
// These are finite sums; existence of a contour integral is not asserted.

theorem complex_constant_contour_closed(F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), coefficient : Complex(F), n : Nat,
  vertices : SampleVertices(Complex(F), n), tags : SampleTags(Complex(F), n),
  closed : sample_last(Complex(F), n, vertices) = sample_first(Complex(F), n, vertices)) :
  complex_contour_sum(F, zero, addF, mulF, negF, (fun (z : Complex(F)) => coefficient), n, vertices, tags) = complex_zero(F, zero) {
  let ringC = complex_commutative_ring(F, zero, one, addF, mulF, negF, ring);
  exact contour_sum_constant_closed(Complex(F), complex_zero(F, zero), complex_one(F, zero, one), complex_add(F, addF), complex_mul(F, addF, mulF, negF), complex_neg(F, negF), ringC, coefficient, n, vertices, tags, closed);
}

theorem complex_contour_composes(F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), f : Complex(F) -> Complex(F), n : Nat,
  vertices : SampleVertices(Complex(F), n), tags : SampleTags(Complex(F), n), m : Nat,
  rightVertices : SampleVertices(Complex(F), m), rightTags : SampleTags(Complex(F), m),
  meets : sample_last(Complex(F), n, vertices) = sample_first(Complex(F), m, rightVertices)) :
  complex_contour_sum(F, zero, addF, mulF, negF, f, n + m, join_vertices(Complex(F), n, vertices, m, rightVertices), join_tags(Complex(F), n, tags, m, rightTags)) =
    complex_add(F, addF, complex_contour_sum(F, zero, addF, mulF, negF, f, n, vertices, tags), complex_contour_sum(F, zero, addF, mulF, negF, f, m, rightVertices, rightTags)) {
  let ringC = complex_commutative_ring(F, zero, one, addF, mulF, negF, ring);
  exact contour_sum_join(Complex(F), complex_zero(F, zero), complex_one(F, zero, one), complex_add(F, addF), complex_mul(F, addF, mulF, negF), complex_neg(F, negF), ringC, f, n, vertices, tags, m, rightVertices, rightTags, meets);
}

theorem complex_identity_backtrack_sum(F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF)) :
  complex_contour_sum(F, zero, addF, mulF, negF, (fun (z : Complex(F)) => z), 2, backtrack_vertices(Complex(F), complex_zero(F, zero), complex_one(F, zero, one)), backtrack_tags(Complex(F), complex_zero(F, zero), complex_one(F, zero, one))) = complex_neg(F, negF, complex_one(F, zero, one)) {
  let ringC = complex_commutative_ring(F, zero, one, addF, mulF, negF, ring);
  exact identity_backtrack_sum(Complex(F), complex_zero(F, zero), complex_one(F, zero, one), complex_add(F, addF), complex_mul(F, addF, mulF, negF), complex_neg(F, negF), ringC);
}

theorem complex_identity_backtrack_nonzero(F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), nontrivial : (zero = one) -> Void) :
  (complex_contour_sum(F, zero, addF, mulF, negF, (fun (z : Complex(F)) => z), 2, backtrack_vertices(Complex(F), complex_zero(F, zero), complex_one(F, zero, one)), backtrack_tags(Complex(F), complex_zero(F, zero), complex_one(F, zero, one))) = complex_zero(F, zero)) -> Void {
  let ringC = complex_commutative_ring(F, zero, one, addF, mulF, negF, ring);
  exact identity_backtrack_sum_nonzero(Complex(F), complex_zero(F, zero), complex_one(F, zero, one), complex_add(F, addF), complex_mul(F, addF, mulF, negF), complex_neg(F, negF), ringC, complex_zero_not_one(F, zero, one, nontrivial));
}
