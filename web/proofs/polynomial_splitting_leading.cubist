import polynomial_splitting;
import polynomial_irreducible_factors;

// A product of n monic linear factors is monic of degree n.
theorem linear_factor_leading(K : AlgebraicField, x : af_carrier(K)) :
  polynomial_coefficients(K, polynomial_linear_factor(K, x), 1) = field_one(K) {
  exact scalar_add_zero_right(K, field_one(K));
}

def MonicLinearProduct(K : AlgebraicField, n : Nat, roots : Fin(n) -> af_carrier(K)) =
  (polynomial_cutoff(K, linear_factor_product(K, n, roots)) = succ(n))
  and (polynomial_coefficients(K, linear_factor_product(K, n, roots), n) = field_one(K));

theorem monic_linear_product_step(
  K : AlgebraicField, n : Nat,
  previous : (forall roots : Fin(n) -> af_carrier(K), MonicLinearProduct(K, n, roots)),
  roots : Fin(succ(n)) -> af_carrier(K)
) :
  MonicLinearProduct(K, succ(n), roots) {
  let x = finite_head(af_carrier(K), n, roots);
  let tail = finite_tail(af_carrier(K), n, roots);
  let A = polynomial_linear_factor(K, x);
  let B = linear_factor_product(K, n, tail);
  obtain (db, lb) = previous(tail);
  let da = linear_factor_degree(K, x);
  let fa = polynomial_coefficients(K, A);
  let fb = polynomial_coefficients(K, B);
  let sa =
    transport(SeriesSupport(K, fa), polynomial_cutoff(K, A), 2, da, polynomial_cutoff_support(K, A));
  let sb =
    transport(
      SeriesSupport(K, fb), polynomial_cutoff(K, B), succ(n), db, polynomial_cutoff_support(K, B)
    );
  have leading : polynomial_coefficients(K, polynomial_mul(K, A, B), succ(n)) = field_one(K) {
    exact trans(
      convolution_top(K, 1, fa, fb, n, sa, sb),
      trans(
        cong((fun (a : af_carrier(K)) => field_mul(K, a, fb(n))), linear_factor_leading(K, x)),
        trans(scalar_mul_one(K, fb(n)), lb)
      )
    );
  }
  exact (polynomial_product_degree(K, A, B, 1, n, da, db), leading);
}

theorem monic_linear_product(K : AlgebraicField, n : Nat) =
  induction n as k return (forall roots : Fin(k) -> af_carrier(K), MonicLinearProduct(K, k, roots)) {
    zero => fun (roots : Fin(0) -> af_carrier(K)) => typed(
      MonicLinearProduct(K, 0, roots), (polynomial_one_cutoff(K), refl(field_one(K)))
    );
    succ previous => monic_linear_product_step(K, k, previous);
  };

theorem polynomial_splitting_leading(
  K : AlgebraicField, p : Polynomial(K), n : Nat, roots : Fin(n) -> af_carrier(K),
  a : af_carrier(K),
  equation : p = polynomial_mul(K, polynomial_constant(K, a), linear_factor_product(K, n, roots))
) :
  polynomial_coefficients(K, p, n) = a {
  obtain (degree, leading) = monic_linear_product(K, n, roots);
  exact trans(
    cong((fun (q : Polynomial(K)) => polynomial_coefficients(K, q, n)), equation),
    trans(
      polynomial_scale_coefficient(K, a, linear_factor_product(K, n, roots), n),
      trans(cong(field_mul(K, a), leading), scalar_mul_one_right(K, a))
    )
  );
}
