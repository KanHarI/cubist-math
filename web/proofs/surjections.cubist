import maps;
import truncation;

// A surjection has merely inhabited fibers. A right inverse includes a map
// g : B -> A and the pointwise law f(g(y)) = y (not g(f(x)) = x).
def Surjective(A : U0, B : U0, f : A -> B) = forall y : B, Mere(Fiber(A, B, f, y));

def RightInverse(A : U0, B : U0, f : A -> B) = exists g : B -> A, forall y : B, f(g(y)) = y;

// Explicit preimages already contain the data of a right inverse: no choice.
theorem right_inverse_from_preimages(
  A : U0, B : U0, f : A -> B, preimages : (forall y : B, Fiber(A, B, f, y))
) :
  RightInverse(A, B, f) {
  let g = fun (y : B) => sigma_first(A, (fun (x : A) => f(x) = y), preimages(y));
  exact (g, (fun (y : B) => sigma_second(A, (fun (x : A) => f(x) = y), preimages(y))));
}

theorem fiber_is_set(A : U0, B : U0, setA : IsSet(A), setB : IsSet(B), f : A -> B, y : B) :
  IsSet(Fiber(A, B, f, y)) {
  exact subtype_is_set(A, (fun (x : A) => f(x) = y), setA, (fun (x : A) => setB(f(x), y)));
}

def EverySurjectionHasRightInverse =
  forall A : U0, forall B : U0, IsSet(A) -> IsSet(B) -> forall f : A -> B, Surjective(A, B, f)
  -> Mere(RightInverse(A, B, f));

// Apply the existing set-level axiom of choice to the fibers over B.
// Its conclusion is mere existence; truncation is eliminated only into the
// proposition Mere(RightInverse(...)), never into an arbitrarily chosen map.
theorem every_surjection_has_right_inverse : EverySurjectionHasRightInverse {
  intro A; // A : U0
  intro B; // B : U0
  intro setA; // setA : IsSet(A), from the first implication above
  intro setB; // setB : IsSet(B), from the second implication above
  intro f; // f : A -> B
  intro surjective; // surjective : Surjective(A, B, f)
  let preimages =
    Choice(U0, B, Fiber(A, B, f), setB, fiber_is_set(A, B, setA, setB, f), surjective);
  exact mere_map(
    (forall y : B, Fiber(A, B, f, y)), RightInverse(A, B, f), right_inverse_from_preimages(A, B, f),
    preimages
  );
}
