import finite;

// Multiplication and exponentiation are recurrences on ordinary Nat.
def multiply_count(n : Nat, m : Nat) = induction n as k return Nat {
  zero => 0;
  succ previous => add_count(m, previous);
};
def power_count(m : Nat, n : Nat) = induction n as k return Nat {
  zero => 1;
  succ previous => multiply_count(m, previous);
};

theorem fin_product(n : Nat, m : Nat) = induction n as k return Bijection(Fin(k) and Fin(m), Fin(multiply_count(k, m))) {
  zero => impossible_bijection(Void and Fin(m), fst(Void, Fin(m)));
  succ previous => compose_bijection((Unit or Fin(k)) and Fin(m), Fin(m) or (Fin(k) and Fin(m)), Fin(add_count(m, multiply_count(k, m))),
    product_successor(Fin(k), Fin(m)),
    compose_bijection(Fin(m) or (Fin(k) and Fin(m)), Fin(m) or Fin(multiply_count(k, m)), Fin(add_count(m, multiply_count(k, m))),
      sum_bijection(Fin(m), Fin(k) and Fin(m), Fin(m), Fin(multiply_count(k, m)), identity_bijection(Fin(m)), previous),
      fin_sum(m, multiply_count(k, m))));
};

// A function on n+1 alternatives is one output and a function on n alternatives.
theorem finite_function_count(n : Nat, m : Nat) = induction n as k return Bijection(Fin(k) -> Fin(m), Fin(power_count(m, k))) {
  zero => compose_bijection(Void -> Fin(m), Unit, Fin(1), empty_functions(Fin(m)), unit_to_fin_one);
  succ previous => compose_bijection((Unit or Fin(k)) -> Fin(m), Fin(m) and (Fin(k) -> Fin(m)), Fin(multiply_count(m, power_count(m, k))),
    functions_on_successor(Fin(k), Fin(m)),
    compose_bijection(Fin(m) and (Fin(k) -> Fin(m)), Fin(m) and Fin(power_count(m, k)), Fin(multiply_count(m, power_count(m, k))),
      product_bijection(Fin(m), Fin(k) -> Fin(m), Fin(m), Fin(power_count(m, k)), identity_bijection(Fin(m)), previous),
      fin_product(m, power_count(m, k))));
};

theorem endofunction_count(k : Nat) : Bijection(Fin(k) -> Fin(k), Fin(power_count(k, k))) {
  exact finite_function_count(k, k);
}

theorem three_to_three : Bijection(Fin(3) -> Fin(3), Fin(27)) { exact endofunction_count(3); }
theorem empty_to_empty : Bijection(Fin(0) -> Fin(0), Fin(1)) { exact endofunction_count(0); }

theorem finite_function_equivalence(n : Nat, m : Nat) : Equiv(U0, Fin(n) -> Fin(m), Fin(power_count(m, n))) {
  exact bijection_equiv(Fin(n) -> Fin(m), Fin(power_count(m, n)), fin_is_set(power_count(m, n)), finite_function_count(n, m));
}
