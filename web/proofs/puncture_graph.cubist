import finite;
import suspension;
import path_actions;

// A common spoke and one additional spoke per label give a bouquet of loops.
// This constructs a homotopy type, not yet a comparison with a metric domain.
def Bouquet(A : U0) = Suspension(Unit or A);

def bouquet_base(A : U0) = north(Unit or A);

def bouquet_tip(A : U0) = south(Unit or A);

def bouquet_spoke(A : U0) = meridian(Unit or A, typed(Unit or A, left(tt)));

def bouquet_edge(A : U0, a : A) = meridian(Unit or A, typed(Unit or A, right(a)));

def bouquet_generator(A : U0, a : A) =
  concatenate(
    U1, Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_base(A), bouquet_edge(A, a),
    inverse(U1, Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A))
  );

def BouquetLoops(A : U0) = bouquet_base(A) = bouquet_base(A);

def PunctureGraph(n : Nat) = Bouquet(Fin(n));

def puncture_loop(n : Nat, i : Fin(n)) = bouquet_generator(Fin(n), i);

def bouquet_generator_spoke(A : U0, a : A) :
  concatenate(
    U1, Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_tip(A), bouquet_generator(A, a),
    bouquet_spoke(A)
  ) = bouquet_edge(A, a) {
  exact append_inverse_cancel(
    Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_base(A), bouquet_edge(A, a),
    bouquet_spoke(A)
  );
}

def bouquet_map_edges(A : U0, X : U0, point : X, loops : A -> (point = point), label : Unit or A) =
  match label return (point = point) {
    left u => refl(point);
    right a => loops(a);
  };

def bouquet_map(A : U0, X : U0, point : X, loops : A -> (point = point)) =
  suspension_rec(Unit or A, X, point, point, bouquet_map_edges(A, X, point, loops));

def bouquet_map_generator(A : U0, X : U0, point : X, loops : A -> (point = point), a : A) :
  ap(
    U1, Bouquet(A), X, bouquet_map(A, X, point, loops), bouquet_base(A), bouquet_base(A),
    bouquet_generator(A, a)
  ) = loops(a) {
  let map = bouquet_map(A, X, point, loops);
  let back =
    ap(
      U1, Bouquet(A), X, map, bouquet_tip(A), bouquet_base(A),
      inverse(U1, Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A))
    );
  let edgeLaw =
    suspension_rec_beta(
      Unit or A, X, point, point, bouquet_map_edges(A, X, point, loops), typed(Unit or A, right(a))
    );
  let spokeLaw =
    suspension_rec_beta(
      Unit or A, X, point, point, bouquet_map_edges(A, X, point, loops), typed(Unit or A, left(tt))
    );
  let backLaw =
    trans(
      map_inverse(Bouquet(A), X, map, bouquet_base(A), bouquet_tip(A), bouquet_spoke(A)),
      cong((fun (p : point = point) => inverse(U1, X, point, point, p)), spokeLaw)
    );
  exact trans(
    map_concat(
      Bouquet(A), X, map, bouquet_base(A), bouquet_tip(A), bouquet_base(A), bouquet_edge(A, a),
      inverse(U1, Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A))
    ),
    trans(
      cong((fun (p : point = point) => concatenate(U1, X, point, point, point, p, back)), edgeLaw),
      trans(
        cong(
          (fun (p : point = point) => concatenate(U1, X, point, point, point, loops(a), p)), backLaw
        ), right_unit(X, point, point, loops(a))
      )
    )
  );
}
