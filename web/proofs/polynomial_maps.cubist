import polynomial_roots;

// Change coefficients through a specified field embedding. Formal support,
// coefficient equality and degree are preserved, even over finite fields.
theorem mapped_series_support(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), f : FormalSeries(K), n : Nat,
  support : SeriesSupport(K, f, n)
) :
  SeriesSupport(L, (fun (j : Nat) => field_embedding_map(K, L, e, f(j))), n) {
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  intro j;
  intro above;
  exact trans(cong(field_embedding_map(K, L, e), support(j, above)), zero);
}

def polynomial_map(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K)
) =
  polynomial_of_support(
    L, (fun (j : Nat) => field_embedding_map(K, L, e, polynomial_coefficients(K, p, j))),
    polynomial_cutoff(K, p),
    mapped_series_support(
      K, L, e, polynomial_coefficients(K, p), polynomial_cutoff(K, p),
      polynomial_cutoff_support(K, p)
    )
  );

theorem polynomial_map_injective(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K),
  q : Polynomial(K), same : polynomial_map(K, L, e, p) = polynomial_map(K, L, e, q)
) :
  p = q {
  exact polynomial_coefficient_ext(
    K, p, q,
    (
      fun (j : Nat) => field_embedding_injective(
        K, L, e, polynomial_coefficients(K, p, j), polynomial_coefficients(K, q, j),
        cong((fun (r : Polynomial(L)) => polynomial_coefficients(L, r, j)), same)
      )
    )
  );
}

theorem polynomial_map_cutoff(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K)
) :
  polynomial_cutoff(L, polynomial_map(K, L, e, p)) = polynomial_cutoff(K, p) {
  let q = polynomial_map(K, L, e, p);
  let n = polynomial_cutoff(K, p);
  let m = polynomial_cutoff(L, q);
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  have reflected : SeriesSupport(K, polynomial_coefficients(K, p), m) {
    intro j;
    intro above;
    exact field_embedding_injective(
      K, L, e, polynomial_coefficients(K, p, j), field_zero(K),
      trans(polynomial_cutoff_support(L, q, j, above), sym(zero))
    );
  }
  exact dimension_order_antisymmetric(
    m, n,
    polynomial_cutoff_least(
      L, q, n,
      mapped_series_support(
        K, L, e, polynomial_coefficients(K, p), n, polynomial_cutoff_support(K, p)
      )
    ), polynomial_cutoff_least(K, p, m, reflected)
  );
}

theorem polynomial_map_zero(K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L)) :
  polynomial_map(K, L, e, polynomial_zero(K)) = polynomial_zero(L) {
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  exact polynomial_coefficient_ext(
    L, polynomial_map(K, L, e, polynomial_zero(K)), polynomial_zero(L), (fun (j : Nat) => zero)
  );
}

theorem polynomial_map_constant(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), a : af_carrier(K)
) :
  polynomial_map(K, L, e, polynomial_constant(K, a)) = polynomial_constant(
    L, field_embedding_map(K, L, e, a)
  ) {
  let f = field_embedding_map(K, L, e);
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  have coefficient : forall j : Nat, f(series_constant(K, a, j)) = series_constant(L, f(a), j) {
    intro j;
    exact induction j as k return (f(series_constant(K, a, k)) = series_constant(L, f(a), k)) {
      zero => refl(f(a));
      succ ignored => zero;
    };
  }
  exact polynomial_coefficient_ext(
    L, polynomial_map(K, L, e, polynomial_constant(K, a)), polynomial_constant(L, f(a)), coefficient
  );
}

theorem polynomial_map_add(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K),
  q : Polynomial(K)
) :
  polynomial_map(K, L, e, polynomial_add(K, p, q)) = polynomial_add(
    L, polynomial_map(K, L, e, p), polynomial_map(K, L, e, q)
  ) {
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  exact polynomial_coefficient_ext(
    L, polynomial_map(K, L, e, polynomial_add(K, p, q)),
    polynomial_add(L, polynomial_map(K, L, e, p), polynomial_map(K, L, e, q)),
    (fun (j : Nat) => add(polynomial_coefficients(K, p, j), polynomial_coefficients(K, q, j)))
  );
}

theorem polynomial_map_neg(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K)
) :
  polynomial_map(K, L, e, polynomial_neg(K, p)) = polynomial_neg(L, polynomial_map(K, L, e, p)) {
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  exact polynomial_coefficient_ext(
    L, polynomial_map(K, L, e, polynomial_neg(K, p)), polynomial_neg(L, polynomial_map(K, L, e, p)),
    (fun (j : Nat) => neg(polynomial_coefficients(K, p, j)))
  );
}

theorem convolution_embedding(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat
) :
  forall a : FormalSeries(K), forall b : FormalSeries(K),
  field_embedding_map(K, L, e, convolution(K, n, a, b)) = convolution(
    L, n, (fun (j : Nat) => field_embedding_map(K, L, e, a(j))),
    (fun (j : Nat) => field_embedding_map(K, L, e, b(j)))
  ) {
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  let f = field_embedding_map(K, L, e);
  exact induction n as k return (
    forall a : FormalSeries(K), forall b : FormalSeries(K),
    f(convolution(K, k, a, b)) = convolution(
      L, k, (fun (j : Nat) => f(a(j))), (fun (j : Nat) => f(b(j)))
    )
  ) {
    zero => fun (a : FormalSeries(K)) => fun (b : FormalSeries(K)) => mul(a(0), b(0));
    succ previous => fun (a : FormalSeries(K)) => fun (b : FormalSeries(K)) => trans(
      add(field_mul(K, a(0), b(succ(k))), convolution(K, k, series_tail(K, a), b)),
      trans(
        cong(
          (fun (v : af_carrier(L)) => field_add(L, v, f(convolution(K, k, series_tail(K, a), b)))),
          mul(a(0), b(succ(k)))
        ), cong(field_add(L, field_mul(L, f(a(0)), f(b(succ(k))))), previous(series_tail(K, a), b))
      )
    );
  };
}

theorem polynomial_map_mul(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K),
  q : Polynomial(K)
) :
  polynomial_map(K, L, e, polynomial_mul(K, p, q)) = polynomial_mul(
    L, polynomial_map(K, L, e, p), polynomial_map(K, L, e, q)
  ) {
  exact polynomial_coefficient_ext(
    L, polynomial_map(K, L, e, polynomial_mul(K, p, q)),
    polynomial_mul(L, polynomial_map(K, L, e, p), polynomial_map(K, L, e, q)),
    (
      fun (j : Nat) => convolution_embedding(
        K, L, e, j, polynomial_coefficients(K, p), polynomial_coefficients(K, q)
      )
    )
  );
}

theorem polynomial_map_shift(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K)
) :
  polynomial_map(K, L, e, polynomial_shift(K, p)) = polynomial_shift(L, polynomial_map(K, L, e, p)) {
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  let f = field_embedding_map(K, L, e);
  let a = polynomial_coefficients(K, p);
  have coefficient :
    forall j : Nat, f(series_shift(K, a, j)) = series_shift(L, (fun (i : Nat) => f(a(i))), j) {
    intro j;
    exact induction j as k return (
      f(series_shift(K, a, k)) = series_shift(L, (fun (i : Nat) => f(a(i))), k)
    ) {
      zero => zero;
      succ ignored => refl(f(a(k)));
    };
  }
  exact polynomial_coefficient_ext(
    L, polynomial_map(K, L, e, polynomial_shift(K, p)),
    polynomial_shift(L, polynomial_map(K, L, e, p)), coefficient
  );
}

theorem polynomial_map_identity(K : AlgebraicField, p : Polynomial(K)) :
  polynomial_map(K, K, field_embedding_identity(K), p) = p {
  exact polynomial_coefficient_ext(
    K, polynomial_map(K, K, field_embedding_identity(K), p), p,
    (fun (j : Nat) => refl(polynomial_coefficients(K, p, j)))
  );
}

theorem polynomial_map_composition(
  K : AlgebraicField, L : AlgebraicField, T : AlgebraicField, e : FieldEmbedding(K, L),
  h : FieldEmbedding(L, T), p : Polynomial(K)
) :
  polynomial_map(L, T, h, polynomial_map(K, L, e, p)) = polynomial_map(
    K, T, field_embedding_compose(K, L, T, e, h), p
  ) {
  exact polynomial_coefficient_ext(
    T, polynomial_map(L, T, h, polynomial_map(K, L, e, p)),
    polynomial_map(K, T, field_embedding_compose(K, L, T, e, h), p),
    (
      fun (j : Nat) => refl(
        field_embedding_map(L, T, h, field_embedding_map(K, L, e, polynomial_coefficients(K, p, j)))
      )
    )
  );
}
