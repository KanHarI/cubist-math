import polynomial_factor_omission;
import algebraic_base_change;
import polynomial_root_existence;

// Cancellation of a common linear factor also cancels divisibility evidence.
def polynomial_factor_divisibility_cancel(
  K : AlgebraicField, F : Polynomial(K), nonzero : PolynomialNonzero(K, F), p q a b : Polynomial(K),
  ep : p = polynomial_mul(K, F, a), eq : q = polynomial_mul(K, F, b),
  divides : PolynomialDivides(K, q, p)
) :
  PolynomialDivides(K, b, a) {
  have send :
    (exists w : Polynomial(K), p = polynomial_mul(K, q, w))
    -> (exists w : Polynomial(K), a = polynomial_mul(K, b, w)) {
    intro witness;
    obtain (w, same) = witness;
    exact (
      w,
      polynomial_cancel_nonzero(
        K, F, a, polynomial_mul(K, b, w), nonzero,
        trans(
          sym(ep),
          trans(
            same,
            trans(
              cong((fun (s : Polynomial(K)) => polynomial_mul(K, s, w)), eq),
              polynomial_mul_assoc(K, F, b, w)
            )
          )
        )
      )
    );
  }
  exact mere_map(
    (exists w : Polynomial(K), p = polynomial_mul(K, q, w)),
    (exists w : Polynomial(K), a = polynomial_mul(K, b, w)), send, divides
  );
}

def unit_distinct_splitting(
  K : AlgebraicField, p : Polynomial(K), nonzero : PolynomialNonzero(K, p),
  unit : PolynomialUnit(K, p)
) :
  DistinctPolynomialSplitting(K, p, polynomial_degree(K, p)) {
  let degree = polynomial_unit_cutoff(K, p, nonzero, unit);
  obtain (roots, a, eq) = polynomial_splitting_zero_degree(K, p, degree);
  let splitting =
    typed(
      DistinctPolynomialSplitting(K, p, 0),
      (roots, a, eq, (fun (i j : Fin(0)) (same : roots(i) = roots(j)) => typed((i = j), absurd(i))))
    );
  exact along DistinctPolynomialSplitting(K, p) by sym(cong(natural_predecessor, degree)) from splitting;
}

def DistinctSplittingDivisors(K : AlgebraicField, n : Nat) =
  forall p : Polynomial(K), PolynomialNonzero(K, p) -> DistinctPolynomialSplitting(K, p, n)
  -> forall q : Polynomial(K), PolynomialNonzero(K, q) -> PolynomialDivides(K, q, p)
  -> Mere(DistinctPolynomialSplitting(K, q, polynomial_degree(K, q)));

// The selected root is absent from every root of the remaining divisor.
def omitted_divisor_roots_avoid(
  K : AlgebraicField, n : Nat, roots : Fin(succ(n)) -> af_carrier(K),
  distinct : Injective(Fin(succ(n)), af_carrier(K), roots), index : Fin(succ(n)), a : af_carrier(K),
  p : Polynomial(K),
  equation : p = polynomial_mul(
    K, polynomial_constant(K, a),
    linear_factor_product(K, n, (fun (j : Fin(n)) => roots(fin_omit(n, index, j))))
  ), nonzero : PolynomialNonzero(K, p), q : Polynomial(K), divides : PolynomialDivides(K, q, p),
  x : af_carrier(K), root : PolynomialRoot(K, K, field_embedding_identity(K), q, x),
  same : x = roots(index)
) :
  Void {
  let rs = fun (j : Fin(n)) => roots(fin_omit(n, index, j));
  let rp = polynomial_divisor_root(K, K, field_embedding_identity(K), p, q, divides, x, root);
  have contradict : (exists j : Fin(n), rs(j) = x) -> Void {
    intro w;
    obtain (j, eq) = w;
    exact distinct_roots_omit_avoid(K, n, roots, distinct, index, j, trans(eq, same));
  }
  exact mere_eliminate(
    (exists j : Fin(n), rs(j) = x), Void, (fun (u v : Void) => typed((u = v), absurd(u))),
    contradict, splitting_root_index(K, p, n, rs, a, equation, nonzero, x, rp)
  );
}

def distinct_splitting_divisor_at_root(
  K : AlgebraicField, n : Nat, previous : DistinctSplittingDivisors(K, n), p : Polynomial(K),
  nonzero : PolynomialNonzero(K, p), roots : Fin(succ(n)) -> af_carrier(K), a : af_carrier(K),
  equation : p = polynomial_mul(
    K, polynomial_constant(K, a), linear_factor_product(K, succ(n), roots)
  ), distinct : Injective(Fin(succ(n)), af_carrier(K), roots), q : Polynomial(K),
  nonzeroQ : PolynomialNonzero(K, q), divides : PolynomialDivides(K, q, p), index : Fin(succ(n)),
  rootQ : PolynomialRoot(K, K, field_embedding_identity(K), q, roots(index))
) :
  Mere(DistinctPolynomialSplitting(K, q, polynomial_degree(K, q))) {
  let x = roots(index);
  let F = polynomial_linear_factor(K, x);
  let rest = (fun (j : Fin(n)) => roots(fin_omit(n, index, j)));
  let P = linear_factor_product(K, n, rest);
  let C = polynomial_constant(K, a);
  let tailP = polynomial_mul(K, C, P);
  let ep =
    trans(
      equation,
      trans(
        cong(polynomial_mul(K, C), linear_factor_product_omit(K, n, roots, index)),
        polynomial_mul_swap(K, C, F, P)
      )
    );
  let nzP = factor_quotient_nonzero(K, p, F, tailP, ep, nonzero);
  obtain (tailQ, eq) = polynomial_factor_theorem(K, q, x, rootQ);
  let nzQ = factor_quotient_nonzero(K, q, F, tailQ, eq, nonzeroQ);
  let divided =
    polynomial_factor_divisibility_cancel(
      K, F, linear_factor_nonzero(K, x), p, q, tailP, tailQ, ep, eq, divides
    );
  let splitP =
    typed(
      DistinctPolynomialSplitting(K, tailP, n),
      (rest, a, refl(tailP), distinct_roots_omit(K, n, roots, distinct, index))
    );
  let m = polynomial_degree(K, tailQ);
  let Goal = DistinctPolynomialSplitting(K, q, polynomial_degree(K, q));
  have extend : DistinctPolynomialSplitting(K, tailQ, m) -> Goal {
    intro splitting;
    obtain (rs, b, fact, distinctQ) = splitting;
    have avoids : forall i : Fin(m), (rs(i) = x) -> Void {
      intro i same;
      exact omitted_divisor_roots_avoid(
        K, n, roots, distinct, index, a, tailP, refl(tailP), nzP, tailQ, divided, rs(i),
        splitting_listed_root(K, tailQ, m, rs, b, fact, i), same
      );
    }
    obtain (newRoots, scalar, factor) = polynomial_splitting_prepend(
      K, q, tailQ, x, eq, m, typed(PolynomialSplitting(K, tailQ, m), (rs, b, fact))
    );
    let result =
      typed(
        DistinctPolynomialSplitting(K, q, succ(m)),
        (newRoots, scalar, factor, distinct_roots_prepend(K, m, x, rs, distinctQ, avoids))
      );
    obtain (d, degree) = polynomial_nonzero_degree(K, tailQ, nzQ);
    let productDegree =
      trans(
        cong(polynomial_cutoff(K), eq),
        polynomial_product_degree(K, F, tailQ, 1, d, linear_factor_degree(K, x), degree)
      );
    let size =
      trans(
        cong(natural_predecessor, productDegree),
        sym(cong((fun (k : Nat) => succ(natural_predecessor(k))), degree))
      );
    exact along DistinctPolynomialSplitting(K, q) by sym(size) from result;
  }
  exact mere_map(
    DistinctPolynomialSplitting(K, tailQ, m), Goal, extend,
    previous(tailP, nzP, splitP, tailQ, nzQ, divided)
  );
}

def distinct_splitting_divisor_zero(K : AlgebraicField, closed : AlgebraicallyClosed(K)) :
  DistinctSplittingDivisors(K, 0) {
  intro p nonzero splitting q nonzeroQ divides;
  obtain (roots, a, equation, distinct) = splitting;
  let Goal = DistinctPolynomialSplitting(K, q, polynomial_degree(K, q));
  have nonunit : (PolynomialUnit(K, q) -> Void) -> Mere(Goal) {
    intro nu;
    have rootImpossible :
      (exists x : af_carrier(K), PolynomialRoot(K, K, field_embedding_identity(K), q, x))
      -> Mere(Goal) {
      intro w;
      obtain (x, root) = w;
      let rp = polynomial_divisor_root(K, K, field_embedding_identity(K), p, q, divides, x, root);
      exact mere_eliminate(
        (exists i : Fin(0), roots(i) = x), Mere(Goal), mere_is_prop(Goal),
        (
          fun (w : (exists i : Fin(0), roots(i) = x)) => typed(
            Mere(Goal), absurd(sigma_first(Fin(0), (fun (i : Fin(0)) => roots(i) = x), w))
          )
        ), splitting_root_index(K, p, 0, roots, a, equation, nonzero, x, rp)
      );
    }
    exact mere_eliminate(
      (exists x : af_carrier(K), PolynomialRoot(K, K, field_embedding_identity(K), q, x)),
      Mere(Goal), mere_is_prop(Goal), rootImpossible, closed(q, nonzeroQ, nu)
    );
  }
  exact match excluded_middle(
    PolynomialUnit(K, q),
    mere_is_prop(exists r : Polynomial(K), polynomial_mul(K, q, r) = polynomial_one(K))
  ) return Mere(Goal) {
    left unit => merely(Goal, unit_distinct_splitting(K, q, nonzeroQ, unit));
    right nu => nonunit(nu);
  };
}

def distinct_splitting_divisor_step(
  K : AlgebraicField, closed : AlgebraicallyClosed(K), n : Nat,
  previous : DistinctSplittingDivisors(K, n)
) :
  DistinctSplittingDivisors(K, succ(n)) {
  intro p nonzero splitting q nonzeroQ divides;
  obtain (roots, a, equation, distinct) = splitting;
  let Goal = DistinctPolynomialSplitting(K, q, polynomial_degree(K, q));
  have nonunit : (PolynomialUnit(K, q) -> Void) -> Mere(Goal) {
    intro nu;
    have useRoot :
      (exists x : af_carrier(K), PolynomialRoot(K, K, field_embedding_identity(K), q, x))
      -> Mere(Goal) {
      intro w;
      obtain (x, root) = w;
      let rp = polynomial_divisor_root(K, K, field_embedding_identity(K), p, q, divides, x, root);
      have locate : (exists i : Fin(succ(n)), roots(i) = x) -> Mere(Goal) {
        intro witness;
        obtain (i, same) = witness;
        exact distinct_splitting_divisor_at_root(
          K, n, previous, p, nonzero, roots, a, equation, distinct, q, nonzeroQ, divides, i,
          along PolynomialRoot(K, K, field_embedding_identity(K), q) by sym(same) from root
        );
      }
      exact mere_eliminate(
        (exists i : Fin(succ(n)), roots(i) = x), Mere(Goal), mere_is_prop(Goal), locate,
        splitting_root_index(K, p, succ(n), roots, a, equation, nonzero, x, rp)
      );
    }
    exact mere_eliminate(
      (exists x : af_carrier(K), PolynomialRoot(K, K, field_embedding_identity(K), q, x)),
      Mere(Goal), mere_is_prop(Goal), useRoot, closed(q, nonzeroQ, nu)
    );
  }
  exact match excluded_middle(
    PolynomialUnit(K, q),
    mere_is_prop(exists r : Polynomial(K), polynomial_mul(K, q, r) = polynomial_one(K))
  ) return Mere(Goal) {
    left unit => merely(Goal, unit_distinct_splitting(K, q, nonzeroQ, unit));
    right nu => nonunit(nu);
  };
}

def distinct_splitting_divisor(K : AlgebraicField, closed : AlgebraicallyClosed(K), n : Nat) =
  induction n as k return DistinctSplittingDivisors(K, k) {
    zero => distinct_splitting_divisor_zero(K, closed);
    succ previous => distinct_splitting_divisor_step(K, closed, k, previous);
  };
