// Two
// Complete checked construction. All intermediate steps are included.
construction two {
  private s0001_UnitForm = unit_type();
  private s0002_UnitIntro = unit_value();
  private s0003_UIntroOmega = universe_omega();
  private s0004_SumForm = either_type(s0001_UnitForm, s0001_UnitForm);
  private s0005_Def = define(s0004_SumForm);
  private s0006_DefEqSwp = definition_symmetry(s0005_Def);
  export lib_Two = definition_left(s0005_Def);
  private s0008_SumIntroL = either_left(s0001_UnitForm, s0001_UnitForm, s0002_UnitIntro);
  private s0009_Subs = substitute(s0008_SumIntroL, s0006_DefEqSwp);
  private s0010_Def = define(s0009_Subs);
  export lib_zero2 = definition_left(s0010_Def);
  private s0012_SumIntroR = either_right(s0001_UnitForm, s0001_UnitForm, s0002_UnitIntro);
  private s0013_Subs = substitute(s0012_SumIntroR, s0006_DefEqSwp);
  private s0014_Def = define(s0013_Subs);
  export lib_one2 = definition_left(s0014_Def);
  private s0016_CtxExt = assume(lib_Two, none);
  private s0017_Vble = variable(s0016_CtxExt);
  private s0018_Subs = substitute(s0017_Vble, s0005_Def);
  private s0019_CtxExt = assume(s0003_UIntroOmega, none);
  private s0020_UVble = universe_variable(s0019_CtxExt);
  private s0021_PiForm = function_type(lib_Two, s0020_UVble, none);
  private s0022_CtxExt = assume(s0021_PiForm, none);
  private s0023_Vble = variable(s0022_CtxExt);
  private s0024_Subs = substitute(s0023_Vble, s0005_Def);
  private s0025_CtxExt = assume(s0004_SumForm, none);
  private s0026_Vble = variable(s0025_CtxExt);
  private s0027_PiElim = apply(s0024_Subs, s0026_Vble);
  private s0028_CtxExt = assume(s0001_UnitForm, none);
  private s0029_Vble = variable(s0028_CtxExt);
  private s0030_SumIntroL = either_left(s0001_UnitForm, s0001_UnitForm, s0029_Vble);
  private s0031_SumIntroR = either_right(s0001_UnitForm, s0001_UnitForm, s0029_Vble);
  private s0032_PiElim = apply(s0024_Subs, s0030_SumIntroL);
  private s0033_PiElim = apply(s0024_Subs, s0031_SumIntroR);
  private s0034_PiElim = apply(s0023_Vble, lib_zero2);
  private s0035_PiElim = apply(s0023_Vble, lib_one2);
  private s0036_CtxExt = assume(s0034_PiElim, none);
  private s0037_CtxExt = assume(s0035_PiElim, none);
  private s0038_Vble = variable(s0036_CtxExt);
  private s0039_Vble = variable(s0037_CtxExt);
  private s0040_Subs = substitute(s0038_Vble, s0010_Def);
  private s0041_Subs = substitute(s0039_Vble, s0014_Def);
  private s0042_UnitElim = unit_eliminate(s0032_PiElim, s0040_Subs, s0029_Vble, s0028_CtxExt);
  private s0043_UnitElim = unit_eliminate(s0033_PiElim, s0041_Subs, s0029_Vble, s0028_CtxExt);
  private s0044_SumElim = either_eliminate(s0027_PiElim, s0042_UnitElim, s0043_UnitElim, s0026_Vble, s0025_CtxExt, s0028_CtxExt, s0028_CtxExt);
  private s0045_PiIntro = function_intro(s0004_SumForm, s0044_SumElim, s0025_CtxExt);
  private s0046_PiElim = apply(s0045_PiIntro, s0018_Subs);
  private s0047_BetaReduceGrossKnuth = reduce_pass(s0046_PiElim);
  private s0048_PiIntro = function_intro(lib_Two, s0047_BetaReduceGrossKnuth, s0016_CtxExt);
  private s0049_PiIntro = function_intro(s0035_PiElim, s0048_PiIntro, s0037_CtxExt);
  private s0050_PiIntro = function_intro(s0034_PiElim, s0049_PiIntro, s0036_CtxExt);
  private s0051_PiIntro = function_intro(s0021_PiForm, s0050_PiIntro, s0022_CtxExt);
  private s0052_PiIntro = function_intro(s0003_UIntroOmega, s0051_PiIntro, s0019_CtxExt);
  private s0053_Def = define(s0052_PiIntro);
  export lib_ind2 = definition_left(s0053_Def);
  private s0055_PiElim = apply(lib_ind2, s0020_UVble);
  private s0056_PiElim = apply(s0055_PiElim, s0023_Vble);
  private s0057_PiElim = apply(s0056_PiElim, s0038_Vble);
  private s0058_PiElim = apply(s0057_PiElim, s0039_Vble);
  private s0059_PiElim = apply(s0058_PiElim, lib_zero2);
  private s0060_DefEqRefl = definition_refl(s0059_PiElim);
  private s0061_HighExp = select_expression(s0060_DefEqRefl);
  private s0062_High1 = select_second(s0061_HighExp);
  private s0063_HighSubs = rewrite_selected(s0062_High1, s0053_Def);
  private s0064_HighSubs = rewrite_selected(s0063_HighSubs, s0010_Def);
  private s0065_BetaReduceGrossKnuth = reduce_pass(s0064_HighSubs);
  private s0066_BetaReduceGrossKnuth = reduce_pass(s0065_BetaReduceGrossKnuth);
  private s0067_BetaReduceGrossKnuth = reduce_pass(s0066_BetaReduceGrossKnuth);
  private s0068_PiIntro = function_intro(s0035_PiElim, s0067_BetaReduceGrossKnuth, s0037_CtxExt);
  private s0069_PiIntro = function_intro(s0034_PiElim, s0068_PiIntro, s0036_CtxExt);
  private s0070_PiIntro = function_intro(s0021_PiForm, s0069_PiIntro, s0022_CtxExt);
  export lib_comp2_zero = function_intro(s0003_UIntroOmega, s0070_PiIntro, s0019_CtxExt);
  private s0072_PiElim = apply(s0058_PiElim, lib_one2);
  private s0073_DefEqRefl = definition_refl(s0072_PiElim);
  private s0074_HighExp = select_expression(s0073_DefEqRefl);
  private s0075_High1 = select_second(s0074_HighExp);
  private s0076_HighSubs = rewrite_selected(s0075_High1, s0053_Def);
  private s0077_HighSubs = rewrite_selected(s0076_HighSubs, s0014_Def);
  private s0078_BetaReduceGrossKnuth = reduce_pass(s0077_HighSubs);
  private s0079_BetaReduceGrossKnuth = reduce_pass(s0078_BetaReduceGrossKnuth);
  private s0080_BetaReduceGrossKnuth = reduce_pass(s0079_BetaReduceGrossKnuth);
  private s0081_PiIntro = function_intro(s0035_PiElim, s0080_BetaReduceGrossKnuth, s0037_CtxExt);
  private s0082_PiIntro = function_intro(s0034_PiElim, s0081_PiIntro, s0036_CtxExt);
  private s0083_PiIntro = function_intro(s0021_PiForm, s0082_PiIntro, s0022_CtxExt);
  export lib_comp2_one = function_intro(s0003_UIntroOmega, s0083_PiIntro, s0019_CtxExt);
}
