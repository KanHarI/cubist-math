import artin_equivariance;
import finite_linear_lifts;
import extension_degree;
import natural_minimum;

// A family of n spanning vectors bounds the size of any basis by n. The
// proof lifts a basis through the family's surjection and applies the checked
// finite-coordinate injection bound.
def finite_spanning_basis_size_bound(
  K : AlgebraicField, V : VectorSpace(K), n : Nat, vectors : Fin(n) -> vector_carrier(K, V),
  spanning : FiniteSpanningFamily(K, V, n, vectors), m : Nat, basis : FiniteBasis(K, V, m)
) :
  le(m, n) {
  let C = CoordinateSpace(K, n);
  let D = CoordinateSpace(K, m);
  let f = family_linear(K, V, n, vectors);
  let h = basis_expansion(K, V, m, basis);
  let X = FiniteLinearLift(K, C, V, f, m, h);
  have bound : X -> le(m, n) {
    intro witness;
    obtain (lift, commute) = witness;
    have injective : CoordinateInjection(K, m, n, lift) {
      intro x;
      intro y;
      intro same;
      exact linear_iso_injective(
        K, D, V, basis, x, y,
        trans(sym(commute(x)), trans(cong(linear_map(K, C, V, f), same), commute(y)))
      );
    }
    exact coordinate_injection_bound(K, n, m, lift, injective);
  }
  exact mere_eliminate(
    X, le(m, n), natural_order_prop(m, n), bound,
    finite_linear_lift(K, C, V, f, family_linear_surjective(K, V, n, vectors, spanning), m, h)
  );
}

def finite_spanning_dimension_bound(
  K : AlgebraicField, V : VectorSpace(K), n : Nat, vectors : Fin(n) -> vector_carrier(K, V),
  spanning : FiniteSpanningFamily(K, V, n, vectors), m : Nat, dimension : HasDimension(K, V, m)
) :
  le(m, n) {
  exact mere_eliminate(
    FiniteBasis(K, V, m), le(m, n), natural_order_prop(m, n),
    (
      fun (basis : FiniteBasis(K, V, m)) => finite_spanning_basis_size_bound(
        K, V, n, vectors, spanning, m, basis
      )
    ), dimension
  );
}

// The upper-bound half of Artin's degree theorem: a finite subgroup with n
// automorphisms makes E finite-dimensional over its fixed field, of degree at
// most n. The lower bound and automorphism classification are separate steps.
def finite_subgroup_fixed_degree_upper_bound(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), n : Nat,
  finite : HasCardinality(SubgroupCarrier(GaloisGroup(K, E), H), n)
) :
  exists finiteExtension : FiniteExtension(
    intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
    intermediate_overfield(K, E, fixed_intermediate_field(K, E, H))
  ),
  le(
    extension_degree(
      intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
      intermediate_overfield(K, E, fixed_intermediate_field(K, E, H)), finiteExtension
    ), n
  ) {
  let M = fixed_intermediate_field(K, E, H);
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let i = intermediate_ambient_embedding(K, E, M);
  let V = field_vector_space(R, F, i);
  let Result =
    exists finiteExtension : FiniteExtension(R, intermediate_overfield(K, E, M)),
    le(extension_degree(R, intermediate_overfield(K, E, M), finiteExtension), n);
  let Basis =
    exists enumeration : Bijection(Fin(n), SubgroupCarrier(GaloisGroup(K, E), H)),
    exists points : Fin(n) -> extension_carrier(K, E),
    FamilyBasis(
      F, CoordinateSpace(F, n), n,
      (
        fun (j : Fin(n)) => embedding_evaluation_vector(
          F, F, n, subgroup_evaluation_maps(K, E, H, n, enumeration), points(j)
        )
      )
    );
  have fromBasis : Basis -> Result {
    intro witness;
    obtain (enumeration, points, basis) = witness;
    let spanning = subgroup_evaluation_spans_fixed_field(K, E, H, n, enumeration, points, basis);
    let finiteExtension = finite_spanning_dimension(R, V, n, points, spanning);
    let bound =
      finite_spanning_dimension_bound(
        R, V, n, points, spanning,
        extension_degree(R, intermediate_overfield(K, E, M), finiteExtension),
        extension_degree_specification(R, intermediate_overfield(K, E, M), finiteExtension)
      );
    exact (finiteExtension, bound);
  }
  exact mere_eliminate(
    Basis, Result,
    sigma_prop(
      FiniteExtension(R, intermediate_overfield(K, E, M)),
      (
        fun (proof : FiniteExtension(R, intermediate_overfield(K, E, M))) => le(
          extension_degree(R, intermediate_overfield(K, E, M), proof), n
        )
      ), finite_extension_prop(R, intermediate_overfield(K, E, M)),
      (
        fun (proof : FiniteExtension(R, intermediate_overfield(K, E, M))) => natural_order_prop(
          extension_degree(R, intermediate_overfield(K, E, M), proof), n
        )
      )
    ), fromBasis, finite_subgroup_evaluation_basis(K, E, H, n, finite)
  );
}

// The same evaluation points are independent over the fixed field: any
// fixed-field relation remains a relation after every subgroup automorphism,
// and the evaluation vectors are independent over the ambient field.
def subgroup_evaluation_points_independent(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), n : Nat,
  enumeration : Bijection(Fin(n), SubgroupCarrier(GaloisGroup(K, E), H)), points : Fin(n)
  -> extension_carrier(K, E),
  basis : FamilyBasis(
    extension_field(K, E), CoordinateSpace(extension_field(K, E), n), n,
    (
      fun (j : Fin(n)) => embedding_evaluation_vector(
        extension_field(K, E), extension_field(K, E), n,
        subgroup_evaluation_maps(K, E, H, n, enumeration), points(j)
      )
    )
  )
) :
  LinearInjective(
    intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
    CoordinateSpace(intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)), n),
    field_vector_space(
      intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
      intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H))
    ),
    family_linear(
      intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
      field_vector_space(
        intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
        intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H))
      ), n, points
    )
  ) {
  let M = fixed_intermediate_field(K, E, H);
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let i = intermediate_ambient_embedding(K, E, M);
  let V = field_vector_space(R, F, i);
  let C = CoordinateSpace(F, n);
  let maps = subgroup_evaluation_maps(K, E, H, n, enumeration);
  let rows = fun (j : Fin(n)) => embedding_evaluation_vector(F, F, n, maps, points(j));
  let source = family_linear(R, V, n, points);
  let eval = family_linear(F, C, n, rows);
  let indexed = forward(Fin(n), SubgroupCarrier(GaloisGroup(K, E), H), enumeration);
  obtain (evalInjective, evalOnto) = basis;
  have kernel :
    forall a : Fin(n) -> af_carrier(R),
    linear_map(R, CoordinateSpace(R, n), V, source, a) = vector_zero(R, V)
    -> a = vector_zero(R, CoordinateSpace(R, n)) {
    intro a;
    intro vanishes;
    let c = fun (j : Fin(n)) => field_embedding_map(R, F, i, a(j));
    have baseZero :
      field_sum(F, n, (fun (j : Fin(n)) => field_mul(F, c(j), points(j)))) = field_zero(F) {
      exact trans(
        sym(field_vector_combination_sum(R, F, i, n, points, a)),
        trans(sym(family_linear_evaluation(R, V, n, points, a)), vanishes)
      );
    }
    have evalZero :
      forall t : Fin(n),
      field_sum(
        F, n,
        (fun (j : Fin(n)) => field_mul(F, c(j), field_embedding_map(F, F, maps(t), points(j))))
      ) = field_zero(F) {
      intro t;
      let h = indexed(t);
      let e = maps(t);
      obtain (zero, one, neg, add, mul) = field_embedding_preserves(F, F, e);
      let mapped =
        fun (j : Fin(n)) => field_mul(
          F, field_embedding_map(F, F, e, c(j)), field_embedding_map(F, F, e, points(j))
        );
      let raw = fun (j : Fin(n)) => field_mul(F, c(j), field_embedding_map(F, F, e, points(j)));
      have fixed : forall j : Fin(n), field_embedding_map(F, F, e, c(j)) = c(j) {
        intro j;
        exact subgroup_member_fixes_intermediate(
          K, E, H, h, c(j), subfield_evidence(F, intermediate_subfield(K, E, M), a(j))
        );
      }
      exact trans(
        sym(
          field_sum_cong(
            F, n, mapped, raw,
            (
              fun (j : Fin(n)) => cong(
                (
                  fun (z : af_carrier(F)) => field_mul(
                    F, z, field_embedding_map(F, F, e, points(j))
                  )
                ), fixed(j)
              )
            )
          )
        ),
        trans(
          sym(embedding_preserves_weighted_sum(F, e, n, c, points)),
          trans(cong(field_embedding_map(F, F, e), baseZero), zero)
        )
      );
    }
    have combinationZero : linear_combination(F, C, n, rows, c) = vector_zero(F, C) {
      exact FunExt(
        U0, Fin(n), (fun (t : Fin(n)) => af_carrier(F)), linear_combination(F, C, n, rows, c),
        vector_zero(F, C),
        (
          fun (t : Fin(n)) => trans(
            coordinate_combination_component(F, n, t, n, rows, c), evalZero(t)
          )
        )
      );
    }
    have cZero : c = vector_zero(F, C) {
      exact evalInjective(
        c, vector_zero(F, C),
        trans(
          family_linear_evaluation(F, C, n, rows, c),
          trans(combinationZero, sym(linear_zero(F, C, C, eval)))
        )
      );
    }
    obtain (baseZeroMap, baseOne, baseNeg, baseAdd, baseMul) = field_embedding_preserves(R, F, i);
    exact FunExt(
      U0, Fin(n), (fun (j : Fin(n)) => af_carrier(R)), a, vector_zero(R, CoordinateSpace(R, n)),
      (
        fun (j : Fin(n)) => field_embedding_injective(
          R, F, i, a(j), field_zero(R),
          trans(cong((fun (v : Fin(n) -> af_carrier(F)) => v(j)), cZero), sym(baseZeroMap))
        )
      )
    );
  }
  exact linear_kernel_injective(R, CoordinateSpace(R, n), V, source, kernel);
}

def finite_independent_basis_size_bound(
  K : AlgebraicField, V : VectorSpace(K), n : Nat, vectors : Fin(n) -> vector_carrier(K, V),
  independent : LinearInjective(K, CoordinateSpace(K, n), V, family_linear(K, V, n, vectors)),
  m : Nat, basis : FiniteBasis(K, V, m)
) :
  le(n, m) {
  let C = CoordinateSpace(K, n);
  let D = CoordinateSpace(K, m);
  let f = family_linear(K, V, n, vectors);
  let inverse = linear_iso_inverse(K, D, V, basis);
  let coordinates = linear_iso_forward(K, V, D, inverse);
  let composite = linear_compose(K, C, V, D, f, coordinates);
  have injective : CoordinateInjection(K, n, m, composite) {
    intro x;
    intro y;
    intro same;
    exact independent(
      x, y,
      linear_iso_injective(
        K, V, D, inverse, linear_map(K, C, V, f, x), linear_map(K, C, V, f, y), same
      )
    );
  }
  exact coordinate_injection_bound(K, m, n, composite, injective);
}

def finite_independent_dimension_bound(
  K : AlgebraicField, V : VectorSpace(K), n : Nat, vectors : Fin(n) -> vector_carrier(K, V),
  independent : LinearInjective(K, CoordinateSpace(K, n), V, family_linear(K, V, n, vectors)),
  m : Nat, dimension : HasDimension(K, V, m)
) :
  le(n, m) {
  exact mere_eliminate(
    FiniteBasis(K, V, m), le(n, m), natural_order_prop(n, m),
    (
      fun (basis : FiniteBasis(K, V, m)) => finite_independent_basis_size_bound(
        K, V, n, vectors, independent, m, basis
      )
    ), dimension
  );
}

def finite_subgroup_fixed_degree_lower_bound(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), n : Nat,
  finite : HasCardinality(SubgroupCarrier(GaloisGroup(K, E), H), n),
  finiteExtension : FiniteExtension(
    intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
    intermediate_overfield(K, E, fixed_intermediate_field(K, E, H))
  )
) :
  le(
    n,
    extension_degree(
      intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
      intermediate_overfield(K, E, fixed_intermediate_field(K, E, H)), finiteExtension
    )
  ) {
  let M = fixed_intermediate_field(K, E, H);
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let i = intermediate_ambient_embedding(K, E, M);
  let V = field_vector_space(R, F, i);
  let d = extension_degree(R, intermediate_overfield(K, E, M), finiteExtension);
  let Basis =
    exists enumeration : Bijection(Fin(n), SubgroupCarrier(GaloisGroup(K, E), H)),
    exists points : Fin(n) -> extension_carrier(K, E),
    FamilyBasis(
      F, CoordinateSpace(F, n), n,
      (
        fun (j : Fin(n)) => embedding_evaluation_vector(
          F, F, n, subgroup_evaluation_maps(K, E, H, n, enumeration), points(j)
        )
      )
    );
  have fromBasis : Basis -> le(n, d) {
    intro witness;
    obtain (enumeration, points, basis) = witness;
    let independent =
      subgroup_evaluation_points_independent(K, E, H, n, enumeration, points, basis);
    exact finite_independent_dimension_bound(
      R, V, n, points, independent, d,
      extension_degree_specification(R, intermediate_overfield(K, E, M), finiteExtension)
    );
  }
  exact mere_eliminate(
    Basis, le(n, d), natural_order_prop(n, d), fromBasis,
    finite_subgroup_evaluation_basis(K, E, H, n, finite)
  );
}

// Artin's fixed-field degree theorem for every merely finite subgroup of
// extension automorphisms. Both inequalities come from the same evaluation
// basis: its points span over the fixed field and are independent there.
def artin_fixed_field_degree(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), n : Nat,
  finite : HasCardinality(SubgroupCarrier(GaloisGroup(K, E), H), n)
) :
  exists finiteExtension : FiniteExtension(
    intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
    intermediate_overfield(K, E, fixed_intermediate_field(K, E, H))
  ),
  extension_degree(
    intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
    intermediate_overfield(K, E, fixed_intermediate_field(K, E, H)), finiteExtension
  ) = n {
  obtain (finiteExtension, upper) = finite_subgroup_fixed_degree_upper_bound(K, E, H, n, finite);
  let lower = finite_subgroup_fixed_degree_lower_bound(K, E, H, n, finite, finiteExtension);
  exact (
    finiteExtension,
    dimension_order_antisymmetric(
      extension_degree(
        intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)),
        intermediate_overfield(K, E, fixed_intermediate_field(K, E, H)), finiteExtension
      ), n, upper, lower
    )
  );
}
