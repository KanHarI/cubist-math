import finite_decisions;
import subgroups;
import intermediate_fields;

// Decidability is additional structure on a subobject, not a consequence of
// the ambient carrier being finite. Its proof is unique for a proposition.
def SubgroupDecisions(G : Group, S : Subgroup(G)) =
  forall x : group_carrier(G), Decidable(subgroup_members(G, S, x));

def DecidableSubgroup(G : Group) = exists S : Subgroup(G), SubgroupDecisions(G, S);

def decidable_subgroup(G : Group, D : DecidableSubgroup(G)) =
  field_first(Subgroup(G), (fun (S : Subgroup(G)) => typed(U1, SubgroupDecisions(G, S))), D);

def subgroup_decisions(G : Group, D : DecidableSubgroup(G)) :
  SubgroupDecisions(G, decidable_subgroup(G, D)) {
  exact field_second(Subgroup(G), (fun (S : Subgroup(G)) => typed(U1, SubgroupDecisions(G, S))), D);
}

def subgroup_decisions_prop(G : Group, S : Subgroup(G)) : Proposition(SubgroupDecisions(G, S)) {
  exact forall_prop(
    group_carrier(G), (fun (x : group_carrier(G)) => Decidable(subgroup_members(G, S, x))),
    (
      fun (x : group_carrier(G)) => decision_prop(
        subgroup_members(G, S, x), subgroup_prop(G, subgroup_members(G, S), subgroup_laws(G, S), x)
      )
    )
  );
}

def decidable_subgroup_ext(
  G : Group, D : DecidableSubgroup(G), E : DecidableSubgroup(G),
  same : decidable_subgroup(G, D) =[Subgroup(G)] decidable_subgroup(G, E)
) :
  D = E {
  exact field_subtype_ext(
    Subgroup(G), (fun (S : Subgroup(G)) => typed(U1, SubgroupDecisions(G, S))),
    subgroup_decisions_prop(G), D, E, same
  );
}

def IntermediateDecisions(K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E)) =
  forall x : extension_carrier(K, E), Decidable(intermediate_members(K, E, M, x));

def DecidableIntermediateField(K : AlgebraicField, E : FieldExt(K)) =
  exists M : IntermediateField(K, E), IntermediateDecisions(K, E, M);

def decidable_intermediate(
  K : AlgebraicField, E : FieldExt(K), D : DecidableIntermediateField(K, E)
) =
  field_first(
    IntermediateField(K, E),
    (fun (M : IntermediateField(K, E)) => typed(U1, IntermediateDecisions(K, E, M))), D
  );

def intermediate_decisions(
  K : AlgebraicField, E : FieldExt(K), D : DecidableIntermediateField(K, E)
) :
  IntermediateDecisions(K, E, decidable_intermediate(K, E, D)) {
  exact field_second(
    IntermediateField(K, E),
    (fun (M : IntermediateField(K, E)) => typed(U1, IntermediateDecisions(K, E, M))), D
  );
}

def intermediate_decisions_prop(K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E)) :
  Proposition(IntermediateDecisions(K, E, M)) {
  obtain (closure, base) = intermediate_laws(K, E, M);
  exact forall_prop(
    extension_carrier(K, E),
    (fun (x : extension_carrier(K, E)) => Decidable(intermediate_members(K, E, M, x))),
    (
      fun (x : extension_carrier(K, E)) => decision_prop(
        intermediate_members(K, E, M, x),
        subfield_prop(extension_field(K, E), intermediate_members(K, E, M), closure, x)
      )
    )
  );
}

def decidable_intermediate_ext(
  K : AlgebraicField, E : FieldExt(K), D : DecidableIntermediateField(K, E),
  F : DecidableIntermediateField(K, E),
  same : decidable_intermediate(K, E, D) =[IntermediateField(K, E)] decidable_intermediate(K, E, F)
) :
  D = F {
  exact field_subtype_ext(
    IntermediateField(K, E),
    (fun (M : IntermediateField(K, E)) => typed(U1, IntermediateDecisions(K, E, M))),
    intermediate_decisions_prop(K, E), D, F, same
  );
}
