import field_logic;

// U1 carriers include types of small subobjects; their order relations are
// U0-valued. These interfaces require no categorical infrastructure or LEM.
def OrderRelation(A : U1) = A -> A -> U0;

def OrderReflexive(A : U1, le : OrderRelation(A)) = forall a : A, le(a, a);

def OrderTransitive(A : U1, le : OrderRelation(A)) =
  forall a : A, forall b : A, forall c : A, le(a, b) -> le(b, c) -> le(a, c);

def PreorderLaws(A : U1, le : OrderRelation(A)) =
  (forall a : A, forall b : A, FieldProp(le(a, b))) and OrderReflexive(A, le)
  and OrderTransitive(A, le);

def OrderAntisymmetric(A : U1, le : OrderRelation(A)) =
  forall a : A, forall b : A, le(a, b) -> le(b, a) -> (a =[A] b);

def PartialOrderLaws(A : U1, le : OrderRelation(A)) =
  PreorderLaws(A, le) and OrderAntisymmetric(A, le);

def order_dual(A : U1, le : OrderRelation(A), a : A, b : A) = le(b, a);

def Monotone(A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B) =
  forall a : A, forall b : A, leA(a, b) -> leB(f(a), f(b));

def Antitone(A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B) =
  Monotone(A, B, leA, order_dual(B, leB), f);

// An order-reversing Galois connection: b <= f(a) exactly when a <= g(b).
// This is an ordinary adjunction after reversing the order on B.
def AntitoneConnection(
  A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B, g : B -> A
) =
  forall a : A, forall b : B, (leB(b, f(a)) -> leA(a, g(b))) and (leA(a, g(b)) -> leB(b, f(a)));

def antitone_compose(
  A : U1, B : U1, C : U1, leA : OrderRelation(A), leB : OrderRelation(B), leC : OrderRelation(C),
  f : A -> B, g : B -> C, reversesF : Antitone(A, B, leA, leB, f),
  reversesG : Antitone(B, C, leB, leC, g)
) :
  Monotone(A, C, leA, leC, (fun (a : A) => g(f(a)))) {
  intro a;
  intro b;
  intro included;
  exact reversesG(f(b), f(a), reversesF(a, b, included));
}

// Extensivity follows just by transposing reflexivity.
def antitone_connection_extensive(
  A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B, g : B -> A,
  connection : AntitoneConnection(A, B, leA, leB, f, g), reflexiveB : OrderReflexive(B, leB), a : A
) :
  leA(a, g(f(a))) {
  obtain (toA, toB) = connection(a, f(a));
  exact toA(reflexiveB(f(a)));
}

def antitone_connection_reverses(
  A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B, g : B -> A,
  connection : AntitoneConnection(A, B, leA, leB, f, g), transitiveA : OrderTransitive(A, leA),
  reflexiveB : OrderReflexive(B, leB)
) :
  Antitone(A, B, leA, leB, f) {
  intro a;
  intro b;
  intro included;
  obtain (toA, toB) = connection(a, f(b));
  exact toB(
    transitiveA(
      a, b, g(f(b)), included,
      antitone_connection_extensive(A, B, leA, leB, f, g, connection, reflexiveB, b)
    )
  );
}

// Swapping the two sides preserves the antitone form of the connection.
def antitone_connection_swap(
  A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B, g : B -> A,
  connection : AntitoneConnection(A, B, leA, leB, f, g)
) :
  AntitoneConnection(B, A, leB, leA, g, f) {
  intro b;
  intro a;
  obtain (toA, toB) = connection(a, b);
  exact (toB, toA);
}

// In a partial order, the induced closure is idempotent as an actual equality.
def antitone_connection_closure_idempotent(
  A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B, g : B -> A,
  connection : AntitoneConnection(A, B, leA, leB, f, g), reflexiveA : OrderReflexive(A, leA),
  reflexiveB : OrderReflexive(B, leB), transitiveB : OrderTransitive(B, leB),
  antisymmetricA : OrderAntisymmetric(A, leA), a : A
) :
  g(f(g(f(a)))) =[A] g(f(a)) {
  let swapped = antitone_connection_swap(A, B, leA, leB, f, g, connection);
  let reversesG =
    antitone_connection_reverses(B, A, leB, leA, g, f, swapped, transitiveB, reflexiveA);
  let lower =
    reversesG(
      f(a), f(g(f(a))),
      antitone_connection_extensive(B, A, leB, leA, g, f, swapped, reflexiveA, f(a))
    );
  let upper = antitone_connection_extensive(A, B, leA, leB, f, g, connection, reflexiveB, g(f(a)));
  exact antisymmetricA(g(f(g(f(a)))), g(f(a)), lower, upper);
}

// Inclusion of small-valued predicates, without assuming membership decidable.
def PredicateIncluded(A : U0, P : A -> U0, Q : A -> U0) = forall x : A, P(x) -> Q(x);

// An ordinary order adjunction is the same connection with the second order
// reversed: f(a) <= b iff a <= g(b). Both maps preserve their original orders.
def OrderAdjunction(
  A : U1, B : U1, leA : OrderRelation(A), leB : OrderRelation(B), f : A -> B, g : B -> A
) =
  AntitoneConnection(A, B, leA, order_dual(B, leB), f, g);
