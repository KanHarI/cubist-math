import contour_refinement;
import sample_magnitude;

// The uniform change in f is required only at the old/new sampled tags.
def ContourTagBounds(F : U1, addF : F -> F -> F, negF : F -> F,
  lt : F -> F -> U0, f : F -> F, delta : F, n : Nat) =
  induction n as k return (SampleVertices(F, k) -> SampleTags(F, k) -> SampleTags(F, k) -> U0) {
    zero => fun (vertices : F) => fun (oldTags : Unit) => fun (newTags : Unit) => Unit;
    succ previous => fun (vertices : SampleVertices(F, succ(k))) => fun (oldTags : SampleTags(F, succ(k))) => fun (newTags : SampleTags(F, succ(k))) =>
      FieldMagnitudeBound(F, negF, lt, coordinate_difference(F, addF, negF, f(field_fst(F, SampleTags(F, k), oldTags)), f(field_fst(F, SampleTags(F, k), newTags))), delta) and previous(field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags), field_snd(F, SampleTags(F, k), newTags));
  };

theorem contour_tag_error_variation_bound(F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  lt : F -> F -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  order : StrictOrder(F, lt), arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  f : F -> F, weight : F -> F -> F -> F, delta : F, n : Nat) :
  forall vertices : SampleVertices(F, n), forall oldTags : SampleTags(F, n), forall newTags : SampleTags(F, n),
    ContourTagBounds(F, addF, negF, lt, f, delta, n, vertices, oldTags, newTags) -> SampleMagnitudeBounds(F, F, negF, lt, (fun (a : F) => fun (b : F) => fun (t : F) => coordinate_difference(F, addF, negF, a, b)), weight, n, vertices, oldTags) ->
      FieldMagnitudeBound(F, negF, lt, contour_tag_error_sum(F, zero, addF, mulF, negF, f, n, vertices, oldTags, newTags), mulF(delta, sample_sum(F, F, zero, addF, weight, n, vertices, oldTags))) {
  exact induction n as k return (forall vertices : SampleVertices(F, k), forall oldTags : SampleTags(F, k), forall newTags : SampleTags(F, k),
    ContourTagBounds(F, addF, negF, lt, f, delta, k, vertices, oldTags, newTags) -> SampleMagnitudeBounds(F, F, negF, lt, (fun (a : F) => fun (b : F) => fun (t : F) => coordinate_difference(F, addF, negF, a, b)), weight, k, vertices, oldTags) ->
      FieldMagnitudeBound(F, negF, lt, contour_tag_error_sum(F, zero, addF, mulF, negF, f, k, vertices, oldTags, newTags), mulF(delta, sample_sum(F, F, zero, addF, weight, k, vertices, oldTags)))) {
    zero => fun (vertices : F) => fun (oldTags : Unit) => fun (newTags : Unit) => fun (errors : Unit) => fun (increments : Unit) =>
      transport(FieldMagnitudeBound(F, negF, lt, zero), zero, mulF(delta, zero), sym(ring_mul_zero(F, zero, one, addF, mulF, negF, ring, delta)), field_magnitude_zero(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic));
    succ previous => fun (vertices : SampleVertices(F, succ(k))) => fun (oldTags : SampleTags(F, succ(k))) => fun (newTags : SampleTags(F, succ(k))) =>
      fun (errors : ContourTagBounds(F, addF, negF, lt, f, delta, succ(k), vertices, oldTags, newTags)) => fun (increments : SampleMagnitudeBounds(F, F, negF, lt, (fun (a : F) => fun (b : F) => fun (t : F) => coordinate_difference(F, addF, negF, a, b)), weight, succ(k), vertices, oldTags)) =>
        transport(FieldMagnitudeBound(F, negF, lt, contour_tag_error_sum(F, zero, addF, mulF, negF, f, succ(k), vertices, oldTags, newTags)),
          addF(mulF(delta, weight(field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices)), field_fst(F, SampleTags(F, k), oldTags))), mulF(delta, sample_sum(F, F, zero, addF, weight, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags)))), mulF(delta, sample_sum(F, F, zero, addF, weight, succ(k), vertices, oldTags)),
          sym(ring_distribute(F, zero, one, addF, mulF, negF, ring, delta, weight(field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices)), field_fst(F, SampleTags(F, k), oldTags)), sample_sum(F, F, zero, addF, weight, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags)))),
          field_magnitude_add(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, contour_tag_error(F, addF, mulF, negF, f, field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices)), field_fst(F, SampleTags(F, k), oldTags), field_fst(F, SampleTags(F, k), newTags)), contour_tag_error_sum(F, zero, addF, mulF, negF, f, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags), field_snd(F, SampleTags(F, k), newTags)), mulF(delta, weight(field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices)), field_fst(F, SampleTags(F, k), oldTags))), mulF(delta, sample_sum(F, F, zero, addF, weight, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags))),
            field_magnitude_mul(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, coordinate_difference(F, addF, negF, f(field_fst(F, SampleTags(F, k), oldTags)), f(field_fst(F, SampleTags(F, k), newTags))), coordinate_difference(F, addF, negF, field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices))), delta, weight(field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices)), field_fst(F, SampleTags(F, k), oldTags)),
              field_fst(FieldMagnitudeBound(F, negF, lt, coordinate_difference(F, addF, negF, f(field_fst(F, SampleTags(F, k), oldTags)), f(field_fst(F, SampleTags(F, k), newTags))), delta), ContourTagBounds(F, addF, negF, lt, f, delta, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags), field_snd(F, SampleTags(F, k), newTags)), errors),
              field_fst(FieldMagnitudeBound(F, negF, lt, coordinate_difference(F, addF, negF, field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices))), weight(field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices)), field_fst(F, SampleTags(F, k), oldTags))), SampleMagnitudeBounds(F, F, negF, lt, (fun (a : F) => fun (b : F) => fun (t : F) => coordinate_difference(F, addF, negF, a, b)), weight, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags)), increments)),
            previous(field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags), field_snd(F, SampleTags(F, k), newTags), field_snd(FieldMagnitudeBound(F, negF, lt, coordinate_difference(F, addF, negF, f(field_fst(F, SampleTags(F, k), oldTags)), f(field_fst(F, SampleTags(F, k), newTags))), delta), ContourTagBounds(F, addF, negF, lt, f, delta, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags), field_snd(F, SampleTags(F, k), newTags)), errors),
              field_snd(FieldMagnitudeBound(F, negF, lt, coordinate_difference(F, addF, negF, field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices))), weight(field_fst(F, SampleVertices(F, k), vertices), sample_first(F, k, field_snd(F, SampleVertices(F, k), vertices)), field_fst(F, SampleTags(F, k), oldTags))), SampleMagnitudeBounds(F, F, negF, lt, (fun (a : F) => fun (b : F) => fun (t : F) => coordinate_difference(F, addF, negF, a, b)), weight, k, field_snd(F, SampleVertices(F, k), vertices), field_snd(F, SampleTags(F, k), oldTags)), increments))));
  };
}

theorem contour_tag_error_length_bound(F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  lt : F -> F -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  order : StrictOrder(F, lt), arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  f : F -> F, weight : F -> F -> F -> F, delta : F, length : F,
  nonnegativeDelta : FieldLe(F, lt, zero, delta), n : Nat,
  vertices : SampleVertices(F, n), oldTags : SampleTags(F, n), newTags : SampleTags(F, n),
  errors : ContourTagBounds(F, addF, negF, lt, f, delta, n, vertices, oldTags, newTags), increments : SampleMagnitudeBounds(F, F, negF, lt, (fun (a : F) => fun (b : F) => fun (t : F) => coordinate_difference(F, addF, negF, a, b)), weight, n, vertices, oldTags),
  variation : FieldLe(F, lt, sample_sum(F, F, zero, addF, weight, n, vertices, oldTags), length)) :
  FieldMagnitudeBound(F, negF, lt, contour_tag_error_sum(F, zero, addF, mulF, negF, f, n, vertices, oldTags, newTags), mulF(delta, length)) {
  obtain (positiveOne, (translate, (scale, (weakScale, (ltLe, (leLt, splitPositive)))))) = arithmetic;
  let totalWeight = sample_sum(F, F, zero, addF, weight, n, vertices, oldTags);
  let bounded = contour_tag_error_variation_bound(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, f, weight, delta, n, vertices, oldTags, newTags, errors, increments);
  let rightScaled = weakScale(totalWeight, length, delta, variation, nonnegativeDelta);
  let leftScaled = transport((fun (v : F) => FieldLe(F, lt, v, mulF(length, delta))), mulF(totalWeight, delta), mulF(delta, totalWeight),
    ring_mul_comm(F, zero, one, addF, mulF, negF, ring, totalWeight, delta), rightScaled);
  let grows = transport(FieldLe(F, lt, mulF(delta, totalWeight)), mulF(length, delta), mulF(delta, length),
    ring_mul_comm(F, zero, one, addF, mulF, negF, ring, length, delta), leftScaled);
  exact field_magnitude_enlarge(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, contour_tag_error_sum(F, zero, addF, mulF, negF, f, n, vertices, oldTags, newTags), mulF(delta, totalWeight), mulF(delta, length), bounded, grows);
}
