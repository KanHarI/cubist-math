import dyadic_refinement;
import subdivision_tagged_zip;
import interval_subdivisions;

// Coarse width bounds and fine admissibility refer to the same actual family.
theorem interval_refinement_mesh(F : Type1, zero : F, one : F, addF : F -> F -> F,
  mulF : F -> F -> F, negF : F -> F, lt : F -> F -> Type,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), radius : F, mesh : F, small : lt(radius, mesh),
  n : Nat, vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n), tags : SampleTags(FieldUnitInterval(F, zero, one, lt), n),
  pieces : SampleSubdivisions(FieldUnitInterval(F, zero, one, lt), n, vertices),
  coarseValid : SampleTagged(FieldUnitInterval(F, zero, one, lt), IntervalTaggedWidth(F, zero, one, addF, negF, lt, radius), n, vertices, tags),
  fineValid : SubdivisionTagged(FieldUnitInterval(F, zero, one, lt), IntervalRefinementAdmissible(F, zero, one, lt), n, vertices, tags, pieces)) :
  SubdivisionTagged(FieldUnitInterval(F, zero, one, lt), IntervalSubdivisionFine(F, zero, one, addF, negF, lt, mesh), n, vertices, tags, pieces) {
  let I = FieldUnitInterval(F, zero, one, lt);
  let coarse = IntervalTaggedWidth(F, zero, one, addF, negF, lt, radius);
  let fine = IntervalRefinementAdmissible(F, zero, one, lt);
  let other = IntervalSubdivisionFine(F, zero, one, addF, negF, lt, mesh);
  obtain (positiveOne, (translate, (scale, (weakScale, (ltLe, (leLt, splitPositive)))))) = arithmetic;
  have combine : forall a : I, forall b : I, forall tag : I, forall piece : SampleSubdivision(I, a, b),
    coarse(a, b, tag) -> fine(a, b, tag, piece) -> other(a, b, tag, piece) {
    intro a;
    intro b;
    intro tag;
    intro piece;
    intro coarseData;
    intro fineData;
    obtain (within, bounded) = coarseData;
    exact (within, (leLt(interval_difference(F, zero, one, addF, negF, lt)(a, b), radius, mesh, bounded, small), fineData));
  }
  exact subdivision_tagged_zip(I, coarse, fine, other, combine, n, vertices, tags, pieces, coarseValid, fineValid);
}

// Once this dyadic level meets the mesh bound, every later level gives a
// refinement certificate satisfying the hypotheses of the analytic estimates.
theorem dyadic_samples_refine_below_mesh(F : Type1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> Type,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt), arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  half : F -> F, halfSum : (forall x : F, addF(half(x), half(x)) = x), G : Type1, zeroG : G, addG : G -> G -> G,
  leftUnit : (forall x : G, addG(zeroG, x) = x), rightUnit : (forall x : G, addG(x, zeroG) = x),
  assoc : (forall x : G, forall y : G, forall z : G, addG(addG(x, y), z) = addG(x, addG(y, z))),
  edge : FieldUnitInterval(F, zero, one, lt) -> FieldUnitInterval(F, zero, one, lt) -> FieldUnitInterval(F, zero, one, lt) -> G, depth : Nat, extra : Nat, a : FieldUnitInterval(F, zero, one, lt), b : FieldUnitInterval(F, zero, one, lt), ordered : FieldLe(F, lt, field_interval_coordinate(F, zero, one, lt)(a), field_interval_coordinate(F, zero, one, lt)(b)),
  mesh : F, small : lt(dyadic_width(F, half, depth, interval_difference(F, zero, one, addF, negF, lt)(a, b)), mesh)) :
  SubdivisionRefinementSum(FieldUnitInterval(F, zero, one, lt), G, zeroG, addG, edge,
    IntervalSubdivisionFine(F, zero, one, addF, negF, lt, mesh), a, b, dyadic_piece(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b, ordered), dyadic_piece(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth + extra, a, b, ordered)) {
  let I = FieldUnitInterval(F, zero, one, lt);
  let coarse = dyadic_piece(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b, ordered);
  let n = subdivision_count(I, a, b, coarse);
  let vertices = subdivision_vertices(I, a, b, coarse);
  let tags = subdivision_tags(I, a, b, coarse);
  obtain (pieces, (fineValid, computes)) = dyadic_samples_refine(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, G, zeroG, addG, leftUnit, rightUnit, assoc, edge, depth, extra, a, b, ordered);
  let coarseValid = dyadic_piece_valid(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b, ordered);
  let valid = interval_refinement_mesh(F, zero, one, addF, mulF, negF, lt, arithmetic,
    dyadic_width(F, half, depth, interval_difference(F, zero, one, addF, negF, lt)(a, b)), mesh, small,
    n, vertices, tags, pieces, coarseValid, fineValid);
  exact (pieces, (valid, computes));
}
