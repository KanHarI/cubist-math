import sample_subdivision_conditions;

// Endpoint paths transport the dependent subdivision data. These are
// identities of endpoints, not geometric contour paths or homotopies.
def subdivision_move_end(C : U1, a : C, b : C, c : C, p : b = c, piece : SampleSubdivision(C, a, b)) =
  transport((fun (endpoint : C) => SampleSubdivision(C, a, endpoint)), b, c, p, piece);

theorem subdivision_sum_move_end(
  C : U1, G : U1, zero : G, addG : G -> G -> G, edge : C -> C -> C -> G, a : C, b : C, c : C,
  p : b = c, piece : SampleSubdivision(C, a, b)
) : subdivision_sum(C, G, zero, addG, edge, a, c, subdivision_move_end(C, a, b, c, p, piece)) = subdivision_sum(
  C, G, zero, addG, edge, a, b, piece
) {
  exact path_induction(
    C,
    (
      fun (u : C) => fun (v : C) => fun (q : u = v) => forall data : SampleSubdivision(C, a, u),
      subdivision_sum(C, G, zero, addG, edge, a, v, subdivision_move_end(C, a, u, v, q, data)) = subdivision_sum(
        C, G, zero, addG, edge, a, u, data
      )
    ),
    (
      fun (u : C) => fun (data : SampleSubdivision(C, a, u)) => refl(
        subdivision_sum(C, G, zero, addG, edge, a, u, data)
      )
    ), b, c, p
  )(piece);
}

theorem subdivision_condition_move_end(
  C : U1, condition : (forall a : C, forall b : C, C -> SampleSubdivision(C, a, b) -> U1), a : C,
  b : C, c : C, tag : C, p : b = c, piece : SampleSubdivision(C, a, b),
  valid : condition(a, b, tag, piece)
) : condition(a, c, tag, subdivision_move_end(C, a, b, c, p, piece)) {
  exact path_induction(
    C,
    (
      fun (u : C) => fun (v : C) => fun (q : u = v) => forall data : SampleSubdivision(C, a, u),
      condition(a, u, tag, data) -> condition(a, v, tag, subdivision_move_end(C, a, u, v, q, data))
    ),
    (
      fun (u : C) => fun (data : SampleSubdivision(C, a, u)) => fun (
        evidence : condition(a, u, tag, data)
      ) => evidence
    ), b, c, p
  )(piece, valid);
}
