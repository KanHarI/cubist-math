import sample_tagged;

// Map the evidence at each edge without changing vertices or tags.
def sample_tagged_map_step(
  C : U1, condition : C -> C -> C -> U0, other : C -> C -> C -> U0,
  mapping : (forall a : C, forall b : C, forall tag : C, condition(a, b, tag) -> other(a, b, tag)),
  n : Nat,
  previous : (
    forall vertices : SampleVertices(C, n), forall tags : SampleTags(C, n),
    SampleTagged(C, condition, n, vertices, tags) -> SampleTagged(C, other, n, vertices, tags)
  ), vertices : SampleVertices(C, succ(n)), tags : SampleTags(C, succ(n)),
  valid : SampleTagged(C, condition, succ(n), vertices, tags)
) :
  SampleTagged(C, other, succ(n), vertices, tags) {
  let a = field_fst(C, SampleVertices(C, n), vertices);
  let tail = field_snd(C, SampleVertices(C, n), vertices);
  let b = sample_first(C, n, tail);
  let tag = field_fst(C, SampleTags(C, n), tags);
  let tailTags = field_snd(C, SampleTags(C, n), tags);
  have data : condition(a, b, tag) and SampleTagged(C, condition, n, tail, tailTags) {
    exact valid;
  }
  obtain (headValid, tailValid) = data;
  exact typed(
    (other(a, b, tag) and SampleTagged(C, other, n, tail, tailTags)),
    (mapping(a, b, tag, headValid), previous(tail, tailTags, tailValid))
  );
}

def sample_tagged_map(
  C : U1, condition : C -> C -> C -> U0, other : C -> C -> C -> U0,
  mapping : (forall a : C, forall b : C, forall tag : C, condition(a, b, tag) -> other(a, b, tag)),
  n : Nat
) :
  forall vertices : SampleVertices(C, n), forall tags : SampleTags(C, n),
  SampleTagged(C, condition, n, vertices, tags) -> SampleTagged(C, other, n, vertices, tags) {
  exact induction n as k return (
    forall vertices : SampleVertices(C, k), forall tags : SampleTags(C, k),
    SampleTagged(C, condition, k, vertices, tags) -> SampleTagged(C, other, k, vertices, tags)
  ) {
    zero => fun (vertices : C) => fun (tags : Unit) => fun (valid : Unit) => tt;
    succ previous => sample_tagged_map_step(C, condition, other, mapping, k, previous);
  };
}
