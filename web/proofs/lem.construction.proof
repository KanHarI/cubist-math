// Law of excluded middle (LEM)
// Complete checked construction. All intermediate steps are included.
construction lem {
  axioms allow; // Explicit policy inherited from the original proof.
  private s0001_UIntroOmega = universe_omega();
  private s0002_CtxExt = assume(s0001_UIntroOmega, none);
  private s0003_UVble = universe_variable(s0002_CtxExt);
  private s0004_CtxExt = assume(s0003_UVble, none);
  private s0005_Vble = variable(s0004_CtxExt);
  private s0006_VoidForm = empty_type();
  private s0007_PiForm = function_type(s0005_Vble, s0006_VoidForm, none);
  private s0008_PiForm = function_type(s0007_PiForm, s0006_VoidForm, none);
  private s0009_UIntroOmega = universe_omega();
  private s0010_CtxExt = assume(s0009_UIntroOmega, none);
  private s0011_UVble = universe_variable(s0010_CtxExt);
  private s0012_UIntro0 = universe_zero();
  private s0013_PiForm = function_type(s0011_UVble, s0012_UIntro0, none);
  private s0014_PiForm = function_type(s0009_UIntroOmega, s0013_PiForm, s0010_CtxExt);
  private s0015_Axiom = postulate(s0014_PiForm);
  private s0016_PiElim = apply(s0015_Axiom, s0011_UVble);
  private s0017_CtxExt = assume(s0011_UVble, none);
  private s0018_Vble = variable(s0017_CtxExt);
  private s0019_PiElim = apply(s0016_PiElim, s0018_Vble);
  private s0020_UCumulOmega = universe_lift_omega(s0012_UIntro0);
  private s0021_UIntroOmega = universe_omega();
  private s0022_CtxExt = assume(s0021_UIntroOmega, none);
  private s0023_UVble = universe_variable(s0022_CtxExt);
  private s0024_CtxExt = assume(s0023_UVble, none);
  private s0025_Vble = variable(s0024_CtxExt);
  private s0026_CtxExt = assume(s0025_Vble, none);
  private s0027_CtxExt = assume(s0025_Vble, s0026_CtxExt);
  private s0028_Vble = variable(s0026_CtxExt);
  private s0029_Vble = variable(s0027_CtxExt);
  private s0030_EqForm = equality_type(s0025_Vble, s0028_Vble, s0029_Vble);
  private s0031_PiForm = function_type(s0025_Vble, s0030_EqForm, s0027_CtxExt);
  private s0032_PiForm = function_type(s0025_Vble, s0031_PiForm, s0026_CtxExt);
  private s0033_PiIntro = function_intro(s0023_UVble, s0032_PiForm, s0024_CtxExt);
  private s0034_PiIntro = function_intro(s0021_UIntroOmega, s0033_PiIntro, s0022_CtxExt);
  private s0035_Def = define(s0034_PiIntro);
  private s0036_DefEqExtL = definition_left(s0035_Def);
  private s0037_PiElim = apply(s0036_DefEqExtL, s0020_UCumulOmega);
  private s0038_PiElim = apply(s0037_PiElim, s0019_PiElim);
  private s0039_PiForm = function_type(s0023_UVble, s0038_PiElim, s0024_CtxExt);
  private s0040_PiForm = function_type(s0021_UIntroOmega, s0039_PiForm, s0022_CtxExt);
  private s0041_Axiom = postulate(s0040_PiForm);
  private s0042_CtxExt = assume(s0023_UVble, s0024_CtxExt);
  private s0043_Vble = variable(s0042_CtxExt);
  private s0044_PiForm = function_type(s0025_Vble, s0043_Vble, none);
  private s0045_PiElim = apply(s0036_DefEqExtL, s0023_UVble);
  private s0046_PiElim = apply(s0045_PiElim, s0043_Vble);
  private s0047_SigmaForm = pair_type(s0044_PiForm, s0046_PiElim, none);
  private s0048_PiForm = function_type(s0019_PiElim, s0043_Vble, none);
  private s0049_PiForm = function_type(s0047_SigmaForm, s0048_PiForm, none);
  private s0050_PiForm = function_type(s0023_UVble, s0049_PiForm, s0042_CtxExt);
  private s0051_PiForm = function_type(s0023_UVble, s0050_PiForm, s0024_CtxExt);
  private s0052_PiForm = function_type(s0021_UIntroOmega, s0051_PiForm, s0022_CtxExt);
  private s0053_Axiom = postulate(s0052_PiForm);
  private s0054_PiForm = function_type(s0025_Vble, s0019_PiElim, none);
  private s0055_PiForm = function_type(s0023_UVble, s0054_PiForm, s0024_CtxExt);
  private s0056_PiForm = function_type(s0021_UIntroOmega, s0055_PiForm, s0022_CtxExt);
  private s0057_Axiom = postulate(s0056_PiForm);
  private s0058_PiElim = apply(s0015_Axiom, s0023_UVble);
  private s0059_PiElim = apply(s0058_PiElim, s0025_Vble);
  private s0060_PiForm = function_type(s0008_PiForm, s0059_PiElim, none);
  private s0061_PiForm = function_type(s0023_UVble, s0060_PiForm, s0024_CtxExt);
  private s0062_PiForm = function_type(s0021_UIntroOmega, s0061_PiForm, s0022_CtxExt);
  export LEM = postulate(s0062_PiForm);
}
