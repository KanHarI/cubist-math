import polynomial_degree;

// Ring identities specialized to the checked coefficient representation.

def polynomial_add_zero_right(K : AlgebraicField) =
  ring_add_zero_right(
    Polynomial(K), polynomial_zero(K), polynomial_one(K), polynomial_add(K), polynomial_mul(K),
    polynomial_neg(K), polynomial_ring(K)
  );

