import polynomial_annihilator;
import polynomial_monic;

// The minimal polynomial is the unique monic generator of the annihilator.
// This specification does not choose an arbitrary irreducible associate.
def MinimalPolynomialSpec(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L), p : Polynomial(K)
) =
  PolynomialNonzero(K, p) and PolynomialMonic(K, p) and PolynomialRoot(K, L, e, p, x)
  and (forall q : Polynomial(K), PolynomialRoot(K, L, e, q, x) -> PolynomialDivides(K, p, q));

def MinimalPolynomialData(K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L)) =
  exists p : Polynomial(K), MinimalPolynomialSpec(K, L, e, x, p);

def polynomial_nonzero_prop(K : AlgebraicField, p : Polynomial(K)) =
  forall_prop(
    (p = polynomial_zero(K)), (fun (same : p = polynomial_zero(K)) => Void),
    (fun (same : p = polynomial_zero(K)) (v w : Void) => typed((v = w), absurd(v)))
  );

def minimal_polynomial_spec_prop(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L), p : Polynomial(K)
) =
  product_prop(
    PolynomialNonzero(K, p),
    (
      PolynomialMonic(K, p) and PolynomialRoot(K, L, e, p, x)
      and (forall q : Polynomial(K), PolynomialRoot(K, L, e, q, x) -> PolynomialDivides(K, p, q))
    ), polynomial_nonzero_prop(K, p),
    product_prop(
      PolynomialMonic(K, p),
      (
        PolynomialRoot(K, L, e, p, x)
        and (forall q : Polynomial(K), PolynomialRoot(K, L, e, q, x) -> PolynomialDivides(K, p, q))
      ), af_set(K, polynomial_coefficients(K, p, polynomial_degree(K, p)), field_one(K)),
      product_prop(
        PolynomialRoot(K, L, e, p, x),
        (forall q : Polynomial(K), PolynomialRoot(K, L, e, q, x) -> PolynomialDivides(K, p, q)),
        polynomial_root_prop(K, L, e, p, x),
        forall_prop(
          Polynomial(K),
          (fun (q : Polynomial(K)) => PolynomialRoot(K, L, e, q, x) -> PolynomialDivides(K, p, q)),
          (
            fun (q : Polynomial(K)) => forall_prop(
              PolynomialRoot(K, L, e, q, x),
              (fun (root : PolynomialRoot(K, L, e, q, x)) => PolynomialDivides(K, p, q)),
              (fun (root : PolynomialRoot(K, L, e, q, x)) => polynomial_divides_prop(K, p, q))
            )
          )
        )
      )
    )
  );

// Two monic generators have equal degree. Their difference has smaller
// degree and is still annihilating, hence must be zero.
def minimal_polynomial_unique(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L), p q : Polynomial(K),
  hp : MinimalPolynomialSpec(K, L, e, x, p), hq : MinimalPolynomialSpec(K, L, e, x, q)
) :
  p = q {
  obtain (np, mp, rp, gp) = hp;
  obtain (nq, mq, rq, gq) = hq;
  let sameCutoff =
    dimension_order_antisymmetric(
      polynomial_cutoff(K, p), polynomial_cutoff(K, q),
      polynomial_divides_cutoff_le(K, p, q, np, nq, gp(q, rq)),
      polynomial_divides_cutoff_le(K, q, p, nq, np, gq(p, rp))
    );
  obtain (d, dp) = polynomial_nonzero_degree(K, p, np);
  let dq = trans(sym(sameCutoff), dp);
  let difference = polynomial_subtract(K, p, q);
  let I = PolynomialAnnihilator(K, L, e, x);
  let rootDifference =
    polynomial_ideal_add(K, I, p, polynomial_neg(K, q), rp, polynomial_ideal_neg(K, I, q, rq));
  exact polynomial_subtract_zero_equal(
    K, p, q,
    polynomial_small_divisible_zero(
      K, difference, p, d, dp, monic_difference_support(K, p, q, d, dp, dq, mp, mq),
      gp(difference, rootDifference)
    )
  );
}

def minimal_polynomial_data_prop(K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L)) :
  Proposition(MinimalPolynomialData(K, L, e, x)) {
  intro a b;
  let P = MinimalPolynomialSpec(K, L, e, x);
  exact subtype_ext(
    Polynomial(K), P, minimal_polynomial_spec_prop(K, L, e, x), a, b,
    minimal_polynomial_unique(
      K, L, e, x, sigma_first(Polynomial(K), P, a), sigma_first(Polynomial(K), P, b),
      sigma_second(Polynomial(K), P, a), sigma_second(Polynomial(K), P, b)
    )
  );
}

def normalize_annihilator_generator(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L),
  generator : IdealPrincipalGenerator(K, PolynomialAnnihilator(K, L, e, x))
) :
  MinimalPolynomialData(K, L, e, x) {
  obtain (g, root, nonzero, generates) = generator;
  obtain (d, degree) = polynomial_nonzero_degree(K, g, nonzero);
  let leading = polynomial_coefficients(K, g, d);
  obtain (ring, nontrivial, inverses) = af_laws(K);
  obtain (a, inverse) = inverses(leading, polynomial_leading_nonzero(K, g, d, degree));
  let p = polynomial_scale(K, a, g);
  have rootP : PolynomialRoot(K, L, e, p, x) := with unfolding [] {
    trans(
      polynomial_eval_scale(K, L, e, a, g, x),
      trans(
        cong(field_mul(L, field_embedding_map(K, L, e, a)), root),
        scalar_mul_zero(L, field_embedding_map(K, L, e, a))
      )
    )
  };
  have generatesP :
    forall q : Polynomial(K), PolynomialRoot(K, L, e, q, x) -> PolynomialDivides(K, p, q) {
    intro q rq;
    exact polynomial_divides_trans(
      K, p, g, q, polynomial_scale_divides(K, a, leading, inverse, g), generates(q, rq)
    );
  }
  exact (
    p, polynomial_normalize_nonzero(K, g, d, degree, a, inverse),
    polynomial_normalize_monic(K, g, d, degree, a, inverse), rootP, generatesP
  );
}

// Unique existence removes the truncation without selecting a basis or
// invoking a choice axiom. The resulting polynomial is canonical.
def minimal_polynomial_data(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L),
  algebraic : AlgebraicElement(K, L, e, x)
) :
  MinimalPolynomialData(K, L, e, x) {
  exact mere_eliminate(
    IdealPrincipalGenerator(K, PolynomialAnnihilator(K, L, e, x)),
    MinimalPolynomialData(K, L, e, x), minimal_polynomial_data_prop(K, L, e, x),
    normalize_annihilator_generator(K, L, e, x),
    algebraic_annihilator_generator(K, L, e, x, algebraic)
  );
}

def minimal_polynomial(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L),
  algebraic : AlgebraicElement(K, L, e, x)
) =
  sigma_first(
    Polynomial(K), MinimalPolynomialSpec(K, L, e, x), minimal_polynomial_data(K, L, e, x, algebraic)
  );

def minimal_polynomial_spec(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L),
  algebraic : AlgebraicElement(K, L, e, x)
) =
  sigma_second(
    Polynomial(K), MinimalPolynomialSpec(K, L, e, x), minimal_polynomial_data(K, L, e, x, algebraic)
  );

def minimal_polynomial_irreducible(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L),
  algebraic : AlgebraicElement(K, L, e, x)
) :
  PolynomialIrreducible(K, minimal_polynomial(K, L, e, x, algebraic)) {
  obtain (nonzero, monic, root, generates) = minimal_polynomial_spec(K, L, e, x, algebraic);
  exact annihilator_generator_irreducible(
    K, L, e, x, minimal_polynomial(K, L, e, x, algebraic), root, nonzero, generates
  );
}

def minimal_polynomial_divides(
  K L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L),
  algebraic : AlgebraicElement(K, L, e, x), q : Polynomial(K), root : PolynomialRoot(K, L, e, q, x)
) :
  PolynomialDivides(K, minimal_polynomial(K, L, e, x, algebraic), q) {
  obtain (nonzero, monic, rp, generates) = minimal_polynomial_spec(K, L, e, x, algebraic);
  exact generates(q, root);
}
