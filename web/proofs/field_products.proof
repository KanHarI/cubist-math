import field_logic;

// Products and their equality proofs at the universe used by real carriers.
def field_pair_eta(A : U1, B : U1, u : A and B) =
  pair_induction(
    (fun (v : A and B) => typed(A and B, (field_fst(A, B, v), field_snd(A, B, v))) = v),
    (fun (a : A) => fun (b : B) => refl(typed(A and B, (a, b)))), u
  );

def field_pair_path(
  A : U1, B : U1, u : A and B, v : A and B, p : field_fst(A, B, u) = field_fst(A, B, v),
  q : field_snd(A, B, u) = field_snd(A, B, v)
) =
  trans(
    sym(field_pair_eta(A, B, u)),
    trans(
      cong((fun (a : A) => typed(A and B, (a, field_snd(A, B, u)))), p),
      trans(
        cong((fun (b : B) => typed(A and B, (field_fst(A, B, v), b))), q), field_pair_eta(A, B, v)
      )
    )
  );

def field_pair_path_refl(A : U1, B : U1, u : A and B) =
  pair_induction(
    (
      fun (v : A and B) => field_pair_path(
        A, B, v, v, refl(field_fst(A, B, v)), refl(field_snd(A, B, v))
      ) = refl(v)
    ), (fun (a : A) => fun (b : B) => refl(refl(typed(A and B, (a, b))))), u
  );

def field_pair_path_decode(A : U1, B : U1, u : A and B, v : A and B, p : u = v) =
  path_induction(
    A and B,
    (
      fun (x : A and B) => fun (y : A and B) => fun (r : x = y) => field_pair_path(
        A, B, x, y, cong(field_fst(A, B), r), cong(field_snd(A, B), r)
      ) = r
    ), field_pair_path_refl(A, B), u, v, p
  );

theorem field_product_is_set(A : U1, B : U1, setA : FieldSet(A), setB : FieldSet(B)) : FieldSet(
  A and B
) {
  intro u;
  intro v;
  intro p;
  intro q;
  have pathP : u = v {
    exact p;
  }
  have pathQ : u = v {
    exact q;
  }
  let sameFirst =
    setA(
      field_fst(A, B, u), field_fst(A, B, v), cong(field_fst(A, B), pathP),
      cong(field_fst(A, B), pathQ)
    );
  let sameSecond =
    setB(
      field_snd(A, B, u), field_snd(A, B, v), cong(field_snd(A, B), pathP),
      cong(field_snd(A, B), pathQ)
    );
  exact trans(
    sym(field_pair_path_decode(A, B, u, v, pathP)),
    trans(
      cong(
        (
          fun (r : field_fst(A, B, u) = field_fst(A, B, v)) => field_pair_path(
            A, B, u, v, r, cong(field_snd(A, B), pathP)
          )
        ), sameFirst
      ),
      trans(
        cong(field_pair_path(A, B, u, v, cong(field_fst(A, B), pathQ)), sameSecond),
        field_pair_path_decode(A, B, u, v, pathQ)
      )
    )
  );
}
