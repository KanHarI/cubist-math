// Is trunc
// Complete checked construction. All intermediate steps are included.
construction is_trunc {
  private s0001_UIntroOmega = universe_omega();
  private s0002_CtxExt = assume(s0001_UIntroOmega, none);
  private s0003_UVble = universe_variable(s0002_CtxExt);
  private s0004_CtxExt = assume(s0003_UVble, none);
  private s0005_Vble = variable(s0004_CtxExt);
  private s0006_CtxExt = assume(s0005_Vble, none);
  private s0007_CtxExt = assume(s0005_Vble, s0006_CtxExt);
  private s0008_Vble = variable(s0006_CtxExt);
  private s0009_Vble = variable(s0007_CtxExt);
  private s0010_EqForm = equality_type(s0005_Vble, s0008_Vble, s0009_Vble);
  private s0011_PiForm = function_type(s0005_Vble, s0010_EqForm, s0007_CtxExt);
  private s0012_PiForm = function_type(s0005_Vble, s0011_PiForm, s0006_CtxExt);
  private s0013_PiIntro = function_intro(s0003_UVble, s0012_PiForm, s0004_CtxExt);
  private s0014_PiIntro = function_intro(s0001_UIntroOmega, s0013_PiIntro, s0002_CtxExt);
  private s0015_Def = define(s0014_PiIntro);
  export lib_IsTrunc = definition_left(s0015_Def);
}
