import compositum_embeddings;
import field_embedding_image;
import intermediate_towers;
import f4_generated_subfields;

// The specified F2 -> F4 inclusion, as a morphism between bundled fields.
def f2_f4_embedding : FieldEmbedding(F2, F4) {
  exact extension_inclusion_embedding(F2, F4OverF2);
}

theorem f2_embedding_image_is_base :
  subfield_image(F2, F4, f2_f4_embedding, subfield_top(F2)) =[Subfield(F4)] f4_base_subfield {
  let image = subfield_image(F2, F4, f2_f4_embedding, subfield_top(F2));
  have intoBase : SubfieldIncluded(F4, image, f4_base_subfield) {
    intro y;
    intro member;
    obtain (k, unit, same) = typed(
      SubfieldImage(F2, F4, f2_f4_embedding, subfield_top(F2), y), member
    );
    exact typed(F2Image(y), (k, same));
  }
  have intoImage : SubfieldIncluded(F4, f4_base_subfield, image) {
    intro y;
    intro member;
    obtain (k, same) = typed(F2Image(y), member);
    exact typed(SubfieldImage(F2, F4, f2_f4_embedding, subfield_top(F2), y), (k, tt, same));
  }
  exact subfield_inclusion_antisymmetric(F4, image, f4_base_subfield, intoBase, intoImage);
}

// The realized base subfield is equal to F2 as a field, by the canonical
// isomorphism from an embedding's source onto its image and univalence.
theorem f4_base_field_is_f2 : F2 =[AlgebraicField] subfield_as_field(F4, f4_base_subfield) {
  exact with unfolding [embedding_image_field] {
    trans(
      field_embedding_image_equality(F2, F4, f2_f4_embedding),
      cong(subfield_as_field(F4), f2_embedding_image_is_base)
    )
  };
}

theorem f4_base_tower :
  FieldTower(
    F2, intermediate_as_field(F2, F4OverF2, f4_base_intermediate), F4,
    intermediate_base_embedding(F2, F4OverF2, f4_base_intermediate),
    intermediate_ambient_embedding(F2, F4OverF2, f4_base_intermediate), f2_f4_embedding
  ) {
  exact intermediate_tower(F2, F4OverF2, f4_base_intermediate);
}

// A genuine non-surjective embedding exercises change of ambient composita.
theorem f2_compositum_in_f4 :
  subfield_image(F2, F4, f2_f4_embedding, compositum(F2, subfield_top(F2), subfield_top(F2))) =[
    Subfield(F4)
  ] compositum(
    F4, subfield_image(F2, F4, f2_f4_embedding, subfield_top(F2)),
    subfield_image(F2, F4, f2_f4_embedding, subfield_top(F2))
  ) {
  exact compositum_image(F2, F4, f2_f4_embedding, subfield_top(F2), subfield_top(F2));
}
