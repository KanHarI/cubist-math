import subfield_composita;
import subfield_image_orders;

// Change-of-ambient compatibility for every field embedding, not just an
// isomorphism. The image of a compositum is the compositum of the two images.
theorem compositum_image_forward(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K), T : Subfield(K)
) : SubfieldIncluded(
  L, subfield_image(K, L, e, compositum(K, S, T)),
  compositum(L, subfield_image(K, L, e, S), subfield_image(K, L, e, T))
) {
  let imageS = subfield_image(K, L, e, S);
  let imageT = subfield_image(K, L, e, T);
  let target = compositum(L, imageS, imageT);
  let preimage = subfield_preimage(K, L, e, target);
  let includesS =
    subfield_image_inclusion_to_preimage(
      K, L, e, S, target, compositum_contains_left(L, imageS, imageT)
    );
  let includesT =
    subfield_image_inclusion_to_preimage(
      K, L, e, T, target, compositum_contains_right(L, imageS, imageT)
    );
  exact subfield_image_inclusion_from_preimage(
    K, L, e, compositum(K, S, T), target, compositum_least(K, S, T, preimage, includesS, includesT)
  );
}

theorem compositum_image_backward(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K), T : Subfield(K)
) : SubfieldIncluded(
  L, compositum(L, subfield_image(K, L, e, S), subfield_image(K, L, e, T)),
  subfield_image(K, L, e, compositum(K, S, T))
) {
  exact compositum_least(
    L, subfield_image(K, L, e, S), subfield_image(K, L, e, T),
    subfield_image(K, L, e, compositum(K, S, T)),
    subfield_image_monotone(K, L, e, S, compositum(K, S, T), compositum_contains_left(K, S, T)),
    subfield_image_monotone(K, L, e, T, compositum(K, S, T), compositum_contains_right(K, S, T))
  );
}

theorem compositum_image(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K), T : Subfield(K)
) : subfield_image(K, L, e, compositum(K, S, T)) =[Subfield(L)] compositum(
  L, subfield_image(K, L, e, S), subfield_image(K, L, e, T)
) {
  exact subfield_inclusion_antisymmetric(
    L, subfield_image(K, L, e, compositum(K, S, T)),
    compositum(L, subfield_image(K, L, e, S), subfield_image(K, L, e, T)),
    compositum_image_forward(K, L, e, S, T), compositum_image_backward(K, L, e, S, T)
  );
}
