import embedded_composita;
import f4_embedding_images;

// Two copies of the base F2 inside F4 generate F2, not the ambient F4.
// Equality is equality of bundled fields, obtained from the image isomorphism.
theorem f2_embedded_compositum_is_f2 :
  EmbeddedCompositum(F2, F2, F4, f2_f4_embedding, f2_f4_embedding) =[AlgebraicField] F2 {
  let S = subfield_image(F2, F4, f2_f4_embedding, subfield_top(F2));
  exact with unfolding [
    AlgebraicField, EmbeddedCompositum, embedded_compositum_subfield, embedding_image_field
  ] {
    trans(
      cong(subfield_as_field(F4), compositum_idempotent(F4, S)),
      sym(field_embedding_image_equality(F2, F4, f2_f4_embedding))
    )
  };
}

theorem f2_embedded_compositum_triangle :
  FieldTower(
    F2, EmbeddedCompositum(F2, F2, F4, f2_f4_embedding, f2_f4_embedding), F4,
    embedded_compositum_left(F2, F2, F4, f2_f4_embedding, f2_f4_embedding),
    embedded_compositum_inclusion(F2, F2, F4, f2_f4_embedding, f2_f4_embedding), f2_f4_embedding
  ) {
  exact embedded_compositum_left_triangle(F2, F2, F4, f2_f4_embedding, f2_f4_embedding);
}

theorem f2_embedded_compositum_base_agreement :
  field_embedding_compose(
    F2, F2, EmbeddedCompositum(F2, F2, F4, f2_f4_embedding, f2_f4_embedding),
    field_embedding_identity(F2),
    embedded_compositum_left(F2, F2, F4, f2_f4_embedding, f2_f4_embedding)
  ) = field_embedding_compose(
    F2, F2, EmbeddedCompositum(F2, F2, F4, f2_f4_embedding, f2_f4_embedding),
    field_embedding_identity(F2),
    embedded_compositum_right(F2, F2, F4, f2_f4_embedding, f2_f4_embedding)
  ) {
  exact embedded_compositum_base_agreement(
    F2, F2, F2, F4, field_embedding_identity(F2), field_embedding_identity(F2), f2_f4_embedding,
    f2_f4_embedding, f2_f4_embedding, field_embedding_left_identity(F2, F4, f2_f4_embedding),
    field_embedding_left_identity(F2, F4, f2_f4_embedding)
  );
}
