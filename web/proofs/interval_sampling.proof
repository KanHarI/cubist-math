import interval_tag_bounds;
import sample_tagged;

def IntervalAdmissibleTags(F : Type1, zero : F, one : F, lt : F -> F -> Type, n : Nat) =
  SampleTagged(FieldUnitInterval(F, zero, one, lt), IntervalTagWithin(F, zero, one, lt), n);
def IntervalMeshBelow(F : Type1, zero : F, one : F, addF : F -> F -> F, negF : F -> F, lt : F -> F -> Type, radius : F, n : Nat) =
  SampleAdjacent(FieldUnitInterval(F, zero, one, lt),
    (fun (a : FieldUnitInterval(F, zero, one, lt)) => fun (b : FieldUnitInterval(F, zero, one, lt)) =>
      lt(interval_difference(F, zero, one, addF, negF, lt, a, b), radius)), n);

theorem interval_tag_orders_endpoints(F : Type1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, lt : F -> F -> Type,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  a : FieldUnitInterval(F, zero, one, lt), b : FieldUnitInterval(F, zero, one, lt), tag : FieldUnitInterval(F, zero, one, lt), within : IntervalTagWithin(F, zero, one, lt, a, b, tag)) :
  FieldLe(F, lt, field_interval_coordinate(F, zero, one, lt, a), field_interval_coordinate(F, zero, one, lt, b)) {
  obtain (lower, upper) = within;
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  exact order_le_trans(F, zero, one, addF, mulF, lt, arithmetic, coordinate(a), coordinate(tag), coordinate(b), lower, upper);
}

theorem interval_admissible_samples_ordered(F : Type1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, lt : F -> F -> Type,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), n : Nat,
  vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n), tags : SampleTags(FieldUnitInterval(F, zero, one, lt), n), valid : IntervalAdmissibleTags(F, zero, one, lt, n, vertices, tags)) :
  SampleAdjacent(FieldUnitInterval(F, zero, one, lt), (fun (a : FieldUnitInterval(F, zero, one, lt)) => fun (b : FieldUnitInterval(F, zero, one, lt)) =>
    FieldLe(F, lt, field_interval_coordinate(F, zero, one, lt, a), field_interval_coordinate(F, zero, one, lt, b))), n, vertices) {
  let I = FieldUnitInterval(F, zero, one, lt);
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  exact sample_tagged_adjacent(I, IntervalTagWithin(F, zero, one, lt), (fun (a : I) => fun (b : I) => FieldLe(F, lt, coordinate(a), coordinate(b))),
    (fun (a : I) => fun (b : I) => fun (tag : I) => interval_tag_orders_endpoints(F, zero, one, addF, mulF, lt, arithmetic, a, b, tag)), n, vertices, tags, valid);
}

theorem interval_endpoint_tags_admissible(F : Type1, zero : F, one : F, lt : F -> F -> Type, order : StrictOrder(F, lt), n : Nat,
  vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n),
  ordered : SampleAdjacent(FieldUnitInterval(F, zero, one, lt), (fun (a : FieldUnitInterval(F, zero, one, lt)) => fun (b : FieldUnitInterval(F, zero, one, lt)) =>
    FieldLe(F, lt, field_interval_coordinate(F, zero, one, lt, a), field_interval_coordinate(F, zero, one, lt, b))), n, vertices)) :
  IntervalAdmissibleTags(F, zero, one, lt, n, vertices, sample_left_tags(FieldUnitInterval(F, zero, one, lt), n, vertices)) and
  IntervalAdmissibleTags(F, zero, one, lt, n, vertices, sample_right_tags(FieldUnitInterval(F, zero, one, lt), n, vertices)) {
  let I = FieldUnitInterval(F, zero, one, lt);
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  let related = (fun (a : I) => fun (b : I) => FieldLe(F, lt, coordinate(a), coordinate(b)));
  have leftAllowed : forall a : I, forall b : I, related(a, b) -> IntervalTagWithin(F, zero, one, lt, a, b, a) {
    intro a;
    intro b;
    intro ab;
    exact (order_le_refl(F, lt, order, coordinate(a)), ab);
  }
  have rightAllowed : forall a : I, forall b : I, related(a, b) -> IntervalTagWithin(F, zero, one, lt, a, b, b) {
    intro a;
    intro b;
    intro ab;
    exact (ab, order_le_refl(F, lt, order, coordinate(b)));
  }
  exact (sample_left_tags_valid(I, IntervalTagWithin(F, zero, one, lt), related, leftAllowed, n, vertices, ordered),
    sample_right_tags_valid(I, IntervalTagWithin(F, zero, one, lt), related, rightAllowed, n, vertices, ordered));
}
