import paths;

// Universe-polymorphic path algebra needed for adjointification. These laws
// are derived by identity elimination, with no extensionality axiom.
def path_right_unit_at(U : Universe, A : U, x : A, y : A, p : x = y) =
  path_induction(
    A,
    (fun (a : A) => fun (b : A) => fun (q : a = b) => concatenate(U, A, a, b, b, q, refl(b)) = q),
    (fun (a : A) => refl(refl(a))), x, y, p
  );

theorem path_cancel_right_at(
  U : Universe, A : U, x : A, y : A, z : A, p : x = y, q : x = y, r : y = z,
  same : concatenate(U, A, x, y, z, p, r) = concatenate(U, A, x, y, z, q, r)
) : p = q {
  let eliminate =
    typed(
      ((concatenate(U, A, x, y, z, p, r) = concatenate(U, A, x, y, z, q, r)) -> (p = q)),
      based_induction(
        U, U, A, y,
        (
          fun (b : A) => fun (s : y = b) => (
            concatenate(U, A, x, y, b, p, s) = concatenate(U, A, x, y, b, q, s)
          ) -> (p = q)
        ),
        (
          fun (h : concatenate(U, A, x, y, y, p, refl(y)) = concatenate(U, A, x, y, y, q, refl(y))) => trans(
            sym(path_right_unit_at(U, A, x, y, p)), trans(h, path_right_unit_at(U, A, x, y, q))
          )
        ), z, r
      )
    );
  exact eliminate(same);
}

def path_prepend_inverse_cancel_at(U : Universe, A : U, x : A, y : A, z : A, p : x = y, q : y = z) =
  path_induction(
    A,
    (
      fun (a : A) => fun (b : A) => fun (r : a = b) => forall c : A, forall s : b = c,
      concatenate(U, A, b, a, c, inverse(U, A, a, b, r), concatenate(U, A, a, b, c, r, s)) = s
    ), (fun (a : A) => fun (c : A) => fun (s : a = c) => refl(s)), x, y, p
  )(z, q);

// Naturality of a homotopy from f to the identity.
def homotopy_natural(
  U : Universe, A : U, f : A -> A, h : (forall x : A, f(x) = x), x : A, y : A, p : x = y
) =
  path_induction(
    A,
    (
      fun (a : A) => fun (b : A) => fun (q : a = b) => concatenate(
        U, A, f(a), f(b), b, ap(U, A, A, f, a, b, q), h(b)
      ) = concatenate(U, A, f(a), a, b, h(a), q)
    ), (fun (a : A) => sym(path_right_unit_at(U, A, f(a), a, h(a)))), x, y, p
  );

theorem homotopy_self(U : Universe, A : U, f : A -> A, h : (forall x : A, f(x) = x), x : A) : ap(
  U, A, A, f, f(x), x, h(x)
) = h(f(x)) {
  exact path_cancel_right_at(
    U, A, f(f(x)), f(x), x, ap(U, A, A, f, f(x), x, h(x)), h(f(x)), h(x),
    homotopy_natural(U, A, f, h, f(x), x, h(x))
  );
}

// Applying f commutes with the actions of g∘f and f∘g on paths.
def ap_interchange(U : Universe, A : U, B : U, f : A -> B, g : B -> A, x : A, y : A, p : x = y) =
  path_induction(
    A,
    (
      fun (a : A) => fun (b : A) => fun (q : a = b) => ap(
        U, A, B, f, g(f(a)), g(f(b)), ap(U, A, A, (fun (v : A) => g(f(v))), a, b, q)
      ) = ap(U, B, B, (fun (v : B) => f(g(v))), f(a), f(b), ap(U, A, B, f, a, b, q))
    ), (fun (a : A) => refl(refl(f(g(f(a)))))), x, y, p
  );

// Keep f, g and eta. Correct epsilon so that the half-adjoint triangle holds:
// epsilon'(y) = epsilon(f(g(y)))⁻¹ · ap(f, eta(g(y))) · epsilon(y).
def adjoint_counit(
  U : Universe, A : U, B : U, f : A -> B, g : B -> A, eta : (forall x : A, g(f(x)) = x),
  epsilon : (forall y : B, f(g(y)) = y), y : B
) =
  concatenate(
    U, B, f(g(y)), f(g(f(g(y)))), y, inverse(U, B, f(g(f(g(y)))), f(g(y)), epsilon(f(g(y)))),
    concatenate(
      U, B, f(g(f(g(y)))), f(g(y)), y, ap(U, A, B, f, g(f(g(y))), g(y), eta(g(y))), epsilon(y)
    )
  );

theorem adjoint_triangle(
  U : Universe, A : U, B : U, f : A -> B, g : B -> A, eta : (forall x : A, g(f(x)) = x),
  epsilon : (forall y : B, f(g(y)) = y), x : A
) : ap(U, A, B, f, g(f(x)), x, eta(x)) = adjoint_counit(U, A, B, f, g, eta, epsilon, f(x)) {
  let a = f(g(f(g(f(x)))));
  let b = f(g(f(x)));
  let c = f(x);
  let p = epsilon(b);
  let q = ap(U, A, B, f, g(f(g(f(x)))), g(f(x)), eta(g(f(x))));
  let s = ap(U, A, B, f, g(f(x)), x, eta(x));
  let act = (fun (r : g(f(g(f(x)))) = g(f(x))) => ap(U, A, B, f, g(f(g(f(x)))), g(f(x)), r));
  have exchange : q = ap(U, B, B, (fun (v : B) => f(g(v))), b, c, s) {
    exact trans(
      sym(cong(act, homotopy_self(U, A, (fun (v : A) => g(f(v))), eta, x))),
      ap_interchange(U, A, B, f, g, g(f(x)), x, eta(x))
    );
  }
  have middle : concatenate(U, B, a, b, c, q, epsilon(c)) = concatenate(U, B, a, b, c, p, s) {
    exact trans(
      cong((fun (r : a = b) => concatenate(U, B, a, b, c, r, epsilon(c))), exchange),
      homotopy_natural(U, B, (fun (v : B) => f(g(v))), epsilon, b, c, s)
    );
  }
  exact sym(
    trans(
      cong((fun (r : a = c) => concatenate(U, B, b, a, c, inverse(U, B, a, b, p), r)), middle),
      path_prepend_inverse_cancel_at(U, B, a, b, c, p, s)
    )
  );
}

// Two inverse homotopies imply the existing full IsEquiv, for arbitrary
// types and universes. The supplied forward map and inverse remain unchanged.
def equiv_from_inverse(
  U : Universe, A : U, B : U, f : A -> B, g : B -> A, eta : (forall x : A, g(f(x)) = x),
  epsilon : (forall y : B, f(g(y)) = y)
) : Equiv(U, A, B) {
  exact (
    f, g, eta, adjoint_counit(U, A, B, f, g, eta, epsilon),
    adjoint_triangle(U, A, B, f, g, eta, epsilon)
  );
}
