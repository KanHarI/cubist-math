import subdivision_join_conditions;
import dyadic_sampling;

// A certificate ties an actual fine sum to actual per-edge refinements of
// the coarse samples. This is a sum identity for the specified edge function,
// not an assertion that arbitrary sample lists with equal sums are identical.
def SubdivisionRefinementSum(
  C G : U1, zero : G, addG : G -> G -> G, edge : C -> C -> C -> G,
  condition : (forall a : C, forall b : C, C -> SampleSubdivision(C, a, b) -> U1), a b : C,
  coarse fine : SampleSubdivision(C, a, b)
) =
  exists pieces : SampleSubdivisions(
    C, subdivision_count(C, a, b, coarse), subdivision_vertices(C, a, b, coarse)
  ),
  SubdivisionTagged(
    C, condition, subdivision_count(C, a, b, coarse), subdivision_vertices(C, a, b, coarse),
    subdivision_tags(C, a, b, coarse), pieces
  )
  and (
    subdivision_sum(C, G, zero, addG, edge, a, b, fine) = subdivision_total(
      C, G, zero, addG, edge, subdivision_count(C, a, b, coarse),
      subdivision_vertices(C, a, b, coarse), pieces
    )
  );

// The two coarse halves and the two fine halves are joined in the same order.
// Both the per-edge conditions and the exact fine-sum identity are retained.
def subdivision_refinement_sum_join(
  C G : U1, zero : G, addG : G -> G -> G, unitLaw : (forall x : G, addG(zero, x) = x),
  assoc : (forall x : G, forall y : G, forall z : G, addG(addG(x, y), z) = addG(x, addG(y, z))),
  edge : C -> C -> C -> G,
  condition : (forall a : C, forall b : C, C -> SampleSubdivision(C, a, b) -> U1), a b c : C,
  coarseLeft : SampleSubdivision(C, a, b), coarseRight : SampleSubdivision(C, b, c),
  fineLeft : SampleSubdivision(C, a, b), fineRight : SampleSubdivision(C, b, c),
  left : SubdivisionRefinementSum(C, G, zero, addG, edge, condition, a, b, coarseLeft, fineLeft),
  right : SubdivisionRefinementSum(C, G, zero, addG, edge, condition, b, c, coarseRight, fineRight)
) :
  SubdivisionRefinementSum(
    C, G, zero, addG, edge, condition, a, c, join_subdivisions(C, a, b, c, coarseLeft, coarseRight),
    join_subdivisions(C, a, b, c, fineLeft, fineRight)
  ) {
  let n = subdivision_count(C, a, b, coarseLeft);
  let vertices = subdivision_vertices(C, a, b, coarseLeft);
  let tags = subdivision_tags(C, a, b, coarseLeft);
  let m = subdivision_count(C, b, c, coarseRight);
  let rightVertices = subdivision_vertices(C, b, c, coarseRight);
  let rightTags = subdivision_tags(C, b, c, coarseRight);
  obtain (leftPieces, leftValid, leftComputes) = left;
  obtain (rightPieces, rightValid, rightComputes) = right;
  have lastLeft : sample_last(C, n, vertices) = b := field_snd(
    (sample_first(C, n, vertices) = a), (sample_last(C, n, vertices) = b),
    subdivision_endpoints(C, a, b, coarseLeft)
  );
  have firstRight : sample_first(C, m, rightVertices) = b := field_fst(
    (sample_first(C, m, rightVertices) = b), (sample_last(C, m, rightVertices) = c),
    subdivision_endpoints(C, b, c, coarseRight)
  );
  let same = trans(lastLeft, sym(firstRight));
  let pieces =
    join_subdivision_families(C, n, vertices, leftPieces, m, rightVertices, rightPieces, same);
  let valid =
    subdivision_tagged_join(
      C, condition, n, vertices, tags, leftPieces, m, rightVertices, rightTags, rightPieces, same,
      leftValid, rightValid
    );
  let leftTotal = subdivision_total(C, G, zero, addG, edge, n, vertices, leftPieces);
  let rightFine = subdivision_sum(C, G, zero, addG, edge, b, c, fineRight);
  let joinFine =
    subdivision_sum_join(C, G, zero, addG, unitLaw, assoc, edge, a, b, c, fineLeft, fineRight);
  let joinTotal =
    subdivision_total_join(
      C, G, zero, addG, unitLaw, assoc, edge, n, vertices, leftPieces, m, rightVertices,
      rightPieces, same
    );
  exact (
    pieces, valid,
    trans(
      joinFine,
      trans(
        cong((fun (v : G) => addG(v, rightFine)), leftComputes),
        trans(cong(addG(leftTotal), rightComputes), sym(joinTotal))
      )
    )
  );
}

// Every finite subdivision refines the one-edge coarse interval for sums.
// The caller supplies the actual local condition for that fine subdivision.
def subdivision_refinement_sum_single(
  C G : U1, zero : G, addG : G -> G -> G, rightUnit : (forall x : G, addG(x, zero) = x), edge : C
  -> C -> C -> G, condition : (forall a : C, forall b : C, C -> SampleSubdivision(C, a, b) -> U1),
  a b : C, fine : SampleSubdivision(C, a, b), valid : condition(a, b, a, fine)
) :
  SubdivisionRefinementSum(
    C, G, zero, addG, edge, condition, a, b, single_edge_subdivision(C, a, b), fine
  ) {
  let pieces = typed((SampleSubdivision(C, a, b) and Unit), (fine, tt));
  exact (
    pieces, typed((condition(a, b, a, fine) and Unit), (valid, tt)),
    sym(rightUnit(subdivision_sum(C, G, zero, addG, edge, a, b, fine)))
  );
}
