import affine_dyadic_limits;

// The integral is constructed by completeness from the proved Cauchy sequence.
// Actual Archimedean bounds and the field's completeness operation remain
// explicit inputs; no convergence of these contour sums is assumed.
def affine_dyadic_integral_exists(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F, lt : F -> F
  -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), minF : F -> F -> F, maxF : F -> F
  -> F, lattice : FieldLattice(F, lt, minF, maxF), inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), z : Complex(F), slope : Complex(F),
  integrand : Complex(F) -> Complex(F),
  uniform : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => integrand(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), a : FieldUnitInterval(F, zero, one, lt), b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt)
) :
  exists value : Complex(F),
  ComplexConverges(
    F, zero, addF, lt,
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
      integrand, a, b, ordered
    ), value
  ) {
  exact complex_cauchy_complete(
    F, zero, addF, lt, complete,
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
      integrand, a, b, ordered
    ),
    affine_dyadic_cauchy(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered
    )
  );
}

def affine_dyadic_integral(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  lt : F -> F -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  order : StrictOrder(F, lt), arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  minF : F -> F -> F, maxF : F -> F -> F, lattice : FieldLattice(F, lt, minF, maxF),
  inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), z : Complex(F), slope : Complex(F),
  integrand : Complex(F) -> Complex(F),
  uniform : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => integrand(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), a : FieldUnitInterval(F, zero, one, lt), b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt)
) =
  field_first(
    Complex(F),
    ComplexConverges(
      F, zero, addF, lt,
      affine_dyadic_sum(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
        integrand, a, b, ordered
      )
    ),
    affine_dyadic_integral_exists(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete
    )
  );

def affine_dyadic_integral_converges(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F, lt : F -> F
  -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), minF : F -> F -> F, maxF : F -> F
  -> F, lattice : FieldLattice(F, lt, minF, maxF), inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), z : Complex(F), slope : Complex(F),
  integrand : Complex(F) -> Complex(F),
  uniform : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => integrand(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), a : FieldUnitInterval(F, zero, one, lt), b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt)
) :
  ComplexConverges(
    F, zero, addF, lt,
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
      integrand, a, b, ordered
    ),
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete
    )
  ) {
  exact field_second(
    Complex(F),
    ComplexConverges(
      F, zero, addF, lt,
      affine_dyadic_sum(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
        integrand, a, b, ordered
      )
    ),
    affine_dyadic_integral_exists(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete
    )
  );
}

// Any other limit of these actual sums is the constructed integral.
def affine_dyadic_integral_unique(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F, lt : F -> F
  -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), minF : F -> F -> F, maxF : F -> F
  -> F, lattice : FieldLattice(F, lt, minF, maxF), inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), z : Complex(F), slope : Complex(F),
  integrand : Complex(F) -> Complex(F),
  uniform : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => integrand(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), a : FieldUnitInterval(F, zero, one, lt), b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt), value : Complex(F),
  converges : ComplexConverges(
    F, zero, addF, lt,
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
      integrand, a, b, ordered
    ), value
  )
) :
  affine_dyadic_integral(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete
  ) = value {
  let halving =
    ordered_field_halving(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses);
  exact complex_limit_unique(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, halving,
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
      integrand, a, b, ordered
    ),
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete
    ), value,
    affine_dyadic_integral_converges(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete
    ), converges
  );
}

// Changing the witnesses used to obtain a modulus or a limit cannot change
// the value: the sampled sequence does not contain these witnesses.
def affine_dyadic_integral_independent_data(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F, lt : F -> F
  -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), minF : F -> F -> F, maxF : F -> F
  -> F, lattice : FieldLattice(F, lt, minF, maxF), inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), z : Complex(F), slope : Complex(F),
  integrand : Complex(F) -> Complex(F),
  uniform : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => integrand(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), a : FieldUnitInterval(F, zero, one, lt), b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt),
  otherInverses : FieldInverses(F, zero, one, mulF, lt),
  otherBounds : ArchimedeanBounds(F, zero, one, addF, lt),
  otherUniform : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => integrand(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), otherComplete : CauchyComplete(F, zero, addF, lt)
) :
  affine_dyadic_integral(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete
  ) = affine_dyadic_integral(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, otherInverses,
    otherBounds, half, halfSum, z, slope, integrand, otherUniform, a, b, ordered, otherComplete
  ) {
  exact affine_dyadic_integral_unique(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, integrand, uniform, a, b, ordered, complete,
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice,
      otherInverses, otherBounds, half, halfSum, z, slope, integrand, otherUniform, a, b, ordered,
      otherComplete
    ),
    affine_dyadic_integral_converges(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice,
      otherInverses, otherBounds, half, halfSum, z, slope, integrand, otherUniform, a, b, ordered,
      otherComplete
    )
  );
}
