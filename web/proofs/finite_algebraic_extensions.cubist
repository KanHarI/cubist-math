import polynomial_coordinate_maps;
import minimal_polynomials;
import finite_basis_search;
import extension_degree;

// The n+1 powers of any element of an n-dimensional extension are dependent.
// The resulting nonzero coefficient array is a formal annihilating polynomial.
def finite_basis_element_algebraic(
  K L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat,
  basis : FiniteBasis(K, field_vector_space(K, L, e), n), x : af_carrier(L)
) :
  AlgebraicElement(K, L, e, x) {
  let V = field_vector_space(K, L, e);
  let C = CoordinateSpace(K, succ(n));
  let evaluation = polynomial_evaluation_linear(K, L, e, x, succ(n));
  have impossible : (AlgebraicElement(K, L, e, x) -> Void) -> Void {
    intro transcendental;
    have kernel :
      forall a : Fin(succ(n)) -> af_carrier(K), linear_map(K, C, V, evaluation, a) = field_zero(L)
      -> a = (fun (i : Fin(succ(n))) => field_zero(K)) {
      intro a root;
      let p = polynomial_from_coordinates(K, succ(n), a);
      have zero : p = polynomial_zero(K) {
        have contradiction : PolynomialNonzero(K, p) -> Void {
          intro nonzero;
          exact transcendental(
            merely(
              (exists q : Polynomial(K), PolynomialNonzero(K, q) and PolynomialRoot(K, L, e, q, x)),
              typed(
                (
                  exists q : Polynomial(K), PolynomialNonzero(K, q)
                  and PolynomialRoot(K, L, e, q, x)
                ), (p, nonzero, root)
              )
            )
          );
        }
        exact double_negation(
          p = polynomial_zero(K), polynomial_set(K, p, polynomial_zero(K)), contradiction
        );
      }
      exact polynomial_from_coordinates_zero(K, succ(n), a, zero);
    }
    let inverse = linear_iso_inverse(K, CoordinateSpace(K, n), V, basis);
    exact coordinate_embedding_bound(
      K, V, n, linear_iso_forward(K, V, CoordinateSpace(K, n), inverse),
      linear_iso_injective(K, V, CoordinateSpace(K, n), inverse), evaluation,
      linear_kernel_injective(K, C, V, evaluation, kernel)
    );
  }
  exact double_negation(
    AlgebraicElement(K, L, e, x),
    mere_is_prop(
      exists p : Polynomial(K), PolynomialNonzero(K, p) and PolynomialRoot(K, L, e, p, x)
    ), impossible
  );
}

def AlgebraicExtension(K L : AlgebraicField, e : FieldEmbedding(K, L)) =
  forall x : af_carrier(L), AlgebraicElement(K, L, e, x);

def finite_extension_algebraic(
  K L : AlgebraicField, e : FieldEmbedding(K, L),
  finite : FiniteExtension(K, embedding_as_extension(K, L, e))
) :
  AlgebraicExtension(K, L, e) {
  intro x;
  obtain (n, basis) = finite;
  exact mere_eliminate(
    FiniteBasis(K, field_vector_space(K, L, e), n), AlgebraicElement(K, L, e, x),
    mere_is_prop(
      exists p : Polynomial(K), PolynomialNonzero(K, p) and PolynomialRoot(K, L, e, p, x)
    ),
    (
      fun (b : FiniteBasis(K, field_vector_space(K, L, e), n)) => finite_basis_element_algebraic(
        K, L, e, n, b, x
      )
    ), basis
  );
}
