import field_extensions;

// F2 and F4 are constructed by finite tables. F4 represents F2[t]/(t^2+t+1):
// the four entries are 0, 1, alpha, alpha+1. Every algebraic law below is
// checked by elimination of the finite carrier and computation in each case.
def F2Carrier = Fin(2);
def f2_0 = typed((Unit or Fin(1)), left(tt));
def f2_1 = typed((Unit or Fin(1)), right(typed((Unit or Fin(0)), left(tt))));
def f2_induction(C : F2Carrier -> U0, c0 : C(f2_0), c1 : C(f2_1), x : F2Carrier) : C(x) {
  exact match typed(Unit or Fin(1), x) as point0 return C(point0) {
      left u0 => unit_induction((fun (u : Unit) => C(typed((Unit or Fin(1)), left(u)))), c0, u0);
      right tail1 => match typed(Unit or Fin(0), tail1) as point1 return C(typed((Unit or Fin(1)), right(point1))) {
      left u1 => unit_induction((fun (u : Unit) => C(typed((Unit or Fin(1)), right(typed((Unit or Fin(0)), left(u)))))), c1, u1);
      right tail2 => typed(C(typed((Unit or Fin(1)), right(typed((Unit or Fin(0)), right(tail2))))), absurd(tail2));
    };
    };
}
def f2_add(x : F2Carrier, y : F2Carrier) =
  f2_induction((fun (x : F2Carrier) => F2Carrier),
    f2_induction((fun (y : F2Carrier) => F2Carrier), f2_0, f2_1, y),
    f2_induction((fun (y : F2Carrier) => F2Carrier), f2_1, f2_0, y), x);
def f2_mul(x : F2Carrier, y : F2Carrier) =
  f2_induction((fun (x : F2Carrier) => F2Carrier),
    f2_induction((fun (y : F2Carrier) => F2Carrier), f2_0, f2_0, y),
    f2_induction((fun (y : F2Carrier) => F2Carrier), f2_0, f2_1, y), x);
def f2_ops = field_ops(F2Carrier, f2_0, f2_1, (fun (x : F2Carrier) => x), f2_add, f2_mul);
theorem f2_add_assoc(x : F2Carrier, y : F2Carrier, z : F2Carrier) : f2_add(f2_add(x, y), z) = f2_add(x, f2_add(y, z)) {
  exact f2_induction((fun (x : F2Carrier) => f2_add(f2_add(x, y), z) = f2_add(x, f2_add(y, z))),
    f2_induction((fun (y : F2Carrier) => f2_add(f2_add(f2_0, y), z) = f2_add(f2_0, f2_add(y, z))),
    f2_induction((fun (z : F2Carrier) => f2_add(f2_add(f2_0, f2_0), z) = f2_add(f2_0, f2_add(f2_0, z))),
    refl(f2_add(f2_add(f2_0, f2_0), f2_0)),
    refl(f2_add(f2_add(f2_0, f2_0), f2_1)), z),
    f2_induction((fun (z : F2Carrier) => f2_add(f2_add(f2_0, f2_1), z) = f2_add(f2_0, f2_add(f2_1, z))),
    refl(f2_add(f2_add(f2_0, f2_1), f2_0)),
    refl(f2_add(f2_add(f2_0, f2_1), f2_1)), z), y),
    f2_induction((fun (y : F2Carrier) => f2_add(f2_add(f2_1, y), z) = f2_add(f2_1, f2_add(y, z))),
    f2_induction((fun (z : F2Carrier) => f2_add(f2_add(f2_1, f2_0), z) = f2_add(f2_1, f2_add(f2_0, z))),
    refl(f2_add(f2_add(f2_1, f2_0), f2_0)),
    refl(f2_add(f2_add(f2_1, f2_0), f2_1)), z),
    f2_induction((fun (z : F2Carrier) => f2_add(f2_add(f2_1, f2_1), z) = f2_add(f2_1, f2_add(f2_1, z))),
    refl(f2_add(f2_add(f2_1, f2_1), f2_0)),
    refl(f2_add(f2_add(f2_1, f2_1), f2_1)), z), y), x);
}
theorem f2_add_comm(x : F2Carrier, y : F2Carrier) : f2_add(x, y) = f2_add(y, x) {
  exact f2_induction((fun (x : F2Carrier) => f2_add(x, y) = f2_add(y, x)),
    f2_induction((fun (y : F2Carrier) => f2_add(f2_0, y) = f2_add(y, f2_0)),
    refl(f2_add(f2_0, f2_0)),
    refl(f2_add(f2_0, f2_1)), y),
    f2_induction((fun (y : F2Carrier) => f2_add(f2_1, y) = f2_add(y, f2_1)),
    refl(f2_add(f2_1, f2_0)),
    refl(f2_add(f2_1, f2_1)), y), x);
}
theorem f2_add_zero(x : F2Carrier) : f2_add(f2_0, x) = x {
  exact f2_induction((fun (x : F2Carrier) => f2_add(f2_0, x) = x),
    refl(f2_add(f2_0, f2_0)),
    refl(f2_add(f2_0, f2_1)), x);
}
theorem f2_add_neg(x : F2Carrier) : f2_add(x, x) = f2_0 {
  exact f2_induction((fun (x : F2Carrier) => f2_add(x, x) = f2_0),
    refl(f2_add(f2_0, f2_0)),
    refl(f2_add(f2_1, f2_1)), x);
}
theorem f2_mul_assoc(x : F2Carrier, y : F2Carrier, z : F2Carrier) : f2_mul(f2_mul(x, y), z) = f2_mul(x, f2_mul(y, z)) {
  exact f2_induction((fun (x : F2Carrier) => f2_mul(f2_mul(x, y), z) = f2_mul(x, f2_mul(y, z))),
    f2_induction((fun (y : F2Carrier) => f2_mul(f2_mul(f2_0, y), z) = f2_mul(f2_0, f2_mul(y, z))),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_mul(f2_0, f2_0), z) = f2_mul(f2_0, f2_mul(f2_0, z))),
    refl(f2_mul(f2_mul(f2_0, f2_0), f2_0)),
    refl(f2_mul(f2_mul(f2_0, f2_0), f2_1)), z),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_mul(f2_0, f2_1), z) = f2_mul(f2_0, f2_mul(f2_1, z))),
    refl(f2_mul(f2_mul(f2_0, f2_1), f2_0)),
    refl(f2_mul(f2_mul(f2_0, f2_1), f2_1)), z), y),
    f2_induction((fun (y : F2Carrier) => f2_mul(f2_mul(f2_1, y), z) = f2_mul(f2_1, f2_mul(y, z))),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_mul(f2_1, f2_0), z) = f2_mul(f2_1, f2_mul(f2_0, z))),
    refl(f2_mul(f2_mul(f2_1, f2_0), f2_0)),
    refl(f2_mul(f2_mul(f2_1, f2_0), f2_1)), z),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_mul(f2_1, f2_1), z) = f2_mul(f2_1, f2_mul(f2_1, z))),
    refl(f2_mul(f2_mul(f2_1, f2_1), f2_0)),
    refl(f2_mul(f2_mul(f2_1, f2_1), f2_1)), z), y), x);
}
theorem f2_mul_comm(x : F2Carrier, y : F2Carrier) : f2_mul(x, y) = f2_mul(y, x) {
  exact f2_induction((fun (x : F2Carrier) => f2_mul(x, y) = f2_mul(y, x)),
    f2_induction((fun (y : F2Carrier) => f2_mul(f2_0, y) = f2_mul(y, f2_0)),
    refl(f2_mul(f2_0, f2_0)),
    refl(f2_mul(f2_0, f2_1)), y),
    f2_induction((fun (y : F2Carrier) => f2_mul(f2_1, y) = f2_mul(y, f2_1)),
    refl(f2_mul(f2_1, f2_0)),
    refl(f2_mul(f2_1, f2_1)), y), x);
}
theorem f2_mul_one(x : F2Carrier) : f2_mul(f2_1, x) = x {
  exact f2_induction((fun (x : F2Carrier) => f2_mul(f2_1, x) = x),
    refl(f2_mul(f2_1, f2_0)),
    refl(f2_mul(f2_1, f2_1)), x);
}
theorem f2_distribute(x : F2Carrier, y : F2Carrier, z : F2Carrier) : f2_mul(x, f2_add(y, z)) = f2_add(f2_mul(x, y), f2_mul(x, z)) {
  exact f2_induction((fun (x : F2Carrier) => f2_mul(x, f2_add(y, z)) = f2_add(f2_mul(x, y), f2_mul(x, z))),
    f2_induction((fun (y : F2Carrier) => f2_mul(f2_0, f2_add(y, z)) = f2_add(f2_mul(f2_0, y), f2_mul(f2_0, z))),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_0, f2_add(f2_0, z)) = f2_add(f2_mul(f2_0, f2_0), f2_mul(f2_0, z))),
    refl(f2_mul(f2_0, f2_add(f2_0, f2_0))),
    refl(f2_mul(f2_0, f2_add(f2_0, f2_1))), z),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_0, f2_add(f2_1, z)) = f2_add(f2_mul(f2_0, f2_1), f2_mul(f2_0, z))),
    refl(f2_mul(f2_0, f2_add(f2_1, f2_0))),
    refl(f2_mul(f2_0, f2_add(f2_1, f2_1))), z), y),
    f2_induction((fun (y : F2Carrier) => f2_mul(f2_1, f2_add(y, z)) = f2_add(f2_mul(f2_1, y), f2_mul(f2_1, z))),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_1, f2_add(f2_0, z)) = f2_add(f2_mul(f2_1, f2_0), f2_mul(f2_1, z))),
    refl(f2_mul(f2_1, f2_add(f2_0, f2_0))),
    refl(f2_mul(f2_1, f2_add(f2_0, f2_1))), z),
    f2_induction((fun (z : F2Carrier) => f2_mul(f2_1, f2_add(f2_1, z)) = f2_add(f2_mul(f2_1, f2_1), f2_mul(f2_1, z))),
    refl(f2_mul(f2_1, f2_add(f2_1, f2_0))),
    refl(f2_mul(f2_1, f2_add(f2_1, f2_1))), z), y), x);
}
def f2_nontrivial(p : f2_1 = f2_0) = sum_disjoint(Fin(1), tt, typed((Unit or Fin(0)), left(tt)), sym(p));
def f2_inverses(x : F2Carrier) = f2_induction(
  (fun (x : F2Carrier) => FieldNonzero(F2Carrier, f2_ops, x) -> exists y : F2Carrier, f2_mul(x, y) = f2_1),
  (fun (h : FieldNonzero(F2Carrier, f2_ops, f2_0)) => typed((exists y : F2Carrier, f2_mul(f2_0, y) = f2_1), absurd(h(refl(f2_0))))),
  (fun (h : FieldNonzero(F2Carrier, f2_ops, f2_1)) => typed((exists y : F2Carrier, f2_mul(f2_1, y) = f2_1), (f2_1, refl(f2_1)))), x);
def f2_laws : AlgebraicFieldLaws(F2Carrier, f2_ops) {
  exact (((f2_add_assoc, (f2_add_comm, (f2_add_zero, f2_add_neg))),
    (f2_mul_assoc, (f2_mul_comm, (f2_mul_one, f2_distribute)))), (f2_nontrivial, f2_inverses));
}
def F2 = algebraic_field(F2Carrier, f2_ops, fin_is_set(2), f2_laws);
def F4Carrier = Fin(4);
def f4_0 = typed((Unit or Fin(3)), left(tt));
def f4_1 = typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), left(tt))));
def f4_2 = typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), right(typed((Unit or Fin(1)), left(tt))))));
def f4_3 = typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), right(typed((Unit or Fin(1)), right(typed((Unit or Fin(0)), left(tt))))))));
def f4_induction(C : F4Carrier -> U0, c0 : C(f4_0), c1 : C(f4_1), c2 : C(f4_2), c3 : C(f4_3), x : F4Carrier) : C(x) {
  exact match typed(Unit or Fin(3), x) as point0 return C(point0) {
      left u0 => unit_induction((fun (u : Unit) => C(typed((Unit or Fin(3)), left(u)))), c0, u0);
      right tail1 => match typed(Unit or Fin(2), tail1) as point1 return C(typed((Unit or Fin(3)), right(point1))) {
      left u1 => unit_induction((fun (u : Unit) => C(typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), left(u)))))), c1, u1);
      right tail2 => match typed(Unit or Fin(1), tail2) as point2 return C(typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), right(point2))))) {
      left u2 => unit_induction((fun (u : Unit) => C(typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), right(typed((Unit or Fin(1)), left(u)))))))), c2, u2);
      right tail3 => match typed(Unit or Fin(0), tail3) as point3 return C(typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), right(typed((Unit or Fin(1)), right(point3))))))) {
      left u3 => unit_induction((fun (u : Unit) => C(typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), right(typed((Unit or Fin(1)), right(typed((Unit or Fin(0)), left(u)))))))))), c3, u3);
      right tail4 => typed(C(typed((Unit or Fin(3)), right(typed((Unit or Fin(2)), right(typed((Unit or Fin(1)), right(typed((Unit or Fin(0)), right(tail4))))))))), absurd(tail4));
    };
    };
    };
    };
}
def f4_add(x : F4Carrier, y : F4Carrier) =
  f4_induction((fun (x : F4Carrier) => F4Carrier),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_0, f4_1, f4_2, f4_3, y),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_1, f4_0, f4_3, f4_2, y),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_2, f4_3, f4_0, f4_1, y),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_3, f4_2, f4_1, f4_0, y), x);
def f4_mul(x : F4Carrier, y : F4Carrier) =
  f4_induction((fun (x : F4Carrier) => F4Carrier),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_0, f4_0, f4_0, f4_0, y),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_0, f4_1, f4_2, f4_3, y),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_0, f4_2, f4_3, f4_1, y),
    f4_induction((fun (y : F4Carrier) => F4Carrier), f4_0, f4_3, f4_1, f4_2, y), x);
def f4_ops = field_ops(F4Carrier, f4_0, f4_1, (fun (x : F4Carrier) => x), f4_add, f4_mul);
theorem f4_add_assoc(x : F4Carrier, y : F4Carrier, z : F4Carrier) : f4_add(f4_add(x, y), z) = f4_add(x, f4_add(y, z)) {
  exact f4_induction((fun (x : F4Carrier) => f4_add(f4_add(x, y), z) = f4_add(x, f4_add(y, z))),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_add(f4_0, y), z) = f4_add(f4_0, f4_add(y, z))),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_0, f4_0), z) = f4_add(f4_0, f4_add(f4_0, z))),
    refl(f4_add(f4_add(f4_0, f4_0), f4_0)),
    refl(f4_add(f4_add(f4_0, f4_0), f4_1)),
    refl(f4_add(f4_add(f4_0, f4_0), f4_2)),
    refl(f4_add(f4_add(f4_0, f4_0), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_0, f4_1), z) = f4_add(f4_0, f4_add(f4_1, z))),
    refl(f4_add(f4_add(f4_0, f4_1), f4_0)),
    refl(f4_add(f4_add(f4_0, f4_1), f4_1)),
    refl(f4_add(f4_add(f4_0, f4_1), f4_2)),
    refl(f4_add(f4_add(f4_0, f4_1), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_0, f4_2), z) = f4_add(f4_0, f4_add(f4_2, z))),
    refl(f4_add(f4_add(f4_0, f4_2), f4_0)),
    refl(f4_add(f4_add(f4_0, f4_2), f4_1)),
    refl(f4_add(f4_add(f4_0, f4_2), f4_2)),
    refl(f4_add(f4_add(f4_0, f4_2), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_0, f4_3), z) = f4_add(f4_0, f4_add(f4_3, z))),
    refl(f4_add(f4_add(f4_0, f4_3), f4_0)),
    refl(f4_add(f4_add(f4_0, f4_3), f4_1)),
    refl(f4_add(f4_add(f4_0, f4_3), f4_2)),
    refl(f4_add(f4_add(f4_0, f4_3), f4_3)), z), y),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_add(f4_1, y), z) = f4_add(f4_1, f4_add(y, z))),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_1, f4_0), z) = f4_add(f4_1, f4_add(f4_0, z))),
    refl(f4_add(f4_add(f4_1, f4_0), f4_0)),
    refl(f4_add(f4_add(f4_1, f4_0), f4_1)),
    refl(f4_add(f4_add(f4_1, f4_0), f4_2)),
    refl(f4_add(f4_add(f4_1, f4_0), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_1, f4_1), z) = f4_add(f4_1, f4_add(f4_1, z))),
    refl(f4_add(f4_add(f4_1, f4_1), f4_0)),
    refl(f4_add(f4_add(f4_1, f4_1), f4_1)),
    refl(f4_add(f4_add(f4_1, f4_1), f4_2)),
    refl(f4_add(f4_add(f4_1, f4_1), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_1, f4_2), z) = f4_add(f4_1, f4_add(f4_2, z))),
    refl(f4_add(f4_add(f4_1, f4_2), f4_0)),
    refl(f4_add(f4_add(f4_1, f4_2), f4_1)),
    refl(f4_add(f4_add(f4_1, f4_2), f4_2)),
    refl(f4_add(f4_add(f4_1, f4_2), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_1, f4_3), z) = f4_add(f4_1, f4_add(f4_3, z))),
    refl(f4_add(f4_add(f4_1, f4_3), f4_0)),
    refl(f4_add(f4_add(f4_1, f4_3), f4_1)),
    refl(f4_add(f4_add(f4_1, f4_3), f4_2)),
    refl(f4_add(f4_add(f4_1, f4_3), f4_3)), z), y),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_add(f4_2, y), z) = f4_add(f4_2, f4_add(y, z))),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_2, f4_0), z) = f4_add(f4_2, f4_add(f4_0, z))),
    refl(f4_add(f4_add(f4_2, f4_0), f4_0)),
    refl(f4_add(f4_add(f4_2, f4_0), f4_1)),
    refl(f4_add(f4_add(f4_2, f4_0), f4_2)),
    refl(f4_add(f4_add(f4_2, f4_0), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_2, f4_1), z) = f4_add(f4_2, f4_add(f4_1, z))),
    refl(f4_add(f4_add(f4_2, f4_1), f4_0)),
    refl(f4_add(f4_add(f4_2, f4_1), f4_1)),
    refl(f4_add(f4_add(f4_2, f4_1), f4_2)),
    refl(f4_add(f4_add(f4_2, f4_1), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_2, f4_2), z) = f4_add(f4_2, f4_add(f4_2, z))),
    refl(f4_add(f4_add(f4_2, f4_2), f4_0)),
    refl(f4_add(f4_add(f4_2, f4_2), f4_1)),
    refl(f4_add(f4_add(f4_2, f4_2), f4_2)),
    refl(f4_add(f4_add(f4_2, f4_2), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_2, f4_3), z) = f4_add(f4_2, f4_add(f4_3, z))),
    refl(f4_add(f4_add(f4_2, f4_3), f4_0)),
    refl(f4_add(f4_add(f4_2, f4_3), f4_1)),
    refl(f4_add(f4_add(f4_2, f4_3), f4_2)),
    refl(f4_add(f4_add(f4_2, f4_3), f4_3)), z), y),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_add(f4_3, y), z) = f4_add(f4_3, f4_add(y, z))),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_3, f4_0), z) = f4_add(f4_3, f4_add(f4_0, z))),
    refl(f4_add(f4_add(f4_3, f4_0), f4_0)),
    refl(f4_add(f4_add(f4_3, f4_0), f4_1)),
    refl(f4_add(f4_add(f4_3, f4_0), f4_2)),
    refl(f4_add(f4_add(f4_3, f4_0), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_3, f4_1), z) = f4_add(f4_3, f4_add(f4_1, z))),
    refl(f4_add(f4_add(f4_3, f4_1), f4_0)),
    refl(f4_add(f4_add(f4_3, f4_1), f4_1)),
    refl(f4_add(f4_add(f4_3, f4_1), f4_2)),
    refl(f4_add(f4_add(f4_3, f4_1), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_3, f4_2), z) = f4_add(f4_3, f4_add(f4_2, z))),
    refl(f4_add(f4_add(f4_3, f4_2), f4_0)),
    refl(f4_add(f4_add(f4_3, f4_2), f4_1)),
    refl(f4_add(f4_add(f4_3, f4_2), f4_2)),
    refl(f4_add(f4_add(f4_3, f4_2), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_add(f4_add(f4_3, f4_3), z) = f4_add(f4_3, f4_add(f4_3, z))),
    refl(f4_add(f4_add(f4_3, f4_3), f4_0)),
    refl(f4_add(f4_add(f4_3, f4_3), f4_1)),
    refl(f4_add(f4_add(f4_3, f4_3), f4_2)),
    refl(f4_add(f4_add(f4_3, f4_3), f4_3)), z), y), x);
}
theorem f4_add_comm(x : F4Carrier, y : F4Carrier) : f4_add(x, y) = f4_add(y, x) {
  exact f4_induction((fun (x : F4Carrier) => f4_add(x, y) = f4_add(y, x)),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_0, y) = f4_add(y, f4_0)),
    refl(f4_add(f4_0, f4_0)),
    refl(f4_add(f4_0, f4_1)),
    refl(f4_add(f4_0, f4_2)),
    refl(f4_add(f4_0, f4_3)), y),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_1, y) = f4_add(y, f4_1)),
    refl(f4_add(f4_1, f4_0)),
    refl(f4_add(f4_1, f4_1)),
    refl(f4_add(f4_1, f4_2)),
    refl(f4_add(f4_1, f4_3)), y),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_2, y) = f4_add(y, f4_2)),
    refl(f4_add(f4_2, f4_0)),
    refl(f4_add(f4_2, f4_1)),
    refl(f4_add(f4_2, f4_2)),
    refl(f4_add(f4_2, f4_3)), y),
    f4_induction((fun (y : F4Carrier) => f4_add(f4_3, y) = f4_add(y, f4_3)),
    refl(f4_add(f4_3, f4_0)),
    refl(f4_add(f4_3, f4_1)),
    refl(f4_add(f4_3, f4_2)),
    refl(f4_add(f4_3, f4_3)), y), x);
}
theorem f4_add_zero(x : F4Carrier) : f4_add(f4_0, x) = x {
  exact f4_induction((fun (x : F4Carrier) => f4_add(f4_0, x) = x),
    refl(f4_add(f4_0, f4_0)),
    refl(f4_add(f4_0, f4_1)),
    refl(f4_add(f4_0, f4_2)),
    refl(f4_add(f4_0, f4_3)), x);
}
theorem f4_add_neg(x : F4Carrier) : f4_add(x, x) = f4_0 {
  exact f4_induction((fun (x : F4Carrier) => f4_add(x, x) = f4_0),
    refl(f4_add(f4_0, f4_0)),
    refl(f4_add(f4_1, f4_1)),
    refl(f4_add(f4_2, f4_2)),
    refl(f4_add(f4_3, f4_3)), x);
}
theorem f4_mul_assoc(x : F4Carrier, y : F4Carrier, z : F4Carrier) : f4_mul(f4_mul(x, y), z) = f4_mul(x, f4_mul(y, z)) {
  exact f4_induction((fun (x : F4Carrier) => f4_mul(f4_mul(x, y), z) = f4_mul(x, f4_mul(y, z))),
