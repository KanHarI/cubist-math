theorem f4_mul_comm(x : F4Carrier, y : F4Carrier) : f4_mul(x, y) = f4_mul(y, x) {
  exact f4_induction((fun (x : F4Carrier) => f4_mul(x, y) = f4_mul(y, x)),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_0, y) = f4_mul(y, f4_0)),
    refl(f4_mul(f4_0, f4_0)),
    refl(f4_mul(f4_0, f4_1)),
    refl(f4_mul(f4_0, f4_2)),
    refl(f4_mul(f4_0, f4_3)), y),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_1, y) = f4_mul(y, f4_1)),
    refl(f4_mul(f4_1, f4_0)),
    refl(f4_mul(f4_1, f4_1)),
    refl(f4_mul(f4_1, f4_2)),
    refl(f4_mul(f4_1, f4_3)), y),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_2, y) = f4_mul(y, f4_2)),
    refl(f4_mul(f4_2, f4_0)),
    refl(f4_mul(f4_2, f4_1)),
    refl(f4_mul(f4_2, f4_2)),
    refl(f4_mul(f4_2, f4_3)), y),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_3, y) = f4_mul(y, f4_3)),
    refl(f4_mul(f4_3, f4_0)),
    refl(f4_mul(f4_3, f4_1)),
    refl(f4_mul(f4_3, f4_2)),
    refl(f4_mul(f4_3, f4_3)), y), x);
}
theorem f4_mul_one(x : F4Carrier) : f4_mul(f4_1, x) = x {
  exact f4_induction((fun (x : F4Carrier) => f4_mul(f4_1, x) = x),
    refl(f4_mul(f4_1, f4_0)),
    refl(f4_mul(f4_1, f4_1)),
    refl(f4_mul(f4_1, f4_2)),
    refl(f4_mul(f4_1, f4_3)), x);
}
theorem f4_distribute(x : F4Carrier, y : F4Carrier, z : F4Carrier) : f4_mul(x, f4_add(y, z)) = f4_add(f4_mul(x, y), f4_mul(x, z)) {
  exact f4_induction((fun (x : F4Carrier) => f4_mul(x, f4_add(y, z)) = f4_add(f4_mul(x, y), f4_mul(x, z))),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_0, f4_add(y, z)) = f4_add(f4_mul(f4_0, y), f4_mul(f4_0, z))),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_0, f4_add(f4_0, z)) = f4_add(f4_mul(f4_0, f4_0), f4_mul(f4_0, z))),
    refl(f4_mul(f4_0, f4_add(f4_0, f4_0))),
    refl(f4_mul(f4_0, f4_add(f4_0, f4_1))),
    refl(f4_mul(f4_0, f4_add(f4_0, f4_2))),
    refl(f4_mul(f4_0, f4_add(f4_0, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_0, f4_add(f4_1, z)) = f4_add(f4_mul(f4_0, f4_1), f4_mul(f4_0, z))),
    refl(f4_mul(f4_0, f4_add(f4_1, f4_0))),
    refl(f4_mul(f4_0, f4_add(f4_1, f4_1))),
    refl(f4_mul(f4_0, f4_add(f4_1, f4_2))),
    refl(f4_mul(f4_0, f4_add(f4_1, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_0, f4_add(f4_2, z)) = f4_add(f4_mul(f4_0, f4_2), f4_mul(f4_0, z))),
    refl(f4_mul(f4_0, f4_add(f4_2, f4_0))),
    refl(f4_mul(f4_0, f4_add(f4_2, f4_1))),
    refl(f4_mul(f4_0, f4_add(f4_2, f4_2))),
    refl(f4_mul(f4_0, f4_add(f4_2, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_0, f4_add(f4_3, z)) = f4_add(f4_mul(f4_0, f4_3), f4_mul(f4_0, z))),
    refl(f4_mul(f4_0, f4_add(f4_3, f4_0))),
    refl(f4_mul(f4_0, f4_add(f4_3, f4_1))),
    refl(f4_mul(f4_0, f4_add(f4_3, f4_2))),
    refl(f4_mul(f4_0, f4_add(f4_3, f4_3))), z), y),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_1, f4_add(y, z)) = f4_add(f4_mul(f4_1, y), f4_mul(f4_1, z))),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_1, f4_add(f4_0, z)) = f4_add(f4_mul(f4_1, f4_0), f4_mul(f4_1, z))),
    refl(f4_mul(f4_1, f4_add(f4_0, f4_0))),
    refl(f4_mul(f4_1, f4_add(f4_0, f4_1))),
    refl(f4_mul(f4_1, f4_add(f4_0, f4_2))),
    refl(f4_mul(f4_1, f4_add(f4_0, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_1, f4_add(f4_1, z)) = f4_add(f4_mul(f4_1, f4_1), f4_mul(f4_1, z))),
    refl(f4_mul(f4_1, f4_add(f4_1, f4_0))),
    refl(f4_mul(f4_1, f4_add(f4_1, f4_1))),
    refl(f4_mul(f4_1, f4_add(f4_1, f4_2))),
    refl(f4_mul(f4_1, f4_add(f4_1, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_1, f4_add(f4_2, z)) = f4_add(f4_mul(f4_1, f4_2), f4_mul(f4_1, z))),
    refl(f4_mul(f4_1, f4_add(f4_2, f4_0))),
    refl(f4_mul(f4_1, f4_add(f4_2, f4_1))),
    refl(f4_mul(f4_1, f4_add(f4_2, f4_2))),
    refl(f4_mul(f4_1, f4_add(f4_2, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_1, f4_add(f4_3, z)) = f4_add(f4_mul(f4_1, f4_3), f4_mul(f4_1, z))),
    refl(f4_mul(f4_1, f4_add(f4_3, f4_0))),
    refl(f4_mul(f4_1, f4_add(f4_3, f4_1))),
    refl(f4_mul(f4_1, f4_add(f4_3, f4_2))),
    refl(f4_mul(f4_1, f4_add(f4_3, f4_3))), z), y),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_2, f4_add(y, z)) = f4_add(f4_mul(f4_2, y), f4_mul(f4_2, z))),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_2, f4_add(f4_0, z)) = f4_add(f4_mul(f4_2, f4_0), f4_mul(f4_2, z))),
    refl(f4_mul(f4_2, f4_add(f4_0, f4_0))),
    refl(f4_mul(f4_2, f4_add(f4_0, f4_1))),
    refl(f4_mul(f4_2, f4_add(f4_0, f4_2))),
    refl(f4_mul(f4_2, f4_add(f4_0, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_2, f4_add(f4_1, z)) = f4_add(f4_mul(f4_2, f4_1), f4_mul(f4_2, z))),
    refl(f4_mul(f4_2, f4_add(f4_1, f4_0))),
    refl(f4_mul(f4_2, f4_add(f4_1, f4_1))),
    refl(f4_mul(f4_2, f4_add(f4_1, f4_2))),
    refl(f4_mul(f4_2, f4_add(f4_1, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_2, f4_add(f4_2, z)) = f4_add(f4_mul(f4_2, f4_2), f4_mul(f4_2, z))),
    refl(f4_mul(f4_2, f4_add(f4_2, f4_0))),
    refl(f4_mul(f4_2, f4_add(f4_2, f4_1))),
    refl(f4_mul(f4_2, f4_add(f4_2, f4_2))),
    refl(f4_mul(f4_2, f4_add(f4_2, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_2, f4_add(f4_3, z)) = f4_add(f4_mul(f4_2, f4_3), f4_mul(f4_2, z))),
    refl(f4_mul(f4_2, f4_add(f4_3, f4_0))),
    refl(f4_mul(f4_2, f4_add(f4_3, f4_1))),
    refl(f4_mul(f4_2, f4_add(f4_3, f4_2))),
    refl(f4_mul(f4_2, f4_add(f4_3, f4_3))), z), y),
    f4_induction((fun (y : F4Carrier) => f4_mul(f4_3, f4_add(y, z)) = f4_add(f4_mul(f4_3, y), f4_mul(f4_3, z))),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_3, f4_add(f4_0, z)) = f4_add(f4_mul(f4_3, f4_0), f4_mul(f4_3, z))),
    refl(f4_mul(f4_3, f4_add(f4_0, f4_0))),
    refl(f4_mul(f4_3, f4_add(f4_0, f4_1))),
    refl(f4_mul(f4_3, f4_add(f4_0, f4_2))),
    refl(f4_mul(f4_3, f4_add(f4_0, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_3, f4_add(f4_1, z)) = f4_add(f4_mul(f4_3, f4_1), f4_mul(f4_3, z))),
    refl(f4_mul(f4_3, f4_add(f4_1, f4_0))),
    refl(f4_mul(f4_3, f4_add(f4_1, f4_1))),
    refl(f4_mul(f4_3, f4_add(f4_1, f4_2))),
    refl(f4_mul(f4_3, f4_add(f4_1, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_3, f4_add(f4_2, z)) = f4_add(f4_mul(f4_3, f4_2), f4_mul(f4_3, z))),
    refl(f4_mul(f4_3, f4_add(f4_2, f4_0))),
    refl(f4_mul(f4_3, f4_add(f4_2, f4_1))),
    refl(f4_mul(f4_3, f4_add(f4_2, f4_2))),
    refl(f4_mul(f4_3, f4_add(f4_2, f4_3))), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_3, f4_add(f4_3, z)) = f4_add(f4_mul(f4_3, f4_3), f4_mul(f4_3, z))),
    refl(f4_mul(f4_3, f4_add(f4_3, f4_0))),
    refl(f4_mul(f4_3, f4_add(f4_3, f4_1))),
    refl(f4_mul(f4_3, f4_add(f4_3, f4_2))),
    refl(f4_mul(f4_3, f4_add(f4_3, f4_3))), z), y), x);
}
def f4_nontrivial(p : f4_1 = f4_0) = sum_disjoint(Fin(3), tt, typed((Unit or Fin(2)), left(tt)), sym(p));
def f4_inverses(x : F4Carrier) = f4_induction(
  (fun (x : F4Carrier) => FieldNonzero(F4Carrier, f4_ops, x) -> exists y : F4Carrier, f4_mul(x, y) = f4_1),
  (fun (h : FieldNonzero(F4Carrier, f4_ops, f4_0)) => typed((exists y : F4Carrier, f4_mul(f4_0, y) = f4_1), absurd(h(refl(f4_0))))),
  (fun (h : FieldNonzero(F4Carrier, f4_ops, f4_1)) => typed((exists y : F4Carrier, f4_mul(f4_1, y) = f4_1), (f4_1, refl(f4_1)))),
  (fun (h : FieldNonzero(F4Carrier, f4_ops, f4_2)) => typed((exists y : F4Carrier, f4_mul(f4_2, y) = f4_1), (f4_3, refl(f4_1)))),
  (fun (h : FieldNonzero(F4Carrier, f4_ops, f4_3)) => typed((exists y : F4Carrier, f4_mul(f4_3, y) = f4_1), (f4_2, refl(f4_1)))), x);
def f4_laws : AlgebraicFieldLaws(F4Carrier, f4_ops) {
  exact (((f4_add_assoc, (f4_add_comm, (f4_add_zero, f4_add_neg))),
    (f4_mul_assoc, (f4_mul_comm, (f4_mul_one, f4_distribute)))), (f4_nontrivial, f4_inverses));
}
def F4 = algebraic_field(F4Carrier, f4_ops, fin_is_set(4), f4_laws);
