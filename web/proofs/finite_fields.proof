    refl(f4_mul(f4_mul(f4_1, f4_1), f4_0)),
    refl(f4_mul(f4_mul(f4_1, f4_1), f4_1)),
    refl(f4_mul(f4_mul(f4_1, f4_1), f4_2)),
    refl(f4_mul(f4_mul(f4_1, f4_1), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_mul(f4_1, f4_2), z) = f4_mul(f4_1, f4_mul(f4_2, z))),
    refl(f4_mul(f4_mul(f4_1, f4_2), f4_0)),
    refl(f4_mul(f4_mul(f4_1, f4_2), f4_1)),
    refl(f4_mul(f4_mul(f4_1, f4_2), f4_2)),
    refl(f4_mul(f4_mul(f4_1, f4_2), f4_3)), z),
    f4_induction((fun (z : F4Carrier) => f4_mul(f4_mul(f4_1, f4_3), z) = f4_mul(f4_1, f4_mul(f4_3, z))),
