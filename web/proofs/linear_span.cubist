import finite_bases;

// A finite linear combination has an explicit list of vectors and scalars.
// Fin(n) supplies its indices, including the empty combination when n = 0.
def linear_combination(K : AlgebraicField, V : VectorSpace(K), n : Nat) =
  induction n as k return (
    (Fin(k) -> vector_carrier(K, V)) -> (Fin(k) -> af_carrier(K)) -> vector_carrier(K, V)
  ) {
    zero => fun (vectors : Fin(0) -> vector_carrier(K, V)) => fun (
      coefficients : Fin(0) -> af_carrier(K)
    ) => vector_zero(K, V);
    succ previous => fun (vectors : Fin(succ(k)) -> vector_carrier(K, V)) => fun (
      coefficients : Fin(succ(k)) -> af_carrier(K)
    ) => vector_add(
      K, V,
      vector_scale(
        K, V, coefficients(typed(Fin(succ(k)), left(tt))), vectors(typed(Fin(succ(k)), left(tt)))
      ),
      previous(
        (fun (i : Fin(k)) => vectors(typed(Fin(succ(k)), right(i)))),
        (fun (i : Fin(k)) => coefficients(typed(Fin(succ(k)), right(i))))
      )
    );
  };

def SpanWitness(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, x : vector_carrier(K, V)
) =
  exists n : Nat, exists vectors : Fin(n) -> vector_carrier(K, V),
  exists coefficients : Fin(n) -> af_carrier(K), (forall i : Fin(n), P(vectors(i)))
  and (linear_combination(K, V, n, vectors, coefficients) = x);

// Span asserts mere existence of a finite combination. It does not choose
// coordinates and cannot be eliminated into an arbitrary data type.
def Span(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, x : vector_carrier(K, V)
) =
  Truncate(U0, SpanWitness(K, V, P, x));

def span_prop(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, x : vector_carrier(K, V)
) =
  TruncateProp(U0, SpanWitness(K, V, P, x));

def span_zero(K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0) :
  Span(K, V, P, vector_zero(K, V)) {
  exact TruncateIntro(
    U0, SpanWitness(K, V, P, vector_zero(K, V)),
    typed(
      SpanWitness(K, V, P, vector_zero(K, V)),
      (
        0, (fun (i : Fin(0)) => typed(vector_carrier(K, V), absurd(i))),
        (fun (i : Fin(0)) => typed(af_carrier(K), absurd(i))),
        (fun (i : Fin(0)) => typed(P(typed(vector_carrier(K, V), absurd(i))), absurd(i))),
        refl(vector_zero(K, V))
      )
    )
  );
}

def span_generator(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, x : vector_carrier(K, V),
  member : P(x)
) :
  Span(K, V, P, x) {
  exact TruncateIntro(
    U0, SpanWitness(K, V, P, x),
    typed(
      SpanWitness(K, V, P, x),
      (
        1, (fun (i : Fin(1)) => x), (fun (i : Fin(1)) => af_one(af_carrier(K), af_operations(K))),
        (fun (i : Fin(1)) => member),
        trans(
          cong(
            (fun (y : vector_carrier(K, V)) => vector_add(K, V, y, vector_zero(K, V))),
            vector_scale_one(K, V, x)
          ), group_unit_right(vector_group(K, V), x)
        )
      )
    )
  );
}

def span_included(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, Q : vector_carrier(K, V)
  -> U0, included : (forall x : vector_carrier(K, V), P(x) -> Q(x)), x : vector_carrier(K, V),
  member : Span(K, V, P, x)
) :
  Span(K, V, Q, x) {
  have mapWitness : SpanWitness(K, V, P, x) -> Span(K, V, Q, x) {
    intro witness;
    obtain (n, vectors, coefficients, members, sum) = witness;
    exact TruncateIntro(
      U0, SpanWitness(K, V, Q, x),
      typed(
        SpanWitness(K, V, Q, x),
        (n, vectors, coefficients, (fun (i : Fin(n)) => included(vectors(i), members(i))), sum)
      )
    );
  }
  exact TruncateElim(
    U0, SpanWitness(K, V, P, x), Span(K, V, Q, x), span_prop(K, V, Q, x), mapWitness, member
  );
}

// Independence quantifies over distinct finite lists of members. Distinctness
// is essential: repeated vectors can otherwise cancel with nonzero coefficients.
def LinearlyIndependent(K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0) =
  forall n : Nat, forall vectors : Fin(n) -> vector_carrier(K, V),
  (forall i : Fin(n), forall j : Fin(n), vectors(i) = vectors(j) -> i = j)
  -> (forall i : Fin(n), P(vectors(i))) -> forall coefficients : Fin(n) -> af_carrier(K),
  linear_combination(K, V, n, vectors, coefficients) = vector_zero(K, V) -> forall i : Fin(n),
  coefficients(i) = af_zero(af_carrier(K), af_operations(K));

def Spans(K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0) =
  forall x : vector_carrier(K, V), Span(K, V, P, x);

// A general basis is a proposition-valued subset, not necessarily finite.
// This is the target interface for the proof via Zorn derived from choice.
def VectorBasis(K : AlgebraicField, V : VectorSpace(K)) =
  exists P : vector_carrier(K, V) -> U0, (forall x : vector_carrier(K, V), Proposition(P(x)))
  and LinearlyIndependent(K, V, P) and Spans(K, V, P);

// The empty subset is independent, constructively.
def empty_linearly_independent(K : AlgebraicField, V : VectorSpace(K)) :
  LinearlyIndependent(K, V, (fun (x : vector_carrier(K, V)) => Void)) {
  intro n;
  intro vectors;
  intro distinct;
  intro members;
  intro coefficients;
  intro vanishes;
  intro i;
  exact absurd(members(i));
}

// Independence excludes the zero vector: its coefficient 1 would vanish.
def independent_excludes_zero(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  independent : LinearlyIndependent(K, V, P), member : P(vector_zero(K, V))
) :
  Void {
  let A = af_carrier(K);
  let ops = af_operations(K);
  let zero = vector_zero(K, V);
  obtain (ring, nontrivial, inverses) = af_laws(K);
  have vanishes :
    linear_combination(K, V, 1, (fun (i : Fin(1)) => zero), (fun (i : Fin(1)) => af_one(A, ops))) = zero {
    exact trans(
      cong(
        (fun (x : vector_carrier(K, V)) => vector_add(K, V, x, zero)), vector_scale_one(K, V, zero)
      ), group_unit_right(vector_group(K, V), zero)
    );
  }
  exact nontrivial(
    independent(
      1, (fun (i : Fin(1)) => zero),
      (
        fun (i : Fin(1)) => fun (j : Fin(1)) => fun (same : zero = zero) => trans(
          sym(fin_one_unique(i)), fin_one_unique(j)
        )
      ), (fun (i : Fin(1)) => member), (fun (i : Fin(1)) => af_one(A, ops)), vanishes,
      fin_one_center
    )
  );
}
