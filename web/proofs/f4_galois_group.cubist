import f4_galois;
import group_univalence;
import fundamental_groups;

// Every automorphism is determined by the image of alpha. The only possible
// images are alpha and alpha+1, so the Galois group has exactly two elements.
def F4Automorphism = Galois(F2, F4OverF2);

def f4_auto_apply(e : F4Automorphism) : F4Carrier -> F4Carrier {
  exact extension_iso_forward(F2, F4OverF2, F4OverF2, e);
}

def f4_auto_field_map(e : F4Automorphism) :
  FieldOpsPreserved(F4Carrier, F4Carrier, f4_auto_apply(e), f4_ops, f4_ops) {
  exact fst(
    FieldOpsPreserved(F4Carrier, F4Carrier, f4_auto_apply(e), f4_ops, f4_ops),
    (forall k : F2Carrier, f4_auto_apply(e, f2_into_f4(k)) = f2_into_f4(k)),
    structure_iso_preserves(ExtensionData(F2), ExtensionPreserved(F2), F4OverF2, F4OverF2, e)
  );
}

theorem f4_auto_ext(
  e : F4Automorphism, d : F4Automorphism, alpha : f4_auto_apply(e, f4_2) = f4_auto_apply(d, f4_2)
) :
  e = d {
  obtain (e0, e1, en, ea, em) = f4_auto_field_map(e);
  obtain (d0, d1, dn, da, dm) = f4_auto_field_map(d);
  let onePath = trans(e1, sym(d1));
  have other : f4_auto_apply(e, f4_3) = f4_auto_apply(d, f4_3) {
    exact trans(
      ea(f4_2, f4_1),
      trans(
        cong((fun (x : F4Carrier) => f4_add(x, f4_auto_apply(e, f4_1))), alpha),
        trans(cong(f4_add(f4_auto_apply(d, f4_2)), onePath), sym(da(f4_2, f4_1)))
      )
    );
  }
  exact structure_iso_ext(
    ExtensionData(F2), ExtensionPreserved(F2), extension_preserved_prop(F2), F4OverF2, F4OverF2, e,
    d,
    (
      fun (x : F4Carrier) => f4_induction(
        (fun (x : F4Carrier) => f4_auto_apply(e, x) = f4_auto_apply(d, x)), trans(e0, sym(d0)),
        onePath, alpha, other, x
      )
    )
  );
}

theorem f4_auto_injective(
  e : F4Automorphism, x : F4Carrier, y : F4Carrier, p : f4_auto_apply(e, x) = f4_auto_apply(e, y)
) :
  x = y {
  let bijection =
    structure_iso_bijection(ExtensionData(F2), ExtensionPreserved(F2), F4OverF2, F4OverF2, e);
  exact trans(
    sym(left_inverse(F4Carrier, F4Carrier, bijection, x)),
    trans(
      cong(backward(F4Carrier, F4Carrier, bijection), p),
      left_inverse(F4Carrier, F4Carrier, bijection, y)
    )
  );
}

def f4_symmetry(b : F2Carrier) =
  f2_induction(
    (fun (b : F2Carrier) => F4Automorphism), f4_identity_automorphism, f4_frobenius_automorphism, b
  );

def f4_root_bit(x : F4Carrier) =
  f4_induction((fun (x : F4Carrier) => F2Carrier), f2_0, f2_0, f2_0, f2_1, x);

def f4_symmetry_bit(e : F4Automorphism) = f4_root_bit(f4_auto_apply(e, f4_2));

theorem f4_symmetry_bit_roundtrip(b : F2Carrier) : f4_symmetry_bit(f4_symmetry(b)) = b {
  exact f2_induction(
    (fun (b : F2Carrier) => f4_symmetry_bit(f4_symmetry(b)) = b), refl(f2_0), refl(f2_1), b
  );
}

theorem f4_symmetry_classify(e : F4Automorphism) : f4_symmetry(f4_symmetry_bit(e)) = e {
  obtain (e0, e1, en, ea, em) = f4_auto_field_map(e);
  let f = f4_auto_apply(e);
  have classify : (f(f4_2) = f(f4_2)) -> (f4_symmetry(f4_symmetry_bit(e)) = e) {
    exact f4_induction(
      (fun (v : F4Carrier) => (f(f4_2) = v) -> (f4_symmetry(f4_root_bit(v)) = e)),
      (
        fun (p : f(f4_2) = f4_0) => typed(
          (f4_symmetry(f4_root_bit(f4_0)) = e),
          absurd(f4_2_not_0(f4_auto_injective(e, f4_2, f4_0, trans(p, sym(e0)))))
        )
      ),
      (
        fun (p : f(f4_2) = f4_1) => typed(
          (f4_symmetry(f4_root_bit(f4_1)) = e),
          absurd(f4_2_not_1(f4_auto_injective(e, f4_2, f4_1, trans(p, sym(e1)))))
        )
      ), (fun (p : f(f4_2) = f4_2) => f4_auto_ext(f4_identity_automorphism, e, sym(p))),
      (fun (p : f(f4_2) = f4_3) => f4_auto_ext(f4_frobenius_automorphism, e, sym(p))), f(f4_2)
    );
  }
  exact classify(refl(f(f4_2)));
}

theorem f4_galois_has_two_elements : Bijection(F2Carrier, F4Automorphism) {
  exact (f4_symmetry, f4_symmetry_bit, f4_symmetry_bit_roundtrip, f4_symmetry_classify);
}

def f4_auto_compose(e : F4Automorphism, d : F4Automorphism) =
  extension_iso_compose(F2, F4OverF2, F4OverF2, F4OverF2, e, d);

theorem f4_symmetry_add(a : F2Carrier, b : F2Carrier) :
  f4_symmetry(f2_add(a, b)) = f4_auto_compose(f4_symmetry(a), f4_symmetry(b)) {
  exact f2_induction(
    (
      fun (a : F2Carrier) => f4_symmetry(f2_add(a, b)) = f4_auto_compose(
        f4_symmetry(a), f4_symmetry(b)
      )
    ),
    f2_induction(
      (
        fun (b : F2Carrier) => f4_symmetry(f2_add(f2_0, b)) = f4_auto_compose(
          f4_symmetry(f2_0), f4_symmetry(b)
        )
      ),
      f4_auto_ext(
        f4_identity_automorphism,
        f4_auto_compose(f4_identity_automorphism, f4_identity_automorphism), refl(f4_2)
      ),
      f4_auto_ext(
        f4_frobenius_automorphism,
        f4_auto_compose(f4_identity_automorphism, f4_frobenius_automorphism), refl(f4_3)
      ), b
    ),
    f2_induction(
      (
        fun (b : F2Carrier) => f4_symmetry(f2_add(f2_1, b)) = f4_auto_compose(
          f4_symmetry(f2_1), f4_symmetry(b)
        )
      ),
      f4_auto_ext(
        f4_frobenius_automorphism,
        f4_auto_compose(f4_frobenius_automorphism, f4_identity_automorphism), refl(f4_3)
      ), sym(f4_frobenius_square), b
    ), a
  );
}

theorem f4_auto_square(e : F4Automorphism) : f4_auto_compose(e, e) = f4_identity_automorphism {
  exact trans(
    sym(cong((fun (e : F4Automorphism) => f4_auto_compose(e, e)), f4_symmetry_classify(e))),
    trans(
      sym(f4_symmetry_add(f4_symmetry_bit(e), f4_symmetry_bit(e))),
      cong(f4_symmetry, f2_add_neg(f4_symmetry_bit(e)))
    )
  );
}

def F4GaloisGroup = GaloisGroup(F2, F4OverF2);

def cyclic_two_laws : GroupLaws(F2Carrier, f2_0, f2_add) {
  exact (
    fin_is_set(2), f2_add_assoc, f2_add_zero,
    (fun (x : F2Carrier) => trans(f2_add_comm(x, f2_0), f2_add_zero(x))),
    (
      fun (x : F2Carrier) => typed(
        (exists y : F2Carrier, (f2_add(y, x) = f2_0) and (f2_add(x, y) = f2_0)),
        (x, f2_add_neg(x), f2_add_neg(x))
      )
    )
  );
}

def CyclicTwo = group_object(F2Carrier, f2_0, f2_add, cyclic_two_laws);

theorem f4_galois_is_cyclic_two : GroupIso(CyclicTwo, F4GaloisGroup) {
  exact (
    f4_symmetry, f4_symmetry_bit, f4_symmetry_bit_roundtrip, f4_symmetry_classify, f4_symmetry_add
  );
}

theorem f4_galois_group_equality : CyclicTwo =[Group] F4GaloisGroup {
  exact group_isotoid(CyclicTwo, F4GaloisGroup, f4_galois_is_cyclic_two);
}

// Loops are equalities of the whole extension, including its F2-embedding.
// This identity type lives in U1; no truncation or resizing is applied.
def F4ExtensionLoops = F4OverF2 =[FieldExt(F2)] F4OverF2;

def f4_loop_of_bit(b : F2Carrier) = extension_iso_path(F2, F4OverF2, F4OverF2, f4_symmetry(b));

def f4_loop_bit(p : F4ExtensionLoops) =
  f4_symmetry_bit(extension_path_iso(F2, F4OverF2, F4OverF2, p));

theorem f4_loop_bit_roundtrip(b : F2Carrier) : f4_loop_bit(f4_loop_of_bit(b)) = b {
  exact with unfolding [f4_loop_bit, f4_loop_of_bit] {
    trans(
      cong(f4_symmetry_bit, extension_iso_roundtrip(F2, F4OverF2, F4OverF2, f4_symmetry(b))),
      f4_symmetry_bit_roundtrip(b)
    )
  };
}

theorem f4_extension_loop_roundtrip(p : F4ExtensionLoops) : f4_loop_of_bit(f4_loop_bit(p)) = p {
  exact with unfolding [f4_loop_bit, f4_loop_of_bit] {
    trans(
      cong(
        extension_iso_path(F2, F4OverF2, F4OverF2),
        f4_symmetry_classify(extension_path_iso(F2, F4OverF2, F4OverF2, p))
      ), extension_path_roundtrip(F2, F4OverF2, F4OverF2, p)
    )
  };
}

// The two loops are reflexivity and the nontrivial Frobenius loop.
theorem f4_symmetry_zero : f4_symmetry(f2_0) = f4_identity_automorphism {
  exact with unfolding [f4_symmetry] {
    refl(f4_identity_automorphism)
  };
}

theorem f4_symmetry_one : f4_symmetry(f2_1) = f4_frobenius_automorphism {
  exact with unfolding [f4_symmetry] {
    refl(f4_frobenius_automorphism)
  };
}

theorem f4_loop_zero : f4_loop_of_bit(f2_0) = refl(F4OverF2) {
  exact with unfolding [f4_loop_of_bit, f4_identity_automorphism] {
    trans(
      cong(extension_iso_path(F2, F4OverF2, F4OverF2), f4_symmetry_zero),
      galois_identity_is_reflexivity(F2, F4OverF2)
    )
  };
}

theorem f4_loop_one : f4_loop_of_bit(f2_1) = f4_galois_loop {
  exact with unfolding [f4_loop_of_bit, f4_galois_loop] {
    cong(extension_iso_path(F2, F4OverF2, F4OverF2), f4_symmetry_one)
  };
}

theorem f4_loop_of_bit_add(a : F2Carrier, b : F2Carrier) :
  f4_loop_of_bit(f2_add(a, b)) = trans(f4_loop_of_bit(a), f4_loop_of_bit(b)) {
  exact with unfolding [f4_loop_of_bit, f4_auto_compose] {
    trans(
      cong(extension_iso_path(F2, F4OverF2, F4OverF2), f4_symmetry_add(a, b)),
      galois_composition_is_concatenation(F2, F4OverF2, f4_symmetry(a), f4_symmetry(b))
    )
  };
}

// Reading a concatenation of loops gives the sum of their two symmetry bits.
theorem f4_loop_bit_concatenate(p : F4ExtensionLoops, q : F4ExtensionLoops) :
  f4_loop_bit(trans(p, q)) = f2_add(f4_loop_bit(p), f4_loop_bit(q)) {
  have recovered :
    trans(f4_loop_of_bit(f4_loop_bit(p)), f4_loop_of_bit(f4_loop_bit(q))) = trans(p, q) {
    exact trans(
      cong(
        (fun (r : F4ExtensionLoops) => trans(r, f4_loop_of_bit(f4_loop_bit(q)))),
        f4_extension_loop_roundtrip(p)
      ), cong((fun (r : F4ExtensionLoops) => trans(p, r)), f4_extension_loop_roundtrip(q))
    );
  }
  exact with unfolding [f4_loop_bit, f4_loop_of_bit] {
    trans(
      sym(cong(f4_loop_bit, recovered)),
      trans(
        cong(f4_loop_bit, sym(f4_loop_of_bit_add(f4_loop_bit(p), f4_loop_bit(q)))),
        f4_loop_bit_roundtrip(f2_add(f4_loop_bit(p), f4_loop_bit(q)))
      )
    )
  };
}

def f4_extension_loop_equivalence : Equiv(U1, F4ExtensionLoops, group_carrier(CyclicTwo)) {
  exact equiv_from_inverse_into_set(
    U1, F4ExtensionLoops, F2Carrier, fin_is_set(2), f4_loop_bit, f4_loop_of_bit,
    f4_extension_loop_roundtrip, f4_loop_bit_roundtrip
  );
}

// Univalence identifies the actual identity type of the extension with C2's
// carrier. This is a proved equality of types, not definitional equality.
// Under this identification, concatenation is addition modulo two.
theorem f4_extension_loops_equal_cyclic_two :
  (F4OverF2 =[FieldExt(F2)] F4OverF2) =[U1] group_carrier(CyclicTwo) {
  exact ua(U1, F4ExtensionLoops, group_carrier(CyclicTwo), f4_extension_loop_equivalence);
}

// Transport along the displayed equality is the explicit symmetry-bit map.
theorem f4_extension_loop_equality_action(p : F4ExtensionLoops) :
  transport(
    (fun (A : U1) => A), F4ExtensionLoops, group_carrier(CyclicTwo),
    f4_extension_loops_equal_cyclic_two, p
  ) = f4_loop_bit(p) {
  exact with unfolding [f4_extension_loops_equal_cyclic_two, f4_extension_loop_equivalence] {
    UnivalenceBeta(U1, F4ExtensionLoops, group_carrier(CyclicTwo), f4_extension_loop_equivalence, p)
  };
}

theorem f4_automorphisms_equal_loops : F4Automorphism =[U1] F4ExtensionLoops {
  exact galois_automorphisms_are_loops(F2, F4OverF2);
}

// Concatenation gives the loop type its group structure in the same universe.
def f4_extension_loop_multiply(p : F4ExtensionLoops, q : F4ExtensionLoops) = trans(p, q);

def f4_extension_loops_are_set :
  forall p : F4ExtensionLoops, forall q : F4ExtensionLoops, forall r : p = q, forall s : p = q,
  r = s {
  exact transport(
    (fun (A : U1) => forall x : A, forall y : A, forall p : x = y, forall q : x = y, p = q),
    F2Carrier, F4ExtensionLoops, sym(f4_extension_loops_equal_cyclic_two), fin_is_set(2)
  );
}

def f4_extension_loop_group_laws =
  fundamental_group_laws(FieldExt(F2), F4OverF2, f4_extension_loops_are_set);

// This is pi_1(Ext(F2), F4): the loop space is already a set.
def F4ExtensionLoopGroup = FundamentalGroup(FieldExt(F2), F4OverF2, f4_extension_loops_are_set);

// Repackage the small cyclic group in U1 so both carriers have the same bound.
def CyclicTwoAtU1 = group_object_at(U1, F2Carrier, f2_0, f2_add, cyclic_two_laws);

// The identification respects the full group operations, not just cardinality.
theorem f4_extension_loop_group_is_cyclic_two : GroupIsoAt(U1, F4ExtensionLoopGroup, CyclicTwoAtU1) {
  exact (
    f4_loop_bit, f4_loop_of_bit, f4_extension_loop_roundtrip, f4_loop_bit_roundtrip,
    f4_loop_bit_concatenate
  );
}

// pi_1(Ext(F2), F4) is cyclic of order two. This compares bundled groups:
// the two loops are the constant loop and Frobenius, and concatenation is
// addition modulo two. No set truncation is needed: the loops form a set.
theorem f4_extension_fundamental_group_is_cyclic_two :
  GroupIsoAt(
    U1, FundamentalGroup(FieldExt(F2), F4OverF2, f4_extension_loops_are_set), CyclicTwoAtU1
  ) {
  exact f4_extension_loop_group_is_cyclic_two;
}
