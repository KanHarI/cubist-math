// Cubical paths expose their interval coordinate; Interval is binder syntax,
// not an additional type in the universe hierarchy.
def reverse_path(A : U0, x : A, y : A, p : x = y) =
  path(fun (i : Interval) => A, fun (i : Interval) => at(p, flip(i)));

// Reversing twice computes to the original path, even in an arbitrary type.
theorem reverse_twice(A : U0, x : A, y : A, p : x = y) : reverse_path(
  A, y, x, reverse_path(A, x, y, p)
) = p {
  exact refl(p);
}

// Function action is pointwise application along a path.
def map_path(A : U0, B : U0, f : A -> B, x : A, y : A, p : x = y) =
  path(fun (i : Interval) => B, fun (i : Interval) => f(at(p, i)));

// Paths in a varying family can be stated without encoding them as transport.
def dependent_path(P : PathP(fun (i : Interval) => U0, Nat, Nat), x : Nat, y : Nat) =
  PathP(fun (i : Interval) => at(P, i), x, y);

// An empty tube gives transport through a family of types.
def transport_path(P : PathP(fun (i : Interval) => U0, Nat, Nat), x : Nat) =
  comp(fun (i : Interval) => at(P, i), x);

// Composition fills a square with fixed left edge and right edge q.
def join_paths(A : U0, x : A, y : A, z : A, p : x = y, q : y = z) =
  path(
    fun (i : Interval) => A,
    fun (i : Interval) => comp(
      fun (j : Interval) => A, at(p, i), face(i, 0, fun (j : Interval) => x),
      face(i, 1, fun (j : Interval) => at(q, j))
    )
  );

def Susp(A : U0) = Pushout(A, Unit, Unit, fun (a : A) => tt, fun (a : A) => tt);

def susp_meridian(A : U0, a : A) = push_path(Susp(A), a);

// Induction checks the bridge as a dependent path with the required endpoints.
def collapse_suspension(A : U0, z : Susp(A)) =
  pushout_induction(
    fun (p : Susp(A)) => Unit, fun (a : Unit) => tt, fun (b : Unit) => tt,
    fun (a : A) => path(fun (i : Interval) => Unit, fun (i : Interval) => tt), z
  );

theorem collapse_north(A : U0) : collapse_suspension(A, push_left(Susp(A), tt)) = tt {
  exact refl(tt);
}

// The transport-based suspension interface is also derived from the pushout.
// Its bridge to dependent paths includes an independently checked inverse law.
def unit_family(p : Suspension(Unit)) = Unit;
theorem unit_unique(u : Unit) = unit_induction(fun (x : Unit) => x = tt, refl(tt), u);
def transported_meridian(a : Unit) =
  unit_unique(transport(unit_family, north(Unit), south(Unit), meridian(Unit, a), tt));
def collapse_with_transport(p : Suspension(Unit)) =
  suspension_induction(unit_family, tt, tt, transported_meridian, p);

theorem transported_meridian_beta(a : Unit) : apd(
  collapse_with_transport, north(Unit), south(Unit), meridian(Unit, a)
) = transported_meridian(a) {
  exact suspension_meridian_beta(unit_family, tt, tt, transported_meridian, a);
}
