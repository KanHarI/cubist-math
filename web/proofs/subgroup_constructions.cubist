import subgroups;
import group_homomorphisms;

def SubgroupIncluded(G : Group, S : Subgroup(G), T : Subgroup(G)) =
  forall x : group_carrier(G), subgroup_members(G, S, x) -> subgroup_members(G, T, x);

def subgroup_inclusion_prop(G : Group, S : Subgroup(G), T : Subgroup(G)) :
  Proposition(SubgroupIncluded(G, S, T)) {
  let A = group_carrier(G);
  let P = subgroup_members(G, S);
  let Q = subgroup_members(G, T);
  exact forall_prop(
    A, (fun (x : A) => P(x) -> Q(x)),
    (
      fun (x : A) => forall_prop(
        P(x), (fun (member : P(x)) => Q(x)),
        (fun (member : P(x)) => subgroup_prop(G, Q, subgroup_laws(G, T), x))
      )
    )
  );
}

def subgroup_inclusion_refl(G : Group, S : Subgroup(G)) : SubgroupIncluded(G, S, S) {
  exact (fun (x : group_carrier(G)) => fun (member : subgroup_members(G, S, x)) => member);
}

def subgroup_inclusion_trans(
  G : Group, S : Subgroup(G), T : Subgroup(G), V : Subgroup(G), st : SubgroupIncluded(G, S, T),
  tv : SubgroupIncluded(G, T, V)
) :
  SubgroupIncluded(G, S, V) {
  exact (
    fun (x : group_carrier(G)) => fun (member : subgroup_members(G, S, x)) => tv(x, st(x, member))
  );
}

def subgroup_inclusion_antisymmetric(
  G : Group, S : Subgroup(G), T : Subgroup(G), st : SubgroupIncluded(G, S, T),
  ts : SubgroupIncluded(G, T, S)
) :
  S =[Subgroup(G)] T {
  exact subgroup_ext(
    G, S, T,
    field_predicate_ext(
      group_carrier(G), subgroup_members(G, S), subgroup_members(G, T),
      subgroup_prop(G, subgroup_members(G, S), subgroup_laws(G, S)),
      subgroup_prop(G, subgroup_members(G, T), subgroup_laws(G, T)),
      (
        fun (x : group_carrier(G)) => typed(
          (
            (subgroup_members(G, S, x) -> subgroup_members(G, T, x))
            and (subgroup_members(G, T, x) -> subgroup_members(G, S, x))
          ), (st(x), ts(x))
        )
      )
    )
  );
}

def SubgroupTop(G : Group, x : group_carrier(G)) = Unit;

def subgroup_top_laws(G : Group) : SubgroupLaws(G, SubgroupTop(G)) {
  exact (
    (
      fun (x : group_carrier(G)) => fun (p : Unit) => fun (q : Unit) => trans(
        sym(unit_equal(p)), unit_equal(q)
      )
    ), tt,
    (
      fun (x : group_carrier(G)) => fun (y : group_carrier(G)) => fun (hx : Unit) => fun (hy : Unit) => tt
    ),
    (
      fun (x : group_carrier(G)) => fun (y : group_carrier(G)) => fun (hx : Unit) => fun (
        same : group_multiply(G, y, x) = group_unit(G)
      ) => tt
    )
  );
}

def subgroup_top(G : Group) : Subgroup(G) {
  exact (SubgroupTop(G), subgroup_top_laws(G));
}

def SubgroupBottom(G : Group, x : group_carrier(G)) = x = group_unit(G);

def subgroup_bottom_laws(G : Group) : SubgroupLaws(G, SubgroupBottom(G)) {
  let A = group_carrier(G);
  let one = group_unit(G);
  let m = group_multiply(G);
  exact (
    (fun (x : A) => group_is_set(G, x, one)), refl(one),
    (
      fun (x : A) => fun (y : A) => fun (hx : x = one) => fun (hy : y = one) => trans(
        cong((fun (z : A) => m(z, y)), hx), trans(group_unit_left(G, y), hy)
      )
    ),
    (
      fun (x : A) => fun (y : A) => fun (hx : x = one) => fun (same : m(y, x) = one) => trans(
        sym(group_unit_right(G, y)), trans(cong(m(y), sym(hx)), same)
      )
    )
  );
}

def subgroup_bottom(G : Group) : Subgroup(G) {
  exact (SubgroupBottom(G), subgroup_bottom_laws(G));
}

def subgroup_bottom_least(G : Group, S : Subgroup(G)) : SubgroupIncluded(G, subgroup_bottom(G), S) {
  intro x;
  intro same;
  exact transport(
    subgroup_members(G, S), group_unit(G), x, sym(typed((x = group_unit(G)), same)),
    subgroup_unit(G, subgroup_members(G, S), subgroup_laws(G, S))
  );
}

def subgroup_top_greatest(G : Group, S : Subgroup(G)) : SubgroupIncluded(G, S, subgroup_top(G)) {
  exact (fun (x : group_carrier(G)) => fun (member : subgroup_members(G, S, x)) => tt);
}

// Inverse images are contravariant in homomorphisms and require no
// surjectivity or decision of subgroup membership.
def SubgroupPreimage(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(H), x : group_carrier(G)
) =
  subgroup_members(H, S, group_hom_map(G, H, h, x));

def subgroup_preimage_laws(G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(H)) :
  SubgroupLaws(G, SubgroupPreimage(G, H, h, S)) {
  let A = group_carrier(G);
  let f = group_hom_map(G, H, h);
  let P = subgroup_members(H, S);
  let laws = subgroup_laws(H, S);
  exact (
    (fun (x : A) => subgroup_prop(H, P, laws, f(x))),
    transport(
      P, group_unit(H), f(group_unit(G)), sym(group_hom_unit(G, H, h)), subgroup_unit(H, P, laws)
    ),
    (
      fun (x : A) => fun (y : A) => fun (hx : P(f(x))) => fun (hy : P(f(y))) => transport(
        P, group_multiply(H, f(x), f(y)), f(group_multiply(G, x, y)),
        sym(group_hom_multiply(G, H, h, x, y)), subgroup_multiply(H, P, laws, f(x), f(y), hx, hy)
      )
    ),
    (
      fun (x : A) => fun (y : A) => fun (hx : P(f(x))) => fun (
        same : group_multiply(G, y, x) = group_unit(G)
      ) => subgroup_inverse(
        H, P, laws, f(x), f(y), hx,
        trans(sym(group_hom_multiply(G, H, h, y, x)), trans(cong(f, same), group_hom_unit(G, H, h)))
      )
    )
  );
}

def subgroup_preimage(G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(H)) : Subgroup(G) {
  exact (SubgroupPreimage(G, H, h, S), subgroup_preimage_laws(G, H, h, S));
}

def subgroup_preimage_identity(G : Group, S : Subgroup(G)) :
  subgroup_preimage(G, G, group_hom_identity(G), S) =[Subgroup(G)] S {
  exact subgroup_ext(
    G, subgroup_preimage(G, G, group_hom_identity(G), S), S,
    FunExt(
      U1, group_carrier(G), (fun (x : group_carrier(G)) => U0),
      SubgroupPreimage(G, G, group_hom_identity(G), S), subgroup_members(G, S),
      (fun (x : group_carrier(G)) => refl(subgroup_members(G, S, x)))
    )
  );
}

def subgroup_preimage_composite(
  G : Group, H : Group, K : Group, h : GroupHom(G, H), k : GroupHom(H, K), S : Subgroup(K)
) :
  subgroup_preimage(G, K, group_hom_compose(G, H, K, h, k), S) =[Subgroup(G)] subgroup_preimage(
    G, H, h, subgroup_preimage(H, K, k, S)
  ) {
  exact subgroup_ext(
    G, subgroup_preimage(G, K, group_hom_compose(G, H, K, h, k), S),
    subgroup_preimage(G, H, h, subgroup_preimage(H, K, k, S)),
    refl(SubgroupPreimage(G, K, group_hom_compose(G, H, K, h, k), S))
  );
}

// Small-indexed intersections remain small predicates, as for subfields.
def SubgroupIntersection(G : Group, I : U0, family : I -> Subgroup(G), x : group_carrier(G)) =
  forall i : I, subgroup_members(G, family(i), x);

def subgroup_intersection_laws(G : Group, I : U0, family : I -> Subgroup(G)) :
  SubgroupLaws(G, SubgroupIntersection(G, I, family)) {
  let A = group_carrier(G);
  exact (
    (
      fun (x : A) => forall_prop(
        I, (fun (i : I) => subgroup_members(G, family(i), x)),
        (
          fun (i : I) => subgroup_prop(
            G, subgroup_members(G, family(i)), subgroup_laws(G, family(i)), x
          )
        )
      )
    ),
    (fun (i : I) => subgroup_unit(G, subgroup_members(G, family(i)), subgroup_laws(G, family(i)))),
    (
      fun (x : A) => fun (y : A) => fun (hx : SubgroupIntersection(G, I, family, x)) => fun (
        hy : SubgroupIntersection(G, I, family, y)
      ) => fun (i : I) => subgroup_multiply(
        G, subgroup_members(G, family(i)), subgroup_laws(G, family(i)), x, y, hx(i), hy(i)
      )
    ),
    (
      fun (x : A) => fun (y : A) => fun (hx : SubgroupIntersection(G, I, family, x)) => fun (
        same : group_multiply(G, y, x) = group_unit(G)
      ) => fun (i : I) => subgroup_inverse(
        G, subgroup_members(G, family(i)), subgroup_laws(G, family(i)), x, y, hx(i), same
      )
    )
  );
}

def subgroup_intersection(G : Group, I : U0, family : I -> Subgroup(G)) : Subgroup(G) {
  exact (SubgroupIntersection(G, I, family), subgroup_intersection_laws(G, I, family));
}

def subgroup_intersection_lower(G : Group, I : U0, family : I -> Subgroup(G), i : I) :
  SubgroupIncluded(G, subgroup_intersection(G, I, family), family(i)) {
  exact (
    fun (x : group_carrier(G)) => fun (member : SubgroupIntersection(G, I, family, x)) => member(i)
  );
}

def subgroup_intersection_greatest(
  G : Group, I : U0, family : I -> Subgroup(G), S : Subgroup(G),
  lower : (forall i : I, SubgroupIncluded(G, S, family(i)))
) :
  SubgroupIncluded(G, S, subgroup_intersection(G, I, family)) {
  exact (
    fun (x : group_carrier(G)) => fun (member : subgroup_members(G, S, x)) => fun (i : I) => lower(
      i, x, member
    )
  );
}
