import polynomial_ideals;
import polynomial_maps;
import polynomial_root_bound;

def bounded_eval_mapped(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L), n : Nat
) =
  induction n as k return (
    forall f : FormalSeries(K),
    bounded_eval(
      L, L, field_embedding_identity(L), x, k, (fun (j : Nat) => field_embedding_map(K, L, e, f(j)))
    ) = bounded_eval(K, L, e, x, k, f)
  ) {
    zero => fun (f : FormalSeries(K)) => refl(field_zero(L));
    succ previous => fun (f : FormalSeries(K)) => cong(
      (
        fun (a : af_carrier(L)) => field_add(
          L, field_embedding_map(K, L, e, f(0)), field_mul(L, x, a)
        )
      ), previous(series_tail(K, f))
    );
  };

def polynomial_eval_mapped(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K),
  x : af_carrier(L)
) :
  polynomial_eval(L, L, field_embedding_identity(L), polynomial_map(K, L, e, p), x) = polynomial_eval(
    K, L, e, p, x
  ) {
  let n = polynomial_cutoff(K, p);
  let f = polynomial_coefficients(K, p);
  exact with unfolding [] {
    trans(
      cong(
        (
          fun (k : Nat) => bounded_eval(
            L, L, field_embedding_identity(L), x, k,
            (fun (j : Nat) => field_embedding_map(K, L, e, f(j)))
          )
        ), polynomial_map_cutoff(K, L, e, p)
      ), bounded_eval_mapped(K, L, e, x, n, f)
    )
  };
}

def polynomial_map_nonzero(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K),
  nonzero : PolynomialNonzero(K, p)
) :
  PolynomialNonzero(L, polynomial_map(K, L, e, p)) {
  intro zero;
  exact nonzero(
    polynomial_map_injective(
      K, L, e, p, polynomial_zero(K), trans(zero, sym(polynomial_map_zero(K, L, e)))
    )
  );
}

def ExtensionRootFamily(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K), n : Nat
) =
  exists roots : Fin(n) -> af_carrier(L), Injective(Fin(n), af_carrier(L), roots)
  and (forall i : Fin(n), PolynomialRoot(K, L, e, p, roots(i)));

def polynomial_extension_root_bound(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K),
  nonzero : PolynomialNonzero(K, p),
  family : ExtensionRootFamily(K, L, e, p, succ(polynomial_degree(K, p)))
) :
  Void {
  obtain (roots, distinct, vanishes) = family;
  let q = polynomial_map(K, L, e, p);
  let n = succ(polynomial_degree(K, p));
  let local =
    typed(
      RootFamily(L, q, n),
      (
        roots, distinct,
        (fun (i : Fin(n)) => trans(polynomial_eval_mapped(K, L, e, p, roots(i)), vanishes(i)))
      )
    );
  let degree =
    cong((fun (k : Nat) => succ(natural_predecessor(k))), polynomial_map_cutoff(K, L, e, p));
  exact polynomial_root_bound(
    L, q, polynomial_map_nonzero(K, L, e, p, nonzero),
    transport(RootFamily(L, q), n, succ(polynomial_degree(L, q)), sym(degree), local)
  );
}
