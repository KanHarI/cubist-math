import prelude;
import paths;

// Carriers in Type1 include proposition-valued Dedekind cuts over small Q.
// Universe arguments to the original prelude axioms remain explicit here.
def FieldProp(P : Type1) = forall p : P, forall q : P, p = q;
def FieldSet(F : Type1) = forall x : F, forall y : F, FieldProp(x = y);
def FieldExists(A : Type1) = truncation_at(Type1, A);
def field_exists_intro(A : Type1, a : A) = truncation_intro_at(Type1, A, a);
def field_exists_prop(A : Type1) = truncation_prop_at(Type1, A);
def field_exists_elim(A : Type1, P : Type1, prop : FieldProp(P), f : A -> P) =
  truncation_elim_at(Type1, A, P, prop, f);
def field_exists_map(A : Type1, B : Type1, f : A -> B, h : FieldExists(A)) =
  field_exists_elim(A, FieldExists(B), field_exists_prop(B),
    (fun (a : A) => field_exists_intro(B, f(a))), h);
def FieldOr(P : Type1, Q : Type1) = FieldExists(P or Q);
def FieldIff(P : Type1, Q : Type1) = (P -> Q) and (Q -> P);

def field_first(A : Type1, P : A -> Type1, pair : (exists a : A, P(a))) =
  unpack pair as (a, p) return A { a; };
def field_second(A : Type1, P : A -> Type1, pair : (exists a : A, P(a))) =
  pair_induction((fun (v : (exists a : A, P(a))) => P(field_first(A, P, v))),
    (fun (a : A) => fun (p : P(a)) => p), pair);
def field_fst(A : Type1, B : Type1, pair : A and B) = field_first(A, (fun (a : A) => B), pair);
def field_snd(A : Type1, B : Type1, pair : A and B) = field_second(A, (fun (a : A) => B), pair);

def field_forall_prop(A : Type1, P : A -> Type1, prop : (forall a : A, FieldProp(P(a))),
  f : (forall a : A, P(a)), g : (forall a : A, P(a))) =
  funext_at(Type1, A, P, f, g, (fun (a : A) => prop(a, f(a), g(a))));
def field_not_prop(A : Type1, f : A -> Void, g : A -> Void) =
  funext_at(Type1, A, (fun (a : A) => typed(Type1, Void)), f, g,
    (fun (a : A) => typed((f(a) = g(a)), absurd(f(a)))));
