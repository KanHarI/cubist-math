import subgroup_carriers;
import truncation;

// A homomorphism can have several preimages. Image membership records mere
// existence, so no representative is selected and the image is a subobject.
def SubgroupImageWitness(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), y : group_carrier(H)
) =
  exists x : group_carrier(G), subgroup_members(G, S, x) and (group_hom_map(G, H, h, x) = y);

def SubgroupImage(G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), y : group_carrier(H)) =
  Mere(SubgroupImageWitness(G, H, h, S, y));

def subgroup_image_prop(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), y : group_carrier(H)
) =
  mere_is_prop(SubgroupImageWitness(G, H, h, S, y));

def subgroup_image_intro(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), x : group_carrier(G),
  member : subgroup_members(G, S, x)
) :
  SubgroupImage(G, H, h, S, group_hom_map(G, H, h, x)) {
  exact merely(
    SubgroupImageWitness(G, H, h, S, group_hom_map(G, H, h, x)),
    typed(
      SubgroupImageWitness(G, H, h, S, group_hom_map(G, H, h, x)),
      (x, member, refl(group_hom_map(G, H, h, x)))
    )
  );
}

def subgroup_image_product_witness(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), y : group_carrier(H),
  z : group_carrier(H), a : SubgroupImageWitness(G, H, h, S, y),
  b : SubgroupImageWitness(G, H, h, S, z)
) :
  SubgroupImageWitness(G, H, h, S, group_multiply(H, y, z)) {
  obtain (x, sx, fx) = a;
  obtain (w, sw, fw) = b;
  let f = group_hom_map(G, H, h);
  exact (
    group_multiply(G, x, w),
    subgroup_multiply(G, subgroup_members(G, S), subgroup_laws(G, S), x, w, sx, sw),
    trans(
      group_hom_multiply(G, H, h, x, w),
      trans(
        cong((fun (v : group_carrier(H)) => group_multiply(H, v, f(w))), fx),
        cong(group_multiply(H, y), fw)
      )
    )
  );
}

theorem subgroup_image_multiply(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), y : group_carrier(H),
  z : group_carrier(H), a : SubgroupImage(G, H, h, S, y), b : SubgroupImage(G, H, h, S, z)
) :
  SubgroupImage(G, H, h, S, group_multiply(H, y, z)) {
  let target = SubgroupImage(G, H, h, S, group_multiply(H, y, z));
  let prop = subgroup_image_prop(G, H, h, S, group_multiply(H, y, z));
  exact mere_eliminate(
    SubgroupImageWitness(G, H, h, S, y), target, prop,
    (
      fun (wa : SubgroupImageWitness(G, H, h, S, y)) => mere_map(
        SubgroupImageWitness(G, H, h, S, z),
        SubgroupImageWitness(G, H, h, S, group_multiply(H, y, z)),
        subgroup_image_product_witness(G, H, h, S, y, z, wa), b
      )
    ), a
  );
}

def subgroup_image_inverse_witness(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), y : group_carrier(H),
  a : SubgroupImageWitness(G, H, h, S, y)
) :
  SubgroupImageWitness(G, H, h, S, group_inverse(H, y)) {
  obtain (x, sx, fx) = a;
  exact (
    group_inverse(G, x),
    subgroup_inverse(
      G, subgroup_members(G, S), subgroup_laws(G, S), x, group_inverse(G, x), sx,
      group_inverse_left(G, x)
    ), trans(group_hom_inverse(G, H, h, x), cong(group_inverse(H), fx))
  );
}

theorem subgroup_image_inverse(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), y : group_carrier(H),
  a : SubgroupImage(G, H, h, S, y)
) :
  SubgroupImage(G, H, h, S, group_inverse(H, y)) {
  exact mere_map(
    SubgroupImageWitness(G, H, h, S, y), SubgroupImageWitness(G, H, h, S, group_inverse(H, y)),
    subgroup_image_inverse_witness(G, H, h, S, y), a
  );
}

theorem subgroup_image_laws(G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G)) :
  SubgroupLaws(H, SubgroupImage(G, H, h, S)) {
  have containsUnit : SubgroupImage(G, H, h, S, group_unit(H)) {
    exact merely(
      SubgroupImageWitness(G, H, h, S, group_unit(H)),
      typed(
        SubgroupImageWitness(G, H, h, S, group_unit(H)),
        (
          group_unit(G), subgroup_unit(G, subgroup_members(G, S), subgroup_laws(G, S)),
          group_hom_unit(G, H, h)
        )
      )
    );
  }
  have inverseClosed :
    forall y : group_carrier(H), forall z : group_carrier(H), SubgroupImage(G, H, h, S, y)
    -> (group_multiply(H, z, y) = group_unit(H)) -> SubgroupImage(G, H, h, S, z) {
    intro y;
    intro z;
    intro member;
    intro leftInverse;
    let same =
      group_inverse_unique(
        group_carrier(H), group_unit(H), group_multiply(H), group_laws(H), y, z,
        group_inverse(H, y), leftInverse, group_inverse_right(H, y)
      );
    exact transport(
      SubgroupImage(G, H, h, S), group_inverse(H, y), z, sym(same),
      subgroup_image_inverse(G, H, h, S, y, member)
    );
  }
  exact (
    subgroup_image_prop(G, H, h, S), containsUnit, subgroup_image_multiply(G, H, h, S),
    inverseClosed
  );
}

def subgroup_image(G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G)) : Subgroup(H) {
  exact (SubgroupImage(G, H, h, S), subgroup_image_laws(G, H, h, S));
}

// Direct image is left adjoint to inverse image in the subobject orders.
// Truncation is eliminated only into the target's propositional membership.
theorem subgroup_image_least(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), T : Subgroup(H),
  lands : SubgroupIncluded(G, S, subgroup_preimage(G, H, h, T))
) :
  SubgroupIncluded(H, subgroup_image(G, H, h, S), T) {
  intro y;
  intro member;
  have descend : SubgroupImageWitness(G, H, h, S, y) -> subgroup_members(H, T, y) {
    intro witness;
    obtain (x, sx, fx) = witness;
    exact transport(subgroup_members(H, T), group_hom_map(G, H, h, x), y, fx, lands(x, sx));
  }
  exact mere_eliminate(
    SubgroupImageWitness(G, H, h, S, y), subgroup_members(H, T, y),
    subgroup_prop(H, subgroup_members(H, T), subgroup_laws(H, T), y), descend, member
  );
}

theorem subgroup_image_preimage_adjunction(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), T : Subgroup(H)
) :
  (
    SubgroupIncluded(H, subgroup_image(G, H, h, S), T)
    -> SubgroupIncluded(G, S, subgroup_preimage(G, H, h, T))
  )
  and (
    SubgroupIncluded(G, S, subgroup_preimage(G, H, h, T))
    -> SubgroupIncluded(H, subgroup_image(G, H, h, S), T)
  ) {
  exact (
    (
      fun (included : SubgroupIncluded(H, subgroup_image(G, H, h, S), T)) => fun (
        x : group_carrier(G)
      ) => fun (member : subgroup_members(G, S, x)) => included(
        group_hom_map(G, H, h, x), subgroup_image_intro(G, H, h, S, x, member)
      )
    ), subgroup_image_least(G, H, h, S, T)
  );
}

theorem subgroup_image_monotone(
  G : Group, H : Group, h : GroupHom(G, H), S : Subgroup(G), T : Subgroup(G),
  included : SubgroupIncluded(G, S, T)
) :
  SubgroupIncluded(H, subgroup_image(G, H, h, S), subgroup_image(G, H, h, T)) {
  exact subgroup_image_least(
    G, H, h, S, subgroup_image(G, H, h, T),
    (
      fun (x : group_carrier(G)) => fun (member : subgroup_members(G, S, x)) => subgroup_image_intro(
        G, H, h, T, x, included(x, member)
      )
    )
  );
}

theorem subgroup_image_identity(G : Group, S : Subgroup(G)) :
  subgroup_image(G, G, group_hom_identity(G), S) = S {
  exact subgroup_inclusion_antisymmetric(
    G, subgroup_image(G, G, group_hom_identity(G), S), S,
    subgroup_image_least(G, G, group_hom_identity(G), S, S, subgroup_inclusion_refl(G, S)),
    subgroup_image_intro(G, G, group_hom_identity(G), S)
  );
}

// Factor a homomorphism as a surjection onto its image followed by inclusion.
def group_image(G : Group, H : Group, h : GroupHom(G, H)) =
  subgroup_image(G, H, h, subgroup_top(G));

def group_image_factor(G : Group, H : Group, h : GroupHom(G, H)) =
  subgroup_factor(
    G, H, h, group_image(G, H, h),
    (fun (x : group_carrier(G)) => subgroup_image_intro(G, H, h, subgroup_top(G), x, tt))
  );

theorem group_image_trivial(G : Group, H : Group) :
  group_image(G, H, group_hom_trivial(G, H)) = subgroup_bottom(H) {
  exact subgroup_inclusion_antisymmetric(
    H, group_image(G, H, group_hom_trivial(G, H)), subgroup_bottom(H),
    subgroup_image_least(
      G, H, group_hom_trivial(G, H), subgroup_top(G), subgroup_bottom(H),
      (fun (x : group_carrier(G)) => fun (member : Unit) => refl(group_unit(H)))
    ), subgroup_bottom_least(H, group_image(G, H, group_hom_trivial(G, H)))
  );
}

theorem group_image_factor_triangle(G : Group, H : Group, h : GroupHom(G, H)) :
  group_hom_compose(
    G, subgroup_as_group(H, group_image(G, H, h)), H, group_image_factor(G, H, h),
    subgroup_inclusion(H, group_image(G, H, h))
  ) = h {
  exact subgroup_factor_triangle(
    G, H, h, group_image(G, H, h),
    (fun (x : group_carrier(G)) => subgroup_image_intro(G, H, h, subgroup_top(G), x, tt))
  );
}

theorem group_image_factor_surjective(
  G : Group, H : Group, h : GroupHom(G, H), y : SubgroupCarrier(H, group_image(G, H, h))
) :
  Mere(
    exists x : group_carrier(G),
    group_hom_map(G, subgroup_as_group(H, group_image(G, H, h)), group_image_factor(G, H, h), x) = y
  ) {
  let image = group_image(G, H, h);
  let value = subgroup_value(H, image, y);
  let f = group_hom_map(G, subgroup_as_group(H, image), group_image_factor(G, H, h));
  have lift :
    SubgroupImageWitness(G, H, h, subgroup_top(G), value) -> (exists x : group_carrier(G), f(x) = y) {
    intro witness;
    obtain (x, member, same) = witness;
    exact (x, subgroup_value_ext(H, image, f(x), y, same));
  }
  exact mere_map(
    SubgroupImageWitness(G, H, h, subgroup_top(G), value), (exists x : group_carrier(G), f(x) = y),
    lift, subgroup_evidence(H, image, y)
  );
}
