import subfield_preimages;

// Embeddings have at most one preimage. Consequently this actual witness type
// is already a proposition; image membership needs no truncation or choice.
def SubfieldImage(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K),
  y : af_carrier(L)
) =
  exists x : af_carrier(K), subfield_members(K, S, x) and (field_embedding_map(K, L, e, x) = y);

theorem subfield_image_prop(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K),
  y : af_carrier(L), p : SubfieldImage(K, L, e, S, y), q : SubfieldImage(K, L, e, S, y)
) : p = q {
  let A = af_carrier(K);
  let P = subfield_members(K, S);
  let f = field_embedding_map(K, L, e);
  let fiber = (fun (x : A) => P(x) and (f(x) = y));
  let a = sigma_first(A, fiber, p);
  let b = sigma_first(A, fiber, q);
  have pa : f(a) = y {
    exact snd(P(a), (f(a) = y), sigma_second(A, fiber, p));
  }
  have qb : f(b) = y {
    exact snd(P(b), (f(b) = y), sigma_second(A, fiber, q));
  }
  exact subtype_ext(
    A, fiber,
    (
      fun (x : A) => product_prop(
        P(x), (f(x) = y), subfield_prop(K, P, subfield_laws(K, S), x), af_set(L, f(x), y)
      )
    ), p, q, field_embedding_injective(K, L, e, a, b, trans(pa, sym(qb)))
  );
}

theorem subfield_image_zero(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K)
) : SubfieldImage(K, L, e, S, af_zero(af_carrier(L), af_operations(L))) {
  obtain (p0, p1, pn, pa, pm) = field_embedding_preserves(K, L, e);
  exact (
    af_zero(af_carrier(K), af_operations(K)),
    subfield_zero(K, subfield_members(K, S), subfield_laws(K, S)), p0
  );
}
theorem subfield_image_one(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K)
) : SubfieldImage(K, L, e, S, af_one(af_carrier(L), af_operations(L))) {
  obtain (p0, p1, pn, pa, pm) = field_embedding_preserves(K, L, e);
  exact (
    af_one(af_carrier(K), af_operations(K)),
    subfield_one(K, subfield_members(K, S), subfield_laws(K, S)), p1
  );
}
theorem subfield_image_neg(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K),
  y : af_carrier(L), member : SubfieldImage(K, L, e, S, y)
) : SubfieldImage(K, L, e, S, af_neg(af_carrier(L), af_operations(L), y)) {
  obtain (x, px, same) = member;
  obtain (p0, p1, pn, pa, pm) = field_embedding_preserves(K, L, e);
  exact (
    af_neg(af_carrier(K), af_operations(K), x),
    subfield_neg(K, subfield_members(K, S), subfield_laws(K, S), x, px),
    trans(pn(x), cong(af_neg(af_carrier(L), af_operations(L)), same))
  );
}

theorem subfield_image_add(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K),
  x : af_carrier(L), y : af_carrier(L), px : SubfieldImage(K, L, e, S, x),
  py : SubfieldImage(K, L, e, S, y)
) : SubfieldImage(K, L, e, S, af_add(af_carrier(L), af_operations(L), x, y)) {
  let A = af_carrier(K);
  let B = af_carrier(L);
  let f = field_embedding_map(K, L, e);
  let operation = af_add(B, af_operations(L));
  obtain (a, memberA, imageA) = px;
  obtain (b, memberB, imageB) = py;
  obtain (p0, p1, pn, pa, pm) = field_embedding_preserves(K, L, e);
  exact (
    af_add(A, af_operations(K), a, b),
    subfield_add(K, subfield_members(K, S), subfield_laws(K, S), a, b, memberA, memberB),
    trans(
      pa(a, b), trans(cong((fun (v : B) => operation(v, f(b))), imageA), cong(operation(x), imageB))
    )
  );
}

theorem subfield_image_mul(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K),
  x : af_carrier(L), y : af_carrier(L), px : SubfieldImage(K, L, e, S, x),
  py : SubfieldImage(K, L, e, S, y)
) : SubfieldImage(K, L, e, S, af_mul(af_carrier(L), af_operations(L), x, y)) {
  let A = af_carrier(K);
  let B = af_carrier(L);
  let f = field_embedding_map(K, L, e);
  let operation = af_mul(B, af_operations(L));
  obtain (a, memberA, imageA) = px;
  obtain (b, memberB, imageB) = py;
  obtain (p0, p1, pn, pa, pm) = field_embedding_preserves(K, L, e);
  exact (
    af_mul(A, af_operations(K), a, b),
    subfield_mul(K, subfield_members(K, S), subfield_laws(K, S), a, b, memberA, memberB),
    trans(
      pm(a, b), trans(cong((fun (v : B) => operation(v, f(b))), imageA), cong(operation(x), imageB))
    )
  );
}

// An ambient inverse of an image element is the image of its unique source
// inverse. The inverse witness forces nonzeroness; no zero decision is used.
theorem subfield_image_inverse(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K),
  x : af_carrier(L), y : af_carrier(L), px : SubfieldImage(K, L, e, S, x),
  inverseLaw : af_mul(af_carrier(L), af_operations(L), x, y) = af_one(
    af_carrier(L), af_operations(L)
  )
) : SubfieldImage(K, L, e, S, y) {
  let A = af_carrier(K);
  let B = af_carrier(L);
  let opsA = af_operations(K);
  let opsB = af_operations(L);
  let f = field_embedding_map(K, L, e);
  let multiplyL = af_mul(B, opsB);
  obtain (a, memberA, imageA) = px;
  obtain (p0, p1, pn, pa, pm) = field_embedding_preserves(K, L, e);
  obtain (ringLaws, nontrivial, inverses) = typed(AlgebraicFieldLaws(A, opsA), af_laws(K));
  have nonzeroImage : FieldNonzero(B, opsB, f(a)) {
    intro equalZero;
    exact field_nonzero_of_inverse(L, x, y, inverseLaw, trans(sym(imageA), equalZero));
  }
  obtain (b, inverseA) = inverses(a, field_embedding_reflects_nonzero(K, L, e, a, nonzeroImage));
  have inverseImage : multiplyL(x, f(b)) = af_one(B, opsB) {
    exact trans(
      cong((fun (v : B) => multiplyL(v, f(b))), sym(imageA)),
      trans(sym(pm(a, b)), trans(cong(f, inverseA), p1))
    );
  }
  exact (
    b, subfield_inverse(K, subfield_members(K, S), subfield_laws(K, S), a, b, memberA, inverseA),
    algebraic_inverse_unique(
      B, opsB, af_set(L), field_ring_data(B, opsB, af_laws(L)), x, f(b), y, inverseImage, inverseLaw
    )
  );
}

theorem subfield_image_laws(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K)
) : SubfieldLaws(L, SubfieldImage(K, L, e, S)) {
  exact (
    subfield_image_prop(K, L, e, S), subfield_image_zero(K, L, e, S),
    subfield_image_one(K, L, e, S), subfield_image_neg(K, L, e, S), subfield_image_add(K, L, e, S),
    subfield_image_mul(K, L, e, S), subfield_image_inverse(K, L, e, S)
  );
}
def subfield_image(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(K)
) : Subfield(L) {
  exact (SubfieldImage(K, L, e, S), subfield_image_laws(K, L, e, S));
}
