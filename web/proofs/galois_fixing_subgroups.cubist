import galois_fixed_fields;

import subgroups;

// The Galois case uses the same subgroup type as every other bundled group.
def GaloisSubgroupLaws(K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0) =
  SubgroupLaws(GaloisGroup(K, E), H);

def GaloisSubgroup(K : AlgebraicField, E : FieldExt(K)) = Subgroup(GaloisGroup(K, E));

def galois_fixing_prop(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0, e : Galois(K, E)
) :
  Proposition(GaloisFixing(K, E, P, e)) {
  exact forall_prop(
    extension_carrier(K, E),
    (fun (x : extension_carrier(K, E)) => P(x) -> (extension_iso_forward(K, E, E, e, x) = x)),
    (
      fun (x : extension_carrier(K, E)) => forall_prop(
        P(x), (fun (member : P(x)) => extension_iso_forward(K, E, E, e, x) = x),
        (
          fun (member : P(x)) => structure_set(
            ExtensionData(K), E, extension_iso_forward(K, E, E, e, x), x
          )
        )
      )
    )
  );
}

def galois_fixing_identity(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0
) :
  GaloisFixing(K, E, P, extension_identity_iso(K, E)) {
  intro x;
  intro member;
  exact refl(x);
}

def galois_fixing_compose(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0, e : Galois(K, E),
  d : Galois(K, E), fixesE : GaloisFixing(K, E, P, e), fixesD : GaloisFixing(K, E, P, d)
) :
  GaloisFixing(K, E, P, galois_compose(K, E, e, d)) {
  intro x;
  intro member;
  exact trans(cong(extension_iso_forward(K, E, E, d), fixesE(x, member)), fixesD(x, member));
}

// A loop and its reverse have inverse actions on the carrier. If the loop
// fixes x, this equation forces its reverse to fix x as well.
def galois_fixing_inverse(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0, e : Galois(K, E),
  fixes : GaloisFixing(K, E, P, e)
) :
  GaloisFixing(K, E, P, galois_inverse(K, E, e)) {
  intro x;
  intro member;
  let inverseMap = extension_iso_forward(K, E, E, galois_inverse(K, E, e));
  have inverseLaw : inverseMap(extension_iso_forward(K, E, E, e, x)) = x {
    exact cong(
      (fun (d : Galois(K, E)) => extension_iso_forward(K, E, E, d, x)),
      galois_right_inverse(K, E, e)
    );
  }
  exact trans(sym(cong(inverseMap, fixes(x, member))), inverseLaw);
}

// Any witnessed left inverse agrees with the inverse supplied by path reversal.
def galois_fixing_witnessed_inverse(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0, e : Galois(K, E),
  d : Galois(K, E), fixes : GaloisFixing(K, E, P, e),
  inverseLaw : galois_compose(K, E, d, e) = extension_identity_iso(K, E)
) :
  GaloisFixing(K, E, P, d) {
  have same : d = galois_inverse(K, E, e) {
    exact group_inverse_unique(
      Galois(K, E), extension_identity_iso(K, E), galois_compose(K, E), galois_group_laws(K, E), e,
      d, galois_inverse(K, E, e), inverseLaw, galois_right_inverse(K, E, e)
    );
  }
  exact transport(
    GaloisFixing(K, E, P), galois_inverse(K, E, e), d, sym(same),
    galois_fixing_inverse(K, E, P, e, fixes)
  );
}

// No closure property of P is required to obtain a subgroup of symmetries.
def galois_fixing_subgroup_laws(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0
) :
  GaloisSubgroupLaws(K, E, GaloisFixing(K, E, P)) {
  exact (
    galois_fixing_prop(K, E, P), galois_fixing_identity(K, E, P), galois_fixing_compose(K, E, P),
    galois_fixing_witnessed_inverse(K, E, P)
  );
}

def galois_fixing_subgroup(K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0) :
  GaloisSubgroup(K, E) {
  exact (GaloisFixing(K, E, P), galois_fixing_subgroup_laws(K, E, P));
}

def galois_subgroup_members(K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E)) =
  unpack H as (P, laws) return (Galois(K, E) -> U0) {
    P;
  };

def fixed_intermediate_field(K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E)) =
  galois_fixed_field(K, E, galois_subgroup_members(K, E, H));

def fixing_galois_subgroup(K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E)) =
  galois_fixing_subgroup(K, E, intermediate_members(K, E, M));

// The two assignments are an order-reversing connection between genuine
// subgroup and intermediate-field records. They are not yet a correspondence:
// inverse equalities require the finite normal separable hypotheses and proofs.
def intermediate_galois_connection(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), M : IntermediateField(K, E)
) :
  GaloisConnection(K, E, galois_subgroup_members(K, E, H), intermediate_members(K, E, M)) {
  exact galois_connection(K, E, galois_subgroup_members(K, E, H), intermediate_members(K, E, M));
}
