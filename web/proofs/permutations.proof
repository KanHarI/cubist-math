import finite_cancellation;
import bijection_equality;
import function_counting;

// Bijection records on sets have unique inverse data, so this counts
// permutations themselves, without extra multiplicity from proof witnesses.
opaque def Permutations(n : Nat) = Bijection(Fin(n), Fin(n));
def permutation_image(n : Nat, e : Permutations(succ(n))) =
  forward(Fin(succ(n)), Fin(succ(n)), e, head(Fin(n)));
def adjust_permutation(n : Nat, c : Fin(succ(n)), e : Permutations(succ(n))) =
  compose_bijection(Fin(succ(n)), Fin(succ(n)), Fin(succ(n)), e, swap_bijection(Fin(n), fin_decidable(n), c));
def permutation_tail(n : Nat, e : Permutations(succ(n))) =
  restrict_bijection(Fin(n), Fin(n), adjust_permutation(n, permutation_image(n, e), e),
    swap_chosen(Fin(n), fin_decidable(n), permutation_image(n, e)));
def permutation_extend(n : Nat, d : Permutations(n)) =
  sum_bijection(Unit, Fin(n), Unit, Fin(n), identity_bijection(Unit), d);
def permutation_join_at(n : Nat, y : Fin(succ(n)), d : Permutations(n)) =
  adjust_permutation(n, y, permutation_extend(n, d));
def permutation_split(n : Nat, e : Permutations(succ(n))) =
  typed(Fin(succ(n)) and Permutations(n), (permutation_image(n, e), permutation_tail(n, e)));
def permutation_join(n : Nat, p : Fin(succ(n)) and Permutations(n)) =
  permutation_join_at(n, fst(Fin(succ(n)), Permutations(n), p), snd(Fin(succ(n)), Permutations(n), p));

theorem extension_restriction_point(A : U0, B : U0, e : Bijection(Unit or A, Unit or B),
  fixed : forward(Unit or A, Unit or B, e, head(A)) = head(B), x : Unit or A) =
  match x as z return
    (sum_map(Unit, A, Unit, B, (fun (u : Unit) => u), forward(A, B, restrict_bijection(A, B, e, fixed)), z) = forward(Unit or A, Unit or B, e, z)) {
    left u => trans(cong((fun (v : Unit) => typed(Unit or B, left(v))), sym(unit_equal(u))),
      trans(sym(fixed), cong((fun (v : Unit) => forward(Unit or A, Unit or B, e, typed(Unit or A, left(v)))), unit_equal(u))));
    right a => restrict_tail_path(A, B, forward(Unit or A, Unit or B, e), backward(Unit or A, Unit or B, e), left_inverse(Unit or A, Unit or B, e), fixed, a);
  };

theorem permutation_rebuild(n : Nat, e : Permutations(succ(n))) : permutation_join(n, permutation_split(n, e)) = e {
  let S = Fin(succ(n));
  let image = permutation_image(n, e);
  let adjusted = adjust_permutation(n, image, e);
  exact bijection_ext(S, S, fin_is_set(succ(n)), fin_is_set(succ(n)), permutation_join(n, permutation_split(n, e)), e,
    FunExt(U0, S, (fun (x : S) => S), forward(S, S, permutation_join(n, permutation_split(n, e))), forward(S, S, e),
      (fun (x : S) => trans(cong(swap(Fin(n), fin_decidable(n), image),
        extension_restriction_point(Fin(n), Fin(n), adjusted, swap_chosen(Fin(n), fin_decidable(n), image), x)),
        swap_twice(Fin(n), fin_decidable(n), image, forward(S, S, e, x))))));
}

theorem permutation_join_image(n : Nat, y : Fin(succ(n)), d : Permutations(n)) : permutation_image(n, permutation_join_at(n, y, d)) = y {
  exact swap_head(Fin(n), fin_decidable(n), y);
}

theorem permutation_join_tail_point(n : Nat, y : Fin(succ(n)), d : Permutations(n), a : Fin(n)) :
  forward(Fin(n), Fin(n), permutation_tail(n, permutation_join_at(n, y, d)), a) = forward(Fin(n), Fin(n), d, a)
{
  let joined = permutation_join_at(n, y, d);
  let image = permutation_image(n, joined);
  let adjusted = adjust_permutation(n, image, joined);
  let fixed = swap_chosen(Fin(n), fin_decidable(n), image);
  let f = forward(Fin(succ(n)), Fin(succ(n)), adjusted);
  let g = backward(Fin(succ(n)), Fin(succ(n)), adjusted);
  let eta = left_inverse(Fin(succ(n)), Fin(succ(n)), adjusted);
  let b = forward(Fin(n), Fin(n), d, a);
  exact tail_injective(Fin(n), restrict_tail(Fin(n), Fin(n), f, g, eta, fixed, a), b,
    trans(restrict_tail_path(Fin(n), Fin(n), f, g, eta, fixed, a),
      trans(cong((fun (c : Fin(succ(n))) => swap(Fin(n), fin_decidable(n), c, swap(Fin(n), fin_decidable(n), y, tail(Fin(n), b)))), permutation_join_image(n, y, d)),
        swap_twice(Fin(n), fin_decidable(n), y, tail(Fin(n), b)))));
}

theorem permutation_join_tail(n : Nat, y : Fin(succ(n)), d : Permutations(n)) : permutation_tail(n, permutation_join_at(n, y, d)) = d {
  exact bijection_ext(Fin(n), Fin(n), fin_is_set(n), fin_is_set(n), permutation_tail(n, permutation_join_at(n, y, d)), d,
    FunExt(U0, Fin(n), (fun (a : Fin(n)) => Fin(n)), forward(Fin(n), Fin(n), permutation_tail(n, permutation_join_at(n, y, d))), forward(Fin(n), Fin(n), d), permutation_join_tail_point(n, y, d)));
}

theorem permutation_split_join(n : Nat, p : Fin(succ(n)) and Permutations(n)) : permutation_split(n, permutation_join(n, p)) = p {
  exact pair_induction((fun (q : Fin(succ(n)) and Permutations(n)) => permutation_split(n, permutation_join(n, q)) = q),
    (fun (y : Fin(succ(n))) => fun (d : Permutations(n)) =>
      product_path(Fin(succ(n)), Permutations(n), permutation_image(n, permutation_join_at(n, y, d)), y, permutation_join_image(n, y, d),
        permutation_tail(n, permutation_join_at(n, y, d)), d, permutation_join_tail(n, y, d))), p);
}

theorem permutation_successor(n : Nat) : Bijection(Permutations(succ(n)), Fin(succ(n)) and Permutations(n)) {
  exact (permutation_split(n), (permutation_join(n), (permutation_rebuild(n), permutation_split_join(n))));
}

theorem empty_permutation_unique(e : Permutations(0)) : identity_bijection(Fin(0)) = e {
  exact bijection_ext(Fin(0), Fin(0), fin_is_set(0), fin_is_set(0), identity_bijection(Fin(0)), e,
    FunExt(U0, Fin(0), (fun (x : Fin(0)) => Fin(0)), forward(Fin(0), Fin(0), identity_bijection(Fin(0))), forward(Fin(0), Fin(0), e),
      (fun (x : Fin(0)) => typed((x = forward(Fin(0), Fin(0), e, x)), absurd(x)))));
}
def empty_permutation_bijection = typed(Bijection(Permutations(0), Unit),
  ((fun (e : Permutations(0)) => tt), ((fun (u : Unit) => identity_bijection(Fin(0))), (empty_permutation_unique, unit_equal))));

def factorial_count(n : Nat) = induction n as k return Nat {
  zero => 1;
  succ previous => multiply_count(succ(k), previous);
};

theorem finite_permutation_count(n : Nat) = induction n as k return Bijection(Permutations(k), Fin(factorial_count(k))) {
  zero => compose_bijection(Permutations(0), Unit, Fin(1), empty_permutation_bijection, unit_to_fin_one);
  succ previous => compose_bijection(Permutations(succ(k)), Fin(succ(k)) and Permutations(k), Fin(factorial_count(succ(k))),
    permutation_successor(k),
    compose_bijection(Fin(succ(k)) and Permutations(k), Fin(succ(k)) and Fin(factorial_count(k)), Fin(factorial_count(succ(k))),
      product_bijection(Fin(succ(k)), Permutations(k), Fin(succ(k)), Fin(factorial_count(k)), identity_bijection(Fin(succ(k))), previous),
      fin_product(succ(k), factorial_count(k))));
};

theorem three_permutations : Bijection(Permutations(3), Fin(6)) { exact finite_permutation_count(3); }

// Count the library's full equivalence type, including its coherence field.
theorem finite_equivalence_count(k : Nat) : Bijection(Equiv(U0, Fin(k), Fin(k)), Fin(factorial_count(k))) {
  exact compose_bijection(Equiv(U0, Fin(k), Fin(k)), Permutations(k), Fin(factorial_count(k)),
    equivalences_are_bijections(Fin(k), Fin(k), fin_is_set(k), fin_is_set(k)), finite_permutation_count(k));
}

theorem finite_permutation_equivalence(k : Nat) : Equiv(U0, Equiv(U0, Fin(k), Fin(k)), Fin(factorial_count(k))) {
  exact bijection_equiv(Equiv(U0, Fin(k), Fin(k)), Fin(factorial_count(k)), fin_is_set(factorial_count(k)), finite_equivalence_count(k));
}
