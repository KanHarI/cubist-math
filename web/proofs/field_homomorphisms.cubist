import field_arithmetic;
import classical;

// A unital field homomorphism is automatically injective. This lets universal
// constructions prove preservation first, without adding injectivity data by hand.
theorem field_hom_kernel_zero(
  K : AlgebraicField, L : AlgebraicField, f : af_carrier(K) -> af_carrier(L),
  preserves : FieldOpsPreserved(af_carrier(K), af_carrier(L), f, af_operations(K), af_operations(L)),
  a : af_carrier(K), zero : f(a) = field_zero(L)
) :
  a = field_zero(K) {
  obtain (f0, f1, fn, fa, fm) = preserves;
  have impossible : FieldNonzero(af_carrier(K), af_operations(K), a) -> Void {
    intro nonzero;
    obtain (ring, nontrivial, inverses) = af_laws(K);
    obtain (b, inverse) = inverses(a, nonzero);
    obtain (ringL, nontrivialL, inversesL) = af_laws(L);
    exact nontrivialL(
      trans(
        sym(f1),
        trans(
          cong(f, sym(inverse)),
          trans(
            fm(a, b),
            trans(
              cong((fun (x : af_carrier(L)) => field_mul(L, x, f(b))), zero),
              scalar_zero_mul(L, f(b))
            )
          )
        )
      )
    );
  }
  exact double_negation(a = field_zero(K), af_set(K, a, field_zero(K)), impossible);
}

theorem field_hom_injective(
  K : AlgebraicField, L : AlgebraicField, f : af_carrier(K) -> af_carrier(L),
  preserves : FieldOpsPreserved(af_carrier(K), af_carrier(L), f, af_operations(K), af_operations(L)),
  x : af_carrier(K), y : af_carrier(K), same : f(x) = f(y)
) :
  x = y {
  obtain (f0, f1, fn, fa, fm) = preserves;
  let difference = field_add(K, x, field_neg(K, y));
  have vanishes : f(difference) = field_zero(L) {
    exact trans(
      fa(x, field_neg(K, y)),
      trans(
        cong(field_add(L, f(x)), fn(y)),
        trans(
          cong((fun (a : af_carrier(L)) => field_add(L, a, field_neg(L, f(y)))), same),
          scalar_add_inverse_right(L, f(y))
        )
      )
    );
  }
  exact group_cancel_right(
    vector_group(K, ScalarSpace(K)), x, y, field_neg(K, y),
    trans(
      field_hom_kernel_zero(K, L, f, preserves, difference, vanishes),
      sym(scalar_add_inverse_right(K, y))
    )
  );
}

def field_embedding_from_hom(
  K : AlgebraicField, L : AlgebraicField, f : af_carrier(K) -> af_carrier(L),
  preserves : FieldOpsPreserved(af_carrier(K), af_carrier(L), f, af_operations(K), af_operations(L))
) :
  FieldEmbedding(K, L) {
  exact (f, preserves, field_hom_injective(K, L, f, preserves));
}

// Assemble preservation laws before specializing a constructed field's operations.
def field_ops_preserved_from_laws(
  A : U0, B : U0, ops : FieldOps(A), zero : B, one : B, neg : B -> B, add : B -> B -> B, mul : B
  -> B -> B, f : A -> B, f0 : f(af_zero(A, ops)) = zero, f1 : f(af_one(A, ops)) = one,
  fn : (forall x : A, f(af_neg(A, ops, x)) = neg(f(x))),
  fa : (forall x : A, forall y : A, f(af_add(A, ops, x, y)) = add(f(x), f(y))),
  fm : (forall x : A, forall y : A, f(af_mul(A, ops, x, y)) = mul(f(x), f(y)))
) :
  FieldOpsPreserved(A, B, f, ops, field_ops(B, zero, one, neg, add, mul)) {
  exact (f0, f1, fn, fa, fm);
}

// The dual constructor is useful when the source field has just been built.
def field_ops_map_from_laws(
  A : U0, zero : A, one : A, neg : A -> A, add : A -> A -> A, mul : A -> A -> A, B : U0,
  ops : FieldOps(B), f : A -> B, f0 : f(zero) = af_zero(B, ops), f1 : f(one) = af_one(B, ops),
  fn : (forall x : A, f(neg(x)) = af_neg(B, ops, f(x))),
  fa : (forall x : A, forall y : A, f(add(x, y)) = af_add(B, ops, f(x), f(y))),
  fm : (forall x : A, forall y : A, f(mul(x, y)) = af_mul(B, ops, f(x), f(y)))
) :
  FieldOpsPreserved(A, B, f, field_ops(A, zero, one, neg, add, mul), ops) {
  exact (f0, f1, fn, fa, fm);
}
