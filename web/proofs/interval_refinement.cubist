import uniform_curve_tags;
import sample_refinement_tags;

// Tags admissible for a refinement all lie within its outer endpoints.
theorem interval_refinement_tags_global(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, lt : F -> F -> U0,
  order : StrictOrder(F, lt), arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), n : Nat,
  vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n),
  tags : SampleTags(FieldUnitInterval(F, zero, one, lt), n),
  valid : IntervalAdmissibleTags(F, zero, one, lt, n, vertices, tags)
) :
  SampleTagged(
    FieldUnitInterval(F, zero, one, lt),
    (
      fun (x : FieldUnitInterval(F, zero, one, lt)) => fun (y : FieldUnitInterval(F, zero, one, lt)) => IntervalTagWithin(
        F, zero, one, lt, sample_first(FieldUnitInterval(F, zero, one, lt), n, vertices),
        sample_last(FieldUnitInterval(F, zero, one, lt), n, vertices)
      )
    ), n, vertices, tags
  ) {
  let I = FieldUnitInterval(F, zero, one, lt);
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  let related = (fun (a : I) => fun (b : I) => FieldLe(F, lt, coordinate(a), coordinate(b)));
  exact sample_between_global(
    I, related, (fun (x : I) => order_le_refl(F, lt, order, coordinate(x))),
    (
      fun (x : I) => fun (y : I) => fun (z : I) => order_le_trans(
        F, zero, one, addF, mulF, lt, arithmetic, coordinate(x), coordinate(y), coordinate(z)
      )
    ), n, sample_first(I, n, vertices), sample_last(I, n, vertices), vertices, tags,
    order_le_refl(F, lt, order, coordinate(sample_first(I, n, vertices))),
    order_le_refl(F, lt, order, coordinate(sample_last(I, n, vertices))), valid
  );
}

// A coarse tag need not be admissible for each refined edge. The common
// containing interval, rather than the refined edge, controls its distance.
theorem uniform_refinement_tag_bounds(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F, lt : F -> F
  -> U0, ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  values : FieldUnitInterval(F, zero, one, lt) -> Complex(F),
  uniform : ComplexUniformCurve(F, zero, one, addF, lt, values), epsilon : F,
  positive : lt(zero, epsilon)
) :
  exists mesh : F, lt(zero, mesh)
  and (
    forall n : Nat, forall vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n),
    forall coarseTag : FieldUnitInterval(F, zero, one, lt),
    forall tags : SampleTags(FieldUnitInterval(F, zero, one, lt), n),
    IntervalAdmissibleTags(F, zero, one, lt, n, vertices, tags)
    -> IntervalTagWithin(
      F, zero, one, lt, sample_first(FieldUnitInterval(F, zero, one, lt), n, vertices),
      sample_last(FieldUnitInterval(F, zero, one, lt), n, vertices), coarseTag
    )
    -> lt(
      interval_difference(
        F, zero, one, addF, negF, lt,
        sample_first(FieldUnitInterval(F, zero, one, lt), n, vertices),
        sample_last(FieldUnitInterval(F, zero, one, lt), n, vertices)
      ), mesh
    )
    -> ComplexParameterTagBounds(
      FieldUnitInterval(F, zero, one, lt), F, addF, negF, lt, values, epsilon, n, vertices,
      sample_repeat_tags(FieldUnitInterval(F, zero, one, lt), n, coarseTag), tags
    )
  ) {
  let I = FieldUnitInterval(F, zero, one, lt);
  obtain (mesh, positiveMesh, closeValues) = uniform(epsilon, positive);
  have estimates :
    forall n : Nat, forall vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n),
    forall coarseTag : FieldUnitInterval(F, zero, one, lt),
    forall tags : SampleTags(FieldUnitInterval(F, zero, one, lt), n),
    IntervalAdmissibleTags(F, zero, one, lt, n, vertices, tags)
    -> IntervalTagWithin(
      F, zero, one, lt, sample_first(FieldUnitInterval(F, zero, one, lt), n, vertices),
      sample_last(FieldUnitInterval(F, zero, one, lt), n, vertices), coarseTag
    )
    -> lt(
      interval_difference(
        F, zero, one, addF, negF, lt,
        sample_first(FieldUnitInterval(F, zero, one, lt), n, vertices),
        sample_last(FieldUnitInterval(F, zero, one, lt), n, vertices)
      ), mesh
    )
    -> ComplexParameterTagBounds(
      FieldUnitInterval(F, zero, one, lt), F, addF, negF, lt, values, epsilon, n, vertices,
      sample_repeat_tags(FieldUnitInterval(F, zero, one, lt), n, coarseTag), tags
    ) {
    intro n;
    intro vertices;
    intro coarseTag;
    intro tags;
    intro valid;
    intro coarseWithin;
    intro small;
    let a = sample_first(I, n, vertices);
    let b = sample_last(I, n, vertices);
    let within = IntervalTagWithin(F, zero, one, lt, a, b);
    let constantCondition = (fun (x : I) => fun (y : I) => within);
    have localBound :
      forall x : I, forall y : I, forall oldTag : I, forall newTag : I, Unit -> within(oldTag)
      -> within(newTag)
      -> ComplexBoxBound(
        F, negF, lt,
        coordinate_difference(
          Complex(F), complex_add(F, addF), complex_neg(F, negF), values(oldTag), values(newTag)
        ), epsilon
      ) {
      intro x;
      intro y;
      intro oldTag;
      intro newTag;
      intro unitWitness;
      intro oldWithin;
      intro newWithin;
      let closeParameters =
        interval_tags_close(
          F, zero, one, addF, mulF, negF, lt, ring, arithmetic, a, b, newTag, oldTag, newWithin,
          oldWithin, mesh, small
        );
      exact complex_close_difference_bound(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, values(oldTag), values(newTag),
        epsilon, closeValues(newTag, oldTag, closeParameters)
      );
    }
    let oldValid = sample_repeat_tags_valid(I, within, coarseTag, coarseWithin, n, vertices);
    let newValid =
      interval_refinement_tags_global(
        F, zero, one, addF, mulF, lt, order, arithmetic, n, vertices, tags, valid
      );
    exact parameter_tag_bounds_from_samples(
      I, F, addF, negF, lt, values, epsilon, (fun (x : I) => fun (y : I) => Unit),
      constantCondition, localBound, n, vertices, sample_repeat_tags(I, n, coarseTag), tags,
      sample_adjacent_constant(I, Unit, tt, n, vertices), oldValid, newValid
    );
  }
  exact (mesh, positiveMesh, estimates);
}
