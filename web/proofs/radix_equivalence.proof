import radix_uniqueness;
import equivalence_from_inverse;

// Every positive digit tree evaluates to a positive natural number.
theorem radix_decode_positive(extra : Nat, p : RadixPositive(extra)) : 1 <= radix_positive_to_nat(
  extra, p
) {
  exact radix_positive_induction(
    extra, (fun (q : RadixPositive(extra)) => 1 <= radix_positive_to_nat(extra, q)),
    (
      fun (d : RadixDigit(succ(extra))) => typed(
        (1 <= radix_positive_to_nat(extra, radix_leading(extra, d))), tt
      )
    ),
    (
      fun (d : RadixDigit(succ(succ(extra)))) => fun (q : RadixPositive(extra)) => fun (
        ih : 1 <= radix_positive_to_nat(extra, q)
      ) => nat_add_positive(
        succ(succ(extra)) * radix_positive_to_nat(extra, q),
        radix_digit_value(succ(succ(extra)), d),
        nat_add_positive(
          radix_positive_to_nat(extra, q),
          radix_positive_to_nat(extra, q) + extra * radix_positive_to_nat(extra, q), ih
        )
      )
    ), p
  );
}
theorem radix_nat_positive_decompose(n : Nat) : (1 <= n) -> (exists k : Nat, n = succ(k)) {
  exact induction n as k return ((1 <= k) -> (exists predecessor : Nat, k = succ(predecessor))) {
    zero => fun (impossible : Void) => typed(
      (exists predecessor : Nat, 0 = succ(predecessor)), absurd(impossible)
    );
    succ previous => fun (positive : 1 <= succ(k)) => typed(
      (exists predecessor : Nat, succ(k) = succ(predecessor)), (k, refl(succ(k)))
    );
  };
}
theorem radix_leading_not_append(
  extra : Nat, d : RadixDigit(succ(extra)), e : RadixDigit(succ(succ(extra))),
  q : RadixPositive(extra),
  same : radix_positive_to_nat(extra, radix_leading(extra, d)) = radix_positive_to_nat(
    extra, radix_append(extra, e, q)
  )
) : Void {
  obtain (predecessor, next) = radix_nat_positive_decompose(
    radix_positive_to_nat(extra, q), radix_decode_positive(extra, q)
  );
  let base = succ(succ(extra));
  let ev = radix_digit_value(base, e);
  exact radix_nat_small_not_large(
    base, succ(radix_digit_value(succ(extra), d)), base * predecessor + ev,
    radix_digit_bound(succ(extra), d),
    trans(
      same,
      trans(cong((fun (v : Nat) => base * v + ev), next), radix_eval_succ(base, predecessor, ev))
    )
  );
}
def RadixPositiveInjectiveAt(extra : Nat, p : RadixPositive(extra)) =
  forall q : RadixPositive(extra),
  (radix_positive_to_nat(extra, p) = radix_positive_to_nat(extra, q)) -> (p = q);
theorem radix_leading_injective(extra : Nat, d : RadixDigit(succ(extra)), q : RadixPositive(extra)) : (
  radix_positive_to_nat(extra, radix_leading(extra, d)) = radix_positive_to_nat(extra, q)
) -> (radix_leading(extra, d) = q) {
  exact radix_positive_induction(
    extra,
    (
      fun (r : RadixPositive(extra)) => (
        radix_positive_to_nat(extra, radix_leading(extra, d)) = radix_positive_to_nat(extra, r)
      ) -> (radix_leading(extra, d) = r)
    ),
    (
      fun (e : RadixDigit(succ(extra))) => fun (
        same : radix_positive_to_nat(extra, radix_leading(extra, d)) = radix_positive_to_nat(
          extra, radix_leading(extra, e)
        )
      ) => cong(
        radix_leading(extra),
        radix_digit_injective(
          succ(extra), d, e,
          nat_succ_injective(
            radix_digit_value(succ(extra), d), radix_digit_value(succ(extra), e), same
          )
        )
      )
    ),
    (
      fun (e : RadixDigit(succ(succ(extra)))) => fun (r : RadixPositive(extra)) => fun (
        ignored : (
          radix_positive_to_nat(extra, radix_leading(extra, d)) = radix_positive_to_nat(extra, r)
        ) -> (radix_leading(extra, d) = r)
      ) => fun (
        same : radix_positive_to_nat(extra, radix_leading(extra, d)) = radix_positive_to_nat(
          extra, radix_append(extra, e, r)
        )
      ) => typed(
        (radix_leading(extra, d) = radix_append(extra, e, r)),
        absurd(radix_leading_not_append(extra, d, e, r, same))
      )
    ), q
  );
}
theorem radix_append_append_injective(
  extra : Nat, d : RadixDigit(succ(succ(extra))), p : RadixPositive(extra),
  ih : RadixPositiveInjectiveAt(extra, p), e : RadixDigit(succ(succ(extra))),
  q : RadixPositive(extra),
  same : radix_positive_to_nat(extra, radix_append(extra, d, p)) = radix_positive_to_nat(
    extra, radix_append(extra, e, q)
  )
) : radix_append(extra, d, p) = radix_append(extra, e, q) {
  let base = succ(succ(extra));
  obtain (quotient, remainder) = radix_division_unique(
    base, radix_digit_value(base, d), radix_digit_value(base, e), radix_digit_bound(base, d),
    radix_digit_bound(base, e), radix_positive_to_nat(extra, p), radix_positive_to_nat(extra, q),
    same
  );
  exact trans(
    cong(
      (fun (digit : RadixDigit(base)) => radix_append(extra, digit, p)),
      radix_digit_injective(base, d, e, remainder)
    ), cong(radix_append(extra, e), ih(q, quotient))
  );
}
theorem radix_append_injective(
  extra : Nat, d : RadixDigit(succ(succ(extra))), p : RadixPositive(extra),
  ih : RadixPositiveInjectiveAt(extra, p), q : RadixPositive(extra)
) : (radix_positive_to_nat(extra, radix_append(extra, d, p)) = radix_positive_to_nat(extra, q))
-> (radix_append(extra, d, p) = q) {
  exact radix_positive_induction(
    extra,
    (
      fun (r : RadixPositive(extra)) => (
        radix_positive_to_nat(extra, radix_append(extra, d, p)) = radix_positive_to_nat(extra, r)
      ) -> (radix_append(extra, d, p) = r)
    ),
    (
      fun (e : RadixDigit(succ(extra))) => fun (
        same : radix_positive_to_nat(extra, radix_append(extra, d, p)) = radix_positive_to_nat(
          extra, radix_leading(extra, e)
        )
      ) => typed(
        (radix_append(extra, d, p) = radix_leading(extra, e)),
        absurd(radix_leading_not_append(extra, e, d, p, sym(same)))
      )
    ),
    (
      fun (e : RadixDigit(succ(succ(extra)))) => fun (r : RadixPositive(extra)) => fun (
        ignored : (
          radix_positive_to_nat(extra, radix_append(extra, d, p)) = radix_positive_to_nat(extra, r)
        ) -> (radix_append(extra, d, p) = r)
      ) => radix_append_append_injective(extra, d, p, ih, e, r)
    ), q
  );
}
theorem radix_positive_injective(extra : Nat, p : RadixPositive(extra)) : RadixPositiveInjectiveAt(
  extra, p
) {
  exact radix_positive_induction(
    extra, RadixPositiveInjectiveAt(extra), radix_leading_injective(extra),
    radix_append_injective(extra), p
  );
}

theorem radix_decode_nonzero(
  extra : Nat, p : RadixPositive(extra), same : radix_positive_to_nat(extra, p) = 0
) : Void {
  exact transport(
    (fun (n : Nat) => 1 <= n), radix_positive_to_nat(extra, p), 0, same,
    radix_decode_positive(extra, p)
  );
}
theorem radix_zero_injective(extra : Nat, u : Unit, b : RadixNat(extra)) : (
  0 = radix_to_nat(extra, b)
) -> (typed(RadixNat(extra), left(u)) = b) {
  exact match b as y return ((0 = radix_to_nat(extra, y)) -> (typed(RadixNat(extra), left(u)) = y)) {
    left v => fun (same : 0 = 0) => cong(
      (fun (point : Unit) => typed(RadixNat(extra), left(point))),
      trans(sym(unit_equal(u)), unit_equal(v))
    );
    right q => fun (same : 0 = radix_positive_to_nat(extra, q)) => typed(
      (typed(RadixNat(extra), left(u)) = radix_positive(extra, q)),
      absurd(radix_decode_nonzero(extra, q, sym(same)))
    );
  };
}
theorem radix_nonzero_injective(extra : Nat, p : RadixPositive(extra), b : RadixNat(extra)) : (
  radix_positive_to_nat(extra, p) = radix_to_nat(extra, b)
) -> (radix_positive(extra, p) = b) {
  exact match b as y return (
    (radix_positive_to_nat(extra, p) = radix_to_nat(extra, y)) -> (radix_positive(extra, p) = y)
  ) {
    left zero => fun (same : radix_positive_to_nat(extra, p) = 0) => typed(
      (radix_positive(extra, p) = typed(RadixNat(extra), left(zero))),
      absurd(radix_decode_nonzero(extra, p, same))
    );
    right q => fun (same : radix_positive_to_nat(extra, p) = radix_positive_to_nat(extra, q)) => cong(
      radix_positive(extra), radix_positive_injective(extra, p, q, same)
    );
  };
}
theorem radix_injective(extra : Nat, a : RadixNat(extra), b : RadixNat(extra)) : (
  radix_to_nat(extra, a) = radix_to_nat(extra, b)
) -> (a = b) {
  exact match a as x return ((radix_to_nat(extra, x) = radix_to_nat(extra, b)) -> (x = b)) {
    left zero => radix_zero_injective(extra, zero, b);
    right p => radix_nonzero_injective(extra, p, b);
  };
}
theorem radix_roundtrip(extra : Nat, a : RadixNat(extra)) : radix_of_nat(
  extra, radix_to_nat(extra, a)
) = a {
  exact radix_injective(
    extra, radix_of_nat(extra, radix_to_nat(extra, a)), a,
    radix_nat_roundtrip(extra, radix_to_nat(extra, a))
  );
}
def radix_nat_equiv(extra : Nat) =
  equiv_from_inverse(
    U0, RadixNat(extra), Nat, radix_to_nat(extra), radix_of_nat(extra), radix_roundtrip(extra),
    radix_nat_roundtrip(extra)
  );
def nat_radix_equiv(extra : Nat) =
  equiv_from_inverse(
    U0, Nat, RadixNat(extra), radix_of_nat(extra), radix_to_nat(extra), radix_nat_roundtrip(extra),
    radix_roundtrip(extra)
  );
