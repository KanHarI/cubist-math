// Product commutativity
// Complete checked construction. All intermediate steps are included.
construction product_commutes {
  private s0001_UIntro0 = universe_zero();
  private s0002_CtxExt = assume(s0001_UIntro0, none);
  private s0003_CtxExt = assume(s0001_UIntro0, s0002_CtxExt);
  private s0004_Vble = variable(s0002_CtxExt);
  private s0005_Vble = variable(s0003_CtxExt);
  private s0006_SigmaForm = pair_type(s0004_Vble, s0005_Vble, none);
  private s0007_SigmaForm = pair_type(s0005_Vble, s0004_Vble, none);
  private s0008_PiForm = function_type(s0006_SigmaForm, s0007_SigmaForm, none);
  private s0009_PiForm = function_type(s0001_UIntro0, s0008_PiForm, s0003_CtxExt);
  export ProductCommutes = function_type(s0001_UIntro0, s0009_PiForm, s0002_CtxExt);
  private s0011_CtxExt = assume(s0001_UIntro0, none);
  private s0012_CtxExt = assume(s0001_UIntro0, s0011_CtxExt);
  private s0013_Vble = variable(s0011_CtxExt);
  private s0014_Vble = variable(s0012_CtxExt);
  private s0015_PiForm = function_type(s0013_Vble, s0001_UIntro0, none);
  private s0016_CtxExt = assume(s0015_PiForm, none);
  private s0017_Vble = variable(s0016_CtxExt);
  private s0018_CtxExt = assume(s0013_Vble, none);
  private s0019_Vble = variable(s0018_CtxExt);
  private s0020_PiElim = apply(s0017_Vble, s0019_Vble);
  private s0021_SigmaForm = pair_type(s0013_Vble, s0020_PiElim, s0018_CtxExt);
  private s0022_CtxExt = assume(s0020_PiElim, none);
  private s0023_Vble = variable(s0022_CtxExt);
  private s0024_CtxExt = assume(s0021_SigmaForm, none);
  private s0025_Vble = variable(s0024_CtxExt);
  private s0026_SigmaElim = pair_eliminate(
    s0013_Vble, s0019_Vble, s0025_Vble, none, s0018_CtxExt, s0022_CtxExt
  );
  private s0027_PiIntro = function_intro(s0021_SigmaForm, s0026_SigmaElim, s0024_CtxExt);
  private s0028_PiIntro = function_intro(s0015_PiForm, s0027_PiIntro, s0016_CtxExt);
  private s0029_PiIntro = function_intro(s0001_UIntro0, s0028_PiIntro, s0011_CtxExt);
  private s0030_SigmaIntro = pair_intro(s0019_Vble, s0020_PiElim, s0023_Vble, s0018_CtxExt);
  private s0031_PiComp = function_compute(s0026_SigmaElim, s0030_SigmaIntro, s0024_CtxExt);
  private s0032_SigmaComp = pair_compute(
    s0013_Vble, s0019_Vble, s0019_Vble, s0023_Vble, none, s0018_CtxExt, none
  );
  private s0033_DefEqSwp = definition_symmetry(s0032_SigmaComp);
  private s0034_Subs = substitute(s0023_Vble, s0033_DefEqSwp);
  private s0035_PiElim = apply(s0017_Vble, s0026_SigmaElim);
  private s0036_SigmaElim = pair_eliminate(
    s0035_PiElim, s0034_Subs, s0025_Vble, s0024_CtxExt, s0018_CtxExt, s0022_CtxExt
  );
  private s0037_PiIntro = function_intro(s0021_SigmaForm, s0036_SigmaElim, s0024_CtxExt);
  private s0038_PiIntro = function_intro(s0015_PiForm, s0037_PiIntro, s0016_CtxExt);
  private s0039_PiIntro = function_intro(s0001_UIntro0, s0038_PiIntro, s0011_CtxExt);
  private s0040_Def = define(s0029_PiIntro);
  private s0041_DefEqExtL = definition_left(s0040_Def);
  private s0042_Def = define(s0039_PiIntro);
  private s0043_DefEqExtL = definition_left(s0042_Def);
  private s0044_PiIntro = function_intro(s0013_Vble, s0014_Vble, none);
  private s0045_PiElim = apply(s0028_PiIntro, s0044_PiIntro);
  private s0046_BetaReduceGrossKnuth = reduce_pass(s0045_PiElim);
  private s0047_PiIntro = function_intro(s0001_UIntro0, s0046_BetaReduceGrossKnuth, s0012_CtxExt);
  private s0048_PiIntro = function_intro(s0001_UIntro0, s0047_PiIntro, s0011_CtxExt);
  private s0049_Def = define(s0048_PiIntro);
  private s0050_DefEqExtL = definition_left(s0049_Def);
  private s0051_PiElim = apply(s0038_PiIntro, s0044_PiIntro);
  private s0052_BetaReduceGrossKnuth = reduce_pass(s0051_PiElim);
  private s0053_BetaReduceGrossKnuth = reduce_pass(s0052_BetaReduceGrossKnuth);
  private s0054_PiIntro = function_intro(s0001_UIntro0, s0053_BetaReduceGrossKnuth, s0012_CtxExt);
  private s0055_PiIntro = function_intro(s0001_UIntro0, s0054_PiIntro, s0011_CtxExt);
  private s0056_Def = define(s0055_PiIntro);
  private s0057_DefEqExtL = definition_left(s0056_Def);
  private s0058_CtxExt = assume(s0006_SigmaForm, none);
  private s0059_Vble = variable(s0058_CtxExt);
  private s0060_PiElim = apply(s0057_DefEqExtL, s0013_Vble);
  private s0061_PiElim = apply(s0060_PiElim, s0014_Vble);
  private s0062_PiElim = apply(s0050_DefEqExtL, s0013_Vble);
  private s0063_PiElim = apply(s0062_PiElim, s0014_Vble);
  private s0064_PiElim = apply(s0061_PiElim, s0059_Vble);
  private s0065_PiElim = apply(s0063_PiElim, s0059_Vble);
  private s0066_SigmaIntro = pair_intro(s0064_PiElim, s0013_Vble, s0065_PiElim, none);
  private s0067_PiIntro = function_intro(s0006_SigmaForm, s0066_SigmaIntro, s0058_CtxExt);
  private s0068_PiIntro = function_intro(s0001_UIntro0, s0067_PiIntro, s0012_CtxExt);
  export product_commutes = function_intro(s0001_UIntro0, s0068_PiIntro, s0011_CtxExt);
  verify ProductCommutes with product_commutes;
}
