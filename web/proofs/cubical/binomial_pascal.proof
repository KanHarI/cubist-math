import binomial_types;

def BinCard(n : Nat, k : Nat, p : Fin(n) -> Bool) = Mere(Bijection(Fin(k), Selected(Fin(n), p)));
def bin_predicate(n : Nat, k : Nat, s : FiniteBinomial(n, k)) : Fin(n) -> Bool {
  exact sigma_first(Fin(n) -> Bool, BinCard(n, k), s);
}

def bin_cardinality(n : Nat, k : Nat, s : FiniteBinomial(n, k)) =
  sigma_second(Fin(n) -> Bool, BinCard(n, k), s);
def bin_pair(n : Nat, k : Nat, p : Fin(n) -> Bool, h : BinCard(n, k, p)) =
  typed(FiniteBinomial(n, k), (p, h));
theorem bin_ext(
  n : Nat, k : Nat, u : FiniteBinomial(n, k), v : FiniteBinomial(n, k),
  p : bin_predicate(n, k, u) = bin_predicate(n, k, v)
) : u = v {
  exact subtype_ext(
    Fin(n) -> Bool, BinCard(n, k),
    (fun (q : Fin(n) -> Bool) => mere_is_prop(Bijection(Fin(k), Selected(Fin(n), q)))), u, v, p
  );
}

def normalize_card(n : Nat, k : Nat, p : Fin(succ(n)) -> Bool, h : BinCard(succ(n), k, p)) =
  cardinal_compose(
    Fin(k), Selected(Fin(succ(n)), p), Selected(Fin(succ(n)), predicate_normal(Fin(n), p)), h,
    selected_normalize(Fin(n), p)
  );

def bin_drop(
  n : Nat, k : Nat, p : Fin(n) -> Bool,
  h : BinCard(succ(n), succ(k), predicate_join(Fin(n), yes, p))
) =
  bin_pair(
    n, k, p,
    mere_map(
      Bijection(Fin(succ(k)), Unit or Selected(Fin(n), p)), Bijection(Fin(k), Selected(Fin(n), p)),
      cancel_unit_bijection(
        Fin(k), Selected(Fin(n), p), selected_decidable(Fin(n), fin_decidable(n), p)
      ),
      cardinal_compose(
        Fin(succ(k)), Selected(Fin(succ(n)), predicate_join(Fin(n), yes, p)), Unit
        or Selected(Fin(n), p), h, selected_true(Fin(n), p)
      )
    )
  );
def bin_omit(
  n : Nat, k : Nat, p : Fin(n) -> Bool, h : BinCard(succ(n), k, predicate_join(Fin(n), no, p))
) =
  bin_pair(
    n, k, p,
    cardinal_compose(
      Fin(k), Selected(Fin(succ(n)), predicate_join(Fin(n), no, p)), Selected(Fin(n), p), h,
      selected_false(Fin(n), p)
    )
  );

def bin_include(n : Nat, k : Nat, p : Fin(n) -> Bool, h : BinCard(n, k, p)) =
  bin_pair(
    succ(n), succ(k), predicate_join(Fin(n), yes, p),
    cardinal_compose(
      Fin(succ(k)), Unit or Selected(Fin(n), p),
      Selected(Fin(succ(n)), predicate_join(Fin(n), yes, p)),
      mere_map(
        Bijection(Fin(k), Selected(Fin(n), p)),
        Bijection(Fin(succ(k)), Unit or Selected(Fin(n), p)),
        (
          fun (e : Bijection(Fin(k), Selected(Fin(n), p))) => sum_bijection(
            Unit, Fin(k), Unit, Selected(Fin(n), p), identity_bijection(Unit), e
          )
        ), h
      ),
      reverse_bijection(
        Selected(Fin(succ(n)), predicate_join(Fin(n), yes, p)), Unit or Selected(Fin(n), p),
        selected_true(Fin(n), p)
      )
    )
  );
def bin_exclude(n : Nat, k : Nat, p : Fin(n) -> Bool, h : BinCard(n, k, p)) =
  bin_pair(
    succ(n), k, predicate_join(Fin(n), no, p),
    cardinal_compose(
      Fin(k), Selected(Fin(n), p), Selected(Fin(succ(n)), predicate_join(Fin(n), no, p)), h,
      reverse_bijection(
        Selected(Fin(succ(n)), predicate_join(Fin(n), no, p)), Selected(Fin(n), p),
        selected_false(Fin(n), p)
      )
    )
  );

def change_head_card(
  n : Nat, k : Nat, p : Fin(n) -> Bool, b : Bool, c : Bool, q : b = c,
  h : BinCard(succ(n), k, predicate_join(Fin(n), b, p))
) =
  transport((fun (v : Bool) => BinCard(succ(n), k, predicate_join(Fin(n), v, p))), b, c, q, h);

def pascal_on_head(n : Nat, k : Nat, p : Fin(n) -> Bool, b : Bool) =
  match b as c return (
    BinCard(succ(n), succ(k), predicate_join(Fin(n), c, p))
    -> (FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)))
  ) {
    left u => fun (h : BinCard(succ(n), succ(k), predicate_join(Fin(n), typed(Bool, left(u)), p))) => typed(
      FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)),
      left(
        bin_drop(
          n, k, p,
          change_head_card(
            n, succ(k), p, typed(Bool, left(u)), yes,
            cong((fun (v : Unit) => typed(Bool, left(v))), sym(unit_equal(u))), h
          )
        )
      )
    );
    right u => fun (h : BinCard(succ(n), succ(k), predicate_join(Fin(n), typed(Bool, right(u)), p))) => typed(
      FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)),
      right(
        bin_omit(
          n, succ(k), p,
          change_head_card(
            n, succ(k), p, typed(Bool, right(u)), no,
            cong((fun (v : Unit) => typed(Bool, right(v))), sym(unit_equal(u))), h
          )
        )
      )
    );
  };
def pascal_forward(n : Nat, k : Nat, s : FiniteBinomial(succ(n), succ(k))) =
  pascal_on_head(
    n, k, predicate_tail(Fin(n), bin_predicate(succ(n), succ(k), s)),
    bin_predicate(succ(n), succ(k), s, head(Fin(n))),
    normalize_card(
      n, succ(k), bin_predicate(succ(n), succ(k), s), bin_cardinality(succ(n), succ(k), s)
    )
  );
def pascal_backward(n : Nat, k : Nat, s : FiniteBinomial(n, k) or FiniteBinomial(n, succ(k))) =
  match s return FiniteBinomial(succ(n), succ(k)) {
    left u => bin_include(n, k, bin_predicate(n, k, u), bin_cardinality(n, k, u));
    right v => bin_exclude(n, succ(k), bin_predicate(n, succ(k), v), bin_cardinality(n, succ(k), v));
  };

theorem pascal_predicate_roundtrip(n : Nat, k : Nat, p : Fin(n) -> Bool, b : Bool) = match b as c return (
  forall h : BinCard(succ(n), succ(k), predicate_join(Fin(n), c, p)),
  bin_predicate(succ(n), succ(k), pascal_backward(n, k, pascal_on_head(n, k, p, c, h))) = predicate_join(
    Fin(n), c, p
  )
) {
  left u => fun (h : BinCard(succ(n), succ(k), predicate_join(Fin(n), typed(Bool, left(u)), p))) => cong(
    (fun (c : Bool) => predicate_join(Fin(n), c, p)),
    cong((fun (v : Unit) => typed(Bool, left(v))), unit_equal(u))
  );
  right u => fun (h : BinCard(succ(n), succ(k), predicate_join(Fin(n), typed(Bool, right(u)), p))) => cong(
    (fun (c : Bool) => predicate_join(Fin(n), c, p)),
    cong((fun (v : Unit) => typed(Bool, right(v))), unit_equal(u))
  );
};
theorem pascal_left(n : Nat, k : Nat, s : FiniteBinomial(succ(n), succ(k))) : pascal_backward(
  n, k, pascal_forward(n, k, s)
) = s {
  let p = bin_predicate(succ(n), succ(k), s);
  let h = bin_cardinality(succ(n), succ(k), s);
  exact bin_ext(
    succ(n), succ(k), pascal_backward(n, k, pascal_forward(n, k, s)), s,
    trans(
      pascal_predicate_roundtrip(
        n, k, predicate_tail(Fin(n), p), p(head(Fin(n))), normalize_card(n, succ(k), p, h)
      ), predicate_eta(Fin(n), p)
    )
  );
}

def sum_left_or(A : U0, B : U0, fallback : A, x : A or B) = match x return A {
    left a => a;
    right b => fallback;
  };
def sum_right_or(A : U0, B : U0, fallback : B, x : A or B) = match x return B {
    left a => fallback;
    right b => b;
  };
theorem pascal_right_selected(n : Nat, k : Nat, s : FiniteBinomial(n, k)) : pascal_forward(
  n, k, pascal_backward(n, k, typed(FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), left(s)))
) = typed(FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), left(s)) {
  let result =
    pascal_forward(
      n, k,
      pascal_backward(n, k, typed(FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), left(s)))
    );
  let restored = sum_left_or(FiniteBinomial(n, k), FiniteBinomial(n, succ(k)), s, result);
  exact cong(
    (
      fun (v : FiniteBinomial(n, k)) => typed(
        FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), left(v)
      )
    ),
    bin_ext(
      n, k, restored, s,
      FunExt(
        U0, Fin(n), (fun (a : Fin(n)) => Bool), bin_predicate(n, k, restored),
        bin_predicate(n, k, s), (fun (a : Fin(n)) => refl(bin_predicate(n, k, s, a)))
      )
    )
  );
}

theorem pascal_right_omitted(n : Nat, k : Nat, s : FiniteBinomial(n, succ(k))) : pascal_forward(
  n, k, pascal_backward(n, k, typed(FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), right(s)))
) = typed(FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), right(s)) {
  let result =
    pascal_forward(
      n, k,
      pascal_backward(n, k, typed(FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), right(s)))
    );
  let restored = sum_right_or(FiniteBinomial(n, k), FiniteBinomial(n, succ(k)), s, result);
  exact cong(
    (
      fun (v : FiniteBinomial(n, succ(k))) => typed(
        FiniteBinomial(n, k) or FiniteBinomial(n, succ(k)), right(v)
      )
    ),
    bin_ext(
      n, succ(k), restored, s,
      FunExt(
        U0, Fin(n), (fun (a : Fin(n)) => Bool), bin_predicate(n, succ(k), restored),
        bin_predicate(n, succ(k), s), (fun (a : Fin(n)) => refl(bin_predicate(n, succ(k), s, a)))
      )
    )
  );
}

def pascal_right(n : Nat, k : Nat, s : FiniteBinomial(n, k) or FiniteBinomial(n, succ(k))) =
  with unfolding [pascal_right_omitted] {
    match s as z return (pascal_forward(n, k, pascal_backward(n, k, z)) = z) {
      left u => pascal_right_selected(n, k, u);
      right v => pascal_right_omitted(n, k, v);
    }
  };
theorem binomial_pascal(n : Nat, k : Nat) : Bijection(
  FiniteBinomial(succ(n), succ(k)), FiniteBinomial(n, k) or FiniteBinomial(n, succ(k))
) {
  exact (pascal_forward(n, k), pascal_backward(n, k), pascal_left(n, k), pascal_right(n, k));
}
