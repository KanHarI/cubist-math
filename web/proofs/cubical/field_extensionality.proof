import field_logic;
import bijection_equality;

// The predicate values are small, although the space of predicates is U1.
// Univalence and function extensionality are constructive assumptions here.
theorem field_prop_ext(
  P : U0, Q : U0, propP : FieldProp(P), propQ : FieldProp(Q), f : P -> Q, g : Q -> P
) : P = Q {
  exact ua(
    U0, P, Q,
    bijection_equiv(
      P, Q, proposition_is_set(Q, propQ),
      typed(
        Bijection(P, Q),
        (f, g, (fun (p : P) => propP(g(f(p)), p)), (fun (q : Q) => propQ(f(g(q)), q)))
      )
    )
  );
}

theorem field_predicate_ext(
  A : U1, P : A -> U0, Q : A -> U0, propP : (forall a : A, FieldProp(P(a))),
  propQ : (forall a : A, FieldProp(Q(a))), same : (forall a : A, FieldIff(P(a), Q(a)))
) : P = Q {
  exact FunExt(
    U1, A, (fun (a : A) => typed(U1, U0)), P, Q,
    (
      fun (a : A) => field_prop_ext(
        P(a), Q(a), propP(a), propQ(a), field_fst(P(a) -> Q(a), Q(a) -> P(a), same(a)),
        field_snd(P(a) -> Q(a), Q(a) -> P(a), same(a))
      )
    )
  );
}

def field_dependent_pair_path(
  A : U1, P : A -> U1, x : A, y : A, p : x = y, u : P(x), v : P(y), q : transport(P, x, y, p, u) = v
) =
  path(
    fun (i : Interval) => exists z : A, P(z),
    fun (i : Interval) => typed(
      (exists z : A, P(z)),
      (at(p, i), at(path_from_transport(fun (j : Interval) => P(at(p, j)), u, v, q), i))
    )
  );
def field_sigma_eta(A : U1, P : A -> U1, u : (exists x : A, P(x))) =
  pair_induction(
    (
      fun (v : (exists x : A, P(x))) => typed(
        (exists x : A, P(x)), (field_first(A, P, v), field_second(A, P, v))
      ) = v
    ), (fun (x : A) => fun (h : P(x)) => refl(typed((exists z : A, P(z)), (x, h)))), u
  );
theorem field_subtype_ext(
  A : U1, P : A -> U1, prop : (forall a : A, FieldProp(P(a))), u : (exists x : A, P(x)),
  v : (exists x : A, P(x)), p : field_first(A, P, u) = field_first(A, P, v)
) : u = v {
  exact trans(
    sym(field_sigma_eta(A, P, u)),
    trans(
      field_dependent_pair_path(
        A, P, field_first(A, P, u), field_first(A, P, v), p, field_second(A, P, u),
        field_second(A, P, v),
        prop(
          field_first(A, P, v),
          transport(P, field_first(A, P, u), field_first(A, P, v), p, field_second(A, P, u)),
          field_second(A, P, v)
        )
      ), field_sigma_eta(A, P, v)
    )
  );
}

theorem field_sigma_prop(
  A : U1, P : A -> U1, propA : FieldProp(A), propP : (forall a : A, FieldProp(P(a))),
  u : (exists a : A, P(a)), v : (exists a : A, P(a))
) : u = v {
  exact field_subtype_ext(A, P, propP, u, v, propA(field_first(A, P, u), field_first(A, P, v)));
}
