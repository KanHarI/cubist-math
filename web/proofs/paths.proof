// Equality operations are defined by path induction.
def inverse(U : Universe, A : U, x : A, y : A, p : x = y) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => b = a, fun (a : A) => refl(a), x, y, p
  );

def concatenate(U : Universe, A : U, x : A, y : A, z : A, p : x = y, q : y = z) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (r : a = b) => forall c : A, (b = c) -> (a = c),
    fun (a : A) => fun (c : A) => fun (r : a = c) => r, x, y, p
  )(z, q);

// Applying a function to a path, defined by equality induction.
def ap(U : Universe, A : U, B : U, f : A -> B, x : A, y : A, p : x = y) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => f(a) = f(b), fun (a : A) => refl(f(a)), x,
    y, p
  );

// Half-adjoint equivalence: an inverse, two homotopies and their triangle law.
// The triangle is essential for general types; inverse data alone is not IsEquiv.
def IsEquiv(U : Universe, A : U, B : U, f : A -> B) =
  exists g : B -> A, exists eta : (forall x : A, g(f(x)) = x),
  exists epsilon : (forall y : B, f(g(y)) = y), forall x : A,
  ap(U, A, B, f, g(f(x)), x, eta(x)) = epsilon(f(x));

def Equiv(U : Universe, A : U, B : U) = exists f : A -> B, IsEquiv(U, A, B, f);

// For a set-valued codomain, equality proofs are unique, so the triangle law
// follows from the supplied inverse homotopies. This is constructive at any U.
def equiv_from_inverse_into_set(
  U : Universe, A : U, B : U,
  setB : (forall x : B, forall y : B, forall p : x = y, forall q : x = y, p = q), f : A -> B, g : B
  -> A, eta : (forall x : A, g(f(x)) = x), epsilon : (forall y : B, f(g(y)) = y)
) : Equiv(U, A, B) {
  exact (
    f, g, eta, epsilon,
    (fun (x : A) => setB(f(g(f(x))), f(x), ap(U, A, B, f, g(f(x)), x, eta(x)), epsilon(f(x))))
  );
}

def transport_constant(A : U1, B : U1, x : A, y : A, p : x = y, v : B) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => forall w : B,
    transport((fun (point : A) => B), a, b, q, w) = w, fun (a : A) => fun (w : B) => refl(w), x, y,
    p
  )(v);

def apd_constant(A : U1, B : U1, f : A -> B, x : A, y : A, p : x = y) =
  path_induction(
    A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => apd(f, a, b, q) = concatenate(
      U1, B, transport((fun (point : A) => B), a, b, q, f(a)), f(a), f(b),
      transport_constant(A, B, a, b, q, f(a)), ap(U1, A, B, f, a, b, q)
    ), fun (a : A) => refl(refl(f(a))), x, y, p
  );

def cancel_left(A : U1, x : A, y : A, p : x = y) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (path : a = b) => forall z : A, forall q : b = z,
    forall r : b = z, (concatenate(U1, A, a, b, z, path, q) = concatenate(U1, A, a, b, z, path, r))
    -> (q = r),
    fun (a : A) => fun (z : A) => fun (q : a = z) => fun (r : a = z) => fun (h : q = r) => h, x, y,
    p
  );

// The path algebra and transport laws used by encode/decode.
def right_unit(A : U1, x : A, y : A, p : x = y) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => concatenate(U1, A, a, b, b, q, refl(b)) = q,
    fun (a : A) => refl(refl(a)), x, y, p
  );

def inverse_left(A : U1, x : A, y : A, p : x = y) =
  path_induction(
    A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => concatenate(
      U1, A, b, a, b, inverse(U1, A, a, b, q), q
    ) = refl(b), fun (a : A) => refl(refl(a)), x, y, p
  );

def inverse_right(A : U1, x : A, y : A, p : x = y) =
  path_induction(
    A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => concatenate(
      U1, A, a, b, a, q, inverse(U1, A, a, b, q)
    ) = refl(a), fun (a : A) => refl(refl(a)), x, y, p
  );

def path_associative(A : U1, x : A, y : A, z : A, w : A, p : x = y, q : y = z, r : z = w) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (path : a = b) => forall c : A, forall d : A,
    forall q1 : b = c, forall r1 : c = d,
    concatenate(U1, A, a, c, d, concatenate(U1, A, a, b, c, path, q1), r1) = concatenate(
      U1, A, a, b, d, path, concatenate(U1, A, b, c, d, q1, r1)
    ),
    fun (a : A) => fun (c : A) => fun (d : A) => fun (q1 : a = c) => fun (r1 : c = d) => refl(
      concatenate(U1, A, a, c, d, q1, r1)
    ), x, y, p
  )(z, w, q, r);

def transport_concat(A : U1, C : A -> U0, x : A, y : A, z : A, p : x = y, q : y = z, v : C(x)) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (path : a = b) => forall c : A, forall next : b = c,
    forall u : C(a),
    transport(C, a, c, concatenate(U1, A, a, b, c, path, next), u) = transport(
      C, b, c, next, transport(C, a, b, path, u)
    ),
    fun (a : A) => fun (c : A) => fun (next : a = c) => fun (u : C(a)) => refl(
      transport(C, a, c, next, u)
    ), x, y, p
  )(z, q, v);

def transport_inverse_after(A : U1, C : A -> U0, x : A, y : A, p : x = y, v : C(x)) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => forall u : C(a),
    transport(C, b, a, inverse(U1, A, a, b, q), transport(C, a, b, q, u)) = u,
    fun (a : A) => fun (u : C(a)) => refl(u), x, y, p
  )(v);

def transport_after_inverse(A : U1, C : A -> U0, x : A, y : A, p : x = y, v : C(y)) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => forall u : C(b),
    transport(C, a, b, q, transport(C, b, a, inverse(U1, A, a, b, q), u)) = u,
    fun (a : A) => fun (u : C(a)) => refl(u), x, y, p
  )(v);

def transport_ap(A : U1, C : A -> U0, x : A, y : A, p : x = y, v : C(x)) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => forall u : C(a),
    transport(C, a, b, q, u) = transport(
      (fun (T : U0) => T), C(a), C(b), ap(U1, A, U0, C, a, b, q), u
    ), fun (a : A) => fun (u : C(a)) => refl(u), x, y, p
  )(v);

def append_cancel_inverse(A : U1, x : A, y : A, z : A, p : x = y, q : y = z) =
  trans(
    path_associative(A, x, y, z, y, p, q, inverse(U1, A, y, z, q)),
    trans(
      cong((fun (r : y = y) => concatenate(U1, A, x, y, y, p, r)), inverse_right(A, y, z, q)),
      right_unit(A, x, y, p)
    )
  );

def append_inverse_cancel(A : U1, x : A, y : A, z : A, p : x = y, q : z = y) =
  trans(
    path_associative(A, x, y, z, y, p, inverse(U1, A, z, y, q), q),
    trans(
      cong((fun (r : y = y) => concatenate(U1, A, x, y, y, p, r)), inverse_left(A, z, y, q)),
      right_unit(A, x, y, p)
    )
  );

// Transport of a function returning a path from a fixed base point.
def transport_decoder(
  A : U1, origin : A, C : A -> U0, x : A, y : A, p : x = y, f : C(x) -> (origin = x), v : C(y)
) =
  path_induction(
    A, fun (a : A) => fun (b : A) => fun (q : a = b) => forall g : C(a) -> (origin = a),
    forall w : C(b),
    transport((fun (point : A) => C(point) -> (origin = point)), a, b, q, g)(w) = concatenate(
      U1, A, origin, a, b, g(transport(C, b, a, inverse(U1, A, a, b, q), w)), q
    ),
    fun (a : A) => fun (g : C(a) -> (origin = a)) => fun (w : C(a)) => sym(
      right_unit(A, origin, a, g(w))
    ), x, y, p
  )(f, v);

// Based path induction, with explicit universes for the carrier and motive.
// This one principle covers both small and higher identity systems.
def based_induction(
  U : Universe, V : Universe, A : U, origin : A, C : (forall x : A, (origin = x) -> V),
  c : C(origin, refl(origin)), x : A, p : origin = x
) =
  path_induction(
    A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => forall D : (forall point : A, (a = point) -> V),
    D(a, refl(a)) -> D(b, q),
    fun (a : A) => fun (D : (forall point : A, (a = point) -> V)) => fun (d : D(a, refl(a))) => d,
    origin, x, p
  )(C, c);
