// Equality operations are defined by path induction.
def inverse(A : Type1, x : A, y : A, p : x = y) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => b = a,
    fun (a : A) => refl(a), x, y, p);

def concatenate(A : Type1, x : A, y : A, z : A, p : x = y, q : y = z) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (r : a = b) =>
      forall c : A, (b = c) -> (a = c),
    fun (a : A) => fun (c : A) => fun (r : a = c) => r,
    x, y, p)(z, q);


// Applying a function to a path, defined by equality induction.
def ap(A : Type1, B : Type1, f : A -> B, x : A, y : A, p : x = y) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => f(a) = f(b),
    fun (a : A) => refl(f(a)), x, y, p);

def IsEquiv(A : Type, B : Type, f : A -> B) =
  exists g : B -> A,
  exists eta : (forall x : A, g(f(x)) = x),
  exists epsilon : (forall y : B, f(g(y)) = y),
  forall x : A,
    typed((f(g(f(x))) = f(x)), ap(A, B, f, g(f(x)), x, eta(x))) = epsilon(f(x));

def Equiv(A : Type, B : Type) = exists f : A -> B, IsEquiv(A, B, f);

def transport_constant(A : Type1, B : Type1, x : A, y : A, p : x = y, v : B) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) =>
      forall w : B, transport((fun (point : A) => B), a, b, q, w) = w,
    fun (a : A) => fun (w : B) => refl(w), x, y, p)(v);

def apd_constant(A : Type1, B : Type1, f : A -> B, x : A, y : A, p : x = y) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) =>
      apd(f, a, b, q) = concatenate(B,
        transport((fun (point : A) => B), a, b, q, f(a)), f(a), f(b),
        transport_constant(A, B, a, b, q, f(a)), ap(A, B, f, a, b, q)),
    fun (a : A) => refl(refl(f(a))), x, y, p);

def cancel_left(A : Type1, x : A, y : A, p : x = y) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (path : a = b) =>
      forall z : A, forall q : b = z, forall r : b = z,
      (concatenate(A, a, b, z, path, q) = concatenate(A, a, b, z, path, r)) -> (q = r),
    fun (a : A) => fun (z : A) => fun (q : a = z) => fun (r : a = z) => fun (h : q = r) => h,
    x, y, p);

// The path algebra and transport laws used by encode/decode.
def right_unit(A : Type1, x : A, y : A, p : x = y) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) =>
      concatenate(A, a, b, b, q, refl(b)) = q,
    fun (a : A) => refl(refl(a)), x, y, p);

def inverse_left(A : Type1, x : A, y : A, p : x = y) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) =>
      concatenate(A, b, a, b, inverse(A, a, b, q), q) = refl(b),
    fun (a : A) => refl(refl(a)), x, y, p);

def inverse_right(A : Type1, x : A, y : A, p : x = y) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) =>
      concatenate(A, a, b, a, q, inverse(A, a, b, q)) = refl(a),
    fun (a : A) => refl(refl(a)), x, y, p);

def path_associative(A : Type1, x : A, y : A, z : A, w : A,
  p : x = y, q : y = z, r : z = w) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (path : a = b) =>
      forall c : A, forall d : A, forall q1 : b = c, forall r1 : c = d,
      concatenate(A, a, c, d, concatenate(A, a, b, c, path, q1), r1) =
      concatenate(A, a, b, d, path, concatenate(A, b, c, d, q1, r1)),
    fun (a : A) => fun (c : A) => fun (d : A) => fun (q1 : a = c) => fun (r1 : c = d) =>
      refl(concatenate(A, a, c, d, q1, r1)), x, y, p)(z, w, q, r);

def transport_concat(A : Type1, C : A -> Type, x : A, y : A, z : A,
  p : x = y, q : y = z, v : C(x)) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (path : a = b) =>
      forall c : A, forall next : b = c, forall u : C(a),
      transport(C, a, c, concatenate(A, a, b, c, path, next), u) =
      transport(C, b, c, next, transport(C, a, b, path, u)),
    fun (a : A) => fun (c : A) => fun (next : a = c) => fun (u : C(a)) =>
      refl(transport(C, a, c, next, u)), x, y, p)(z, q, v);

def transport_inverse_after(A : Type1, C : A -> Type, x : A, y : A, p : x = y, v : C(x)) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => forall u : C(a),
      transport(C, b, a, inverse(A, a, b, q), transport(C, a, b, q, u)) = u,
    fun (a : A) => fun (u : C(a)) => refl(u), x, y, p)(v);

def transport_after_inverse(A : Type1, C : A -> Type, x : A, y : A, p : x = y, v : C(y)) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => forall u : C(b),
      transport(C, a, b, q, transport(C, b, a, inverse(A, a, b, q), u)) = u,
    fun (a : A) => fun (u : C(a)) => refl(u), x, y, p)(v);

def transport_ap(A : Type1, C : A -> Type, x : A, y : A, p : x = y, v : C(x)) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) => forall u : C(a),
      transport(C, a, b, q, u) =
      transport((fun (T : Type) => T), C(a), C(b), ap(A, Type, C, a, b, q), u),
    fun (a : A) => fun (u : C(a)) => refl(u), x, y, p)(v);

def append_cancel_inverse(A : Type1, x : A, y : A, z : A, p : x = y, q : y = z) =
  trans(path_associative(A, x, y, z, y, p, q, inverse(A, y, z, q)),
    trans(cong((fun (r : y = y) => concatenate(A, x, y, y, p, r)), inverse_right(A, y, z, q)),
      right_unit(A, x, y, p)));

def append_inverse_cancel(A : Type1, x : A, y : A, z : A, p : x = y, q : z = y) =
  trans(path_associative(A, x, y, z, y, p, inverse(A, z, y, q), q),
    trans(cong((fun (r : y = y) => concatenate(A, x, y, y, p, r)), inverse_left(A, z, y, q)),
      right_unit(A, x, y, p)));

// Transport of a function returning a path from a fixed base point.
def transport_decoder(A : Type1, origin : A, C : A -> Type, x : A, y : A,
  p : x = y, f : C(x) -> (origin = x), v : C(y)) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) =>
      forall g : C(a) -> (origin = a), forall w : C(b),
      transport((fun (point : A) => C(point) -> (origin = point)), a, b, q, g)(w) =
      concatenate(A, origin, a, b, g(transport(C, b, a, inverse(A, a, b, q), w)), q),
    fun (a : A) => fun (g : C(a) -> (origin = a)) => fun (w : C(a)) =>
      sym(right_unit(A, origin, a, g(w))), x, y, p)(f, v);

// The ordinary based path-induction principle, derived from equality induction.
def based_induction(A : Type1, origin : A,
  C : (forall x : A, (origin = x) -> Type), c : C(origin, refl(origin)), x : A, p : origin = x) =
  path_induction(A,
    fun (a : A) => fun (b : A) => fun (q : a = b) =>
      forall D : (forall point : A, (a = point) -> Type),
      D(a, refl(a)) -> D(b, q),
    fun (a : A) => fun (D : (forall point : A, (a = point) -> Type)) => fun (d : D(a, refl(a))) => d,
    origin, x, p)(C, c);
