import group_identity;
import identity_systems;

// Structures on small sets. S contains the operations and their law evidence.
// R states preservation by a function; the hypotheses below are proved for
// each signature, never postulated as axioms.
def Structure(S : U0 -> U0) = exists A : U0, S(A) and IsSet(A);
def structure_object(S : U0 -> U0, A : U0, data : S(A), setA : IsSet(A)) =
  typed(Structure(S), (A, (data, setA)));
def structure_carrier(S : U0 -> U0, X : Structure(S)) =
  field_first(U0, (fun (A : U0) => typed(U1, S(A) and IsSet(A))), X);
def structure_bundle(S : U0 -> U0, X : Structure(S)) =
  field_second(U0, (fun (A : U0) => typed(U1, S(A) and IsSet(A))), X);
def structure_data(S : U0 -> U0, X : Structure(S)) =
  fst(S(structure_carrier(S, X)), IsSet(structure_carrier(S, X)), structure_bundle(S, X));
def structure_set(S : U0 -> U0, X : Structure(S)) : IsSet(structure_carrier(S, X)) {
  exact snd(S(structure_carrier(S, X)), IsSet(structure_carrier(S, X)), structure_bundle(S, X));
}
def StructureRelation(S : U0 -> U0) =
  forall A : U0, forall B : U0, (A -> B) -> S(A) -> S(B) -> U0;
def RelationProp(S : U0 -> U0, R : StructureRelation(S)) =
  forall A : U0, forall B : U0, IsSet(A) -> IsSet(B) ->
  forall f : A -> B, forall a : S(A), forall b : S(B), Proposition(R(A, B, f, a, b));
def RelationIdentity(S : U0 -> U0, R : StructureRelation(S)) =
  forall A : U0, forall a : S(A), R(A, A, (fun (x : A) => x), a, a);
def RelationReflects(S : U0 -> U0, R : StructureRelation(S)) =
  forall A : U0, IsSet(A) -> forall a : S(A), forall b : S(A),
  R(A, A, (fun (x : A) => x), a, b) -> (a = b);
def StructureMapLaws(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S),
  f : structure_carrier(S, X) -> structure_carrier(S, Y)) =
  InverseData(structure_carrier(S, X), structure_carrier(S, Y), f) and
  R(structure_carrier(S, X), structure_carrier(S, Y), f, structure_data(S, X), structure_data(S, Y));
def StructureIso(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S)) =
  exists f : structure_carrier(S, X) -> structure_carrier(S, Y), StructureMapLaws(S, R, X, Y, f);
def structure_iso_forward(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y)) : structure_carrier(S, X) -> structure_carrier(S, Y) {
  exact sigma_first((structure_carrier(S, X) -> structure_carrier(S, Y)), StructureMapLaws(S, R, X, Y), e);
}
def structure_iso_evidence(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y)) =
  sigma_second((structure_carrier(S, X) -> structure_carrier(S, Y)), StructureMapLaws(S, R, X, Y), e);
def structure_iso_bijection(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y)) =
  typed(Bijection(structure_carrier(S, X), structure_carrier(S, Y)),
    (structure_iso_forward(S, R, X, Y, e),
      fst(InverseData(structure_carrier(S, X), structure_carrier(S, Y), structure_iso_forward(S, R, X, Y, e)),
        R(structure_carrier(S, X), structure_carrier(S, Y), structure_iso_forward(S, R, X, Y, e), structure_data(S, X), structure_data(S, Y)),
        structure_iso_evidence(S, R, X, Y, e))));
def structure_iso_preserves(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y)) =
  snd(InverseData(structure_carrier(S, X), structure_carrier(S, Y), structure_iso_forward(S, R, X, Y, e)),
    R(structure_carrier(S, X), structure_carrier(S, Y), structure_iso_forward(S, R, X, Y, e), structure_data(S, X), structure_data(S, Y)),
    structure_iso_evidence(S, R, X, Y, e));

theorem structure_map_laws_prop(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R),
  X : Structure(S), Y : Structure(S), f : structure_carrier(S, X) -> structure_carrier(S, Y)) :
  Proposition(StructureMapLaws(S, R, X, Y, f)) {
  exact group_product_prop(InverseData(structure_carrier(S, X), structure_carrier(S, Y), f),
    R(structure_carrier(S, X), structure_carrier(S, Y), f, structure_data(S, X), structure_data(S, Y)),
    inverse_data_prop(structure_carrier(S, X), structure_carrier(S, Y), structure_set(S, X), structure_set(S, Y), f),
    prop(structure_carrier(S, X), structure_carrier(S, Y), structure_set(S, X), structure_set(S, Y), f, structure_data(S, X), structure_data(S, Y)));
}
theorem structure_iso_ext(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R),
  X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y), d : StructureIso(S, R, X, Y),
  same : (forall x : structure_carrier(S, X), structure_iso_forward(S, R, X, Y, e, x) = structure_iso_forward(S, R, X, Y, d, x))) : e = d {
  exact subtype_ext((structure_carrier(S, X) -> structure_carrier(S, Y)), StructureMapLaws(S, R, X, Y), structure_map_laws_prop(S, R, prop, X, Y), e, d,
    FunExt(U0, structure_carrier(S, X), (fun (x : structure_carrier(S, X)) => structure_carrier(S, Y)),
      structure_iso_forward(S, R, X, Y, e), structure_iso_forward(S, R, X, Y, d), same));
}
def structure_identity_iso(S : U0 -> U0, R : StructureRelation(S), identity : RelationIdentity(S, R), X : Structure(S)) =
  typed(StructureIso(S, R, X, X), ((fun (x : structure_carrier(S, X)) => x),
    (((fun (x : structure_carrier(S, X)) => x), ((fun (x : structure_carrier(S, X)) => refl(x)), (fun (x : structure_carrier(S, X)) => refl(x)))),
     identity(structure_carrier(S, X), structure_data(S, X)))));
def StructureIsoTotal(S : U0 -> U0, R : StructureRelation(S), X : Structure(S)) = exists Y : Structure(S), StructureIso(S, R, X, Y);
def structure_iso_point(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y)) = typed(StructureIsoTotal(S, R, X), (Y, e));
def structure_iso_center(S : U0 -> U0, R : StructureRelation(S), identity : RelationIdentity(S, R), X : Structure(S)) =
  structure_iso_point(S, R, X, X, structure_identity_iso(S, R, identity, X));

// At a fixed carrier and fixed data, sethood evidence contributes no extra paths.
theorem structure_total_set_path(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), A : U0, a : S(A), setA : IsSet(A), setB : IsSet(A)) :
  forall e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setB)),
    (forall x : structure_carrier(S, structure_object(S, A, a, setA)), x = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setB), e, x)) ->
    (structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setB), e)) {
  exact path_induction(IsSet(A),
    (fun (setA : IsSet(A)) => fun (setB : IsSet(A)) => fun (p : setA = setB) => forall e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setB)),
    (forall x : structure_carrier(S, structure_object(S, A, a, setA)), x = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setB), e, x)) ->
    (structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setB), e))),
    (fun (setA : IsSet(A)) => fun (e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setA))) =>
      fun (same : (forall x : A, x = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setA), e, x))) =>
      cong(structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, A, a, setA)), structure_iso_ext(S, R, prop, structure_object(S, A, a, setA), structure_object(S, A, a, setA), structure_identity_iso(S, R, identity, structure_object(S, A, a, setA)), e, same))),
    setA, setB, group_set_evidence_prop(A, setA, setB));
}

theorem structure_total_data_path(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), A : U0, a : S(A), b : S(A), p : a = b) :
  forall setA : IsSet(A), forall setB : IsSet(A), forall e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB)),
    (forall x : structure_carrier(S, structure_object(S, A, a, setA)), x = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e, x)) ->
    (structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e)) {
  exact path_induction(S(A),
    (fun (a : S(A)) => fun (b : S(A)) => fun (p : a = b) => forall setA : IsSet(A), forall setB : IsSet(A), forall e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB)),
    (forall x : structure_carrier(S, structure_object(S, A, a, setA)), x = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e, x)) ->
    (structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e))),
    (fun (a : S(A)) => structure_total_set_path(S, R, prop, identity, A, a)), a, b, p);
}
theorem structure_total_same_carrier(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R),
  A : U0, a : S(A), b : S(A), setA : IsSet(A), setB : IsSet(A), e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB)),
  same : (forall x : A, x = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e, x))) :
  structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e) {
  let f = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e);
  let id = fun (x : A) => x;
  let sameFunction = FunExt(U0, A, (fun (x : A) => A), id, f, same);
  let preserves = transport((fun (f : A -> A) => R(A, A, f, a, b)), f, id, sym(sameFunction), structure_iso_preserves(S, R, structure_object(S, A, a, setA), structure_object(S, A, b, setB), e));
  exact structure_total_data_path(S, R, prop, identity, A, a, b, reflects(A, setA, a, b, preserves), setA, setB, e, same);
}

// Univalence is used only for the carrier; path induction handles the structure.
theorem structure_total_transport(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), A : U0, B : U0, p : A = B) :
  forall a : S(A), forall b : S(B), forall setA : IsSet(A), forall setB : IsSet(B),
    forall e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB)),
    (forall x : A, group_carrier_transport(A, B, p, x) = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB), e, x)) ->
    (structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB), e)) {
  exact path_induction(U0,
    (fun (A : U0) => fun (B : U0) => fun (p : A = B) => forall a : S(A), forall b : S(B), forall setA : IsSet(A), forall setB : IsSet(B),
    forall e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB)),
    (forall x : A, group_carrier_transport(A, B, p, x) = structure_iso_forward(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB), e, x)) ->
    (structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB), e))),
    (fun (A : U0) => structure_total_same_carrier(S, R, prop, identity, reflects, A)), A, B, p);
}
theorem structure_objects_total(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), A : U0, B : U0,
  a : S(A), b : S(B), setA : IsSet(A), setB : IsSet(B), e : StructureIso(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB))) :
  structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB), e) {
  let equivalence = bijection_equiv(A, B, setB, structure_iso_bijection(S, R, structure_object(S, A, a, setA), structure_object(S, B, b, setB), e));
  let p = Univalence(U0, A, B, equivalence);
  exact structure_total_transport(S, R, prop, identity, reflects, A, B, p, a, b, setA, setB, e,
    (fun (x : A) => UnivalenceBeta(U0, A, B, equivalence, x)));
}

def structure_induction(S : U0 -> U0, P : Structure(S) -> U1,
  step : (forall A : U0, forall a : S(A), forall setA : IsSet(A), P(structure_object(S, A, a, setA))), X : Structure(S)) : P(X) {
  exact pair_induction(P, (fun (A : U0) => fun (data : S(A) and IsSet(A)) =>
    pair_induction((fun (data : S(A) and IsSet(A)) => P(typed(Structure(S), (A, data)))), step(A), data)), X);
}

theorem structure_total_contractible(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), X : Structure(S)) : forall Y : Structure(S), forall e : StructureIso(S, R, X, Y), structure_iso_center(S, R, identity, X) = structure_iso_point(S, R, X, Y, e) {
  exact structure_induction(S, (fun (X : Structure(S)) => forall Y : Structure(S), forall e : StructureIso(S, R, X, Y), structure_iso_center(S, R, identity, X) = structure_iso_point(S, R, X, Y, e)),
    (fun (A : U0) => fun (a : S(A)) => fun (setA : IsSet(A)) =>
      structure_induction(S, (fun (Y : Structure(S)) => forall e : StructureIso(S, R, structure_object(S, A, a, setA), Y), structure_iso_center(S, R, identity, structure_object(S, A, a, setA)) = structure_iso_point(S, R, structure_object(S, A, a, setA), Y, e)),
        (fun (B : U0) => fun (b : S(B)) => fun (setB : IsSet(B)) =>
          structure_objects_total(S, R, prop, identity, reflects, A, B, a, b, setA, setB)))), X);
}
def structure_total_contraction(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), X : Structure(S), z : StructureIsoTotal(S, R, X)) =
  pair_induction((fun (z : StructureIsoTotal(S, R, X)) => structure_iso_center(S, R, identity, X) = z),
    structure_total_contractible(S, R, prop, identity, reflects, X), z);

def structure_iso_path_data(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y), d : StructureIso(S, R, X, Y), p : e = d) =
  fun (x : structure_carrier(S, X)) => cong((fun (e : StructureIso(S, R, X, Y)) => structure_iso_forward(S, R, X, Y, e, x)), p);
def structure_iso_choose_path(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y), d : StructureIso(S, R, X, Y), p : e = d) =
  structure_iso_ext(S, R, prop, X, Y, e, d, structure_iso_path_data(S, R, X, Y, e, d, p));
theorem structure_iso_set(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), X : Structure(S), Y : Structure(S)) : IsSet(StructureIso(S, R, X, Y)) {
  have constant : forall e : StructureIso(S, R, X, Y), forall d : StructureIso(S, R, X, Y), forall p : e = d, forall q : e = d,
    structure_iso_choose_path(S, R, prop, X, Y, e, d, p) = structure_iso_choose_path(S, R, prop, X, Y, e, d, q) {
    intro e; intro d; intro p; intro q;
    let sameData = FunExt(U0, structure_carrier(S, X),
      (fun (x : structure_carrier(S, X)) => structure_iso_forward(S, R, X, Y, e, x) = structure_iso_forward(S, R, X, Y, d, x)),
      structure_iso_path_data(S, R, X, Y, e, d, p), structure_iso_path_data(S, R, X, Y, e, d, q),
      (fun (x : structure_carrier(S, X)) => structure_set(S, Y)(structure_iso_forward(S, R, X, Y, e, x), structure_iso_forward(S, R, X, Y, d, x),
        structure_iso_path_data(S, R, X, Y, e, d, p, x), structure_iso_path_data(S, R, X, Y, e, d, q, x))));
    exact cong(structure_iso_ext(S, R, prop, X, Y, e, d), sameData);
  }
  exact constant_paths_are_set(StructureIso(S, R, X, Y), structure_iso_choose_path(S, R, prop, X, Y), constant);
}
def structure_identity_family(S : U0 -> U0, R : StructureRelation(S), X : Structure(S), Y : Structure(S)) = typed(U1, StructureIso(S, R, X, Y));

// The forward map is canonical: transport of the identity isomorphism.
theorem structure_identity(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), X : Structure(S), Y : Structure(S)) :
  Equiv(U1, (X = Y), StructureIso(S, R, X, Y)) {
  exact identity_system_equivalence(Structure(S), X, structure_identity_family(S, R, X), structure_identity_iso(S, R, identity, X),
    structure_total_contraction(S, R, prop, identity, reflects, X), Y, structure_iso_set(S, R, prop, X, Y));
}
def structure_equality_iso(S : U0 -> U0, R : StructureRelation(S), identity : RelationIdentity(S, R), X : Structure(S), Y : Structure(S), p : X = Y) =
  transport(structure_identity_family(S, R, X), X, Y, p, structure_identity_iso(S, R, identity, X));
def structure_iso_equality(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y)) =
  identity_system_encode(Structure(S), X, structure_identity_family(S, R, X), structure_identity_iso(S, R, identity, X),
    structure_total_contraction(S, R, prop, identity, reflects, X), Y, e);
theorem structure_iso_roundtrip(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), X : Structure(S), Y : Structure(S), e : StructureIso(S, R, X, Y)) :
  structure_equality_iso(S, R, identity, X, Y, structure_iso_equality(S, R, prop, identity, reflects, X, Y, e)) = e {
  exact identity_system_section(Structure(S), X, structure_identity_family(S, R, X), structure_identity_iso(S, R, identity, X),
    structure_total_contraction(S, R, prop, identity, reflects, X), Y, e);
}
theorem structure_path_roundtrip(S : U0 -> U0, R : StructureRelation(S), prop : RelationProp(S, R), identity : RelationIdentity(S, R), reflects : RelationReflects(S, R), X : Structure(S), Y : Structure(S), p : X = Y) :
  structure_iso_equality(S, R, prop, identity, reflects, X, Y, structure_equality_iso(S, R, identity, X, Y, p)) = p {
  exact identity_system_retraction(Structure(S), X, structure_identity_family(S, R, X), structure_identity_iso(S, R, identity, X),
    structure_total_contraction(S, R, prop, identity, reflects, X), Y, p);
}
