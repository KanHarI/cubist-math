// Is set
// Complete checked construction. All intermediate steps are included.
construction is_set {
  private s0001_UIntroOmega = universe_omega();
  private s0002_CtxExt = assume(s0001_UIntroOmega, none);
  private s0003_UVble = universe_variable(s0002_CtxExt);
  private s0004_CtxExt = assume(s0003_UVble, none);
  private s0005_Vble = variable(s0004_CtxExt);
  private s0006_CtxExt = assume(s0005_Vble, none);
  private s0007_CtxExt = assume(s0005_Vble, s0006_CtxExt);
  private s0008_Vble = variable(s0006_CtxExt);
  private s0009_Vble = variable(s0007_CtxExt);
  private s0010_EqForm = equality_type(s0005_Vble, s0008_Vble, s0009_Vble);
  private s0011_UIntroOmega = universe_omega();
  private s0012_CtxExt = assume(s0011_UIntroOmega, none);
  private s0013_UVble = universe_variable(s0012_CtxExt);
  private s0014_CtxExt = assume(s0013_UVble, none);
  private s0015_Vble = variable(s0014_CtxExt);
  private s0016_CtxExt = assume(s0015_Vble, none);
  private s0017_CtxExt = assume(s0015_Vble, s0016_CtxExt);
  private s0018_Vble = variable(s0016_CtxExt);
  private s0019_Vble = variable(s0017_CtxExt);
  private s0020_EqForm = equality_type(s0015_Vble, s0018_Vble, s0019_Vble);
  private s0021_PiForm = function_type(s0015_Vble, s0020_EqForm, s0017_CtxExt);
  private s0022_PiForm = function_type(s0015_Vble, s0021_PiForm, s0016_CtxExt);
  private s0023_PiIntro = function_intro(s0013_UVble, s0022_PiForm, s0014_CtxExt);
  private s0024_PiIntro = function_intro(s0011_UIntroOmega, s0023_PiIntro, s0012_CtxExt);
  private s0025_Def = define(s0024_PiIntro);
  private s0026_DefEqExtL = definition_left(s0025_Def);
  private s0027_PiElim = apply(s0026_DefEqExtL, s0013_UVble);
  private s0028_PiElim = apply(s0027_PiElim, s0020_EqForm);
  private s0029_PiForm = function_type(s0015_Vble, s0028_PiElim, s0017_CtxExt);
  private s0030_PiForm = function_type(s0015_Vble, s0029_PiForm, s0016_CtxExt);
  private s0031_PiIntro = function_intro(s0013_UVble, s0030_PiForm, s0014_CtxExt);
  private s0032_PiIntro = function_intro(s0011_UIntroOmega, s0031_PiIntro, s0012_CtxExt);
  private s0033_Def = define(s0032_PiIntro);
  export lib_IsSet = definition_left(s0033_Def);
}
