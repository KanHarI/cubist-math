import group_isomorphisms;

// The total space of groups equipped with an isomorphism from G is contractible.
def GroupIsoTotal(G : Group) = exists H : Group, GroupIso(G, H);
def group_iso_center(G : Group) = typed(GroupIsoTotal(G), (G, group_identity_iso(G)));
def group_iso_point(G : Group, H : Group, iso : GroupIso(G, H)) = typed(GroupIsoTotal(G), (H, iso));
theorem group_total_laws_path(
  A : U0, unit : A, multiply : A -> A -> A, laws : GroupLaws(A, unit, multiply),
  otherLaws : GroupLaws(A, unit, multiply)
) : forall iso : GroupIso(
  group_object(A, unit, multiply, laws), group_object(A, unit, multiply, otherLaws)
),
(
  forall x : group_carrier(group_object(A, unit, multiply, laws)),
  x = group_iso_forward(
    group_object(A, unit, multiply, laws), group_object(A, unit, multiply, otherLaws), iso, x
  )
)
-> (
  group_iso_center(group_object(A, unit, multiply, laws)) = group_iso_point(
    group_object(A, unit, multiply, laws), group_object(A, unit, multiply, otherLaws), iso
  )
) {
  exact path_induction(
    GroupLaws(A, unit, multiply),
    (
      fun (laws : GroupLaws(A, unit, multiply)) => fun (otherLaws : GroupLaws(A, unit, multiply)) => fun (
        p : laws = otherLaws
      ) => forall iso : GroupIso(
        group_object(A, unit, multiply, laws), group_object(A, unit, multiply, otherLaws)
      ),
      (
        forall x : group_carrier(group_object(A, unit, multiply, laws)),
        x = group_iso_forward(
          group_object(A, unit, multiply, laws), group_object(A, unit, multiply, otherLaws), iso, x
        )
      )
      -> (
        group_iso_center(group_object(A, unit, multiply, laws)) = group_iso_point(
          group_object(A, unit, multiply, laws), group_object(A, unit, multiply, otherLaws), iso
        )
      )
    ),
    (
      fun (laws : GroupLaws(A, unit, multiply)) => fun (
        iso : GroupIso(group_object(A, unit, multiply, laws), group_object(A, unit, multiply, laws))
      ) => fun (
        same : (
          forall x : A,
          x = group_iso_forward(
            group_object(A, unit, multiply, laws), group_object(A, unit, multiply, laws), iso, x
          )
        )
      ) => cong(
        group_iso_point(
          group_object(A, unit, multiply, laws), group_object(A, unit, multiply, laws)
        ),
        group_iso_ext(
          group_object(A, unit, multiply, laws), group_object(A, unit, multiply, laws),
          group_identity_iso(group_object(A, unit, multiply, laws)), iso, same
        )
      )
    ), laws, otherLaws, group_laws_prop(A, unit, multiply, laws, otherLaws)
  );
}

theorem group_total_multiplication_path(
  A : U0, unit : A, multiply : A -> A -> A, other : A -> A -> A, same : multiply = other
) : forall laws : GroupLaws(A, unit, multiply), forall otherLaws : GroupLaws(A, unit, other),
forall iso : GroupIso(
  group_object(A, unit, multiply, laws), group_object(A, unit, other, otherLaws)
),
(
  forall x : group_carrier(group_object(A, unit, multiply, laws)),
  x = group_iso_forward(
    group_object(A, unit, multiply, laws), group_object(A, unit, other, otherLaws), iso, x
  )
)
-> (
  group_iso_center(group_object(A, unit, multiply, laws)) = group_iso_point(
    group_object(A, unit, multiply, laws), group_object(A, unit, other, otherLaws), iso
  )
) {
  exact path_induction(
    (A -> A -> A),
    (
      fun (multiply : A -> A -> A) => fun (other : A -> A -> A) => fun (p : multiply = other) => forall laws : GroupLaws(
        A, unit, multiply
      ), forall otherLaws : GroupLaws(A, unit, other),
      forall iso : GroupIso(
        group_object(A, unit, multiply, laws), group_object(A, unit, other, otherLaws)
      ),
      (
        forall x : group_carrier(group_object(A, unit, multiply, laws)),
        x = group_iso_forward(
          group_object(A, unit, multiply, laws), group_object(A, unit, other, otherLaws), iso, x
        )
      )
      -> (
        group_iso_center(group_object(A, unit, multiply, laws)) = group_iso_point(
          group_object(A, unit, multiply, laws), group_object(A, unit, other, otherLaws), iso
        )
      )
    ), (fun (multiply : A -> A -> A) => group_total_laws_path(A, unit, multiply)), multiply, other,
    same
  );
}

theorem group_total_same_carrier(A : U0, unit : A, otherUnit : A, same : unit = otherUnit) : forall multiply : A -> A -> A,
forall other : A -> A -> A, (multiply = other) -> forall laws : GroupLaws(A, unit, multiply),
forall otherLaws : GroupLaws(A, otherUnit, other),
forall iso : GroupIso(
  group_object(A, unit, multiply, laws), group_object(A, otherUnit, other, otherLaws)
),
(
  forall x : group_carrier(group_object(A, unit, multiply, laws)),
  x = group_iso_forward(
    group_object(A, unit, multiply, laws), group_object(A, otherUnit, other, otherLaws), iso, x
  )
)
-> (
  group_iso_center(group_object(A, unit, multiply, laws)) = group_iso_point(
    group_object(A, unit, multiply, laws), group_object(A, otherUnit, other, otherLaws), iso
  )
) {
  exact path_induction(
    A,
    (
      fun (unit : A) => fun (otherUnit : A) => fun (p : unit = otherUnit) => forall multiply : A -> A -> A,
      forall other : A -> A -> A, (multiply = other) -> forall laws : GroupLaws(A, unit, multiply),
      forall otherLaws : GroupLaws(A, otherUnit, other),
      forall iso : GroupIso(
        group_object(A, unit, multiply, laws), group_object(A, otherUnit, other, otherLaws)
      ),
      (
        forall x : group_carrier(group_object(A, unit, multiply, laws)),
        x = group_iso_forward(
          group_object(A, unit, multiply, laws), group_object(A, otherUnit, other, otherLaws), iso,
          x
        )
      )
      -> (
        group_iso_center(group_object(A, unit, multiply, laws)) = group_iso_point(
          group_object(A, unit, multiply, laws), group_object(A, otherUnit, other, otherLaws), iso
        )
      )
    ), (fun (unit : A) => group_total_multiplication_path(A, unit)), unit, otherUnit, same
  );
}

theorem group_total_transport_path(A : U0, B : U0, p : A = B) : forall unitA : A, forall unitB : B,
forall multiplyA : A -> A -> A, forall multiplyB : B -> B -> B,
forall lawsA : GroupLaws(A, unitA, multiplyA), forall lawsB : GroupLaws(B, unitB, multiplyB),
(group_carrier_transport(A, B, p, unitA) = unitB)
-> (
  forall x : A, forall y : A,
  group_carrier_transport(A, B, p, multiplyA(x, y)) = multiplyB(
    group_carrier_transport(A, B, p, x), group_carrier_transport(A, B, p, y)
  )
)
-> forall iso : GroupIso(
  group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB)
),
(
  forall x : A,
  group_carrier_transport(A, B, p, x) = group_iso_forward(
    group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB), iso, x
  )
)
-> (
  group_iso_center(group_object(A, unitA, multiplyA, lawsA)) = group_iso_point(
    group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB), iso
  )
) {
  exact path_induction(
    U0,
    (
      fun (A : U0) => fun (B : U0) => fun (p : A = B) => forall unitA : A, forall unitB : B,
      forall multiplyA : A -> A -> A, forall multiplyB : B -> B -> B,
      forall lawsA : GroupLaws(A, unitA, multiplyA), forall lawsB : GroupLaws(B, unitB, multiplyB),
      (group_carrier_transport(A, B, p, unitA) = unitB)
      -> (
        forall x : A, forall y : A,
        group_carrier_transport(A, B, p, multiplyA(x, y)) = multiplyB(
          group_carrier_transport(A, B, p, x), group_carrier_transport(A, B, p, y)
        )
      )
      -> forall iso : GroupIso(
        group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB)
      ),
      (
        forall x : A,
        group_carrier_transport(A, B, p, x) = group_iso_forward(
          group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB), iso, x
        )
      )
      -> (
        group_iso_center(group_object(A, unitA, multiplyA, lawsA)) = group_iso_point(
          group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB), iso
        )
      )
    ),
    (
      fun (A : U0) => fun (unitA : A) => fun (unitB : A) => fun (multiplyA : A -> A -> A) => fun (
        multiplyB : A -> A -> A
      ) => fun (lawsA : GroupLaws(A, unitA, multiplyA)) => fun (
        lawsB : GroupLaws(A, unitB, multiplyB)
      ) => fun (sameUnit : unitA = unitB) => fun (
        sameMultiply : (forall x : A, forall y : A, multiplyA(x, y) = multiplyB(x, y))
      ) => group_total_same_carrier(
        A, unitA, unitB, sameUnit, multiplyA, multiplyB,
        FunExt(
          U0, A, (fun (x : A) => A -> A), multiplyA, multiplyB,
          (
            fun (x : A) => FunExt(
              U0, A, (fun (y : A) => A), multiplyA(x), multiplyB(x), sameMultiply(x)
            )
          )
        ), lawsA, lawsB
      )
    ), A, B, p
  );
}

theorem group_objects_iso_total_path(
  A : U0, unitA : A, multiplyA : A -> A -> A, lawsA : GroupLaws(A, unitA, multiplyA), B : U0,
  unitB : B, multiplyB : B -> B -> B, lawsB : GroupLaws(B, unitB, multiplyB), f : A -> B, g : B
  -> A, leftLaw : (forall x : A, g(f(x)) = x), rightLaw : (forall y : B, f(g(y)) = y),
  preserves : (forall x : A, forall y : A, f(multiplyA(x, y)) = multiplyB(f(x), f(y)))
) : group_iso_center(group_object(A, unitA, multiplyA, lawsA)) = group_iso_point(
  group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB),
  typed(
    GroupIso(group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB)),
    (f, g, leftLaw, rightLaw, preserves)
  )
) {
  let bijection = typed(Bijection(A, B), (f, g, leftLaw, rightLaw));
  let equivalence = bijection_equiv(A, B, group_set_law(B, unitB, multiplyB, lawsB), bijection);
  let carrierPath = ua(U0, A, B, equivalence);
  have computes : forall x : A, group_carrier_transport(A, B, carrierPath, x) = f(x) {
    intro x;
    exact UnivalenceBeta(U0, A, B, equivalence, x);
  }
  have unitPath : group_carrier_transport(A, B, carrierPath, unitA) = unitB {
    exact trans(
      computes(unitA),
      group_isomorphism_preserves_unit(
        A, unitA, multiplyA, lawsA, B, unitB, multiplyB, lawsB, f, g, rightLaw, preserves
      )
    );
  }
  have multiplicationPath : forall x : A, forall y : A,
  group_carrier_transport(A, B, carrierPath, multiplyA(x, y)) = multiplyB(
    group_carrier_transport(A, B, carrierPath, x), group_carrier_transport(A, B, carrierPath, y)
  ) {
    intro x;
    intro y;
    exact trans(
      computes(multiplyA(x, y)),
      trans(
        preserves(x, y),
        trans(
          cong((fun (b : B) => multiplyB(b, f(y))), sym(computes(x))),
          cong(multiplyB(group_carrier_transport(A, B, carrierPath, x)), sym(computes(y)))
        )
      )
    );
  }
  exact group_total_transport_path(
    A, B, carrierPath, unitA, unitB, multiplyA, multiplyB, lawsA, lawsB, unitPath,
    multiplicationPath,
    typed(
      GroupIso(group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB)),
      (f, g, leftLaw, rightLaw, preserves)
    ), computes
  );
}

theorem group_objects_iso_total(
  A : U0, unitA : A, multiplyA : A -> A -> A, lawsA : GroupLaws(A, unitA, multiplyA), B : U0,
  unitB : B, multiplyB : B -> B -> B, lawsB : GroupLaws(B, unitB, multiplyB),
  iso : GroupIso(group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB))
) : group_iso_center(group_object(A, unitA, multiplyA, lawsA)) = group_iso_point(
  group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB), iso
) {
  exact pair_induction(
    (
      fun (iso : GroupIsomorphism(A, multiplyA, B, multiplyB)) => group_iso_center(
        group_object(A, unitA, multiplyA, lawsA)
      ) = group_iso_point(
        group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB), iso
      )
    ),
    (
      fun (f : A -> B) => fun (data : GroupMapEvidence(A, multiplyA, B, multiplyB, f)) => pair_induction(
        (
          fun (data : GroupMapEvidence(A, multiplyA, B, multiplyB, f)) => group_iso_center(
            group_object(A, unitA, multiplyA, lawsA)
          ) = group_iso_point(
            group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB),
            typed(GroupIsomorphism(A, multiplyA, B, multiplyB), (f, data))
          )
        ),
        (
          fun (g : B -> A) => fun (conditions : GroupMapLaws(A, multiplyA, B, multiplyB, f, g)) => pair_induction(
            (
              fun (conditions : GroupMapLaws(A, multiplyA, B, multiplyB, f, g)) => group_iso_center(
                group_object(A, unitA, multiplyA, lawsA)
              ) = group_iso_point(
                group_object(A, unitA, multiplyA, lawsA), group_object(B, unitB, multiplyB, lawsB),
                typed(
                  GroupIsomorphism(A, multiplyA, B, multiplyB),
                  (f, typed(GroupMapEvidence(A, multiplyA, B, multiplyB, f), (g, conditions)))
                )
              )
            ),
            (
              fun (leftLaw : LeftLaw(A, B, f, g)) => fun (
                remaining : (
                  RightLaw(A, B, f, g) and GroupMultiplicative(A, multiplyA, B, multiplyB, f)
                )
              ) => pair_induction(
                (
                  fun (
                    remaining : (
                      RightLaw(A, B, f, g) and GroupMultiplicative(A, multiplyA, B, multiplyB, f)
                    )
                  ) => group_iso_center(group_object(A, unitA, multiplyA, lawsA)) = group_iso_point(
                    group_object(A, unitA, multiplyA, lawsA),
                    group_object(B, unitB, multiplyB, lawsB),
                    typed(
                      GroupIsomorphism(A, multiplyA, B, multiplyB),
                      (
                        f,
                        typed(
                          GroupMapEvidence(A, multiplyA, B, multiplyB, f),
                          (
                            g,
                            typed(
                              GroupMapLaws(A, multiplyA, B, multiplyB, f, g), (leftLaw, remaining)
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                (
                  fun (rightLaw : RightLaw(A, B, f, g)) => fun (
                    preserves : GroupMultiplicative(A, multiplyA, B, multiplyB, f)
                  ) => group_objects_iso_total_path(
                    A, unitA, multiplyA, lawsA, B, unitB, multiplyB, lawsB, f, g, leftLaw, rightLaw,
                    preserves
                  )
                ), remaining
              )
            ), conditions
          )
        ), data
      )
    ), iso
  );
}

theorem group_isomorphism_total_contractible(G : Group) : forall H : Group,
forall iso : GroupIso(G, H), group_iso_center(G) = group_iso_point(G, H, iso) {
  exact group_induction(
    (
      fun (G : Group) => forall H : Group, forall iso : GroupIso(G, H),
      group_iso_center(G) = group_iso_point(G, H, iso)
    ),
    (
      fun (A : U0) => fun (unitA : A) => fun (multiplyA : A -> A -> A) => fun (
        lawsA : GroupLaws(A, unitA, multiplyA)
      ) => group_induction(
        (
          fun (H : Group) => forall iso : GroupIso(group_object(A, unitA, multiplyA, lawsA), H),
          group_iso_center(group_object(A, unitA, multiplyA, lawsA)) = group_iso_point(
            group_object(A, unitA, multiplyA, lawsA), H, iso
          )
        ),
        (
          fun (B : U0) => fun (unitB : B) => fun (multiplyB : B -> B -> B) => fun (
            lawsB : GroupLaws(B, unitB, multiplyB)
          ) => group_objects_iso_total(A, unitA, multiplyA, lawsA, B, unitB, multiplyB, lawsB)
        )
      )
    ), G
  );
}
