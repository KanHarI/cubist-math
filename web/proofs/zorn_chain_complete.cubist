import bourbaki_witt;

def OrderMaximal(A : U1, le : OrderRelation(A), x : A) = forall y : A, le(x, y) -> le(y, x);

def StrictlyAbove(A : U1, le : OrderRelation(A), x : A) =
  exists y : A, le(x, y) and (le(y, x) -> Void);

def strict_above_point(A : U1, le : OrderRelation(A), x : A, witness : StrictlyAbove(A, le, x)) =
  field_first(A, (fun (y : A) => typed(U1, le(x, y) and (le(y, x) -> Void))), witness);

def strict_above_laws(A : U1, le : OrderRelation(A), x : A, witness : StrictlyAbove(A, le, x)) =
  field_second(A, (fun (y : A) => typed(U1, le(x, y) and (le(y, x) -> Void))), witness);

def strict_above_is_set(A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le), x : A) :
  FieldSet(StrictlyAbove(A, le, x)) {
  exact field_subtype_is_set(
    A, (fun (y : A) => typed(U1, le(x, y) and (le(y, x) -> Void))),
    partial_order_is_set(A, le, laws),
    (
      fun (y : A) => product_prop(
        le(x, y), (le(y, x) -> Void), order_prop(A, le, laws, x, y), negation_is_prop(le(y, x))
      )
    )
  );
}

// If there is no maximal element, each point merely has a strict successor.
// At this stage there is no selected successor function.
def no_maximal_strict_successor(
  A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le),
  none : FieldExists(exists x : A, OrderMaximal(A, le, x)) -> Void, x : A
) :
  FieldExists(StrictlyAbove(A, le, x)) {
  have contradiction : (FieldExists(StrictlyAbove(A, le, x)) -> Void) -> Void {
    intro noSuccessor;
    have maximal : OrderMaximal(A, le, x) {
      intro y;
      intro xy;
      exact double_negation(
        le(y, x), order_prop(A, le, laws, y, x),
        (
          fun (strict : le(y, x) -> Void) => noSuccessor(
            field_exists_intro(StrictlyAbove(A, le, x), (y, xy, strict))
          )
        )
      );
    }
    exact none(field_exists_intro((exists a : A, OrderMaximal(A, le, a)), (x, maximal)));
  }
  exact double_negation(
    FieldExists(StrictlyAbove(A, le, x)), field_exists_prop(StrictlyAbove(A, le, x)), contradiction
  );
}

// A selected strict-successor function contradicts the fixed-point theorem.
def no_strict_successor_function(
  A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le), complete : ChainComplete(A, le),
  choose : (forall x : A, StrictlyAbove(A, le, x))
) :
  Void {
  let f = fun (x : A) => strict_above_point(A, le, x, choose(x));
  have progressive : Progressive(A, le, f) {
    intro x;
    obtain (above, strict) = strict_above_laws(A, le, x, choose(x));
    exact above;
  }
  obtain (x, fixed) = bourbaki_witt(A, le, laws, complete, f, progressive);
  obtain (above, strict) = strict_above_laws(A, le, x, choose(x));
  exact strict(transport(le(f(x)), f(x), x, fixed, order_refl(A, le, laws, f(x))));
}

// The chain-complete form of Zorn, derived from Choice(U1) and LEM.
// Choice is applied only to sets, and its merely selected function is
// eliminated into Void. No maximality or fixed-point axiom is introduced.
def zorn_chain_complete(
  A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le), complete : ChainComplete(A, le)
) :
  FieldExists(exists x : A, OrderMaximal(A, le, x)) {
  let Result = exists x : A, OrderMaximal(A, le, x);
  have contradiction : (FieldExists(Result) -> Void) -> Void {
    intro none;
    let successors =
      Choice(
        U1, A, StrictlyAbove(A, le), partial_order_is_set(A, le, laws),
        strict_above_is_set(A, le, laws), no_maximal_strict_successor(A, le, laws, none)
      );
    exact field_exists_elim(
      (forall x : A, StrictlyAbove(A, le, x)), Void,
      (fun (p : Void) => fun (q : Void) => typed((p = q), absurd(p))),
      no_strict_successor_function(A, le, laws, complete), successors
    );
  }
  exact double_negation(FieldExists(Result), field_exists_prop(Result), contradiction);
}
