import ring_laws;

// Coordinate identities for the complex multiplication formula.
// Every normalization step below is an application of a proved ring law.

theorem complex_coordinate_assoc_real(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, c : F, d : F, e : F, f : F
) : addF(mulF(addF(mulF(a, c), negF(mulF(b, d))), e), negF(mulF(addF(mulF(a, d), mulF(b, c)), f))) = addF(
  mulF(a, addF(mulF(c, e), negF(mulF(d, f)))), negF(mulF(b, addF(mulF(c, f), mulF(d, e))))
) {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(addF(mulF(a, d), mulF(b, c)), f)))),
      ring_distribute_left(F, zero, one, addF, mulF, negF, ring, mulF(a, c), negF(mulF(b, d)), e)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(addF(mulF(a, d), mulF(b, c)), f)))),
      cong(
        (fun (value : F) => addF(value, mulF(negF(mulF(b, d)), e))),
        ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, a, c, e)
      )
    );
  let leftStep3 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(addF(mulF(a, d), mulF(b, c)), f)))),
      cong(
        (fun (value : F) => addF(mulF(a, mulF(c, e)), value)),
        ring_neg_mul(F, zero, one, addF, mulF, negF, ring, mulF(b, d), e)
      )
    );
  let leftStep4 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(addF(mulF(a, d), mulF(b, c)), f)))),
      cong(
        (fun (value : F) => addF(mulF(a, mulF(c, e)), value)),
        cong(
          (fun (value : F) => negF(value)),
          ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, b, d, e)
        )
      )
    );
  let leftStep5 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, e)), negF(mulF(b, mulF(d, e)))), value)),
      cong(
        (fun (value : F) => negF(value)),
        ring_distribute_left(F, zero, one, addF, mulF, negF, ring, mulF(a, d), mulF(b, c), f)
      )
    );
  let leftStep6 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, e)), negF(mulF(b, mulF(d, e)))), value)),
      cong(
        (fun (value : F) => negF(value)),
        cong(
          (fun (value : F) => addF(value, mulF(mulF(b, c), f))),
          ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, a, d, f)
        )
      )
    );
  let leftStep7 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, e)), negF(mulF(b, mulF(d, e)))), value)),
      cong(
        (fun (value : F) => negF(value)),
        cong(
          (fun (value : F) => addF(mulF(a, mulF(d, f)), value)),
          ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, b, c, f)
        )
      )
    );
  let leftStep8 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, e)), negF(mulF(b, mulF(d, e)))), value)),
      ring_neg_add(F, zero, one, addF, mulF, negF, ring, mulF(a, mulF(d, f)), mulF(b, mulF(c, f)))
    );
  let leftStep9 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, mulF(c, e)), negF(mulF(b, mulF(d, e))),
      addF(negF(mulF(a, mulF(d, f))), negF(mulF(b, mulF(c, f))))
    );
  let leftStep10 =
    cong(
      (fun (value : F) => addF(mulF(a, mulF(c, e)), value)),
      ring_add_swap(
        F, zero, one, addF, mulF, negF, ring, negF(mulF(b, mulF(d, e))), negF(mulF(a, mulF(d, f))),
        negF(mulF(b, mulF(c, f)))
      )
    );
  let leftStep11 =
    cong(
      (fun (value : F) => addF(mulF(a, mulF(c, e)), value)),
      cong(
        (fun (value : F) => addF(negF(mulF(a, mulF(d, f))), value)),
        ring_add_comm(
          F, zero, one, addF, mulF, negF, ring, negF(mulF(b, mulF(d, e))), negF(mulF(b, mulF(c, f)))
        )
      )
    );
  let rightStep1 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(b, addF(mulF(c, f), mulF(d, e)))))),
      ring_distribute(F, zero, one, addF, mulF, negF, ring, a, mulF(c, e), negF(mulF(d, f)))
    );
  let rightStep2 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(b, addF(mulF(c, f), mulF(d, e)))))),
      cong(
        (fun (value : F) => addF(mulF(a, mulF(c, e)), value)),
        ring_mul_neg(F, zero, one, addF, mulF, negF, ring, a, mulF(d, f))
      )
    );
  let rightStep3 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, e)), negF(mulF(a, mulF(d, f)))), value)),
      cong(
        (fun (value : F) => negF(value)),
        ring_distribute(F, zero, one, addF, mulF, negF, ring, b, mulF(c, f), mulF(d, e))
      )
    );
  let rightStep4 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, e)), negF(mulF(a, mulF(d, f)))), value)),
      ring_neg_add(F, zero, one, addF, mulF, negF, ring, mulF(b, mulF(c, f)), mulF(b, mulF(d, e)))
    );
  let rightStep5 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, mulF(c, e)), negF(mulF(a, mulF(d, f))),
      addF(negF(mulF(b, mulF(c, f))), negF(mulF(b, mulF(d, e))))
    );
  exact trans(
    trans(
      leftStep1,
      trans(
        leftStep2,
        trans(
          leftStep3,
          trans(
            leftStep4,
            trans(
              leftStep5,
              trans(
                leftStep6,
                trans(leftStep7, trans(leftStep8, trans(leftStep9, trans(leftStep10, leftStep11))))
              )
            )
          )
        )
      )
    ), sym(trans(rightStep1, trans(rightStep2, trans(rightStep3, trans(rightStep4, rightStep5)))))
  );
}

theorem complex_coordinate_assoc_imag(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, c : F, d : F, e : F, f : F
) : addF(mulF(addF(mulF(a, c), negF(mulF(b, d))), f), mulF(addF(mulF(a, d), mulF(b, c)), e)) = addF(
  mulF(a, addF(mulF(c, f), mulF(d, e))), mulF(b, addF(mulF(c, e), negF(mulF(d, f))))
) {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(addF(mulF(a, d), mulF(b, c)), e))),
      ring_distribute_left(F, zero, one, addF, mulF, negF, ring, mulF(a, c), negF(mulF(b, d)), f)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(value, mulF(addF(mulF(a, d), mulF(b, c)), e))),
      cong(
        (fun (value : F) => addF(value, mulF(negF(mulF(b, d)), f))),
        ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, a, c, f)
      )
    );
  let leftStep3 =
    cong(
      (fun (value : F) => addF(value, mulF(addF(mulF(a, d), mulF(b, c)), e))),
      cong(
        (fun (value : F) => addF(mulF(a, mulF(c, f)), value)),
        ring_neg_mul(F, zero, one, addF, mulF, negF, ring, mulF(b, d), f)
      )
    );
  let leftStep4 =
    cong(
      (fun (value : F) => addF(value, mulF(addF(mulF(a, d), mulF(b, c)), e))),
      cong(
        (fun (value : F) => addF(mulF(a, mulF(c, f)), value)),
        cong(
          (fun (value : F) => negF(value)),
          ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, b, d, f)
        )
      )
    );
  let leftStep5 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, f)), negF(mulF(b, mulF(d, f)))), value)),
      ring_distribute_left(F, zero, one, addF, mulF, negF, ring, mulF(a, d), mulF(b, c), e)
    );
  let leftStep6 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, f)), negF(mulF(b, mulF(d, f)))), value)),
      cong(
        (fun (value : F) => addF(value, mulF(mulF(b, c), e))),
        ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, a, d, e)
      )
    );
  let leftStep7 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, f)), negF(mulF(b, mulF(d, f)))), value)),
      cong(
        (fun (value : F) => addF(mulF(a, mulF(d, e)), value)),
        ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, b, c, e)
      )
    );
  let leftStep8 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, mulF(c, f)), negF(mulF(b, mulF(d, f))),
      addF(mulF(a, mulF(d, e)), mulF(b, mulF(c, e)))
    );
  let leftStep9 =
    cong(
      (fun (value : F) => addF(mulF(a, mulF(c, f)), value)),
      ring_add_swap(
        F, zero, one, addF, mulF, negF, ring, negF(mulF(b, mulF(d, f))), mulF(a, mulF(d, e)),
        mulF(b, mulF(c, e))
      )
    );
  let leftStep10 =
    cong(
      (fun (value : F) => addF(mulF(a, mulF(c, f)), value)),
      cong(
        (fun (value : F) => addF(mulF(a, mulF(d, e)), value)),
        ring_add_comm(
          F, zero, one, addF, mulF, negF, ring, negF(mulF(b, mulF(d, f))), mulF(b, mulF(c, e))
        )
      )
    );
  let rightStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(b, addF(mulF(c, e), negF(mulF(d, f)))))),
      ring_distribute(F, zero, one, addF, mulF, negF, ring, a, mulF(c, f), mulF(d, e))
    );
  let rightStep2 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, f)), mulF(a, mulF(d, e))), value)),
      ring_distribute(F, zero, one, addF, mulF, negF, ring, b, mulF(c, e), negF(mulF(d, f)))
    );
  let rightStep3 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, mulF(c, f)), mulF(a, mulF(d, e))), value)),
      cong(
        (fun (value : F) => addF(mulF(b, mulF(c, e)), value)),
        ring_mul_neg(F, zero, one, addF, mulF, negF, ring, b, mulF(d, f))
      )
    );
  let rightStep4 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, mulF(c, f)), mulF(a, mulF(d, e)),
      addF(mulF(b, mulF(c, e)), negF(mulF(b, mulF(d, f))))
    );
  exact trans(
    trans(
      leftStep1,
      trans(
        leftStep2,
        trans(
          leftStep3,
          trans(
            leftStep4,
            trans(
              leftStep5,
              trans(leftStep6, trans(leftStep7, trans(leftStep8, trans(leftStep9, leftStep10))))
            )
          )
        )
      )
    ), sym(trans(rightStep1, trans(rightStep2, trans(rightStep3, rightStep4))))
  );
}

theorem complex_coordinate_distribute_real(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, c : F, d : F, e : F, f : F
) : addF(mulF(a, addF(c, e)), negF(mulF(b, addF(d, f)))) = addF(
  addF(mulF(a, c), negF(mulF(b, d))), addF(mulF(a, e), negF(mulF(b, f)))
) {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(b, addF(d, f))))),
      ring_distribute(F, zero, one, addF, mulF, negF, ring, a, c, e)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, c), mulF(a, e)), value)),
      cong(
        (fun (value : F) => negF(value)),
        ring_distribute(F, zero, one, addF, mulF, negF, ring, b, d, f)
      )
    );
  let leftStep3 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, c), mulF(a, e)), value)),
      ring_neg_add(F, zero, one, addF, mulF, negF, ring, mulF(b, d), mulF(b, f))
    );
  let leftStep4 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, c), mulF(a, e),
      addF(negF(mulF(b, d)), negF(mulF(b, f)))
    );
  let rightStep1 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, c), negF(mulF(b, d)),
      addF(mulF(a, e), negF(mulF(b, f)))
    );
  let rightStep2 =
    cong(
      (fun (value : F) => addF(mulF(a, c), value)),
      ring_add_swap(
        F, zero, one, addF, mulF, negF, ring, negF(mulF(b, d)), mulF(a, e), negF(mulF(b, f))
      )
    );
  exact trans(
    trans(leftStep1, trans(leftStep2, trans(leftStep3, leftStep4))),
    sym(trans(rightStep1, rightStep2))
  );
}

theorem complex_coordinate_distribute_imag(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, c : F, d : F, e : F, f : F
) : addF(mulF(a, addF(d, f)), mulF(b, addF(c, e))) = addF(
  addF(mulF(a, d), mulF(b, c)), addF(mulF(a, f), mulF(b, e))
) {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(b, addF(c, e)))),
      ring_distribute(F, zero, one, addF, mulF, negF, ring, a, d, f)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(addF(mulF(a, d), mulF(a, f)), value)),
      ring_distribute(F, zero, one, addF, mulF, negF, ring, b, c, e)
    );
  let leftStep3 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, d), mulF(a, f), addF(mulF(b, c), mulF(b, e))
    );
  let rightStep1 =
    ring_add_assoc(
      F, zero, one, addF, mulF, negF, ring, mulF(a, d), mulF(b, c), addF(mulF(a, f), mulF(b, e))
    );
  let rightStep2 =
    cong(
      (fun (value : F) => addF(mulF(a, d), value)),
      ring_add_swap(F, zero, one, addF, mulF, negF, ring, mulF(b, c), mulF(a, f), mulF(b, e))
    );
  exact trans(trans(leftStep1, trans(leftStep2, leftStep3)), sym(trans(rightStep1, rightStep2)));
}

theorem complex_coordinate_comm_real(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, c : F, d : F
) : addF(mulF(a, c), negF(mulF(b, d))) = addF(mulF(c, a), negF(mulF(d, b))) {
  let rightStep1 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(d, b)))),
      ring_mul_comm(F, zero, one, addF, mulF, negF, ring, c, a)
    );
  let rightStep2 =
    cong(
      (fun (value : F) => addF(mulF(a, c), value)),
      cong(
        (fun (value : F) => negF(value)), ring_mul_comm(F, zero, one, addF, mulF, negF, ring, d, b)
      )
    );
  exact trans(refl(addF(mulF(a, c), negF(mulF(b, d)))), sym(trans(rightStep1, rightStep2)));
}

theorem complex_coordinate_comm_imag(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, c : F, d : F
) : addF(mulF(a, d), mulF(b, c)) = addF(mulF(c, b), mulF(d, a)) {
  let rightStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(d, a))),
      ring_mul_comm(F, zero, one, addF, mulF, negF, ring, c, b)
    );
  let rightStep2 =
    cong(
      (fun (value : F) => addF(mulF(b, c), value)),
      ring_mul_comm(F, zero, one, addF, mulF, negF, ring, d, a)
    );
  let rightStep3 = ring_add_comm(F, zero, one, addF, mulF, negF, ring, mulF(b, c), mulF(a, d));
  exact trans(
    refl(addF(mulF(a, d), mulF(b, c))), sym(trans(rightStep1, trans(rightStep2, rightStep3)))
  );
}

theorem complex_coordinate_one_real(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F
) : addF(mulF(one, a), negF(mulF(zero, b))) = a {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(zero, b)))),
      ring_mul_one(F, zero, one, addF, mulF, negF, ring, a)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(a, value)),
      cong((fun (value : F) => negF(value)), ring_zero_mul(F, zero, one, addF, mulF, negF, ring, b))
    );
  let leftStep3 =
    cong((fun (value : F) => addF(a, value)), ring_neg_zero(F, zero, one, addF, mulF, negF, ring));
  let leftStep4 = ring_add_zero_right(F, zero, one, addF, mulF, negF, ring, a);
  exact trans(trans(leftStep1, trans(leftStep2, trans(leftStep3, leftStep4))), sym(refl(a)));
}

theorem complex_coordinate_one_imag(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F
) : addF(mulF(one, b), mulF(zero, a)) = b {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(zero, a))),
      ring_mul_one(F, zero, one, addF, mulF, negF, ring, b)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(b, value)), ring_zero_mul(F, zero, one, addF, mulF, negF, ring, a)
    );
  let leftStep3 = ring_add_zero_right(F, zero, one, addF, mulF, negF, ring, b);
  exact trans(trans(leftStep1, trans(leftStep2, leftStep3)), sym(refl(b)));
}

theorem complex_coordinate_i_square_real(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF)
) : addF(mulF(zero, zero), negF(mulF(one, one))) = negF(one) {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, negF(mulF(one, one)))),
      ring_zero_mul(F, zero, one, addF, mulF, negF, ring, zero)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(zero, value)),
      cong(
        (fun (value : F) => negF(value)), ring_mul_one(F, zero, one, addF, mulF, negF, ring, one)
      )
    );
  let leftStep3 = ring_add_zero(F, zero, one, addF, mulF, negF, ring, negF(one));
  exact trans(trans(leftStep1, trans(leftStep2, leftStep3)), sym(refl(negF(one))));
}

theorem complex_coordinate_i_square_imag(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF)
) : addF(mulF(zero, one), mulF(one, zero)) = zero {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(one, zero))),
      ring_zero_mul(F, zero, one, addF, mulF, negF, ring, one)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(zero, value)),
      ring_mul_zero(F, zero, one, addF, mulF, negF, ring, one)
    );
  let leftStep3 = ring_add_zero(F, zero, one, addF, mulF, negF, ring, zero);
  exact trans(trans(leftStep1, trans(leftStep2, leftStep3)), sym(refl(zero)));
}

theorem complex_coordinate_norm_real(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F
) : addF(mulF(a, a), negF(mulF(b, negF(b)))) = addF(mulF(a, a), mulF(b, b)) {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(mulF(a, a), value)),
      cong(
        (fun (value : F) => negF(value)), ring_mul_neg(F, zero, one, addF, mulF, negF, ring, b, b)
      )
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(mulF(a, a), value)),
      ring_neg_neg(F, zero, one, addF, mulF, negF, ring, mulF(b, b))
    );
  exact trans(trans(leftStep1, leftStep2), sym(refl(addF(mulF(a, a), mulF(b, b)))));
}

theorem complex_coordinate_norm_imag(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F
) : addF(mulF(a, negF(b)), mulF(b, a)) = zero {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(b, a))),
      ring_mul_neg(F, zero, one, addF, mulF, negF, ring, a, b)
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(negF(mulF(a, b)), value)),
      ring_mul_comm(F, zero, one, addF, mulF, negF, ring, b, a)
    );
  let leftStep3 = ring_add_inverse(F, zero, one, addF, mulF, negF, ring, mulF(a, b));
  exact trans(trans(leftStep1, trans(leftStep2, leftStep3)), sym(refl(zero)));
}

theorem complex_coordinate_inverse_real(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, d : F
) : addF(mulF(a, mulF(a, d)), negF(mulF(b, negF(mulF(b, d))))) = mulF(
  addF(mulF(a, a), mulF(b, b)), d
) {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(mulF(a, mulF(a, d)), value)),
      cong(
        (fun (value : F) => negF(value)),
        ring_mul_neg(F, zero, one, addF, mulF, negF, ring, b, mulF(b, d))
      )
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(mulF(a, mulF(a, d)), value)),
      ring_neg_neg(F, zero, one, addF, mulF, negF, ring, mulF(b, mulF(b, d)))
    );
  let rightStep1 =
    ring_distribute_left(F, zero, one, addF, mulF, negF, ring, mulF(a, a), mulF(b, b), d);
  let rightStep2 =
    cong(
      (fun (value : F) => addF(value, mulF(mulF(b, b), d))),
      ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, a, a, d)
    );
  let rightStep3 =
    cong(
      (fun (value : F) => addF(mulF(a, mulF(a, d)), value)),
      ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, b, b, d)
    );
  exact trans(trans(leftStep1, leftStep2), sym(trans(rightStep1, trans(rightStep2, rightStep3))));
}

theorem complex_coordinate_inverse_imag(
  F : U1, zero : F, one : F, addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a : F, b : F, d : F
) : addF(mulF(a, negF(mulF(b, d))), mulF(b, mulF(a, d))) = zero {
  let leftStep1 =
    cong(
      (fun (value : F) => addF(value, mulF(b, mulF(a, d)))),
      ring_mul_neg(F, zero, one, addF, mulF, negF, ring, a, mulF(b, d))
    );
  let leftStep2 =
    cong(
      (fun (value : F) => addF(negF(mulF(a, mulF(b, d))), value)),
      ring_mul_swap(F, zero, one, addF, mulF, negF, ring, b, a, d)
    );
  let leftStep3 = ring_add_inverse(F, zero, one, addF, mulF, negF, ring, mulF(a, mulF(b, d)));
  exact trans(trans(leftStep1, trans(leftStep2, leftStep3)), sym(refl(zero)));
}
