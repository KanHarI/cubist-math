import circle;
import group_univalence;

// The existing winding isomorphism now gives a path in the type of groups.
def CircleLoopGroup = group_object(LoopsS1, refl(base), loop_multiply, loop_group);

def IntegerGroup = group_object(Z, zeroZ, addZ, integer_group);

// Winding number is a group isomorphism from the circle's loops to the integers.
// Its inverse sends an integer to that many turns around the circle.
def circle_group_isomorphism : GroupIso(CircleLoopGroup, IntegerGroup) {
  exact (winding, integer_loop, integer_loop_winding, winding_integer_loop, winding_concatenate);
}

def circle_group_identification : CircleLoopGroup =[Group] IntegerGroup {
  exact group_isotoid(CircleLoopGroup, IntegerGroup, circle_group_isomorphism);
}

// The circle's fundamental group equals the additive group of integers in Group.
// This equality identifies the complete group structures via the winding isomorphism.
def circle_loop_group_equals_integers : CircleLoopGroup =[Group] IntegerGroup {
  exact circle_group_identification;
}

// Reading that equality as an isomorphism recovers the original winding map.
def circle_group_identification_recovers_winding :
  group_idtoiso(CircleLoopGroup, IntegerGroup, circle_group_identification) = circle_group_isomorphism {
  exact group_idtoiso_isotoid(CircleLoopGroup, IntegerGroup, circle_group_isomorphism);
}
