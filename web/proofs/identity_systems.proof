import field_extensionality;
import homotopy_paths;

// Based path induction with a Type1-valued motive.
def higher_based_induction(A : Type1, origin : A,
  C : (forall x : A, (origin = x) -> Type1), c : C(origin, refl(origin)), x : A, p : origin = x) =
  path_induction(A,
    (fun (a : A) => fun (b : A) => fun (q : a = b) =>
      forall D : (forall point : A, (a = point) -> Type1), D(a, refl(a)) -> D(b, q)),
    (fun (a : A) => fun (D : (forall point : A, (a = point) -> Type1)) => fun (d : D(a, refl(a))) => d), origin, x, p)(C, c);

// A reusable Type1 version of the identity-system argument.
def IdentityTotal(A : Type1, R : A -> Type1) = exists b : A, R(b);
def identity_total_point(A : Type1, R : A -> Type1, b : A, r : R(b)) = typed(IdentityTotal(A, R), (b, r));
def identity_system_decode(A : Type1, a : A, R : A -> Type1, r0 : R(a), b : A, p : a = b) = transport(R, a, b, p, r0);
def identity_system_encode(A : Type1, a : A, R : A -> Type1, r0 : R(a),
  contraction : (forall z : IdentityTotal(A, R), identity_total_point(A, R, a, r0) = z), b : A, r : R(b)) =
  cong(field_first(A, R), contraction(identity_total_point(A, R, b, r)));

theorem identity_total_second_path(A : Type1, R : A -> Type1,
  x : IdentityTotal(A, R), y : IdentityTotal(A, R), p : x = y) :
  transport(R, field_first(A, R, x), field_first(A, R, y), cong(field_first(A, R), p), field_second(A, R, x)) = field_second(A, R, y) {
  exact path_induction(IdentityTotal(A, R),
    (fun (x : IdentityTotal(A, R)) => fun (y : IdentityTotal(A, R)) => fun (p : x = y) =>
      transport(R, field_first(A, R, x), field_first(A, R, y), cong(field_first(A, R), p), field_second(A, R, x)) = field_second(A, R, y)),
    (fun (x : IdentityTotal(A, R)) => refl(field_second(A, R, x))), x, y, p);
}

theorem identity_system_section(A : Type1, a : A, R : A -> Type1, r0 : R(a),
  contraction : (forall z : IdentityTotal(A, R), identity_total_point(A, R, a, r0) = z), b : A, r : R(b)) :
  identity_system_decode(A, a, R, r0, b, identity_system_encode(A, a, R, r0, contraction, b, r)) = r {
  exact identity_total_second_path(A, R, identity_total_point(A, R, a, r0), identity_total_point(A, R, b, r), contraction(identity_total_point(A, R, b, r)));
}

theorem identity_system_retraction(A : Type1, a : A, R : A -> Type1, r0 : R(a),
  contraction : (forall z : IdentityTotal(A, R), identity_total_point(A, R, a, r0) = z), b : A, p : a = b) :
  identity_system_encode(A, a, R, r0, contraction, b, identity_system_decode(A, a, R, r0, b, p)) = p {
  let center = identity_total_point(A, R, a, r0);
  have atCenter : contraction(center) = refl(center) {
    exact contractible_loops_are_null(IdentityTotal(A, R), center, (fun (z : IdentityTotal(A, R)) => sym(contraction(z))), center, contraction(center));
  }
  exact higher_based_induction(A, a,
    (fun (b : A) => fun (p : a = b) => identity_system_encode(A, a, R, r0, contraction, b, identity_system_decode(A, a, R, r0, b, p)) = p),
    cong((fun (q : center = center) => cong(field_first(A, R), q)), atCenter), b, p);
}

// Higher-universe equivalences use exactly the same half-adjoint data as Equiv.
def HigherIsEquiv(A : Type1, B : Type1, f : A -> B) =
  exists g : B -> A, exists eta : (forall x : A, g(f(x)) = x),
  exists eps : (forall y : B, f(g(y)) = y),
  forall x : A, ap(A, B, f, g(f(x)), x, eta(x)) = eps(f(x));
def HigherEquiv(A : Type1, B : Type1) = exists f : A -> B, HigherIsEquiv(A, B, f);

theorem identity_system_equivalence(A : Type1, a : A, R : A -> Type1, r0 : R(a),
  contraction : (forall z : IdentityTotal(A, R), identity_total_point(A, R, a, r0) = z),
  b : A, setR : FieldSet(R(b))) : HigherEquiv((a = b), R(b)) {
  let f = identity_system_decode(A, a, R, r0, b);
  let g = identity_system_encode(A, a, R, r0, contraction, b);
  let eta = identity_system_retraction(A, a, R, r0, contraction, b);
  let eps = identity_system_section(A, a, R, r0, contraction, b);
  exact (f, (g, (eta, (eps,
    (fun (p : a = b) => setR(f(g(f(p))), f(p), ap((a = b), R(b), f, g(f(p)), p, eta(p)), eps(f(p))))))));
}

// The weakly constant path-map form of Hedberg's argument.
theorem constant_path_correction(A : Type1,
  choose : (forall x : A, forall y : A, (x = y) -> (x = y)), x : A, y : A, p : x = y) :
  concatenate(A, x, x, y, inverse(A, x, x, choose(x, x, refl(x))), choose(x, y, p)) = p {
  exact higher_based_induction(A, x,
    (fun (y : A) => fun (p : x = y) =>
      concatenate(A, x, x, y, inverse(A, x, x, choose(x, x, refl(x))), choose(x, y, p)) = p),
    inverse_left(A, x, x, choose(x, x, refl(x))), y, p);
}
theorem constant_paths_are_set(A : Type1,
  choose : (forall x : A, forall y : A, (x = y) -> (x = y)),
  constant : (forall x : A, forall y : A, forall p : x = y, forall q : x = y, choose(x, y, p) = choose(x, y, q))) : FieldSet(A) {
  intro x; intro y; intro p; intro q;
  exact trans(sym(constant_path_correction(A, choose, x, y, p)),
    trans(cong((fun (r : x = y) => concatenate(A, x, x, y, inverse(A, x, x, choose(x, x, refl(x))), r)), constant(x, y, p, q)),
      constant_path_correction(A, choose, x, y, q)));
}
