import embedded_composita;

// Fixed-universe scope: fields have carriers in U0; bundled fields and
// extensions lie in U1. Membership may be a proposition in U1. This leaves
// room for algebraic properties without asserting propositional resizing.
def ExtensionClass = forall K : AlgebraicField, FieldExt(K) -> U1;

def ExtensionClassProp(C : ExtensionClass) =
  forall K : AlgebraicField, forall E : FieldExt(K), FieldProp(C(K, E));

def ExtensionMember(
  C : ExtensionClass, K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L)
) =
  C(K, embedding_as_extension(K, L, e));

// Isomorphism invariance comes from transport on the univalent extension
// type. It is not an extra law imposed on each class of extensions.
def extension_class_iso(
  C : ExtensionClass, K : AlgebraicField, E : FieldExt(K), F : FieldExt(K),
  e : ExtensionIso(K, E, F), member : C(K, E)
) :
  C(K, F) {
  exact transport(C(K), E, F, extension_iso_path(K, E, F, e), member);
}

def extension_class_iso_iff(
  C : ExtensionClass, K : AlgebraicField, E : FieldExt(K), F : FieldExt(K),
  e : ExtensionIso(K, E, F)
) :
  FieldIff(C(K, E), C(K, F)) {
  let path = extension_iso_path(K, E, F, e);
  exact (
    (fun (member : C(K, E)) => transport(C(K), E, F, path, member)),
    (fun (member : C(K, F)) => transport(C(K), F, E, sym(path), member))
  );
}

// Lang's first condition is an iff along a specified commutative tower.
def DistinguishedTower(C : ExtensionClass) =
  forall B : AlgebraicField, forall K : AlgebraicField, forall L : AlgebraicField,
  forall bk : FieldEmbedding(B, K), forall kl : FieldEmbedding(K, L),
  forall bl : FieldEmbedding(B, L), FieldTower(B, K, L, bk, kl, bl)
  -> FieldIff(
    ExtensionMember(C, B, L, bl), ExtensionMember(C, B, K, bk) and ExtensionMember(C, K, L, kl)
  );

// Lang's second condition is base change inside a specified common field.
// No tensor-product field or unspecified choice of embeddings is assumed.
def DistinguishedBaseChange(C : ExtensionClass) =
  forall B : AlgebraicField, forall K : AlgebraicField, forall L : AlgebraicField,
  forall O : AlgebraicField, forall bk : FieldEmbedding(B, K), forall bl : FieldEmbedding(B, L),
  forall bo : FieldEmbedding(B, O), forall ko : FieldEmbedding(K, O),
  forall lo : FieldEmbedding(L, O), FieldTower(B, K, O, bk, ko, bo)
  -> FieldTower(B, L, O, bl, lo, bo) -> ExtensionMember(C, B, K, bk)
  -> ExtensionMember(
    C, L, EmbeddedCompositum(K, L, O, ko, lo), embedded_compositum_right(K, L, O, ko, lo)
  );

// Lang's third condition keeps the original base and forms the compositum.
def DistinguishedComposita(C : ExtensionClass) =
  forall B : AlgebraicField, forall K : AlgebraicField, forall L : AlgebraicField,
  forall O : AlgebraicField, forall bk : FieldEmbedding(B, K), forall bl : FieldEmbedding(B, L),
  forall bo : FieldEmbedding(B, O), forall ko : FieldEmbedding(K, O),
  forall lo : FieldEmbedding(L, O), FieldTower(B, K, O, bk, ko, bo)
  -> FieldTower(B, L, O, bl, lo, bo) -> ExtensionMember(C, B, K, bk) -> ExtensionMember(C, B, L, bl)
  -> ExtensionMember(
    C, B, EmbeddedCompositum(K, L, O, ko, lo), embedded_compositum_base(B, K, L, O, bk, ko, lo)
  );

// Expose all three clauses of Lang's definition, and require membership to
// be propositional. Chosen bases and splitting witnesses are separate data.
def Distinguished(C : ExtensionClass) =
  ExtensionClassProp(C) and DistinguishedTower(C) and DistinguishedBaseChange(C)
  and DistinguishedComposita(C);

// The third clause follows from the first two. The common-base agreement
// is essential when applying the tower criterion through the right factor.
def distinguished_composita_from_tower_base_change(
  C : ExtensionClass, towerLaw : DistinguishedTower(C), baseChange : DistinguishedBaseChange(C)
) :
  DistinguishedComposita(C) {
  intro B;
  intro K;
  intro L;
  intro O;
  intro bk;
  intro bl;
  intro bo;
  intro ko;
  intro lo;
  intro leftTower;
  intro rightTower;
  intro inK;
  intro inL;
  let M = EmbeddedCompositum(K, L, O, ko, lo);
  let lm = embedded_compositum_right(K, L, O, ko, lo);
  let bm = embedded_compositum_base(B, K, L, O, bk, ko, lo);
  let commute =
    sym(embedded_compositum_base_agreement(B, K, L, O, bk, bl, bo, ko, lo, leftTower, rightTower));
  let inLM = baseChange(B, K, L, O, bk, bl, bo, ko, lo, leftTower, rightTower, inK);
  obtain (decompose, combine) = typed(
    FieldIff(
      ExtensionMember(C, B, M, bm), ExtensionMember(C, B, L, bl) and ExtensionMember(C, L, M, lm)
    ), towerLaw(B, L, M, bl, lm, bm, commute)
  );
  exact combine(typed((ExtensionMember(C, B, L, bl) and ExtensionMember(C, L, M, lm)), (inL, inLM)));
}

def distinguished_from_tower_base_change(
  C : ExtensionClass, prop : ExtensionClassProp(C), towerLaw : DistinguishedTower(C),
  baseChange : DistinguishedBaseChange(C)
) :
  Distinguished(C) {
  exact (
    prop, towerLaw, baseChange,
    distinguished_composita_from_tower_base_change(C, towerLaw, baseChange)
  );
}
