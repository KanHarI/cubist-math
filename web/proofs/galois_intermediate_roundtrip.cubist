import galois_normal_target;
import finite_equal_dimension;
import galois_orders;
import artin_degree;
import artin_classification;
import equivalence_from_inverse;
import finite_decidable_subtypes;

def intermediate_inclusion_embedding(
  K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E), N : IntermediateField(K, E),
  included : IntermediateIncluded(K, E, M, N)
) :
  FieldEmbedding(intermediate_as_field(K, E, M), intermediate_as_field(K, E, N)) {
  let F = extension_field(K, E);
  let S = intermediate_subfield(K, E, M);
  exact field_embedding_factor(
    intermediate_as_field(K, E, M), F, intermediate_ambient_embedding(K, E, M),
    intermediate_subfield(K, E, N),
    (
      fun (a : af_carrier(intermediate_as_field(K, E, M))) => included(
        subfield_value(F, S, a), subfield_evidence(F, S, a)
      )
    )
  );
}

def intermediate_inclusion_triangle(
  K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E), N : IntermediateField(K, E),
  included : IntermediateIncluded(K, E, M, N)
) :
  FieldTower(
    intermediate_as_field(K, E, M), intermediate_as_field(K, E, N), extension_field(K, E),
    intermediate_inclusion_embedding(K, E, M, N, included), intermediate_ambient_embedding(K, E, N),
    intermediate_ambient_embedding(K, E, M)
  ) {
  let F = extension_field(K, E);
  let S = intermediate_subfield(K, E, M);
  exact field_embedding_factor_triangle(
    intermediate_as_field(K, E, M), F, intermediate_ambient_embedding(K, E, M),
    intermediate_subfield(K, E, N),
    (
      fun (a : af_carrier(intermediate_as_field(K, E, M))) => included(
        subfield_value(F, S, a), subfield_evidence(F, S, a)
      )
    )
  );
}

def intermediate_inclusion_surjective_equal(
  K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E), N : IntermediateField(K, E),
  included : IntermediateIncluded(K, E, M, N),
  onto : Surjective(
    af_carrier(intermediate_as_field(K, E, M)), af_carrier(intermediate_as_field(K, E, N)),
    field_embedding_map(
      intermediate_as_field(K, E, M), intermediate_as_field(K, E, N),
      intermediate_inclusion_embedding(K, E, M, N, included)
    )
  )
) :
  M =[IntermediateField(K, E)] N {
  let F = extension_field(K, E);
  let S = intermediate_subfield(K, E, M);
  let T = intermediate_subfield(K, E, N);
  let R = intermediate_as_field(K, E, M);
  let Q = intermediate_as_field(K, E, N);
  let i = intermediate_inclusion_embedding(K, E, M, N, included);
  have reverse : IntermediateIncluded(K, E, N, M) {
    intro x;
    intro member;
    let target = typed(af_carrier(Q), (x, member));
    obtain (a, same) = field_embedding_preimage(R, Q, i, onto, target);
    exact transport(
      intermediate_members(K, E, M), subfield_value(F, S, a), x, cong(subfield_value(F, T), same),
      subfield_evidence(F, S, a)
    );
  }
  exact intermediate_inclusion_antisym(K, E, M, N, included, reverse);
}

// The field roundtrip. The count of fixing loops supplies [E:M]; Artin's
// theorem supplies [E:Fix(Aut_M E)]. Their equality forces the middle step
// to have degree one, so the inclusion M -> Fix(Aut_M E) is onto.
def finite_normal_separable_fixed_fixing_intermediate(
  K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E), finite : FiniteExtension(K, E),
  normal : NormalEmbeddingLaw(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  separable : SeparableExtension(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  T : AlgebraicField, closed : AlgebraicallyClosed(T), j : FieldEmbedding(extension_field(K, E), T)
) :
  fixed_intermediate_field(K, E, fixing_galois_subgroup(K, E, M)) =[IntermediateField(K, E)] M {
  let H = fixing_galois_subgroup(K, E, M);
  let N = fixed_intermediate_field(K, E, H);
  let G = GaloisGroup(K, E);
  let R = intermediate_as_field(K, E, M);
  let Q = intermediate_as_field(K, E, N);
  let F = extension_field(K, E);
  let included = galois_fixed_fixing_contains(K, E, intermediate_members(K, E, M));
  let i = intermediate_inclusion_embedding(K, E, M, N, included);
  let h = intermediate_ambient_embedding(K, E, N);
  let e = intermediate_ambient_embedding(K, E, M);
  let triangle = intermediate_inclusion_triangle(K, E, M, N, included);
  obtain (upperM, countH) = finite_normal_separable_intermediate_automorphism_count(
    K, E, M, finite, normal, separable, T, closed, j
  );
  let d = extension_degree(R, intermediate_overfield(K, E, M), upperM);
  obtain (upperN, degreeN) = artin_fixed_field_degree(K, E, H, d, countH);
  let steps = finite_extension_tower_converse(R, Q, F, i, h, e, triangle, upperM);
  let lower =
    fst(
      FiniteExtension(R, embedding_as_extension(R, Q, i)),
      FiniteExtension(Q, intermediate_overfield(K, E, N)), steps
    );
  let m = extension_degree(R, embedding_as_extension(R, Q, i), lower);
  let towerDegree = tower_law(R, Q, F, i, h, e, triangle, lower, upperN, upperM);
  have product : multiply_count(d, m) = d {
    exact trans(sym(cong((fun (q : Nat) => multiply_count(q, m)), degreeN)), sym(towerDegree));
  }
  let nonempty = subgroup_carrier_unit(G, H);
  obtain (k, positive) = inhabited_cardinality_positive(SubgroupCarrier(G, H), d, countH, nonempty);
  let productPositive =
    transport((fun (q : Nat) => multiply_count(q, m) = q), d, succ(k), positive, product);
  let degreeOne = positive_product_unit(k, m, productPositive);
  let onto = degree_one_embedding_surjective(R, Q, i, lower, degreeOne);
  exact sym(intermediate_inclusion_surjective_equal(K, E, M, N, included, onto));
}

// The two checked roundtrips assemble into an equivalence. The finiteAll
// argument records a cardinality for each subgroup; below it can be supplied
// by finite-subtype counting once the ambient Galois group is enumerated.
def finite_galois_correspondence_with_finite_subgroups(
  K : AlgebraicField, E : FieldExt(K), finite : FiniteExtension(K, E),
  normal : NormalEmbeddingLaw(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  separable : SeparableExtension(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  T : AlgebraicField, closed : AlgebraicallyClosed(T), j : FieldEmbedding(extension_field(K, E), T),
  finiteAll : forall H : GaloisSubgroup(K, E), exists n : Nat,
  HasCardinality(SubgroupCarrier(GaloisGroup(K, E), H), n)
) :
  Equiv(U1, GaloisSubgroup(K, E), IntermediateField(K, E)) {
  let fixed = fixed_intermediate_field(K, E);
  let fixing = fixing_galois_subgroup(K, E);
  exact equiv_from_inverse(
    U1, GaloisSubgroup(K, E), IntermediateField(K, E), fixed, fixing,
    (
      fun (H : GaloisSubgroup(K, E)) => unpack finiteAll(H) as (n, count) return (
        fixing(fixed(H)) =[GaloisSubgroup(K, E)] H
      ) {
        artin_fixing_fixed_subgroup(K, E, H, n, count);
      }
    ),
    (
      fun (M : IntermediateField(K, E)) => finite_normal_separable_fixed_fixing_intermediate(
        K, E, M, finite, normal, separable, T, closed, j
      )
    )
  );
}

def finite_galois_subgroup_cardinality(
  K : AlgebraicField, E : FieldExt(K), n : Nat, finiteG : HasCardinality(Galois(K, E), n),
  H : GaloisSubgroup(K, E)
) :
  HasFiniteCardinality(SubgroupCarrier(GaloisGroup(K, E), H)) {
  let G = GaloisGroup(K, E);
  let members = subgroup_members(G, H);
  exact finite_predicate_of_finite(
    Galois(K, E), n, finiteG, members, subgroup_prop(G, members, subgroup_laws(G, H))
  );
}

// The general finite correspondence, with a supplied algebraically closed
// target containing E. The ambient automorphism count makes every subgroup
// finite, so both roundtrips apply to arbitrary proposition-valued subobjects.
def finite_galois_correspondence(
  K : AlgebraicField, E : FieldExt(K), finite : FiniteExtension(K, E),
  normal : NormalEmbeddingLaw(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  separable : SeparableExtension(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  T : AlgebraicField, closed : AlgebraicallyClosed(T), j : FieldEmbedding(extension_field(K, E), T)
) :
  Equiv(U1, GaloisSubgroup(K, E), IntermediateField(K, E)) {
  let d = extension_degree(K, E, finite);
  let finiteG =
    finite_normal_separable_automorphism_count(K, E, finite, normal, separable, T, closed, j);
  exact finite_galois_correspondence_with_finite_subgroups(
    K, E, finite, normal, separable, T, closed, j,
    (fun (H : GaloisSubgroup(K, E)) => finite_galois_subgroup_cardinality(K, E, d, finiteG, H))
  );
}

// Numerical degree product for a corresponding pair M and H = Aut_M(E).
// The quotient-index interpretation requires a separate finite presentation
// of the coset type, which lives in U1 in the general quotient construction.
def finite_galois_cardinality_tower_law(
  K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E), finite : FiniteExtension(K, E),
  normal : NormalEmbeddingLaw(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  separable : SeparableExtension(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  T : AlgebraicField, closed : AlgebraicallyClosed(T), j : FieldEmbedding(extension_field(K, E), T)
) :
  exists lower : FiniteExtension(K, intermediate_as_extension(K, E, M)), exists h : Nat,
  HasCardinality(SubgroupCarrier(GaloisGroup(K, E), fixing_galois_subgroup(K, E, M)), h)
  and (
    extension_degree(K, E, finite) = multiply_count(
      h, extension_degree(K, intermediate_as_extension(K, E, M), lower)
    )
  ) {
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let b = intermediate_base_embedding(K, E, M);
  let i = intermediate_ambient_embedding(K, E, M);
  let e = extension_inclusion_embedding(K, E);
  let steps =
    finite_extension_tower_converse(K, R, F, b, i, e, intermediate_tower(K, E, M), finite);
  let lower =
    fst(
      FiniteExtension(K, intermediate_as_extension(K, E, M)),
      FiniteExtension(R, intermediate_overfield(K, E, M)), steps
    );
  obtain (upper, countH) = finite_normal_separable_intermediate_automorphism_count(
    K, E, M, finite, normal, separable, T, closed, j
  );
  let h = extension_degree(R, intermediate_overfield(K, E, M), upper);
  exact (
    lower, h, countH, tower_law(K, R, F, b, i, e, intermediate_tower(K, E, M), lower, upper, finite)
  );
}

def base_image_intermediate(K : AlgebraicField, E : FieldExt(K)) : IntermediateField(K, E) {
  let F = extension_field(K, E);
  let e = extension_inclusion_embedding(K, E);
  let S = subfield_image(K, F, e, subfield_top(K));
  exact (
    subfield_members(F, S), subfield_laws(F, S),
    (fun (a : af_carrier(K)) => (a, tt, refl(extension_inclusion(K, E, a))))
  );
}

def base_image_fixing_is_full_group(K : AlgebraicField, E : FieldExt(K)) :
  fixing_galois_subgroup(K, E, base_image_intermediate(K, E)) =[GaloisSubgroup(K, E)] subgroup_top(
    GaloisGroup(K, E)
  ) {
  let G = GaloisGroup(K, E);
  let M = base_image_intermediate(K, E);
  let H = fixing_galois_subgroup(K, E, M);
  have fullFixes : GaloisSubgroupIncluded(K, E, subgroup_top(G), H) {
    intro g;
    intro member;
    intro x;
    intro inBase;
    obtain (a, unit, same) = inBase;
    exact trans(
      cong(extension_iso_forward(K, E, E, g), sym(same)), trans(galois_fixes_base(K, E, g, a), same)
    );
  }
  have included : GaloisSubgroupIncluded(K, E, H, subgroup_top(G)) {
    intro g;
    intro member;
    exact tt;
  }
  exact galois_subgroup_inclusion_antisym(K, E, H, subgroup_top(G), included, fullFixes);
}

def finite_normal_separable_full_fixed_field(
  K : AlgebraicField, E : FieldExt(K), finite : FiniteExtension(K, E),
  normal : NormalEmbeddingLaw(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  separable : SeparableExtension(K, extension_field(K, E), extension_inclusion_embedding(K, E)),
  T : AlgebraicField, closed : AlgebraicallyClosed(T), j : FieldEmbedding(extension_field(K, E), T)
) :
  fixed_intermediate_field(K, E, subgroup_top(GaloisGroup(K, E))) =[IntermediateField(K, E)] base_image_intermediate(
    K, E
  ) {
  let M = base_image_intermediate(K, E);
  exact trans(
    sym(cong(fixed_intermediate_field(K, E), base_image_fixing_is_full_group(K, E))),
    finite_normal_separable_fixed_fixing_intermediate(
      K, E, M, finite, normal, separable, T, closed, j
    )
  );
}
