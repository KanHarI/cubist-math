// Unit prop unique
// Complete checked construction. All intermediate steps are included.
construction unit_prop_unique {
  private s0001_UnitForm = unit_type();
  private s0002_UnitIntro = unit_value();
  private s0003_CtxExt = assume(s0001_UnitForm, none);
  private s0004_Vble = variable(s0003_CtxExt);
  private s0005_EqForm = equality_type(s0001_UnitForm, s0004_Vble, s0002_UnitIntro);
  private s0006_EqIntro = reflexivity(s0002_UnitIntro);
  private s0007_UnitElim = unit_eliminate(s0005_EqForm, s0006_EqIntro, s0004_Vble, s0003_CtxExt);
  private s0008_PiIntro = function_intro(s0001_UnitForm, s0007_UnitElim, s0003_CtxExt);
  private s0009_Def = define(s0008_PiIntro);
  export lib_unit_unique = definition_left(s0009_Def);
}
