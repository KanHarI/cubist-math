import prelude;
import paths;

// Reuse the original prelude truncation type, unit, and proposition axiom.
def IsProp(A : Type) = forall x : A, forall y : A, x = y;
def Mere(A : Type) = truncation(A);
def merely(A : Type, a : A) = truncation_intro(A, a);
def mere_is_prop(A : Type) = truncation_prop(A);

// The prelude supplies the standard elimination axiom. This checked wrapper
// rearranges its premises; it introduces no additional axiom.
def mere_eliminate(A : Type, P : Type, proposition : IsProp(P), f : A -> P) =
  truncation_elim(A, P, proposition, f);

def mere_map(A : Type, B : Type, f : A -> B, h : Mere(A)) =
  mere_eliminate(A, Mere(B), mere_is_prop(B), (fun (a : A) => merely(B, f(a))), h);
