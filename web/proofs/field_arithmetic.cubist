def scalar_mul_zero(K : AlgebraicField) =
  ring_mul_zero(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
    scalar_ring(K)
  );

def scalar_mul_neg(K : AlgebraicField) =
