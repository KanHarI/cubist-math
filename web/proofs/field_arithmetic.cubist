import linear_constructions;

// Readable specializations of the existing ring laws to a bundled field.
def field_zero(K : AlgebraicField) = af_zero(af_carrier(K), af_operations(K));

def field_one(K : AlgebraicField) = af_one(af_carrier(K), af_operations(K));

def field_add(K : AlgebraicField) = af_add(af_carrier(K), af_operations(K));

def field_mul(K : AlgebraicField) = af_mul(af_carrier(K), af_operations(K));

def field_neg(K : AlgebraicField) = af_neg(af_carrier(K), af_operations(K));

def scalar_ring(K : AlgebraicField) =
  algebraic_field_ring(
    af_carrier(K), af_operations(K), af_set(K),
    field_ring_data(af_carrier(K), af_operations(K), af_laws(K))
  );

def scalar_add_assoc(K : AlgebraicField) =
  ring_add_assoc(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
    scalar_ring(K)
  );

def scalar_add_comm(K : AlgebraicField) =
  ring_add_comm(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
    scalar_ring(K)
  );

def scalar_add_zero(K : AlgebraicField) =
  ring_add_zero(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
    scalar_ring(K)
  );

def scalar_add_inverse(K : AlgebraicField) =
  ring_add_inverse(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
    scalar_ring(K)
  );

def scalar_mul_assoc(K : AlgebraicField) =
  ring_mul_assoc(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
    scalar_ring(K)
  );

def scalar_mul_comm(K : AlgebraicField) =
  ring_mul_comm(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
    scalar_ring(K)
  );

def scalar_mul_one(K : AlgebraicField) =
  ring_mul_one(
    af_carrier(K), field_zero(K), field_one(K), field_add(K), field_mul(K), field_neg(K),
