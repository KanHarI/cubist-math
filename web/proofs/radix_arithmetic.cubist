import radix_naturals;
import paths;

// The carry cases use structural finite-digit increment, at any radix >= 2.
def radix_positive_succ(extra : Nat, p : RadixPositive(extra)) =
  radix_positive_rec(
    extra, RadixPositive(extra),
    fun (first : RadixDigit(succ(extra))) => match radix_digit_succ(succ(extra), first) return RadixPositive(
      extra
    ) {
      left next => radix_leading(extra, next);
      right carry => radix_append(extra, radix_digit_zero(succ(extra)), radix_one(extra));
    },
    fun (digit : RadixDigit(succ(succ(extra)))) (child ih : RadixPositive(extra)) => match radix_digit_succ(
      succ(succ(extra)), digit
    ) return RadixPositive(extra) {
      left next => radix_append(extra, next, child);
      right carry => radix_append(extra, radix_digit_zero(succ(extra)), ih);
    }, p
  );

def radix_succ(extra : Nat, n : RadixNat(extra)) = match n return RadixNat(extra) {
    left zero => radix_positive(extra, radix_one(extra));
    right p => radix_positive(extra, radix_positive_succ(extra, p));
  };

// Only small digit values drive these loops; whole numbers remain W trees.
def radix_add_small(extra count : Nat, p : RadixPositive(extra)) =
  induction count as k return RadixPositive(extra) {
    zero => p;
    succ previous => radix_positive_succ(extra, previous);
  };

def radix_positive_add(extra : Nat, a : RadixPositive(extra)) :
  RadixPositive(extra) -> RadixPositive(extra) {
  exact radix_positive_rec(
    extra, (RadixPositive(extra) -> RadixPositive(extra)),
    fun (first : RadixDigit(succ(extra))) (other : RadixPositive(extra)) => radix_add_small(
      extra, succ(radix_digit_value(succ(extra), first)), other
    ),
    fun (digit : RadixDigit(succ(succ(extra)))) (child : RadixPositive(extra)) (
      ih : RadixPositive(extra) -> RadixPositive(extra)
    ) (other : RadixPositive(extra)) => radix_positive_cases(
      extra, RadixPositive(extra),
      fun (first : RadixDigit(succ(extra))) => radix_add_small(
        extra, succ(radix_digit_value(succ(extra), first)), radix_append(extra, digit, child)
      ),
      fun (next : RadixDigit(succ(succ(extra)))) (tail : RadixPositive(extra)) => radix_add_small(
        extra, radix_digit_value(succ(succ(extra)), next), radix_append(extra, digit, ih(tail))
      ), other
    ), a
  );
}

def radix_add(extra : Nat, a b : RadixNat(extra)) = match a return RadixNat(extra) {
    left zero => b;
    right p => match b return RadixNat(extra) {
      left zero => a;
      right q => radix_positive(extra, radix_positive_add(extra, p, q));
    };
  };

def radix_add_copies(extra count : Nat, a b : RadixPositive(extra)) =
  induction count as k return RadixPositive(extra) {
    zero => a;
    succ previous => radix_positive_add(extra, previous, b);
  };

def radix_positive_mul(extra : Nat, a : RadixPositive(extra)) :
  RadixPositive(extra) -> RadixPositive(extra) {
  exact radix_positive_rec(
    extra, (RadixPositive(extra) -> RadixPositive(extra)),
    fun (first : RadixDigit(succ(extra))) (other : RadixPositive(extra)) => radix_add_copies(
      extra, radix_digit_value(succ(extra), first), other, other
    ),
    fun (digit : RadixDigit(succ(succ(extra)))) (child : RadixPositive(extra)) (
      ih : RadixPositive(extra) -> RadixPositive(extra)
    ) (other : RadixPositive(extra)) => radix_add_copies(
      extra, radix_digit_value(succ(succ(extra)), digit),
      radix_append(extra, radix_digit_zero(succ(extra)), ih(other)), other
    ), a
  );
}

def radix_mul(extra : Nat, a b : RadixNat(extra)) = match a return RadixNat(extra) {
    left zero => radix_zero(extra);
    right p => match b return RadixNat(extra) {
      left zero => radix_zero(extra);
      right q => radix_positive(extra, radix_positive_mul(extra, p, q));
    };
  };

def radix_of_nat(extra n : Nat) = induction n as k return RadixNat(extra) {
    zero => radix_zero(extra);
    succ previous => radix_succ(extra, previous);
  };

opaque def radix_factorial(extra n : Nat) = induction n as k return RadixNat(extra) {
    zero => radix_positive(extra, radix_one(extra));
    succ previous => radix_mul(extra, radix_of_nat(extra, succ(k)), previous);
  };

def radix_factorial_step(extra n : Nat) :
  radix_factorial(extra, succ(n)) = radix_mul(
    extra, radix_of_nat(extra, succ(n)), radix_factorial(extra, n)
  ) {
  rfl;
}

def radix_factorial_value_step(
  extra n : Nat, value : RadixNat(extra), previous : radix_factorial(extra, n) = value
) :
  radix_factorial(extra, succ(n)) = radix_mul(extra, radix_of_nat(extra, succ(n)), value) {
  exact trans(
    radix_factorial_step(extra, n),
    cong((fun (v : RadixNat(extra)) => radix_mul(extra, radix_of_nat(extra, succ(n)), v)), previous)
  );
}

def radix_factorial_zero(extra : Nat) :
  radix_factorial(extra, 0) = radix_positive(extra, radix_one(extra)) {
  rfl;
}
