import generated_field_carriers;
import field_embedding_factorization;
import polynomial_splitting;

// Generators consist of the image of the base field and the listed roots.
def RootFieldGenerators(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat,
  roots : Fin(n) -> af_carrier(L), y : af_carrier(L)
) =
  (exists a : af_carrier(K), field_embedding_map(K, L, e, a) = y)
  or (exists i : Fin(n), roots(i) = y);

def RootGeneratedSubfield(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat,
  roots : Fin(n) -> af_carrier(L)
) =
  generated_subfield(L, RootFieldGenerators(K, L, e, n, roots));

def RootGeneratedField(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat,
  roots : Fin(n) -> af_carrier(L)
) =
  subfield_as_field(L, RootGeneratedSubfield(K, L, e, n, roots));

def root_generated_contains_base(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat, roots : Fin(n)
  -> af_carrier(L), a : af_carrier(K)
) :
  subfield_members(L, RootGeneratedSubfield(K, L, e, n, roots), field_embedding_map(K, L, e, a)) {
  let y = field_embedding_map(K, L, e, a);
  exact generated_field_contains(
    L, RootFieldGenerators(K, L, e, n, roots), y,
    typed(
      RootFieldGenerators(K, L, e, n, roots, y),
      left(typed((exists b : af_carrier(K), field_embedding_map(K, L, e, b) = y), (a, refl(y))))
    )
  );
}

def root_generated_embedding(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat,
  roots : Fin(n) -> af_carrier(L)
) =
  field_embedding_factor(
    K, L, e, RootGeneratedSubfield(K, L, e, n, roots),
    root_generated_contains_base(K, L, e, n, roots)
  );

def root_generated_root(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat, roots : Fin(n)
  -> af_carrier(L), i : Fin(n)
) :
  af_carrier(RootGeneratedField(K, L, e, n, roots)) {
  let x = roots(i);
  exact (
    x,
    generated_field_contains(
      L, RootFieldGenerators(K, L, e, n, roots), x,
      typed(
        RootFieldGenerators(K, L, e, n, roots, x),
        right(typed((exists j : Fin(n), roots(j) = x), (i, refl(x))))
      )
    )
  );
}

// The realized field is still generated internally by the lifted base and roots.
def root_generated_generates(
  K : AlgebraicField, L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat, roots : Fin(n)
  -> af_carrier(L), z : af_carrier(RootGeneratedField(K, L, e, n, roots))
) :
  GeneratedField(
    RootGeneratedField(K, L, e, n, roots),
    RootFieldGenerators(
      K, RootGeneratedField(K, L, e, n, roots), root_generated_embedding(K, L, e, n, roots), n,
      root_generated_root(K, L, e, n, roots)
    ), z
  ) {
  let P = RootFieldGenerators(K, L, e, n, roots);
  let S = RootGeneratedSubfield(K, L, e, n, roots);
  let T = RootGeneratedField(K, L, e, n, roots);
  let d = root_generated_embedding(K, L, e, n, roots);
  let rs = root_generated_root(K, L, e, n, roots);
  let Q = RootFieldGenerators(K, T, d, n, rs);
  let H = generated_subfield(T, Q);
  have contains :
    forall y : af_carrier(L), forall member : P(y),
    subfield_members(T, H, generated_carrier_generator(L, P, y, member)) {
    intro y;
    intro member;
    let target = generated_carrier_generator(L, P, y, member);
    have baseCase :
      (exists a : af_carrier(K), field_embedding_map(K, L, e, a) = y)
      -> subfield_members(T, H, target) {
      intro witness;
      obtain (a, same) = witness;
      let u = field_embedding_map(K, T, d, a);
      let generator =
        typed(
          Q(u),
          left(typed((exists b : af_carrier(K), field_embedding_map(K, T, d, b) = u), (a, refl(u))))
        );
      exact transport(
        subfield_members(T, H), u, target, subfield_value_ext(L, S, u, target, same),
        generated_field_contains(T, Q, u, generator)
      );
    }
    have rootCase : (exists i : Fin(n), roots(i) = y) -> subfield_members(T, H, target) {
      intro witness;
      obtain (i, same) = witness;
      let u = rs(i);
      let generator = typed(Q(u), right(typed((exists j : Fin(n), rs(j) = u), (i, refl(u)))));
      exact transport(
        subfield_members(T, H), u, target, subfield_value_ext(L, S, u, target, same),
        generated_field_contains(T, Q, u, generator)
      );
    }
    exact match member as which return subfield_members(T, H, target) {
      left base => baseCase(base);
      right root => rootCase(root);
    };
  }
  exact generated_carrier_least(L, P, H, contains, z);
}
