import artin_hom_independence;
import finite_sums;

def field_add_laws(L : AlgebraicField) :
  AddLaws(af_carrier(L), field_zero(L), field_add(L), field_neg(L)) {
  exact fst(
    FieldAddLaws(af_carrier(L), af_operations(L)), FieldMulLaws(af_carrier(L), af_operations(L)),
    field_ring_data(af_carrier(L), af_operations(L), af_laws(L))
  );
}

def field_sum(L : AlgebraicField, n : Nat, values : Fin(n) -> af_carrier(L)) =
  finite_sum(af_carrier(L), field_zero(L), field_add(L), n, values);

def field_sum_zero(
  L : AlgebraicField, n : Nat, values : Fin(n) -> af_carrier(L), allZero : forall i : Fin(n),
  values(i) = field_zero(L)
) :
  field_sum(L, n, values) = field_zero(L) {
  exact finite_sum_zero(
    af_carrier(L), field_zero(L), field_add(L), field_neg(L), field_add_laws(L), n, values, allZero
  );
}

def field_sum_cong(
  L : AlgebraicField, n : Nat, values : Fin(n) -> af_carrier(L), other : Fin(n) -> af_carrier(L),
  same : forall i : Fin(n), values(i) = other(i)
) :
  field_sum(L, n, values) = field_sum(L, n, other) {
  exact finite_sum_cong(
    af_carrier(L), field_zero(L), field_add(L), field_neg(L), field_add_laws(L), n, values, other,
    same
  );
}

def field_sum_add(
  L : AlgebraicField, n : Nat, values : Fin(n) -> af_carrier(L), other : Fin(n) -> af_carrier(L)
) :
  field_sum(L, n, (fun (i : Fin(n)) => field_add(L, values(i), other(i)))) = field_add(
    L, field_sum(L, n, values), field_sum(L, n, other)
  ) {
  exact finite_sum_add(
    af_carrier(L), field_zero(L), field_add(L), field_neg(L), field_add_laws(L), n, values, other
  );
}

// Multiplication distributes over an arbitrary finite sum. This is the field
// calculation needed when a relation is evaluated at tx instead of x.
def field_sum_mul(L : AlgebraicField, a : af_carrier(L), n : Nat) =
  induction n as k return (
    forall values : Fin(k) -> af_carrier(L),
    field_sum(L, k, (fun (i : Fin(k)) => field_mul(L, a, values(i)))) = field_mul(
      L, a, field_sum(L, k, values)
    )
  ) {
    zero => fun (values : Fin(0) -> af_carrier(L)) => sym(scalar_mul_zero(L, a));
    succ previous => fun (values : Fin(succ(k)) -> af_carrier(L)) => trans(
      cong(
        field_add(L, field_mul(L, a, finite_head(af_carrier(L), k, values))),
        previous(finite_tail(af_carrier(L), k, values))
      ),
      sym(
        scalar_distribute(
          L, a, finite_head(af_carrier(L), k, values),
          field_sum(L, k, finite_tail(af_carrier(L), k, values))
        )
      )
    );
  };

def field_sum_neg(L : AlgebraicField, n : Nat) =
  induction n as k return (
    forall values : Fin(k) -> af_carrier(L),
    field_sum(L, k, (fun (i : Fin(k)) => field_neg(L, values(i)))) = field_neg(
      L, field_sum(L, k, values)
    )
  ) {
    zero => fun (values : Fin(0) -> af_carrier(L)) => sym(scalar_neg_zero(L));
    succ previous => fun (values : Fin(succ(k)) -> af_carrier(L)) => trans(
      cong(
        field_add(L, field_neg(L, finite_head(af_carrier(L), k, values))),
        previous(finite_tail(af_carrier(L), k, values))
      ),
      sym(
        ring_neg_add(
          af_carrier(L), field_zero(L), field_one(L), field_add(L), field_mul(L), field_neg(L),
          scalar_ring(L), finite_head(af_carrier(L), k, values),
          field_sum(L, k, finite_tail(af_carrier(L), k, values))
        )
      )
    );
  };

def hom_family_sum(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(n) -> FieldEmbedding(K, L),
  coefficients : Fin(n) -> af_carrier(L), x : af_carrier(K)
) =
  field_sum(
    L, n, (fun (i : Fin(n)) => field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), x)))
  );

// Evaluating a relation at tx is the relation at x with coefficient c_i f_i(t).
def hom_family_sum_product(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(n) -> FieldEmbedding(K, L),
  coefficients : Fin(n) -> af_carrier(L), t : af_carrier(K), x : af_carrier(K)
) :
  hom_family_sum(K, L, n, maps, coefficients, field_mul(K, t, x)) = hom_family_sum(
    K, L, n, maps,
    (fun (i : Fin(n)) => field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), t))), x
  ) {
  have sameTerm :
    forall i : Fin(n),
    field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), field_mul(K, t, x))) = field_mul(
      L, field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), t)),
      field_embedding_map(K, L, maps(i), x)
    ) {
    intro i;
    obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, maps(i));
    exact trans(
      cong(field_mul(L, coefficients(i)), mul(t, x)),
      sym(
        scalar_mul_assoc(
          L, coefficients(i), field_embedding_map(K, L, maps(i), t),
          field_embedding_map(K, L, maps(i), x)
        )
      )
    );
  }
  exact field_sum_cong(
    L, n,
    (
      fun (i : Fin(n)) => field_mul(
        L, coefficients(i), field_embedding_map(K, L, maps(i), field_mul(K, t, x))
      )
    ),
    (
      fun (i : Fin(n)) => field_mul(
        L, field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), t)),
        field_embedding_map(K, L, maps(i), x)
      )
    ), sameTerm
  );
}

def hom_family_sum_scaled(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(n) -> FieldEmbedding(K, L),
  coefficients : Fin(n) -> af_carrier(L), b : af_carrier(L), x : af_carrier(K)
) :
  hom_family_sum(K, L, n, maps, (fun (i : Fin(n)) => field_mul(L, b, coefficients(i))), x) = field_mul(
    L, b, hom_family_sum(K, L, n, maps, coefficients, x)
  ) {
  let values =
    fun (i : Fin(n)) => field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), x));
  exact trans(
    field_sum_cong(
      L, n,
      (
        fun (i : Fin(n)) => field_mul(
          L, field_mul(L, b, coefficients(i)), field_embedding_map(K, L, maps(i), x)
        )
      ), (fun (i : Fin(n)) => field_mul(L, b, values(i))),
      (
        fun (i : Fin(n)) => scalar_mul_assoc(
          L, b, coefficients(i), field_embedding_map(K, L, maps(i), x)
        )
      )
    ), field_sum_mul(L, b, n, values)
  );
}

def hom_family_sum_at_one(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(n) -> FieldEmbedding(K, L),
  coefficients : Fin(n) -> af_carrier(L)
) :
  hom_family_sum(K, L, n, maps, coefficients, field_one(K)) = field_sum(L, n, coefficients) {
  have same :
    forall i : Fin(n),
    field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), field_one(K))) = coefficients(
      i
    ) {
    intro i;
    obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, maps(i));
    exact trans(cong(field_mul(L, coefficients(i)), one), scalar_mul_one_right(L, coefficients(i)));
  }
  exact field_sum_cong(
    L, n,
    (
      fun (i : Fin(n)) => field_mul(
        L, coefficients(i), field_embedding_map(K, L, maps(i), field_one(K))
      )
    ), coefficients, same
  );
}

def hom_family_difference(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(n) -> FieldEmbedding(K, L),
  first : Fin(n) -> af_carrier(L), second : Fin(n) -> af_carrier(L), x : af_carrier(K)
) :
  hom_family_sum(
    K, L, n, maps, (fun (i : Fin(n)) => field_add(L, first(i), field_neg(L, second(i)))), x
  ) = field_add(
    L, hom_family_sum(K, L, n, maps, first, x),
    field_neg(L, hom_family_sum(K, L, n, maps, second, x))
  ) {
  let F = fun (i : Fin(n)) => field_embedding_map(K, L, maps(i), x);
  let u = fun (i : Fin(n)) => field_mul(L, first(i), F(i));
  let v = fun (i : Fin(n)) => field_mul(L, second(i), F(i));
  let w = fun (i : Fin(n)) => field_mul(L, field_add(L, first(i), field_neg(L, second(i))), F(i));
  let z = fun (i : Fin(n)) => field_add(L, u(i), field_neg(L, v(i)));
  have same : forall i : Fin(n), w(i) = z(i) {
    intro i;
    exact trans(
      scalar_distribute_left(L, first(i), field_neg(L, second(i)), F(i)),
      cong(
        field_add(L, u(i)),
        ring_neg_mul(
          af_carrier(L), field_zero(L), field_one(L), field_add(L), field_mul(L), field_neg(L),
          scalar_ring(L), second(i), F(i)
        )
      )
    );
  }
  exact trans(
    field_sum_cong(L, n, w, z, same),
    trans(
      field_sum_add(L, n, u, (fun (i : Fin(n)) => field_neg(L, v(i)))),
      cong(field_add(L, field_sum(L, n, u)), field_sum_neg(L, n, v))
    )
  );
}

def hom_family_twisted_relation(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(n) -> FieldEmbedding(K, L),
  coefficients : Fin(n) -> af_carrier(L), relation : forall x : af_carrier(K),
  hom_family_sum(K, L, n, maps, coefficients, x) = field_zero(L), t : af_carrier(K),
  b : af_carrier(L), x : af_carrier(K)
) :
  hom_family_sum(
    K, L, n, maps,
    (
      fun (i : Fin(n)) => field_add(
        L, field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), t)),
        field_neg(L, field_mul(L, b, coefficients(i)))
      )
    ), x
  ) = field_zero(L) {
  let first =
    fun (i : Fin(n)) => field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), t));
  let second = fun (i : Fin(n)) => field_mul(L, b, coefficients(i));
  let firstZero =
    trans(
      sym(hom_family_sum_product(K, L, n, maps, coefficients, t, x)), relation(field_mul(K, t, x))
    );
  let secondZero =
    trans(
      hom_family_sum_scaled(K, L, n, maps, coefficients, b, x),
      trans(cong(field_mul(L, b), relation(x)), scalar_mul_zero(L, b))
    );
  exact trans(
    hom_family_difference(K, L, n, maps, first, second, x),
    trans(
      cong(
        (
          fun (z : af_carrier(L)) => field_add(
            L, z, field_neg(L, hom_family_sum(K, L, n, maps, second, x))
          )
        ), firstZero
      ),
      trans(
        cong((fun (z : af_carrier(L)) => field_add(L, field_zero(L), field_neg(L, z))), secondZero),
        trans(
          cong(field_add(L, field_zero(L)), scalar_neg_zero(L)), scalar_add_zero(L, field_zero(L))
        )
      )
    )
  );
}

def PairwiseDistinctEmbeddings(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(n) -> FieldEmbedding(K, L)
) =
  forall i : Fin(n), forall j : Fin(n), maps(i) = maps(j) -> i = j;

def HomFamilyIndependent(n : Nat) =
  forall K : AlgebraicField, forall L : AlgebraicField,
  forall maps : Fin(n) -> FieldEmbedding(K, L), PairwiseDistinctEmbeddings(K, L, n, maps)
  -> forall coefficients : Fin(n) -> af_carrier(L),
  (forall x : af_carrier(K), hom_family_sum(K, L, n, maps, coefficients, x) = field_zero(L))
  -> forall i : Fin(n), coefficients(i) = field_zero(L);

def hom_family_independent_zero : HomFamilyIndependent(0) {
  intro K;
  intro L;
  intro maps;
  intro distinct;
  intro coefficients;
  intro relation;
  intro i;
  exact absurd(i);
}

def hom_family_twisted_head_zero(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(succ(n)) -> FieldEmbedding(K, L),
  coefficients : Fin(succ(n)) -> af_carrier(L), t : af_carrier(K)
) :
  field_add(
    L,
    field_mul(
      L, finite_head(af_carrier(L), n, coefficients),
      field_embedding_map(K, L, finite_head(FieldEmbedding(K, L), n, maps), t)
    ),
    field_neg(
      L,
      field_mul(
        L, field_embedding_map(K, L, finite_head(FieldEmbedding(K, L), n, maps), t),
        finite_head(af_carrier(L), n, coefficients)
      )
    )
  ) = field_zero(L) {
  let c = finite_head(af_carrier(L), n, coefficients);
  let v = field_embedding_map(K, L, finite_head(FieldEmbedding(K, L), n, maps), t);
  exact trans(
    cong(
      (fun (z : af_carrier(L)) => field_add(L, z, field_neg(L, field_mul(L, v, c)))),
      scalar_mul_comm(L, c, v)
    ), scalar_add_inverse_right(L, field_mul(L, v, c))
  );
}

def hom_family_tail_distinct(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(succ(n)) -> FieldEmbedding(K, L),
  distinct : PairwiseDistinctEmbeddings(K, L, succ(n), maps)
) :
  PairwiseDistinctEmbeddings(K, L, n, finite_tail(FieldEmbedding(K, L), n, maps)) {
  intro i;
  intro j;
  intro same;
  exact tail_injective(
    Fin(n), i, j, distinct(typed(Fin(succ(n)), right(i)), typed(Fin(succ(n)), right(j)), same)
  );
}

def hom_family_twisted_tail_relation(
  K : AlgebraicField, L : AlgebraicField, n : Nat, maps : Fin(succ(n)) -> FieldEmbedding(K, L),
  coefficients : Fin(succ(n)) -> af_carrier(L), relation : forall x : af_carrier(K),
  hom_family_sum(K, L, succ(n), maps, coefficients, x) = field_zero(L), t : af_carrier(K),
  x : af_carrier(K)
) :
  hom_family_sum(
    K, L, n, finite_tail(FieldEmbedding(K, L), n, maps),
    (
      fun (i : Fin(n)) => field_add(
        L,
        field_mul(
          L, coefficients(typed(Fin(succ(n)), right(i))),
          field_embedding_map(K, L, maps(typed(Fin(succ(n)), right(i))), t)
        ),
        field_neg(
          L,
          field_mul(
            L, field_embedding_map(K, L, finite_head(FieldEmbedding(K, L), n, maps), t),
            coefficients(typed(Fin(succ(n)), right(i)))
          )
        )
      )
    ), x
  ) = field_zero(L) {
  let head = typed(Fin(succ(n)), left(tt));
  let pivot = field_embedding_map(K, L, maps(head), t);
  let twisted =
    fun (i : Fin(succ(n))) => field_add(
      L, field_mul(L, coefficients(i), field_embedding_map(K, L, maps(i), t)),
      field_neg(L, field_mul(L, pivot, coefficients(i)))
    );
  let tail = finite_tail(af_carrier(L), n, twisted);
  let tailMaps = finite_tail(FieldEmbedding(K, L), n, maps);
  let tailSum = hom_family_sum(K, L, n, tailMaps, tail, x);
  let headZero =
    trans(
      cong(
        (fun (z : af_carrier(L)) => field_mul(L, z, field_embedding_map(K, L, maps(head), x))),
        hom_family_twisted_head_zero(K, L, n, maps, coefficients, t)
      ), scalar_zero_mul(L, field_embedding_map(K, L, maps(head), x))
    );
  exact trans(
    sym(scalar_add_zero(L, tailSum)),
    trans(
      cong((fun (z : af_carrier(L)) => field_add(L, z, tailSum)), sym(headZero)),
      hom_family_twisted_relation(K, L, succ(n), maps, coefficients, relation, t, pivot, x)
    )
  );
}

def hom_family_tail_coefficient_zero(
  n : Nat, previous : HomFamilyIndependent(n), K : AlgebraicField, L : AlgebraicField,
  maps : Fin(succ(n)) -> FieldEmbedding(K, L),
  distinct : PairwiseDistinctEmbeddings(K, L, succ(n), maps), coefficients : Fin(succ(n))
  -> af_carrier(L), relation : forall x : af_carrier(K),
  hom_family_sum(K, L, succ(n), maps, coefficients, x) = field_zero(L), i : Fin(n)
) :
  coefficients(typed(Fin(succ(n)), right(i))) = field_zero(L) {
  let head = typed(Fin(succ(n)), left(tt));
  let index = typed(Fin(succ(n)), right(i));
  let c = coefficients(index);
  let f = maps(index);
  let g = maps(head);
  let tailMaps = finite_tail(FieldEmbedding(K, L), n, maps);
  have twistedZero :
    forall t : af_carrier(K),
    field_add(
      L, field_mul(L, c, field_embedding_map(K, L, f, t)),
      field_neg(L, field_mul(L, field_embedding_map(K, L, g, t), c))
    ) = field_zero(L) {
    intro t;
    let pivot = field_embedding_map(K, L, g, t);
    let tailCoefficients =
      fun (j : Fin(n)) => field_add(
        L,
        field_mul(
          L, coefficients(typed(Fin(succ(n)), right(j))),
          field_embedding_map(K, L, maps(typed(Fin(succ(n)), right(j))), t)
        ), field_neg(L, field_mul(L, pivot, coefficients(typed(Fin(succ(n)), right(j)))))
      );
    exact previous(
      K, L, tailMaps, hom_family_tail_distinct(K, L, n, maps, distinct), tailCoefficients,
      (
        fun (x : af_carrier(K)) => hom_family_twisted_tail_relation(
          K, L, n, maps, coefficients, relation, t, x
        )
      ), i
    );
  }
  have impossible : FieldNonzero(af_carrier(L), af_operations(L), c) -> Void {
    intro nonzero;
    have sameMap :
      forall t : af_carrier(K), field_embedding_map(K, L, f, t) = field_embedding_map(K, L, g, t) {
      intro t;
      let ft = field_embedding_map(K, L, f, t);
      let gt = field_embedding_map(K, L, g, t);
      let product = field_mul(L, gt, c);
      let equalProducts =
        trans(
          group_cancel_right(
            FieldAdditiveGroup(L), field_mul(L, c, ft), product, field_neg(L, product),
            trans(twistedZero(t), sym(scalar_add_inverse_right(L, product)))
          ), scalar_mul_comm(L, gt, c)
        );
      exact field_mul_left_cancel_nonzero(L, c, ft, gt, nonzero, equalProducts);
    }
    exact sum_disjoint(
      Fin(n), tt, i, distinct(head, index, sym(field_embedding_ext(K, L, f, g, sameMap)))
    );
  }
  exact double_negation(c = field_zero(L), af_set(L, c, field_zero(L)), impossible);
}

def hom_family_head_coefficient_zero(
  n : Nat, previous : HomFamilyIndependent(n), K : AlgebraicField, L : AlgebraicField,
  maps : Fin(succ(n)) -> FieldEmbedding(K, L),
  distinct : PairwiseDistinctEmbeddings(K, L, succ(n), maps), coefficients : Fin(succ(n))
  -> af_carrier(L), relation : forall x : af_carrier(K),
  hom_family_sum(K, L, succ(n), maps, coefficients, x) = field_zero(L)
) :
  coefficients(typed(Fin(succ(n)), left(tt))) = field_zero(L) {
  let c = finite_head(af_carrier(L), n, coefficients);
  let tail = finite_tail(af_carrier(L), n, coefficients);
  let tailSum = field_sum(L, n, tail);
  have tailZero : tailSum = field_zero(L) {
    exact field_sum_zero(
      L, n, tail,
      (
        fun (i : Fin(n)) => hom_family_tail_coefficient_zero(
          n, previous, K, L, maps, distinct, coefficients, relation, i
        )
      )
    );
  }
  exact trans(
    sym(scalar_add_zero_right(L, c)),
    trans(
      cong(field_add(L, c), sym(tailZero)),
      trans(sym(hom_family_sum_at_one(K, L, succ(n), maps, coefficients)), relation(field_one(K)))
    )
  );
}

def hom_family_independent_step(n : Nat, previous : HomFamilyIndependent(n)) :
  HomFamilyIndependent(succ(n)) {
  intro K;
  intro L;
  intro maps;
  intro distinct;
  intro coefficients;
  intro relation;
  intro index;
  exact match index as i return coefficients(i) = field_zero(L) {
    left u => transport(
      (fun (j : Fin(succ(n))) => coefficients(j) = field_zero(L)), typed(Fin(succ(n)), left(tt)),
      typed(Fin(succ(n)), left(u)),
      cong((fun (v : Unit) => typed(Fin(succ(n)), left(v))), unit_equal(u)),
      hom_family_head_coefficient_zero(n, previous, K, L, maps, distinct, coefficients, relation)
    );
    right j => hom_family_tail_coefficient_zero(
      n, previous, K, L, maps, distinct, coefficients, relation, j
    );
  };
}

// Dedekind's independence theorem for every explicitly finite family of
// pairwise distinct field embeddings into a common field.
def distinct_field_embeddings_independent(n : Nat) =
  induction n as k return HomFamilyIndependent(k) {
    zero => hom_family_independent_zero;
    succ previous => hom_family_independent_step(k, previous);
  };
