import ordered_squares;

// Weak inequalities derived from the constructive ordered-ring interface.
theorem order_le_refl(F : Type1, lt : F -> F -> Type,
  order : StrictOrder(F, lt), x : F) : FieldLe(F, lt, x, x) {
  obtain (prop, (irreflexive, (transitive, (cotransitive, antisymmetric)))) = order;
  exact irreflexive(x);
}
theorem order_le_trans(F : Type1, zero : F, one : F,
  addF : F -> F -> F, mulF : F -> F -> F, lt : F -> F -> Type,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  x : F, y : F, z : F, xy : FieldLe(F, lt, x, y), yz : FieldLe(F, lt, y, z)) :
  FieldLe(F, lt, x, z) {
  obtain (positiveOne, (translate, (scale, (weakScale, (ltLe, (leLt, splitPositive)))))) = arithmetic;
  intro zx;
  exact yz(ltLe(z, x, y, zx, xy));
}
theorem order_le_translate(F : Type1, zero : F, one : F,
  addF : F -> F -> F, mulF : F -> F -> F, lt : F -> F -> Type,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  x : F, y : F, z : F, xy : FieldLe(F, lt, x, y)) :
  FieldLe(F, lt, addF(x, z), addF(y, z)) {
  obtain (positiveOne, (translate, (scale, (weakScale, (ltLe, (leLt, splitPositive)))))) = arithmetic;
  obtain (forward, backward) = translate(y, x, z);
  intro reversed;
  exact xy(backward(reversed));
}
theorem order_le_add(F : Type1, zero : F, one : F,
  addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  lt : F -> F -> Type, ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  x : F, y : F, u : F, v : F, xy : FieldLe(F, lt, x, y), uv : FieldLe(F, lt, u, v)) :
  FieldLe(F, lt, addF(x, u), addF(y, v)) {
  let first = order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, x, y, u, xy);
  let shifted = order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, u, v, y, uv);
  let second = transport((fun (a : F) => FieldLe(F, lt, a, addF(v, y))), addF(u, y), addF(y, u),
    ring_add_comm(F, zero, one, addF, mulF, negF, ring, u, y), shifted);
  let third = transport(FieldLe(F, lt, addF(y, u)), addF(v, y), addF(y, v),
    ring_add_comm(F, zero, one, addF, mulF, negF, ring, v, y), second);
  exact order_le_trans(F, zero, one, addF, mulF, lt, arithmetic, addF(x, u), addF(y, u), addF(y, v), first, third);
}
theorem order_le_add_nonnegative(F : Type1, zero : F, one : F,
  addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  lt : F -> F -> Type, ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  x : F, y : F, nonnegative : FieldLe(F, lt, zero, y)) : FieldLe(F, lt, x, addF(x, y)) {
  let shifted = order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, zero, y, x, nonnegative);
  let first = transport((fun (a : F) => FieldLe(F, lt, a, addF(y, x))), addF(zero, x), x,
    ring_add_zero(F, zero, one, addF, mulF, negF, ring, x), shifted);
  exact transport(FieldLe(F, lt, x), addF(y, x), addF(x, y),
    ring_add_comm(F, zero, one, addF, mulF, negF, ring, y, x), first);
}
theorem order_mul_nonnegative(F : Type1, zero : F, one : F,
  addF : F -> F -> F, mulF : F -> F -> F, negF : F -> F,
  lt : F -> F -> Type, ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  x : F, y : F, nx : FieldLe(F, lt, zero, x), ny : FieldLe(F, lt, zero, y)) : FieldLe(F, lt, zero, mulF(x, y)) {
  obtain (positiveOne, (translate, (scale, (weakScale, (ltLe, (leLt, splitPositive)))))) = arithmetic;
  exact transport((fun (a : F) => FieldLe(F, lt, a, mulF(x, y))), mulF(zero, y), zero,
    ring_zero_mul(F, zero, one, addF, mulF, negF, ring, y), weakScale(zero, x, y, nx, ny));
}
