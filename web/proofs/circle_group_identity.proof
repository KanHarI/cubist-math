import circle;
import group_univalence;

// The existing winding isomorphism now gives a path in the type of groups.
def CircleLoopGroup = group_object(LoopsS1, refl(base), loop_multiply, loop_group);
def IntegerGroup = group_object(Z, zeroZ, addZ, integer_group);
def circle_group_isomorphism = typed(GroupIso(CircleLoopGroup, IntegerGroup),
  (winding, (integer_loop, (integer_loop_winding, (winding_integer_loop, winding_concatenate)))));

def circle_group_identification : CircleLoopGroup = IntegerGroup {
  exact group_identity_encode(CircleLoopGroup, IntegerGroup, circle_group_isomorphism);
}

theorem circle_loop_group_equals_integers : CircleLoopGroup = IntegerGroup {
  exact circle_group_identification;
}

// Reading that equality as an isomorphism recovers the original winding map.
theorem circle_group_identification_recovers_winding :
  group_equality_iso(CircleLoopGroup, IntegerGroup, circle_group_identification) = circle_group_isomorphism {
  exact group_identity_decode_encode(CircleLoopGroup, IntegerGroup, circle_group_isomorphism);
}
