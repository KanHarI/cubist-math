import finite_basis_search;
import span_exchange;
import subgroup_carriers;

// Realize a subspace on its subtype, retaining the ambient scalar action.
def subspace_as_subgroup(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) :
  Subgroup(vector_group(K, V)) {
  let G = vector_group(K, V);
  let X = vector_carrier(K, V);
  let P = subspace_members(K, V, S);
  have inverseClosed :
    forall x : X, forall y : X, P(x) -> vector_add(K, V, y, x) = vector_zero(K, V) -> P(y) {
    intro x;
    intro y;
    intro member;
    intro inverse;
    let same =
      group_inverse_unique(
        X, vector_zero(K, V), vector_add(K, V), group_laws(G), x, y, vector_neg(K, V, x), inverse,
        group_inverse_right(G, x)
      );
    exact transport(P, vector_neg(K, V, x), y, sym(same), subspace_neg(K, V, S, x, member));
  }
  exact (P, subspace_prop(K, V, S), subspace_zero(K, V, S), subspace_add(K, V, S), inverseClosed);
}

def SubspaceCarrier(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) =
  SubgroupCarrier(vector_group(K, V), subspace_as_subgroup(K, V, S));

def subspace_value(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) =
  subgroup_value(vector_group(K, V), subspace_as_subgroup(K, V, S));

def subspace_evidence(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) =
  subgroup_evidence(vector_group(K, V), subspace_as_subgroup(K, V, S));

def subspace_value_ext(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) =
  subgroup_value_ext(vector_group(K, V), subspace_as_subgroup(K, V, S));

def subspace_carrier_scale(
  K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V), a : af_carrier(K),
  x : SubspaceCarrier(K, V, S)
) :
  SubspaceCarrier(K, V, S) {
  exact (
    vector_scale(K, V, a, subspace_value(K, V, S, x)),
    subspace_scale(K, V, S, a, subspace_value(K, V, S, x), subspace_evidence(K, V, S, x))
  );
}

def subspace_carrier_scalar_laws(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) :
  ScalarLaws(
    K, subgroup_as_group(vector_group(K, V), subspace_as_subgroup(K, V, S)),
    subspace_carrier_scale(K, V, S)
  ) {
  let G = subgroup_as_group(vector_group(K, V), subspace_as_subgroup(K, V, S));
  let X = SubspaceCarrier(K, V, S);
  let val = subspace_value(K, V, S);
  let scale = subspace_carrier_scale(K, V, S);
  exact (
    (
      fun (x : X) => subspace_value_ext(
        K, V, S, scale(af_one(af_carrier(K), af_operations(K)), x), x,
        vector_scale_one(K, V, val(x))
      )
    ),
    (
      fun (a : af_carrier(K)) => fun (b : af_carrier(K)) => fun (x : X) => subspace_value_ext(
        K, V, S, scale(af_mul(af_carrier(K), af_operations(K), a, b), x), scale(a, scale(b, x)),
        vector_scale_associative(K, V, a, b, val(x))
      )
    ),
    (
      fun (a : af_carrier(K)) => fun (x : X) => fun (y : X) => subspace_value_ext(
        K, V, S, scale(a, group_multiply(G, x, y)), group_multiply(G, scale(a, x), scale(a, y)),
        vector_scale_add_vectors(K, V, a, val(x), val(y))
      )
    ),
    (
      fun (a : af_carrier(K)) => fun (b : af_carrier(K)) => fun (x : X) => subspace_value_ext(
        K, V, S, scale(af_add(af_carrier(K), af_operations(K), a, b), x),
        group_multiply(G, scale(a, x), scale(b, x)), vector_scale_add_scalars(K, V, a, b, val(x))
      )
    )
  );
}

def SubspaceVectorSpace(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) : VectorSpace(K) {
  let G = subgroup_as_group(vector_group(K, V), subspace_as_subgroup(K, V, S));
  let X = SubspaceCarrier(K, V, S);
  let val = subspace_value(K, V, S);
  exact vector_space(
    K, G, subspace_carrier_scale(K, V, S),
    (
      fun (x : X) => fun (y : X) => subspace_value_ext(
        K, V, S, group_multiply(G, x, y), group_multiply(G, y, x),
        vector_abelian(K, V, val(x), val(y))
      )
    ), subspace_carrier_scalar_laws(K, V, S)
  );
}

def subspace_inclusion_linear(K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V)) :
  LinearMap(K, SubspaceVectorSpace(K, V, S), V) {
  let X = SubspaceCarrier(K, V, S);
  let val = subspace_value(K, V, S);
  exact (
    val, (fun (x : X) => fun (y : X) => refl(vector_add(K, V, val(x), val(y)))),
    (fun (a : af_carrier(K)) => fun (x : X) => refl(vector_scale(K, V, a, val(x))))
  );
}

def finite_subspace(
  K : AlgebraicField, V : VectorSpace(K), finite : FiniteDimensional(K, V), S : Subspace(K, V)
) :
  FiniteDimensional(K, SubspaceVectorSpace(K, V, S)) {
  exact finite_dimensional_injection(
    K, SubspaceVectorSpace(K, V, S), V, subspace_inclusion_linear(K, V, S),
    subspace_value_ext(K, V, S), finite
  );
}

// Finite subspace bases are asserted without selecting a basis globally.
def finite_subspace_basis(
  K : AlgebraicField, V : VectorSpace(K), finite : FiniteDimensional(K, V), S : Subspace(K, V)
) :
  Mere(exists n : Nat, FiniteBasis(K, SubspaceVectorSpace(K, V, S), n)) {
  exact finite_basis_exists(K, SubspaceVectorSpace(K, V, S), finite_subspace(K, V, finite, S));
}
