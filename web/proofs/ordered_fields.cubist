import field_logic;

// Representation-independent algebra. F may live in U0 or U1.
// Neither excluded middle nor choice is part of these assumptions.
def AddLaws(F : U1, zero : F, addF : F -> F -> F, negF : F -> F) =
  (forall x : F, forall y : F, forall z : F, addF(addF(x, y), z) = addF(x, addF(y, z)))
  and (forall x : F, forall y : F, addF(x, y) = addF(y, x)) and (forall x : F, addF(zero, x) = x)
  and (forall x : F, addF(negF(x), x) = zero);

def MulLaws(F : U1, one : F, addF mulF : F -> F -> F) =
  (forall x : F, forall y : F, forall z : F, mulF(mulF(x, y), z) = mulF(x, mulF(y, z)))
  and (forall x : F, forall y : F, mulF(x, y) = mulF(y, x)) and (forall x : F, mulF(one, x) = x)
  and (forall x : F, forall y : F, forall z : F, mulF(x, addF(y, z)) = addF(mulF(x, y), mulF(x, z)));

def CommutativeRing(F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F) =
  FieldSet(F) and AddLaws(F, zero, addF, negF) and MulLaws(F, one, addF, mulF);

def FieldLe(F : U1, lt : F -> F -> U0, x y : F) = lt(y, x) -> Void;

def FieldApart(F : U1, lt : F -> F -> U0, x y : F) = FieldOr(lt(x, y), lt(y, x));

// Cotransitivity is the constructive order law, not decidable trichotomy.
def StrictOrder(F : U1, lt : F -> F -> U0) =
  (forall x : F, forall y : F, FieldProp(lt(x, y))) and (forall x : F, lt(x, x) -> Void)
  and (forall x : F, forall y : F, forall z : F, lt(x, y) -> lt(y, z) -> lt(x, z))
  and (forall x : F, forall y : F, forall z : F, lt(x, y) -> FieldOr(lt(x, z), lt(z, y)))
  and (forall x : F, forall y : F, FieldLe(F, lt, x, y) -> FieldLe(F, lt, y, x) -> x = y);

def FieldLattice(F : U1, lt : F -> F -> U0, minF maxF : F -> F -> F) =
  (forall x : F, forall y : F, FieldLe(F, lt, minF(x, y), x))
  and (forall x : F, forall y : F, FieldLe(F, lt, minF(x, y), y))
  and (
    forall x : F, forall y : F, forall z : F, FieldLe(F, lt, z, x) -> FieldLe(F, lt, z, y)
    -> FieldLe(F, lt, z, minF(x, y))
  ) and (forall x : F, forall y : F, FieldLe(F, lt, x, maxF(x, y)))
  and (forall x : F, forall y : F, FieldLe(F, lt, y, maxF(x, y)))
  and (
    forall x : F, forall y : F, forall z : F, FieldLe(F, lt, x, z) -> FieldLe(F, lt, y, z)
    -> FieldLe(F, lt, maxF(x, y), z)
  );

def OrderedArithmetic(F : U1, zero one : F, addF mulF : F -> F -> F, lt : F -> F -> U0) =
  lt(zero, one)
  and (forall x : F, forall y : F, forall z : F, FieldIff(lt(x, y), lt(addF(x, z), addF(y, z))))
  and (
    forall x : F, forall y : F, forall z : F, lt(zero, z)
    -> FieldIff(lt(x, y), lt(mulF(x, z), mulF(y, z)))
  )
  and (
    forall x : F, forall y : F, forall z : F, FieldLe(F, lt, x, y) -> FieldLe(F, lt, zero, z)
    -> FieldLe(F, lt, mulF(x, z), mulF(y, z))
  ) and (forall x : F, forall y : F, forall z : F, lt(x, y) -> FieldLe(F, lt, y, z) -> lt(x, z))
  and (forall x : F, forall y : F, forall z : F, FieldLe(F, lt, x, y) -> lt(y, z) -> lt(x, z))
  and (forall x : F, forall y : F, lt(zero, addF(x, y)) -> FieldOr(lt(zero, x), lt(zero, y)));

def FieldInverses(F : U1, zero one : F, mulF : F -> F -> F, lt : F -> F -> U0) =
  forall x : F, FieldIff(FieldApart(F, lt, x, zero), (exists y : F, mulF(x, y) = one));

def OrderedField(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, minF maxF : F -> F -> F,
  lt : F -> F -> U0
) =
  CommutativeRing(F, zero, one, addF, mulF, negF) and StrictOrder(F, lt)
  and FieldLattice(F, lt, minF, maxF) and OrderedArithmetic(F, zero, one, addF, mulF, lt)
  and FieldInverses(F, zero, one, mulF, lt);

// Consequences of the interface, usable with every future construction.
def field_add_right_unit(
  F : U1, zero : F, addF : F -> F -> F, negF : F -> F, laws : AddLaws(F, zero, addF, negF), x : F
) :
  addF(x, zero) = x {
  obtain (assoc, comm, unit, additiveInverse) = laws;
  exact trans(comm(x, zero), unit(x));
}

def field_add_cancel(
  F : U1, zero : F, addF : F -> F -> F, negF : F -> F, laws : AddLaws(F, zero, addF, negF),
  x y z : F, same : addF(x, y) = addF(x, z)
) :
  y = z {
  obtain (assoc, comm, unit, additiveInverse) = laws;
  simpa only [<- assoc, additiveInverse, unit] using cong(addF(negF(x)), same);
}

def field_inverse_unique(
  F : U1, one : F, addF mulF : F -> F -> F, laws : MulLaws(F, one, addF, mulF), x y z : F,
  leftLaw : mulF(x, y) = one, rightLaw : mulF(x, z) = one
) :
  y = z {
  obtain (assoc, comm, unit, distribute) = laws;
  simpa only [<- assoc, leftLaw, rightLaw, unit] using cong(mulF(x), comm(z, y));
}

def field_zero_not_one(
  F : U1, zero one : F, lt : F -> F -> U0, order : StrictOrder(F, lt), positive : lt(zero, one)
) :
  (zero = one) -> Void {
  obtain (prop, irreflexive, transitive, cotransitive, antisymmetric) = order;
  intro same;
  exact irreflexive(zero, along((fun (x : F) => lt(zero, x))) by sym(same) from positive);
}
