import suspension;
import integers;
import groups;

// The cover has fiber Z at both poles. Crossing upper applies successor;
// crossing lower leaves the integer unchanged. Univalence uses the
// computational Glue construction, applied to the checked successor equivalence.
def code_meridians(a : S0) = match a return (Z = Z) {
    left point => ua(U0, Z, Z, successor_equivalence);
    right point => refl(Z);
  };

def code(x : S1) = suspension_rec(S0, U0, Z, Z, code_meridians, x);

def encode(x : S1, p : base = x) = transport(code, base, x, p, zeroZ);

def winding(p : base = base) = encode(base, p);

theorem code_meridian(a : S0) = suspension_rec_beta(S0, U0, Z, Z, code_meridians, a);

theorem successor_transport(z : Z) :
  transport((fun (T : U0) => T), Z, Z, ua(U0, Z, Z, successor_equivalence), z) = successorZ(z) {
  exact UnivalenceBeta(U0, Z, Z, successor_equivalence, z);
}

theorem code_upper(z : Z) : transport(code, base, south_pole, upper, z) = successorZ(z) {
  let change_path = fun (p : Z = Z) => transport((fun (T : U0) => T), Z, Z, p, z);
  exact trans(
    transport_ap(S1, code, base, south_pole, upper, z),
    trans(cong(change_path, code_meridian(typed(S0, left(tt)))), successor_transport(z))
  );
}

theorem code_lower(z : Z) : transport(code, base, south_pole, lower, z) = z {
  let change_path = fun (p : Z = Z) => transport((fun (T : U0) => T), Z, Z, p, z);
  exact trans(
    transport_ap(S1, code, base, south_pole, lower, z),
    trans(
      cong(change_path, code_meridian(typed(S0, right(tt)))),
      transport_constant(U0, Z, Z, Z, refl(Z), z)
    )
  );
}

def lower_inverse = inverse(U1, S1, base, south_pole, lower);

def upper_inverse = inverse(U1, S1, base, south_pole, upper);

def loop_inverse = inverse(U1, S1, base, base, loop);

theorem code_lower_inverse(z : Z) : transport(code, south_pole, base, lower_inverse, z) = z {
  let back = fun (v : Z) => transport(code, south_pole, base, lower_inverse, v);
  exact trans(
    sym(cong(back, code_lower(z))), transport_inverse_after(S1, code, base, south_pole, lower, z)
  );
}

theorem code_upper_inverse(z : Z) :
  transport(code, south_pole, base, upper_inverse, z) = predecessorZ(z) {
  let back = transport(code, south_pole, base, upper_inverse, z);
  let forward_back =
    trans(sym(code_upper(back)), transport_after_inverse(S1, code, base, south_pole, upper, z));
  exact trans(sym(predecessor_successor(back)), cong(predecessorZ, forward_back));
}

theorem code_loop(z : Z) : transport(code, base, base, loop, z) = successorZ(z) {
  let back = fun (v : Z) => transport(code, south_pole, base, lower_inverse, v);
  exact trans(
    transport_concat(S1, code, base, south_pole, base, upper, lower_inverse, z),
    trans(cong(back, code_upper(z)), code_lower_inverse(successorZ(z)))
  );
}

theorem code_loop_inverse(z : Z) : transport(code, base, base, loop_inverse, z) = predecessorZ(z) {
  let back = transport(code, base, base, loop_inverse, z);
  let forward_back =
    trans(sym(code_loop(back)), transport_after_inverse(S1, code, base, base, loop, z));
  exact trans(sym(predecessor_successor(back)), cong(predecessorZ, forward_back));
}

theorem winding_generator : winding(loop) = nonnegative(1) {
  exact code_loop(zeroZ);
}

// Turn an integer into a loop by repeating loop, or its inverse.
def positive_loops(n : Nat) = induction n as k return (base = base) {
    zero => refl(base);
    succ previous => concatenate(U1, S1, base, base, base, previous, loop);
  };

def negative_loops(n : Nat) = induction n as k return (base = base) {
    zero => loop_inverse;
    succ previous => concatenate(U1, S1, base, base, base, previous, loop_inverse);
  };

def integer_loop(z : Z) = match z return (base = base) {
    left n => positive_loops(n);
    right n => negative_loops(n);
  };

def winding_positive(n : Nat) =
  induction n as k return (winding(positive_loops(k)) = nonnegative(k)) {
    zero => refl(zeroZ);
    succ previous => trans(
      transport_concat(S1, code, base, base, base, positive_loops(k), loop, zeroZ),
      trans(code_loop(winding(positive_loops(k))), cong(successorZ, previous))
    );
  };

def winding_negative(n : Nat) = induction n as k return (winding(negative_loops(k)) = negative(k)) {
    zero => code_loop_inverse(zeroZ);
    succ previous => trans(
      transport_concat(S1, code, base, base, base, negative_loops(k), loop_inverse, zeroZ),
      trans(code_loop_inverse(winding(negative_loops(k))), cong(predecessorZ, previous))
    );
  };

def winding_integer_loop(z : Z) = match z as w return (winding(integer_loop(w)) = w) {
    left n => winding_positive(n);
    right n => winding_negative(n);
  };

def integer_loop_successor(z : Z) =
  match z as w return (
    integer_loop(successorZ(w)) = concatenate(U1, S1, base, base, base, integer_loop(w), loop)
  ) {
    left n => refl(positive_loops(succ(n)));
    right n => induction n as k return (
      integer_loop(successorZ(negative(k))) = concatenate(
        U1, S1, base, base, base, negative_loops(k), loop
      )
    ) {
      zero => sym(inverse_left(S1, base, base, loop));
      succ previous => sym(append_inverse_cancel(S1, base, base, base, negative_loops(k), loop));
    };
  };

theorem integer_loop_predecessor(z : Z) :
  integer_loop(predecessorZ(z)) = concatenate(
    U1, S1, base, base, base, integer_loop(z), loop_inverse
  ) {
  let previous = integer_loop(predecessorZ(z));
  let step =
    trans(
      sym(integer_loop_successor(predecessorZ(z))), cong(integer_loop, successor_predecessor(z))
    );
  let append_inverse =
    fun (p : base = base) => concatenate(U1, S1, base, base, base, p, loop_inverse);
  exact trans(
    sym(append_cancel_inverse(S1, base, base, base, previous, loop)), cong(append_inverse, step)
  );
}

def south_decoder(z : Z) = concatenate(U1, S1, base, base, south_pole, integer_loop(z), lower);

theorem upper_transition(z : Z) :
  concatenate(U1, S1, base, base, south_pole, integer_loop(predecessorZ(z)), upper) = south_decoder(
    z
  ) {
  let previous = integer_loop(predecessorZ(z));
  let append_previous =
    fun (p : base = south_pole) => concatenate(U1, S1, base, base, south_pole, previous, p);
  let upper_expansion = sym(append_inverse_cancel(S1, base, south_pole, base, upper, lower));
  let step =
    trans(
      sym(integer_loop_successor(predecessorZ(z))), cong(integer_loop, successor_predecessor(z))
    );
  let append_lower = fun (p : base = base) => concatenate(U1, S1, base, base, south_pole, p, lower);
  exact trans(
    cong(append_previous, upper_expansion),
    trans(
      sym(path_associative(S1, base, base, base, south_pole, previous, loop, lower)),
      cong(append_lower, step)
    )
  );
}

// Extend the integer-to-loop map over the entire suspension. These two
// coherence proofs say that it agrees across upper and lower meridians.
def decoder_family(x : S1) = code(x) -> (base = x);

theorem decoder_upper :
  transport(decoder_family, base, south_pole, upper, integer_loop) = south_decoder {
  let transported = transport(decoder_family, base, south_pole, upper, integer_loop);
  let append_upper =
    fun (z : Z) => concatenate(U1, S1, base, base, south_pole, integer_loop(z), upper);
  exact FunExt(
    U0, Z, (fun (z : Z) => base = south_pole), transported, south_decoder,
    (
      fun (z : Z) => trans(
        transport_decoder(S1, base, code, base, south_pole, upper, integer_loop, z),
        trans(cong(append_upper, code_upper_inverse(z)), upper_transition(z))
      )
    )
  );
}

theorem decoder_lower :
  transport(decoder_family, base, south_pole, lower, integer_loop) = south_decoder {
  let transported = transport(decoder_family, base, south_pole, lower, integer_loop);
  let append_lower =
    fun (z : Z) => concatenate(U1, S1, base, base, south_pole, integer_loop(z), lower);
  exact FunExt(
    U0, Z, (fun (z : Z) => base = south_pole), transported, south_decoder,
    (
      fun (z : Z) => trans(
        transport_decoder(S1, base, code, base, south_pole, lower, integer_loop, z),
        cong(append_lower, code_lower_inverse(z))
      )
    )
  );
}

def decoder_meridians(a : S0) =
  match a as label return (
    transport(decoder_family, base, south_pole, meridian(S0, label), integer_loop) = south_decoder
  ) {
    left u => unit_induction(
      (
        fun (point : Unit) => transport(
          decoder_family, base, south_pole, meridian(S0, typed(S0, left(point))), integer_loop
        ) = south_decoder
      ), decoder_upper, u
    );
    right u => unit_induction(
      (
        fun (point : Unit) => transport(
          decoder_family, base, south_pole, meridian(S0, typed(S0, right(point))), integer_loop
        ) = south_decoder
      ), decoder_lower, u
    );
  };

def decode(x : S1) =
  suspension_induction(S0, decoder_family, integer_loop, south_decoder, decoder_meridians, x);

theorem decode_encode(x : S1, p : base = x) : decode(x, encode(x, p)) = p {
  exact based_induction(
    U1, U0, S1, base,
    (fun (point : S1) => fun (path : base = point) => decode(point, encode(point, path)) = path),
    refl(refl(base)), x, p
  );
}

theorem integer_loop_winding(p : base = base) : integer_loop(winding(p)) = p {
  exact decode_encode(base, p);
}

// Concatenation acts as ordinary integer addition, not just as a bijection.
def action_positive(n : Nat, z : Z) =
  induction n as k return (
    transport(code, base, base, positive_loops(k), z) = add_nonnegative(k, z)
  ) {
    zero => transport_constant(S1, Z, base, base, refl(base), z);
    succ previous => trans(
      transport_concat(S1, code, base, base, base, positive_loops(k), loop, z),
      trans(
        code_loop(transport(code, base, base, positive_loops(k), z)), cong(successorZ, previous)
      )
    );
  };

def action_negative(n : Nat, z : Z) =
  induction n as k return (transport(code, base, base, negative_loops(k), z) = add_negative(k, z)) {
    zero => code_loop_inverse(z);
    succ previous => trans(
      transport_concat(S1, code, base, base, base, negative_loops(k), loop_inverse, z),
      trans(
        code_loop_inverse(transport(code, base, base, negative_loops(k), z)),
        cong(predecessorZ, previous)
      )
    );
  };

def action_integer(x : Z, y : Z) =
  match y as w return (transport(code, base, base, integer_loop(w), x) = addZ(x, w)) {
    left n => action_positive(n, x);
    right n => action_negative(n, x);
  };

theorem winding_concatenate(p : base = base, q : base = base) :
  winding(concatenate(U1, S1, base, base, base, p, q)) = addZ(winding(p), winding(q)) {
  let act = fun (r : base = base) => transport(code, base, base, r, winding(p));
  exact trans(
    transport_concat(S1, code, base, base, base, p, q, zeroZ),
    trans(cong(act, sym(integer_loop_winding(q))), action_integer(winding(p), winding(q)))
  );
}

// Setness justifies using the loop space itself as the fundamental group:
// its set-truncation is equivalent to it. No higher paths are silently erased.
def LoopsS1 = base = base;

def loop_multiply(p : LoopsS1, q : LoopsS1) = concatenate(U1, S1, base, base, base, p, q);

def loop_equal_decidable(p : LoopsS1, q : LoopsS1) =
  match integer_equal_decidable(winding(p), winding(q)) return Decidable(p = q) {
    left h => typed(
      Decidable(p = q),
      left(
        trans(
          sym(integer_loop_winding(p)),
          trans(cong(integer_loop, typed((winding(p) = winding(q)), h)), integer_loop_winding(q))
        )
      )
    );
    right no => typed(Decidable(p = q), right(fun (h : p = q) => no(cong(winding, h))));
  };

theorem loops_are_a_set : IsSet(LoopsS1) {
  exact hedberg(LoopsS1, loop_equal_decidable);
}

theorem loop_group : GroupLaws(LoopsS1, refl(base), loop_multiply) {
  exact (
    loops_are_a_set,
    (
      fun (p : LoopsS1) => fun (q : LoopsS1) => fun (r : LoopsS1) => path_associative(
        S1, base, base, base, base, p, q, r
      )
    ), (fun (p : LoopsS1) => left_unit(S1, base, base, p)),
    (fun (p : LoopsS1) => right_unit(S1, base, base, p)),
    (
      fun (p : LoopsS1) => typed(
        (
          exists q : LoopsS1, (loop_multiply(q, p) = refl(base))
          and (loop_multiply(p, q) = refl(base))
        ), (sym(p), inverse_left(S1, base, base, p), inverse_right(S1, base, base, p))
      )
    )
  );
}

theorem integer_loop_add(x : Z, y : Z) :
  integer_loop(addZ(x, y)) = loop_multiply(integer_loop(x), integer_loop(y)) {
  let p = integer_loop(x);
  let q = integer_loop(y);
  let h =
    trans(
      winding_concatenate(p, q),
      trans(
        cong((fun (v : Z) => addZ(v, winding(q))), winding_integer_loop(x)),
        cong((fun (v : Z) => addZ(x, v)), winding_integer_loop(y))
      )
    );
  exact trans(cong(integer_loop, sym(h)), integer_loop_winding(loop_multiply(p, q)));
}

theorem reflect_integer_path(x : Z, y : Z, h : integer_loop(x) = integer_loop(y)) : x = y {
  exact trans(sym(winding_integer_loop(x)), trans(cong(winding, h), winding_integer_loop(y)));
}

theorem addition_associative(x : Z, y : Z, z : Z) : addZ(addZ(x, y), z) = addZ(x, addZ(y, z)) {
  let p = integer_loop(x);
  let q = integer_loop(y);
  let r = integer_loop(z);
  let append_r = fun (s : LoopsS1) => loop_multiply(s, r);
  let prepend_p = fun (s : LoopsS1) => loop_multiply(p, s);
  exact reflect_integer_path(
    addZ(addZ(x, y), z), addZ(x, addZ(y, z)),
    trans(
      integer_loop_add(addZ(x, y), z),
      trans(
        cong(append_r, integer_loop_add(x, y)),
        trans(
          path_associative(S1, base, base, base, base, p, q, r),
          trans(cong(prepend_p, sym(integer_loop_add(y, z))), sym(integer_loop_add(x, addZ(y, z))))
        )
      )
    )
  );
}

theorem addition_left_zero(x : Z) : addZ(zeroZ, x) = x {
  exact reflect_integer_path(
    addZ(zeroZ, x), x, trans(integer_loop_add(zeroZ, x), left_unit(S1, base, base, integer_loop(x)))
  );
}

def inverse_integer(x : Z) = winding(sym(integer_loop(x)));

theorem addition_inverse_left(x : Z) : addZ(inverse_integer(x), x) = zeroZ {
  let p = integer_loop(x);
  exact trans(
    cong((fun (v : Z) => addZ(inverse_integer(x), v)), sym(winding_integer_loop(x))),
    trans(sym(winding_concatenate(sym(p), p)), cong(winding, inverse_left(S1, base, base, p)))
  );
}

theorem addition_inverse_right(x : Z) : addZ(x, inverse_integer(x)) = zeroZ {
  let p = integer_loop(x);
  exact trans(
    cong((fun (v : Z) => addZ(v, inverse_integer(x))), sym(winding_integer_loop(x))),
    trans(sym(winding_concatenate(p, sym(p))), cong(winding, inverse_right(S1, base, base, p)))
  );
}

theorem integer_group : GroupLaws(Z, zeroZ, addZ) {
  exact (
    integers_are_a_set, addition_associative, addition_left_zero, (fun (x : Z) => refl(x)),
    (
      fun (x : Z) => typed(
        (exists y : Z, (addZ(y, x) = zeroZ) and (addZ(x, y) = zeroZ)),
        (inverse_integer(x), addition_inverse_left(x), addition_inverse_right(x))
      )
    )
  );
}

// The final statement includes both group structures and a multiplication-
// preserving bijection, not merely a winding-number function.
def FundamentalGroupS1IsZ =
  GroupLaws(LoopsS1, refl(base), loop_multiply) and GroupLaws(Z, zeroZ, addZ)
  and GroupIsomorphism(LoopsS1, loop_multiply, Z, addZ);

theorem fundamental_group_of_circle : FundamentalGroupS1IsZ {
  exact (
    loop_group, integer_group, winding, integer_loop, integer_loop_winding, winding_integer_loop,
    winding_concatenate
  );
}
