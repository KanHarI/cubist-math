import order_maps;
import field_extensionality;
import classical;

def order_prop(A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le)) :
  forall x : A, forall y : A, FieldProp(le(x, y)) {
  obtain ((prop, reflexive, transitive), antisymmetric) = laws;
  exact prop;
}

def order_refl(A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le)) :
  OrderReflexive(A, le) {
  obtain ((prop, reflexive, transitive), antisymmetric) = laws;
  exact reflexive;
}

def order_trans(A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le)) :
  OrderTransitive(A, le) {
  obtain ((prop, reflexive, transitive), antisymmetric) = laws;
  exact transitive;
}

def order_antisym(A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le)) :
  OrderAntisymmetric(A, le) {
  obtain ((prop, reflexive, transitive), antisymmetric) = laws;
  exact antisymmetric;
}

def OrderChain(A : U1, le : OrderRelation(A), C : A -> U0) =
  forall x : A, forall y : A, C(x) -> C(y) -> FieldOr(le(x, y), le(y, x));

def ChainSupremum(A : U1, le : OrderRelation(A), C : A -> U0) =
  exists s : A, (forall x : A, C(x) -> le(x, s))
  and (forall z : A, (forall x : A, C(x) -> le(x, z)) -> le(s, z));

// Includes the empty chain. Its supremum is the least element.
def ChainComplete(A : U1, le : OrderRelation(A)) =
  forall C : A -> U0, OrderChain(A, le, C) -> ChainSupremum(A, le, C);

def chain_sup(
  A : U1, le : OrderRelation(A), complete : ChainComplete(A, le), C : A -> U0,
  chain : OrderChain(A, le, C)
) =
  field_first(
    A,
    (
      fun (s : A) => (forall x : A, C(x) -> le(x, s))
      and (forall z : A, (forall x : A, C(x) -> le(x, z)) -> le(s, z))
    ), complete(C, chain)
  );

def chain_sup_laws(
  A : U1, le : OrderRelation(A), complete : ChainComplete(A, le), C : A -> U0,
  chain : OrderChain(A, le, C)
) =
  field_second(
    A,
    (
      fun (s : A) => (forall x : A, C(x) -> le(x, s))
      and (forall z : A, (forall x : A, C(x) -> le(x, z)) -> le(s, z))
    ), complete(C, chain)
  );

def chain_sup_upper(
  A : U1, le : OrderRelation(A), complete : ChainComplete(A, le), C : A -> U0,
  chain : OrderChain(A, le, C)
) :
  forall x : A, C(x) -> le(x, chain_sup(A, le, complete, C, chain)) {
  obtain (upper, least) = chain_sup_laws(A, le, complete, C, chain);
  exact upper;
}

def chain_sup_least(
  A : U1, le : OrderRelation(A), complete : ChainComplete(A, le), C : A -> U0,
  chain : OrderChain(A, le, C)
) :
  forall z : A, (forall x : A, C(x) -> le(x, z)) -> le(chain_sup(A, le, complete, C, chain), z) {
  obtain (upper, least) = chain_sup_laws(A, le, complete, C, chain);
  exact least;
}

def Progressive(A : U1, le : OrderRelation(A), f : A -> A) = forall x : A, le(x, f(x));

// Binary propositional elimination, allowing a U1 target.
def field_or_elim(
  P Q R : U1, prop : FieldProp(R), leftCase : P -> R, rightCase : Q -> R, h : FieldOr(P, Q)
) :
  R {
  exact field_exists_elim(P or Q, R, prop, (fun (side : P or Q) => match side return R {
        left p => leftCase(p);
        right q => rightCase(q);
      }), h);
}

def field_and_prop(P Q : U1, propP : FieldProp(P), propQ : FieldProp(Q), a b : P and Q) : a = b {
  exact path t => typed(
    P and Q,
    (
      propP(field_fst(P, Q, a), field_fst(P, Q, b)) @ t,
      propQ(field_snd(P, Q, a), field_snd(P, Q, b)) @ t
    )
  );
}

// A weakly constant family of maps on paths makes the carrier a set.
// Normalization at reflexivity is proved by path induction, not assumed.
def collapse_path(A : U1, h : (forall x : A, forall y : A, (x = y) -> (x = y)), x y : A, p : x = y) =
  trans(sym(h(x, x, refl(x))), h(x, y, p));

def collapse_path_recovers(
  A : U1, h : (forall x : A, forall y : A, (x = y) -> (x = y)), x y : A, p : x = y
) :
  collapse_path(A, h, x, y, p) = p {
  exact based_induction(
    U1, U1, A, x, (fun (z : A) (q : x = z) => collapse_path(A, h, x, z, q) = q),
    inverse_left(A, x, x, h(x, x, refl(x))), y, p
  );
}

def weak_path_collapser_set(
  A : U1, h : (forall x : A, forall y : A, (x = y) -> (x = y)),
  constant : (
    forall x : A, forall y : A, forall p : x = y, forall q : x = y, h(x, y, p) = h(x, y, q)
  )
) :
  FieldSet(A) {
  intro x y p q;
  exact trans(
    sym(collapse_path_recovers(A, h, x, y, p)),
    trans(
      cong((fun (r : x = y) => trans(sym(h(x, x, refl(x))), r)), constant(x, y, p, q)),
      collapse_path_recovers(A, h, x, y, q)
    )
  );
}

def order_path_collapse(
  A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le), x y : A, p : x = y
) =
  order_antisym(
    A, le, laws, x, y, along le(x) by p from order_refl(A, le, laws, x),
    along((fun (z : A) => le(z, x))) by p from order_refl(A, le, laws, x)
  );

def partial_order_is_set(A : U1, le : OrderRelation(A), laws : PartialOrderLaws(A, le)) :
  FieldSet(A) {
  have constant :
    forall x : A, forall y : A, forall p : x = y, forall q : x = y,
    order_path_collapse(A, le, laws, x, y, p) = order_path_collapse(A, le, laws, x, y, q) {
    intro x y p q;
    let forward = fun (r : x = y) => along le(x) by r from order_refl(A, le, laws, x);
    let backward =
      fun (r : x = y) => along((fun (z : A) => le(z, x))) by r from order_refl(A, le, laws, x);
    exact trans(
      cong(
        (fun (a : le(x, y)) => order_antisym(A, le, laws, x, y, a, backward(p))),
        order_prop(A, le, laws, x, y, forward(p), forward(q))
      ),
      cong(
        order_antisym(A, le, laws, x, y, forward(q)),
        order_prop(A, le, laws, y, x, backward(p), backward(q))
      )
    );
  }
  exact weak_path_collapser_set(A, order_path_collapse(A, le, laws), constant);
}

def field_subtype_is_set(
  A : U1, P : A -> U1, setA : FieldSet(A), prop : (forall x : A, FieldProp(P(x)))
) :
  FieldSet(exists x : A, P(x)) {
  let S = exists x : A, P(x);
  let first = field_first(A, P);
  let h = fun (x y : S) (p : x = y) => field_subtype_ext(A, P, prop, x, y, cong(first, p));
  exact weak_path_collapser_set(
    S, h,
    (
      fun (x y : S) (p q : x = y) => cong(
        field_subtype_ext(A, P, prop, x, y),
        setA(first(x), first(y), cong(first, p), cong(first, q))
      )
    )
  );
}
