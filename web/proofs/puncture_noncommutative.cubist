import bouquet_actions;
import puncture_winding;
import finite_cancellation;

// Two generators act as the transpositions (0 1) and (0 2) on three states.
// A nontrivial action witnesses a nontrivial loop, without a free-group axiom.
def first_puncture = typed(Unit or Fin(1), left(tt));

def second_puncture = typed(Unit or Fin(1), right(typed(Unit or Void, left(tt))));

def first_second_different(p : first_puncture = second_puncture) =
  sum_disjoint(Fin(1), tt, typed(Unit or Void, left(tt)), p);

def second_first_different(p : second_puncture = first_puncture) = first_second_different(sym(p));

def state_zero = typed(Unit or Fin(2), left(tt));

def state_one = typed(Unit or Fin(2), right(first_puncture));

def state_two = typed(Unit or Fin(2), right(second_puncture));

def first_permutation =
  bijection_equiv(
    Fin(3), Fin(3), fin_is_set(3), swap_bijection(Fin(2), fin_decidable(2), state_one)
  );

def second_permutation =
  bijection_equiv(
    Fin(3), Fin(3), fin_is_set(3), swap_bijection(Fin(2), fin_decidable(2), state_two)
  );

def puncture_permutations(label : Fin(2)) =
  match typed(Unit or Fin(1), label) return Equiv(U0, Fin(3), Fin(3)) {
    left u => first_permutation;
    right tail => match typed(Unit or Void, tail) return Equiv(U0, Fin(3), Fin(3)) {
      left u => second_permutation;
      right impossible => absurd(impossible);
    };
  };

def first_puncture_loop = puncture_loop(2, first_puncture);

def second_puncture_loop = puncture_loop(2, second_puncture);

def two_loop_product(p : BouquetLoops(Fin(2)), q : BouquetLoops(Fin(2))) =
  append_path(
    PunctureGraph(2), bouquet_base(Fin(2)), bouquet_base(Fin(2)), bouquet_base(Fin(2)), p, q
  );

def two_loop_inverse(p : BouquetLoops(Fin(2))) =
  inverse(U1, PunctureGraph(2), bouquet_base(Fin(2)), bouquet_base(Fin(2)), p);

def puncture_ab = two_loop_product(first_puncture_loop, second_puncture_loop);

def puncture_aba_inverse = two_loop_product(puncture_ab, two_loop_inverse(first_puncture_loop));

def puncture_commutator =
  two_loop_product(puncture_aba_inverse, two_loop_inverse(second_puncture_loop));

def three_state_action(p : BouquetLoops(Fin(2)), v : Fin(3)) =
  loop_action(Fin(2), Fin(3), puncture_permutations, p, v);

theorem puncture_ab_action : three_state_action(puncture_ab, state_zero) = state_one {
  exact trans(
    loop_action_append(
      Fin(2), Fin(3), puncture_permutations, first_puncture_loop, second_puncture_loop, state_zero
    ),
    trans(
      cong(
        (fun (v : Fin(3)) => three_state_action(second_puncture_loop, v)),
        loop_action_generator(Fin(2), Fin(3), puncture_permutations, first_puncture, state_zero)
      ),
      trans(
        loop_action_generator(Fin(2), Fin(3), puncture_permutations, second_puncture, state_one),
        swap_tail_different(
          Fin(2), second_puncture, first_puncture,
          fin_decidable(2, second_puncture, first_puncture), second_first_different
        )
      )
    )
  );
}

theorem puncture_aba_inverse_action :
  three_state_action(puncture_aba_inverse, state_zero) = state_zero {
  exact trans(
    loop_action_append(
      Fin(2), Fin(3), puncture_permutations, puncture_ab, two_loop_inverse(first_puncture_loop),
      state_zero
    ),
    trans(
      cong(
        (fun (v : Fin(3)) => three_state_action(two_loop_inverse(first_puncture_loop), v)),
        puncture_ab_action
      ),
      trans(
        loop_action_inverse(Fin(2), Fin(3), puncture_permutations, first_puncture, state_one),
        swap_tail_equal(
          Fin(2), first_puncture, first_puncture, fin_decidable(2, first_puncture, first_puncture),
          refl(first_puncture)
        )
      )
    )
  );
}

theorem puncture_commutator_action : three_state_action(puncture_commutator, state_zero) = state_two {
  exact trans(
    loop_action_append(
      Fin(2), Fin(3), puncture_permutations, puncture_aba_inverse,
      two_loop_inverse(second_puncture_loop), state_zero
    ),
    trans(
      cong(
        (fun (v : Fin(3)) => three_state_action(two_loop_inverse(second_puncture_loop), v)),
        puncture_aba_inverse_action
      ), loop_action_inverse(Fin(2), Fin(3), puncture_permutations, second_puncture, state_zero)
    )
  );
}

theorem puncture_commutator_nontrivial : (puncture_commutator = refl(bouquet_base(Fin(2)))) -> Void {
  intro collapsed;
  let impossible =
    trans(
      sym(puncture_commutator_action),
      cong((fun (p : BouquetLoops(Fin(2))) => three_state_action(p, state_zero)), collapsed)
    );
  exact sum_disjoint(Fin(2), tt, second_puncture, sym(impossible));
}

theorem puncture_generators_do_not_commute :
  (
    two_loop_product(first_puncture_loop, second_puncture_loop) = two_loop_product(
      second_puncture_loop, first_puncture_loop
    )
  ) -> Void {
  intro commuted;
  have reverseAction :
    three_state_action(two_loop_product(second_puncture_loop, first_puncture_loop), state_zero) = state_two {
    exact trans(
      loop_action_append(
        Fin(2), Fin(3), puncture_permutations, second_puncture_loop, first_puncture_loop, state_zero
      ),
      trans(
        cong(
          (fun (v : Fin(3)) => three_state_action(first_puncture_loop, v)),
          loop_action_generator(Fin(2), Fin(3), puncture_permutations, second_puncture, state_zero)
        ),
        trans(
          loop_action_generator(Fin(2), Fin(3), puncture_permutations, first_puncture, state_two),
          swap_tail_different(
            Fin(2), first_puncture, second_puncture,
            fin_decidable(2, first_puncture, second_puncture), first_second_different
          )
        )
      )
    );
  }
  let impossible =
    trans(
      sym(puncture_ab_action),
      trans(
        cong((fun (p : BouquetLoops(Fin(2))) => three_state_action(p, state_zero)), commuted),
        reverseAction
      )
    );
  exact sum_disjoint(
    Fin(1), tt, typed(Unit or Void, left(tt)),
    tail_injective(Fin(2), first_puncture, second_puncture, impossible)
  );
}

theorem commutator_first_winding_zero :
  puncture_winding(2, first_puncture, puncture_commutator) = zeroZ {
  let abValue =
    puncture_winding_append_values(
      2, first_puncture, first_puncture_loop, second_puncture_loop, nonnegative(1), zeroZ,
      puncture_winding_self(2, first_puncture),
      puncture_winding_other(2, first_puncture, second_puncture, first_second_different)
    );
  let abaValue =
    puncture_winding_append_values(
      2, first_puncture, puncture_ab, two_loop_inverse(first_puncture_loop), nonnegative(1),
      negative(0), abValue, puncture_winding_reverse_self(2, first_puncture)
    );
  exact puncture_winding_append_values(
    2, first_puncture, puncture_aba_inverse, two_loop_inverse(second_puncture_loop), zeroZ, zeroZ,
    abaValue,
    puncture_winding_reverse_other(2, first_puncture, second_puncture, first_second_different)
  );
}

theorem commutator_second_winding_zero :
  puncture_winding(2, second_puncture, puncture_commutator) = zeroZ {
  let abValue =
    puncture_winding_append_values(
      2, second_puncture, first_puncture_loop, second_puncture_loop, zeroZ, nonnegative(1),
      puncture_winding_other(2, second_puncture, first_puncture, second_first_different),
      puncture_winding_self(2, second_puncture)
    );
  let abaValue =
    puncture_winding_append_values(
      2, second_puncture, puncture_ab, two_loop_inverse(first_puncture_loop), nonnegative(1), zeroZ,
      abValue,
      puncture_winding_reverse_other(2, second_puncture, first_puncture, second_first_different)
    );
  exact puncture_winding_append_values(
    2, second_puncture, puncture_aba_inverse, two_loop_inverse(second_puncture_loop),
    nonnegative(1), negative(0), abaValue, puncture_winding_reverse_self(2, second_puncture)
  );
}

theorem commutator_all_windings_zero(selected : Fin(2)) :
  puncture_winding(2, selected, puncture_commutator) = zeroZ {
  exact match typed(Unit or Fin(1), selected) as label return (
    puncture_winding(2, label, puncture_commutator) = zeroZ
  ) {
    left u => unit_induction(
      (
        fun (v : Unit) => puncture_winding(2, typed(Unit or Fin(1), left(v)), puncture_commutator) = zeroZ
      ), commutator_first_winding_zero, u
    );
    right tail => match typed(Unit or Void, tail) as value return (
      puncture_winding(2, typed(Unit or Fin(1), right(value)), puncture_commutator) = zeroZ
    ) {
      left u => unit_induction(
        (
          fun (v : Unit) => puncture_winding(
            2, typed(Unit or Fin(1), right(typed(Unit or Void, left(v)))), puncture_commutator
          ) = zeroZ
        ), commutator_second_winding_zero, u
      );
      right impossible => absurd(impossible);
    };
  };
}

// A checked counterexample to identifying homotopy classes by winding vectors.
theorem winding_vector_does_not_classify_loops :
  exists p : BouquetLoops(Fin(2)),
  (forall selected : Fin(2), puncture_winding(2, selected, p) = zeroZ)
  and ((p = refl(bouquet_base(Fin(2)))) -> Void) {
  exact (puncture_commutator, commutator_all_windings_zero, puncture_commutator_nontrivial);
}
