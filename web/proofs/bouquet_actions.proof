import puncture_graph;
import prelude;

def action_forward(F : Type, e : Equiv(F, F)) : F -> F { exact equivalence_function(F, F, e); }
def action_backward(F : Type, e : Equiv(F, F)) : F -> F { exact equivalence_inverse(F, F, e); }
def action_left_law(F : Type, e : Equiv(F, F)) : forall v : F, action_backward(F, e, action_forward(F, e, v)) = v {
  exact equivalence_left(F, F, e);
}

// A family of equivalences gives a local system on the bouquet. Transport
// around a generator performs its specified action on the fiber.
def action_edges(A : Type, F : Type, actions : A -> Equiv(F, F), label : Unit or A) =
  match label return (F = F) { left u => refl(F); right a => univalence(F, F, actions(a)); };
def action_family(A : Type, F : Type, actions : A -> Equiv(F, F)) =
  suspension_rec(Unit or A, Type, F, F, action_edges(A, F, actions));
theorem action_univalence(A : Type, F : Type, actions : A -> Equiv(F, F), a : A, v : F) :
  transport((fun (T : Type) => T), F, F, univalence(F, F, actions(a)), v) = action_forward(F, actions(a), v) {
  exact univalence_beta(F, F, actions(a), v);
}
theorem action_spoke(A : Type, F : Type, actions : A -> Equiv(F, F), v : F) :
  transport(action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A), v) = v {
  exact trans(transport_ap(Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A), v),
    cong((fun (p : F = F) => transport((fun (T : Type) => T), F, F, p, v)),
      suspension_rec_beta(Unit or A, Type, F, F, action_edges(A, F, actions), typed(Unit or A, left(tt)))));
}
theorem action_spoke_inverse(A : Type, F : Type, actions : A -> Equiv(F, F), v : F) :
  transport(action_family(A, F, actions), bouquet_tip(A), bouquet_base(A), inverse(Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A)), v) = v {
  let before = transport(action_family(A, F, actions), bouquet_tip(A), bouquet_base(A), inverse(Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A)), v);
  exact trans(sym(action_spoke(A, F, actions, before)), transport_after_inverse(Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A), v));
}
theorem action_edge(A : Type, F : Type, actions : A -> Equiv(F, F), a : A, v : F) :
  transport(action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_edge(A, a), v) = action_forward(F, actions(a), v) {
  exact trans(transport_ap(Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_edge(A, a), v),
    trans(cong((fun (p : F = F) => transport((fun (T : Type) => T), F, F, p, v)),
      suspension_rec_beta(Unit or A, Type, F, F, action_edges(A, F, actions), typed(Unit or A, right(a)))), action_univalence(A, F, actions, a, v)));
}
def loop_action(A : Type, F : Type, actions : A -> Equiv(F, F), p : BouquetLoops(A), v : F) =
  transport(action_family(A, F, actions), bouquet_base(A), bouquet_base(A), p, v);
theorem loop_action_generator(A : Type, F : Type, actions : A -> Equiv(F, F), a : A, v : F) :
  loop_action(A, F, actions, bouquet_generator(A, a), v) = action_forward(F, actions(a), v) {
  exact trans(transport_concat(Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_base(A), bouquet_edge(A, a),
    inverse(Bouquet(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A)), v),
    trans(action_spoke_inverse(A, F, actions, transport(action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_edge(A, a), v)), action_edge(A, F, actions, a, v)));
}
theorem loop_action_inverse(A : Type, F : Type, actions : A -> Equiv(F, F), a : A, v : F) :
  loop_action(A, F, actions, inverse(Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a)), v) = action_backward(F, actions(a), v) {
  let before = loop_action(A, F, actions, inverse(Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a)), v);
  let same = trans(sym(loop_action_generator(A, F, actions, a, before)),
    transport_after_inverse(Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a), v));
  exact trans(sym(action_left_law(F, actions(a), before)),
    cong(action_backward(F, actions(a)), same));
}
theorem loop_action_append(A : Type, F : Type, actions : A -> Equiv(F, F), p : BouquetLoops(A), q : BouquetLoops(A), v : F) :
  loop_action(A, F, actions, append_path(Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), p, q), v) =
  loop_action(A, F, actions, q, loop_action(A, F, actions, p, v)) {
  exact trans(cong((fun (r : BouquetLoops(A)) => loop_action(A, F, actions, r, v)), append_path_agrees(Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), p, q)),
    transport_concat(Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_base(A), bouquet_base(A), p, q, v));
}
