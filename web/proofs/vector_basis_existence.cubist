import independent_extension;
import zorn_chain_complete;

// A chain presented as a predicate gives the indexed family used by the
// previously checked independent-union construction. Its indices live in U1.
def IndependentChainIndex(K : AlgebraicField, V : VectorSpace(K), C : IndependentSubset(K, V) -> U0) =
  exists S : IndependentSubset(K, V), C(S);

def independent_chain_member(
  K : AlgebraicField, V : VectorSpace(K), C : IndependentSubset(K, V) -> U0,
  i : IndependentChainIndex(K, V, C)
) =
  field_first(IndependentSubset(K, V), (fun (S : IndependentSubset(K, V)) => typed(U1, C(S))), i);

def independent_chain_evidence(
  K : AlgebraicField, V : VectorSpace(K), C : IndependentSubset(K, V) -> U0,
  i : IndependentChainIndex(K, V, C)
) =
  field_second(IndependentSubset(K, V), (fun (S : IndependentSubset(K, V)) => typed(U1, C(S))), i);

def independent_indexed_chain(
  K : AlgebraicField, V : VectorSpace(K), C : IndependentSubset(K, V) -> U0,
  chain : OrderChain(IndependentSubset(K, V), IndependentIncluded(K, V), C)
) :
  PredicateChain(
    IndependentChainIndex(K, V, C), vector_carrier(K, V),
    (
      fun (i : IndependentChainIndex(K, V, C)) => independent_members(
        K, V, independent_chain_member(K, V, C, i)
      )
    )
  ) {
  intro i;
  intro j;
  exact chain(
    independent_chain_member(K, V, C, i), independent_chain_member(K, V, C, j),
    independent_chain_evidence(K, V, C, i), independent_chain_evidence(K, V, C, j)
  );
}

def independent_chain_complete(K : AlgebraicField, V : VectorSpace(K)) :
  ChainComplete(IndependentSubset(K, V), IndependentIncluded(K, V)) {
  intro C;
  intro chain;
  let A = IndependentSubset(K, V);
  let I = IndependentChainIndex(K, V, C);
  let family = independent_chain_member(K, V, C);
  let indexed = independent_indexed_chain(K, V, C, chain);
  let union = IndependentUnion(K, V, I, family, indexed);
  have upper : forall S : A, C(S) -> IndependentIncluded(K, V, S, union) {
    intro S;
    intro cs;
    exact independent_union_upper(K, V, I, family, indexed, typed(I, (S, cs)));
  }
  have least :
    forall T : A, (forall S : A, C(S) -> IndependentIncluded(K, V, S, T))
    -> IndependentIncluded(K, V, union, T) {
    intro T;
    intro bound;
    exact independent_union_least(
      K, V, I, family, indexed, T,
      (fun (i : I) => bound(family(i), independent_chain_evidence(K, V, C, i)))
    );
  }
  exact (union, upper, least);
}

// Every vector space over a supplied small field has a basis. Existence is
// mere: the theorem does not select coordinates or a preferred basis.
// The only classical assumptions are the existing Choice and LEM schemas;
// maximality is proved through the chain-complete form of Zorn above.
def vector_space_has_basis(K : AlgebraicField, V : VectorSpace(K)) : FieldExists(VectorBasis(K, V)) {
  let A = IndependentSubset(K, V);
  let le = IndependentIncluded(K, V);
  let Maximal = exists S : A, OrderMaximal(A, le, S);
  have toBasis : Maximal -> VectorBasis(K, V) {
    intro witness;
    obtain (S, maximal) = witness;
    exact maximal_independent_basis(K, V, S, maximal);
  }
  exact field_exists_map(
    Maximal, VectorBasis(K, V), toBasis,
    zorn_chain_complete(A, le, independent_partial_order(K, V), independent_chain_complete(K, V))
  );
}
