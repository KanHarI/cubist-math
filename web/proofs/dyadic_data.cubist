import dyadic_mesh;

// The actual samples produced by the checked recursive construction.
def dyadic_piece(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), depth : Nat,
  a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) =
  dyadic_samples_piece(
    F, zero, one, addF, negF, lt, half, depth, a, b,
    dyadic_interval_samples(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    )
  );

def dyadic_children_join(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), depth : Nat,
  a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) :
  SampleSubdivision(FieldUnitInterval(F, zero, one, lt), a, b) {
  let midpoint =
    interval_midpoint_point(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, a, b, ordered
    );
  let leftOrdered =
    interval_midpoint_left_order(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, a, b, ordered
    );
  let rightOrdered =
    interval_midpoint_right_order(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, a, b, ordered
    );
  exact join_subdivisions(
    FieldUnitInterval(F, zero, one, lt), a, midpoint, b,
    dyadic_piece(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a,
      midpoint, leftOrdered
    ),
    dyadic_piece(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, midpoint,
      b, rightOrdered
    )
  );
}

// These equations are checked by conversion of the actual constructed terms.
def dyadic_piece_zero(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) :
  dyadic_piece(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, 0, a, b, ordered
  ) = single_edge_subdivision(FieldUnitInterval(F, zero, one, lt), a, b) {
  exact refl(single_edge_subdivision(FieldUnitInterval(F, zero, one, lt), a, b));
}

def dyadic_piece_succ(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), depth : Nat,
  a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) :
  dyadic_piece(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, succ(depth), a, b,
    ordered
  ) = dyadic_children_join(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b, ordered
  ) {
  exact refl(
    dyadic_children_join(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    )
  );
}

def dyadic_piece_count(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), depth : Nat,
  a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) :
  subdivision_count(
    FieldUnitInterval(F, zero, one, lt), a, b,
    dyadic_piece(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    )
  ) = dyadic_count(depth) {
  exact dyadic_samples_count(
    F, zero, one, addF, negF, lt, half, depth, a, b,
    dyadic_interval_samples(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    )
  );
}

def dyadic_piece_valid(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), depth : Nat,
  a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) :
  SubdivisionTaggedValid(
    FieldUnitInterval(F, zero, one, lt),
    IntervalTaggedWidth(
      F, zero, one, addF, negF, lt,
      dyadic_width(F, half, depth, interval_difference(F, zero, one, addF, negF, lt)(a, b))
    ), a, b,
    dyadic_piece(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    )
  ) {
  exact dyadic_samples_valid(
    F, zero, one, addF, negF, lt, half, depth, a, b,
    dyadic_interval_samples(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    )
  );
}

def dyadic_piece_admissible(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), depth : Nat,
  a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) :
  IntervalAdmissibleTags(
    F, zero, one, lt,
    subdivision_count(
      FieldUnitInterval(F, zero, one, lt), a, b,
      dyadic_piece(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
        ordered
      )
    ),
    subdivision_vertices(
      FieldUnitInterval(F, zero, one, lt), a, b,
      dyadic_piece(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
        ordered
      )
    ),
    subdivision_tags(
      FieldUnitInterval(F, zero, one, lt), a, b,
      dyadic_piece(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
        ordered
      )
    )
  ) {
  let piece =
    dyadic_piece(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    );
  exact interval_tagged_width_admissible(
    F, zero, one, addF, negF, lt,
    dyadic_width(F, half, depth, interval_difference(F, zero, one, addF, negF, lt)(a, b)),
    subdivision_count(FieldUnitInterval(F, zero, one, lt), a, b, piece),
    subdivision_vertices(FieldUnitInterval(F, zero, one, lt), a, b, piece),
    subdivision_tags(FieldUnitInterval(F, zero, one, lt), a, b, piece),
    dyadic_piece_valid(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, depth, a, b,
      ordered
    )
  );
}
