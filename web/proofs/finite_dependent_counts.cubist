import finite_cardinalities;
import function_counting;

// Finite choice is proved by induction. No Choice axiom is needed to select
// one witness from each member of a supplied finite enumeration.
def finite_mere_choice_zero(P : Fin(0) -> U0, inhabited : forall i : Fin(0), Mere(P(i))) :
  Mere(forall i : Fin(0), P(i)) {
  exact merely((forall i : Fin(0), P(i)), (fun (i : Fin(0)) => typed(P(i), absurd(i))));
}

def finite_mere_choice_step(
  n : Nat,
  previous : (
    forall P : Fin(n) -> U0, (forall i : Fin(n), Mere(P(i))) -> Mere(forall i : Fin(n), P(i))
  ), P : Fin(succ(n)) -> U0, inhabited : forall i : Fin(succ(n)), Mere(P(i))
) :
  Mere(forall i : Fin(succ(n)), P(i)) {
  let h = typed(Fin(succ(n)), left(tt));
  let Q = fun (i : Fin(n)) => P(typed(Fin(succ(n)), right(i)));
  let Goal = (forall i : Fin(succ(n)), P(i));
  have chooseHead : P(h) -> Mere(Goal) {
    intro first;
    have join : (forall i : Fin(n), Q(i)) -> Goal {
      intro rest;
      intro i;
      exact match i as j return P(j) {
        left u => transport(
          (fun (v : Unit) => P(typed(Fin(succ(n)), left(v)))), tt, u, unit_equal(u), first
        );
        right k => rest(k);
      };
    }
    exact mere_map(
      (forall i : Fin(n), Q(i)), Goal, join,
      previous(Q, (fun (i : Fin(n)) => inhabited(typed(Fin(succ(n)), right(i)))))
    );
  }
  exact mere_eliminate(P(h), Mere(Goal), mere_is_prop(Goal), chooseHead, inhabited(h));
}

def finite_mere_choice(n : Nat) =
  induction n as k return (
    forall P : Fin(k) -> U0, (forall i : Fin(k), Mere(P(i))) -> Mere(forall i : Fin(k), P(i))
  ) {
    zero => finite_mere_choice_zero;
    succ previous => finite_mere_choice_step(k, previous);
  };

def UniformFiberCount(A : U0, n : Nat, m : Nat) =
  forall B : A -> U0, (forall a : A, IsSet(B(a))) -> (forall a : A, HasCardinality(B(a), m))
  -> HasCardinality((exists a : A, B(a)), multiply_count(n, m));

// Equal-size finite fibers multiply their size by the size of the base.
// The family is identified with the constant Fin(m) family by univalence.
def finite_uniform_fiber_count(n : Nat, m : Nat) : UniformFiberCount(Fin(n), n, m) {
  intro B;
  intro sets;
  intro counts;
  let A = (exists i : Fin(n), B(i));
  let C = Fin(n) and Fin(m);
  let k = multiply_count(n, m);
  let P = fun (i : Fin(n)) => Bijection(Fin(m), B(i));
  have enumerate : (forall i : Fin(n), P(i)) -> HasCardinality(A, k) {
    intro e;
    let same =
      FunExt(
        U1, Fin(n), (fun (i : Fin(n)) => U0), B, (fun (i : Fin(n)) => Fin(m)),
        (
          fun (i : Fin(n)) => sym(
            ua(U0, Fin(m), B(i), bijection_equiv(Fin(m), B(i), sets(i), e(i)))
          )
        )
      );
    let path = cong((fun (F : Fin(n) -> U0) => (exists i : Fin(n), F(i))), same);
    let product = merely(Bijection(Fin(k), C), reverse_bijection(C, Fin(k), fin_product(n, m)));
    exact cardinality_path(C, A, sym(path), k, product);
  }
  exact mere_eliminate(
    (forall i : Fin(n), P(i)), HasCardinality(A, k), has_cardinality_prop(A, k), enumerate,
    finite_mere_choice(n, P, counts)
  );
}

def uniform_fiber_count(
  A : U0, setA : IsSet(A), n : Nat, m : Nat, countA : HasCardinality(A, n)
) :
  UniformFiberCount(A, n, m) {
  intro B;
  intro sets;
  intro counts;
  let Goal = HasCardinality((exists a : A, B(a)), multiply_count(n, m));
  have useEnumeration : Bijection(Fin(n), A) -> Goal {
    intro e;
    let same = ua(U0, Fin(n), A, bijection_equiv(Fin(n), A, setA, e));
    let result =
      transport(
        (fun (X : U0) => UniformFiberCount(X, n, m)), Fin(n), A, same,
        finite_uniform_fiber_count(n, m)
      );
    exact result(B, sets, counts);
  }
  exact mere_eliminate(
    Bijection(Fin(n), A), Goal, has_cardinality_prop((exists a : A, B(a)), multiply_count(n, m)),
    useEnumeration, countA
  );
}
