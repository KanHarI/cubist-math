// Inhabitation checks explicit, assumption-free evidence without comparing proofs.
import propositions;
use unat;

def ConstantUnit(A : U0) : U0 := Unit;

def ConstantVoid(A : U0) : U0 := Void;

# test(nonempty.unit)
evaluate nonempty Unit by tt;

# test(nonempty.equality)
evaluate nonempty (2 + 2 = 4) by refl(4);

# test(nonempty.refutation)
evaluate nonempty (Void -> Void) by fun (x : Void) => x;

# test(nonempty.other_refutation)
evaluate nonempty (Void -> Void) by fun (x : Void) => absurd(x);

# test(nonempty.universe)
evaluate nonempty U1 by Unit;

# test(nonempty.dependent)
evaluate nonempty (exists A : U0. A) by (Unit, tt);

# test(nonempty.empty)
# expect_error(E606)
evaluate nonempty Void by tt;

# test(nonempty.false_equality)
# expect_error(E606)
evaluate nonempty (2 = 3) by refl(2);

# test(nonempty.false_refutation)
# expect_error(E606)
evaluate nonempty (Unit -> Void) by fun (x : Unit) => x;

# test(nonempty.value_is_not_type)
# expect_error(E604)
evaluate nonempty tt by tt;

# test(nonempty.assumption_in_type)
# expect_error(E324)
evaluate nonempty ConstantUnit(Truncate(U0, Unit)) by tt;

# test(nonempty.assumption_in_evidence)
# expect_error(E324)
evaluate nonempty ((Unit -> Void) -> Void) by fun (no : Unit -> Void) => TruncateElim(
  U0, Unit, Void, fun (a, b : Void) => absurd(a), no, TruncateIntro(U0, Unit, tt)
);

# test(nonempty.after_refusals)
evaluate nonempty (Unit -> Unit) by fun x => x;

// This proof has a very large full normal form; inhabitation needs its checked type.
# test(nonempty.quotient_foundation)
evaluate nonempty IsSet(U1, Prop(U0)) by prop_type_is_set(U0);

# test(nonempty.universe_refusal)
# expect_error(E606)
evaluate nonempty U0 by U0;

# test(empty.void)
evaluate empty Void by fun (x : Void) => x;

# test(empty.other_refutation)
evaluate empty Void by fun (x : Void) => absurd(x);

# test(empty.disequality)
evaluate empty (0 = 1) by unat_zero_ne_succ(0);

# test(empty.inferred_lambda)
evaluate empty Void by fun x => x;

# test(empty.inhabited)
# expect_error(E606)
evaluate empty Unit by fun (x : Unit) => x;

# test(empty.wrong_evidence)
# expect_error(E606)
evaluate empty Void by tt;

# test(empty.value_is_not_type)
# expect_error(E604)
evaluate empty tt by fun (x : Void) => x;

# test(empty.assumption_in_type)
# expect_error(E324)
evaluate empty ConstantVoid(Truncate(U0, Unit)) by fun (x : Void) => x;

# test(empty.assumption_in_evidence)
# expect_error(E324)
evaluate empty (Unit -> Void) by fun (no : Unit -> Void) => TruncateElim(
  U0, Unit, Void, fun (a, b : Void) => absurd(a), no, TruncateIntro(U0, Unit, tt)
);

# test(empty.after_refusals)
evaluate empty Void by fun (x : Void) => x;
