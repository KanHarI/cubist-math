// Migrated from tests/theories.test.mjs:
// an operation whose arguments share one domain has homomorphisms, preserving it and computing.
import nat;
import hlevels;
use nat;

# test(theory_grouped_operation.Pair)
theory Pair(U < UU0) {
  M : set U;
  pair : forall x, y : M. M;
}

# test(theory_grouped_operation.nat_pair)
def nat_pair : Pair(U0) := Pair.make(Nat, nat_is_set, add);

# test(theory_grouped_operation.preserved)
def preserved(A, B : Pair(U0), f : Pair.Hom(A, B), x, y : A.M) :
  f.map(A.pair(x, y)) = B.pair(f.map(x), f.map(y)) := f.map_pair(x, y);

# test(theory_grouped_operation.composite)
def composite : Pair.Hom.compose(Pair.Hom.id(nat_pair), Pair.Hom.id(nat_pair)).map(5) = 5 {
  rfl;
}
