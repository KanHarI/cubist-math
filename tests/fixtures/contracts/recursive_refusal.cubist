// G12-range (CB5): recursive type-unfolding refusals cover the responsible original reference.

import hlevels;
import unat;
# test(generation.G12_range.refusal)
# expect_error(E845)
# expect_error_at(iter(n))
// Error: E845: iter is recursive, and a field's type cannot unfold it: state the law over a model,
//   outside the theory.
theory T(U < UU0) {
  M : set U;
  c : M;
  op(x : M) : M;
  def iter(n : UNat) : M := match n {
    zero => c;
    succ(k) => op(iter(k));
  };
  law nope(n : UNat) : iter(n) = c;
}
