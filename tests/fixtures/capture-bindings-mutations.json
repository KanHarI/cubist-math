          "source": "import hlevels; import nat;\nnotation lexical { numeral(n : Nat) := n; }\nuse lexical;\n\ntheory T(U < UU0) { M : set U; c : M; op(n : Nat, x, y : M) : M;\n  def helper0(x : M) : M := op(0,x,c);\n  def wrapped(value_ : M, proof_ : value_ = value_) : M := (fun (x : M) => helper0(x))(value_);\n  law same(c : M) : helper0(c) = op(0,c,c);\n  \n}\nnotation shifted { numeral(n : Nat) := succ(n); }\nuse shifted;\ntheory Child(U < UU0) extends T {\n  def fresh(x : M) : M := op(0,x,c);\n}\ndef intended(S : Child(U0), x : S.M) : S.wrapped(x,refl(x)) = S.op(zero,x,S.c) := refl(S.op(zero,x,S.c));\ndef named(S : Child(U0), x : S.M) : S.M := Child.wrapped(S,value_ := x,proof_ := refl(x));\ndef captured(S : Child(U0), x : S.M) : S.wrapped(x,refl(x)) = S.op(zero,x,x) := refl(S.op(zero,x,x));\ndef law_meaning(S : Child(U0), x : S.M) : S.op(zero,x,S.c) = S.op(zero,x,x) := S.same(x);\ndef identity(S : Child(U0), x : S.M) : Child.Hom.compose(Child.Hom.id(S),Child.Hom.id(S)).map(x) = x { rfl; }\ndef child_selection(S : Child(U0), x : S.M) : S.fresh(x) = S.op(succ(zero),x,S.c) { rfl; }\n\ninitial N : Child(U0);\ndef generated(x : N) : N.model.wrapped(x,refl(x)) = N.op(zero,x,N.c) { rfl; }\ndef forget(x : N) : Unit := match x { N.c => tt; _ => tt; };\ndef forgotten : forget(N.op(zero,N.c,N.c)) = tt { rfl; }\nfree W(A : U0) : Child(U0) on A;\ndef fold_computes(S : Child(U0), x : S.M) : W.fold(S.M,S,fun (a : S.M) => a).map(W.gen(x)) = x { rfl; }\ndef ordinary : U0 := forall unused : Unit. Unit;\n",
