// G9 (FG5): freshened law binders and every use retain written labels and definition targets.

import hlevels;
theory T(U < UU0) {
  M : set U;
  c : M;
  op(x, y : M) : M;
  def k(x : M) : M := op(x, c);
  law l(c : M) : k(c) = op(c, c);
}

def meaning(S : T(U0), x : S.M) : S.op(x, S.c) = S.op(x, x) := S.l(x);
