// G5-single (FG5): single-binder advice preserves supported calls and generated interfaces.

import hlevels;
theory T(U < UU0) {
  M : set U;
  op : forall x : M. M;
}

def identity(S : T(U0)) := T.Hom.id(S);

def applied(S : T(U0), a : S.M) : S.M := S.op(a);

initial N : T(U0);

def initial_model : T(U0) := N.model;

def folded(S : T(U0)) : T.Hom(N.model, S) := N.fold(S);
