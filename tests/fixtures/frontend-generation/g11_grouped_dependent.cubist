// G11-grouped-dependent (CB2): helper chain with grouped/dependent parameters.

import hlevels;
theory T(U < UU0) {
  M : set U;
  c : M;
  op(x, y : M) : M;
  def k(x : M) : M := op(x, c);
  def chain(x : M) : M := k(x);
  def kk(c, d : M, p : c = c) : M := chain(c);
}

def intended(S : T(U0), x : S.M) : S.kk(x, x, refl(x)) = S.op(x, S.c) := refl(S.op(x, S.c));

// Error: E606: Type mismatch: found S.op(x, x) = S.op(x, x), expected T.kk{{U0}}(S, x, x, refl(x))
//   = S.op(x, x).
def captured(S : T(U0), x : S.M) : S.kk(x, x, refl(x)) = S.op(x, x) := refl(S.op(x, x));
