// B1 (control): opened fields precede later globals in ordinary and generated declarations.

import hlevels;
theory Point(U < UU0) {
  M : set U;
  point : M;
}

def unit_set : IsSet(U0, Unit) {
  hlevel;
}

def selected : Point(U0) := Point.make(Unit, unit_set, tt);

use selected;
inductive M : U0 {
  unrelated;
}

inductive Box : U0 {
  box(x : M);
}

theory T(U < UU0) {
  A : set U;
  op(x : M) : A;
}

def boxed : Box := box(tt);

def input(S : T(U0)) : S.A := S.op(tt);

initial N : T(U0);

def generated : N := N.op(tt);
