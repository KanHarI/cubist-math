// G10 (CB3): a pattern binder cannot capture a helper's free field.

import hlevels;
import nat;
theory T(U < UU0) {
  M : set U;
  c : M;
  def k(n : Nat) : M := c;
  law l(n : Nat) : (match n return M {
      zero => c;
      succ(c) => k(c);
    }) = c;
}

def intended(S : T(U0), n : Nat) : (match n return S.M {
      zero => S.c;
      succ(k_) => S.c;
    }) = S.c := S.l(n);

def at_step(S : T(U0)) : S.c = S.c := S.l(succ(zero));

// Error: E606: Type mismatch: found S.c = S.c, expected x = S.c.
def captured(S : T(U0), x : S.M) : x = S.c := at_step(S);
