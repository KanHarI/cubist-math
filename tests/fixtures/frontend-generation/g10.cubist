// G10 (CB3): a pattern binder cannot capture a helper's free field.

import hlevels;
import unat;
inductive Box(U < UU0, A : U) : U {
  box(a : A);
}

theory T(U < UU0) {
  M : set U;
  c : M;
  def k(n : UNat) : M := c;
  law l(x : M) : (match typed(Box(U, M), box(x)) return M {
      box(c) => k(zero);
    }) = c;
}

def intended(S : T(U0), x : S.M) : S.c = S.c := S.l(x);

// Error: E606
def captured(S : T(U0), x : S.M) : x = S.c := S.l(x);
