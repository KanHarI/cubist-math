// G10 (FG2/FG5): a capture refusal points to the conflicting binder.

import hlevels;
import nat;
// Error: E871: Inlining k here would capture its field c: rename the enclosing pattern or statement
//   binding.
theory T(U < UU0) {
  M : set U;
  c : M;
  def k(n : Nat) : M := c;
  law l(n : Nat) : (match n return M {
      zero => c;
      succ(c) => k(c);
    }) = c;
}
