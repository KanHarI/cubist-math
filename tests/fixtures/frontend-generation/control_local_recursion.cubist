// control-local-recursion (control): a local recursive name remains local in a field type.

import hlevels;
import unat;
theory T(U < UU0) {
  M : set U;
  c : M;
  op(x : M) : M;
  def iter(n : UNat) : M := match n {
    zero => c;
    succ(k) => op(iter(k));
  };
  law ok(iter : UNat -> M) : op(iter(zero)) = op(iter(zero));
}

def local(S : T(U0), f : UNat -> S.M) : S.op(f(zero)) = S.op(f(zero)) := S.ok(f);
