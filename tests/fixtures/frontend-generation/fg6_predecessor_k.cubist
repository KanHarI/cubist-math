// FG6-predecessor-k (FG6): generated recursive calls retain a predecessor named k after a nested match destructs it.

import hlevels;
import unat;
theory T(U < UU0) {
  M : set U;
  c : M;
  op(x : M) : M;
  def iter(n : UNat) : M := match n {
    zero => c;
    succ(k) => match k {
      zero => op(iter(k));
      succ(j) => op(iter(k));
    };
  };
}

def computes(S : T(U0)) : S.iter(succ(succ(zero))) = S.op(S.op(S.c)) {
  rfl;
}
