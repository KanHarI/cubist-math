// Holes and named arguments (work-plan L4.1a). A hole `_` is an argument that
// the call's other arguments or the type expected of it determine; a named
// argument `x := e` gives the parameter x, and the parameters before it that
// no argument gives are holes too. Each print shows the term the kernel
// checked, with every hole's solution in its place.
import univalence;
import hlevels;

def same(U < UU0, A : U, a : A) : A := a;

def apply(U < UU0, A, B : U, f : A -> B, a : A) : B := f(a);

def concat(U < UU0, A : U, x, y, z : A, p : x = y, q : y = z) : x = z := trans(p, q);

def function_of(U < UU0, A, B : U, f : A -> B) : A -> B := f;

// From an argument's type: the carrier of n.
def from_argument(n : Nat) : Nat := same(U0, _, n);

// Output: λ (n : Nat). (λ (ascription : Nat). ascription)(same(U0, Nat, n))
print(inspect(from_argument));

// From the type expected of the call: glue_path's two types.
def from_expected(P : U0, e : ContrEquiv(U0, P, Unit)) : P = Unit := glue_path(U0, _, _, e);

// A path's endpoints, from the paths' types.
def endpoints(x, y, z : Nat, p : x = y, q : y = z) : x = z := concat(U0, _, _, _, _, p, q);

// Output: λ (x : Nat). λ (y : Nat). λ (z : Nat). λ (p : (x =[Nat] y)). λ (q : (y =[Nat] z)). (λ
//   (ascription : (x =[Nat] z)). ascription)(concat(U0, Nat, x, y, z, p, q))
print(inspect(endpoints));

// A lambda with a typed binder gives A and B; an untyped one waits until n
// and the expected type have given them, and is checked against A -> B.
def typed_lambda(n : Nat) : Nat := apply(U0, _, _, fun (x : Nat) => succ(x), n);

def untyped_lambda(n : Nat) : Nat := apply(U0, _, _, fun x => succ(x), n);

// Holes inside an argument, solved from the type the outer call expects of
// it: an equivalence from inverses, glued to a path of types.
computable def inhabited_is_unit(P : U0, prop : IsProp(U0, P), p : P) :
  P = Unit := glue_path(
    U0, _, _,
    inverse_equiv(
      U0, _, _, fun (x : P) => tt, fun (u : Unit) => p, fun (u : Unit) => unit_is_prop(tt, u),
      fun (x : P) => prop(p, x)
    )
  );

// Named arguments: the parameters before the last one named are holes, in
// any order of the names, and a universe can be named too.
computable def named(P : U0, prop : IsProp(U0, P), p : P) :
  P = Unit := glue_path(
    U := U0,
    e := inverse_equiv(
      U0, g := fun (u : Unit) => p, f := fun (x : P) => tt,
      sec := fun (u : Unit) => unit_is_prop(tt, u), ret := fun (x : P) => prop(p, x)
    )
  );

def named_after_positional(n : Nat) : Nat := apply(U0, Nat, a := n, f := fun x => succ(x));

// Parameters after the last one given are left for a later application.
def partial : Nat -> Nat := apply(U0, f := fun (x : Nat) => succ(x));

// Output: 3
print(evaluate(partial(2)));

// A hole is never filled with an inhabitant of its type: here a, of type
// n = n, is not determined, although refl(n) has that type.
// Error: E388: Nothing determines the parameter a of same, of type n = n: not the other arguments'
//   types, nor the type expected of the call. Give it explicitly.
def no_search(n : Nat) : n = n := same(U0, n = n, _);

// A universe that cumulativity leaves open: Nat is in U0, and in U1 as well.
// Error: E392: The parameter A of same is not determined: U0 fits, and so would a larger universe.
//   Give it explicitly.
def universe_open := same(U2, _, Nat);

def universe_given := same(U2, U0, Nat);

// A solution may not mention a variable bound inside the constraint: B
// would be n = n, for the lambda's own n.
// Error: E389: The parameter B of function_of would be n = n, which mentions a variable bound
//   inside an argument, out of its scope. Give it explicitly.
def bound_variable := function_of(U0, _, _, fun (n : Nat) => refl(n));

// A universe argument can be a hole: the least universe the call needs,
// here U0, which holds A := Nat (cubist-tests/implicit_parameters).
def universe_hole(n : Nat) : Nat := same(_, Nat, n);

// Error: E375: same has no parameter b; its parameters are U, A, a.
def unknown_parameter(n : Nat) : Nat := same(U0, b := n);

// Error: E377: The argument a is given twice.
def given_twice(n : Nat) : Nat := same(U0, a := n, a := n);

// Error: E378: refl takes its arguments explicitly: a hole _ or a named argument is an argument of
//   a definition or a function.
def builtin_hole(n : Nat) : n = n := refl(_);

// Error: E379: succ is a declared type or a constructor, whose arguments are written out: a hole _
//   or a named argument is an argument of a definition or a function.
def constructor_hole(n : Nat) : Nat := succ(_);

// Error: E374: f has no named parameters: a named argument gives a parameter that a definition
//   declares.
def local_function(f : Nat -> Nat, n : Nat) : Nat := f(x := n);

// Error: E382: same takes 3 arguments; this is one more.
def too_many(n : Nat) : Nat := same(U0, Nat, n, n);

// Error: E385: A hole _ stands for an argument of a call, which the call's other arguments or the
//   type expected of it determine; anywhere else, write the term.
def standalone : Nat := _;

// A mismatch is reported at the argument.
// Error: E606: Type mismatch: found Unit, expected Nat.
def mismatch(n : Nat) : Nat := apply(U0, _, _, fun (x : Nat) => x, tt);
