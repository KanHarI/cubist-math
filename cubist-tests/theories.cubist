// Theories (L2.4, docs/roadmaps/core-theories.md): declarations of sorts,
// operations with notation and laws; their models, built field by field and
// read by projections, m.f; extension, with labels, renaming and shared
// ancestors; open, which puts a model's fields and notation in scope; and
// the refusals.
import nat;
import hlevels;

theory Semigroup(U < UU0) {
  M : set U;
  mul(x, y : M) : M notation x * y;
  law mul_assoc(x, y, z : M) : (x * y) * z = x * (y * z);
}

theory Monoid(U < UU0) extends Semigroup {
  one : M;
  law one_mul(x : M) : one * x = x;
  law mul_one(x : M) : x * one = x;
}

theory CommMonoid(U < UU0) extends Monoid {
  law mul_comm(x, y : M) : x * y = y * x;
}

theory Group(U < UU0) extends Monoid {
  inv(x : M) : M;
  law inv_mul(x : M) : inv(x) * x = one;
}

// Monoid comes once, through both parents.
theory CommGroup(U < UU0) extends Group, CommMonoid {
}

// Two copies of Monoid on one sort R, the additive one renamed, with + for
// its operation; * keeps meaning the multiplicative one.
theory Semiring(U < UU0) extends
    additive : CommMonoid(M := R, mul := add notation x + y, one := zero, mul_assoc := add_assoc,
      one_mul := zero_add, mul_one := add_zero, mul_comm := add_comm),
    multiplicative : Monoid(M := R) {
  law mul_add(x, y, z : R) : x * (y + z) = x * y + x * z;
}

// A law is a proposition: an equation between elements of a sort, Void,
// or forall, -> and `and` over those.
theory Nontrivial(U < UU0) extends Monoid {
  zero : M;
  law zero_ne_one : zero = one -> Void;
  law trivially : Unit;
}

// A sort renamed twice takes its evidence's name along each time.
theory Carrier(U < UU0) extends Monoid(M := R) {
}

theory Recarried(U < UU0) extends Carrier(R := S) {
}

def recarried_evidence(A : Recarried(U0)) : IsSet(U0, A.S) := A.S_is_set;

// A model is built field by field, by name.
def additive_nat : CommMonoid(U0) := CommMonoid.make(
  M := Nat, M_is_set := nat_is_set, mul := add, mul_assoc := nat_add_assoc, one := 0,
  one_mul := nat_zero_add, mul_one := nat_add_zero, mul_comm := nat_add_comm
);

// Its fields are read by m.f, and compute.
def two_plus_three : additive_nat.mul(2, 3) = 5 {
  rfl;
}

// Output: 5
print(evaluate(additive_nat.mul(2, 3)));

// A projection's type is written through the earlier projections, and a
// projection of a model prints as m.f.
// Output: forall U < UU0. forall m : Monoid(U). forall x : m.M. m.mul(m.one, x) = x
print(typeof(Monoid.one_mul));

// A model's parents: G.group is its Group-model, and G.group.monoid that
// one's Monoid-model.
def parent_mul(G : CommGroup(U0), x, y : G.M) : G.group.monoid.mul(x, y) = G.mul(x, y) {
  rfl;
}

def forget(G : CommGroup(U0)) : Monoid(U0) := G.comm_monoid.monoid;

// open puts the fields and the notation in scope for the rest of the block.
def square(G : Monoid(U0), x : G.M) : G.M {
  use G;
  exact x * x;
}

def square_one(G : Monoid(U0)) : square(G, G.one) = G.one {
  use G;
  exact one_mul(one);
}

def twice_plus_square(R : Semiring(U0), x : R.R) : R.R {
  use R;
  exact x * x + x;
}

// Outside an open, + and * mean add and mul in scope, Nat's here.
def still_nat(n : Nat) : 0 + n * 1 = n * 1 {
  rfl;
}

// Models in any universe below UU0.
def large_square(U < UU0, G : Monoid(U), x : G.M) : G.M {
  use G;
  exact x * x;
}

// Refusals. A projection of a model shows as m.f in messages.
// Error: E606: Type mismatch: found G.mul(G.one, x) = x, expected G.mul(x, G.one) = x.
def wrong_side(G : Monoid(U0), x : G.M) : G.mul(x, G.one) = x {
  use G;
  exact one_mul(x);
}

// Error: E803: Twice has two fields named one: give each its own name.
theory Twice(U < UU0) {
  M : set U;
  one : M;
  one : M;
}

// Error: E810: A notation names an operation's two arguments, as in mul(x, y : M) : M notation x *
//   y; one has none.
theory ConstantNotation(U < UU0) {
  M : set U;
  one : M notation x * y;
}

// Error: E811: The notation of mul writes its arguments in order: x * y.
theory Reversed(U < UU0) {
  M : set U;
  mul(x, y : M) : M notation y * x;
}

// Error: E804: * would stand for both mul and times in SharedOperator: a notation means one
//   operation; rename one's notation.
theory SharedOperator(U < UU0) {
  M : set U;
  mul(x, y : M) : M notation x * y;
  times(x, y : M) : M notation x * y;
}

// Error: E818: The law point must state a proposition: an equation between elements of a sort,
//   Void, or forall, -> or and over those; M is a sort, whose elements are data. A law holds no
//   data, and homomorphisms ignore laws: declare data as an operation or a constant.
theory Pointed(U < UU0) {
  M : set U;
  law point : M;
}

theory Left(U < UU0) {
  M : set U;
  point : M;
}

theory Right(U < UU0) {
  M : set U;
  point : M;
}

// Two unrelated parents' points are two fields, each its parent's; their
// carriers are one (theory_independent).
theory Clash(U < UU0) extends Left, Right {
}

// One ancestor's field, reached twice with two types, is refused.
// Error: E802: Twice2 gets a field named point from both Left and Left: rename one, as in
//   Left(point := …).
theory Twice2(U < UU0) extends Left, left2 : Left(M := N) {
}

// Error: E805: Missing is not a theory here: Unknown extends theories in scope.
theory Unknown(U < UU0) extends Missing {
}

// Error: E807: Monoid has no field unit; its fields are M, M_is_set, mul, mul_assoc, one, one_mul,
//   mul_one.
theory BadRenaming(U < UU0) extends Monoid(unit := one) {
}

// Error: E834: use selects a model of a theory, such as m : Group(U0); this is a value of type Nat.
def open_a_number(n : Nat) : Nat {
  use n;
  exact n;
}

// A local model may take a theory's name, as Left does here; its fields
// are then the model's.
def shadowing_model(Left : Monoid(U0)) : Left.mul(Left.one, Left.one) = Left.one :=
  Left.one_mul(Left.one);

// Error: E815: G is a model of Monoid, which has no field zero: it has M, M_is_set, mul, mul_assoc,
//   one, one_mul, mul_one, and the parents semigroup.
def no_such_field(G : Monoid(U0)) : G.M := G.zero;

// A theory's name is the type of its models (L2.4c); T.Model, its earlier
// name, is refused.
// Error: E396: Monoid.Model is now Monoid: a theory's name is the type of its models, as in
//   Monoid(U0).
def model_type_names(G : Monoid(U0)) : Monoid.Model(U0) := G;
