// Faithful printing (L2.10d): an operation prints with its notation's
// operator only where that notation is selected, and is qualified, as
// unat.(x + y), elsewhere; a literal read from its characters prints as it
// was written, in its notation; and a numeral rule's application prints
// as the numeral where its notation is selected. What a print shows reads
// back, where it is shown, as the term it shows.
import integers;
import rationals;
import unat;
import lists;
import lexemes;
import algebra;
use unat;

notation times {
  x + y := mul(x, y);
  numeral(n : UNat) := n;
}

def doubled(x : UNat) : times.(x + x) = mul(x, x) {
  rfl;
}

// With no notation selected, mul prints as unat's *, as name-based reading
// reads it until L2.10j.
// Output: forall x : UNat. x * x = x * x
print(typeof(doubled));

// A literal prints as it was written, qualified by its notation.
def half : Q := rationals.(1/2);

// Output: rationals.(1/2) = rationals.(1/2)
print(typeof(refl(typed(Q, rationals.(1/2)))));

// Only a whole lexeme prints as a literal: one whose tail is a name prints
// as the application it is.
notation decimal {
  literal(s : Lexeme) := natural_literal(s);
}

def tail : Lexeme := cons(digit(2), nil);

def partial := refl(parsed_value(natural_literal(cons(digit(1), tail)), tt));

// Output: parsed_value{{U0, UNat}}(natural_literal(cons(digit(1), tail)), tt) = parsed_value{{U0,
//   UNat}}(natural_literal(cons(digit(1), tail)), tt)
print(typeof(partial));

use times;

// Where times is selected, mul is its +, and unat's operations are
// qualified.
// Output: forall x : UNat. x + x = x + x
print(typeof(doubled));

// Output: unat.(2 + 3) = unat.(2 + 3)
print(typeof(refl(unat.(2 + 3))));

// Each operand prints in the view its rule reads it in: powers' exponent is
// read in unat, where * is mul.
def combine(x, y : UNat) : UNat := add(x, y);

notation powers {
  x + y := mul(x, y);
  x * y := mul(x, y);
  x ^ unat. (n) := combine(x, n);
  numeral(n : UNat) := n;
}

use powers;

def exponent(x, y : UNat) :
  combine(x, mul(y, y)) = combine(x, mul(y, y)) := refl(combine(x, mul(y, y)));

// Output: forall x : UNat. forall y : UNat. x ^ (y * y) = x ^ (y * y)
print(typeof(exponent));

def exponent_again : forall x : UNat. forall y : UNat. x ^ (y * y) = x ^ (y * y) := exponent;

// A model's ^ groups to the right, as the parser reads it: a power of a
// power keeps its parentheses.
theory Powers(U < UU0) {
  A : U;
  power(x, y : A) : A notation x ^ y;
}

def tower : Powers(U0) := Powers.make(A := UNat, power := fun (x, y : UNat) => succ(x));

use tower;

def nested(x, y, z : UNat) :
  tower.power(tower.power(x, y), z) = tower.power(tower.power(x, y), z) := refl(
    tower.power(tower.power(x, y), z)
  );

// Output: forall x : UNat. forall y : UNat. forall z : UNat. (x ^ y) ^ z = (x ^ y) ^ z
print(typeof(nested));

def nested_again :
  forall x : UNat. forall y : UNat. forall z : UNat. (x ^ y) ^ z = (x ^ y) ^ z := nested;

// A numeral rule that takes its numeral twice prints as the numeral only
// where both places hold the same one.
def pick(a, b : UNat) : UNat := b;

notation diagonal {
  numeral(n : UNat) := pick(n, n);
}

use diagonal;

// Output: pick(unat.(2), unat.(3)) = pick(unat.(2), unat.(3))
print(typeof(refl(pick(unat.(2), unat.(3)))));

// Output: 2 = 2
print(typeof(refl(pick(unat.(2), unat.(2)))));

// A numeral rule with a fixed argument, as tallied(n, 0), prints back as
// the numeral where its notation is selected.
use unat;

def tallied(a, b : UNat) : UNat := a + b;

notation tally {
  numeral(n : UNat) := tallied(n, 0);
}

use tally;

def five : UNat := 5;

// Output: 5 = 5
print(typeof(refl(typed(UNat, 5))));

// The printed text reads back as the term, where it was printed.
def again : 5 = 5 := refl(five);

use integers;

// The integers' literal rule prints back as written, a wide one too.
def wide : Z := 340282366920938463463374607431768211455;

// Output: 340282366920938463463374607431768211455 = 340282366920938463463374607431768211455
print(typeof(refl(typed(Z, 340282366920938463463374607431768211455))));

def wide_again :
  340282366920938463463374607431768211455 = 340282366920938463463374607431768211455 := refl(wide);
