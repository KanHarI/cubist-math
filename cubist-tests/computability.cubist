// From tests/computability.test.mjs: A computable declaration is rejected
// when it depends on an assumption, naming the path.
// A rejected declaration is not committed, so its dependents are blocked.
// Without the modifier the same proof is accepted, with its assumptions reported.

import h1_classical;

computable def successor(n : UNat) := succ(n);

// Error: E330: This computable declaration depends on non-computing assumptions: LEM. Path to LEM:
//   double_negation (h1_classical) → LEM.
computable def uses_lem(P : U0, prop_ : IsProp(U0, P), nn : (P -> Void) -> Void) : P {
  exact double_negation(U0, P, prop_, nn);
}

// Error: E340: Untranslated dependency: uses_lem
def after_failure := uses_lem;

def ordinary(P : U0, prop_ : IsProp(U0, P), nn : (P -> Void) -> Void) : P {
  exact double_negation(U0, P, prop_, nn);
}
