// Named notations (L2.10a): notation v { rules } declares one; use v; and
// v.(e) select it, and a selection is complete, so an operator it does not
// bind is an error, never an outer selection's or a function named add. A
// rule's names are read where the notation is declared. Two models on one
// carrier stay apart, and selections nest.
import unat;
import hlevels;
import algebra;

// The library's unat: 2 + 3 * 4 is add(2, mul(3, 4)).
def fourteen : unat.(2 + 3 * 4 = 14) {
  rfl;
}

// A notation of one's own, binding + to multiplication.
notation times {
  x + y := mul(x, y);
  numeral(n : UNat) := n;
}

// Output: unat.(12)
print(evaluate(times.(3 + 4)));

// A rule's names are read where it was declared: a local add changes nothing.
def hygienic(add : UNat) : times.(2 + 3 = 6) {
  rfl;
}

// A rule's binder captures no name of an operand: z is the caller's here.
notation first {
  x + y := (fun (z : UNat) => x)(y);
}

def keeps(z, w : UNat) : first.(z + w) = z {
  rfl;
}

// Nor is an operand's name one the rule binds itself, as an induction's
// hypothesis: x in the step is the hypothesis, not the left operand.
notation stepped {
  x + y := induction y return UNat {
    zero => zero;
    succ x => x;
  };
}

def steps : stepped.(unat.(7) + unat.(1)) = zero {
  rfl;
}

// A name the rule binds is not read where the rule is declared either: z in
// the step is the hypothesis, not this global z.
def z : UNat := succ(zero);

notation rebound {
  x + y := induction y return UNat {
    zero => zero;
    succ z => z;
  };
}

def rebinds : rebound.(unat.(7) + unat.(1)) = zero {
  rfl;
}

// An induction's index is the predecessor in its step too: x there is the
// predecessor of 1, not the left operand, and z not the global z.
notation indexed {
  x + y := induction y as x return UNat {
    zero => zero;
    succ h => x;
  };
}

def predecessor : indexed.(unat.(7) + unat.(1)) = zero {
  rfl;
}

notation reindexed {
  x + y := induction y as z return UNat {
    zero => zero;
    succ h => z;
  };
}

def repredecessor : reindexed.(unat.(7) + unat.(1)) = zero {
  rfl;
}

// The operation alone.
def plus := unat.(+);

// Output: unat.(7)
print(evaluate(unat.(plus(3, 4))));

// Two models on one carrier: * is addition in one and multiplication in
// the other.
def additive_ : Monoid(U0) := nat_additive.monoid;

def multiplicative : Monoid(U0) := nat_multiplicative.monoid;

// Output: unat.(7)
print(evaluate(unat.(3 additive_.(*) 4)));

// Output: unat.(12)
print(evaluate(unat.(3 multiplicative.(*) 4)));

// A rule's qualified name is read by its root where the rule is declared:
// a local additive changes nothing.
notation summed {
  x + y := additive_.mul(x, y);
}

def rooted(additive_ : Monoid(U0), x, y : UNat) : summed.(x + y) = unat.(x + y) {
  rfl;
}

// Selections nest, the innermost winning.
def nested(x : UNat) : UNat := multiplicative.(x * unat.(x + 1));

// Output: unat.(12)
print(evaluate(unat.(nested(3))));

// A selection is complete: + is not the additive monoid's, whose
// operation is *.
// Error: E397: + is not in additive_'s notation, which is selected here: select a notation that
//   binds it, as unat.(x + y), or write the operation.
def missing(x : UNat) : UNat := additive_.(x + x);

// Error: E397: < is not in times's notation, which is selected here: select a notation that binds
//   it, as unat.(x < y), or write the operation.
def no_order : times.(1 < 2) := tt;

use unat;

// For the rest of the file, unat's notation.
def doubled(x : UNat) : UNat := x + x;

// Output: 6
print(evaluate(doubled(3)));
