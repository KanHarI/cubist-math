// From tests/proof-ergonomics.test.mjs: Freeze is withheld when removing a
// rule changes conditional premise search.

import primes;
use unat;

def freeze_case(
  f, g, k : UNat -> UNat, a, b, t : UNat, c : forall n : UNat. g(n) = n -> f(n) = k(n),
  divert : g(a) = b, unit : forall n : UNat. g(n) = n, fallback : f(a) = t
) :
  f(a) + f(b) = t + k(b) {
  simp [c, divert, unit, fallback];
}
