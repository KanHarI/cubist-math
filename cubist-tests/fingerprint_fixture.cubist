// The declarations whose elaboration fingerprints
// tests/elaboration-fingerprint.test.mjs takes: a rewrite, a universe-generic
// definition and its use. The test edits a proof and moves the source, and
// the fingerprints tell.

import nat;
use nat;

def two : succ(1) = 2 {
  rfl;
}

def moved(x, y : Nat, p : x = y, q : y = x) : x = x {
  rw [p];
  exact q;
}

def mirror(U < UU0, A : U, x, y : A, p : x = y) : y = x {
  exact path(fun (i : Interval) => A, fun (i : Interval) => at(p, flip(i)));
}

def mirror_nat := mirror(U0, Nat);
