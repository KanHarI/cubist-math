// From tests/truncation-migration.test.mjs: the library's excluded middle coexists with the
// archive's legacy builtin, and a program that uses both lists both.
// The archive's double negation uses its legacy LEM over Truncate, labelled LEM[Truncate]; the
// library's uses the axiom LEM of classical_axioms, over Trunc, which the import of h1_classical
// binds in place of the builtin.
import classical;
import h1_classical;

def old(P : U0, prop_ : IsProp(U0, P), h : (P -> Void) -> Void) :
  P := classical::double_negation(P, prop_, h);

def rebuilt(P : U0, prop_ : IsProp(U0, P), h : (P -> Void) -> Void) :
  P := double_negation(U0, P, prop_, h);

def both(P : U0, prop_ : IsProp(U0, P), h : (P -> Void) -> Void) :
  P and P := (old(P, prop_, h), rebuilt(P, prop_, h));

// The truncation former of the retired LEM(Trunc, U, …) is no universe.
// Error: E322: Expected a universe: U0, UU0, a universe variable, next(E) or max(E, F).
def rejected(P : U1, h : (P -> Void) -> Void) := LEM(Trunc, U1, P, h);
