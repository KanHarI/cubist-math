// From tests/inductive-declarations.test.mjs: Inspection: no declared type
// mentions an assumption, so the view has no assumption's label to avoid.
// The display shows an assumption by its label, and the view's names do not
// avoid those labels: no declared type mentions an assumption. The kernel
// admits a signature only from closed judgements (the H1 specification's
// 5.2), and the lowering refuses an assumption before it gets there: in a
// parameter, in a constructor's argument, or in a definition one of them
// uses, naming it, and nothing is admitted.
// Each refusal names the assumption by its label, and the parameter or
// argument that uses it, where the source writes it. Each such type here is
// a path between two uses of the library's excluded middle or choice.

import unat;
import classical_axioms;

// Error: E507: InParameter's parameter t uses the assumption LEM: a declared type's parameters and
//   constructors cannot use assumptions, since its signature is closed.
inductive InParameter(t : LEM(U0) = LEM(U0)) {
  p;
}

// Error: E507: InGeneric's parameter t uses the assumption LEM: a declared type's parameters and
//   constructors cannot use assumptions, since its signature is closed.
inductive InGeneric(U < UU0, t : LEM(U) = LEM(U)) {
  g;
}

// Error: E507: a's argument t uses the assumption Choice: a declared type's parameters and
//   constructors cannot use assumptions, since its signature is closed.
inductive InArgument {
  a(t : Choice(U0) = Choice(U0));
}

// Two uses of excluded middle, which are equal.
def Settled(A : U0, nn : (A -> Void) -> Void) := LEM(U0, A, nn) = LEM(U0, A, nn);

// Error: E507: d's argument t uses the assumption LEM: a declared type's parameters and
//   constructors cannot use assumptions, since its signature is closed.
inductive InDefinition {
  d(t : Settled(Unit, fun (k : Unit -> Void) => k(tt)));
}

// Error: E507: r's type uses the assumption LEM: a declared type's parameters and constructors
//   cannot use assumptions, since its signature is closed.
inductive InResult {
  r : (LEM(U0) = LEM(U0)) -> InResult;
}

inductive Clear {
  c(n : UNat);
}

// Output: inductive Clear : U0 (type) { c : UNat -> Clear [1 data, 0 positions, 0 dimensions]; }
//   eliminator for P : Clear -> U { c_case : forall x : UNat. P(c(x)); }
print(inspect(Clear));
