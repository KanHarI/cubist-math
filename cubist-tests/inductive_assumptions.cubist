// From tests/inductive-declarations.test.mjs: Inspection: no declared type
// mentions an assumption, so the view has no assumption's label to avoid.
// The display shows an assumption by its label, and the view's names do not
// avoid those labels: no declared type mentions an assumption. The kernel
// admits a signature only from closed judgements (the H1 specification's
// 5.2), and the lowering refuses an assumption before it gets there: in a
// parameter, in a constructor's argument, or in a definition one of them
// uses, naming it, and nothing is admitted.
// Each refusal names the assumption by its label, and the parameter or
// argument that uses it, where the source writes it.

import classical_axioms;

// Error: E507: InParameter's parameter t uses the assumption Truncate: a declared type's parameters
//   and constructors cannot use assumptions, since its signature is closed.
inductive InParameter(t : Truncate(U0, Nat)) {
  p;
}

// Error: E507: InGeneric's parameter t uses the assumption Truncate: a declared type's parameters
//   and constructors cannot use assumptions, since its signature is closed.
inductive InGeneric(U < UU0, A : U, t : Truncate(U, A)) {
  g;
}

// Error: E507: a's argument t uses the assumption Truncate: a declared type's parameters and
//   constructors cannot use assumptions, since its signature is closed.
inductive InArgument {
  a(t : Truncate(U0, Nat));
}

// Error: E507: d's argument t uses the assumption Truncate: a declared type's parameters and
//   constructors cannot use assumptions, since its signature is closed.
inductive InDefinition {
  d(t : ExcludedMiddle(U0));
}

// Error: E507: r's type uses the assumption Truncate: a declared type's parameters and constructors
//   cannot use assumptions, since its signature is closed.
inductive InResult {
  r : Truncate(U0, Nat) -> InResult;
}

inductive Clear {
  c(n : Nat);
}
