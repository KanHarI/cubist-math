// Squares (L2.8; library/squares.cubist): Square(a0_, a1_, a_0, a_1),
// a path between two paths over two others, and its constructions. Each
// holds by conversion, as the laws below check by rfl.
import nat;
import squares;
use nat;

// Transposing twice, or flipping twice, gives the square back.
def transpose_twice{{
  A : U0, a00, a01, a10, a11 : A, a0_ : a00 = a01, a1_ : a10 = a11, a_0 : a00 = a10, a_1 : a01 = a11
}}(s : Square(a0_, a1_, a_0, a_1)) :
  transpose(transpose(s)) = s {
  rfl;
}

def flip_twice{{
  A : U0, a00, a01, a10, a11 : A, a0_ : a00 = a01, a1_ : a10 = a11, a_0 : a00 = a10, a_1 : a01 = a11
}}(s : Square(a0_, a1_, a_0, a_1)) :
  flip_horizontal(flip_horizontal(s)) = s {
  rfl;
}

// The naturality square of a homotopy: n + 0 and n agree at each point.
def plus_zero(n : Nat) : n + 0 = n := nat_add_zero(n);

def natural(x, y : Nat, p : x = y) :
  Square(plus_zero(x), plus_zero(y), cong(fun (n : Nat) => n + 0, p), cong(fun (n : Nat) => n, p)) := naturality(
    fun (n : Nat) => n + 0, fun (n : Nat) => n, plus_zero, p
  );

// Its corner is where both of its sides start.
def corner(x, y : Nat, p : x = y) : natural(x, y, p) @ 0 @ 0 = x + 0 {
  rfl;
}

// The filler of a double composition has p reversed on its left, and the
// composite at its top, where its transpose ends.
def filler_left{{A : U0, w, x, y, z : A}}(p : w = x, q : x = y, r : y = z) :
  double_comp_filler(p, q, r) @ 0 = ~p {
  rfl;
}

def filler_top{{A : U0, w, x, y, z : A}}(p : w = x, q : x = y, r : y = z) :
  transpose(double_comp_filler(p, q, r)) @ 1 = double_comp(p, q, r) {
  rfl;
}

// Composing squares: the reflexive squares of p and q side by side, and of
// p twice one above the other.
def side_by_side{{A : U0, x, y : A}}(p : x = y) :
  Square(p, p, trans(refl(x), refl(x)), trans(refl(y), refl(y))) := horizontal(
    refl_square(p), refl_square(p)
  );

def stacked{{A : U0, x, y, z : A}}(p : x = y, q : y = z) :
  Square(trans(refl(x), refl(x)), trans(refl(z), refl(z)), trans(p, q), trans(p, q)) := vertical(
    transpose(refl_square(trans(p, q))), transpose(refl_square(trans(p, q)))
  );

// A closed square computes: its points are numbers.
// Output: 2
print(evaluate(refl_square(typed(1 + 1 = 2, refl(2))) @ 1 @ 0));

// Squares and equations of composites (the conversions are inverse only up
// to a path, not by conversion).
def to_and_from{{
  A : U0, a00, a01, a10, a11 : A, a0_ : a00 = a01, a1_ : a10 = a11, a_0 : a00 = a10, a_1 : a01 = a11
}}(s : Square(a0_, a1_, a_0, a_1)) :
  Square(a0_, a1_, a_0, a_1) := path_to_square(square_to_path(s));

// A homotopy's naturality as an equation: n + 0 and n agree along any path.
def natural_path(x, y : Nat, p : x = y) :
  trans(plus_zero(x), cong(fun (n : Nat) => n, p)) = trans(
    cong(fun (n : Nat) => n + 0, p), plus_zero(y)
  ) := naturality_path(fun (n : Nat) => n + 0, fun (n : Nat) => n, plus_zero, p);

// A map takes a composite to the composite of its images.
def doubled_composite(x, y, z : Nat, p : x = y, q : y = z) :
  cong(fun (n : Nat) => n + n, trans(p, q)) = trans(
    cong(fun (n : Nat) => n + n, p), cong(fun (n : Nat) => n + n, q)
  ) := cong_trans(fun (n : Nat) => n + n, p, q);

// Two fillers of the same three sides have equal tops.
def tops{{A : U0, x, y, z : A}}(p : x = y, q : y = z) :
  trans(p, q) = double_comp(refl(x), p, q) := top_unique(
    trans_filler(p, q), double_comp_filler(refl(x), p, q)
  );
