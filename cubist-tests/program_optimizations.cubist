// From tests/cubical-program.test.mjs: path proofs and their refusals, which
// every combination of the kernel's optimization switches checks alike.

import unat;
use unat;

def compose_(x : UNat, y : UNat, z : UNat, p : x = y, q : y = z) : succ(x) = succ(z) {
  exact cong(succ, trans(p, q));
}

def reverse(x : UNat, y : UNat, p : x = y) : y = x {
  exact sym(p);
}

// Error: E606: Type mismatch: found 0 = 0, expected 0 = 1.
def wrong : 0 = 1 {
  exact trans(refl(0), refl(0));
}

// Error: E429: Path endpoints do not match.
def disconnected : 0 = 1 {
  exact trans(refl(0), refl(1));
}
