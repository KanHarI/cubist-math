// From tests/projections-let.test.mjs: P.1 and p.2 are the kernel's
// projections, with the family read from the pair's type.
// The pair's type may be a definition that computes to a pair type.

import unat;
use unat;

def first_of(p : UNat and Unit) : UNat := p.1;

def second_of(p : UNat and Unit) : Unit := p.2;

def witness_(A : U0, B : A -> U0, p : exists x : A. B(x)) : A := p.1;

def evidence(A : U0, B : A -> U0, p : exists x : A. B(x)) : B(p.1) := p.2;

def third(t : UNat and Unit and UNat) : UNat := t.2.2;

def middle(t : UNat and Unit and UNat) : Unit := t.2.1;

def applied(f : UNat -> UNat and (UNat -> UNat), n : UNat) : UNat := f(n).2(n);

def swap(A, B : U0, p : A and B) : B and A := (p.2, p.1);

def eta(A : U0, B : A -> U0, p : exists x : A. B(x)) : p = (p.1, p.2) := refl(p);

def beta : typed(UNat and Unit, (3, tt)).1 = 3 := refl(3);

def universe_generic(U < UU0, A : U, B : A -> U, p : exists x : A. B(x)) : A := p.1;

// The pair's type may be a definition that computes to a pair type.
def Pairing := UNat and Unit;

def through_definition(p : Pairing) : UNat := p.1;

def Box(U < UU0, A : U) := A and A;

def through_generic_definition(U < UU0, A : U, b : Box(U, A)) : A := b.2;

evaluate typed(UNat and UNat, (2, 5)).2 expecting 5;

// The kernel's projections, under the parameter's lambda and the ascription
// that keeps the stated result type.
// Output: λ (p : (UNat × Unit)). (λ (ascription : UNat). ascription)(p.1)
print(inspect(first_of));
// Output: λ (p : (UNat × Unit)). (λ (ascription : Unit). ascription)(p.2)
print(inspect(second_of));
// Output: λ (t : (UNat × (Unit × UNat))). (λ (ascription : UNat). ascription)(t.2.2)
print(inspect(third));

// The family is read from the pair's type.
// Output: forall A : U0. forall B : A -> U0. forall p : exists x : A. B(x). B(p.1)
print(typeof(evidence));

// Misused projections are rejected with precise messages, reported at the
// projection itself.
// Error: E349: Projection .1 requires a dependent pair; found a value of type UNat.
def not_a_pair(n : UNat) : UNat := n.1;

// Error: E349: Projection .2 requires a dependent pair; found a value of type UNat -> UNat.
def function_projection(f : UNat -> UNat) : UNat := f.2;
