// From tests/cubical-program.test.mjs: logical assumptions remain explicit,
// minimal, and inspectable after native closure: excluded_and_choice uses LEM
// and Choice, excluded LEM alone, and innocent none.

import unat;
import classical_axioms;
use unat;

def excluded(A : U0, nn : (A -> Void) -> Void) : Trunc(U0, A) := LEM(U0, A, nn);

def excluded_and_choice : ExcludedMiddle(U0) and AxiomOfChoice(U0) := (LEM(U0), Choice(U0));

computable def innocent : 0 = 0 {
  exact refl(0);
}

// Error: E606: Type mismatch: found 0 = 0, expected 0 = 1.
def wrong : 0 = 1 {
  exact refl(0);
}
