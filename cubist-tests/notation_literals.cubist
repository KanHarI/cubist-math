// Literals in a selected notation (L2.10c). A numeric token, 1/2, 2.3 or
// 1_000, is read by the selected notation's literal rule from its
// characters; a plain numeral by its numeral rule, or its literal rule; and
// a notation with neither reads none. A model's module may add rules to its
// notation, as the rationals' and the integers' do, and a theory's derived
// operation marked notation numeral reads numerals in its models.
import nat;
import lists;
import lexemes;
import hlevels;
import algebra;
import integers;
import rationals;
use nat;

computable def equal_or_not(x, y : Q) : Nat := match rat_decide(x, y) return Nat {
    left same => 1;
    right different => 0;
  };

// 1/2 is one literal, read by the rationals' parser.
def half : Q := rationals.(1/2);

// Output: 1
print(evaluate(equal_or_not(rationals.(1/2 + 1/3), rationals.(5/6))));

// Output: 1
print(evaluate(equal_or_not(rationals.(0.5), rationals.(1/2))));

// Output: 1
print(evaluate(equal_or_not(rationals.(1_2/4), rationals.(3))));

// The parser refuses 1/0 at its denominator.
// Error: E905: rationals's literal rule refuses 1/0 at its character 3.
def undefined : Q := rationals.(1/0);

// The integers' module gives them numerals: integers.(2) is int(2, 0).
def two : integers.(2) = int(2, 0) {
  rfl;
}

// A theory's derived operation reads numerals in a model: one added n times.
theory Rig(U < UU0) {
  R : set U;
  add(x, y : R) : R notation x + y;
  zero : R;
  one : R;
  def of_nat(n : Nat) : R := match n {
      zero => zero;
      succ(k) => one + of_nat(k);
    } notation numeral;
}

def counting : Rig(U0) := Rig.make(R := Nat, R_is_set := nat_is_set, add := add, zero := 0, one := 1);

// Output: 7
print(evaluate(counting.(2 + 5)));

// A notation with neither rule reads no numerals; nat.(…) gives one.
def additive : Monoid(U0) := nat_additive.monoid;

// Error: E907: additive's notation reads no numeral 2: write nat.(2) for a natural number, or
//   select a notation that reads it.
def unread : Nat := additive.(2 * 3);

def read : Nat := additive.(nat.(2) * nat.(3));

// nat reads no literal other than a plain numeral.
// Error: E908: nat's notation reads no literal 1/2: select a notation whose literal rule reads it,
//   as rationals.(1/2).
def not_natural : Nat := nat.(1/2);

// A model whose module adds a literal or a numeral rule keeps its theory's
// operators, by name and between operands.
def rational_add := rationals.(+);

def int_sum(x, y : Z) : Z := x integers.(+) y;

// A literal rule reads a token as it is written, a numeral or a binary
// literal too: 007 has three glyphs, and 257 is no natural number here.
computable def glyph_count(s : Lexeme) : Parsed(U0, Nat) := ok(length(s));

notation count {
  literal(s : Lexeme) := glyph_count(s);
}

// Output: 3
print(evaluate(count.(007)));

// Output: 3
print(evaluate(count.(257)));

// Output: 5
print(evaluate(count.(0b101)));

// A literal's and a numeral's names are where their rules are declared: a
// local Nat changes neither the rationals' parse nor the integers' numeral.
def half_under(Nat : U0) : Q := rationals.(1/2);

def two_under(Nat : U0) : Z := integers.(2);

// The rules a module adds are its model's: a parameter that takes the
// model's name reads numerals in its own theory's notation, which has none.
theory Boxed(U < UU0) {
  M : U;
  point : M;
}

def box : Boxed(U0) := Boxed.make(M := Nat, point := 0);

notation box {
  numeral(n : Nat) := succ(n);
}

// Output: 3
print(evaluate(box.(2)));

// Error: E907: box's notation reads no numeral 2: write nat.(2) for a natural number, or select a
//   notation that reads it.
def shadowed(box : Boxed(U0)) : box.M := box.(2);

// A derived operation that names itself free recurs; one whose parameter
// takes its name does not, and later fields unfold it.
theory Unfolded(U < UU0) {
  M : U;
  point : M;
  def keep(keep : M) : M := keep;
  def twice(x : M) : M := keep(keep(x));
  def apply(apply : M -> M, x : M) : M := apply(x);
}

def unfolded : Unfolded(U0) := Unfolded.make(M := Nat, point := 0);

// Output: 5
print(evaluate(Unfolded.apply(unfolded, fun (n : Nat) => succ(n), 4)));
