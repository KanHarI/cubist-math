// From tests/dimension.test.mjs: Dimension does not choose a basis, forget
// linearity, or ignore a tower's embedding.

import extension_degree;
use nat;

// Error: E606: Type mismatch: found HasDimension(Truncate, K, V, n), expected FiniteBasis(K, V, n).
def choose_basis(K : AlgebraicField, V : VectorSpace(K), n : Nat, size : HasDimension(K, V, n)) :
  FiniteBasis(K, V, n) {
  exact size;
}

// Error: E606: Type mismatch: found ExtensionDegree(Truncate, K, embedding_as_extension(K, K,
//   field_embedding_identity(K)), 1), expected ExtensionDegree(Truncate, K,
//   embedding_as_extension(K, K, field_embedding_identity(K)), 2).
def wrong_scalar_degree(K : AlgebraicField) :
  ExtensionDegree(K, embedding_as_extension(K, K, field_embedding_identity(K)), 2) {
  exact identity_extension_degree(K);
}

// Error: E606: Type mismatch: found exists f : (Fin(m) -> af_carrier(K)) -> Fin(n) ->
//   af_carrier(K). exists g : (Fin(n) -> af_carrier(K)) -> Fin(m) -> af_carrier(K). (forall x :
//   Fin(m) -> af_carr…, expected exists f : exists f : vector_carrier(K, CoordinateSpace(K, m)) ->
//   vector_carrier(K, CoordinateSpace(K, n)). LinearLaws(K, CoordinateSpace(K, m), CoordinateSpac….
def arbitrary_bijection_is_linear(
  K : AlgebraicField, m : Nat, n : Nat,
  b : Bijection((Fin(m) -> af_carrier(K)), (Fin(n) -> af_carrier(K)))
) :
  m = n {
  exact coordinate_dimension_invariant(K, m, n, b);
}

// Error: E606: Type mismatch: found FiniteExtension(Truncate, K, embedding_as_extension(K, M,
//   field_embedding_compose(K, L, M, e, d))), expected FiniteExtension(Truncate, K,
//   embedding_as_extension(K, M, c)).
def unrelated_embedding(
  K : AlgebraicField, L : AlgebraicField, M : AlgebraicField, e : FieldEmbedding(K, L),
  d : FieldEmbedding(L, M), c : FieldEmbedding(K, M),
  lower : FiniteExtension(K, embedding_as_extension(K, L, e)),
  upper : FiniteExtension(L, embedding_as_extension(L, M, d))
) :
  FiniteExtension(K, embedding_as_extension(K, M, c)) {
  exact finite_extension_tower(
    K, L, M, e, d, field_embedding_compose(K, L, M, e, d),
    refl(field_embedding_compose(K, L, M, e, d)), lower, upper
  );
}
