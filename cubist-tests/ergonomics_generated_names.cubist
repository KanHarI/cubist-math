// From tests/proof-ergonomics.test.mjs: Generated names stay distinct when a
// source name ends in a digit. a1 takes serial 1 and, after eight arrows and
// q, the quantified a takes serial 11. Both were once named a11, so this
// false statement checked as forall a, a = a.

import nat;

// Error: E606: Type mismatch: found forall a : Nat. a = a, expected forall a : Nat. a = a1_.
def aliased(a1 : Nat, q : Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat) :
  forall a : Nat. a = a1 {
  intro a;
  exact refl(a);
}

// Warning: W705: a is unused in the body: write Nat -> … instead of forall a : Nat. ….
def distinct(a1 : Nat, q : Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat) :
  forall a : Nat. a1 = a1 {
  intro a;
  exact refl(a1);
}
