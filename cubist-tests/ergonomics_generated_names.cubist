// From tests/proof-ergonomics.test.mjs: Generated names stay distinct when a
// source name ends in a digit. a1 takes serial 1 and, after eight arrows and
// q, the quantified a takes serial 11. Both were once named a11, so this
// false statement checked as forall a, a = a.

import unat;

// Error: E606: Type mismatch: found forall a : UNat. a = a, expected forall a : UNat. a = a1_.
def aliased(a1 : UNat, q : UNat -> UNat -> UNat -> UNat -> UNat -> UNat -> UNat -> UNat -> UNat) :
  forall a : UNat. a = a1 {
  intro a;
  exact refl(a);
}

// Warning: W705: a is unused in the body: write UNat -> … instead of forall a : UNat. ….
def distinct(a1 : UNat, q : UNat -> UNat -> UNat -> UNat -> UNat -> UNat -> UNat -> UNat -> UNat) :
  forall a : UNat. a1 = a1 {
  intro a;
  exact refl(a1);
}
