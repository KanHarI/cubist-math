// Constructor shadowing does not retarget literals in imported Nat: N's zero
// and succ shadow Nat's, and the numeral 2 is still Nat's. From
// tests/program-types.test.mjs.
import nat;
use nat;

inductive N {
  zero;
  succ(n : N);
}

def ordinary : N := succ(zero);

def literal_ : Nat := 2;

def same : literal_ = 2 {
  rfl;
}
