// Constructor shadowing does not retarget literals in imported UNat: N's zero
// and succ shadow UNat's, and the numeral 2 is still UNat's. From
// tests/program-types.test.mjs.
import unat;
use unat;

inductive N {
  zero;
  succ(n : N);
}

def ordinary : N := succ(zero);

def literal_ : UNat := 2;

def same : literal_ = 2 {
  rfl;
}
