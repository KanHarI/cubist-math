// A theory's sorts are sets or propositions, whose evidence is hlevels':
// without its import, the theory's type of models names it, once, and the
// rest of the theory is unavailable.

// Error: E814: The sorts of Magma need IsSet, from hlevels: import hlevels;
theory Magma(U < UU0) {
  M : set U;
  mul(x, y : M) : M notation x * y;
}

// A theory without sorts needs nothing.
theory Pointed(U < UU0) {
  point : Unit;
}

// Error: E340: Untranslated dependency: Magma.make
def uses_magma := Magma.make;
