// The first proof, whose derivations tests/instruction-driver.test.mjs walks
// in instruction mode: every definition, unat's included,
// derives at its checked type, and lt_succ's judgement graph is the one the
// workbench lists. tests/elaboration.test.mjs shows its proof statements'
// goals and its elaboration view.
import unat;
use unat;

def lt(n, m : UNat) : U0 {
  exact exists k : UNat. succ(k) + n = m;
}

def lt_succ(n : UNat) : lt(n, succ(n)) {
  exact (0, refl(succ(n)));
}

def exists_greater_number : forall n : UNat. exists m : UNat. lt(n, m) {
  intro n;
  exact (succ(n), lt_succ(n));
}
