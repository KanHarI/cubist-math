// From tests/computability.test.mjs: Evaluate checks the normal form of a
// closed assumption-free term.

import h1_classical;
import bnat_notation;
import unat;
use unat;

evaluate 2 + 2 expecting 4;
// Error: E326: The term evaluates to 4, not 5.
evaluate 2 + 2 expecting 5;
evaluate bnat_mul(bnat.(0b1101), bnat.(0b1011)) expecting bnat.(0b10001111);
// A binary value prints in decimal.
// Output: bnat.(143)
print(evaluate(bnat_mul(bnat.(0b1101), bnat.(0b1011))));
// Error: E324: The evaluated term depends on non-computing assumptions: LEM. Path to LEM:
//   double_negation (h1_classical) → LEM.
evaluate double_negation expecting double_negation;
// Error: E325: The evaluated term has type UNat, but the expected value has type Unit.
evaluate 2 + 2 expecting tt;
