// From tests/computability.test.mjs: Evaluate checks the normal form of a
// closed assumption-free term.

import primes;
import classical;
import binary_arithmetic;
use nat;

evaluate 2 + 2 expecting 4;
// Error: E326: The term evaluates to 4, not 5.
evaluate 2 + 2 expecting 5;
evaluate binary_mul(binary.(0b1101), binary.(0b1011)) expecting binary.(0b10001111);
// A binary value prints as a binary literal.
// Output: binary.(0b10001111)
print(evaluate(binary_mul(binary.(0b1101), binary.(0b1011))));
// Error: E324: The evaluated term depends on non-computing assumptions: LEM, Truncate,
//   TruncateElim. Path to LEM: double_negation (classical) → LEM.
evaluate double_negation expecting double_negation;
// Error: E325: The evaluated term has type Nat, but the expected value has type Unit.
evaluate 2 + 2 expecting tt;
