// From tests/cubical-wasm.test.mjs: a false factorial value is refused:
// binary_factorial(3) is 0b110. (The JS test imported binary_induction
// alone, and was refused for the missing name.)
import binary_arithmetic;
use nat;

// Error: E606: Type mismatch: found binary.(0b111) = binary.(0b111), expected binary_factorial(3) =
//   binary.(0b111).
def wrong_factorial : binary_factorial(3) = binary.(0b111) {
  exact refl(binary.(0b111));
}
