// The hlevel tactic (work-plan L2.5b, the HoTT roadmap's D1), from
// tests/hlevel.test.mjs: it proves h-level statements, and equalities in
// propositions, from the lemmas of library/hlevels.cubist, evidence in scope
// and hints, under counted fuel.
import hlevels;
use nat;

// hlevel proves each kind of goal, from evidence, hints and the type's shape.
// Every proof is built from computable lemmas and uses no assumption, so it
// may be marked computable. Structural rules need a numeral: a variable level
// is given only by evidence at that level.
def unit_contractible : IsContr(U0, Unit) {
  hlevel;
}

def void_proposition : IsProp(U0, Void) {
  hlevel;
}

def nat_set : IsSet(U0, Nat) {
  hlevel;
}

def nat_groupoid : HasLevel(U0, 2, Nat) {
  hlevel;
}

def functions_into_nat : IsSet(U0, Nat -> Nat) {
  hlevel;
}

def pairs_of_numbers : IsSet(U0, Nat and Nat) {
  hlevel;
}

def functions_into_unit : IsContr(U0, Nat -> Unit) {
  hlevel;
}

def paths_of_numbers : IsProp(U0, 3 = 3) {
  hlevel;
}

def level_statement : IsProp(U0, IsSet(U0, Nat)) {
  hlevel;
}

def parallel_paths : forall p, q : 0 = 0. p = q {
  intro p, q;
  hlevel;
}

def lifted(A : U0, h : IsProp(U0, A)) : HasLevel(U0, 3, A) {
  hlevel;
}

def from_contractible(A : U0, c : IsContr(U0, A)) : IsSet(U0, A -> A) {
  hlevel;
}

def in_u1(A : U1, h : IsSet(U1, A)) : IsSet(U1, (A -> A) and A) {
  hlevel;
}

def equal_in_prop(A : U0, h : IsProp(U0, A), x, y : A) : x = y {
  hlevel;
}

def from_hint(A : U0, B : A -> U0, h : forall x : A. IsProp(U0, B(x)), a : A) :
  IsSet(U0, B(a) and Nat) {
  hlevel with [h(a)];
}

def after_intro : forall A : U0. IsSet(U0, A) -> IsSet(U0, A -> A) {
  intro A, h;
  hlevel;
}

def after_universe_intro : forall U < UU0. IsSet(U, Nat) {
  intro U;
  hlevel;
}

def after_universe_intros : forall U < UU0. forall A : U. IsSet(U, A) -> IsSet(U, A and (Unit -> A)) {
  intro U, A, h;
  hlevel;
}

def from_have(A : U0, p : Unit -> IsProp(U0, A)) : IsProp(U0, A) {
  let h := p(tt);
  hlevel;
}

def from_have_block(A : U0, p : Unit -> IsProp(U0, A)) : IsSet(U0, A and A) {
  let h : IsProp(U0, A) {
    exact p(tt);
  }
  hlevel;
}

def from_let(A : U0, p : Unit -> IsContr(U0, A)) : IsSet(U0, A) {
  let c := p(tt);
  hlevel;
}

def from_obtain(A : U0, q : IsProp(U0, A) and Nat) : IsSet(U0, A) {
  obtain (h, n) := q;
  hlevel;
}

def prop_at_any_level(n : Nat, A : U0, h : IsProp(U0, A)) : HasLevel(U0, n, A) {
  hlevel;
}

def contractible_at_any_level(n : Nat, A : U0, c : IsContr(U0, A)) : HasLevel(U0, n, A) {
  hlevel;
}

def statement_at_any_level(n : Nat, A : U0) : HasLevel(U0, n, IsSet(U0, A)) {
  hlevel;
}

// Error: E366: hlevel could not prove HasLevel(U0, n, A -> A); nothing in scope states that A -> A
//   has level n.
def same_variable_level(n : Nat, A : U0, h : HasLevel(U0, n, A)) : HasLevel(U0, n, A -> A) {
  hlevel with [h];
}

computable def computable_evidence : IsSet(U0, Nat -> (Nat and Unit)) {
  hlevel;
}

def any_universe(U < UU0, A : U, h : IsSet(U, A)) : IsSet(U, (A -> A) and (Unit -> A)) {
  hlevel;
}

def variable_statement(n : Nat, A : U0) : IsProp(U0, HasLevel(U0, n, A)) {
  hlevel;
}

// hlevel checks dependent path h-levels using evidence at the line's start.
def path_prop(A, B : U0, e : A = B, h : IsSet(U0, A), a : A, b : B) :
  IsProp(U0, PathP(fun (i : Interval) => e @ i, a, b)) {
  hlevel;
}

def path_contr(A, B : U0, e : A = B, h : IsContr(U0, A), a : A, b : B) :
  IsContr(U0, PathP(fun (i : Interval) => e @ i, a, b)) {
  hlevel;
}

// Error: E366: hlevel could not prove IsProp(U0, PathP(fun (i200 : Interval) => e @ i200, a, b)):
//   it needs e @ 0 to be a set; no local evidence, hint or rule gives that.
def no_evidence(A, B : U0, e : A = B, a : A, b : B) :
  IsProp(U0, PathP(fun (i : Interval) => e @ i, a, b)) {
  hlevel;
}

// hlevel refuses, naming the first obligation nothing discharges. The HoTT
// roadmap's D completion: IsProp of an arbitrary type and 0 = 1 stay
// unproved, the second with Nat a set. At a variable level HasLevel does not
// reduce, so evidence in another universe states something else; a
// quantified hypothesis is no evidence until applied; each binder the search
// goes under keeps its name, however deep.
// Error: E366: hlevel could not prove 0 = 1; Nat is not a proposition: 0 and 1 differ.
def zero_is_one : 0 = 1 {
  hlevel;
}

// Error: E366: hlevel could not prove IsProp(U0, Nat); Nat is not a proposition: 0 and 1 differ.
def nat_prop : IsProp(U0, Nat) {
  hlevel;
}

// Error: E366: hlevel could not prove IsProp(U0, A); no local evidence, hint or rule gives that.
def arbitrary(A : U0) : IsProp(U0, A) {
  hlevel;
}

// Error: E366: hlevel could not prove IsSet(U0, A -> Nat and B): it needs Nat and B to be a set,
//   which needs B to be a set; no local evidence, hint or rule gives that.
def nested(A, B : U0) : IsSet(U0, A -> (Nat and B)) {
  hlevel;
}

// Error: E366: hlevel could not prove IsProp(U0, forall x : A. B(x)): it needs B(x) to be a
//   proposition for every x : A; no local evidence, hint or rule gives that.
def dependent(A : U0, B : A -> U0) : IsProp(U0, forall x : A. B(x)) {
  hlevel;
}

// Error: E366: hlevel could not prove IsContr(U0, Void); Void is empty, so it is not contractible.
def void_contractible : IsContr(U0, Void) {
  hlevel;
}

// Error: E364: hlevel proves IsContr, IsProp, IsSet or HasLevel, or an equality in a proposition;
//   the goal is Nat.
def not_a_level : Nat {
  hlevel;
}

// Error: E366: hlevel could not prove HasLevel(U0, n, A); nothing in scope states that A has level
//   n.
def variable_level(n : Nat, A : U0) : HasLevel(U0, n, A) {
  hlevel;
}

// Error: E459: Statements after hlevel are unreachable.
def unreachable : IsProp(U0, Unit) {
  hlevel;
  rfl;
}

// Error: E366: hlevel could not prove HasLevel(U0, n, A); nothing in scope states that A has level
//   n.
def other_universe(n : Nat, A : U0, h : HasLevel(U1, n, A)) : HasLevel(U0, n, A) {
  hlevel;
}

// Error: E363: The hint a has type A, which states no h-level.
def not_a_statement(A : U0, a : A) : IsProp(U0, Unit) {
  hlevel with [a];
}

// Quantified evidence in scope is a rule too, so no hint is needed.
def without_hint(A : U0, B : A -> U0, h : forall x : A. IsProp(U0, B(x)), a : A) :
  IsSet(U0, B(a) and Nat) {
  hlevel;
}

// Error: E366: hlevel could not prove IsProp(U0, forall x : A. Unit and B(x)): it needs Unit and
//   B(x) to be a proposition for every x : A, which needs B(x) to be a proposition; no local
//   evidence, hint or rule gives that.
def nested_names(A : U0, B : A -> U0) : IsProp(U0, forall x : A. Unit and B(x)) {
  hlevel;
}

// A quantified hint is a rule: its parameter is read from the goal
// (hlevel_rules).
def quantified_hint(A : U0, B : A -> U0, h : forall x : A. IsProp(U0, B(x)), a : A) :
  IsProp(U0, B(a)) {
  hlevel with [h];
}
