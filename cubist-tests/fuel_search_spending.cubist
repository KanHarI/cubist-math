// From tests/search-fuel.test.mjs: a search's own questions and rewrites
// are on its fuel. Reading the goal's endpoints is the search's question,
// and each rewrite is counted.
import unat;
use unat;

def nothing(n : UNat) : n = n {
  simp only [];
}

def rewritten(n, m : UNat, h : n = m) : n + 0 = m {
  rw [unat_add_zero(n)];
  exact h;
}

def targeted(n, m : UNat, h : n = m) : n + 0 = m {
  rw [unat_add_zero(n)] at lhs;
  exact h;
}
