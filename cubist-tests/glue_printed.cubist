// A Glue line prints as the source writes it, and written back, that source
// checks. A printed path carries no type: the declaration gives it. The full
// normal form, under !!!, unfolds the fiber the folded one would name.
// tests/cubist-glue.test.mjs checks that the copy below is what the print
// shows.
import glue_;

// Output: fun (A : U0) => path i => Glue(A, face(i, 0, A, (fun (x : A) => x, fun (x : A) => ((x,
//   refl(x)), fun (x1 : exists x1 : A. x = x1) => path i => (x1.2 @ i, path j => x1.2 @ i & j)))),
//   face(i, 1, A, (fun (x : A) => x, fun (x : A) => ((x, refl(x)), fun (x1 : exists x1 : A. x = x1)
//   => path i => (x1.2 @ i, path j => x1.2 @ i & j)))))
print(evaluate(!!!glued_line));

// The print's binders are the normal form's, which carry no names (ABI 4),
// and show the driver's: a follow-up names them after the definitions'.
def again : forall A : U0. A = A := fun (A : U0) => path i => Glue(
  A,
  face(
    i, 0, A,
    (
      fun (x : A) => x,
      fun (x : A) => (
        (x, refl(x)),
        fun (x1 : exists x1 : A. x = x1) => path i => (x1.2 @ i, path j => x1.2 @ i & j)
      )
    )
  ),
  face(
    i, 1, A,
    (
      fun (x : A) => x,
      fun (x : A) => (
        (x, refl(x)),
        fun (x1 : exists x1 : A. x = x1) => path i => (x1.2 @ i, path j => x1.2 @ i & j)
      )
    )
  )
);

def same : glued_line = again {
  rfl;
}
