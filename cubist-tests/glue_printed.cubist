// A Glue line prints as the source writes it, and written back, that source
// checks. A printed path carries no type: the declaration gives it.
// tests/cubist-glue.test.mjs checks that the copy below is what the print
// shows.
import glue_;

// Output: fun (A : U0) => path i => Glue(A, face(i, 0, A, (fun (x : A) => x, fun (y : A) => ((y,
//   refl(y)), fun (p : exists x : A. y = x) => path i => (p.2 @ i, path j => p.2 @ i & j)))),
//   face(i, 1, A, (fun (x : A) => x, fun (y : A) => ((y, refl(y)), fun (p : exists x : A. y = x) =>
//   path i => (p.2 @ i, path j => p.2 @ i & j)))))
print(evaluate(glued_line));

def again : forall A : U0. A = A := fun (A : U0) => path i => Glue(
  A,
  face(
    i, 0, A,
    (
      fun (x : A) => x,
      fun (y : A) => (
        (y, refl(y)), fun (p : exists x : A. y = x) => path i => (p.2 @ i, path j => p.2 @ i & j)
      )
    )
  ),
  face(
    i, 1, A,
    (
      fun (x : A) => x,
      fun (y : A) => (
        (y, refl(y)), fun (p : exists x : A. y = x) => path i => (p.2 @ i, path j => p.2 @ i & j)
      )
    )
  )
);

def same : glued_line = again {
  rfl;
}
