// From tests/proof-ergonomics.test.mjs: Imported simp registrations are
// scoped, and conflicting named sets fail only on use. This module registers
// unat_add_zero by default and as units; ergonomics_simp_rules_b does too, at
// priority 7.
import unat;
use unat;

simp_rule unat_add_zero;
simp_set units := [unat_add_zero];

def registered(n : UNat) : n + 0 = n {
  simp;
}
