// From tests/proof-ergonomics.test.mjs: Each calc by keyword links to its
// checked step in an ordinary declaration.
// No other link starts at `by`, so the source view shows this one.

import unat;
use unat;

def ordinary(B : U0, f : UNat -> B, n : UNat) : f((n + 0) + 0) = f(n) {
  calc {
    f((n + 0) + 0) = f(n + 0) by cong(f, unat_add_zero(n + 0));
    _ = f(n) by cong(f, unat_add_zero(n));
  }
}
