// Selecting a model's notation (L2.4c): use m; for the rest of a block, or
// of the file at its top level, a later use switching it; m.(e) for one
// expression; and a qualified operator, a m.(*) b, with its usual
// precedence, or m.(*) alone, the operation. A parent's operator is reached
// through its label, and inside a theory label.(e) reads a parent's
// notation.
import unat;
import hlevels;
import algebra;
use unat;

def additive_ : Monoid(U0) := nat_additive.monoid;

def multiplicative : Monoid(U0) := nat_multiplicative.monoid;

// * binds tighter than +, whatever its model: 2 * 3, then that and 1.
def mixed : additive_.M := 2 multiplicative.(*) 3 additive_.(*) 1;

// Output: 7
print(evaluate(mixed));

// The monoid reads no numerals: they are unat's.
def product : multiplicative.(unat.(2) * unat.(3) * unat.(4)) = 24 {
  rfl;
}

def sum_of := additive_.(*);

// Output: 9
print(evaluate(sum_of(4, 5)));

def cube(x : UNat) : UNat {
  use multiplicative;
  exact x * x * x * one;
}

// Output: 27
print(evaluate(cube(3)));

// A ring's additive monoid, through its parent's label.
def doubled(R : CommRing(U0), x : R.R) : R.R := x R.additive_.(*) x;

// A file-level use covers the directives after it too, so a natural
// numeral there is unat.(3) (L2.10c).
use additive_;

def twice(x : UNat) : UNat := x * x;

// Output: 6
print(evaluate(twice(unat.(3))));

// An expression in a directive is read in the selection too: * is
// additive's.
// Output: 6
print(evaluate(unat.(3) * unat.(3)));

use multiplicative;

def squared(x : UNat) : UNat := x * x;

// Output: 9
print(evaluate(squared(unat.(3))));

theory Magma(U < UU0) {
  M : set U;
  mul(x, y : M) : M notation x * y;
}

theory Action(U < UU0) {
  M : set U;
  act(x, y : M) : M notation x * y;
}

// Inside a theory, label.(e) and x label.(*) y read a parent's notation.
theory Both(U < UU0) extends Magma, Action {
  law mixed(x : M) : magma.(x * x) = action.(x * x);
  law qualified(x, y : M) : x magma.(*) y = x action.(*) y;
  // A selection inside another is read as it says: action's * here.
  law nested(x, y : M) : magma.(action.(x * y)) = action.act(x, y);
}

// Output: forall U < UU0. forall m : Both(U). forall x : m.M. forall y : m.M. m.act(x, y) =
//   m.act(x, y)
print(typeof(Both.nested));

def both_nat : Both(U0) := Both.make(
  M := UNat, M_is_set := unat_is_set, mul := fun (x, y : UNat) => x, act := fun (x, y : UNat) => x,
  mixed := fun (x : UNat) => refl(x), qualified := fun (x, y : UNat) => refl(x),
  nested := fun (x, y : UNat) => refl(x)
);

def first(x, y : UNat) : UNat := x both_nat.magma.(*) y;

// Error: E832: * is ambiguous in Both: it is magma's mul and action's act. Write both_nat.magma.(*)
//   or both_nat.action.(*).
def unqualified(x : UNat) : UNat := x both_nat.(*) x;

// Error: E835: UNat.(*) takes a model of a theory; UNat is not one.
def not_a_model := 3 UNat.(*) 4;

// Error: E836: Magma binds no operation to +.
def no_notation(G : Magma(U0), x : G.M) : G.M := x G.(+) x;

// Error: E834: use selects a model of a theory, such as m : Group(U0); this is a value of type UNat.
def use_a_number(n : UNat) : UNat {
  use n;
  exact n;
}

// A file-level use is read in what the uses before it select, as the
// definitions after it are: 0 is unat's here.
use unat;

def pick(n : UNat) : Monoid(U0) := multiplicative;

use pick(0);

def picked : UNat := one;

// Output: 1
print(evaluate(picked));

// And inner is the field that use outer opens.
theory Wrapper(U < UU0) {
  inner : Monoid(U);
}

def outer : Wrapper(U0) := Wrapper.make(inner := additive_);

use outer;

use inner;

def wrapped : UNat := one;

// Output: 0
print(evaluate(wrapped));

// A use before it that no longer reads, its model's name taken by a later
// definition, is refused here, as a definition after it would be.
use nat_multiplicative.monoid;

def nat_multiplicative : UNat := unat.(1);

// Error: E343: Untranslated name: nat_multiplicative.monoid
use unat;
