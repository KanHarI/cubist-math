import bnat_transport;
import bnat_notation;
use bnat;

// Closed values transported in both directions along the checked universe
// path agree with the explicit conversion maps.
def forward_zero : comp(fun (i : Interval) => unat_bnat_path @ i, unat.(0)) = 0b0 {
  rfl;
}

def forward_three : comp(fun (i : Interval) => unat_bnat_path @ i, unat.(3)) = 0b11 {
  rfl;
}

def reverse_zero : comp(fun (i : Interval) => unat_bnat_path @ ~i, 0b0) = unat.(0) {
  rfl;
}

def reverse_three : comp(fun (i : Interval) => unat_bnat_path @ ~i, 0b11) = unat.(3) {
  rfl;
}

// The whole operation, transported with its carrier, agrees with direct
// binary arithmetic for all arguments.
def add_agrees(a, b : BNat) :
  comp(
    fun (i : Interval) => (unat_bnat_path @ i) -> (unat_bnat_path @ i) -> (unat_bnat_path @ i), add
  )(a, b) = a + b := unat_bnat_transport_add(a, b);

def mul_agrees(a, b : BNat) :
  comp(
    fun (i : Interval) => (unat_bnat_path @ i) -> (unat_bnat_path @ i) -> (unat_bnat_path @ i), mul
  )(a, b) = a * b := unat_bnat_transport_mul(a, b);

// A dependent function family travels along the same path. Its
// argument's path type changes with that argument and with the carrier.
computable def transported_reflexivity : forall n : BNat. n = n := comp(
  fun (i : Interval) => forall n : unat_bnat_path @ i. n = n, fun (n : UNat) => refl(n)
);

def dependent_family_agrees(n : BNat) :
  transported_reflexivity(n) = refl(n) := bnat_is_set(n, n, transported_reflexivity(n), refl(n));

def dependent_closed :
  transported_reflexivity(0b101) = refl(0b101) := dependent_family_agrees(0b101);

// The universe path's equivalence uses the semiring isomorphism's maps.
def same_forward_map : unat_bnat_equiv.1 = unat_bnat_semiring_iso.to.map {
  rfl;
}

def same_reverse_map :
  equiv_inverse(U0, UNat, BNat, unat_bnat_equiv) = unat_bnat_semiring_iso.from.map {
  rfl;
}
