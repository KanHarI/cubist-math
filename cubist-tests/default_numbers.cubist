// The public Z and Q are binary. Computed values print their quotient
// representatives with decimal magnitudes read from their bits, literals
// print as written, and a generic numeral at a model with a literal rule of
// its own prints as the call.
import rationals;

section {{U < UU0}}(A : CommRing(U)) {
  def six : 6 = 6 := refl(6);
}

def default_integers : Z = BInt {
  rfl;
}

def default_rationals : Q = BQ {
  rfl;
}

use integers;

// Output: class((bnat.(2), bnat.(5)))
print(evaluate(2 - 5));

// Output: class((bnat.(0), bnat.(340282366920938463426481119284349108225)))
print(evaluate(18446744073709551615 * -18446744073709551615));

// Output: 18446744073709551615 = 18446744073709551615
print(typeof(refl(typed(Z, 18446744073709551615))));

use rationals;

// Output: class((class((bnat.(5), bnat.(0))), class((bnat.(6), bnat.(0))), <fun>))
print(evaluate(1/2 + 1/3));

// Output: 18446744073709551615/2 = 18446744073709551615/2
print(typeof(refl(typed(Q, 18446744073709551615/2))));

use nat;

// Output: class((2, 5))
print(evaluate(int(2, 5)));

// Output: class((class((340282366920938463463374607431768211456, 0)), class((1, 0)), <fun>))
print(evaluate(rat_of_nat(340282366920938463463374607431768211456)));

// A literal of one carrier is qualified in another's view.
// Output: integers.(7) = integers.(7)
print(typeof(refl(typed(Z, integers.(7)))));

// The integers' and the rationals' literal rules would read a numeral
// otherwise, so a generic numeral at them keeps the call; its binary natural
// prints in decimal through the literal reader.
// Output: CommRing.of_nat{{U0}}(integers, 6) = CommRing.of_nat{{U0}}(integers, 6)
print(typeof(six(integers)));

def integer_six_again :
  CommRing.of_nat{{U0}}(integers, 6) = CommRing.of_nat{{U0}}(integers, 6) := six(integers);

section {{U < UU0}}(F : Field(U)) {
  def ten : 10 = 10 := refl(10);
}

// Output: Field.of_nat{{U0}}(rationals, 10) = Field.of_nat{{U0}}(rationals, 10)
print(typeof(ten(rationals)));

def rational_ten_again :
  Field.of_nat{{U0}}(rationals, 10) = Field.of_nat{{U0}}(rationals, 10) := ten(rationals);
