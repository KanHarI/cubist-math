// From tests/proof-ergonomics.test.mjs: A parenthesized binder links from its
// keyword like an unparenthesized one.

import unat;

def bare := fun (n : UNat) => n;

def parenthesized := (fun (n : UNat) => n);

def bare_type := forall n : UNat. n = n;

def parenthesized_type := (forall n : UNat. n = n);
