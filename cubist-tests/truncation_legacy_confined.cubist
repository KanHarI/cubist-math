// From tests/truncation-confinement.test.mjs: the archive's legacy builtins over Truncate are
// accepted only in archive modules. A test module is none, so each is refused here, called or
// named, with what replaces it.

// Error: E491: Truncate is the archive's legacy builtin, accepted only in archive modules:
//   elsewhere use the library's Trunc, from h1_truncation, and its axioms LEM and Choice, from
//   classical_axioms.
def truncated(A : U0) := Truncate(U0, A);

// Error: E491: TruncateIntro is the archive's legacy builtin, accepted only in archive modules:
//   elsewhere use the library's Trunc, from h1_truncation, and its axioms LEM and Choice, from
//   classical_axioms.
def introduced(A : U0, a : A) := TruncateIntro(U0, A, a);

// Error: E491: TruncateProp is the archive's legacy builtin, accepted only in archive modules:
//   elsewhere use the library's Trunc, from h1_truncation, and its axioms LEM and Choice, from
//   classical_axioms.
def proposition(A : U0) := TruncateProp(U0, A);

// Error: E491: TruncateElim is the archive's legacy builtin, accepted only in archive modules:
//   elsewhere use the library's Trunc, from h1_truncation, and its axioms LEM and Choice, from
//   classical_axioms.
def eliminated(A, P : U0, prop_ : (forall x, y : P. x = y), f : A -> P) :=
  TruncateElim(U0, A, P, prop_, f);

// Error: E491: LEM is the archive's legacy builtin, accepted only in archive modules: elsewhere use
//   the library's Trunc, from h1_truncation, and its axioms LEM and Choice, from classical_axioms.
def excluded(A : U0, nn : (A -> Void) -> Void) := LEM(U0, A, nn);

// Error: E491: Choice is the archive's legacy builtin, accepted only in archive modules: elsewhere
//   use the library's Trunc, from h1_truncation, and its axioms LEM and Choice, from
//   classical_axioms.
def choice_at_zero := Choice(U0);

// Error: E491: Truncate is the archive's legacy builtin, accepted only in archive modules:
//   elsewhere use the library's Trunc, from h1_truncation, and its axioms LEM and Choice, from
//   classical_axioms.
def named := Truncate;
