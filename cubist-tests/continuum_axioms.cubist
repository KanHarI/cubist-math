// From tests/declarations.test.mjs: the continuum hypotheses as user-supplied axioms, as the
// library will assume them: each statement of continuum_hypothesis is a family over U < UU0 whose
// body lives in next(next(U)), and an axiom definition assumes its body for every U. Every result
// that uses one lists it, and none of them is computable.
import continuum_hypothesis;

def CH := axiom ContinuumHypothesis;

def GCH := axiom GeneralizedContinuumHypothesis;

// Output: forall U < UU0. forall X : next(U). IsSet(next(U), X) -> CardinalLT(next(U), Nat, X) and
//   CardinalLT(next(U), X, PowerSet(U, Nat)) -> Void
print(typeof(CH));

// The generalized hypothesis gives the hypothesis, so this lists GCH alone.
def ch_from_gch(U < UU0) : ContinuumHypothesis(U) := gch_implies_ch(U, GCH(U));

def both(U < UU0) : ContinuumHypothesis(U) and ContinuumHypothesis(U) := (CH(U), ch_from_gch(U));

def at_zero : ContinuumHypothesis(U0) := both(U0).1;

// Error: E330: This computable declaration depends on non-computing assumptions:
//   continuum_axioms::CH. Path to continuum_axioms::CH: continuum_axioms::CH.
computable def computed : ContinuumHypothesis(U0) := CH(U0);
