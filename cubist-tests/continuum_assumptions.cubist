// From tests/declarations.test.mjs: the library's continuum hypotheses, assumed in
// continuum_axioms, as results and refusals show them. Each statement of continuum_hypothesis is a
// family over U < UU0 whose body lives in next(next(U)), and each axiom assumes its body for every
// U: one assumption, labelled by its bare name, since the library's own module assumes it. The
// axioms each result lists are stated in tests/fixtures/contracts/continuum_axiom_contracts.cubist.
import continuum_axioms;

// Output: forall U < UU0. forall X : next(U). IsSet(next(U), X) -> CardinalLT(next(U), Nat, X) and
//   CardinalLT(next(U), X, PowerSet(U, Nat)) -> Void
print(typeof(CH));

// Output: forall U < UU0. forall A : U. IsSet(U, A) -> CardinalLE(U, Nat, A) ->
//   CardinalityDichotomy(next(U), A, PowerSet(U, A))
print(typeof(DecidableGCH));

// The generalized hypothesis gives the hypothesis, so this relies on GCH alone.
def ch_from_gch(U < UU0) : ContinuumHypothesis(U) := gch_implies_ch(U, GCH(U));

def both(U < UU0) : ContinuumHypothesis(U) and ContinuumHypothesis(U) := (CH(U), ch_from_gch(U));

def at_zero : ContinuumHypothesis(U0) := both(U0).1;

// Error: E330: This computable declaration depends on non-computing assumptions: CH, GCH. Path to
//   CH: at_zero → both → CH.
computable def computed : ContinuumHypothesis(U0) := at_zero;

// Error: E324: The evaluated term depends on non-computing assumptions: GCH. Path to GCH:
//   ch_from_gch → GCH.
evaluate nonempty ContinuumHypothesis(U0) by ch_from_gch(U0);
