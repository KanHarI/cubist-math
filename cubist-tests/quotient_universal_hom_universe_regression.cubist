computable def check_group_hom_identity_at_1 := group_hom_identity_at(U1);

computable def check_group_hom_compose_at_1 := group_hom_compose_at(U1);

computable def check_group_hom_object_at_1 := group_hom_object_at(U1);

computable def check_GroupHomLawsAt_2 := GroupHomLawsAt(U2);

computable def check_GroupHomAt_2 := GroupHomAt(U2);

computable def check_group_hom_map_at_2 := group_hom_map_at(U2);

computable def check_group_hom_multiply_at_2 := group_hom_multiply_at(U2);

computable def check_group_is_set_at_2 := group_is_set_at(U2);

