computable def small_hom_specialization(G : Group, H : Group) :
  GroupHomAt(U0, G, H) =[U0] GroupHom(G, H) {
  exact refl(GroupHom(G, H));
}

computable def identity_computes(G : GroupAt(U2), x : group_carrier_at(U2, G)) :
  group_hom_map_at(U2, G, G, group_hom_identity_at(U2, G), x) = x {
  exact refl(x);
}
