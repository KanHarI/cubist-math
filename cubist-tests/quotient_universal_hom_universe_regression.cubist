// From tests/quotient-universal.test.mjs: homomorphism universe schemas
// check at U0–U3 and agree with small homomorphisms, each computable.
import group_homomorphisms;

computable def check_GroupHomLawsAt_0 := GroupHomLawsAt(U0);

computable def check_GroupHomAt_0 := GroupHomAt(U0);

computable def check_group_hom_map_at_0 := group_hom_map_at(U0);

computable def check_group_hom_multiply_at_0 := group_hom_multiply_at(U0);

computable def check_group_is_set_at_0 := group_is_set_at(U0);

