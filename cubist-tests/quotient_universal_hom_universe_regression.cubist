computable def check_group_hom_map_at_3 := group_hom_map_at(U3);

computable def check_group_hom_multiply_at_3 := group_hom_multiply_at(U3);

computable def check_group_is_set_at_3 := group_is_set_at(U3);

computable def check_group_hom_laws_prop_at_3 := group_hom_laws_prop_at(U3);

