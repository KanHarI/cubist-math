computable def check_group_hom_ext_at_0 := group_hom_ext_at(U0);

computable def check_group_hom_identity_at_0 := group_hom_identity_at(U0);

computable def check_group_hom_compose_at_0 := group_hom_compose_at(U0);

computable def check_group_hom_object_at_0 := group_hom_object_at(U0);

computable def check_GroupHomLawsAt_1 := GroupHomLawsAt(U1);

computable def check_GroupHomAt_1 := GroupHomAt(U1);

