// A numeral prints abbreviated, bare or as name.(n), only where its text
// reads back as the same term in the scope it is printed for: a binder or a
// named notation that takes a model's or a reader's name keeps the longer,
// exact form. Each printed text is read back below it.
import algebra;
import differences;
import unat_models;

// A notation that takes unat's name reads otherwise: unary values print as
// their constructors.
notation unat {
  numeral(n : UNat) := succ(n);
}

// Output: succ(succ(zero)) = succ(succ(zero))
print(typeof(refl(succ(succ(zero)))));

def two_unary : succ(succ(zero)) = succ(succ(zero)) := refl(succ(succ(zero)));

def ring_copy : CommRing(U0) := difference_ring{{U0}}(unat_semiring, unat_decide, unat_add_cancel);

use ring_copy;

// Where the selected model is the one in the term, a numeral prints bare.
// Output: 6 = 6
print(typeof(refl(typed(ring_copy.R, 6))));

def global_six : 6 = 6 := refl(6);

// A parameter named as the selected model is another model: its numeral
// prints qualified, since a bare one would read through the selection.
def shadowed(ring_copy : CommRing(U0)) : ring_copy.(6) = ring_copy.(6) := refl(ring_copy.(6));

// Output: forall ring_copy : CommRing(U0). ring_copy.(6) = ring_copy.(6)
print(typeof(shadowed));

def shadowed_again : forall ring_copy : CommRing(U0). ring_copy.(6) = ring_copy.(6) := shadowed;

// A named notation A reads A.(n) before a model A does: a model variable A's
// numeral prints as the call, its binary natural through bnat_numerals.
notation A {
  numeral(n : BNat) := n;
}

section {{U < UU0}}(A : CommRing(U)) {
  def six : 6 = 6 := refl(6);
}

// Output: forall U < UU0. forall A : CommRing(U). CommRing.of_nat{{U}}(A, bnat_numerals.(6)) = CommRing.of_nat{{U}}(A, bnat_numerals.(6))
print(typeof(six));

def six_again :
  forall U < UU0. forall A : CommRing(U).
  CommRing.of_nat{{U}}(A, bnat_numerals.(6)) = CommRing.of_nat{{U}}(A, bnat_numerals.(6)) := six;

// Likewise for bnat_numerals' name: a binary value prints through another
// notation that reads it as itself, here A, and as its constructors where
// none does.
notation bnat_numerals {
  numeral(n : BNat) := b_zero;
}

// Output: A.(3) = A.(3)
print(typeof(refl(b_positive(bp_odd(bp_one)))));

def three_by_a : A.(3) = A.(3) := refl(b_positive(bp_odd(bp_one)));

notation A {
  numeral(n : BNat) := b_zero;
}

// Output: b_positive(bp_odd(bp_one)) = b_positive(bp_odd(bp_one))
print(typeof(refl(b_positive(bp_odd(bp_one)))));

def three_bits :
  b_positive(bp_odd(bp_one)) = b_positive(bp_odd(bp_one)) := refl(b_positive(bp_odd(bp_one)));
