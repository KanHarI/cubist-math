// From tests/computability.test.mjs: Evaluation unfolds every definition and
// ignores unfolding hints.

import unat;
use unat;

def boxed(n : UNat) := succ(n);

def identity(n : UNat) := n;

evaluate boxed(1) expecting 2;
evaluate with unfolding [identity] {
  identity(boxed(2))
} expecting 3;
evaluate with unfolding [] {
  boxed(boxed(0))
} expecting boxed(1);

// Evaluation unfolds boxed, though the hint names no definition.
// Output: 2
print(evaluate(with unfolding [] {
      boxed(boxed(0))
    }));
