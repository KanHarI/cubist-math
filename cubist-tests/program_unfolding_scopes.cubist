// From tests/cubical-program.test.mjs: unfolding scopes close local
// variables and interval coordinates without leaking hints.

import unat;

def id_(n : UNat) := n;

def local(n : UNat) : id_(n) = n {
  exact with unfolding [id_] {
    refl(n)
  };
}

def scoped_path(n : UNat, p : n = n) :=
  path(fun (i : Interval) => UNat, fun (i : Interval) => with unfolding [id_] {
      at(p, i)
    });

def endpoint(n : UNat, p : n = n) : at(scoped_path(n, p), 0) = n {
  exact refl(n);
}
