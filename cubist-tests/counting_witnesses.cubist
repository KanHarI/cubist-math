// The truncated counting results compute: a witness read off a closed mere
// enumeration (library/finite_choice.cubist), projected to a number. The
// contracts in tests/fixtures/contracts/counting_contracts.cubist check that
// these results use no assumption.
import finite_choice;
use nat;

// Finite choice: the section chosen over Fin(2), at 1, is the element given.
// Output: 2 : Nat
print(
  witness(
    mere_map(
      U0, U0, forall i : Fin(2). Fin(3), Nat, fun (s : forall i : Fin(2). Fin(3)) => s((1, tt)).1,
      fin_choice(2, fun (i : Fin(2)) => Fin(3), fun (i : Fin(2)) => merely(U0, Fin(3), (2, tt)))
    )
  )
);

// Fibered counting: Fin(2) with fibers Fin(3) has 6 elements, the fourth
// (from 0) at base 1 and fiber 1, as 4 = 1 * 3 + 1.
// Output: 1 : Nat
print(
  witness(
    mere_map(
      U0, U0, ContrEquiv(U0, Fin(2 * 3), exists a : Fin(2). Fin(3)), Nat,
      fun (e : ContrEquiv(U0, Fin(2 * 3), exists a : Fin(2). Fin(3))) => e.1((4, tt)).2.1,
      fibered_cardinality(
        Fin(2), 2, fin_cardinality(2), fun (a : Fin(2)) => Fin(3), 3,
        fun (a : Fin(2)) => fin_cardinality(3)
      )
    )
  )
);

// Fin(4) with fibers Fin(5): 17 = 3 * 5 + 2, at base 3 and fiber 2.
// Output: 3 : Nat
print(
  witness(
    mere_map(
      U0, U0, ContrEquiv(U0, Fin(4 * 5), exists a : Fin(4). Fin(5)), Nat,
      fun (e : ContrEquiv(U0, Fin(4 * 5), exists a : Fin(4). Fin(5))) => e.1((17, tt)).1.1,
      fibered_cardinality(
        Fin(4), 4, fin_cardinality(4), fun (a : Fin(4)) => Fin(5), 5,
        fun (a : Fin(4)) => fin_cardinality(5)
      )
    )
  )
);

// Output: 2 : Nat
print(
  witness(
    mere_map(
      U0, U0, ContrEquiv(U0, Fin(4 * 5), exists a : Fin(4). Fin(5)), Nat,
      fun (e : ContrEquiv(U0, Fin(4 * 5), exists a : Fin(4). Fin(5))) => e.1((17, tt)).2.1,
      fibered_cardinality(
        Fin(4), 4, fin_cardinality(4), fun (a : Fin(4)) => Fin(5), 5,
        fun (a : Fin(4)) => fin_cardinality(5)
      )
    )
  )
);
