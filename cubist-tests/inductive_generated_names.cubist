// From tests/inductive-declarations.test.mjs: Inspection: generated names
// print as themselves after every round of suffixes.
// The fifth review of #74: a generated name prints as itself after every
// round of suffixes. P__ printed as nothing, as the display reads __ as a
// module's separator: the motive vanished from its clause, and U__ left the
// universe blank. After one underscore, names take a letter.

inductive E(P, Q, M, R, P_, Q_, M_, R_ : U0) {
  e;
}

inductive F(U, V, W, X, Y, V_, W_, X_, Y_ : U0) {
  f;
}

inductive D {
  c_;
  d(x : D);
}

// Output: inductive E : U0 -> U0 -> U0 -> U0 -> U0 -> U0 -> U0 -> U0 -> U0 (type) { e : E [0 data,
//   0 positions, 0 dimensions]; } eliminator for P_a : E(P, Q, M, R, P_, Q_, M_, R_) -> U { e_case
//   : P_a(e); }
print(inspect(E));
// Output: inductive F : U0 -> U0 -> U0 -> U0 -> U0 -> U0 -> U0 -> U0 -> U0 -> U0 (type) { f : F [0
//   data, 0 positions, 0 dimensions]; } eliminator for P : F(U, V, W, X, Y, V_, W_, X_, Y_) -> U_a
//   { f_case : P(f); }
print(inspect(F));
// Output: inductive D : U0 (type) { c_ : D [0 data, 0 positions, 0 dimensions]; d : D -> D [0 data,
//   1 position, 0 dimensions]; } eliminator for P : D -> U { c_case : P(c_); d_case : forall x : D.
//   P(x) -> P(d(x)); }
print(inspect(D));
