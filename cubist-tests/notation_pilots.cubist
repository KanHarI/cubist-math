// The notation roadmap's pilots (L2.10e): its proposed examples on the
// library's integers, rationals and algebra, checked. Each qualifier a
// pilot needs is counted in the roadmap.
import nat;
import hlevels;
import algebra;
import integers;
import rationals;
use nat;

// The integers, selected for a statement and its proof.
def add_comm(x, y : Z) : integers.(x + y = y + x) := int_add_comm(x, y);

// Mixed arithmetic: int's arguments are natural numbers, so inside the
// integers' notation they are qualified.
def mixed(n : Nat, x : Z) : Z := integers.(x * int(nat.(n + 1), nat.(0)));

// One literal, read by the rationals' parser, and a sum of two.
def half : Q := rationals.(1/2);

def sum_value : Q := rationals.(1/2 + 1/3);

// A theorem's target in the rationals' notation, proved by deciding the
// equation: the decision, evaluated, is yes, and its proof is the
// equation's (explicit, as L2.10g's decide is deferred).
computable def Yes(U < UU0, P : U, d : Decidable(U, P)) : U0 := match d return U0 {
    left p => Unit;
    right n => Void;
  };

computable def decided(U < UU0, P : U, d : Decidable(U, P), yes : Yes(U, P, d)) :
  P := (match d as e return Yes(U, P, e) -> P {
    left p => fun (s : Unit) => p;
    right n => fun (s : Void) => typed(P, absurd(s));
  })(yes);

def five_sixths : rationals.(1/2 + 1/3 = 5/6) := decided(
  U0, rationals.(1/2 + 1/3) = rationals.(5/6), rat_decide(rationals.(1/2 + 1/3), rationals.(5/6)), tt
);

// rationals.(1/0) is refused at its denominator.
// Error: E905: rationals's literal rule refuses 1/0 at its character 3.
def undefined : Q := rationals.(1/0);

// A group's statement in its notation, with its field names.
def square_one(U < UU0, G : Group(U)) : G.(one * one = one) := G.one_mul(G.one);

// Same carrier, different operations, with no competing registrations.
def additive_product(x, y : Nat) : Nat := nat_additive.(x * y);

def multiplicative_product(x, y : Nat) : Nat := nat_multiplicative.(x * y);

// Output: 7
print(evaluate(additive_product(3, 4)));

// Output: 12
print(evaluate(multiplicative_product(3, 4)));
