// Partial elements on a face whose dimensions a variable's type mentions.
//
// A tube, a Glue piece or a glue value lives on its face, and there a
// variable's type is the type on that face: g : Glue(A, face(k, 0, A, e)) is
// at A where k = 0. The kernel types such a part on its face with Restrict,
// in a context that assumes the face, and only the partial element on that
// face discharges the assumption. Each case opens in the workspace, where the
// Kernel graph shows the Restrict steps.
import contractible_maps;

// Glue eta for a variable: glue(unglue(g), face(k, 0, g)) is g, and its value
// on k = 0 is g itself, of the Glue type, which is A there.
def glue_eta(A : U0) :=
  path(
    fun (k : Interval) => forall g : Glue(A, face(k, 0, A, id_contr_equiv(U0, A))). g = g,
    fun (k : Interval) => fun (g : Glue(A, face(k, 0, A, id_contr_equiv(U0, A)))) => path i => glue(
      unglue(g), face(k, 0, g)
    )
  );

// A composition whose tube is a variable of a type that mentions the tube's
// face: x : loop @ k is in the family there, loop @ 0, only on k = 0.
def tube_on_its_face(A : U0, loop : A = A) :=
  path(
    fun (k : Interval) => loop @ k -> loop @ k,
    fun (k : Interval) => fun (x : loop @ k) => comp(
      fun (i : Interval) => loop @ k, x, face(k, 0, fun (i : Interval) => x)
    )
  );

// The variable is used inside the tube, as the argument of a function on
// loop @ 0, which it is there.
def variable_inside_a_tube(A : U0, loop : A = A) :=
  path(
    fun (k : Interval) => loop @ k -> loop @ k,
    fun (k : Interval) => fun (x : loop @ k) => comp(
      fun (i : Interval) => loop @ k, x,
      face(k, 0, fun (i : Interval) => (fun (y : loop @ 0) => y)(x))
    )
  );

// The same, with the variable given its type there: in the tube, the
// coordinate k is 0, so typed(loop @ 0, x) is checked where x is at loop @ 0.
def typed_inside_a_tube(A : U0, loop : A = A) :=
  path(
    fun (k : Interval) => loop @ k -> loop @ k,
    fun (k : Interval) => fun (x : loop @ k) => comp(
      fun (i : Interval) => loop @ k, x, face(k, 0, fun (i : Interval) => typed(loop @ 0, x))
    )
  );

// Two such tubes agree where both faces hold, j = 0 and k = 0.
def overlapping_tubes(A : U0, loop : A = A) :=
  path(
    fun (j : Interval) => PathP(
      fun (k : Interval) => loop @ k -> loop @ k,
      fun (x : loop @ 0) => comp(
        fun (i : Interval) => loop @ 0, x, face(j, 0, fun (i : Interval) => x),
        face_when(1, fun (i : Interval) => x)
      ),
      fun (x : loop @ 1) => comp(
        fun (i : Interval) => loop @ 1, x, face(j, 0, fun (i : Interval) => x),
        face_when(0, fun (i : Interval) => x)
      )
    ),
    fun (j : Interval) => path k => fun (x : loop @ k) => comp(
      fun (i : Interval) => loop @ k, x, face(j, 0, fun (i : Interval) => x),
      face(k, 0, fun (i : Interval) => x)
    )
  );
