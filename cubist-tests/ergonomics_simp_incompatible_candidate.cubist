// From tests/proof-ergonomics.test.mjs: A quantified rule with an
// incompatible parameter type leaves later rules available.

import primes;
use unat;

computable def through(f : UNat -> UNat, n : UNat) : f(n + 0) = f(n) {
  exact cong(f, unat_add_zero(n));
}

computable def family(P : UNat -> U0, n : UNat) : P(n + 0) = P(n) {
  simp only [through, unat_add_zero];
}
