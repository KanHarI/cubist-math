// From tests/proof-ergonomics.test.mjs: Exclusions remove defaults and
// hypothesis simplification keeps the source.

import primes;
use unat;

simp_rule unat_add_zero;
simp_set units := [unat_add_zero];
// Error: E456: simp only left an unresolved equality goal; add a following proof statement.
//   Remaining goal: n + 0 = n. No rule fired.
def removed(n : UNat) : n + 0 = n {
  simp without [unat_add_zero];
}

// Error: E456: simp only left an unresolved equality goal; add a following proof statement.
//   Remaining goal: n + 0 = n. No rule fired.
def removed_set(n : UNat) : n + 0 = n {
  simp [units] without [units];
}

def retained(n : UNat, h : n + 0 = n) : n + 0 = n {
  simp at h as normalized;
  exact h;
}

computable def normalized(n : UNat, h : n + 0 = n) : n = n {
  simp at h as shorter;
  exact shorter;
}

// Error: E454: simp at requires a local hypothesis: unat_add_zero.
def global_rejected(n : UNat) : n = n {
  simp only [] at unat_add_zero as bad;
  rfl;
}
