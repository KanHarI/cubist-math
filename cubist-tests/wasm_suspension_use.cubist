// From tests/cubical-wasm.test.mjs: source-defined suspension induction
// uses a proved PathP bridge.
import suspension_types;

def C := Suspension(Unit);

def family(p : C) := Unit;

def unique(u : Unit) := unit_induction(fun (x : Unit) => x = tt, refl(tt), u);

def boundary(a : Unit) :=
  unique(transport(family, north(Unit), south(Unit), meridian(Unit, a), tt));

def collapse(p : C) := suspension_induction(Unit, family, tt, tt, boundary, p);

def point_beta : collapse(north(Unit)) = tt {
  exact refl(tt);
}

def bridge_beta(a : Unit) : apd(collapse, north(Unit), south(Unit), meridian(Unit, a)) = boundary(a) {
  exact suspension_meridian_beta(Unit, family, tt, tt, boundary, a);
}
