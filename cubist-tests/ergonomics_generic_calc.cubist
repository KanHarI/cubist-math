// From tests/proof-ergonomics.test.mjs: Generic calc endpoints stay separate
// from step witnesses.
// The step's checked path belongs to its `by` keyword, not its left endpoint.

import unat;
use unat;

def generic(U < UU0, n : UNat) : n + 0 = n {
  calc {
    n + 0 = n by unat_add_zero(n);
  }
}
