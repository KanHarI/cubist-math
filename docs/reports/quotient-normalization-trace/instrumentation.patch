  * Full normalization is only requested for an explicit inspection result. */
 #include "term_internal.h"

+#include <stdio.h>
+/* TEMPORARY DIAGNOSTIC: records contractions, never returns partial judgements. */
+typedef struct { char mode; cc_term entry, current; cc_node node; } trace_frame;
+static trace_frame trace_frames[2200];
+static unsigned trace_depth, trace_count, trace_limit;
+static bool trace_enabled;
+bool ck_trace_enabled(void) { return trace_enabled; }
+static cc_term trace_whnf_impl(cc_kernel *, cc_term);
+static cc_term trace_normal_impl(cc_kernel *, cc_term);
+void ck_trace_start(cc_kernel *k, unsigned limit) {
+    trace_depth = trace_count = 0; trace_limit = limit; trace_enabled = limit != 0;
+    /* No multi-contraction cache shortcuts in a contraction-count trace. */
+    memset(k->weak_cache, 0, k->capacity * sizeof *k->weak_cache);
+    memset(k->normal_cache, 0, k->capacity * sizeof *k->normal_cache);
+}
+static void trace_current(cc_kernel *k, cc_term term, const cc_node *node) {
+    if (!trace_enabled || !trace_depth) return;
+    trace_frames[trace_depth-1].current = term;
+    trace_frames[trace_depth-1].node = node ? *node : k->nodes[term];
+}
+cc_term ck_trace_rewrite(cc_kernel *k, const char *rule, cc_term before, cc_term after) {
+    if (!trace_enabled || !after || k->error[0]) return after;
+    trace_current(k, after, NULL);
+    fprintf(stderr, "REWRITE %u %s %u %u work=%llu nodes=%zu\n", ++trace_count, rule, before, after,
+            (unsigned long long)k->work.query_steps, k->count);
+    if (trace_count == 1 || trace_count == 2 || trace_count == 5 || trace_count == 10 ||
+        trace_count == 20 || trace_count == 50 || trace_count == trace_limit) {
+        for (unsigned i=0; i<trace_depth; ++i) {
+            trace_frame f=trace_frames[i]; cc_node n=f.node;
+            fprintf(stderr,"STATE %u %u %c %u %u %u %u %u,%u,%u,%u\n", trace_count,i,f.mode,
+                    f.entry,f.current,n.kind,n.payload,n.child[0],n.child[1],n.child[2],n.child[3]);
+        }
+    }
+    if (trace_count == trace_limit) return ck_fail_as(k,CC_ERROR_RESOURCE,"Diagnostic contraction checkpoint reached."),0;
+    return after;
+}
+cc_term ck_trace_then_whnf(cc_kernel *k, const char *rule, cc_term before, cc_term after) {
+    cc_term next=ck_trace_rewrite(k,rule,before,after); return next ? ck_whnf(k,next) : 0;
+}
+static cc_term trace_call(cc_kernel *k, cc_term term, bool normal) {
+    if (!trace_enabled) return normal ? trace_normal_impl(k,term) : trace_whnf_impl(k,term);
+    if (!term || k->error[0]) return 0;
+    if (trace_depth >= 2200) return ck_fail_as(k,CC_ERROR_RESOURCE,"Diagnostic trace stack full."),0;
+    trace_frames[trace_depth++] = (trace_frame){normal?'N':'W',term,term,k->nodes[term]};
+    cc_term result=normal ? trace_normal_impl(k,term) : trace_whnf_impl(k,term);
+    trace_depth--;
+    return result;
+}
+cc_term ck_whnf(cc_kernel *k, cc_term t) { return trace_call(k,t,false); }
+cc_term ck_normal(cc_kernel *k, cc_term t) { return trace_call(k,t,true); }
+
+
 static cc_term app(cc_kernel *k, cc_term f, cc_term x) {
     return ck_make(k, CC_APP, 0, f, x, 0, 0);
 }
