import primes;
use unat;

// Current expansion for a two-step calc or simp only [unat_add_zero].
def add_zero_twice(n : UNat) : (n + 0) + 0 = n {
  exact trans(unat_add_zero(n + 0), unat_add_zero(n));
}

// A fixed-codomain application needs congruence as well as rewriting.
def add_zero_under_function(B : U0, f : UNat -> B, n : UNat) : f((n + 0) + 0) = f(n) {
  exact cong(f, add_zero_twice(n));
}

// An explicitly reversed rule is a path with its orientation retained.
def insert_zero(n : UNat) : n = n + 0 {
  exact sym(unat_add_zero(n));
}
