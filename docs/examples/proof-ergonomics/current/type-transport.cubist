// Explicit predecessors for checked type-goal simpa.
import primes;
use unat;

def move_type(A, B : U0, p : A = B, a : A) : B {
  exact transport(fun (X : U0) => X, A, B, p, a);
}

def move_type_back(A, B : U0, p : A = B, b : B) : A {
  exact transport(fun (X : U0) => X, B, A, sym(p), b);
}

def family_simpa(P : UNat -> U0, n : UNat, h : P(n)) : P(n + 0) {
  exact transport(P, n, n + 0, sym(unat_add_zero(n)), h);
}
