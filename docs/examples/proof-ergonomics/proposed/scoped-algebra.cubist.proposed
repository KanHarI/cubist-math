// DESIGN FIXTURE: unsupported syntax; PR 11 exploration, not release-one API.
// This specifies a lexical notation pack using existing checked projections.
import field_vector_spaces;

// 'notation' declares expansion templates, not hidden parameters/instances.
notation field_ops(F : AlgebraicField) {
  infix + := af_add(af_carrier(F), af_operations(F));
  infix * := af_mul(af_carrier(F), af_operations(F));
  alias zero := af_zero(af_carrier(F), af_operations(F));
  alias one := af_one(af_carrier(F), af_operations(F));
}

// A signature-level scope covers its return type and proof, after F is bound.
def field_add_zero(F : AlgebraicField, x : af_carrier(F))
  with notation field_ops(F) : x + zero = x {
  exact group_unit_right(FieldAdditiveGroup(F), x);
}

