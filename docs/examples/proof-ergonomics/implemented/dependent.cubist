// Checked dependent path and transport conveniences.
// Current checked counterparts: ../current/dependent-transport.cubist
// and ../current/path-coherence.cubist.
import paths;

// Only the endpoints are inferred. The family and path are selected explicitly.
def move_in_fiber(A : U0, C : A -> U0, x, y : A, p : x = y, v : C(x)) : C(y) {
  exact along C by p from v;
}

def section_path(A : U0, C : A -> U0, f : (forall a : A. C(a)), x, y : A, p : x = y) :
  PathP(fun (i : Interval) => C(p @ i), f(x), f(y)) {
  exact path i => f(p @ i);
}

// Alternate frontend API for the same direct dependent path.
def section_path_action(A : U0, C : A -> U0, f : (forall a : A. C(a)), x, y : A, p : x = y) :
  PathP(fun (i : Interval) => C(p @ i), f(x), f(y)) {
  exact apd_path(f, p);
}

// Deliberately show the bridge: its subgoal is the existing apd result type,
// transport(C,x,y,p,f(x)) = f(y), and its output is a dependent path.
// The round trip need not be judgmentally equal to section_path.
def section_via_transport(A : U0, C : A -> U0, f : (forall a : A. C(a)), x, y : A, p : x = y) :
  PathP(fun (i : Interval) => C(p @ i), f(x), f(y)) {
  over C along p by {
    exact apd(f, x, y, p);
  }
}

// transport's result here has a fixed fiber C(x), so explicit congruence works.
// Its core term is a Comp: PR 4's application-only traversal cannot descend
// into its source-level arguments. Keep the known congruence context explicit.
def loop_action_right_unit(A : U0, C : A -> U0, x : A, p : x = x, v : C(x)) :
  transport(C, x, x, trans(p, refl(x)), v) = transport(C, x, x, p, v) {
  exact cong(fun (q : x = x) => transport(C, x, x, q, v), right_unit(A, x, x, p));
}

// The supplied loop p is still present in the result above. There is no
// simplification of transport(C,x,x,p,v) to v without additional evidence.
