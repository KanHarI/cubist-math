// Invariant 10 of the HoTT roadmap: every closed result that uses no
// truncation or other assumption reduces to a canonical value. Each
// declaration states that value and is proved by rfl, so the kernel must
// compute it, and each is marked computable, so it may use no assumption. A
// failure here means a kernel or library change has stopped an
// assumption-free result from computing.
import unat;
import circle;
import hlevels;
import quotients;
use unat;

// Natural-number recursion.
computable def closed_arithmetic : add(mul(3, 4), 5) = 17 {
  rfl;
}

// General induction names recursive results separately from stored fields.
computable def closed_induction_double : (induction 3 return UNat {
      zero => 0;
      succ(k) with ih => succ(succ(ih));
    }) = 6 {
  rfl;
}

evaluate (induction 3 return UNat {
    zero => 0;
    succ(k) with ih => succ(succ(ih));
  }) expecting 6;

// Derived path induction along a closed path that is not refl.
computable def closed_path_induction :
  path_induction(
    UNat, fun (a : UNat) => fun (b : UNat) => fun (r : a = b) => UNat, fun (a : UNat) => 7, 3 + 0,
    3, unat_add_zero(3)
  ) = 7 {
  rfl;
}

// Transport along a closed path, and along a closed family.
computable def closed_transport :
  transport(fun (n : UNat) => UNat, 3 + 0, 3, unat_add_zero(3), 5) = 5 {
  rfl;
}

computable def closed_dependent_transport :
  transport(fun (n : UNat) => n = n, 3 + 0, 3, unat_add_zero(3), refl(3 + 0)) = refl(3) {
  rfl;
}

// Univalence (Glue) and the circle's declared pushout: winding numbers compute.
computable def winding_one : winding(loop) = nonnegative(1) {
  rfl;
}

computable def winding_two :
  winding(concatenate(U1, S1, base, base, base, loop, loop)) = nonnegative(2) {
  rfl;
}

computable def winding_minus_one : winding(loop_inverse) = negative(0) {
  rfl;
}

computable def winding_integer_loop : winding(integer_loop(negative(2))) = negative(2) {
  rfl;
}

// The same computation, stated as a checked normal-form test.
evaluate winding(concatenate(U1, S1, base, base, base, loop, loop)) expecting nonnegative(2);

// h-levels: the contraction of Unit has a canonical center, and the path
// and the square the h-level lemmas build between closed elements compute
// to reflexivity. A neutral path or square would not be refl.
computable def unit_center : unit_is_contr.1 = tt {
  rfl;
}

computable def unit_path_computes : unit_is_prop(tt, tt) = refl(tt) {
  rfl;
}

computable def unit_square_computes :
  prop_is_set(U0, Unit, unit_is_prop, tt, tt, refl(tt), refl(tt)) = refl(refl(tt)) {
  rfl;
}

computable def retract_path_computes :
  retract_has_level(
    U0, 0, Unit, Unit, fun (u : Unit) => u, fun (u : Unit) => u, fun (u : Unit) => refl(u),
    unit_is_prop, tt, tt
  ) = refl(tt) {
  rfl;
}

computable def nat_decision_computes : match unat_decide(2, 3) return UNat {
    left p => 1;
    right n => 0;
  }
= 0{
  rfl;
}

computable def nat_square_computes : unat_is_set(1, 1, refl(1), refl(1)) = refl(refl(1)) {
  rfl;
}

computable def unit_paths_contract : path_is_contr(U0, Unit, unit_is_contr, tt, tt).1 = refl(tt) {
  rfl;
}

// Effective quotients: the path between two closed classes gives back the
// relation between their elements, through the set of propositions and
// univalence's Glue types.
computable def effective_class_computes :
  quotient_effective(
    U0, UNat, fun (m, n : UNat) => m = n, fun (m, n : UNat) => unat_is_set(m, n),
    fun (n : UNat) => refl(n), fun (m, n : UNat, r : m = n) => sym(r),
    fun (k, m, n : UNat, r : k = m, s : m = n) => trans(r, s), 2, 2,
    class_path(U0, UNat, fun (m, n : UNat) => m = n, 2, 2, refl(2))
  ) = refl(2) {
  rfl;
}

evaluate unit_is_contr.1 expecting tt;
