import h1_truncation;

// Keep the original public predicate in scope for the ledger comparison.
def FieldProp(P : U1) := forall p : P. forall q : P. p = q;

// K2.5, G2: this wrapper and its original public predicate are compared.
computable def small_mere_eliminate(
  A : U0, P : U1, prop : IsProp(U1, P), f : A -> P, h : Trunc(U0, A)
) :
  P := mere_eliminate(U0, U1, A, P, prop, f, h);
