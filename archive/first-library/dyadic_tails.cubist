import unat;
import dyadic_decay;
use unat;

// Halving a nonnegative width cannot increase it.
def nonnegative_half_le(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), width, halfWidth : F,
  sum : addF(halfWidth, halfWidth) = width, nonnegativeWidth : FieldLe(F, lt, zero, width)
) :
  FieldLe(F, lt, halfWidth, width) {
  let nonnegativeHalf := nonnegative_half_from_sum(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, width, halfWidth, sum,
    nonnegativeWidth
  );
  exact transport order_le_add_nonnegative(
    F, zero, one, addF, mulF, negF, lt, ring, arithmetic, halfWidth, halfWidth, nonnegativeHalf
  ) along sum in FieldLe(F, lt, halfWidth);
}

// The recursive width applies one halving to the input before the previous
// iterate. Induction therefore generalizes over that input width.
def dyadic_width_step_le(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F. addF(half(x), half(x)) = x), depth : UNat
) :
  forall width : F. FieldLe(F, lt, zero, width)
  -> FieldLe(F, lt, dyadic_width(F, half, succ(depth), width), dyadic_width(F, half, depth, width)) {
  exact induction depth as k return (
    forall width : F. FieldLe(F, lt, zero, width)
    -> FieldLe(F, lt, dyadic_width(F, half, succ(k), width), dyadic_width(F, half, k, width))
  ) {
    zero => fun (width : F, nonnegativeWidth : FieldLe(F, lt, zero, width)) => nonnegative_half_le(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, width, half(width),
      halfSum(width), nonnegativeWidth
    );
    succ previous => fun (width : F, nonnegativeWidth : FieldLe(F, lt, zero, width)) => previous(
      half(width),
      nonnegative_half_from_sum(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, width, half(width),
        halfSum(width), nonnegativeWidth
      )
    );
  };
}

// Turn successive weak decreases into the inequality for arbitrary ordered
// natural indices. IndexLE is definitionally the same natural order as le.
def field_sequence_antitone_step(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, lt : F -> F -> U0, order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), sequence : UNat -> F,
  decreasing : (forall k : UNat. FieldLe(F, lt, sequence(succ(k)), sequence(k))), n : UNat,
  previous : (forall m : UNat. IndexLE(m, n) -> FieldLe(F, lt, sequence(n), sequence(m))), m : UNat,
  ordered : IndexLE(m, succ(n))
) :
  FieldLe(F, lt, sequence(succ(n)), sequence(m)) {
  match nat_le_succ_split(m, n, ordered) {
    left(earlier) => {
      exact order_le_trans(
        F, zero, one, addF, mulF, lt, arithmetic, sequence(succ(n)), sequence(n), sequence(m),
        decreasing(n), previous(m, earlier)
      );
    }
    right(same) => {
      exact transport order_le_refl(F, lt, order, sequence(succ(n))) along sym(same) in (
        (fun (k : UNat) => FieldLe(F, lt, sequence(succ(n)), sequence(k)))
      );
    }
  }
}

def field_sequence_antitone(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, lt : F -> F -> U0, order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), sequence : UNat -> F,
  decreasing : (forall k : UNat. FieldLe(F, lt, sequence(succ(k)), sequence(k))), n : UNat
) :
  forall m : UNat. IndexLE(m, n) -> FieldLe(F, lt, sequence(n), sequence(m)) {
  let base : forall m : UNat. IndexLE(m, 0) -> FieldLe(F, lt, sequence(0), sequence(m)) {
    intro m, ordered;
    exact transport order_le_refl(F, lt, order, sequence(0)) along sym(nat_le_zero(m, ordered)) in (
      (fun (k : UNat) => FieldLe(F, lt, sequence(0), sequence(k)))
    );
  }
  exact induction n as k return (
    forall m : UNat. IndexLE(m, k) -> FieldLe(F, lt, sequence(k), sequence(m))
  ) {
    zero => base;
    succ previous => field_sequence_antitone_step(
      F, zero, one, addF, mulF, lt, order, arithmetic, sequence, decreasing, k, previous
    );
  };
}

def dyadic_width_antitone(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F. addF(half(x), half(x)) = x), width : F,
  nonnegativeWidth : FieldLe(F, lt, zero, width), bound, n : UNat, later : IndexLE(bound, n)
) :
  FieldLe(F, lt, dyadic_width(F, half, n, width), dyadic_width(F, half, bound, width)) {
  exact field_sequence_antitone(
    F, zero, one, addF, mulF, lt, order, arithmetic,
    (fun (k : UNat) => dyadic_width(F, half, k, width)),
    (
      fun (k : UNat) => dyadic_width_step_le(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, k, width,
        nonnegativeWidth
      )
    ), n, bound, later
  );
}

def dyadic_width_small_tail(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F. addF(half(x), half(x)) = x), width : F,
  nonnegativeWidth : FieldLe(F, lt, zero, width), epsilon : F, bound : UNat,
  small : lt(dyadic_width(F, half, bound, width), epsilon)
) :
  forall n : UNat. IndexLE(bound, n) -> lt(dyadic_width(F, half, n, width), epsilon) {
  obtain (positiveOne, translate, scale, weakScale, ltLe, leLt, splitPositive) := arithmetic;
  intro n, later;
  exact leLt(
    dyadic_width(F, half, n, width), dyadic_width(F, half, bound, width), epsilon,
    dyadic_width_antitone(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, width,
      nonnegativeWidth, bound, n, later
    ), small
  );
}

// Archimedeanness supplies a merely existing bound for the whole tail.
// This does not choose an actual convergence modulus.
def dyadic_width_eventually_small(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F. addF(half(x), half(x)) = x),
  inverses : FieldInverses(F, zero, one, mulF, lt),
  archimedean : Archimedean(F, zero, one, addF, lt), width : F,
  nonnegativeWidth : FieldLe(F, lt, zero, width), epsilon : F, positiveEpsilon : lt(zero, epsilon)
) :
  FieldExists(
    exists bound : UNat. forall n : UNat. IndexLE(bound, n)
    -> lt(dyadic_width(F, half, n, width), epsilon)
  ) {
  let A := (exists depth : UNat. lt(dyadic_width(F, half, depth, width), epsilon));
  let B := (
    exists bound : UNat. forall n : UNat. IndexLE(bound, n)
    -> lt(dyadic_width(F, half, n, width), epsilon)
  );
  let mapping : A -> B {
    intro data;
    obtain (bound, small) := data;
    exact (
      bound,
      dyadic_width_small_tail(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, width,
        nonnegativeWidth, epsilon, bound, small
      )
    );
  }
  exact field_exists_map(
    A, B, mapping,
    dyadic_width_arbitrarily_small(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, inverses,
      archimedean, width, nonnegativeWidth, epsilon, positiveEpsilon
    )
  );
}
