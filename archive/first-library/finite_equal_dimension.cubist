import artin_evaluation_matrix;
import extension_degree;

// An injective map between two n-dimensional spaces is onto. The proof
// transports both spaces to the same coordinate space and uses the checked
// square-matrix result.
def equal_basis_dimension_injective_surjective(
  K : AlgebraicField, V, W : VectorSpace(K), n : Nat, basisV : FiniteBasis(K, V, n),
  basisW : FiniteBasis(K, W, n), f : LinearMap(K, V, W), injective : LinearInjective(K, V, W, f)
) :
  LinearSurjective(K, V, W, f) {
  let C := CoordinateSpace(K, n);
  let u := linear_iso_forward(K, C, V, basisV);
  let inverseW := linear_iso_inverse(K, C, W, basisW);
  let v := linear_iso_forward(K, W, C, inverseW);
  let middle := linear_compose(K, C, V, W, u, f);
  let square := linear_compose(K, C, W, C, middle, v);
  have squareInjective : LinearInjective(K, C, C, square) {
    intro x, y, same;
    exact linear_iso_injective(
      K, C, V, basisV, x, y,
      injective(
        linear_map(K, C, V, u, x), linear_map(K, C, V, u, y),
        linear_iso_injective(
          K, W, C, inverseW, linear_map(K, V, W, f, linear_map(K, C, V, u, x)),
          linear_map(K, V, W, f, linear_map(K, C, V, u, y)), same
        )
      )
    );
  }
  let squareOnto := coordinate_square_injective_surjective(K, n, square, squareInjective);
  intro y;
  let c := linear_map(K, W, C, v, y);
  have lift :
    Fiber(vector_carrier(K, C), vector_carrier(K, C), linear_map(K, C, C, square), c)
    -> Fiber(vector_carrier(K, V), vector_carrier(K, W), linear_map(K, V, W, f), y) {
    intro witness;
    obtain (x, same) := witness;
    exact (
      linear_map(K, C, V, u, x),
      linear_iso_injective(
        K, W, C, inverseW, linear_map(K, V, W, f, linear_map(K, C, V, u, x)), y, same
      )
    );
  }
  exact mere_map(
    Fiber(vector_carrier(K, C), vector_carrier(K, C), linear_map(K, C, C, square), c),
    Fiber(vector_carrier(K, V), vector_carrier(K, W), linear_map(K, V, W, f), y), lift,
    squareOnto(c)
  );
}

def equal_dimension_injective_surjective(
  K : AlgebraicField, V, W : VectorSpace(K), n : Nat, dimensionV : HasDimension(K, V, n),
  dimensionW : HasDimension(K, W, n), f : LinearMap(K, V, W),
  injective : LinearInjective(K, V, W, f)
) :
  LinearSurjective(K, V, W, f) {
  let Goal := LinearSurjective(K, V, W, f);
  exact mere_eliminate(
    FiniteBasis(K, V, n), Goal, linear_surjective_prop(K, V, W, f),
    (
      fun (basisV : FiniteBasis(K, V, n)) => mere_eliminate(
        FiniteBasis(K, W, n), Goal, linear_surjective_prop(K, V, W, f),
        (
          fun (basisW : FiniteBasis(K, W, n)) => equal_basis_dimension_injective_surjective(
            K, V, W, n, basisV, basisW, f, injective
          )
        ), dimensionW
      )
    ), dimensionV
  );
}

def nonzero_nat_successor(n : Nat, nonzero : (n = 0) -> Void) : exists k : Nat. n = succ(k) {
  exact induction n as k return ((k = 0) -> Void) -> (exists j : Nat. k = succ(j)) {
    zero => fun (impossible : (0 = 0) -> Void) => absurd(impossible(refl(0)));
    succ previous => fun (impossible : (succ(k) = 0) -> Void) => (k, refl(succ(k)));
  }
  (nonzero);
}

def positive_product_zero(k, q : Nat, same : multiply_count(succ(k), q) = 0) : q = 0 {
  exact induction q as r return (multiply_count(succ(k), r) = 0) -> (r = 0) {
    zero => fun (equal : multiply_count(succ(k), 0) = 0) => refl(0);
    succ previous => fun (equal : multiply_count(succ(k), succ(r)) = 0) => absurd(
      nat_zero_ne_succ(
        add_count(k, multiply_count(succ(k), r)), trans(sym(equal), nat_mul_succ(succ(k), r))
      )
    );
  }
  (same);
}

def positive_product_unit(k, m : Nat, same : multiply_count(succ(k), m) = succ(k)) : m = 1 {
  exact induction m as q return (multiply_count(succ(k), q) = succ(k)) -> (q = 1) {
    zero => fun (equal : multiply_count(succ(k), 0) = succ(k)) => absurd(
      nat_zero_ne_succ(k, trans(sym(nat_mul_zero(succ(k))), equal))
    );
    succ previous => fun (equal : multiply_count(succ(k), succ(q)) = succ(k)) => cong(
      succ,
      positive_product_zero(
        k, q,
        nat_add_cancel(
          succ(k), multiply_count(succ(k), q), 0,
          trans(sym(nat_mul_succ(succ(k), q)), trans(equal, sym(nat_add_zero(succ(k)))))
        )
      )
    );
  }
  (same);
}

def inhabited_cardinality_positive(A : U0, n : Nat, count : HasCardinality(A, n), a : A) :
  exists k : Nat. n = succ(k) {
  have nonzero : (n = 0) -> Void {
    intro zero;
    let countZero := along HasCardinality(A) by zero from count;
    exact mere_eliminate(
      Bijection(Fin(0), A), Void, (fun (u, v : Void) => absurd(u)),
      (fun (e : Bijection(Fin(0), A)) => absurd(backward(Fin(0), A, e, a))), countZero
    );
  }
  exact nonzero_nat_successor(n, nonzero);
}

def degree_one_embedding_surjective(
  K, F : AlgebraicField, e : FieldEmbedding(K, F),
  finite : FiniteExtension(K, embedding_as_extension(K, F, e)),
  degreeOne : extension_degree(K, embedding_as_extension(K, F, e), finite) = 1
) :
  Surjective(af_carrier(K), af_carrier(F), field_embedding_map(K, F, e)) {
  let V := field_vector_space(K, F, e);
  let C := ScalarSpace(K);
  let h := field_embedding_linear(K, F, e);
  let dimensionF :=
    along HasDimension(K, V) by degreeOne from extension_degree_specification(
      K, embedding_as_extension(K, F, e), finite
    );
  exact equal_dimension_injective_surjective(
    K, C, V, 1, basis_has_dimension(K, C, 1, scalar_space_basis(K)), dimensionF, h,
    field_embedding_injective(K, F, e)
  );
}
