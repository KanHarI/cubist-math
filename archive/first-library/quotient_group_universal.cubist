import quotient_groups;
import group_quotient_maps;
import group_hom_universes;

// The codomain may be any group in U1, not only a repackaged small group.
// The subgroup and its ambient source group remain small.
def KillsSubgroupAt(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G)
) :=
  forall n : group_carrier(G). subgroup_members(G, S, n)
  -> group_hom_map_at(U1, group_lift(G), H, h, n) = group_unit_at(U1, H);

def group_hom_lift(G, H : Group, h : GroupHom(G, H)) : GroupHomAt(U1, group_lift(G), group_lift(H)) {
  exact with unfolding [group_lift] {
    group_hom_object_at(
      U1, group_carrier(G), group_unit(G), group_multiply(G), group_laws(G), group_carrier(H),
      group_unit(H), group_multiply(H), group_laws(H), group_hom_map(G, H, h),
      group_hom_multiply(G, H, h)
    )
  };
}

// Equal cosets have equal images: x * (x^-1 * y) = y, and the second
// factor maps to the identity. This avoids selecting coset representatives.
def killing_subgroup_respects_cosets_at(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  kills : KillsSubgroupAt(G, H, h, S)
) :
  RespectsRelation(
    group_carrier(G), SameLeftCoset(G, S), group_carrier_at(U1, H),
    group_hom_map_at(U1, group_lift(G), H, h)
  ) {
  intro x, y, same;
  let f := group_hom_map_at(U1, group_lift(G), H, h);
  let d := group_multiply(G, group_inverse(G, x), y);
  let m := group_multiply_at(U1, H);
  have cancel : group_multiply(G, x, d) = y := trans(
    sym(group_associative(G, x, group_inverse(G, x), y)),
    trans(
      cong((fun (z : group_carrier(G)) => group_multiply(G, z, y)), group_inverse_right(G, x)),
      group_unit_left(G, y)
    )
  );
  exact trans(
    sym(group_unit_right_at(U1, H, f(x))),
    trans(
      cong(m(f(x)), sym(kills(d, same))),
      trans(sym(group_hom_multiply_at(U1, group_lift(G), H, h, x, d)), cong(f, cancel))
    )
  );
}

def quotient_descend_map(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  kills : KillsSubgroupAt(G, H, h, S)
) :=
  quotient_rec(
    group_carrier(G), SameLeftCoset(G, S), same_coset_equivalence(G, S), group_carrier_at(U1, H),
    group_is_set_at(U1, H), group_hom_map_at(U1, group_lift(G), H, h),
    killing_subgroup_respects_cosets_at(G, H, h, S, kills)
  );

def quotient_descend_beta(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  kills : KillsSubgroupAt(G, H, h, S), x : group_carrier(G)
) :
  quotient_descend_map(G, H, h, S, kills, left_coset(G, S, x)) = group_hom_map_at(
    U1, group_lift(G), H, h, x
  ) {
  exact with unfolding [quotient_descend_map, left_coset] {
    quotient_rec_beta(
      group_carrier(G), SameLeftCoset(G, S), same_coset_equivalence(G, S), group_carrier_at(U1, H),
      group_is_set_at(U1, H), group_hom_map_at(U1, group_lift(G), H, h),
      killing_subgroup_respects_cosets_at(G, H, h, S, kills), x
    )
  };
}

def quotient_descend_multiply_classes(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  normal : IsNormal(G, S), kills : KillsSubgroupAt(G, H, h, S), x, y : group_carrier(G)
) :
  quotient_descend_map(
    G, H, h, S, kills, quotient_multiply(G, S, normal, left_coset(G, S, x), left_coset(G, S, y))
  ) = group_multiply_at(
    U1, H, quotient_descend_map(G, H, h, S, kills, left_coset(G, S, x)),
    quotient_descend_map(G, H, h, S, kills, left_coset(G, S, y))
  ) {
  let out := quotient_descend_map(G, H, h, S, kills);
  let f := group_hom_map_at(U1, group_lift(G), H, h);
  let m := group_multiply_at(U1, H);
  exact trans(
    cong(out, quotient_multiply_beta(G, S, normal, x, y)),
    trans(
      quotient_descend_beta(G, H, h, S, kills, group_multiply(G, x, y)),
      trans(
        group_hom_multiply_at(U1, group_lift(G), H, h, x, y),
        trans(
          cong(
            (fun (z : group_carrier_at(U1, H)) => m(z, f(y))),
            sym(quotient_descend_beta(G, H, h, S, kills, x))
          ), cong(m(out(left_coset(G, S, x))), sym(quotient_descend_beta(G, H, h, S, kills, y)))
        )
      )
    )
  );
}

def quotient_descend_multiply(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  normal : IsNormal(G, S), kills : KillsSubgroupAt(G, H, h, S), q, r : LeftCosets(G, S)
) :
  quotient_descend_map(G, H, h, S, kills, quotient_multiply(G, S, normal, q, r)) = group_multiply_at(
    U1, H, quotient_descend_map(G, H, h, S, kills, q), quotient_descend_map(G, H, h, S, kills, r)
  ) {
  let Q := LeftCosets(G, S);
  let out := quotient_descend_map(G, H, h, S, kills);
  let m := quotient_multiply(G, S, normal);
  let product := group_multiply_at(U1, H);
  exact with unfolding [left_coset] {
    quotient_induction_prop2(
      group_carrier(G), SameLeftCoset(G, S),
      (fun (q, r : Q) => out(m(q, r)) = product(out(q), out(r))),
      (fun (q, r : Q) => group_is_set_at(U1, H, out(m(q, r)), product(out(q), out(r)))),
      quotient_descend_multiply_classes(G, H, h, S, normal, kills), q, r
    )
  };
}

// The projection is a homomorphism to the actual quotient group in U1.
def quotient_projection(G : Group, S : Subgroup(G), normal : IsNormal(G, S)) :
  GroupHomAt(U1, group_lift(G), QuotientGroup(G, S, normal)) {
  exact with unfolding [group_lift, QuotientGroup] {
    group_hom_object_at(
      U1, group_carrier(G), group_unit(G), group_multiply(G), group_laws(G), LeftCosets(G, S),
      left_coset(G, S, group_unit(G)), quotient_multiply(G, S, normal),
      quotient_group_laws(G, S, normal), left_coset(G, S),
      (fun (x, y : group_carrier(G)) => sym(quotient_multiply_beta(G, S, normal, x, y)))
    )
  };
}

def quotient_descend_hom(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  normal : IsNormal(G, S), kills : KillsSubgroupAt(G, H, h, S)
) :
  GroupHomAt(U1, QuotientGroup(G, S, normal), H) {
  exact (
    quotient_descend_map(G, H, h, S, kills), quotient_descend_multiply(G, H, h, S, normal, kills)
  );
}

// The commuting triangle is an equality of bundled homomorphisms.
def quotient_descend_triangle(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  normal : IsNormal(G, S), kills : KillsSubgroupAt(G, H, h, S)
) :
  group_hom_compose_at(
    U1, group_lift(G), QuotientGroup(G, S, normal), H, quotient_projection(G, S, normal),
    quotient_descend_hom(G, H, h, S, normal, kills)
  ) = h {
  exact group_hom_ext_at(
    U1, group_lift(G), H,
    group_hom_compose_at(
      U1, group_lift(G), QuotientGroup(G, S, normal), H, quotient_projection(G, S, normal),
      quotient_descend_hom(G, H, h, S, normal, kills)
    ), h, quotient_descend_beta(G, H, h, S, kills)
  );
}

// Any other homomorphism whose composite with the projection is h equals
// the descended homomorphism, including its multiplication-law evidence.
def quotient_descend_unique(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  normal : IsNormal(G, S), kills : KillsSubgroupAt(G, H, h, S),
  k : GroupHomAt(U1, QuotientGroup(G, S, normal), H),
  triangle : group_hom_compose_at(
    U1, group_lift(G), QuotientGroup(G, S, normal), H, quotient_projection(G, S, normal), k
  ) = h
) :
  k = quotient_descend_hom(G, H, h, S, normal, kills) {
  let out := group_hom_map_at(U1, QuotientGroup(G, S, normal), H, k);
  let same :=
    fun (x : group_carrier(G)) => cong(
      (fun (m : GroupHomAt(U1, group_lift(G), H)) => group_hom_map_at(U1, group_lift(G), H, m, x)),
      triangle
    );
  let maps :=
    quotient_rec_unique(
      group_carrier(G), SameLeftCoset(G, S), same_coset_equivalence(G, S), group_carrier_at(U1, H),
      group_is_set_at(U1, H), group_hom_map_at(U1, group_lift(G), H, h),
      killing_subgroup_respects_cosets_at(G, H, h, S, kills), out, same
    );
  exact group_hom_ext_at(
    U1, QuotientGroup(G, S, normal), H, k, quotient_descend_hom(G, H, h, S, normal, kills),
    (
      fun (q : LeftCosets(G, S)) => cong(
        (fun (f : LeftCosets(G, S) -> group_carrier_at(U1, H)) => f(q)), maps
      )
    )
  );
}

// Every homomorphism killing the normal subgroup has a unique factorization.
// Both the factor and its uniqueness live in the homomorphism type.
def quotient_group_universal(
  G : Group, H : GroupAt(U1), h : GroupHomAt(U1, group_lift(G), H), S : Subgroup(G),
  normal : IsNormal(G, S), kills : KillsSubgroupAt(G, H, h, S)
) :
  exists factor : GroupHomAt(U1, QuotientGroup(G, S, normal), H).
  (
    group_hom_compose_at(
      U1, group_lift(G), QuotientGroup(G, S, normal), H, quotient_projection(G, S, normal), factor
    ) = h
  )
  and (
    forall other : GroupHomAt(U1, QuotientGroup(G, S, normal), H).
    group_hom_compose_at(
      U1, group_lift(G), QuotientGroup(G, S, normal), H, quotient_projection(G, S, normal), other
    ) = h -> other = factor
  ) {
  exact (
    quotient_descend_hom(G, H, h, S, normal, kills),
    quotient_descend_triangle(G, H, h, S, normal, kills),
    quotient_descend_unique(G, H, h, S, normal, kills)
  );
}

// On small targets this recovers the earlier unique map of sets.
def quotient_descend_agrees_with_map(
  G, H : Group, h : GroupHom(G, H), S : Subgroup(G), kills : KillsSubgroup(G, H, h, S)
) :
  quotient_descend_map(G, group_lift(H), group_hom_lift(G, H, h), S, kills) = group_quotient_map(
    G, H, h, S, kills
  ) {
  exact group_quotient_map_unique(
    G, H, h, S, kills, quotient_descend_map(G, group_lift(H), group_hom_lift(G, H, h), S, kills),
    quotient_descend_beta(G, group_lift(H), group_hom_lift(G, H, h), S, kills)
  );
}

// Every subgroup element becomes the identity under the quotient projection.
def quotient_projection_kills(G : Group, S : Subgroup(G), normal : IsNormal(G, S)) :
  KillsSubgroupAt(G, QuotientGroup(G, S, normal), quotient_projection(G, S, normal), S) {
  intro n, member;
  exact sym(
    same_coset_path(
      G, S, group_unit(G), n,
      same_coset_from_factor(G, S, group_unit(G), n, n, member, group_unit_left(G, n))
    )
  );
}

// Projection is an epimorphism: equality after precomposition detects
// equality of maps out of the quotient, including their law fields.
def quotient_projection_epimorphism(
  G : Group, H : GroupAt(U1), S : Subgroup(G), normal : IsNormal(G, S),
  f, g : GroupHomAt(U1, QuotientGroup(G, S, normal), H),
  same : group_hom_compose_at(
    U1, group_lift(G), QuotientGroup(G, S, normal), H, quotient_projection(G, S, normal), f
  ) = group_hom_compose_at(
    U1, group_lift(G), QuotientGroup(G, S, normal), H, quotient_projection(G, S, normal), g
  )
) :
  f = g {
  let fMap := group_hom_map_at(U1, QuotientGroup(G, S, normal), H, f);
  let gMap := group_hom_map_at(U1, QuotientGroup(G, S, normal), H, g);
  let onClasses :=
    fun (x : group_carrier(G)) => cong(
      (fun (h : GroupHomAt(U1, group_lift(G), H)) => group_hom_map_at(U1, group_lift(G), H, h, x)),
      same
    );
  let maps :=
    quotient_maps_ext(
      group_carrier(G), SameLeftCoset(G, S), group_carrier_at(U1, H), group_is_set_at(U1, H), fMap,
      gMap, onClasses
    );
  exact group_hom_ext_at(
    U1, QuotientGroup(G, S, normal), H, f, g,
    (
      fun (q : LeftCosets(G, S)) => cong(
        (fun (m : LeftCosets(G, S) -> group_carrier_at(U1, H)) => m(q)), maps
      )
    )
  );
}
