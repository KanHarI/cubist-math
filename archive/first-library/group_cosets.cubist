import normal_subgroups;
import set_quotients;

// x and y belong to the same left coset xS exactly when x⁻¹y belongs to S.
// This is a small proposition even though the predicate-based quotient is in U1.
def SameLeftCoset(G : Group, S : Subgroup(G), x, y : group_carrier(G)) :=
  subgroup_members(G, S, group_multiply(G, group_inverse(G, x), y));

def coset_factor(G : Group, x, y : group_carrier(G)) :
  group_multiply(G, x, group_multiply(G, group_inverse(G, x), y)) = y {
  let m := group_multiply(G);
  exact trans(
    sym(group_associative(G, x, group_inverse(G, x), y)),
    trans(
      cong((fun (a : group_carrier(G)) => m(a, y)), group_inverse_right(G, x)),
      group_unit_left(G, y)
    )
  );
}

// A specified factor proves membership; no representative is selected from a truncation.
def same_coset_from_factor(
  G : Group, S : Subgroup(G), x, y, n : group_carrier(G), member : subgroup_members(G, S, n),
  factor : group_multiply(G, x, n) = y
) :
  SameLeftCoset(G, S, x, y) {
  exact along subgroup_members(G, S) by trans(
    sym(group_cancel_left_value(G, x, n)), cong(group_multiply(G, group_inverse(G, x)), factor)
  ) from member;
}

def same_coset_refl(G : Group, S : Subgroup(G), x : group_carrier(G)) : SameLeftCoset(G, S, x, x) {
  exact same_coset_from_factor(
    G, S, x, x, group_unit(G), subgroup_unit(G, subgroup_members(G, S), subgroup_laws(G, S)),
    group_unit_right(G, x)
  );
}

def same_coset_sym(
  G : Group, S : Subgroup(G), x, y : group_carrier(G), same : SameLeftCoset(G, S, x, y)
) :
  SameLeftCoset(G, S, y, x) {
  let m := group_multiply(G);
  let n := m(group_inverse(G, x), y);
  exact same_coset_from_factor(
    G, S, y, x, group_inverse(G, n),
    subgroup_inverse(
      G, subgroup_members(G, S), subgroup_laws(G, S), n, group_inverse(G, n), same,
      group_inverse_left(G, n)
    ),
    trans(
      cong((fun (a : group_carrier(G)) => m(a, group_inverse(G, n))), sym(coset_factor(G, x, y))),
      group_cancel_right_value(G, x, n)
    )
  );
}

def same_coset_trans(
  G : Group, S : Subgroup(G), x, y, z : group_carrier(G), xy : SameLeftCoset(G, S, x, y),
  yz : SameLeftCoset(G, S, y, z)
) :
  SameLeftCoset(G, S, x, z) {
  let m := group_multiply(G);
  let n := m(group_inverse(G, x), y);
  let p := m(group_inverse(G, y), z);
  exact same_coset_from_factor(
    G, S, x, z, m(n, p),
    subgroup_multiply(G, subgroup_members(G, S), subgroup_laws(G, S), n, p, xy, yz),
    trans(
      sym(group_associative(G, x, n, p)),
      trans(
        cong((fun (a : group_carrier(G)) => m(a, p)), coset_factor(G, x, y)), coset_factor(G, y, z)
      )
    )
  );
}

def same_coset_equivalence(G : Group, S : Subgroup(G)) :
  EquivalenceRelation(group_carrier(G), SameLeftCoset(G, S)) {
  exact (
    (
      fun (x, y : group_carrier(G)) => subgroup_prop(
        G, subgroup_members(G, S), subgroup_laws(G, S), group_multiply(G, group_inverse(G, x), y)
      )
    ), same_coset_refl(G, S), same_coset_sym(G, S), same_coset_trans(G, S)
  );
}

// Left multiplication preserves left cosets for every subgroup.
def same_coset_multiply_left(
  G : Group, S : Subgroup(G), a, x, y : group_carrier(G), same : SameLeftCoset(G, S, x, y)
) :
  SameLeftCoset(G, S, group_multiply(G, a, x), group_multiply(G, a, y)) {
  let n := group_multiply(G, group_inverse(G, x), y);
  exact same_coset_from_factor(
    G, S, group_multiply(G, a, x), group_multiply(G, a, y), n, same,
    trans(group_associative(G, a, x, n), cong(group_multiply(G, a), coset_factor(G, x, y)))
  );
}

def group_conjugate_shift(G : Group, a, n : group_carrier(G)) :
  group_multiply(G, a, group_conjugate(G, group_inverse(G, a), n)) = group_multiply(G, n, a) {
  let m := group_multiply(G);
  let i := group_inverse(G, a);
  exact trans(
    cong(m(a), cong(m(m(i, n)), group_inverse_involutive(G, a))),
    trans(
      sym(group_associative(G, a, m(i, n), a)),
      cong((fun (z : group_carrier(G)) => m(z, a)), coset_factor(G, a, n))
    )
  );
}

// Right multiplication is the step that needs normality.
def same_coset_multiply_right(
  G : Group, S : Subgroup(G), normal : IsNormal(G, S), x, y, a : group_carrier(G),
  same : SameLeftCoset(G, S, x, y)
) :
  SameLeftCoset(G, S, group_multiply(G, x, a), group_multiply(G, y, a)) {
  let m := group_multiply(G);
  let n := m(group_inverse(G, x), y);
  let conjugated := group_conjugate(G, group_inverse(G, a), n);
  exact same_coset_from_factor(
    G, S, m(x, a), m(y, a), conjugated, normal(group_inverse(G, a), n, same),
    trans(
      group_associative(G, x, a, conjugated),
      trans(
        cong(m(x), group_conjugate_shift(G, a, n)),
        trans(
          sym(group_associative(G, x, n, a)),
          cong((fun (z : group_carrier(G)) => m(z, a)), coset_factor(G, x, y))
        )
      )
    )
  );
}

def normal_coset_multiply(
  G : Group, S : Subgroup(G), normal : IsNormal(G, S), x, x2, y, y2 : group_carrier(G),
  xx : SameLeftCoset(G, S, x, x2), yy : SameLeftCoset(G, S, y, y2)
) :
  SameLeftCoset(G, S, group_multiply(G, x, y), group_multiply(G, x2, y2)) {
  exact same_coset_trans(
    G, S, group_multiply(G, x, y), group_multiply(G, x2, y), group_multiply(G, x2, y2),
    same_coset_multiply_right(G, S, normal, x, x2, y, xx),
    same_coset_multiply_left(G, S, x2, y, y2, yy)
  );
}

def same_coset_unit_member(
  G : Group, S : Subgroup(G), x : group_carrier(G), same : SameLeftCoset(G, S, group_unit(G), x)
) :
  subgroup_members(G, S, x) {
  let n := group_multiply(G, group_inverse(G, group_unit(G)), x);
  exact along subgroup_members(G, S) by trans(
    sym(group_unit_left(G, n)), coset_factor(G, group_unit(G), x)
  ) from same;
}

// Normality is necessary too: right translation takes gS = gnS to S = gng⁻¹S.
def right_coset_compatibility_implies_normal(
  G : Group, S : Subgroup(G),
  compatible : (
    forall x : group_carrier(G). forall y : group_carrier(G). forall a : group_carrier(G).
    SameLeftCoset(G, S, x, y)
    -> SameLeftCoset(G, S, group_multiply(G, x, a), group_multiply(G, y, a))
  )
) :
  IsNormal(G, S) {
  intro g, n, member;
  let m := group_multiply(G);
  let related := same_coset_from_factor(G, S, g, m(g, n), n, member, refl(m(g, n)));
  let shifted := compatible(g, m(g, n), group_inverse(G, g), related);
  exact same_coset_unit_member(
    G, S, group_conjugate(G, g, n),
    along((fun (a : group_carrier(G)) => SameLeftCoset(G, S, a, group_conjugate(G, g, n)))) by group_inverse_right(
      G, g
    ) from shifted
  );
}

def normal_coset_inverse(
  G : Group, S : Subgroup(G), normal : IsNormal(G, S), x, y : group_carrier(G),
  same : SameLeftCoset(G, S, x, y)
) :
  SameLeftCoset(G, S, group_inverse(G, x), group_inverse(G, y)) {
  let m := group_multiply(G);
  let ix := group_inverse(G, x);
  let iy := group_inverse(G, y);
  let shifted :=
    same_coset_multiply_left(
      G, S, ix, m(x, iy), m(y, iy), same_coset_multiply_right(G, S, normal, x, y, iy, same)
    );
  let first :=
    along((fun (a : group_carrier(G)) => SameLeftCoset(G, S, a, m(ix, m(y, iy))))) by group_cancel_left_value(
      G, x, iy
    ) from shifted;
  let second :=
    along SameLeftCoset(G, S, iy) by trans(
      cong(m(ix), group_inverse_right(G, y)), group_unit_right(G, ix)
    ) from first;
  exact same_coset_sym(G, S, iy, ix, second);
}

// Kernel cosets are exactly the fibers of the homomorphism. This is the
// relation-level part of the first isomorphism theorem, before quotient descent.
def group_hom_difference(G, H : Group, h : GroupHom(G, H), x, y : group_carrier(G)) :
  group_hom_map(G, H, h, group_multiply(G, group_inverse(G, x), y)) = group_multiply(
    H, group_inverse(H, group_hom_map(G, H, h, x)), group_hom_map(G, H, h, y)
  ) {
  let f := group_hom_map(G, H, h);
  exact trans(
    group_hom_multiply(G, H, h, group_inverse(G, x), y),
    cong((fun (a : group_carrier(H)) => group_multiply(H, a, f(y))), group_hom_inverse(G, H, h, x))
  );
}

def kernel_coset_of_equal_images(
  G, H : Group, h : GroupHom(G, H), x, y : group_carrier(G),
  same : group_hom_map(G, H, h, x) = group_hom_map(G, H, h, y)
) :
  SameLeftCoset(G, group_kernel(G, H, h), x, y) {
  let f := group_hom_map(G, H, h);
  exact trans(
    group_hom_difference(G, H, h, x, y),
    trans(cong(group_multiply(H, group_inverse(H, f(x))), sym(same)), group_inverse_left(H, f(x)))
  );
}

def kernel_coset_equal_images(
  G, H : Group, h : GroupHom(G, H), x, y : group_carrier(G),
  same : SameLeftCoset(G, group_kernel(G, H, h), x, y)
) :
  group_hom_map(G, H, h, x) = group_hom_map(G, H, h, y) {
  let f := group_hom_map(G, H, h);
  let equalUnit :=
    trans(
      sym(group_hom_difference(G, H, h, x, y)),
      typed((f(group_multiply(G, group_inverse(G, x), y)) = group_unit(H)), same)
    );
  exact group_cancel_left(
    H, group_inverse(H, f(x)), f(x), f(y), trans(group_inverse_left(H, f(x)), sym(equalUnit))
  );
}

// The existing quotient is a U1 type. This definition asserts no resizing into U0.
def LeftCosets(G : Group, S : Subgroup(G)) := SetQuotient(group_carrier(G), SameLeftCoset(G, S));

def left_coset(G : Group, S : Subgroup(G), x : group_carrier(G)) :=
  quotient_class(group_carrier(G), SameLeftCoset(G, S), x);

def same_coset_path(
  G : Group, S : Subgroup(G), x, y : group_carrier(G), same : SameLeftCoset(G, S, x, y)
) :
  left_coset(G, S, x) = left_coset(G, S, y) {
  exact related_classes_equal(
    group_carrier(G), SameLeftCoset(G, S), same_coset_equivalence(G, S), x, y, same
  );
}

def coset_path_membership(
  G : Group, S : Subgroup(G), x, y : group_carrier(G),
  same : left_coset(G, S, x) = left_coset(G, S, y)
) :
  SameLeftCoset(G, S, x, y) {
  exact equal_classes_related(
    group_carrier(G), SameLeftCoset(G, S), same_coset_equivalence(G, S), x, y, same
  );
}

def normal_coset_product_path(
  G : Group, S : Subgroup(G), normal : IsNormal(G, S), x, x2, y, y2 : group_carrier(G),
  xx : left_coset(G, S, x) = left_coset(G, S, x2), yy : left_coset(G, S, y) = left_coset(G, S, y2)
) :
  left_coset(G, S, group_multiply(G, x, y)) = left_coset(G, S, group_multiply(G, x2, y2)) {
  exact same_coset_path(
    G, S, group_multiply(G, x, y), group_multiply(G, x2, y2),
    normal_coset_multiply(
      G, S, normal, x, x2, y, y2, coset_path_membership(G, S, x, x2, xx),
      coset_path_membership(G, S, y, y2, yy)
    )
  );
}
