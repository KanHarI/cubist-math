import normal_subgroups;
import f4_galois_group;

def cyclic_two_abelian : IsAbelian(CyclicTwo) {
  exact f2_add_comm;
}

// Equality of groups transports the group property itself. No repeated
// case analysis of F4 automorphisms is needed to prove commutativity here.
def f4_galois_abelian : IsAbelian(F4GaloisGroup) {
  exact along IsAbelian by f4_galois_group_equality from cyclic_two_abelian;
}

// All subgroups are normal, without assuming their membership decidable.
// This does not remove the separate decision hypotheses of the constructive
// F4 fixed-field correspondence, nor prove the general normality criterion.
def f4_galois_subgroups_normal(S : Subgroup(F4GaloisGroup)) : IsNormal(F4GaloisGroup, S) {
  exact abelian_subgroups_normal(F4GaloisGroup, f4_galois_abelian, S);
}

// The kernel of the identity homomorphism is exactly the identity subgroup.
def f4_identity_kernel :
  group_kernel(F4GaloisGroup, F4GaloisGroup, group_hom_identity(F4GaloisGroup)) =[
    Subgroup(F4GaloisGroup)
  ] subgroup_bottom(F4GaloisGroup) {
  exact group_kernel_identity(F4GaloisGroup);
}
