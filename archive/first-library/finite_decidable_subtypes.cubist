import unat;
import equivalence_from_inverse;
import finite_cardinalities;
import classical;
use unat;

// Decidable subtypes of Unit or A, by Boolean predicates: this module's
// vocabulary, moved here unchanged from the archive's binomial_types when
// the library replaced the binomial types (library/binomial_types.cubist)
// on 2026-11-02. A decidable predicate is represented by a Boolean-valued
// function.
def Bool := Unit or Unit;

def yes := typed(Bool, left(tt));

def no := typed(Bool, right(tt));

def Truth(b : Bool) := match b return U0 {
    left u => Unit;
    right u => Void;
  };

def Selected(A : U0, p : A -> Bool) := exists a : A. Truth(p(a));

def truth_prop(b : Bool) := match b as c return Proposition(Truth(c)) {
    left u => fun (x, y : Unit) => trans(sym(unit_equal(x)), unit_equal(y));
    right u => fun (x, y : Void) => typed((x = y), absurd(x));
  };

def subtype_map(A : U0, P, Q : A -> U0, f : (forall x : A. P(x) -> Q(x)), u : (exists x : A. P(x))) :=
  typed(
    (exists x : A. Q(x)), (sigma_first(A, P, u), f(sigma_first(A, P, u), sigma_second(A, P, u)))
  );

def subtype_bijection(
  A : U0, P, Q : A -> U0, propP : (forall x : A. Proposition(P(x))),
  propQ : (forall x : A. Proposition(Q(x))), f : (forall x : A. P(x) -> Q(x)),
  g : (forall x : A. Q(x) -> P(x))
) :
  Bijection((exists x : A. P(x)), (exists x : A. Q(x))) {
  exact (
    subtype_map(A, P, Q, f), subtype_map(A, Q, P, g),
    (
      fun (u : (exists x : A. P(x))) => subtype_ext(
        A, P, propP, subtype_map(A, Q, P, g, subtype_map(A, P, Q, f, u)), u,
        refl(sigma_first(A, P, u))
      )
    ),
    (
      fun (v : (exists x : A. Q(x))) => subtype_ext(
        A, Q, propQ, subtype_map(A, P, Q, f, subtype_map(A, Q, P, g, v)), v,
        refl(sigma_first(A, Q, v))
      )
    )
  );
}

def predicate_join(A : U0, b : Bool, p : A -> Bool) :=
  function_join(A, Bool, typed(Bool and (A -> Bool), (b, p)));

def predicate_tail(A : U0, p : (Unit or A) -> Bool, a : A) := p(tail(A, a));

def predicate_normal(A : U0, p : (Unit or A) -> Bool) :=
  predicate_join(A, p(head(A)), predicate_tail(A, p));

def predicate_eta(A : U0, p : (Unit or A) -> Bool) : predicate_normal(A, p) = p {
  ext x;
  exact function_join_split_point(A, Bool, p)(x);
}

def type_path_bijection(A, B : U0, path_ : A = B) := path_induction(
  U0, (fun (X, Y : U0, q : X = Y) => Bijection(X, Y)), (fun (X : U0) => identity_bijection(X)), A,
  B, path_
);

def selected_normalize(A : U0, p : (Unit or A) -> Bool) := type_path_bijection(
  Selected(Unit or A, p), Selected(Unit or A, predicate_normal(A, p)),
  sym(cong(Selected(Unit or A), predicate_eta(A, p)))
);

// Selecting the new first alternative adds Unit to the selected subtype;
// omitting it leaves exactly the old selected subtype.
def selected_index(A : U0, p : A -> Bool, s : Selected(A, p)) :=
  sigma_first(A, (fun (a : A) => Truth(p(a))), s);

def selected_witness(A : U0, p : A -> Bool, s : Selected(A, p)) :=
  sigma_second(A, (fun (a : A) => Truth(p(a))), s);

def selected_true_out_at(A : U0, p : A -> Bool, x : Unit or A) :=
  match x as z return (Truth(predicate_join(A, yes, p, z)) -> (Unit or Selected(A, p))) {
    left u => fun (h : Unit) => typed(Unit or Selected(A, p), left(u));
    right a => fun (h : Truth(p(a))) => typed(
      Unit or Selected(A, p), right(typed(Selected(A, p), (a, h)))
    );
  };

def selected_true_out(A : U0, p : A -> Bool, s : Selected(Unit or A, predicate_join(A, yes, p))) :=
  selected_true_out_at(
    A, p, selected_index(Unit or A, predicate_join(A, yes, p), s),
    selected_witness(Unit or A, predicate_join(A, yes, p), s)
  );

def selected_true_in(A : U0, p : A -> Bool, x : Unit or Selected(A, p)) :=
  match x return Selected(Unit or A, predicate_join(A, yes, p)) {
    left u => (typed(Unit or A, left(u)), tt);
    right s => (tail(A, selected_index(A, p, s)), selected_witness(A, p, s));
  };

def selected_true_index_path(A : U0, p : A -> Bool, x : Unit or A) :=
  match x as z return (
    forall h : Truth(predicate_join(A, yes, p, z)).
    selected_index(
      Unit or A, predicate_join(A, yes, p), selected_true_in(A, p, selected_true_out_at(A, p, z, h))
    ) = z
  ) {
    left u => fun (h : Unit) => refl(typed(Unit or A, left(u)));
    right a => fun (h : Truth(p(a))) => refl(tail(A, a));
  };

def selected_true_left(A : U0, p : A -> Bool, s : Selected(Unit or A, predicate_join(A, yes, p))) :
  selected_true_in(A, p, selected_true_out(A, p, s)) = s {
  exact subtype_ext(
    Unit or A, (fun (x : Unit or A) => Truth(predicate_join(A, yes, p, x))),
    (fun (x : Unit or A) => truth_prop(predicate_join(A, yes, p, x))),
    selected_true_in(A, p, selected_true_out(A, p, s)), s,
    selected_true_index_path(
      A, p, selected_index(Unit or A, predicate_join(A, yes, p), s),
      selected_witness(Unit or A, predicate_join(A, yes, p), s)
    )
  );
}

def selected_true_right(A : U0, p : A -> Bool, x : Unit or Selected(A, p)) :=
  match x as z return (selected_true_out(A, p, selected_true_in(A, p, z)) = z) {
    left u => refl(typed(Unit or Selected(A, p), left(u)));
    right s => cong(
      (fun (v : Selected(A, p)) => typed(Unit or Selected(A, p), right(v))),
      sigma_eta(A, (fun (a : A) => Truth(p(a))), s)
    );
  };

def selected_true(A : U0, p : A -> Bool) :
  Bijection(Selected(Unit or A, predicate_join(A, yes, p)), Unit or Selected(A, p)) {
  exact (
    selected_true_out(A, p), selected_true_in(A, p), selected_true_left(A, p),
    selected_true_right(A, p)
  );
}

def selected_false_out_at(A : U0, p : A -> Bool, x : Unit or A) :=
  match x as z return (Truth(predicate_join(A, no, p, z)) -> Selected(A, p)) {
    left u => fun (h : Void) => typed(Selected(A, p), absurd(h));
    right a => fun (h : Truth(p(a))) => typed(Selected(A, p), (a, h));
  };

def selected_false_out(A : U0, p : A -> Bool, s : Selected(Unit or A, predicate_join(A, no, p))) :=
  selected_false_out_at(
    A, p, selected_index(Unit or A, predicate_join(A, no, p), s),
    selected_witness(Unit or A, predicate_join(A, no, p), s)
  );

def selected_false_in(A : U0, p : A -> Bool, s : Selected(A, p)) := typed(
  Selected(Unit or A, predicate_join(A, no, p)),
  (tail(A, selected_index(A, p, s)), selected_witness(A, p, s))
);

def selected_false_index_path(A : U0, p : A -> Bool, x : Unit or A) :=
  match x as z return (
    forall h : Truth(predicate_join(A, no, p, z)).
    selected_index(
      Unit or A, predicate_join(A, no, p),
      selected_false_in(A, p, selected_false_out_at(A, p, z, h))
    ) = z
  ) {
    left u => fun (h : Void) => typed(
      (
        selected_index(
          Unit or A, predicate_join(A, no, p),
          selected_false_in(A, p, selected_false_out_at(A, p, typed(Unit or A, left(u)), h))
        ) = typed(Unit or A, left(u))
      ), absurd(h)
    );
    right a => fun (h : Truth(p(a))) => refl(tail(A, a));
  };

def selected_false_left(A : U0, p : A -> Bool, s : Selected(Unit or A, predicate_join(A, no, p))) :
  selected_false_in(A, p, selected_false_out(A, p, s)) = s {
  exact subtype_ext(
    Unit or A, (fun (x : Unit or A) => Truth(predicate_join(A, no, p, x))),
    (fun (x : Unit or A) => truth_prop(predicate_join(A, no, p, x))),
    selected_false_in(A, p, selected_false_out(A, p, s)), s,
    selected_false_index_path(
      A, p, selected_index(Unit or A, predicate_join(A, no, p), s),
      selected_witness(Unit or A, predicate_join(A, no, p), s)
    )
  );
}

def selected_false_right(A : U0, p : A -> Bool, s : Selected(A, p)) :=
  sigma_eta(A, (fun (a : A) => Truth(p(a))), s);

def selected_false(A : U0, p : A -> Bool) :
  Bijection(Selected(Unit or A, predicate_join(A, no, p)), Selected(A, p)) {
  exact (
    selected_false_out(A, p), selected_false_in(A, p), selected_false_left(A, p),
    selected_false_right(A, p)
  );
}

def HasFiniteCardinality(A : U0) := exists n : UNat. HasCardinality(A, n);

def finite_cardinality_prop(A : U0) : Proposition(HasFiniteCardinality(A)) {
  intro first, second;
  obtain (n, countN) := first;
  obtain (m, countM) := second;
  exact subtype_ext(
    UNat, HasCardinality(A), has_cardinality_prop(A), first, second,
    cardinality_unique(A, n, m, countN, countM)
  );
}

def finite_cardinality_bijection(A, B : U0, e : Bijection(A, B), finite : HasFiniteCardinality(A)) :
  HasFiniteCardinality(B) {
  obtain (n, count) := finite;
  exact (
    n,
    mere_map(
      Bijection(Fin(n), A), Bijection(Fin(n), B),
      (fun (enumeration : Bijection(Fin(n), A)) => compose_bijection(Fin(n), A, B, enumeration, e)),
      count
    )
  );
}

def finite_selected_true(
  k : UNat, q : Fin(k) -> Bool, m : UNat, count : HasCardinality(Selected(Fin(k), q), m)
) :
  HasCardinality(Selected(Fin(succ(k)), predicate_join(Fin(k), yes, q)), succ(m)) {
  let A := Fin(k);
  let S := Selected(A, q);
  let W := Selected(Fin(succ(k)), predicate_join(A, yes, q));
  exact mere_map(
    Bijection(Fin(m), S), Bijection(Fin(succ(m)), W),
    (
      fun (e : Bijection(Fin(m), S)) => compose_bijection(
        Fin(succ(m)), Unit or S, W,
        sum_bijection(Unit, Fin(m), Unit, S, identity_bijection(Unit), e),
        reverse_bijection(W, Unit or S, selected_true(A, q))
      )
    ), count
  );
}

def finite_selected_false(
  k : UNat, q : Fin(k) -> Bool, m : UNat, count : HasCardinality(Selected(Fin(k), q), m)
) :
  HasCardinality(Selected(Fin(succ(k)), predicate_join(Fin(k), no, q)), m) {
  let A := Fin(k);
  let S := Selected(A, q);
  let W := Selected(Fin(succ(k)), predicate_join(A, no, q));
  exact mere_map(
    Bijection(Fin(m), S), Bijection(Fin(m), W),
    (
      fun (e : Bijection(Fin(m), S)) => compose_bijection(
        Fin(m), S, W, e, reverse_bijection(W, S, selected_false(A, q))
      )
    ), count
  );
}

def finite_selected_bool_step(
  k : UNat, previous : forall p : Fin(k) -> Bool. HasFiniteCardinality(Selected(Fin(k), p)),
  p : Fin(succ(k)) -> Bool
) :
  HasFiniteCardinality(Selected(Fin(succ(k)), p)) {
  let A := Fin(k);
  let q := predicate_tail(A, p);
  let W := Selected(Fin(succ(k)), p);
  let norm := selected_normalize(A, p);
  obtain (m, count) := previous(q);
  let normalized :=
    match p(head(A)) as first return HasFiniteCardinality(
      Selected(Fin(succ(k)), predicate_join(A, first, q))
    ) {
      left u => (
        transport typed(
          HasFiniteCardinality(Selected(Fin(succ(k)), predicate_join(A, yes, q))),
          (succ(m), finite_selected_true(k, q, m, count))
        ) along cong((fun (v : Unit) => typed(Bool, left(v))), unit_equal(u)) in (
          (fun (b : Bool) => HasFiniteCardinality(Selected(Fin(succ(k)), predicate_join(A, b, q))))
        )
      );
      right u => (
        transport typed(
          HasFiniteCardinality(Selected(Fin(succ(k)), predicate_join(A, no, q))),
          (m, finite_selected_false(k, q, m, count))
        ) along cong((fun (v : Unit) => typed(Bool, right(v))), unit_equal(u)) in (
          (fun (b : Bool) => HasFiniteCardinality(Selected(Fin(succ(k)), predicate_join(A, b, q))))
        )
      );
    };
  exact finite_cardinality_bijection(
    Selected(Fin(succ(k)), predicate_normal(A, p)), W,
    reverse_bijection(W, Selected(Fin(succ(k)), predicate_normal(A, p)), norm), normalized
  );
}

def finite_selected_bool(n : UNat) :=
  induction n as k return (forall p : Fin(k) -> Bool. HasFiniteCardinality(Selected(Fin(k), p))) {
    zero => fun (p : Fin(0) -> Bool) => typed(
      HasFiniteCardinality(Selected(Fin(0), p)),
      (
        0,
        merely(
          Bijection(Fin(0), Selected(Fin(0), p)),
          reverse_bijection(
            Selected(Fin(0), p), Fin(0),
            impossible_bijection(
              Selected(Fin(0), p),
              (fun (s : Selected(Fin(0), p)) => absurd(selected_index(Fin(0), p, s)))
            )
          )
        )
      )
    );
    succ previous => finite_selected_bool_step(k, previous);
  };

def classical_predicate_bool(A : U0, P : A -> U0, prop_ : forall a : A. Proposition(P(a)), a : A) :
  Bool {
  exact match excluded_middle(P(a), prop_(a)) return Bool {
    left witness_ => yes;
    right absent => no;
  };
}

def classical_predicate_truth(A : U0, P : A -> U0, prop_ : forall a : A. Proposition(P(a)), a : A) :
  (P(a) -> Truth(classical_predicate_bool(A, P, prop_, a)))
  and (Truth(classical_predicate_bool(A, P, prop_, a)) -> P(a)) {
  let decision := excluded_middle(P(a), prop_(a));
  exact match decision as d return ((P(a) -> Truth(match d return Bool {
          left witness_ => yes;
          right absent => no;
        })) and (Truth(match d return Bool {
          left witness_ => yes;
          right absent => no;
        }) -> P(a))) {
    left witness_ => (fun (member : P(a)) => tt, fun (truth : Unit) => witness_);
    right absent => (
      fun (member : P(a)) => absurd(absent(member)), fun (truth : Void) => absurd(truth)
    );
  };
}

def subtype_reindex_bijection(
  A, B : U0, P : B -> U0, prop_ : forall b : B. Proposition(P(b)), e : Bijection(A, B)
) :
  Bijection((exists a : A. P(forward(A, B, e, a))), (exists b : B. P(b))) {
  let Q := fun (a : A) => P(forward(A, B, e, a));
  let X := exists a : A. Q(a);
  let Y := exists b : B. P(b);
  let f := fun (x : X) => typed(Y, (forward(A, B, e, sigma_first(A, Q, x)), sigma_second(A, Q, x)));
  let g := fun (y : Y) => typed(
    X,
    (
      backward(A, B, e, sigma_first(B, P, y)),
      transport sigma_second(B, P, y) along sym(right_inverse(A, B, e, sigma_first(B, P, y))) in P
    )
  );
  exact (
    f, g,
    (
      fun (x : X) => subtype_ext(
        A, Q, (fun (a : A) => prop_(forward(A, B, e, a))), g(f(x)), x,
        left_inverse(A, B, e, sigma_first(A, Q, x))
      )
    ),
    (
      fun (y : Y) => subtype_ext(
        B, P, prop_, f(g(y)), y, right_inverse(A, B, e, sigma_first(B, P, y))
      )
    )
  );
}

def finite_predicate_from_enumeration(
  A : U0, n : UNat, enumeration : Bijection(Fin(n), A), P : A -> U0, prop_ : forall a : A.
  Proposition(P(a))
) :
  HasFiniteCardinality(exists a : A. P(a)) {
  let Q := fun (i : Fin(n)) => P(forward(Fin(n), A, enumeration, i));
  let propQ := fun (i : Fin(n)) => prop_(forward(Fin(n), A, enumeration, i));
  let p := classical_predicate_bool(Fin(n), Q, propQ);
  let decide := fun (i : Fin(n)) => classical_predicate_truth(Fin(n), Q, propQ, i);
  let selectedToSubtype := reverse_bijection(
    (exists i : Fin(n). Q(i)), Selected(Fin(n), p),
    subtype_bijection(
      Fin(n), Q, (fun (i : Fin(n)) => Truth(p(i))), propQ, (fun (i : Fin(n)) => truth_prop(p(i))),
      (fun (i : Fin(n)) => fst(Q(i) -> Truth(p(i)), Truth(p(i)) -> Q(i), decide(i))),
      (fun (i : Fin(n)) => snd(Q(i) -> Truth(p(i)), Truth(p(i)) -> Q(i), decide(i)))
    )
  );
  let reindex := subtype_reindex_bijection(Fin(n), A, P, prop_, enumeration);
  exact finite_cardinality_bijection(
    Selected(Fin(n), p), (exists a : A. P(a)),
    compose_bijection(
      Selected(Fin(n), p), (exists i : Fin(n). Q(i)), (exists a : A. P(a)), selectedToSubtype,
      reindex
    ), finite_selected_bool(n, p)
  );
}

def finite_predicate_of_finite(
  A : U0, n : UNat, finite : HasCardinality(A, n), P : A -> U0, prop_ : forall a : A.
  Proposition(P(a))
) :
  HasFiniteCardinality(exists a : A. P(a)) {
  let B := exists a : A. P(a);
  exact mere_eliminate(
    Bijection(Fin(n), A), HasFiniteCardinality(B), finite_cardinality_prop(B),
    (
      fun (enumeration : Bijection(Fin(n), A)) => finite_predicate_from_enumeration(
        A, n, enumeration, P, prop_
      )
    ), finite
  );
}
