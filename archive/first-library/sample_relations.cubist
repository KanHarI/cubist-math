import sample_magnitude;

// Adjacent vertices satisfy a relation; no condition is imposed on tags.
def SampleAdjacent(C : U1, related : C -> C -> U0, n : Nat) =
  induction n as k return (SampleVertices(C, k) -> U0) {
    zero => fun (vertices : C) => Unit;
    succ previous => fun (vertices : SampleVertices(C, succ(k))) => related(
      field_fst(C, SampleVertices(C, k), vertices),
      sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices))
    ) and previous(field_snd(C, SampleVertices(C, k), vertices));
  };

def sample_adjacent_magnitude(
  C F : U1, negF : F -> F, lt : F -> F -> U0, related : C -> C -> U0, edge radius : C -> C -> C
  -> F,
  bounded : (
    forall a : C, forall b : C, forall tag : C, related(a, b)
    -> FieldMagnitudeBound(F, negF, lt, edge(a, b, tag), radius(a, b, tag))
  ), n : Nat
) :
  forall vertices : SampleVertices(C, n), forall tags : SampleTags(C, n),
  SampleAdjacent(C, related, n, vertices)
  -> SampleMagnitudeBounds(C, F, negF, lt, edge, radius, n, vertices, tags) {
  exact induction n as k return (
    forall vertices : SampleVertices(C, k), forall tags : SampleTags(C, k),
    SampleAdjacent(C, related, k, vertices)
    -> SampleMagnitudeBounds(C, F, negF, lt, edge, radius, k, vertices, tags)
  ) {
    zero => fun (vertices : C, tags adjacent : Unit) => tt;
    succ previous => fun (
      vertices : SampleVertices(C, succ(k)), tags : SampleTags(C, succ(k)),
      adjacent : SampleAdjacent(C, related, succ(k), vertices)
    ) => typed(
      (
        FieldMagnitudeBound(
          F, negF, lt,
          edge(
            field_fst(C, SampleVertices(C, k), vertices),
            sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
            field_fst(C, SampleTags(C, k), tags)
          ),
          radius(
            field_fst(C, SampleVertices(C, k), vertices),
            sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
            field_fst(C, SampleTags(C, k), tags)
          )
        )
        and SampleMagnitudeBounds(
          C, F, negF, lt, edge, radius, k, field_snd(C, SampleVertices(C, k), vertices),
          field_snd(C, SampleTags(C, k), tags)
        )
      ),
      (
        bounded(
          field_fst(C, SampleVertices(C, k), vertices),
          sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
          field_fst(C, SampleTags(C, k), tags),
          field_fst(
            related(
              field_fst(C, SampleVertices(C, k), vertices),
              sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices))
            ), SampleAdjacent(C, related, k, field_snd(C, SampleVertices(C, k), vertices)), adjacent
          )
        ),
        previous(
          field_snd(C, SampleVertices(C, k), vertices), field_snd(C, SampleTags(C, k), tags),
          field_snd(
            related(
              field_fst(C, SampleVertices(C, k), vertices),
              sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices))
            ), SampleAdjacent(C, related, k, field_snd(C, SampleVertices(C, k), vertices)), adjacent
          )
        )
      )
    );
  };
}
