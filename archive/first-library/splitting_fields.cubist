import finite_splitting_extensions;
import polynomial_splitting_leading;
import root_generated_fields;
import finite_towers;

// A splitting field both splits the polynomial and is generated by its roots
// over the specified base embedding. Finiteness is a proved part of the witness.
def FiniteSplittingField(K : AlgebraicField, p : Polynomial(K), n : Nat) :=
  exists L : AlgebraicField, exists e : FieldEmbedding(K, L),
  FiniteExtension(K, embedding_as_extension(K, L, e))
  and (
    exists roots : Fin(n) -> af_carrier(L), exists a : af_carrier(L),
    (
      polynomial_map(K, L, e, p) = polynomial_mul(
        L, polynomial_constant(L, a), linear_factor_product(L, n, roots)
      )
    ) and (forall y : af_carrier(L), GeneratedField(L, RootFieldGenerators(K, L, e, n, roots), y))
  );

def root_generated_factorization(
  K L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K), n : Nat, roots : Fin(n)
  -> af_carrier(L), a : af_carrier(L),
  equation : polynomial_map(K, L, e, p) = polynomial_mul(
    L, polynomial_constant(L, a), linear_factor_product(L, n, roots)
  )
) :
  polynomial_map(
    K, RootGeneratedField(K, L, e, n, roots), root_generated_embedding(K, L, e, n, roots), p
  ) = polynomial_mul(
    RootGeneratedField(K, L, e, n, roots),
    polynomial_constant(
      RootGeneratedField(K, L, e, n, roots),
      field_embedding_map(
        K, RootGeneratedField(K, L, e, n, roots), root_generated_embedding(K, L, e, n, roots),
        polynomial_coefficients(K, p, n)
      )
    ),
    linear_factor_product(
      RootGeneratedField(K, L, e, n, roots), n, root_generated_root(K, L, e, n, roots)
    )
  ) {
  let S := RootGeneratedSubfield(K, L, e, n, roots);
  let T := RootGeneratedField(K, L, e, n, roots);
  let d := root_generated_embedding(K, L, e, n, roots);
  let j := subfield_inclusion(L, S);
  let triangle :=
    field_embedding_factor_triangle(K, L, e, S, root_generated_contains_base(K, L, e, n, roots));
  let rs := root_generated_root(K, L, e, n, roots);
  let b := field_embedding_map(K, T, d, polynomial_coefficients(K, p, n));
  let left := polynomial_map(K, T, d, p);
  let right := polynomial_mul(T, polynomial_constant(T, b), linear_factor_product(T, n, rs));
  have mappedLeft : polynomial_map(T, L, j, left) = polynomial_map(K, L, e, p) := trans(
    polynomial_map_composition(K, T, L, d, j, p),
    cong((fun (h : FieldEmbedding(K, L)) => polynomial_map(K, L, h, p)), triangle)
  );
  have mappedRight :
    polynomial_map(T, L, j, right) = polynomial_mul(
      L, polynomial_constant(L, a), linear_factor_product(L, n, roots)
    ) {
    let scalar :=
      polynomial_splitting_leading(L, polynomial_map(K, L, e, p), n, roots, a, equation);
    exact trans(
      polynomial_map_mul(T, L, j, polynomial_constant(T, b), linear_factor_product(T, n, rs)),
      trans(
        cong(
          (
            fun (q : Polynomial(L)) => polynomial_mul(
              L, q, polynomial_map(T, L, j, linear_factor_product(T, n, rs))
            )
          ), trans(polynomial_map_constant(T, L, j, b), cong(polynomial_constant(L), scalar))
        ),
        cong(
          polynomial_mul(L, polynomial_constant(L, a)), linear_factor_product_map(T, L, j, n, rs)
        )
      )
    );
  }
  exact polynomial_map_injective(
    T, L, j, left, right, trans(mappedLeft, trans(equation, sym(mappedRight)))
  );
}

def restrict_to_splitting_field(
  K : AlgebraicField, p : Polynomial(K), n : Nat, splitting : FiniteSplittingExtension(K, p, n)
) :
  FiniteSplittingField(K, p, n) {
  obtain (L, e, finite, roots, a, equation) := splitting;
  let S := RootGeneratedSubfield(K, L, e, n, roots);
  let T := RootGeneratedField(K, L, e, n, roots);
  let d := root_generated_embedding(K, L, e, n, roots);
  let j := subfield_inclusion(L, S);
  let triangle :=
    field_embedding_factor_triangle(K, L, e, S, root_generated_contains_base(K, L, e, n, roots));
  obtain (lower, upper) := finite_extension_tower_converse(K, T, L, d, j, e, triangle, finite);
  exact (
    T, d, lower, root_generated_root(K, L, e, n, roots),
    field_embedding_map(K, T, d, polynomial_coefficients(K, p, n)),
    root_generated_factorization(K, L, e, p, n, roots, a, equation),
    root_generated_generates(K, L, e, n, roots)
  );
}

def finite_splitting_field_exists(
  K : AlgebraicField, p : Polynomial(K), nonzero : PolynomialNonzero(K, p)
) :
  FieldExists(FiniteSplittingField(K, p, polynomial_degree(K, p))) {
  let n := polynomial_degree(K, p);
  exact field_exists_map(
    FiniteSplittingExtension(K, p, n), FiniteSplittingField(K, p, n),
    restrict_to_splitting_field(K, p, n), finite_splitting_extension_exists(K, p, nonzero)
  );
}
