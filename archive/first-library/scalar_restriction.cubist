import function_linear_isos;

def restricted_action(
  K L : AlgebraicField, e : FieldEmbedding(K, L), V : VectorSpace(L), a : af_carrier(K),
  x : vector_carrier(L, V)
) =
  vector_scale(L, V, field_embedding_map(K, L, e, a), x);

def restricted_scalar_laws(K L : AlgebraicField, e : FieldEmbedding(K, L), V : VectorSpace(L)) :
  ScalarLaws(K, vector_group(L, V), restricted_action(K, L, e, V)) {
  let embed = field_embedding_map(K, L, e);
  let X = vector_carrier(L, V);
  obtain (zero, one, neg, add, mul) = field_embedding_preserves(K, L, e);
  exact (
    (
      fun (x : X) => trans(
        cong((fun (a : af_carrier(L)) => vector_scale(L, V, a, x)), one), vector_scale_one(L, V, x)
      )
    ),
    (
      fun (a b : af_carrier(K)) (x : X) => trans(
        cong((fun (c : af_carrier(L)) => vector_scale(L, V, c, x)), mul(a, b)),
        vector_scale_associative(L, V, embed(a), embed(b), x)
      )
    ), (fun (a : af_carrier(K)) => vector_scale_add_vectors(L, V, embed(a))),
    (
      fun (a b : af_carrier(K)) (x : X) => trans(
        cong((fun (c : af_carrier(L)) => vector_scale(L, V, c, x)), add(a, b)),
        vector_scale_add_scalars(L, V, embed(a), embed(b), x)
      )
    )
  );
}

def RestrictScalars(K L : AlgebraicField, e : FieldEmbedding(K, L), V : VectorSpace(L)) =
  vector_space(
    K, vector_group(L, V), restricted_action(K, L, e, V), vector_abelian(L, V),
    restricted_scalar_laws(K, L, e, V)
  );

def restrict_linear_map(
  K L : AlgebraicField, e : FieldEmbedding(K, L), V W : VectorSpace(L), f : LinearMap(L, V, W)
) :
  LinearMap(K, RestrictScalars(K, L, e, V), RestrictScalars(K, L, e, W)) {
  exact (
    linear_map(L, V, W, f), linear_add(L, V, W, f),
    (fun (a : af_carrier(K)) => linear_scale(L, V, W, f, field_embedding_map(K, L, e, a)))
  );
}

def restrict_linear_iso(
  K L : AlgebraicField, e : FieldEmbedding(K, L), V W : VectorSpace(L), iso : LinearIso(L, V, W)
) :
  LinearIso(K, RestrictScalars(K, L, e, V), RestrictScalars(K, L, e, W)) {
  obtain (f, g, left, right) = iso;
  exact (restrict_linear_map(K, L, e, V, W, f), restrict_linear_map(K, L, e, W, V, g), left, right);
}

// These identity isomorphisms compare operations, not the chosen proofs
// of their laws. They avoid silently identifying different structure records.
def restrict_coordinate_iso(K L : AlgebraicField, e : FieldEmbedding(K, L), n : Nat) :
  LinearIso(
    K, FunctionSpace(K, Fin(n), field_vector_space(K, L, e)),
    RestrictScalars(K, L, e, CoordinateSpace(L, n))
  ) {
  let X = Fin(n) -> af_carrier(L);
  let f = fun (x : X) => x;
  let add =
    fun (x y : X) => refl((fun (i : Fin(n)) => af_add(af_carrier(L), af_operations(L), x(i), y(i))));
  let scale =
    fun (a : af_carrier(K)) (x : X) => refl(
      (
        fun (i : Fin(n)) => af_mul(
          af_carrier(L), af_operations(L), field_embedding_map(K, L, e, a), x(i)
        )
      )
    );
  exact ((f, add, scale), (f, add, scale), (fun (x : X) => refl(x)), (fun (x : X) => refl(x)));
}

def restrict_field_tower_iso(
  K L M : AlgebraicField, e : FieldEmbedding(K, L), d : FieldEmbedding(L, M)
) :
  LinearIso(
    K, RestrictScalars(K, L, e, field_vector_space(L, M, d)),
    field_vector_space(K, M, field_embedding_compose(K, L, M, e, d))
  ) {
  let X = af_carrier(M);
  let f = fun (x : X) => x;
  let add = fun (x y : X) => refl(af_add(X, af_operations(M), x, y));
  let scale =
    fun (a : af_carrier(K)) (x : X) => refl(
      af_mul(X, af_operations(M), field_embedding_map(L, M, d, field_embedding_map(K, L, e, a)), x)
    );
  exact ((f, add, scale), (f, add, scale), (fun (x : X) => refl(x)), (fun (x : X) => refl(x)));
}

// A product of coordinate systems gives a basis over the bottom field.
// The index order is outer L-coordinates, then inner K-coordinates.
def field_tower_basis(
  K L M : AlgebraicField, e : FieldEmbedding(K, L), d : FieldEmbedding(L, M), m n : Nat,
  lower : FiniteBasis(K, field_vector_space(K, L, e), m),
  upper : FiniteBasis(L, field_vector_space(L, M, d), n)
) :
  FiniteBasis(
    K, field_vector_space(K, M, field_embedding_compose(K, L, M, e, d)), multiply_count(n, m)
  ) {
  let Coordinates = CoordinateSpace(K, multiply_count(n, m));
  let Nested = FunctionSpace(K, Fin(n), CoordinateSpace(K, m));
  let OverL = FunctionSpace(K, Fin(n), field_vector_space(K, L, e));
  let RestrictedCoordinates = RestrictScalars(K, L, e, CoordinateSpace(L, n));
  let RestrictedM = RestrictScalars(K, L, e, field_vector_space(L, M, d));
  let BottomM = field_vector_space(K, M, field_embedding_compose(K, L, M, e, d));
  let expandLower =
    linear_iso_compose(
      K, Coordinates, Nested, OverL, coordinate_product_iso(K, n, m),
      function_linear_iso(K, Fin(n), CoordinateSpace(K, m), field_vector_space(K, L, e), lower)
    );
  let restrictCoordinates =
    linear_iso_compose(
      K, Coordinates, OverL, RestrictedCoordinates, expandLower, restrict_coordinate_iso(K, L, e, n)
    );
  let expandUpper =
    linear_iso_compose(
      K, Coordinates, RestrictedCoordinates, RestrictedM, restrictCoordinates,
      restrict_linear_iso(K, L, e, CoordinateSpace(L, n), field_vector_space(L, M, d), upper)
    );
  exact linear_iso_compose(
    K, Coordinates, RestrictedM, BottomM, expandUpper, restrict_field_tower_iso(K, L, M, e, d)
  );
}
