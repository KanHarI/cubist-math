import algebraic_fields;
import field_extensionality;

// A subfield is a proposition-valued subset closed under the field operations.
// The inverse clause closes under any witnessed inverse; no total inverse or
// decidable test for zero is needed. Existence comes from the ambient field.
def SubfieldLaws(F : AlgebraicField, P : af_carrier(F) -> U0) =
  (forall x : af_carrier(F), Proposition(P(x))) and P(af_zero(af_carrier(F), af_operations(F)))
  and P(af_one(af_carrier(F), af_operations(F)))
  and (forall x : af_carrier(F), P(x) -> P(af_neg(af_carrier(F), af_operations(F), x)))
  and (
    forall x : af_carrier(F), forall y : af_carrier(F), P(x) -> P(y)
    -> P(af_add(af_carrier(F), af_operations(F), x, y))
  )
  and (
    forall x : af_carrier(F), forall y : af_carrier(F), P(x) -> P(y)
    -> P(af_mul(af_carrier(F), af_operations(F), x, y))
  )
  and (
    forall x : af_carrier(F), forall y : af_carrier(F), P(x)
    -> (af_mul(af_carrier(F), af_operations(F), x, y) = af_one(af_carrier(F), af_operations(F)))
    -> P(y)
  );

def Subfield(F : AlgebraicField) = exists P : af_carrier(F) -> U0, SubfieldLaws(F, P);

// Membership remains U0-valued; the type of subfields itself is in U1.
def subfield_members(F : AlgebraicField, S : Subfield(F)) =
  unpack S as (P, laws) return (af_carrier(F) -> U0) {
    P;
  };

def subfield_laws(F : AlgebraicField, S : Subfield(F)) : SubfieldLaws(F, subfield_members(F, S)) {
  exact field_second(
    (af_carrier(F) -> U0), (fun (P : af_carrier(F) -> U0) => typed(U1, SubfieldLaws(F, P))), S
  );
}

// These projections let clients use closure without depending on tuple layout.

def subfield_prop(
  F : AlgebraicField, P : af_carrier(F) -> U0, laws : SubfieldLaws(F, P), x : af_carrier(F)
) :
  Proposition(P(x)) {
  obtain (prop, zero, one, negateLocal, addLocal, multiplyLocal, invClosed) = laws;
  exact prop(x);
}

def subfield_zero(F : AlgebraicField, P : af_carrier(F) -> U0, laws : SubfieldLaws(F, P)) :
  P(af_zero(af_carrier(F), af_operations(F))) {
  obtain (prop, zero, one, negateLocal, addLocal, multiplyLocal, invClosed) = laws;
  exact zero;
}

def subfield_one(F : AlgebraicField, P : af_carrier(F) -> U0, laws : SubfieldLaws(F, P)) :
  P(af_one(af_carrier(F), af_operations(F))) {
  obtain (prop, zero, one, negateLocal, addLocal, multiplyLocal, invClosed) = laws;
  exact one;
}

def subfield_neg(
  F : AlgebraicField, P : af_carrier(F) -> U0, laws : SubfieldLaws(F, P), x : af_carrier(F),
  member : P(x)
) :
  P(af_neg(af_carrier(F), af_operations(F), x)) {
  obtain (prop, zero, one, negateLocal, addLocal, multiplyLocal, invClosed) = laws;
  exact negateLocal(x, member);
}

def subfield_add(
  F : AlgebraicField, P : af_carrier(F) -> U0, laws : SubfieldLaws(F, P), x y : af_carrier(F),
  px : P(x), py : P(y)
) :
  P(af_add(af_carrier(F), af_operations(F), x, y)) {
  obtain (prop, zero, one, negateLocal, addLocal, multiplyLocal, invClosed) = laws;
  exact addLocal(x, y, px, py);
}

def subfield_mul(
  F : AlgebraicField, P : af_carrier(F) -> U0, laws : SubfieldLaws(F, P), x y : af_carrier(F),
  px : P(x), py : P(y)
) :
  P(af_mul(af_carrier(F), af_operations(F), x, y)) {
  obtain (prop, zero, one, negateLocal, addLocal, multiplyLocal, invClosed) = laws;
  exact multiplyLocal(x, y, px, py);
}

def subfield_inverse(
  F : AlgebraicField, P : af_carrier(F) -> U0, laws : SubfieldLaws(F, P), x y : af_carrier(F),
  px : P(x),
  inverseLaw : af_mul(af_carrier(F), af_operations(F), x, y) = af_one(
    af_carrier(F), af_operations(F)
  )
) :
  P(y) {
  obtain (prop, zero, one, negateLocal, addLocal, multiplyLocal, invClosed) = laws;
  exact invClosed(x, y, px, inverseLaw);
}

// Closure laws and membership proposition evidence are properties, not extra data.
def subfield_laws_prop(F : AlgebraicField, P : af_carrier(F) -> U0, p q : SubfieldLaws(F, P)) :
  p = q {
  let A = af_carrier(F);
  let ops = af_operations(F);
  let known = subfield_prop(F, P, p);
  let membershipLaw = (forall x : A, Proposition(P(x)));
  let membershipUnique =
    forall_prop(A, (fun (x : A) => Proposition(P(x))), (fun (x : A) => is_prop_prop(P(x))));
  let zeroLaw = P(af_zero(A, ops));
  let zeroUnique = known(af_zero(A, ops));
  let oneLaw = P(af_one(A, ops));
  let oneUnique = known(af_one(A, ops));
  let negationLaw = (forall x : A, (forall px : P(x), P(af_neg(A, ops, x))));
  let negationUnique =
    forall_prop(
      A, (fun (x : A) => (forall px : P(x), P(af_neg(A, ops, x)))),
      (
        fun (x : A) => forall_prop(
          P(x), (fun (px : P(x)) => P(af_neg(A, ops, x))),
          (fun (px : P(x)) => known(af_neg(A, ops, x)))
        )
      )
    );
  let additionLaw =
    (forall x : A, (forall y : A, (forall px : P(x), (forall py : P(y), P(af_add(A, ops, x, y))))));
  let additionUnique =
    forall_prop(
      A,
      (
        fun (x : A) => (
          forall y : A, (forall px : P(x), (forall py : P(y), P(af_add(A, ops, x, y))))
        )
      ),
      (
        fun (x : A) => forall_prop(
          A, (fun (y : A) => (forall px : P(x), (forall py : P(y), P(af_add(A, ops, x, y))))),
          (
            fun (y : A) => forall_prop(
              P(x), (fun (px : P(x)) => (forall py : P(y), P(af_add(A, ops, x, y)))),
              (
                fun (px : P(x)) => forall_prop(
                  P(y), (fun (py : P(y)) => P(af_add(A, ops, x, y))),
                  (fun (py : P(y)) => known(af_add(A, ops, x, y)))
                )
              )
            )
          )
        )
      )
    );
  let multiplicationLaw =
    (forall x : A, (forall y : A, (forall px : P(x), (forall py : P(y), P(af_mul(A, ops, x, y))))));
  let multiplicationUnique =
    forall_prop(
      A,
      (
        fun (x : A) => (
          forall y : A, (forall px : P(x), (forall py : P(y), P(af_mul(A, ops, x, y))))
        )
      ),
      (
        fun (x : A) => forall_prop(
          A, (fun (y : A) => (forall px : P(x), (forall py : P(y), P(af_mul(A, ops, x, y))))),
          (
            fun (y : A) => forall_prop(
              P(x), (fun (px : P(x)) => (forall py : P(y), P(af_mul(A, ops, x, y)))),
              (
                fun (px : P(x)) => forall_prop(
                  P(y), (fun (py : P(y)) => P(af_mul(A, ops, x, y))),
                  (fun (py : P(y)) => known(af_mul(A, ops, x, y)))
                )
              )
            )
          )
        )
      )
    );
  let inversionLaw =
    (
      forall x : A,
      (
        forall y : A,
        (forall px : P(x), (forall inverseLaw : af_mul(A, ops, x, y) = af_one(A, ops), P(y)))
      )
    );
  let inversionUnique =
    forall_prop(
      A,
      (
        fun (x : A) => (
          forall y : A,
          (forall px : P(x), (forall inverseLaw : af_mul(A, ops, x, y) = af_one(A, ops), P(y)))
        )
      ),
      (
        fun (x : A) => forall_prop(
          A,
          (
            fun (y : A) => (
              forall px : P(x), (forall inverseLaw : af_mul(A, ops, x, y) = af_one(A, ops), P(y))
            )
          ),
          (
            fun (y : A) => forall_prop(
              P(x),
              (fun (px : P(x)) => (forall inverseLaw : af_mul(A, ops, x, y) = af_one(A, ops), P(y))),
              (
                fun (px : P(x)) => forall_prop(
                  af_mul(A, ops, x, y) = af_one(A, ops),
                  (fun (inverseLaw : af_mul(A, ops, x, y) = af_one(A, ops)) => P(y)),
                  (fun (inverseLaw : af_mul(A, ops, x, y) = af_one(A, ops)) => known(y))
                )
              )
            )
          )
        )
      )
    );
  let multiplicationTail = multiplicationLaw and inversionLaw;
  let multiplicationTailUnique =
    product_prop(multiplicationLaw, inversionLaw, multiplicationUnique, inversionUnique);
  let additionTail = additionLaw and multiplicationTail;
  let additionTailUnique =
    product_prop(additionLaw, multiplicationTail, additionUnique, multiplicationTailUnique);
  let negationTail = negationLaw and additionTail;
  let negationTailUnique =
    product_prop(negationLaw, additionTail, negationUnique, additionTailUnique);
  let oneTail = oneLaw and negationTail;
  let oneTailUnique = product_prop(oneLaw, negationTail, oneUnique, negationTailUnique);
  let zeroTail = zeroLaw and oneTail;
  let zeroTailUnique = product_prop(zeroLaw, oneTail, zeroUnique, oneTailUnique);
  let membershipTailUnique =
    product_prop(membershipLaw, zeroTail, membershipUnique, zeroTailUnique);
  exact membershipTailUnique(p, q);
}

// Univalence identifies subfields with the same elements, including their laws.
def subfield_ext(
  F : AlgebraicField, S T : Subfield(F),
  same : (
    forall x : af_carrier(F), (subfield_members(F, S, x) -> subfield_members(F, T, x))
    and (subfield_members(F, T, x) -> subfield_members(F, S, x))
  )
) :
  S =[Subfield(F)] T {
  let P = subfield_members(F, S);
  let Q = subfield_members(F, T);
  have membership : P = Q := field_predicate_ext(
    af_carrier(F), P, Q, subfield_prop(F, P, subfield_laws(F, S)),
    subfield_prop(F, Q, subfield_laws(F, T)), same
  );
  exact field_subtype_ext(
    (af_carrier(F) -> U0), (fun (P : af_carrier(F) -> U0) => typed(U1, SubfieldLaws(F, P))),
    subfield_laws_prop(F), S, T, membership
  );
}

// The whole ambient field is the greatest subfield.
def SubfieldTop(F : AlgebraicField, x : af_carrier(F)) = Unit;

def subfield_top_laws(F : AlgebraicField) : SubfieldLaws(F, SubfieldTop(F)) {
  let A = af_carrier(F);
  let ops = af_operations(F);
  exact (
    (fun (x : A, p q : Unit) => trans(sym(unit_equal(p)), unit_equal(q))), tt, tt,
    (fun (x : A, px : Unit) => tt), (fun (x y : A, px py : Unit) => tt),
    (fun (x y : A, px py : Unit) => tt),
    (fun (x y : A, px : Unit, inverseLaw : af_mul(A, ops, x, y) = af_one(A, ops)) => tt)
  );
}

def subfield_top(F : AlgebraicField) : Subfield(F) {
  exact (SubfieldTop(F), subfield_top_laws(F));
}

def SubfieldIncluded(F : AlgebraicField, S T : Subfield(F)) =
  forall x : af_carrier(F), subfield_members(F, S, x) -> subfield_members(F, T, x);

// Antisymmetry is equality of bundled subfields, using their univalent predicates.
def subfield_inclusion_antisymmetric(
  F : AlgebraicField, S T : Subfield(F), includedST : SubfieldIncluded(F, S, T),
  includedTS : SubfieldIncluded(F, T, S)
) :
  S =[Subfield(F)] T {
  exact subfield_ext(
    F, S, T,
    (
      fun (x : af_carrier(F)) => typed(
        (
          (subfield_members(F, S, x) -> subfield_members(F, T, x))
          and (subfield_members(F, T, x) -> subfield_members(F, S, x))
        ), (includedST(x), includedTS(x))
      )
    )
  );
}

def subfield_inclusion_refl(F : AlgebraicField, S : Subfield(F)) : SubfieldIncluded(F, S, S) {
  intro x member;
  exact member;
}

def subfield_inclusion_trans(
  F : AlgebraicField, S T V : Subfield(F), st : SubfieldIncluded(F, S, T),
  tv : SubfieldIncluded(F, T, V)
) :
  SubfieldIncluded(F, S, V) {
  intro x member;
  exact tv(x, st(x, member));
}
