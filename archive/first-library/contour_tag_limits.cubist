import contour_error_bounds;
import field_magnitude_close;
import field_scale_limits;

// The tag-error estimate controls the difference of the actual finite sums.
def contour_tag_change_close(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), f : F -> F, weight : F -> F -> F
  -> F, delta, length : F, nonnegativeDelta : FieldLe(F, lt, zero, delta), n : Nat,
  vertices : SampleVertices(F, n), oldTags, newTags : SampleTags(F, n),
  errors : ContourTagBounds(F, addF, negF, lt, f, delta, n, vertices, oldTags, newTags),
  increments : SampleMagnitudeBounds(
    F, F, negF, lt, (fun (a, b, t : F) => coordinate_difference(F, addF, negF, a, b)), weight, n,
    vertices, oldTags
  ), variation : FieldLe(F, lt, sample_sum(F, F, zero, addF, weight, n, vertices, oldTags), length),
  epsilon : F, small : lt(mulF(delta, length), epsilon)
) :
  FieldClose(
    F, addF, lt, contour_sum(F, zero, addF, mulF, negF, f, n, vertices, newTags),
    contour_sum(F, zero, addF, mulF, negF, f, n, vertices, oldTags), epsilon
  ) {
  let error := contour_tag_error_sum(F, zero, addF, mulF, negF, f, n, vertices, oldTags, newTags);
  let bound :=
    contour_tag_error_length_bound(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, f, weight, delta, length,
      nonnegativeDelta, n, vertices, oldTags, newTags, errors, increments, variation
    );
  exact field_magnitude_perturbation_close(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic,
    contour_sum(F, zero, addF, mulF, negF, f, n, vertices, oldTags),
    contour_sum(F, zero, addF, mulF, negF, f, n, vertices, newTags), error, mulF(delta, length),
    epsilon,
    contour_sum_change_tags(F, zero, one, addF, mulF, negF, ring, f, n, vertices, oldTags, newTags),
    bound, small
  );
}

// The sampling scheme and its analytic estimates are explicit inputs.
// This does not postulate that arbitrary refinements have small errors.
def contour_tag_errors_converge(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), f : F -> F, weight : F -> F -> F
  -> F, count : Nat -> Nat, vertices : (forall n : Nat. SampleVertices(F, count(n))),
  oldTags, newTags : (forall n : Nat. SampleTags(F, count(n))), delta : Nat -> F, length : F,
  nonnegativeDelta : (forall n : Nat. FieldLe(F, lt, zero, delta(n))),
  errors : (
    forall n : Nat.
    ContourTagBounds(F, addF, negF, lt, f, delta(n), count(n), vertices(n), oldTags(n), newTags(n))
  ),
  increments : (
    forall n : Nat.
    SampleMagnitudeBounds(
      F, F, negF, lt, (fun (a, b, t : F) => coordinate_difference(F, addF, negF, a, b)), weight,
      count(n), vertices(n), oldTags(n)
    )
  ),
  variation : (
    forall n : Nat.
    FieldLe(F, lt, sample_sum(F, F, zero, addF, weight, count(n), vertices(n), oldTags(n)), length)
  ), vanishes : FieldConverges(F, zero, addF, lt, (fun (n : Nat) => mulF(delta(n), length)), zero)
) :
  FieldConverges(
    F, zero, addF, lt,
    (
      fun (n : Nat) => contour_tag_error_sum(
        F, zero, addF, mulF, negF, f, count(n), vertices(n), oldTags(n), newTags(n)
      )
    ), zero
  ) {
  exact field_magnitude_squeeze(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic,
    (
      fun (n : Nat) => contour_tag_error_sum(
        F, zero, addF, mulF, negF, f, count(n), vertices(n), oldTags(n), newTags(n)
      )
    ), (fun (n : Nat) => mulF(delta(n), length)),
    (
      fun (n : Nat) => contour_tag_error_length_bound(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, f, weight, delta(n), length,
        nonnegativeDelta(n), count(n), vertices(n), oldTags(n), newTags(n), errors(n),
        increments(n), variation(n)
      )
    ), vanishes
  );
}

// Over ordered fields, convergence of delta itself suffices.
def contour_tag_errors_from_vanishing_values(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  inverses : FieldInverses(F, zero, one, mulF, lt), f : F -> F, weight : F -> F -> F -> F,
  count : Nat -> Nat, vertices : (forall n : Nat. SampleVertices(F, count(n))),
  oldTags, newTags : (forall n : Nat. SampleTags(F, count(n))), delta : Nat -> F, length : F,
  nonnegativeLength : FieldLe(F, lt, zero, length),
  nonnegativeDelta : (forall n : Nat. FieldLe(F, lt, zero, delta(n))),
  errors : (
    forall n : Nat.
    ContourTagBounds(F, addF, negF, lt, f, delta(n), count(n), vertices(n), oldTags(n), newTags(n))
  ),
  increments : (
    forall n : Nat.
    SampleMagnitudeBounds(
      F, F, negF, lt, (fun (a, b, t : F) => coordinate_difference(F, addF, negF, a, b)), weight,
      count(n), vertices(n), oldTags(n)
    )
  ),
  variation : (
    forall n : Nat.
    FieldLe(F, lt, sample_sum(F, F, zero, addF, weight, count(n), vertices(n), oldTags(n)), length)
  ), vanishes : FieldConverges(F, zero, addF, lt, delta, zero)
) :
  FieldConverges(
    F, zero, addF, lt,
    (
      fun (n : Nat) => contour_tag_error_sum(
        F, zero, addF, mulF, negF, f, count(n), vertices(n), oldTags(n), newTags(n)
      )
    ), zero
  ) {
  let scaled :=
    field_nonnegative_scale_zero_converges(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, length,
      nonnegativeLength, delta, vanishes
    );
  exact contour_tag_errors_converge(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, f, weight, count, vertices,
    oldTags, newTags, delta, length, nonnegativeDelta, errors, increments, variation, scaled
  );
}
