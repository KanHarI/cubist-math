// Binary positive integers: the leading one, then each trailing digit, the
// last digit outermost. They have no leading-zero representation.
inductive BinaryPositive : U0 {
  binary_one;
  binary_bit0(p : BinaryPositive);
  binary_bit1(p : BinaryPositive);
}

// Zero is separate, so every nonzero numeral ends at the one leaf.
inductive BinaryNat : U0 {
  binary_zero;
  binary_positive(p : BinaryPositive);
}

// The recursive result and original child are both available in a digit case.
def binary_positive_rec(R : U0, one : R, even, odd : BinaryPositive -> R -> R, p : BinaryPositive) :
  R := match p {
    binary_one => one;
    binary_bit0(child) => even(child, binary_positive_rec(R, one, even, odd, child));
    binary_bit1(child) => odd(child, binary_positive_rec(R, one, even, odd, child));
  };

def binary_positive_cases(R : U0, one : R, even, odd : BinaryPositive -> R, p : BinaryPositive) :=
  binary_positive_rec(
    R, one, fun (child : BinaryPositive, ignored : R) => even(child),
    fun (child : BinaryPositive, ignored : R) => odd(child), p
  );

// These examples reduce by constructor computation alone.
def binary_literal_digits : 0b110 = binary_positive(binary_bit0(binary_bit1(binary_one))) {
  rfl;
}

def binary_literal_leading_zeroes : 0b000110 = 0b110 {
  rfl;
}
