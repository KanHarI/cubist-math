// Binary positive integers are W trees with a leaf for one and a unary node
// for each trailing digit. They have no leading-zero representation.
def BinaryLabel = Unit or (Unit or Unit);

def BinaryArity(tag : BinaryLabel) = match tag return U0 {
    left one => Void;
    right bit => Unit;
  };

def BinaryPositive = W(BinaryLabel, BinaryArity);

def binary_one =
  sup(
    BinaryPositive, typed(BinaryLabel, left(tt)), fun (v : Void) => typed(BinaryPositive, absurd(v))
  );

def binary_bit0(p : BinaryPositive) =
  sup(BinaryPositive, typed(BinaryLabel, right(left(tt))), fun (u : Unit) => p);

def binary_bit1(p : BinaryPositive) =
  sup(BinaryPositive, typed(BinaryLabel, right(right(tt))), fun (u : Unit) => p);

// Zero is separate, so every nonzero numeral ends at the one leaf.
def BinaryNat = Unit or BinaryPositive;

def binary_zero = typed(BinaryNat, left(tt));

def binary_positive(p : BinaryPositive) = typed(BinaryNat, right(p));

// The recursive result and original child are both available in a digit case.
def binary_positive_rec(R : U0, one : R, even odd : BinaryPositive -> R -> R, p : BinaryPositive) =
  wrec(
    BinaryPositive, fun (tree : BinaryPositive) => R,
    fun (
      tag : BinaryLabel, children : BinaryArity(tag) -> BinaryPositive, ih : BinaryArity(tag) -> R
    ) => (
      match tag as label return (
        (BinaryArity(label) -> BinaryPositive) -> (BinaryArity(label) -> R) -> R
      ) {
        left leaf => fun (f : Void -> BinaryPositive, h : Void -> R) => one;
        right bit => fun (f : Unit -> BinaryPositive, h : Unit -> R) => match bit return R {
          left zeroBit => even(f(tt), h(tt));
          right oneBit => odd(f(tt), h(tt));
        };
      }
    )(children, ih), p
  );

def binary_positive_cases(R : U0, one : R, even odd : BinaryPositive -> R, p : BinaryPositive) =
  binary_positive_rec(
    R, one, fun (child : BinaryPositive, ignored : R) => even(child),
    fun (child : BinaryPositive, ignored : R) => odd(child), p
  );

// These examples reduce using only W, sum, unit and function computation.
def binary_literal_digits : 0b110 = binary_positive(binary_bit0(binary_bit1(binary_one))) {
  rfl;
}

def binary_literal_leading_zeroes : 0b000110 = 0b110 {
  rfl;
}
