import nat;
import lexemes;

// Binary positive integers: the leading one, then each trailing digit, the
// last digit outermost. They have no leading-zero representation.
inductive BinaryPositive : U0 {
  binary_one;
  binary_bit0(p : BinaryPositive);
  binary_bit1(p : BinaryPositive);
}

// Zero is separate, so every nonzero numeral ends at the one leaf.
inductive BinaryNat : U0 {
  binary_zero;
  binary_positive(p : BinaryPositive);
}

// The recursive result and original child are both available in a digit case.
def binary_positive_rec(R : U0, one : R, even, odd : BinaryPositive -> R -> R, p : BinaryPositive) :
  R := match p {
    binary_one => one;
    binary_bit0(child) => even(child, binary_positive_rec(R, one, even, odd, child));
    binary_bit1(child) => odd(child, binary_positive_rec(R, one, even, odd, child));
  };

def binary_positive_cases(R : U0, one : R, even, odd : BinaryPositive -> R, p : BinaryPositive) :=
  binary_positive_rec(
    R, one, fun (child : BinaryPositive, ignored : R) => even(child),
    fun (child : BinaryPositive, ignored : R) => odd(child), p
  );

// n with one more binary digit: 2n, or 2n + 1.
computable def binary_twice(n : BinaryNat) : BinaryNat := match n {
    binary_zero => binary_zero;
    binary_positive(p) => binary_positive(binary_bit0(p));
  };

computable def binary_twice_succ(n : BinaryNat) : BinaryNat := match n {
    binary_zero => binary_positive(binary_one);
    binary_positive(p) => binary_positive(binary_bit1(p));
  };

// The binary digits from position `at` of a lexeme, read after `value`.
computable def binary_digits(s : Lexeme, value : BinaryNat, at_ : Nat) :
  Parsed(U0, BinaryNat) := match s {
    nil => ok(value);
    cons(digit(zero), rest) => binary_digits(rest, binary_twice(value), succ(at_));
    cons(digit(succ(zero)), rest) => binary_digits(rest, binary_twice_succ(value), succ(at_));
    cons(_, rest) => error(at_);
  };

// The binary literals (L2.10j): 0b and binary digits, read from their
// characters, so binary.(0b110) is the numeral with digits 1, 1 and 0.
computable def binary_literal(s : Lexeme) : Parsed(U0, BinaryNat) := match s {
    cons(digit(zero), cons(lower(succ(zero)), cons(g, rest))) => binary_digits(
      cons(g, rest), binary_zero, succ(succ(zero))
    );
    cons(digit(zero), cons(lower(succ(zero)), nil)) => error(succ(succ(zero)));
    cons(digit(zero), _) => error(succ(zero));
    _ => error(zero);
  };

notation binary {
  literal (s : Lexeme) := binary_literal(s);
}

// These examples reduce by constructor computation alone.
def binary_literal_digits : binary.(0b110) = binary_positive(binary_bit0(binary_bit1(binary_one))) {
  rfl;
}

def binary_literal_leading_zeroes : binary.(0b000110) = binary.(0b110) {
  rfl;
}
