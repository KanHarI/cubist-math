import unat;
use unat;

// RadixDigit(n) has n inhabitants. Its leftmost alternative has value n-1;
// this ordering makes increment and overflow structural, with no comparison.
def RadixDigit(n : UNat) := induction n return U0 {
    zero => Void;
    succ previous => Unit or previous;
  };

def radix_digit_top(n : UNat) := typed(Unit or RadixDigit(n), left(tt));

def radix_digit_weaken(n : UNat, digit : RadixDigit(n)) :=
  typed(Unit or RadixDigit(n), right(digit));

def radix_digit_zero(n : UNat) := induction n as k return RadixDigit(succ(k)) {
    zero => radix_digit_top(0);
    succ previous => radix_digit_weaken(succ(k), previous);
  };

def radix_digit_value(n : UNat) : RadixDigit(n) -> UNat {
  exact induction n as k return (RadixDigit(k) -> UNat) {
    zero => fun (impossible : Void) => typed(UNat, absurd(impossible));
    succ previous => fun (digit : RadixDigit(succ(k))) => match typed(Unit or RadixDigit(k), digit) return UNat {
      left top => k;
      right lower => previous(lower);
    };
  };
}

// A right result means overflow. A left result is the next digit in range.
def radix_digit_succ(n : UNat) : RadixDigit(n) -> (RadixDigit(n) or Unit) {
  exact induction n as k return (RadixDigit(k) -> (RadixDigit(k) or Unit)) {
    zero => fun (impossible : Void) => typed(Void or Unit, absurd(impossible));
    succ previous => fun (digit : RadixDigit(succ(k))) => match typed(Unit or RadixDigit(k), digit) return (
      RadixDigit(succ(k)) or Unit
    ) {
      left top => right(tt);
      right lower => match previous(lower) return (RadixDigit(succ(k)) or Unit) {
        left next_ => left(radix_digit_weaken(k, next_));
        right carry => left(radix_digit_top(k));
      };
    };
  };
}

// The parameter extra denotes radix extra+2, ensuring radix at least two.
// A positive numeral is its nonzero leading digit, then each appended digit,
// the last digit outermost.
inductive RadixPositive(extra : UNat) : U0 {
  radix_leading_digit(leading : RadixDigit(succ(extra)));
  radix_appended_digit(digit : RadixDigit(succ(succ(extra))), child : RadixPositive(extra));
}

def radix_leading(extra : UNat, leading : RadixDigit(succ(extra))) :
  RadixPositive(extra) := radix_leading_digit(leading);

def radix_append(extra : UNat, digit : RadixDigit(succ(succ(extra))), child : RadixPositive(extra)) :
  RadixPositive(extra) := radix_appended_digit(digit, child);

// Zero is separate, so every nonzero numeral starts with a nonzero digit.
inductive RadixNat(extra : UNat) : U0 {
  radix_nat_zero;
  radix_nat_positive(p : RadixPositive(extra));
}

def radix_zero(extra : UNat) : RadixNat(extra) := radix_nat_zero;

def radix_positive(extra : UNat, p : RadixPositive(extra)) :
  RadixNat(extra) := radix_nat_positive(p);

def radix_one(extra : UNat) := radix_leading(extra, radix_digit_zero(extra));

def radix_positive_rec(
  extra : UNat, R : U0, leading : RadixDigit(succ(extra)) -> R,
  digit : RadixDigit(succ(succ(extra))) -> RadixPositive(extra) -> R -> R, p : RadixPositive(extra)
) :
  R := match p {
    radix_leading_digit(first) => leading(first);
    radix_appended_digit(next_, child) => digit(
      next_, child, radix_positive_rec(extra, R, leading, digit, child)
    );
  };

def radix_positive_cases(
  extra : UNat, R : U0, leading : RadixDigit(succ(extra)) -> R,
  digit : RadixDigit(succ(succ(extra))) -> RadixPositive(extra) -> R, p : RadixPositive(extra)
) :=
  radix_positive_rec(
    extra, R, leading,
    fun (d : RadixDigit(succ(succ(extra))), child : RadixPositive(extra), ignored : R) => digit(
      d, child
    ), p
  );
