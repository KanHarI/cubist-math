import puncture_graph;
import loop_words;
import circle;

// Collapse all but one labelled generator to the constant loop of S1.
// Finite equality is decided constructively, without excluded middle.
def decision_circle_loop(P : U0, decision : Decidable(P)) := match decision return LoopsS1 {
    left yes => loop;
    right no => refl(base);
  };

def selected_circle_loop(n : Nat, selected label : Fin(n)) :=
  decision_circle_loop((selected = label), fin_decidable(n, selected, label));

def selected_circle_self(n : Nat, selected : Fin(n)) :
  selected_circle_loop(n, selected, selected) = loop {
  exact match fin_decidable(n, selected, selected) as decision return (
    decision_circle_loop((selected = selected), decision) = loop
  ) {
    left yes => refl(loop);
    right no => absurd(no(refl(selected)));
  };
}

def selected_circle_other(n : Nat, selected label : Fin(n), different : (selected = label) -> Void) :
  selected_circle_loop(n, selected, label) = refl(base) {
  exact match fin_decidable(n, selected, label) as decision return (
    decision_circle_loop((selected = label), decision) = refl(base)
  ) {
    left yes => absurd(different(yes));
    right no => refl(refl(base));
  };
}

def puncture_circle_map(n : Nat, selected : Fin(n)) :=
  bouquet_map(Fin(n), S1, base, selected_circle_loop(n, selected));

def puncture_winding(n : Nat, selected : Fin(n), p : BouquetLoops(Fin(n))) :=
  winding(cong(puncture_circle_map(n, selected), p));

def puncture_winding_self(n : Nat, selected : Fin(n)) :
  puncture_winding(n, selected, puncture_loop(n, selected)) = nonnegative(1) {
  exact trans(
    cong(
      winding, bouquet_map_generator(Fin(n), S1, base, selected_circle_loop(n, selected), selected)
    ), trans(cong(winding, selected_circle_self(n, selected)), winding_generator)
  );
}

def puncture_winding_other(n : Nat, selected label : Fin(n), different : (selected = label) -> Void) :
  puncture_winding(n, selected, puncture_loop(n, label)) = zeroZ {
  exact trans(
    cong(winding, bouquet_map_generator(Fin(n), S1, base, selected_circle_loop(n, selected), label)),
    cong(winding, selected_circle_other(n, selected, label, different))
  );
}

def puncture_winding_append(n : Nat, selected : Fin(n), p q : BouquetLoops(Fin(n))) :
  puncture_winding(n, selected, trans(p, q)) = addZ(
    puncture_winding(n, selected, p), puncture_winding(n, selected, q)
  ) {
  let point := bouquet_base(Fin(n));
  let map := puncture_circle_map(n, selected);
  exact trans(
    cong(
      puncture_winding(n, selected), append_path_agrees(PunctureGraph(n), point, point, point, p, q)
    ),
    trans(
      cong(winding, map_concat(PunctureGraph(n), S1, map, point, point, point, p, q)),
      winding_concatenate(cong(map, p), cong(map, q))
    )
  );
}

def puncture_winding_inverse(n : Nat, selected : Fin(n), p : BouquetLoops(Fin(n))) :
  puncture_winding(n, selected, sym(p)) = inverse_integer(puncture_winding(n, selected, p)) {
  let mapped := cong(puncture_circle_map(n, selected), p);
  exact trans(
    cong(
      winding,
      map_inverse(
        PunctureGraph(n), S1, puncture_circle_map(n, selected), bouquet_base(Fin(n)),
        bouquet_base(Fin(n)), p
      )
    ), cong((fun (q : LoopsS1) => winding(sym(q))), sym(integer_loop_winding(mapped)))
  );
}

def puncture_winding_laws(n : Nat, selected : Fin(n)) :
  LoopMapLaws(PunctureGraph(n), bouquet_base(Fin(n)), Z, zeroZ, addZ, puncture_winding(n, selected)) {
  exact (refl(zeroZ), puncture_winding_append(n, selected));
}

def puncture_generator_nontrivial(n : Nat, selected : Fin(n)) :
  (puncture_loop(n, selected) = refl(bouquet_base(Fin(n)))) -> Void {
  intro same;
  let falseInteger :=
    trans(sym(puncture_winding_self(n, selected)), cong(puncture_winding(n, selected), same));
  exact zero_not_successor(0, sym(cong(magnitude, falseInteger)));
}

def puncture_generators_distinct(
  n : Nat, selected label : Fin(n), different : (selected = label) -> Void
) :
  (puncture_loop(n, selected) = puncture_loop(n, label)) -> Void {
  intro same;
  let falseInteger :=
    trans(
      sym(puncture_winding_self(n, selected)),
      trans(
        cong(puncture_winding(n, selected), same),
        puncture_winding_other(n, selected, label, different)
      )
    );
  exact zero_not_successor(0, sym(cong(magnitude, falseInteger)));
}

def puncture_winding_reverse_self(n : Nat, selected : Fin(n)) :
  puncture_winding(n, selected, sym(puncture_loop(n, selected))) = negative(0) {
  exact trans(
    puncture_winding_inverse(n, selected, puncture_loop(n, selected)),
    trans(cong(inverse_integer, puncture_winding_self(n, selected)), code_loop_inverse(zeroZ))
  );
}

def puncture_winding_reverse_other(
  n : Nat, selected label : Fin(n), different : (selected = label) -> Void
) :
  puncture_winding(n, selected, sym(puncture_loop(n, label))) = zeroZ {
  exact trans(
    puncture_winding_inverse(n, selected, puncture_loop(n, label)),
    cong(inverse_integer, puncture_winding_other(n, selected, label, different))
  );
}

def puncture_winding_append_values(
  n : Nat, selected : Fin(n), p q : BouquetLoops(Fin(n)), a b : Z,
  leftValue : puncture_winding(n, selected, p) = a,
  rightValue : puncture_winding(n, selected, q) = b
) :
  puncture_winding(n, selected, trans(p, q)) = addZ(a, b) {
  exact trans(
    puncture_winding_append(n, selected, p, q),
    trans(
      cong((fun (v : Z) => addZ(v, puncture_winding(n, selected, q))), leftValue),
      cong(addZ(a), rightValue)
    )
  );
}
