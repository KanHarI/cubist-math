import quotient_groups;
import kernel_quotient_image;

// The normal-kernel quotient carries its descended operations in U1.
def KernelQuotientGroup(G, H : Group, h : GroupHom(G, H)) :=
  QuotientGroup(G, group_kernel(G, H, h), group_kernel_normal(G, H, h));

def ImageGroup(G, H : Group, h : GroupHom(G, H)) := subgroup_as_group(H, group_image(G, H, h));

def kernel_image_multiply_on_classes(G, H : Group, h : GroupHom(G, H), x, y : group_carrier(G)) :
  kernel_quotient_to_image(
    G, H, h,
    quotient_multiply(
      G, group_kernel(G, H, h), group_kernel_normal(G, H, h),
      left_coset(G, group_kernel(G, H, h), x), left_coset(G, group_kernel(G, H, h), y)
    )
  ) = group_multiply(
    ImageGroup(G, H, h), kernel_quotient_to_image(G, H, h, left_coset(G, group_kernel(G, H, h), x)),
    kernel_quotient_to_image(G, H, h, left_coset(G, group_kernel(G, H, h), y))
  ) {
  let out := kernel_quotient_to_image(G, H, h);
  let f := group_image_map(G, H, h);
  let m := group_multiply(ImageGroup(G, H, h));
  exact with unfolding [left_coset, group_image_map, ImageGroup] {
    trans(
      cong(
        out, quotient_multiply_beta(G, group_kernel(G, H, h), group_kernel_normal(G, H, h), x, y)
      ),
      trans(
        kernel_quotient_to_image_beta(G, H, h, group_multiply(G, x, y)),
        trans(
          group_hom_multiply(G, ImageGroup(G, H, h), group_image_factor(G, H, h), x, y),
          trans(
            cong(
              (fun (a : GroupImageCarrier(G, H, h)) => m(a, f(y))),
              sym(kernel_quotient_to_image_beta(G, H, h, x))
            ),
            cong(
              m(out(left_coset(G, group_kernel(G, H, h), x))),
              sym(kernel_quotient_to_image_beta(G, H, h, y))
            )
          )
        )
      )
    )
  };
}

// Multiplicativity is proved for arbitrary cosets by propositional induction.
def kernel_quotient_image_multiply(G, H : Group, h : GroupHom(G, H), q, r : KernelQuotient(G, H, h)) :
  kernel_quotient_to_image(
    G, H, h, quotient_multiply(G, group_kernel(G, H, h), group_kernel_normal(G, H, h), q, r)
  ) = group_multiply(
    ImageGroup(G, H, h), kernel_quotient_to_image(G, H, h, q), kernel_quotient_to_image(G, H, h, r)
  ) {
  let Q := KernelQuotient(G, H, h);
  let out := kernel_quotient_to_image(G, H, h);
  let m := quotient_multiply(G, group_kernel(G, H, h), group_kernel_normal(G, H, h));
  let product := group_multiply(ImageGroup(G, H, h));
  exact with unfolding [left_coset] {
    quotient_induction_prop2(
      group_carrier(G), SameLeftCoset(G, group_kernel(G, H, h)),
      (fun (q, r : Q) => out(m(q, r)) = product(out(q), out(r))),
      (fun (q, r : Q) => group_is_set(ImageGroup(G, H, h), out(m(q, r)), product(out(q), out(r)))),
      kernel_image_multiply_on_classes(G, H, h), q, r
    )
  };
}

// First group isomorphism theorem: G / ker(h) is isomorphic to im(h).
// The image is repackaged in U1, without resizing the quotient or choosing representatives.
def group_first_isomorphism(G, H : Group, h : GroupHom(G, H)) :
  GroupIsoAt(U1, KernelQuotientGroup(G, H, h), group_lift(ImageGroup(G, H, h))) {
  exact with unfolding [KernelQuotientGroup, QuotientGroup, group_lift] {
    group_iso_object_at(
      U1, KernelQuotient(G, H, h), left_coset(G, group_kernel(G, H, h), group_unit(G)),
      quotient_multiply(G, group_kernel(G, H, h), group_kernel_normal(G, H, h)),
      quotient_group_laws(G, group_kernel(G, H, h), group_kernel_normal(G, H, h)),
      group_carrier(ImageGroup(G, H, h)), group_unit(ImageGroup(G, H, h)),
      group_multiply(ImageGroup(G, H, h)), group_laws(ImageGroup(G, H, h)),
      kernel_quotient_to_image(G, H, h), image_to_kernel_quotient(G, H, h),
      kernel_quotient_image_left(G, H, h), kernel_quotient_image_right(G, H, h),
      kernel_quotient_image_multiply(G, H, h)
    )
  };
}
