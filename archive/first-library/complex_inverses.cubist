import complex_algebra;
import ordered_squares;
import complex_norm_coordinates;

// Positive squared norm is constructive apartness from zero. Negated equality
// is a different notion; no conversion from it is assumed in this module.
def ComplexApartZero(F : U1, zero : F, addF, mulF : F -> F -> F, lt : F -> F -> U0, z : Complex(F)) :=
  lt(zero, complex_norm_squared(F, addF, mulF, z));

def ComplexUnit(F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, z : Complex(F)) :=
  exists w : Complex(F). complex_mul(F, addF, mulF, negF, z, w) = complex_one(F, zero, one);

def complex_norm_multiplicative(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), z, w : Complex(F)
) :
  complex_norm_squared(F, addF, mulF, complex_mul(F, addF, mulF, negF, z, w)) = mulF(
    complex_norm_squared(F, addF, mulF, z), complex_norm_squared(F, addF, mulF, w)
  ) {
  exact complex_coordinate_norm_product(
    F, zero, one, addF, mulF, negF, ring, complex_real(F, z), complex_imag(F, z),
    complex_real(F, w), complex_imag(F, w)
  );
}

def complex_norm_one(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF)
) :
  complex_norm_squared(F, addF, mulF, complex_one(F, zero, one)) = one {
  exact complex_coordinate_norm_one(F, zero, one, addF, mulF, negF, ring);
}

def complex_norm_nonnegative(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), z : Complex(F)
) :
  FieldLe(F, lt, zero, complex_norm_squared(F, addF, mulF, z)) {
  exact ordered_sum_nonnegative(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic,
    mulF(complex_real(F, z), complex_real(F, z)), mulF(complex_imag(F, z), complex_imag(F, z)),
    ordered_square_nonnegative(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, complex_real(F, z)
    ),
    ordered_square_nonnegative(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, complex_imag(F, z)
    )
  );
}

def complex_apart_from_real(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), z : Complex(F),
  apartReal : FieldApart(F, lt, complex_real(F, z), zero)
) :
  ComplexApartZero(F, zero, addF, mulF, lt, z) {
  exact ordered_positive_plus_nonnegative(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic,
    mulF(complex_real(F, z), complex_real(F, z)), mulF(complex_imag(F, z), complex_imag(F, z)),
    ordered_square_of_apart(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, complex_real(F, z), apartReal
    ),
    ordered_square_nonnegative(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, complex_imag(F, z)
    )
  );
}

def complex_apart_from_imag(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), z : Complex(F),
  apartImag : FieldApart(F, lt, complex_imag(F, z), zero)
) :
  ComplexApartZero(F, zero, addF, mulF, lt, z) {
  let positive :=
    ordered_positive_plus_nonnegative(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic,
      mulF(complex_imag(F, z), complex_imag(F, z)), mulF(complex_real(F, z), complex_real(F, z)),
      ordered_square_of_apart(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, complex_imag(F, z), apartImag
      ),
      ordered_square_nonnegative(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, complex_real(F, z)
      )
    );
  exact along lt(zero) by ring_add_comm(
    F, zero, one, addF, mulF, negF, ring, mulF(complex_imag(F, z), complex_imag(F, z)),
    mulF(complex_real(F, z), complex_real(F, z))
  ) from positive;
}

def complex_apart_inverse(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  inverses : FieldInverses(F, zero, one, mulF, lt), z : Complex(F),
  positiveNorm : ComplexApartZero(F, zero, addF, mulF, lt, z)
) :
  ComplexUnit(F, zero, one, addF, mulF, negF, z) {
  let squaredNorm := complex_norm_squared(F, addF, mulF, z);
  obtain (forward, backward) := inverses(squaredNorm);
  let apartNorm :=
    field_exists_intro(
      (lt(squaredNorm, zero) or lt(zero, squaredNorm)),
      typed((lt(squaredNorm, zero) or lt(zero, squaredNorm)), right(positiveNorm))
    );
  have scalarInverse : exists v : F. mulF(squaredNorm, v) = one := forward(apartNorm);
  obtain (reciprocal, normLaw) := scalarInverse;
  exact complex_inverse_from_norm(F, zero, one, addF, mulF, negF, ring, z, reciprocal, normLaw);
}

def complex_inverse_apart(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  inverses : FieldInverses(F, zero, one, mulF, lt), z : Complex(F),
  inverseWitness : ComplexUnit(F, zero, one, addF, mulF, negF, z)
) :
  ComplexApartZero(F, zero, addF, mulF, lt, z) {
  obtain (w, productLaw) := inverseWitness;
  let squaredNorm := complex_norm_squared(F, addF, mulF, z);
  have normLaw : mulF(squaredNorm, complex_norm_squared(F, addF, mulF, w)) = one := trans(
    sym(complex_norm_multiplicative(F, zero, one, addF, mulF, negF, ring, z, w)),
    trans(
      cong(complex_norm_squared(F, addF, mulF), productLaw),
      complex_norm_one(F, zero, one, addF, mulF, negF, ring)
    )
  );
  obtain (forward, backward) := inverses(squaredNorm);
  let apartNorm :=
    backward(
      typed(
        (exists v : F. mulF(squaredNorm, v) = one),
        (complex_norm_squared(F, addF, mulF, w), normLaw)
      )
    );
  let nonnegativeNorm :=
    complex_norm_nonnegative(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, z);
  obtain (prop, irreflexive, transitive, cotransitive, antisymmetric) := order;
  exact field_exists_elim(
    (lt(squaredNorm, zero) or lt(zero, squaredNorm)), lt(zero, squaredNorm),
    prop(zero, squaredNorm),
    (
      fun (side : lt(squaredNorm, zero) or lt(zero, squaredNorm)) => match side return lt(
        zero, squaredNorm
      ) {
        left negative => absurd(nonnegativeNorm(negative));
        right positive => positive;
      }
    ), apartNorm
  );
}

def complex_units_iff_apart(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  inverses : FieldInverses(F, zero, one, mulF, lt), z : Complex(F)
) :
  FieldIff(
    ComplexApartZero(F, zero, addF, mulF, lt, z), ComplexUnit(F, zero, one, addF, mulF, negF, z)
  ) {
  exact (
    complex_apart_inverse(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, z),
    complex_inverse_apart(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, z)
  );
}

// Tightness of the scalar order: failure of positive apartness gives equality.
def ordered_not_apart_zero(
  F : U1, zero : F, lt : F -> F -> U0, order : StrictOrder(F, lt), x : F,
  notApart : FieldApart(F, lt, x, zero) -> Void
) :
  x = zero {
  obtain (prop, irreflexive, transitive, cotransitive, antisymmetric) := order;
  exact antisymmetric(
    x, zero,
    (
      fun (positive : lt(zero, x)) => notApart(
        field_exists_intro(
          (lt(x, zero) or lt(zero, x)), typed((lt(x, zero) or lt(zero, x)), right(positive))
        )
      )
    ),
    (
      fun (negative : lt(x, zero)) => notApart(
        field_exists_intro(
          (lt(x, zero) or lt(zero, x)), typed((lt(x, zero) or lt(zero, x)), left(negative))
        )
      )
    )
  );
}

def complex_apart_tight(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), z : Complex(F),
  notApart : ComplexApartZero(F, zero, addF, mulF, lt, z) -> Void
) :
  z = complex_zero(F, zero) {
  let realZero :=
    ordered_not_apart_zero(
      F, zero, lt, order, complex_real(F, z),
      (
        fun (apartReal : FieldApart(F, lt, complex_real(F, z), zero)) => notApart(
          complex_apart_from_real(
            F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, z, apartReal
          )
        )
      )
    );
  let imagZero :=
    ordered_not_apart_zero(
      F, zero, lt, order, complex_imag(F, z),
      (
        fun (apartImag : FieldApart(F, lt, complex_imag(F, z), zero)) => notApart(
          complex_apart_from_imag(
            F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, z, apartImag
          )
        )
      )
    );
  exact field_pair_path(F, F, z, complex_zero(F, zero), realZero, imagZero);
}

// Directly usable with each future real-field construction. Neither
// completeness nor classical logic is required by this algebraic result.
def complex_ordered_field_inverses(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, minF, maxF : F -> F -> F, lt : F -> F
  -> U0, field : OrderedField(F, zero, one, addF, mulF, negF, minF, maxF, lt), z : Complex(F)
) :
  FieldIff(
    ComplexApartZero(F, zero, addF, mulF, lt, z), ComplexUnit(F, zero, one, addF, mulF, negF, z)
  ) {
  obtain (ring, order, lattice, arithmetic, inverses) := field;
  exact complex_units_iff_apart(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, z
  );
}
