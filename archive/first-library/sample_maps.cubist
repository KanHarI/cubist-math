import sample_chains;

// Map both kinds of finite sampling data, preserving their lengths.
def map_sample_vertices(C, D : U1, f : C -> D, n : Nat) :=
  induction n as k return (SampleVertices(C, k) -> SampleVertices(D, k)) {
    zero => f;
    succ previous => fun (vertices : SampleVertices(C, succ(k))) => typed(
      (D and SampleVertices(D, k)),
      (
        f(field_fst(C, SampleVertices(C, k), vertices)),
        previous(field_snd(C, SampleVertices(C, k), vertices))
      )
    );
  };

def map_sample_tags(C, D : U1, f : C -> D, n : Nat) :=
  induction n as k return (SampleTags(C, k) -> SampleTags(D, k)) {
    zero => fun (tags : Unit) => tags;
    succ previous => fun (tags : SampleTags(C, succ(k))) => typed(
      (D and SampleTags(D, k)),
      (f(field_fst(C, SampleTags(C, k), tags)), previous(field_snd(C, SampleTags(C, k), tags)))
    );
  };

def map_sample_first(C, D : U1, f : C -> D, n : Nat) :
  forall vertices : SampleVertices(C, n).
  sample_first(D, n, map_sample_vertices(C, D, f, n, vertices)) = f(sample_first(C, n, vertices)) {
  exact induction n as k return (
    forall vertices : SampleVertices(C, k).
    sample_first(D, k, map_sample_vertices(C, D, f, k, vertices)) = f(sample_first(C, k, vertices))
  ) {
    zero => fun (vertices : C) => refl(f(vertices));
    succ previous => fun (vertices : SampleVertices(C, succ(k))) => refl(
      f(field_fst(C, SampleVertices(C, k), vertices))
    );
  };
}

def map_sample_last(C, D : U1, f : C -> D, n : Nat) :
  forall vertices : SampleVertices(C, n).
  sample_last(D, n, map_sample_vertices(C, D, f, n, vertices)) = f(sample_last(C, n, vertices)) {
  exact induction n as k return (
    forall vertices : SampleVertices(C, k).
    sample_last(D, k, map_sample_vertices(C, D, f, k, vertices)) = f(sample_last(C, k, vertices))
  ) {
    zero => fun (vertices : C) => refl(f(vertices));
    succ previous => fun (vertices : SampleVertices(C, succ(k))) => previous(
      field_snd(C, SampleVertices(C, k), vertices)
    );
  };
}

// Sampling after a map agrees with evaluating the pulled-back edge formula.
def map_sample_sum(
  C, D : U1, f : C -> D, G : U1, zero : G, addG : G -> G -> G, edge : D -> D -> D -> G, n : Nat
) :
  forall vertices : SampleVertices(C, n). forall tags : SampleTags(C, n).
  sample_sum(
    D, G, zero, addG, edge, n, map_sample_vertices(C, D, f, n, vertices),
    map_sample_tags(C, D, f, n, tags)
  ) = sample_sum(
    C, G, zero, addG, (fun (a, b, tag : C) => edge(f(a), f(b), f(tag))), n, vertices, tags
  ) {
  exact induction n as k return (
    forall vertices : SampleVertices(C, k). forall tags : SampleTags(C, k).
    sample_sum(
      D, G, zero, addG, edge, k, map_sample_vertices(C, D, f, k, vertices),
      map_sample_tags(C, D, f, k, tags)
    ) = sample_sum(
      C, G, zero, addG, (fun (a, b, tag : C) => edge(f(a), f(b), f(tag))), k, vertices, tags
    )
  ) {
    zero => fun (vertices : C, tags : Unit) => refl(zero);
    succ previous => fun (vertices : SampleVertices(C, succ(k)), tags : SampleTags(C, succ(k))) => trans(
      cong(
        (
          fun (v : D) => addG(
            edge(
              f(field_fst(C, SampleVertices(C, k), vertices)), v,
              f(field_fst(C, SampleTags(C, k), tags))
            ),
            sample_sum(
              D, G, zero, addG, edge, k,
              map_sample_vertices(C, D, f, k, field_snd(C, SampleVertices(C, k), vertices)),
              map_sample_tags(C, D, f, k, field_snd(C, SampleTags(C, k), tags))
            )
          )
        ), map_sample_first(C, D, f, k, field_snd(C, SampleVertices(C, k), vertices))
      ),
      cong(
        addG(
          edge(
            f(field_fst(C, SampleVertices(C, k), vertices)),
            f(sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices))),
            f(field_fst(C, SampleTags(C, k), tags))
          )
        ),
        previous(field_snd(C, SampleVertices(C, k), vertices), field_snd(C, SampleTags(C, k), tags))
      )
    );
  };
}
