import interval_subdivisions;
import ordered_halves;

// If a + increment = b, the oriented difference from a to b is increment.
def difference_from_increment(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), a b increment : F,
  sums : addF(a, increment) = b
) :
  coordinate_difference(F, addF, negF, a, b) = increment {
  exact trans(
    cong((fun (v : F) => addF(v, negF(a))), sym(sums)),
    trans(
      cong(
        (fun (v : F) => addF(v, negF(a))),
        ring_add_comm(F, zero, one, addF, mulF, negF, ring, a, increment)
      ),
      trans(
        ring_add_assoc(F, zero, one, addF, mulF, negF, ring, increment, a, negF(a)),
        trans(
          cong(addF(increment), ring_add_inverse_right(F, zero, one, addF, mulF, negF, ring, a)),
          ring_add_zero_right(F, zero, one, addF, mulF, negF, ring, increment)
        )
      )
    )
  );
}

// A weakly nonnegative quantity has a weakly nonnegative half, including
// zero-width intervals. No decision whether that width is zero is required.
def nonnegative_half_from_sum(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), epsilon half : F,
  sum : addF(half, half) = epsilon, nonnegativeEpsilon : FieldLe(F, lt, zero, epsilon)
) :
  FieldLe(F, lt, zero, half) {
  obtain (prop, irreflexive, transitive, cotransitive, antisymmetric) = order;
  obtain (positiveOne, translate, scale, weakScale, ltLe, leLt, splitPositive) = arithmetic;
  intro belowZero;
  obtain (forward, backward) = translate(half, zero, half);
  let belowHalf =
    along lt(addF(half, half)) by ring_add_zero(F, zero, one, addF, mulF, negF, ring, half) from forward(
      belowZero
    );
  let sumNegative = transitive(addF(half, half), half, zero, belowHalf, belowZero);
  exact nonnegativeEpsilon(along((fun (v : F) => lt(v, zero))) by sum from sumNegative);
}

// Construct a midpoint in the interval subtype, with proofs that both
// subinterval widths are the prescribed half of the original width.
def interval_midpoint(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), half : F -> F,
  halfSum : (forall x : F, addF(half(x), half(x)) = x), a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  )
) :
  exists midpoint : FieldUnitInterval(F, zero, one, lt),
  IntervalTagWithin(F, zero, one, lt, a, b, midpoint)
  and (
    interval_difference(F, zero, one, addF, negF, lt)(a, midpoint) = half(
      interval_difference(F, zero, one, addF, negF, lt)(a, b)
    )
  )
  and (
    interval_difference(F, zero, one, addF, negF, lt)(midpoint, b) = half(
      interval_difference(F, zero, one, addF, negF, lt)(a, b)
    )
  ) {
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  let x = coordinate(a);
  let y = coordinate(b);
  let width = coordinate_difference(F, addF, negF, x, y);
  let h = half(width);
  let m = addF(x, h);
  let nonnegativeWidth =
    field_difference_nonnegative(
      F, zero, one, addF, mulF, negF, lt, ring, arithmetic, x, y, ordered
    );
  let nonnegativeHalf =
    nonnegative_half_from_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, width, h, halfSum(width),
      nonnegativeWidth
    );
  let leftBound =
    order_le_add_nonnegative(
      F, zero, one, addF, mulF, negF, lt, ring, arithmetic, x, h, nonnegativeHalf
    );
  have completes : addF(m, h) = y := trans(
    ring_add_assoc(F, zero, one, addF, mulF, negF, ring, x, h, h),
    trans(
      cong(addF(x), halfSum(width)), difference_add_back(F, zero, one, addF, mulF, negF, ring, x, y)
    )
  );
  let rightBound =
    along FieldLe(F, lt, m) by completes from order_le_add_nonnegative(
      F, zero, one, addF, mulF, negF, lt, ring, arithmetic, m, h, nonnegativeHalf
    );
  obtain (lowerA, upperA) = field_interval_bounds(F, zero, one, lt, a);
  obtain (lowerB, upperB) = field_interval_bounds(F, zero, one, lt, b);
  have midpoint : FieldUnitInterval(F, zero, one, lt) := (
    m, order_le_trans(F, zero, one, addF, mulF, lt, arithmetic, zero, x, m, lowerA, leftBound),
    order_le_trans(F, zero, one, addF, mulF, lt, arithmetic, m, y, one, rightBound, upperB)
  );
  exact (
    midpoint, (leftBound, rightBound),
    difference_from_increment(F, zero, one, addF, mulF, negF, ring, x, m, h, refl(m)),
    difference_from_increment(F, zero, one, addF, mulF, negF, ring, m, y, h, completes)
  );
}

// The concrete two-edge subdivision uses left endpoint tags.
def two_edge_subdivision(C : U1, a midpoint b : C) : SampleSubdivision(C, a, b) {
  exact (
    2, typed((C and C and C), (a, midpoint, b)), typed((C and C and Unit), (a, midpoint, tt)),
    refl(a), refl(b)
  );
}

def two_edge_subdivision_admissible(
  F : U1, zero one : F, lt : F -> F -> U0, order : StrictOrder(F, lt),
  a midpoint b : FieldUnitInterval(F, zero, one, lt),
  within : IntervalTagWithin(F, zero, one, lt, a, b, midpoint)
) :
  IntervalAdmissibleTags(
    F, zero, one, lt, 2,
    subdivision_vertices(
      FieldUnitInterval(F, zero, one, lt), a, b,
      two_edge_subdivision(FieldUnitInterval(F, zero, one, lt), a, midpoint, b)
    ),
    subdivision_tags(
      FieldUnitInterval(F, zero, one, lt), a, b,
      two_edge_subdivision(FieldUnitInterval(F, zero, one, lt), a, midpoint, b)
    )
  ) {
  obtain (leftBound, rightBound) = within;
  exact typed(
    (
      IntervalTagWithin(F, zero, one, lt, a, midpoint, a)
      and IntervalTagWithin(F, zero, one, lt, midpoint, b, midpoint) and Unit
    ),
    (
      (order_le_refl(F, lt, order, field_interval_coordinate(F, zero, one, lt)(a)), leftBound),
      (
        order_le_refl(F, lt, order, field_interval_coordinate(F, zero, one, lt)(midpoint)),
        rightBound
      ), tt
    )
  );
}

// Supply the halving operation from the ordered field itself, then construct
// both admissible samples. This requires no midpoint or sampling oracle.
def ordered_interval_bisection(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  inverses : FieldInverses(F, zero, one, mulF, lt), a b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt, a),
    field_interval_coordinate(F, zero, one, lt, b)
  )
) :
  exists midpoint : FieldUnitInterval(F, zero, one, lt),
  IntervalTagWithin(F, zero, one, lt, a, b, midpoint)
  and (
    interval_difference(F, zero, one, addF, negF, lt, a, midpoint) = interval_difference(
      F, zero, one, addF, negF, lt, midpoint, b
    )
  )
  and IntervalAdmissibleTags(
    F, zero, one, lt, 2,
    subdivision_vertices(
      FieldUnitInterval(F, zero, one, lt), a, b,
      two_edge_subdivision(FieldUnitInterval(F, zero, one, lt), a, midpoint, b)
    ),
    subdivision_tags(
      FieldUnitInterval(F, zero, one, lt), a, b,
      two_edge_subdivision(FieldUnitInterval(F, zero, one, lt), a, midpoint, b)
    )
  ) {
  obtain (half, halfSum, halfPositive) = ordered_field_halving(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses
  );
  obtain (midpoint, within, leftWidth, rightWidth) = interval_midpoint(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, a, b, ordered
  );
  exact (
    midpoint, within, trans(leftWidth, sym(rightWidth)),
    two_edge_subdivision_admissible(F, zero, one, lt, order, a, midpoint, b, within)
  );
}
