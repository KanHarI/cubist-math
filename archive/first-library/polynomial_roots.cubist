import polynomial_evaluation;
import polynomial_leading;

// Roots may live in an arbitrary extension through its specified embedding.
def PolynomialRoot(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K), x : af_carrier(L)
) :=
  polynomial_eval(K, L, e, p, x) = field_zero(L);

def polynomial_root_prop(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K), x : af_carrier(L)
) :=
  af_set(L, polynomial_eval(K, L, e, p, x), field_zero(L));

def polynomial_eval_one(K, L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L)) :
  polynomial_eval(K, L, e, polynomial_one(K), x) = field_one(L) {
  obtain (zero, one, neg, add, mul) := field_embedding_preserves(K, L, e);
  exact trans(polynomial_eval_constant(K, L, e, field_one(K), x), one);
}

def polynomial_eval_variable(K, L : AlgebraicField, e : FieldEmbedding(K, L), x : af_carrier(L)) :
  polynomial_eval(K, L, e, polynomial_variable(K), x) = x {
  exact trans(
    polynomial_eval_shift(K, L, e, polynomial_one(K), x),
    trans(cong(field_mul(L, x), polynomial_eval_one(K, L, e, x)), scalar_mul_one_right(L, x))
  );
}

def polynomial_eval_neg(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), p : Polynomial(K), x : af_carrier(L)
) :
  polynomial_eval(K, L, e, polynomial_neg(K, p), x) = field_neg(L, polynomial_eval(K, L, e, p, x)) {
  let E := fun (q : Polynomial(K)) => polynomial_eval(K, L, e, q, x);
  have inverse : field_add(L, E(polynomial_neg(K, p)), E(p)) = field_zero(L) := with unfolding [] {
    trans(
      sym(polynomial_eval_add(K, L, e, polynomial_neg(K, p), p, x)),
      trans(cong(E, polynomial_add_inverse(K, p)), polynomial_eval_zero(K, L, e, x))
    )
  };
  exact group_inverse_unique(
    af_carrier(L), field_zero(L), field_add(L), group_laws(FieldAdditiveGroup(L)), E(p),
    E(polynomial_neg(K, p)), field_neg(L, E(p)), inverse, scalar_add_inverse_right(L, E(p))
  );
}

def polynomial_linear_factor(K : AlgebraicField, r : af_carrier(K)) :=
  polynomial_add(K, polynomial_variable(K), polynomial_constant(K, field_neg(K, r)));

def linear_factor_support(K : AlgebraicField, r : af_carrier(K)) :
  SeriesSupport(K, polynomial_coefficients(K, polynomial_linear_factor(K, r)), 2) {
  exact support_add_same(
    K, polynomial_coefficients(K, polynomial_variable(K)), series_constant(K, field_neg(K, r)), 2,
    support_shift(K, series_constant(K, field_one(K)), 1, support_constant(K, field_one(K))),
    support_weaken(
      K, series_constant(K, field_neg(K, r)), 1, 2, tt, support_constant(K, field_neg(K, r))
    )
  );
}

def linear_factor_degree(K : AlgebraicField, r : af_carrier(K)) :
  polynomial_cutoff(K, polynomial_linear_factor(K, r)) = 2 {
  obtain (ring, nontrivial, inverses) := af_laws(K);
  exact polynomial_cutoff_exact(
    K, polynomial_linear_factor(K, r), 1, linear_factor_support(K, r),
    (
      fun (zero : polynomial_coefficients(K, polynomial_linear_factor(K, r), 1) = field_zero(K)) => nontrivial(
        trans(sym(scalar_add_zero_right(K, field_one(K))), zero)
      )
    )
  );
}

def linear_factor_nonzero(
  K : AlgebraicField, r : af_carrier(K), zero : polynomial_linear_factor(K, r) = polynomial_zero(K)
) :
  Void {
  exact nat_zero_ne_succ(
    1,
    sym(
      trans(
        sym(linear_factor_degree(K, r)),
        trans(cong(polynomial_cutoff(K), zero), polynomial_zero_cutoff(K))
      )
    )
  );
}

def linear_factor_eval(K : AlgebraicField, r, x : af_carrier(K)) :
  polynomial_eval(K, K, field_embedding_identity(K), polynomial_linear_factor(K, r), x) = field_add(
    K, x, field_neg(K, r)
  ) {
  let e := field_embedding_identity(K);
  let E := fun (p : Polynomial(K)) => polynomial_eval(K, K, e, p, x);
  exact with unfolding [] {
    trans(
      polynomial_eval_add(
        K, K, e, polynomial_variable(K), polynomial_constant(K, field_neg(K, r)), x
      ),
      trans(
        cong(
          (fun (a : af_carrier(K)) => field_add(K, a, E(polynomial_constant(K, field_neg(K, r))))),
          polynomial_eval_variable(K, K, e, x)
        ), cong(field_add(K, x), polynomial_eval_constant(K, K, e, field_neg(K, r), x))
      )
    )
  };
}

def linear_factor_root(K : AlgebraicField, r : af_carrier(K)) :
  PolynomialRoot(K, K, field_embedding_identity(K), polynomial_linear_factor(K, r), r) {
  exact trans(linear_factor_eval(K, r, r), scalar_add_inverse_right(K, r));
}

def support_one_eval(
  K : AlgebraicField, p : Polynomial(K),
  support : SeriesSupport(K, polynomial_coefficients(K, p), 1), x : af_carrier(K)
) :
  polynomial_eval(K, K, field_embedding_identity(K), p, x) = polynomial_coefficients(K, p, 0) {
  exact trans(
    polynomial_eval_bound(K, K, field_embedding_identity(K), p, x, 1, support),
    trans(
      cong(field_add(K, polynomial_coefficients(K, p, 0)), scalar_mul_zero(K, x)),
      scalar_add_zero_right(K, polynomial_coefficients(K, p, 0))
    )
  );
}

// The factor theorem is an equality of formal polynomials, not only of
// their values. The quotient is obtained by the checked division algorithm.
def polynomial_factor_theorem(
  K : AlgebraicField, p : Polynomial(K), r : af_carrier(K),
  root : PolynomialRoot(K, K, field_embedding_identity(K), p, r)
) :
  exists q : Polynomial(K). p = polynomial_mul(K, polynomial_linear_factor(K, r), q) {
  let factor := polynomial_linear_factor(K, r);
  let e := field_embedding_identity(K);
  let E := fun (s : Polynomial(K)) => polynomial_eval(K, K, e, s, r);
  obtain (q, s, equation, support) := divide_by_degree(K, p, factor, 1, linear_factor_degree(K, r));
  have evaluated : E(p) = E(s) := with unfolding [] {
    trans(
      cong(E, equation),
      trans(
        polynomial_eval_add(K, K, e, polynomial_mul(K, q, factor), s, r),
        trans(
          cong(
            (fun (a : af_carrier(K)) => field_add(K, a, E(s))),
            polynomial_eval_mul(K, K, e, q, factor, r)
          ),
          trans(
            cong(
              (fun (a : af_carrier(K)) => field_add(K, field_mul(K, E(q), a), E(s))),
              linear_factor_root(K, r)
            ),
            trans(
              cong((fun (a : af_carrier(K)) => field_add(K, a, E(s))), scalar_mul_zero(K, E(q))),
              scalar_add_zero(K, E(s))
            )
          )
        )
      )
    )
  };
  have constantZero : polynomial_coefficients(K, s, 0) = field_zero(K) := trans(
    sym(support_one_eval(K, s, support, r)), trans(sym(evaluated), root)
  );
  let zero :=
    support_zero_polynomial(
      K, s, support_predecessor(K, polynomial_coefficients(K, s), 0, support, constantZero)
    );
  exact (
    q,
    trans(
      equation,
      trans(
        cong(polynomial_add(K, polynomial_mul(K, q, factor)), zero),
        trans(
          polynomial_add_zero_right(K, polynomial_mul(K, q, factor)),
          polynomial_mul_comm(K, q, factor)
        )
      )
    )
  );
}

def polynomial_factor_root(
  K : AlgebraicField, p : Polynomial(K), r : af_carrier(K), q : Polynomial(K),
  factor : p = polynomial_mul(K, polynomial_linear_factor(K, r), q)
) :
  PolynomialRoot(K, K, field_embedding_identity(K), p, r) {
  let e := field_embedding_identity(K);
  let E := fun (s : Polynomial(K)) => polynomial_eval(K, K, e, s, r);
  exact with unfolding [] {
    trans(
      cong(E, factor),
      trans(
        polynomial_eval_mul(K, K, e, polynomial_linear_factor(K, r), q, r),
        trans(
          cong((fun (a : af_carrier(K)) => field_mul(K, a, E(q))), linear_factor_root(K, r)),
          scalar_zero_mul(K, E(q))
        )
      )
    )
  };
}
