import span_exchange;
import finite_omission;
import independent_order;
import classical;

// Adjoining one vector gives a proposition-valued subset. Membership is
// truncated; it does not expose a chosen side of the disjunction.
def AdjoinVector(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, x y : vector_carrier(K, V)
) =
  Truncate(U0, P(y) or (y = x));

def adjoin_vector_prop(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, x y : vector_carrier(K, V)
) =
  TruncateProp(U0, P(y) or (y = x));

def adjoin_vector_old(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  x y : vector_carrier(K, V), member : P(y)
) :
  AdjoinVector(K, V, P, x, y) {
  exact TruncateIntro(U0, P(y) or (y = x), left(member));
}

def adjoin_vector_new(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, x : vector_carrier(K, V)
) :
  AdjoinVector(K, V, P, x, x) {
  exact TruncateIntro(U0, P(x) or (x = x), right(refl(x)));
}

def adjoin_vector_other(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  prop : (forall y : vector_carrier(K, V), Proposition(P(y))), x y : vector_carrier(K, V),
  different : (y = x) -> Void, member : AdjoinVector(K, V, P, x, y)
) :
  P(y) {
  exact TruncateElim(
    U0, P(y) or (y = x), P(y), prop(y), (fun (side : P(y) or (y = x)) => match side return P(y) {
        left old => old;
        right same => absurd(different(same));
      }), member
  );
}

// Deleting a zero coefficient leaves a genuine shorter injective list of
// generators. Coverage restores the conclusion at every original index.
def independent_zero_omission(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  independent : LinearlyIndependent(K, V, P), n : Nat, v : Fin(succ(n)) -> vector_carrier(K, V),
  distinct : (forall i : Fin(succ(n)), forall j : Fin(succ(n)), v(i) = v(j) -> i = j),
  a : Fin(succ(n)) -> af_carrier(K), i : Fin(succ(n)),
  zero : a(i) = af_zero(af_carrier(K), af_operations(K)),
  others : (forall j : Fin(succ(n)), ((j = i) -> Void) -> P(v(j))),
  vanishes : linear_combination(K, V, succ(n), v, a) = vector_zero(K, V), j : Fin(succ(n))
) :
  a(j) = af_zero(af_carrier(K), af_operations(K)) {
  let X = vector_carrier(K, V);
  let omit = fin_omit(n, i);
  let rest = linear_remainder(K, V, succ(n), v, a, i);
  have headZero : vector_scale(K, V, a(i), v(i)) = vector_zero(K, V) := trans(
    cong((fun (b : af_carrier(K)) => vector_scale(K, V, b, v(i))), zero),
    vector_zero_scale(K, V, v(i))
  );
  have restZero : rest = vector_zero(K, V) := trans(
    sym(group_unit_left(vector_group(K, V), rest)),
    trans(
      cong((fun (z : X) => vector_add(K, V, z, rest)), sym(headZero)),
      trans(sym(linear_combination_split(K, V, succ(n), v, a, i)), vanishes)
    )
  );
  let omittedV = fun (t : Fin(n)) => v(omit(t));
  let omittedA = fun (t : Fin(n)) => a(omit(t));
  have omittedZero : forall t : Fin(n),
  omittedA(t) = af_zero(af_carrier(K), af_operations(K)) := independent(
    n, omittedV,
    (
      fun (s t : Fin(n)) (same : omittedV(s) = omittedV(t)) => fin_omit_injective(
        n, i, s, t, distinct(omit(s), omit(t), same)
      )
    ), (fun (t : Fin(n)) => others(omit(t), fin_omit_avoids(n, i, t))), omittedA,
    trans(linear_combination_omit(K, V, n, v, a, i), restZero)
  );
  cases fin_omit_cover(n, i, j) {
    left same => {
      exact trans(cong(a, same), zero);
    }
    right witness => {
      obtain (t, same) = witness;
      exact trans(sym(cong(a, same)), omittedZero(t));
    }
  }
}

// A vector outside the old span cannot have a nonzero coefficient in a
// dependence. Turning not-nonzero into zero uses the explicit LEM instance.
def outside_span_coefficient_zero(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, n : Nat, v : Fin(n)
  -> vector_carrier(K, V), a : Fin(n) -> af_carrier(K), i : Fin(n), outside : Span(K, V, P, v(i))
  -> Void, others : (forall j : Fin(n), ((j = i) -> Void) -> P(v(j))),
  vanishes : linear_combination(K, V, n, v, a) = vector_zero(K, V)
) :
  a(i) = af_zero(af_carrier(K), af_operations(K)) {
  exact double_negation(
    (a(i) = af_zero(af_carrier(K), af_operations(K))),
    af_set(K, a(i), af_zero(af_carrier(K), af_operations(K))),
    (
      fun (nonzero : FieldNonzero(af_carrier(K), af_operations(K), a(i))) => outside(
        nonzero_coefficient_in_span(K, V, P, n, v, a, i, others, nonzero, vanishes)
      )
    )
  );
}

def adjoin_dependence_at_new(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  prop : (forall y : vector_carrier(K, V), Proposition(P(y))),
  independent : LinearlyIndependent(K, V, P), x : vector_carrier(K, V), outside : Span(K, V, P, x)
  -> Void, n : Nat, v : Fin(succ(n)) -> vector_carrier(K, V),
  distinct : (forall i : Fin(succ(n)), forall j : Fin(succ(n)), v(i) = v(j) -> i = j),
  members : (forall i : Fin(succ(n)), AdjoinVector(K, V, P, x, v(i))), a : Fin(succ(n))
  -> af_carrier(K), vanishes : linear_combination(K, V, succ(n), v, a) = vector_zero(K, V),
  i : Fin(succ(n)), same : v(i) = x, j : Fin(succ(n))
) :
  a(j) = af_zero(af_carrier(K), af_operations(K)) {
  have others : forall t : Fin(succ(n)), ((t = i) -> Void) -> P(v(t)) {
    intro t different;
    exact adjoin_vector_other(
      K, V, P, prop, x, v(t),
      (fun (equal : v(t) = x) => different(distinct(t, i, trans(equal, sym(same))))), members(t)
    );
  }
  let outsideHere =
    fun (member : Span(K, V, P, v(i))) => outside(along Span(K, V, P) by same from member);
  exact independent_zero_omission(
    K, V, P, independent, n, v, distinct, a, i,
    outside_span_coefficient_zero(K, V, P, succ(n), v, a, i, outsideHere, others, vanishes), others,
    vanishes, j
  );
}

def adjoin_independent_step(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  prop : (forall y : vector_carrier(K, V), Proposition(P(y))),
  independent : LinearlyIndependent(K, V, P), x : vector_carrier(K, V), outside : Span(K, V, P, x)
  -> Void, n : Nat, v : Fin(succ(n)) -> vector_carrier(K, V),
  distinct : (forall i : Fin(succ(n)), forall j : Fin(succ(n)), v(i) = v(j) -> i = j),
  members : (forall i : Fin(succ(n)), AdjoinVector(K, V, P, x, v(i))), a : Fin(succ(n))
  -> af_carrier(K), vanishes : linear_combination(K, V, succ(n), v, a) = vector_zero(K, V),
  j : Fin(succ(n))
) :
  a(j) = af_zero(af_carrier(K), af_operations(K)) {
  let Occurs = exists i : Fin(succ(n)), v(i) = x;
  cases excluded_middle(Truncate(U0, Occurs), TruncateProp(U0, Occurs)) {
    left occurs => {
      have descend : Occurs -> (a(j) = af_zero(af_carrier(K), af_operations(K))) {
        intro witness;
        obtain (i, same) = witness;
        exact adjoin_dependence_at_new(
          K, V, P, prop, independent, x, outside, n, v, distinct, members, a, vanishes, i, same, j
        );
      }
      exact TruncateElim(
        U0, Occurs, (a(j) = af_zero(af_carrier(K), af_operations(K))),
        af_set(K, a(j), af_zero(af_carrier(K), af_operations(K))), descend, occurs
      );
    }
    right absent => {
      have oldMembers : forall i : Fin(succ(n)), P(v(i)) {
        intro i;
        exact adjoin_vector_other(
          K, V, P, prop, x, v(i),
          (fun (same : v(i) = x) => absent(TruncateIntro(U0, Occurs, (i, same)))), members(i)
        );
      }
      exact independent(succ(n), v, distinct, oldMembers, a, vanishes, j);
    }
  }
}

def adjoin_independent_finite(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  prop : (forall y : vector_carrier(K, V), Proposition(P(y))),
  independent : LinearlyIndependent(K, V, P), x : vector_carrier(K, V),
  outside : Span(K, V, P, x) -> Void, n : Nat
) =
  induction n as k return (
    forall v : Fin(k) -> vector_carrier(K, V),
    (forall i : Fin(k), forall j : Fin(k), v(i) = v(j) -> i = j)
    -> (forall i : Fin(k), AdjoinVector(K, V, P, x, v(i))) -> forall a : Fin(k) -> af_carrier(K),
    linear_combination(K, V, k, v, a) = vector_zero(K, V) -> forall i : Fin(k),
    a(i) = af_zero(af_carrier(K), af_operations(K))
  ) {
    zero => fun (v : Fin(0) -> vector_carrier(K, V)) (
      distinct : (forall i : Fin(0), forall j : Fin(0), v(i) = v(j) -> i = j)
    ) (members : (forall i : Fin(0), AdjoinVector(K, V, P, x, v(i)))) (a : Fin(0) -> af_carrier(K)) (
      vanishes : linear_combination(K, V, 0, v, a) = vector_zero(K, V)
    ) (i : Fin(0)) => typed((a(i) = af_zero(af_carrier(K), af_operations(K))), absurd(i));
    succ previous => adjoin_independent_step(K, V, P, prop, independent, x, outside, k);
  };

def adjoin_independent(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0,
  prop : (forall y : vector_carrier(K, V), Proposition(P(y))),
  independent : LinearlyIndependent(K, V, P), x : vector_carrier(K, V), outside : Span(K, V, P, x)
  -> Void
) :
  LinearlyIndependent(K, V, AdjoinVector(K, V, P, x)) {
  exact adjoin_independent_finite(K, V, P, prop, independent, x, outside);
}

def IndependentAdjoin(
  K : AlgebraicField, V : VectorSpace(K), S : IndependentSubset(K, V), x : vector_carrier(K, V),
  outside : Span(K, V, independent_members(K, V, S), x) -> Void
) :
  IndependentSubset(K, V) {
  let P = independent_members(K, V, S);
  exact (
    AdjoinVector(K, V, P, x), adjoin_vector_prop(K, V, P, x),
    adjoin_independent(K, V, P, independent_prop(K, V, S), independent_law(K, V, S), x, outside)
  );
}

// Maximality is an intermediate hypothesis here, not a replacement for the
// required derivation of Zorn from Choice in the final existence theorem.
def MaximalIndependent(K : AlgebraicField, V : VectorSpace(K), S : IndependentSubset(K, V)) =
  forall T : IndependentSubset(K, V), IndependentIncluded(K, V, S, T)
  -> IndependentIncluded(K, V, T, S);

def maximal_independent_spans(
  K : AlgebraicField, V : VectorSpace(K), S : IndependentSubset(K, V),
  maximal : MaximalIndependent(K, V, S)
) :
  Spans(K, V, independent_members(K, V, S)) {
  intro x;
  let P = independent_members(K, V, S);
  have contradiction : (Span(K, V, P, x) -> Void) -> Void {
    intro outside;
    let T = IndependentAdjoin(K, V, S, x, outside);
    let back = maximal(T, adjoin_vector_old(K, V, P, x));
    exact outside(span_generator(K, V, P, x, back(x, adjoin_vector_new(K, V, P, x))));
  }
  exact double_negation(Span(K, V, P, x), span_prop(K, V, P, x), contradiction);
}

def maximal_independent_basis(
  K : AlgebraicField, V : VectorSpace(K), S : IndependentSubset(K, V),
  maximal : MaximalIndependent(K, V, S)
) :
  VectorBasis(K, V) {
  exact (
    independent_members(K, V, S), independent_prop(K, V, S), independent_law(K, V, S),
    maximal_independent_spans(K, V, S, maximal)
  );
}
