import field_logic;
import bijection_equality;

// The predicate values are small, although the space of predicates is U1.
// Univalence and function extensionality are constructive assumptions here.
def field_prop_ext(P Q : U0, propP : FieldProp(P), propQ : FieldProp(Q), f : P -> Q, g : Q -> P) :
  P = Q {
  exact ua(
    U0, P, Q,
    bijection_equiv(
      P, Q, proposition_is_set(Q, propQ),
      typed(
        Bijection(P, Q),
        (f, g, (fun (p : P) => propP(g(f(p)), p)), (fun (q : Q) => propQ(f(g(q)), q)))
      )
    )
  );
}

def field_predicate_ext(
  A : U1, P Q : A -> U0, propP : (forall a : A, FieldProp(P(a))),
  propQ : (forall a : A, FieldProp(Q(a))), same : (forall a : A, FieldIff(P(a), Q(a)))
) :
  P = Q {
  ext a;
  exact field_prop_ext(
    P(a), Q(a), propP(a), propQ(a), field_fst(P(a) -> Q(a), Q(a) -> P(a), same(a)),
    field_snd(P(a) -> Q(a), Q(a) -> P(a), same(a))
  );
}

def field_subtype_ext(
  A : U1, P : A -> U1, prop : (forall a : A, FieldProp(P(a))), u v : (exists x : A, P(x)),
  p : field_first(A, P, u) = field_first(A, P, v)
) :
  u = v {
  have square : PathP(fun (i : Interval) => P(p @ i), field_second(A, P, u), field_second(A, P, v)) {
    over P along p by {
      exact prop(
        field_first(A, P, v), along P by p from field_second(A, P, u), field_second(A, P, v)
      );
    }
  }
  exact path i => (p @ i, square @ i);
}

def field_sigma_prop(
  A : U1, P : A -> U1, propA : FieldProp(A), propP : (forall a : A, FieldProp(P(a))),
  u v : (exists a : A, P(a))
) :
  u = v {
  exact field_subtype_ext(A, P, propP, u, v, propA(field_first(A, P, u), field_first(A, P, v)));
}
