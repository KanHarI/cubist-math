import dimension;
import scalar_restriction;

// The degree is the unique finite dimension of the extension as a vector
// space over its base. Infinite extensions are not assigned a default value.
def ExtensionDegree(K : AlgebraicField, E : FieldExt(K), n : Nat) :=
  HasDimension(K, ExtensionVectorSpace(K, E), n);

def FiniteExtension(K : AlgebraicField, E : FieldExt(K)) :=
  FiniteDimensional(K, ExtensionVectorSpace(K, E));

def extension_degree(K : AlgebraicField, E : FieldExt(K), finite : FiniteExtension(K, E)) :=
  dimension(K, ExtensionVectorSpace(K, E), finite);

def extension_degree_specification(
  K : AlgebraicField, E : FieldExt(K), finite : FiniteExtension(K, E)
) :=
  dimension_specification(K, ExtensionVectorSpace(K, E), finite);

def extension_degree_unique(
  K : AlgebraicField, E : FieldExt(K), m, n : Nat, first : ExtensionDegree(K, E, m),
  second : ExtensionDegree(K, E, n)
) :
  m = n {
  exact dimension_unique(K, ExtensionVectorSpace(K, E), m, n, first, second);
}

def finite_extension_prop(K : AlgebraicField, E : FieldExt(K)) :=
  finite_dimensional_prop(K, ExtensionVectorSpace(K, E));

def extension_degree_evidence_independent(
  K : AlgebraicField, E : FieldExt(K), first, second : FiniteExtension(K, E)
) :
  extension_degree(K, E, first) = extension_degree(K, E, second) {
  exact dimension_evidence_independent(K, ExtensionVectorSpace(K, E), first, second);
}

def finite_extension_basis(
  K : AlgebraicField, E : FieldExt(K), n : Nat, basis : ExtensionDegreeWitness(K, E, n)
) :
  FiniteExtension(K, E) {
  exact finite_dimensional_basis(K, ExtensionVectorSpace(K, E), n, basis);
}

def extension_degree_of_basis(
  K : AlgebraicField, E : FieldExt(K), finite : FiniteExtension(K, E), n : Nat,
  basis : ExtensionDegreeWitness(K, E, n)
) :
  extension_degree(K, E, finite) = n {
  exact dimension_of_basis(K, ExtensionVectorSpace(K, E), finite, n, basis);
}

def identity_extension_degree(K : AlgebraicField) :
  ExtensionDegree(K, embedding_as_extension(K, K, field_embedding_identity(K)), 1) {
  exact basis_has_dimension(K, ScalarSpace(K), 1, scalar_space_basis(K));
}

def identity_extension_finite(K : AlgebraicField) :
  FiniteExtension(K, embedding_as_extension(K, K, field_embedding_identity(K))) {
  exact (1, identity_extension_degree(K));
}

// The triangle is a path of embeddings. Transporting the product basis
// along that path handles a specified K -> M embedding coherently.
def field_tower_basis_triangle(
  K, L, M : AlgebraicField, e : FieldEmbedding(K, L), d : FieldEmbedding(L, M),
  c : FieldEmbedding(K, M), triangle : FieldTower(K, L, M, e, d, c), m, n : Nat,
  lower : FiniteBasis(K, field_vector_space(K, L, e), m),
  upper : FiniteBasis(L, field_vector_space(L, M, d), n)
) :
  FiniteBasis(K, field_vector_space(K, M, c), multiply_count(n, m)) {
  exact along(
    (
      fun (embedding : FieldEmbedding(K, M)) => FiniteBasis(
        K, field_vector_space(K, M, embedding), multiply_count(n, m)
      )
    )
  ) by triangle from field_tower_basis(K, L, M, e, d, m, n, lower, upper);
}

// The tower law first holds as a proposition about degrees. Truncated basis
// witnesses are eliminated only into this proposition; no basis is selected.
def extension_degree_tower(
  K, L, M : AlgebraicField, e : FieldEmbedding(K, L), d : FieldEmbedding(L, M),
  c : FieldEmbedding(K, M), triangle : FieldTower(K, L, M, e, d, c), m, n : Nat,
  lower : ExtensionDegree(K, embedding_as_extension(K, L, e), m),
  upper : ExtensionDegree(L, embedding_as_extension(L, M, d), n)
) :
  ExtensionDegree(K, embedding_as_extension(K, M, c), multiply_count(n, m)) {
  let Lower := field_vector_space(K, L, e);
  let Upper := field_vector_space(L, M, d);
  let Whole := field_vector_space(K, M, c);
  let Result := HasDimension(K, Whole, multiply_count(n, m));
  exact mere_eliminate(
    FiniteBasis(K, Lower, m), Result, has_dimension_prop(K, Whole, multiply_count(n, m)),
    (
      fun (b : FiniteBasis(K, Lower, m)) => mere_eliminate(
        FiniteBasis(L, Upper, n), Result, has_dimension_prop(K, Whole, multiply_count(n, m)),
        (
          fun (a : FiniteBasis(L, Upper, n)) => basis_has_dimension(
            K, Whole, multiply_count(n, m),
            field_tower_basis_triangle(K, L, M, e, d, c, triangle, m, n, b, a)
          )
        ), upper
      )
    ), lower
  );
}

def finite_extension_tower(
  K, L, M : AlgebraicField, e : FieldEmbedding(K, L), d : FieldEmbedding(L, M),
  c : FieldEmbedding(K, M), triangle : FieldTower(K, L, M, e, d, c),
  lower : FiniteExtension(K, embedding_as_extension(K, L, e)),
  upper : FiniteExtension(L, embedding_as_extension(L, M, d))
) :
  FiniteExtension(K, embedding_as_extension(K, M, c)) {
  let m := extension_degree(K, embedding_as_extension(K, L, e), lower);
  let n := extension_degree(L, embedding_as_extension(L, M, d), upper);
  exact (
    multiply_count(n, m),
    extension_degree_tower(
      K, L, M, e, d, c, triangle, m, n,
      extension_degree_specification(K, embedding_as_extension(K, L, e), lower),
      extension_degree_specification(L, embedding_as_extension(L, M, d), upper)
    )
  );
}

// [M:K] = [M:L] * [L:K], for any evidence that the three extensions are finite.
// In particular the evidence for M/K may be the one just constructed above.
def tower_law(
  K, L, M : AlgebraicField, e : FieldEmbedding(K, L), d : FieldEmbedding(L, M),
  c : FieldEmbedding(K, M), triangle : FieldTower(K, L, M, e, d, c),
  lower : FiniteExtension(K, embedding_as_extension(K, L, e)),
  upper : FiniteExtension(L, embedding_as_extension(L, M, d)),
  whole : FiniteExtension(K, embedding_as_extension(K, M, c))
) :
  extension_degree(K, embedding_as_extension(K, M, c), whole) = multiply_count(
    extension_degree(L, embedding_as_extension(L, M, d), upper),
    extension_degree(K, embedding_as_extension(K, L, e), lower)
  ) {
  let m := extension_degree(K, embedding_as_extension(K, L, e), lower);
  let n := extension_degree(L, embedding_as_extension(L, M, d), upper);
  exact extension_degree_unique(
    K, embedding_as_extension(K, M, c), extension_degree(K, embedding_as_extension(K, M, c), whole),
    multiply_count(n, m), extension_degree_specification(K, embedding_as_extension(K, M, c), whole),
    extension_degree_tower(
      K, L, M, e, d, c, triangle, m, n,
      extension_degree_specification(K, embedding_as_extension(K, L, e), lower),
      extension_degree_specification(L, embedding_as_extension(L, M, d), upper)
    )
  );
}

// Degree respects paths of complete extensions, including those obtained
// by univalence from an isomorphism over the base field.
def extension_degree_path(
  K : AlgebraicField, E, F : FieldExt(K), p : E =[FieldExt(K)] F, finiteE : FiniteExtension(K, E),
  finiteF : FiniteExtension(K, F)
) :
  extension_degree(K, E, finiteE) = extension_degree(K, F, finiteF) {
  exact dimension_path(
    K, ExtensionVectorSpace(K, E), ExtensionVectorSpace(K, F), cong(ExtensionVectorSpace(K), p),
    finiteE, finiteF
  );
}

// Univalence applies to the full extension structure, so this comparison
// preserves the distinguished embedding of the base field as well.
def extension_degree_iso(
  K : AlgebraicField, E, F : FieldExt(K), iso : ExtensionIso(K, E, F),
  finiteE : FiniteExtension(K, E), finiteF : FiniteExtension(K, F)
) :
  extension_degree(K, E, finiteE) = extension_degree(K, F, finiteF) {
  exact extension_degree_path(K, E, F, extension_iso_path(K, E, F, iso), finiteE, finiteF);
}

def finite_extension_iso(
  K : AlgebraicField, E, F : FieldExt(K), iso : ExtensionIso(K, E, F), finite : FiniteExtension(K, E)
) :
  FiniteExtension(K, F) {
  exact along FiniteExtension(K) by extension_iso_path(K, E, F, iso) from finite;
}

def field_embedding_linear(K, L : AlgebraicField, e : FieldEmbedding(K, L)) :
  LinearMap(K, ScalarSpace(K), field_vector_space(K, L, e)) {
  obtain (zero, one, neg, add, mul) := field_embedding_preserves(K, L, e);
  exact (field_embedding_map(K, L, e), add, mul);
}

def extension_basis_positive(
  K : AlgebraicField, E : FieldExt(K), n : Nat, basis : ExtensionDegreeWitness(K, E, n)
) :
  le(1, n) {
  let V := ExtensionVectorSpace(K, E);
  let L := extension_field(K, E);
  let e := extension_inclusion_embedding(K, E);
  let C := CoordinateSpace(K, 1);
  let N := CoordinateSpace(K, n);
  let scalar := basis_expansion(K, ScalarSpace(K), 1, scalar_space_basis(K));
  let embed := field_embedding_linear(K, L, e);
  let intoV := linear_compose(K, C, ScalarSpace(K), V, scalar, embed);
  let outV := basis_coordinates(K, V, n, basis);
  let h := linear_compose(K, C, V, N, intoV, outV);
  have injective : CoordinateInjection(K, 1, n, h) {
    intro x, y, same;
    let sameV :=
      linear_iso_injective(
        K, V, N, linear_iso_inverse(K, N, V, basis), linear_map(K, C, V, intoV, x),
        linear_map(K, C, V, intoV, y), same
      );
    let sameK :=
      field_embedding_injective(
        K, L, e, linear_map(K, C, ScalarSpace(K), scalar, x),
        linear_map(K, C, ScalarSpace(K), scalar, y), sameV
      );
    exact linear_iso_injective(K, C, ScalarSpace(K), scalar_space_basis(K), x, y, sameK);
  }
  exact coordinate_injection_bound(K, n, 1, h, injective);
}

def extension_dimension_not_zero(
  K : AlgebraicField, E : FieldExt(K), degree : ExtensionDegree(K, E, 0)
) :
  Void {
  exact mere_eliminate(
    ExtensionDegreeWitness(K, E, 0), Void, (fun (a, b : Void) => typed((a = b), absurd(a))),
    extension_basis_positive(K, E, 0), degree
  );
}
