import paths_;
import truncation;

// Carriers in U1 include proposition-valued Dedekind cuts over small Q.
// Universe arguments to the library's truncation remain explicit here.
def FieldProp(P : U1) := forall p : P. forall q : P. p = q;

def FieldSet(F : U1) := forall x : F. forall y : F. FieldProp(x = y);

def FieldExists(A : U1) := Trunc(U1, A);

def field_exists_intro(A : U1, a : A) := h1_truncation::merely(U1, A, a);

def field_exists_prop(A : U1) := h1_truncation::mere_is_prop(U1, A);

def field_exists_elim(A, P : U1, prop_ : FieldProp(P), f : A -> P) :=
  h1_truncation::mere_eliminate(U1, U1, A, P, prop_, f);

def field_exists_map(A, B : U1, f : A -> B, h : FieldExists(A)) := field_exists_elim(
  A, FieldExists(B), field_exists_prop(B), (fun (a : A) => field_exists_intro(B, f(a))), h
);

def FieldOr(P, Q : U1) := FieldExists(P or Q);

def FieldIff(P, Q : U1) := (P -> Q) and (Q -> P);

def field_first(A : U1, P : A -> U1, pair : (exists a : A. P(a))) :=
  unpack pair as (a, p) return A {
    a;
  };

def field_second(A : U1, P : A -> U1, pair : (exists a : A. P(a))) := pair_induction(
  (fun (v : (exists a : A. P(a))) => P(field_first(A, P, v))), (fun (a : A, p : P(a)) => p), pair
);

def field_fst(A, B : U1, pair : A and B) := field_first(A, (fun (a : A) => B), pair);

def field_snd(A, B : U1, pair : A and B) := field_second(A, (fun (a : A) => B), pair);

def field_forall_prop(
  A : U1, P : A -> U1, prop_ : (forall a : A. FieldProp(P(a))), f, g : (forall a : A. P(a))
) :=
  FunExt(U1, A, P, f, g, (fun (a : A) => prop_(a, f(a), g(a))));

def field_not_prop(A : U1, f, g : A -> Void) := FunExt(
  U1, A, (fun (a : A) => typed(U1, Void)), f, g, (fun (a : A) => typed((f(a) = g(a)), absurd(f(a))))
);

// Eliminate a small truncation into a proposition in U1: the library's
// elimination takes its motive from any universe, so nothing is resized.
// It requires proposition evidence; no witness is selected.
def small_mere_eliminate(A : U0, P : U1, prop_ : FieldProp(P), f : A -> P, h : Trunc(U0, A)) : P {
  exact h1_truncation::small_mere_eliminate(A, P, prop_, f, h);
}
