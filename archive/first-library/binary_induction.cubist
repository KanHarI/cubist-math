import binary_naturals;

// Dependent induction in the familiar one / even / odd presentation.
def binary_positive_induction(
  P : BinaryPositive -> U0, one : P(binary_one),
  even : (forall p : BinaryPositive. P(p) -> P(binary_bit0(p))),
  odd : (forall p : BinaryPositive. P(p) -> P(binary_bit1(p))), p : BinaryPositive
) :
  P(p) := match p {
    binary_one => one;
    binary_bit0(child) => even(child, binary_positive_induction(P, one, even, odd, child));
    binary_bit1(child) => odd(child, binary_positive_induction(P, one, even, odd, child));
  };
