import unat;
import primes;
use unat;

def InfinitelyManyPrimes := forall n : UNat. exists p : UNat. Prime(p) and n < p;

// Every bound has a larger prime. No axioms are required.
def euclid : InfinitelyManyPrimes {
  intro n;
  let m := succ(factorial(n));
  obtain (i, hp, hd) := prime_divisor_exists(m, factorial_positive(n));
  let p := 2 + i;
  let bigger : n < p {
    match unat_le_total(p, n) {
      left(bounded) => {
        let divides_factorial := bounded_divisor_of_factorial(i, n, bounded);
        exact absurd(nontrivial_divisor_not_consecutive(i, factorial(n), divides_factorial, hd));
      }
      right(greater) => {
        exact greater;
      }
    }
  }
  exact (p, hp, bigger);
}
