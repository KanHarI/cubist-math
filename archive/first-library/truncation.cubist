import paths_;
import classical_axioms;

// The library's truncation Trunc at U0, under the original library's names.
// Importing classical_axioms brings Trunc and the library's axioms into scope.
def IsProp(A : U0) := forall x : A. forall y : A. x = y;

def Mere(A : U0) := Trunc(U0, A);

def merely(A : U0, a : A) := h1_truncation::merely(U0, A, a);

def mere_is_prop(A : U0) := h1_truncation::mere_is_prop(U0, A);

// The library's elimination, into a proposition in U0. This checked wrapper
// rearranges its premises; it introduces no assumption.
def mere_eliminate(A, P : U0, proposition : IsProp(P), f : A -> P) :=
  h1_truncation::mere_eliminate(U0, U0, A, P, proposition, f);

def mere_map(A, B : U0, f : A -> B, h : Mere(A)) :=
  mere_eliminate(A, Mere(B), mere_is_prop(B), (fun (a : A) => merely(B, f(a))), h);
