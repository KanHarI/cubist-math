import field_closeness;
import cauchy_quotient;

// Discharge the closeness premises of the ordinary Cauchy quotient over a
// supplied small ordered field. A concrete rational field is still needed.
def ordered_close_composition(
  Q : U0, zero, one : Q, addQ, mulQ : Q -> Q -> Q, negQ : Q -> Q, ltQ : Q -> Q -> U0,
  ring : CommutativeRing(Q, zero, one, addQ, mulQ, negQ), order : StrictOrder(Q, ltQ),
  arithmetic : OrderedArithmetic(Q, zero, one, addQ, mulQ, ltQ),
  inverses : FieldInverses(Q, zero, one, mulQ, ltQ)
) :
  CloseComposition(Q, zero, addQ, ltQ) {
  obtain (half, halfSum, halfPositive) := ordered_field_halving(
    Q, zero, one, addQ, mulQ, negQ, ltQ, ring, order, arithmetic, inverses
  );
  intro epsilon, positive;
  exact (
    half(epsilon), halfPositive(epsilon, positive),
    (
      fun (x, y, z : Q) => field_close_halved_triangle(
        Q, zero, one, addQ, mulQ, negQ, ltQ, ring, order, arithmetic, half, halfSum, x, y, z,
        epsilon
      )
    )
  );
}

def ordered_cauchy_same_equivalence(
  Q : U0, zero, one : Q, addQ, mulQ : Q -> Q -> Q, negQ : Q -> Q, ltQ : Q -> Q -> U0,
  ring : CommutativeRing(Q, zero, one, addQ, mulQ, negQ), order : StrictOrder(Q, ltQ),
  arithmetic : OrderedArithmetic(Q, zero, one, addQ, mulQ, ltQ),
  inverses : FieldInverses(Q, zero, one, mulQ, ltQ)
) :
  EquivalenceRelation(CauchySequence(Q, zero, addQ, ltQ), CauchySame(Q, zero, addQ, ltQ)) {
  exact cauchy_same_equivalence(
    Q, zero, addQ, ltQ,
    field_close_self(Q, zero, one, addQ, mulQ, negQ, ltQ, ring, order, arithmetic),
    ordered_close_composition(
      Q, zero, one, addQ, mulQ, negQ, ltQ, ring, order, arithmetic, inverses
    )
  );
}
