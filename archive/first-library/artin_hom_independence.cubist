import field_homomorphisms;
import field_arithmetic;

// Multiplication by a nonzero field element is injective. The inverse is used
// only after the explicit nonzero hypothesis has been supplied.
def field_mul_left_cancel_nonzero(
  L : AlgebraicField, a, x, y : af_carrier(L),
  nonzero : FieldNonzero(af_carrier(L), af_operations(L), a),
  same : field_mul(L, a, x) = field_mul(L, a, y)
) :
  x = y {
  obtain (ring, nontrivial, inverses) := af_laws(L);
  obtain (b, inverse) := inverses(a, nonzero);
  have reduce : forall z : af_carrier(L). field_mul(L, b, field_mul(L, a, z)) = z {
    intro z;
    exact trans(
      sym(scalar_mul_assoc(L, b, a, z)),
      trans(
        cong((fun (c : af_carrier(L)) => field_mul(L, c, z)), scalar_mul_comm(L, b, a)),
        trans(cong((fun (c : af_carrier(L)) => field_mul(L, c, z)), inverse), scalar_mul_one(L, z))
      )
    );
  }
  exact trans(sym(reduce(x)), trans(cong(field_mul(L, b), same), reduce(y)));
}

// Dedekind independence, in the two-map case. The coefficient relation is
// pointwise on the source field; no vector-space presentation is assumed.
def distinct_embeddings_two_independent(
  K, L : AlgebraicField, f, g : FieldEmbedding(K, L), different : (f = g) -> Void,
  a, b : af_carrier(L), relation : forall x : af_carrier(K).
  field_add(
    L, field_mul(L, a, field_embedding_map(K, L, f, x)),
    field_mul(L, b, field_embedding_map(K, L, g, x))
  ) = field_zero(L)
) :
  (a = field_zero(L)) and (b = field_zero(L)) {
  let F := field_embedding_map(K, L, f);
  let G := field_embedding_map(K, L, g);
  obtain (f0, f1, fn, fa, fm) := field_embedding_preserves(K, L, f);
  obtain (g0, g1, gn, ga, gm) := field_embedding_preserves(K, L, g);
  have sumZero : field_add(L, a, b) = field_zero(L) := trans(
    sym(
      trans(
        cong(
          (
            fun (v : af_carrier(L)) => field_add(
              L, field_mul(L, a, v), field_mul(L, b, G(field_one(K)))
            )
          ), f1
        ),
        trans(
          cong(
            (
              fun (v : af_carrier(L)) => field_add(
                L, field_mul(L, a, field_one(L)), field_mul(L, b, v)
              )
            ), g1
          ),
          trans(
            cong(
              (fun (v : af_carrier(L)) => field_add(L, v, field_mul(L, b, field_one(L)))),
              scalar_mul_one_right(L, a)
            ), cong(field_add(L, a), scalar_mul_one_right(L, b))
          )
        )
      )
    ), relation(field_one(K))
  );
  have equalIfNonzero : FieldNonzero(af_carrier(L), af_operations(L), a) -> f = g {
    intro nonzero;
    have equalPointwise : forall x : af_carrier(K). F(x) = G(x) {
      intro x;
      let fx := F(x);
      let gx := G(x);
      let c := field_mul(L, b, gx);
      have alternate : field_add(L, field_mul(L, a, gx), c) = field_zero(L) := trans(
        sym(scalar_distribute_left(L, a, b, gx)),
        trans(
          cong((fun (z : af_carrier(L)) => field_mul(L, z, gx)), sumZero), scalar_zero_mul(L, gx)
        )
      );
      let equalProducts :=
        group_cancel_right(
          FieldAdditiveGroup(L), field_mul(L, a, fx), field_mul(L, a, gx), c,
          trans(relation(x), sym(alternate))
        );
      exact field_mul_left_cancel_nonzero(L, a, fx, gx, nonzero, equalProducts);
    }
    exact field_embedding_ext(K, L, f, g, equalPointwise);
  }
  have aZero : a = field_zero(L) := double_negation(
    a = field_zero(L), af_set(L, a, field_zero(L)),
    (
      fun (nonzero : FieldNonzero(af_carrier(L), af_operations(L), a)) => different(
        equalIfNonzero(nonzero)
      )
    )
  );
  have bZero : b = field_zero(L) := trans(
    sym(scalar_add_zero(L, b)),
    trans(cong((fun (z : af_carrier(L)) => field_add(L, z, b)), sym(aZero)), sumZero)
  );
  exact (aZero, bZero);
}
