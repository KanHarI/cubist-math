import bouquet_cover;
import loop_words;
import field_extensionality;

def BouquetGenerated(A : U0, p : BouquetLoops(A)) =
  GeneratedLoop(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), p);

def bouquet_generated_prop(A : U0, p : BouquetLoops(A)) =
  generated_prop(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), p);

def bouquet_generated_unappend(
  A : U0, a : A, p : BouquetLoops(A),
  represented : BouquetGenerated(A, trans(p, sym(bouquet_generator(A, a))))
) :
  BouquetGenerated(A, p) {
  let before = trans(p, sym(bouquet_generator(A, a)));
  exact along BouquetGenerated(A) by append_path_right_inverse(
    Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a), p
  ) from generated_snoc(
    A, Bouquet(A), bouquet_base(A), bouquet_generator(A), before, represented,
    typed(Signed(A), left(a))
  );
}

def bouquet_generation_family(A : U0, x : Bouquet(A)) = bouquet_code(A, x) -> U0;

def bouquet_generation_spoke(A : U0) :
  (along bouquet_generation_family(A) by bouquet_spoke(A) from BouquetGenerated(A)) = BouquetGenerated(
    A
  ) {
  ext p;
  exact trans(
    transport_predicate(
      Bouquet(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A),
      BouquetGenerated(A), p
    ), cong(BouquetGenerated(A), bouquet_spoke_backward(A, p))
  );
}

def bouquet_generation_edge(A : U0, a : A) :
  (along bouquet_generation_family(A) by bouquet_edge(A, a) from BouquetGenerated(A)) = BouquetGenerated(
    A
  ) {
  ext p;
  exact trans(
    transport_predicate(
      Bouquet(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A), bouquet_edge(A, a),
      BouquetGenerated(A), p
    ),
    trans(
      cong(BouquetGenerated(A), bouquet_edge_backward(A, a, p)),
      field_prop_ext(
        BouquetGenerated(A, trans(p, sym(bouquet_generator(A, a)))), BouquetGenerated(A, p),
        bouquet_generated_prop(A, trans(p, sym(bouquet_generator(A, a)))),
        bouquet_generated_prop(A, p), bouquet_generated_unappend(A, a, p),
        (
          fun (represented : BouquetGenerated(A, p)) => generated_snoc(
            A, Bouquet(A), bouquet_base(A), bouquet_generator(A), p, represented,
            typed(Signed(A), right(a))
          )
        )
      )
    )
  );
}

def bouquet_generation_edges(A : U0, label : Unit or A) =
  match label as e return (
    (along bouquet_generation_family(A) by meridian(Unit or A, e) from BouquetGenerated(A)) = BouquetGenerated(
      A
    )
  ) {
    left u => unit_induction(
      (
        fun (v : Unit) => (
          along bouquet_generation_family(A) by meridian(Unit or A, typed(Unit or A, left(v))) from BouquetGenerated(
            A
          )
        ) = BouquetGenerated(A)
      ), bouquet_generation_spoke(A), u
    );
    right a => bouquet_generation_edge(A, a);
  };

def bouquet_generation_predicate(A : U0, x : Bouquet(A)) =
  suspension_induction(
    (Unit or A), bouquet_generation_family(A), BouquetGenerated(A), BouquetGenerated(A),
    bouquet_generation_edges(A), x
  );

def bouquet_encoded_generated(A : U0, x : Bouquet(A), p : bouquet_base(A) = x) :
  bouquet_generation_predicate(A, x, bouquet_encode(A, x, p)) {
  exact based_induction(
    U1, U0, Bouquet(A), bouquet_base(A),
    (
      fun (point : Bouquet(A)) (path : bouquet_base(A) = point) => bouquet_generation_predicate(
        A, point, bouquet_encode(A, point, path)
      )
    ),
    along BouquetGenerated(A) by sym(
      transport_constant(
        Bouquet(A), BouquetLoops(A), bouquet_base(A), bouquet_base(A), refl(bouquet_base(A)),
        refl(bouquet_base(A))
      )
    ) from generated_identity(A, Bouquet(A), bouquet_base(A), bouquet_generator(A)), x, p
  );
}

// Every actual identity loop is merely the evaluation of a finite signed word.
// This proves generation, not uniqueness of reduced words or a geometric
// comparison with the complement of points in the complex plane.
def every_bouquet_loop_generated(A : U0, p : BouquetLoops(A)) :
  Mere(
    exists word : Word(A), eval_word(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), word) = p
  ) {
  exact along BouquetGenerated(A) by bouquet_decode_encode(A, bouquet_base(A), p) from bouquet_encoded_generated(
    A, bouquet_base(A), p
  );
}

def every_puncture_loop_generated(n : Nat, p : bouquet_base(Fin(n)) = bouquet_base(Fin(n))) :
  Mere(
    exists word : Word(Fin(n)),
    eval_word(Fin(n), PunctureGraph(n), bouquet_base(Fin(n)), puncture_loop(n), word) = p
  ) {
  exact every_bouquet_loop_generated(Fin(n), p);
}

// Connectedness is mere existence of connecting paths, not a simultaneous
// choice of a path from the base to every point.
def bouquet_connection_family(A : U0, x : Bouquet(A)) = Mere(bouquet_base(A) = x);

def bouquet_connection_edges(A : U0, label : Unit or A) =
  mere_is_prop(
    (bouquet_base(A) = bouquet_tip(A)),
    along bouquet_connection_family(A) by meridian(Unit or A, label) from merely(
      (bouquet_base(A) = bouquet_base(A)), refl(bouquet_base(A))
    ), merely((bouquet_base(A) = bouquet_tip(A)), bouquet_spoke(A))
  );

def bouquet_connected(A : U0, x : Bouquet(A)) : Mere(bouquet_base(A) = x) {
  exact suspension_induction(
    (Unit or A), bouquet_connection_family(A),
    merely((bouquet_base(A) = bouquet_base(A)), refl(bouquet_base(A))),
    merely((bouquet_base(A) = bouquet_tip(A)), bouquet_spoke(A)), bouquet_connection_edges(A), x
  );
}

def bouquet_path_generated(
  A : U0, x y : Bouquet(A), leftConnector : bouquet_base(A) = x,
  rightConnector : bouquet_base(A) = y, p : x = y
) :
  Mere(
    exists word : Word(A),
    reopen_path(
      Bouquet(A), bouquet_base(A), x, y, leftConnector, rightConnector,
      eval_word(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), word)
    ) = p
  ) {
  let closed = close_path(Bouquet(A), bouquet_base(A), x, y, leftConnector, rightConnector, p);
  exact mere_map(
    (
      exists word : Word(A),
      eval_word(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), word) = closed
    ),
    (
      exists word : Word(A),
      reopen_path(
        Bouquet(A), bouquet_base(A), x, y, leftConnector, rightConnector,
        eval_word(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), word)
      ) = p
    ),
    (
      fun (
        represented : (
          exists word : Word(A),
          eval_word(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), word) = closed
        )
      ) => unpack represented as (word, same) return (
        exists word : Word(A),
        reopen_path(
          Bouquet(A), bouquet_base(A), x, y, leftConnector, rightConnector,
          eval_word(A, Bouquet(A), bouquet_base(A), bouquet_generator(A), word)
        ) = p
      ) {
        (
          word,
          trans(
            cong(
              reopen_path(Bouquet(A), bouquet_base(A), x, y, leftConnector, rightConnector), same
            ),
            reopen_closed_path(Bouquet(A), bouquet_base(A), x, y, leftConnector, rightConnector, p)
          )
        );
      }
    ), every_bouquet_loop_generated(A, closed)
  );
}
