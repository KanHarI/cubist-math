import subfields;
import field_embeddings;

// Pullback of membership along an embedding. This is contravariant in the
// ambient field and covariant in inclusion of subfields of the target.
def SubfieldPreimage(
  K L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L), x : af_carrier(K)
) :=
  subfield_members(L, S, field_embedding_map(K, L, e, x));

def subfield_preimage_laws(K L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L)) :
  SubfieldLaws(K, SubfieldPreimage(K, L, e, S)) {
  let A := af_carrier(K);
  let B := af_carrier(L);
  let opsA := af_operations(K);
  let opsB := af_operations(L);
  let f := field_embedding_map(K, L, e);
  let Q := subfield_members(L, S);
  let laws := subfield_laws(L, S);
  obtain (p0, p1, pn, pa, pm) := field_embedding_preserves(K, L, e);
  exact (
    (fun (x : A) => subfield_prop(L, Q, laws, f(x))),
    along Q by sym(p0) from subfield_zero(L, Q, laws),
    along Q by sym(p1) from subfield_one(L, Q, laws),
    (fun (x : A, px : Q(f(x))) => along Q by sym(pn(x)) from subfield_neg(L, Q, laws, f(x), px)),
    (
      fun (x y : A, px : Q(f(x)), py : Q(f(y))) => along Q by sym(pa(x, y)) from subfield_add(
        L, Q, laws, f(x), f(y), px, py
      )
    ),
    (
      fun (x y : A, px : Q(f(x)), py : Q(f(y))) => along Q by sym(pm(x, y)) from subfield_mul(
        L, Q, laws, f(x), f(y), px, py
      )
    ),
    (
      fun (x y : A, px : Q(f(x)), inverseLaw : af_mul(A, opsA, x, y) = af_one(A, opsA)) => subfield_inverse(
        L, Q, laws, f(x), f(y), px, trans(sym(pm(x, y)), trans(cong(f, inverseLaw), p1))
      )
    )
  );
}

def subfield_preimage(K L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L)) : Subfield(K) {
  exact (SubfieldPreimage(K, L, e, S), subfield_preimage_laws(K, L, e, S));
}

// The laws of a contravariant operation are equalities of subfield bundles.
def subfield_preimage_identity(K : AlgebraicField, S : Subfield(K)) :
  subfield_preimage(K, K, field_embedding_identity(K), S) =[Subfield(K)] S {
  let P := subfield_members(K, S);
  exact subfield_ext(
    K, subfield_preimage(K, K, field_embedding_identity(K), S), S,
    (
      fun (x : af_carrier(K)) => typed(
        ((P(x) -> P(x)) and (P(x) -> P(x))),
        ((fun (member : P(x)) => member), (fun (member : P(x)) => member))
      )
    )
  );
}

def subfield_preimage_composite(
  K L M : AlgebraicField, e : FieldEmbedding(K, L), d : FieldEmbedding(L, M), S : Subfield(M)
) :
  subfield_preimage(K, M, field_embedding_compose(K, L, M, e, d), S) =[Subfield(K)] subfield_preimage(
    K, L, e, subfield_preimage(L, M, d, S)
  ) {
  let P :=
    (
      fun (x : af_carrier(K)) => subfield_members(
        M, S, field_embedding_map(L, M, d, field_embedding_map(K, L, e, x))
      )
    );
  exact subfield_ext(
    K, subfield_preimage(K, M, field_embedding_compose(K, L, M, e, d), S),
    subfield_preimage(K, L, e, subfield_preimage(L, M, d, S)),
    (
      fun (x : af_carrier(K)) => typed(
        ((P(x) -> P(x)) and (P(x) -> P(x))),
        ((fun (member : P(x)) => member), (fun (member : P(x)) => member))
      )
    )
  );
}
