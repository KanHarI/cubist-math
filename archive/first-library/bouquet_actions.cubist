import puncture_graph;

def action_forward(F : U0, e : Equiv(U0, F, F)) : F -> F {
  exact equivalence_function(F, F, e);
}

def action_backward(F : U0, e : Equiv(U0, F, F)) : F -> F {
  exact equivalence_inverse(F, F, e);
}

def action_left_law(F : U0, e : Equiv(U0, F, F)) :
  forall v : F. action_backward(F, e, action_forward(F, e, v)) = v {
  exact equivalence_left(F, F, e);
}

// A family of equivalences gives a local system on the bouquet. Transport
// around a generator performs its specified action on the fiber.
def action_edges(A, F : U0, actions : A -> Equiv(U0, F, F), label : Unit or A) :=
  match label return (F = F) {
    left u => refl(F);
    right a => ua(U0, F, F, actions(a));
  };

def action_family(A, F : U0, actions : A -> Equiv(U0, F, F)) :=
  suspension_rec(Unit or A, U0, F, F, action_edges(A, F, actions));

def action_univalence(A, F : U0, actions : A -> Equiv(U0, F, F), a : A, v : F) :
  (along((fun (T : U0) => T)) by ua(U0, F, F, actions(a)) from v) = action_forward(F, actions(a), v) {
  exact UnivalenceBeta(U0, F, F, actions(a), v);
}

def action_spoke(A, F : U0, actions : A -> Equiv(U0, F, F), v : F) :
  (along action_family(A, F, actions) by bouquet_spoke(A) from v) = v {
  exact trans(
    trans(
      transport_ap(
        Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A),
        v
      ),
      cong(
        (fun (p : F = F) => along((fun (T : U0) => T)) by p from v),
        suspension_rec_beta(
          Unit or A, U0, F, F, action_edges(A, F, actions), typed(Unit or A, left(tt))
        )
      )
    ), transport_constant(U0, F, F, F, refl(F), v)
  );
}

def action_spoke_inverse(A, F : U0, actions : A -> Equiv(U0, F, F), v : F) :
  (along action_family(A, F, actions) by sym(bouquet_spoke(A)) from v) = v {
  let before := along action_family(A, F, actions) by sym(bouquet_spoke(A)) from v;
  exact trans(
    sym(action_spoke(A, F, actions, before)),
    transport_after_inverse(
      Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A), v
    )
  );
}

def action_edge(A, F : U0, actions : A -> Equiv(U0, F, F), a : A, v : F) :
  (along action_family(A, F, actions) by bouquet_edge(A, a) from v) = action_forward(
    F, actions(a), v
  ) {
  exact trans(
    transport_ap(
      Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_edge(A, a),
      v
    ),
    trans(
      cong(
        (fun (p : F = F) => along((fun (T : U0) => T)) by p from v),
        suspension_rec_beta(
          Unit or A, U0, F, F, action_edges(A, F, actions), typed(Unit or A, right(a))
        )
      ), action_univalence(A, F, actions, a, v)
    )
  );
}

def loop_action(A, F : U0, actions : A -> Equiv(U0, F, F), p : BouquetLoops(A), v : F) :=
  along action_family(A, F, actions) by p from v;

def loop_action_generator(A, F : U0, actions : A -> Equiv(U0, F, F), a : A, v : F) :
  loop_action(A, F, actions, bouquet_generator(A, a), v) = action_forward(F, actions(a), v) {
  exact trans(
    transport_concat(
      Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_tip(A), bouquet_base(A),
      bouquet_edge(A, a), sym(bouquet_spoke(A)), v
    ),
    trans(
      action_spoke_inverse(
        A, F, actions, along action_family(A, F, actions) by bouquet_edge(A, a) from v
      ), action_edge(A, F, actions, a, v)
    )
  );
}

def loop_action_inverse(A, F : U0, actions : A -> Equiv(U0, F, F), a : A, v : F) :
  loop_action(A, F, actions, sym(bouquet_generator(A, a)), v) = action_backward(F, actions(a), v) {
  let before := loop_action(A, F, actions, sym(bouquet_generator(A, a)), v);
  let same :=
    trans(
      sym(loop_action_generator(A, F, actions, a, before)),
      transport_after_inverse(
        Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_base(A),
        bouquet_generator(A, a), v
      )
    );
  exact trans(
    sym(action_left_law(F, actions(a), before)), cong(action_backward(F, actions(a)), same)
  );
}

def loop_action_append(A, F : U0, actions : A -> Equiv(U0, F, F), p, q : BouquetLoops(A), v : F) :
  loop_action(A, F, actions, trans(p, q), v) = loop_action(
    A, F, actions, q, loop_action(A, F, actions, p, v)
  ) {
  exact trans(
    cong(
      (fun (r : BouquetLoops(A)) => loop_action(A, F, actions, r, v)),
      append_path_agrees(Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), p, q)
    ),
    transport_concat(
      Bouquet(A), action_family(A, F, actions), bouquet_base(A), bouquet_base(A), bouquet_base(A),
      p, q, v
    )
  );
}
