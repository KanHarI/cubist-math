import galois_fixing_subgroups;
import intermediate_towers;
import field_embedding_spaces;
import subgroup_carriers;
import finite_cardinalities;

// An extension automorphism is a field embedding of its ambient field.
def galois_field_embedding(K : AlgebraicField, E : FieldExt(K), e : Galois(K, E)) :
  FieldEmbedding(extension_field(K, E), extension_field(K, E)) {
  let A = extension_carrier(K, E);
  let f = extension_iso_forward(K, E, E, e);
  let bijection = structure_iso_bijection(ExtensionData(K), ExtensionPreserved(K), E, E, e);
  exact (
    f, galois_preserves_field_ops(K, E, e),
    (
      fun (x y : A, same : f(x) = f(y)) => trans(
        sym(left_inverse(A, A, bijection, x)),
        trans(cong(backward(A, A, bijection), same), left_inverse(A, A, bijection, y))
      )
    )
  );
}

// Fixing M pointwise supplies the triangle for an embedding over M.
def fixing_automorphism_over_intermediate(
  K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E), e : Galois(K, E),
  fixes : GaloisFixing(K, E, intermediate_members(K, E, M), e)
) :
  EmbeddingsOver(
    intermediate_as_field(K, E, M), extension_field(K, E), intermediate_ambient_embedding(K, E, M),
    extension_field(K, E), intermediate_ambient_embedding(K, E, M)
  ) {
  let F = extension_field(K, E);
  let S = intermediate_subfield(K, E, M);
  let R = intermediate_as_field(K, E, M);
  let h = galois_field_embedding(K, E, e);
  exact (h, (fun (x : af_carrier(R)) => fixes(subfield_value(F, S, x), subfield_evidence(F, S, x))));
}

// Distinct automorphisms remain distinct after forgetting their inverse maps.
def galois_field_embedding_injective(
  K : AlgebraicField, E : FieldExt(K), e d : Galois(K, E),
  same : galois_field_embedding(K, E, e) = galois_field_embedding(K, E, d)
) :
  e = d {
  exact structure_iso_ext(
    ExtensionData(K), ExtensionPreserved(K), extension_preserved_prop(K), E, E, e, d,
    (
      fun (x : extension_carrier(K, E)) => cong(
        (
          fun (h : FieldEmbedding(extension_field(K, E), extension_field(K, E))) => field_embedding_map(
            extension_field(K, E), extension_field(K, E), h, x
          )
        ), same
      )
    )
  );
}

def fixing_automorphism_over_intermediate_injective(
  K : AlgebraicField, E : FieldExt(K), M : IntermediateField(K, E), e d : Galois(K, E),
  fixesE : GaloisFixing(K, E, intermediate_members(K, E, M), e),
  fixesD : GaloisFixing(K, E, intermediate_members(K, E, M), d),
  same : fixing_automorphism_over_intermediate(K, E, M, e, fixesE) = fixing_automorphism_over_intermediate(
    K, E, M, d, fixesD
  )
) :
  e = d {
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let i = intermediate_ambient_embedding(K, E, M);
  exact galois_field_embedding_injective(
    K, E, e, d,
    cong((fun (h : EmbeddingsOver(R, F, i, F, i)) => embedding_over(R, F, i, F, i, h)), same)
  );
}

// Every member of H fixes its fixed field, so H injects into the embeddings
// of E over that field. No finiteness or separability is used here.
def subgroup_member_fixes_intermediate(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E),
  h : SubgroupCarrier(GaloisGroup(K, E), H)
) :
  GaloisFixing(
    K, E, intermediate_members(K, E, fixed_intermediate_field(K, E, H)),
    subgroup_value(GaloisGroup(K, E), H, h)
  ) {
  let e = subgroup_value(GaloisGroup(K, E), H, h);
  let member = subgroup_evidence(GaloisGroup(K, E), H, h);
  exact with unfolding [
    fixed_intermediate_field, galois_fixed_field, intermediate_members, galois_subgroup_members,
    subgroup_members
  ] {
    galois_fixing_fixed_contains(K, E, galois_subgroup_members(K, E, H), e, member)
  };
}

def fixed_subgroup_embedding(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E),
  h : SubgroupCarrier(GaloisGroup(K, E), H)
) :
  EmbeddingsOver(
    intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
    intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
    intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H))
  ) {
  let e = subgroup_value(GaloisGroup(K, E), H, h);
  exact fixing_automorphism_over_intermediate(
    K, E, fixed_intermediate_field(K, E, H), e, subgroup_member_fixes_intermediate(K, E, H, h)
  );
}

def fixed_subgroup_embedding_injective(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E),
  h k : SubgroupCarrier(GaloisGroup(K, E), H),
  same : fixed_subgroup_embedding(K, E, H, h) = fixed_subgroup_embedding(K, E, H, k)
) :
  h = k {
  let G = GaloisGroup(K, E);
  let e = subgroup_value(G, H, h);
  let d = subgroup_value(G, H, k);
  let M = fixed_intermediate_field(K, E, H);
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let i = intermediate_ambient_embedding(K, E, M);
  exact subgroup_value_ext(
    G, H, h, k,
    galois_field_embedding_injective(
      K, E, e, d,
      cong((fun (v : EmbeddingsOver(R, F, i, F, i)) => embedding_over(R, F, i, F, i, v)), same)
    )
  );
}

// A member of H may equally be presented as a loop of the bundled extension.
// The corresponding embedding acts by transport around that loop.
def fixed_subgroup_loop_embedding(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), p : E =[FieldExt(K)] E,
  member : subgroup_members(GaloisGroup(K, E), H, extension_path_iso(K, E, E, p))
) :
  EmbeddingsOver(
    intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
    intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
    intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H))
  ) {
  exact fixed_subgroup_embedding(K, E, H, (extension_path_iso(K, E, E, p), member));
}

def fixed_subgroup_loop_embedding_action(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), p : E =[FieldExt(K)] E,
  member : subgroup_members(GaloisGroup(K, E), H, extension_path_iso(K, E, E, p)),
  x : extension_carrier(K, E)
) :
  field_embedding_map(
    extension_field(K, E), extension_field(K, E),
    embedding_over(
      intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
      intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H)),
      extension_field(K, E),
      intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H)),
      fixed_subgroup_loop_embedding(K, E, H, p, member)
    ), x
  ) = (along extension_carrier(K) by p from x) {
  let e = extension_path_iso(K, E, E, p);
  exact trans(
    sym(galois_loop_action(K, E, e, x)),
    cong(
      (fun (q : E =[FieldExt(K)] E) => along extension_carrier(K) by q from x),
      extension_path_roundtrip(K, E, E, p)
    )
  );
}

def fixed_subgroup_loop_embedding_injective(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), p q : E =[FieldExt(K)] E,
  memberP : subgroup_members(GaloisGroup(K, E), H, extension_path_iso(K, E, E, p)),
  memberQ : subgroup_members(GaloisGroup(K, E), H, extension_path_iso(K, E, E, q)),
  same : fixed_subgroup_loop_embedding(K, E, H, p, memberP) = fixed_subgroup_loop_embedding(
    K, E, H, q, memberQ
  )
) :
  p = q {
  let M = fixed_intermediate_field(K, E, H);
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let i = intermediate_ambient_embedding(K, E, M);
  let e = extension_path_iso(K, E, E, p);
  let d = extension_path_iso(K, E, E, q);
  let eq =
    galois_field_embedding_injective(
      K, E, e, d,
      cong((fun (v : EmbeddingsOver(R, F, i, F, i)) => embedding_over(R, F, i, F, i, v)), same)
    );
  exact trans(
    sym(extension_path_roundtrip(K, E, E, p)),
    trans(cong(extension_iso_path(K, E, E), eq), extension_path_roundtrip(K, E, E, q))
  );
}

// A merely finite subgroup yields a merely enumerated distinct family of
// embeddings over its fixed field. This is the lower-bound half of Artin's
// embedding comparison, stated without choosing an enumeration.
def fixed_subgroup_distinct_embeddings(
  K : AlgebraicField, E : FieldExt(K), H : GaloisSubgroup(K, E), n : Nat,
  finite : HasCardinality(SubgroupCarrier(GaloisGroup(K, E), H), n)
) :
  Mere(
    DistinctFamily(
      EmbeddingsOver(
        intermediate_as_field(K, E, fixed_intermediate_field(K, E, H)), extension_field(K, E),
        intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H)),
        extension_field(K, E),
        intermediate_ambient_embedding(K, E, fixed_intermediate_field(K, E, H))
      ), n
    )
  ) {
  let G = GaloisGroup(K, E);
  let A = SubgroupCarrier(G, H);
  let M = fixed_intermediate_field(K, E, H);
  let R = intermediate_as_field(K, E, M);
  let F = extension_field(K, E);
  let i = intermediate_ambient_embedding(K, E, M);
  let B = EmbeddingsOver(R, F, i, F, i);
  have make : Bijection(Fin(n), A) -> DistinctFamily(B, n) {
    intro enumeration;
    let f =
      fun (index : Fin(n)) => fixed_subgroup_embedding(
        K, E, H, forward(Fin(n), A, enumeration, index)
      );
    have injective : Injective(Fin(n), B, f) {
      intro x y same;
      exact inverse_injective(
        Fin(n), A, forward(Fin(n), A, enumeration), backward(Fin(n), A, enumeration),
        left_inverse(Fin(n), A, enumeration), x, y,
        fixed_subgroup_embedding_injective(
          K, E, H, forward(Fin(n), A, enumeration, x), forward(Fin(n), A, enumeration, y), same
        )
      );
    }
    exact (f, injective);
  }
  exact mere_map(Bijection(Fin(n), A), DistinctFamily(B, n), make, finite);
}
