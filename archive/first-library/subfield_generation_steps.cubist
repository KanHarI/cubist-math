import subfields;
import order_maps;
import primes;

// A finite derivation step. Its witnesses live in U0, including inverse
// witnesses; the construction never tests whether an element equals zero.
def FieldClosureStep(F : AlgebraicField, P : af_carrier(F) -> U0, x : af_carrier(F)) =
  P(x) or (x = af_zero(af_carrier(F), af_operations(F)))
  or (x = af_one(af_carrier(F), af_operations(F)))
  or (exists y : af_carrier(F), P(y) and (af_neg(af_carrier(F), af_operations(F), y) = x))
  or (
    exists y : af_carrier(F), exists z : af_carrier(F), P(y) and P(z)
    and (af_add(af_carrier(F), af_operations(F), y, z) = x)
  )
  or (
    exists y : af_carrier(F), exists z : af_carrier(F), P(y) and P(z)
    and (af_mul(af_carrier(F), af_operations(F), y, z) = x)
  )
  or (
    exists y : af_carrier(F), P(y)
    and (af_mul(af_carrier(F), af_operations(F), y, x) = af_one(af_carrier(F), af_operations(F)))
  );

def field_closure_step_keep(
  F : AlgebraicField, P : af_carrier(F) -> U0, x : af_carrier(F), member : P(x)
) :
  FieldClosureStep(F, P, x) {
  exact left(member);
}

def field_closure_step_zero(F : AlgebraicField, P : af_carrier(F) -> U0) :
  FieldClosureStep(F, P, af_zero(af_carrier(F), af_operations(F))) {
  exact right(left(refl(af_zero(af_carrier(F), af_operations(F)))));
}

def field_closure_step_one(F : AlgebraicField, P : af_carrier(F) -> U0) :
  FieldClosureStep(F, P, af_one(af_carrier(F), af_operations(F))) {
  exact right(right(left(refl(af_one(af_carrier(F), af_operations(F))))));
}

def field_closure_step_neg(
  F : AlgebraicField, P : af_carrier(F) -> U0, x : af_carrier(F), member : P(x)
) :
  FieldClosureStep(F, P, af_neg(af_carrier(F), af_operations(F), x)) {
  exact right(right(right(left((x, member, refl(af_neg(af_carrier(F), af_operations(F), x)))))));
}

def field_closure_step_add(
  F : AlgebraicField, P : af_carrier(F) -> U0, x y : af_carrier(F), px : P(x), py : P(y)
) :
  FieldClosureStep(F, P, af_add(af_carrier(F), af_operations(F), x, y)) {
  exact right(
    right(right(right(left((x, y, px, py, refl(af_add(af_carrier(F), af_operations(F), x, y)))))))
  );
}

def field_closure_step_mul(
  F : AlgebraicField, P : af_carrier(F) -> U0, x y : af_carrier(F), px : P(x), py : P(y)
) :
  FieldClosureStep(F, P, af_mul(af_carrier(F), af_operations(F), x, y)) {
  exact right(
    right(
      right(right(right(left((x, y, px, py, refl(af_mul(af_carrier(F), af_operations(F), x, y)))))))
    )
  );
}

def field_closure_step_inverse(
  F : AlgebraicField, P : af_carrier(F) -> U0, x y : af_carrier(F), px : P(x),
  inverseLaw : af_mul(af_carrier(F), af_operations(F), x, y) = af_one(
    af_carrier(F), af_operations(F)
  )
) :
  FieldClosureStep(F, P, y) {
  exact right(right(right(right(right(right((x, px, inverseLaw)))))));
}

// A subfield containing P contains the result of every single closure step.
def field_closure_step_into_subfield(
  F : AlgebraicField, P Q : af_carrier(F) -> U0, laws : SubfieldLaws(F, Q),
  included : PredicateIncluded(af_carrier(F), P, Q), x : af_carrier(F),
  step : FieldClosureStep(F, P, x)
) :
  Q(x) {
  cases step {
    left member => {
      exact included(x, member);
    }
    right alternatives => {
      cases alternatives {
        left zeroPath => {
          exact along Q by sym(zeroPath) from subfield_zero(F, Q, laws);
        }
        right nonzeroAlternatives => {
          cases nonzeroAlternatives {
            left onePath => {
              exact along Q by sym(onePath) from subfield_one(F, Q, laws);
            }
            right operation => {
              cases operation {
                left negated => {
                  obtain (y, py, same) = negated;
                  exact along Q by same from subfield_neg(F, Q, laws, y, included(y, py));
                }
                right binaryOrInverse => {
                  cases binaryOrInverse {
                    left added => {
                      obtain (y, z, py, pz, same) = added;
                      exact along Q by same from subfield_add(
                        F, Q, laws, y, z, included(y, py), included(z, pz)
                      );
                    }
                    right productOrInverse => {
                      cases productOrInverse {
                        left multiplied => {
                          obtain (y, z, py, pz, same) = multiplied;
                          exact along Q by same from subfield_mul(
                            F, Q, laws, y, z, included(y, py), included(z, pz)
                          );
                        }
                        right inverted => {
                          obtain (y, py, inverseLaw) = inverted;
                          exact subfield_inverse(F, Q, laws, y, x, included(y, py), inverseLaw);
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// Rank zero contains the generators; every successor permits one more step.
def FieldClosureStage(F : AlgebraicField, P : af_carrier(F) -> U0, n : Nat) =
  induction n as k return (af_carrier(F) -> U0) {
    zero => P;
    succ previous => FieldClosureStep(F, previous);
  };

// Padding a derivation by m keep-steps raises its rank from n to m+n.
def field_closure_pad(F : AlgebraicField, P : af_carrier(F) -> U0, m : Nat) =
  induction m as k return (
    forall n : Nat, forall x : af_carrier(F), FieldClosureStage(F, P, n, x)
    -> FieldClosureStage(F, P, k + n, x)
  ) {
    zero => (fun (n : Nat, x : af_carrier(F), member : FieldClosureStage(F, P, n, x)) => member);
    succ previous => (
      fun (n : Nat, x : af_carrier(F), member : FieldClosureStage(F, P, n, x)) => field_closure_step_keep(
        F, FieldClosureStage(F, P, k + n), x, previous(n, x, member)
      )
    );
  };

def field_closure_pad_right(
  F : AlgebraicField, P : af_carrier(F) -> U0, n m : Nat, x : af_carrier(F),
  member : FieldClosureStage(F, P, n, x)
) :
  FieldClosureStage(F, P, n + m, x) {
  exact along((fun (rank : Nat) => FieldClosureStage(F, P, rank, x))) by nat_add_comm(m, n) from field_closure_pad(
    F, P, m, n, x, member
  );
}

// Every finite derivation lies in any subfield containing the generators.
def field_closure_stage_least(
  F : AlgebraicField, P Q : af_carrier(F) -> U0, laws : SubfieldLaws(F, Q),
  included : PredicateIncluded(af_carrier(F), P, Q), n : Nat
) =
  induction n as k return (forall x : af_carrier(F), FieldClosureStage(F, P, k, x) -> Q(x)) {
    zero => included;
    succ previous => field_closure_step_into_subfield(
      F, FieldClosureStage(F, P, k), Q, laws, previous
    );
  };
