import radix_decode;
import equivalences;

// Uniqueness of quotient and bounded remainder, without division or choice.
def radix_nat_no_smaller_self(n : Nat) : (succ(n) <= n) -> Void {
  exact induction n as k return ((succ(k) <= k) -> Void) {
    zero => fun (impossible : Void) => impossible;
    succ previous => previous;
  };
}

def radix_nat_small_not_large(r d e : Nat, small : succ(d) <= r, same : d = r + e) : Void {
  let large =
    along((fun (v : Nat) => r <= v)) by trans(nat_add_comm(e, r), sym(same)) from nat_le_add(e, r);
  exact radix_nat_no_smaller_self(d, nat_le_trans(succ(d), r, d, small, large));
}

def radix_eval_succ(r n d : Nat) : r * succ(n) + d = r + (r * n + d) {
  exact trans(cong((fun (v : Nat) => v + d), nat_mul_succ(r, n)), nat_add_assoc(r, r * n, d));
}

def radix_cancel_block(r a b d e : Nat, same : r * succ(a) + d = r * succ(b) + e) :
  r * a + d = r * b + e {
  exact nat_add_cancel(
    r, r * a + d, r * b + e,
    trans(sym(radix_eval_succ(r, a, d)), trans(same, radix_eval_succ(r, b, e)))
  );
}

def radix_division_zero(r d e : Nat, small : succ(d) <= r, b : Nat) :
  (d = r * b + e) -> ((0 = b) and (d = e)) {
  exact induction b as k return ((d = r * k + e) -> ((0 = k) and (d = e))) {
    zero => fun (same : d = r * 0 + e) => typed(
      (0 = 0) and (d = e), (refl(0), trans(same, cong((fun (v : Nat) => v + e), nat_mul_zero(r))))
    );
    succ previous => fun (same : d = r * succ(k) + e) => typed(
      (0 = succ(k)) and (d = e),
      absurd(
        radix_nat_small_not_large(r, d, r * k + e, small, trans(same, radix_eval_succ(r, k, e)))
      )
    );
  };
}

def radix_division_successor(
  r d e : Nat, smallE : succ(e) <= r, a : Nat,
  ih : (forall b : Nat, (r * a + d = r * b + e) -> ((a = b) and (d = e))), b : Nat
) :
  (r * succ(a) + d = r * b + e) -> ((succ(a) = b) and (d = e)) {
  exact induction b as k return ((r * succ(a) + d = r * k + e) -> ((succ(a) = k) and (d = e))) {
    zero => fun (same : r * succ(a) + d = r * 0 + e) => typed(
      (succ(a) = 0) and (d = e),
      absurd(
        radix_nat_small_not_large(
          r, e, r * a + d, smallE,
          trans(
            sym(cong((fun (v : Nat) => v + e), nat_mul_zero(r))),
            trans(sym(same), radix_eval_succ(r, a, d))
          )
        )
      )
    );
    succ previous => fun (same : r * succ(a) + d = r * succ(k) + e) => unpack ih(
      k, radix_cancel_block(r, a, k, d, e, same)
    ) as (quotient, remainder) return ((succ(a) = succ(k)) and (d = e)) {
      (cong(succ, quotient), remainder);
    };
  };
}

def radix_division_unique(r d e : Nat, smallD : succ(d) <= r, smallE : succ(e) <= r, a : Nat) :
  forall b : Nat, (r * a + d = r * b + e) -> ((a = b) and (d = e)) {
  exact induction a as k return (forall b : Nat, (r * k + d = r * b + e) -> ((k = b) and (d = e))) {
    zero => fun (b : Nat, same : r * 0 + d = r * b + e) => radix_division_zero(
      r, d, e, smallD, b, trans(sym(cong((fun (v : Nat) => v + d), nat_mul_zero(r))), same)
    );
    succ previous => radix_division_successor(r, d, e, smallE, k, previous);
  };
}

def radix_digit_bound(n : Nat) : forall d : RadixDigit(n), succ(radix_digit_value(n, d)) <= n {
  exact induction n as k return (forall d : RadixDigit(k), succ(radix_digit_value(k, d)) <= k) {
    zero => fun (d : Void) => typed((succ(radix_digit_value(0, d)) <= 0), absurd(d));
    succ previous => fun (d : RadixDigit(succ(k))) => match typed(Unit or RadixDigit(k), d) as digit return (
      succ(radix_digit_value(succ(k), digit)) <= succ(k)
    ) {
      left top => nat_le_refl(succ(k));
      right lower => nat_le_step(succ(radix_digit_value(k, lower)), k, previous(lower));
    };
  };
}

// Finite digits are distinguished by their values. Unit branches still use
// their actual equality proofs, rather than treating all terms as definitionally equal.
def RadixDigitInjective(n : Nat) =
  forall d : RadixDigit(n), forall e : RadixDigit(n),
  (radix_digit_value(n, d) = radix_digit_value(n, e)) -> (d = e);

def radix_digit_top_unique(n : Nat, u : Unit, e : RadixDigit(succ(n))) :
  (n = radix_digit_value(succ(n), e)) -> (typed(Unit or RadixDigit(n), left(u)) = e) {
  exact match typed(Unit or RadixDigit(n), e) as digit return (
    (n = radix_digit_value(succ(n), digit)) -> (typed(Unit or RadixDigit(n), left(u)) = digit)
  ) {
    left v => fun (same : n = n) => cong(
      (fun (point : Unit) => typed(Unit or RadixDigit(n), left(point))),
      trans(sym(unit_equal(u)), unit_equal(v))
    );
    right lower => fun (same : n = radix_digit_value(n, lower)) => typed(
      (typed(Unit or RadixDigit(n), left(u)) = radix_digit_weaken(n, lower)),
      absurd(
        radix_nat_no_smaller_self(
          radix_digit_value(n, lower),
          along((fun (bound : Nat) => succ(radix_digit_value(n, lower)) <= bound)) by same from radix_digit_bound(
            n, lower
          )
        )
      )
    );
  };
}

def radix_digit_lower_unique(
  n : Nat, ih : RadixDigitInjective(n), d : RadixDigit(n), e : RadixDigit(succ(n))
) :
  (radix_digit_value(n, d) = radix_digit_value(succ(n), e)) -> (radix_digit_weaken(n, d) = e) {
  exact match typed(Unit or RadixDigit(n), e) as digit return (
    (radix_digit_value(n, d) = radix_digit_value(succ(n), digit))
    -> (radix_digit_weaken(n, d) = digit)
  ) {
    left top => fun (same : radix_digit_value(n, d) = n) => sym(
      radix_digit_top_unique(n, top, radix_digit_weaken(n, d), sym(same))
    );
    right lower => fun (same : radix_digit_value(n, d) = radix_digit_value(n, lower)) => cong(
      radix_digit_weaken(n), ih(d, lower, same)
    );
  };
}

def radix_digit_injective(n : Nat) : RadixDigitInjective(n) {
  exact induction n as k return RadixDigitInjective(k) {
    zero => fun (d : Void) => typed(
      (forall e : Void, (radix_digit_value(0, d) = radix_digit_value(0, e)) -> (d = e)), absurd(d)
    );
    succ previous => fun (d : RadixDigit(succ(k))) => match typed(Unit or RadixDigit(k), d) as digit return (
      forall e : RadixDigit(succ(k)),
      (radix_digit_value(succ(k), digit) = radix_digit_value(succ(k), e)) -> (digit = e)
    ) {
      left top => radix_digit_top_unique(k, top);
      right lower => radix_digit_lower_unique(k, previous, lower);
    };
  };
}
