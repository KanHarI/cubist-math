import unat;
use unat;

// What remains of the first library's prime numbers, over unat's arithmetic
// and order: a bounded search for the least witness of a decidable
// predicate, and the unary factorial. Divisibility, primality and Euclid's
// theorem are the library's (divisibility, prime_numbers, euclid).
// Every definition below is checked from source. No axioms and no imported
// instruction snapshots.

def bounded_least_search(
  P : (UNat -> U0), dec : (forall n : UNat. (P(n) or (P(n) -> Void))), n : UNat
) :=
  induction n as n2 return (
    (
      exists i : UNat.
      ((i <= n2) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
    ) or (forall j : UNat. ((j <= n2) -> (P(j) -> Void)))
  ) {
    zero => match dec(0) return (
      (
        exists i : UNat.
        ((i <= 0) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
      ) or (forall j : UNat. ((j <= 0) -> (P(j) -> Void)))
    ) {
      left p => typed(
        (
          (
            exists i : UNat.
            ((i <= 0) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
          ) or (forall j : UNat. ((j <= 0) -> (P(j) -> Void)))
        ),
        left(
          typed(
            (
              exists i : UNat.
              ((i <= 0) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
            ),
            (
              0,
              typed(
                ((0 <= 0) and (P(0) and (forall j : UNat. ((succ(j) <= 0) -> (P(j) -> Void))))),
                (
                  tt,
                  typed(
                    (P(0) and (forall j : UNat. ((succ(j) <= 0) -> (P(j) -> Void)))),
                    (
                      p,
                      (
                        fun (j : UNat) => (
                          fun (impossible : (succ(j) <= 0)) => (fun (x : P(j)) => impossible)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
      right np => typed(
        (
          (
            exists i : UNat.
            ((i <= 0) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
          ) or (forall j : UNat. ((j <= 0) -> (P(j) -> Void)))
        ),
        right(
          (
            fun (j : UNat) => (
              fun (bound : (j <= 0)) => (
                fun (p : P(j)) => np(
                  path_induction(
                    UNat,
                    (
                      fun (x : UNat) => (
                        fun (y : UNat) => (fun (path_ : (x = y)) => (P(x) -> P(y)))
                      )
                    ), (fun (x : UNat) => (fun (t : P(x)) => t)), j, 0, unat_le_zero(j, bound)
                  )(p)
                )
              )
            )
          )
        )
      );
    };
    succ ih => match ih return (
      (
        exists i : UNat.
        ((i <= succ(n2)) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
      ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
    ) {
      left witness_ => unpack witness_ as (i, data) return (
        (
          exists i : UNat.
          ((i <= succ(n2)) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
        ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
      ) {
        unpack data as (bound, rest) return (
          (
            exists i2 : UNat.
            (
              (i2 <= succ(n2))
              and (P(i2) and (forall j : UNat. ((succ(j) <= i2) -> (P(j) -> Void))))
            )
          ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
        ) {
          unpack rest as (proof, minimal) return (
            (
              exists i2 : UNat.
              (
                (i2 <= succ(n2))
                and (P(i2) and (forall j : UNat. ((succ(j) <= i2) -> (P(j) -> Void))))
              )
            ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
          ) {
            typed(
              (
                (
                  exists i2 : UNat.
                  (
                    (i2 <= succ(n2))
                    and (P(i2) and (forall j : UNat. ((succ(j) <= i2) -> (P(j) -> Void))))
                  )
                ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
              ),
              left(
                typed(
                  (
                    exists i2 : UNat.
                    (
                      (i2 <= succ(n2))
                      and (P(i2) and (forall j : UNat. ((succ(j) <= i2) -> (P(j) -> Void))))
                    )
                  ),
                  (
                    i,
                    typed(
                      (
                        (i <= succ(n2))
                        and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void))))
                      ),
                      (
                        unat_le_step(i, n2, bound),
                        typed(
                          (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))),
                          (proof, minimal)
                        )
                      )
                    )
                  )
                )
              )
            );
          };
        };
      };
      right oldNone => match dec(succ(n2)) return (
        (
          exists i : UNat.
          ((i <= succ(n2)) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
        ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
      ) {
        left p => typed(
          (
            (
              exists i : UNat.
              ((i <= succ(n2)) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
            ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
          ),
          left(
            typed(
              (
                exists i : UNat.
                (
                  (i <= succ(n2))
                  and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void))))
                )
              ),
              (
                succ(n2),
                typed(
                  (
                    (succ(n2) <= succ(n2))
                    and (
                      P(succ(n2)) and (forall j : UNat. ((succ(j) <= succ(n2)) -> (P(j) -> Void)))
                    )
                  ),
                  (
                    unat_le_refl(succ(n2)),
                    typed(
                      (P(succ(n2)) and (forall j : UNat. ((succ(j) <= succ(n2)) -> (P(j) -> Void)))),
                      (p, oldNone)
                    )
                  )
                )
              )
            )
          )
        );
        right np => typed(
          (
            (
              exists i : UNat.
              ((i <= succ(n2)) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
            ) or (forall j : UNat. ((j <= succ(n2)) -> (P(j) -> Void)))
          ),
          right(
            (
              fun (j : UNat) => (
                fun (bound : (j <= succ(n2))) => (
                  fun (p : P(j)) => match unat_le_succ_split(j, n2, bound) return Void {
                    left small => oldNone(j, small, p);
                    right same => np(
                      path_induction(
                        UNat,
                        (
                          fun (x : UNat) => (
                            fun (y : UNat) => (fun (path_ : (x = y)) => (P(x) -> P(y)))
                          )
                        ), (fun (x : UNat) => (fun (t : P(x)) => t)), j, succ(n2), same
                      )(p)
                    );
                  }
                )
              )
            )
          )
        );
      };
    };
  };

def least_bounded_witness(
  P : (UNat -> U0), dec : (forall n : UNat. (P(n) or (P(n) -> Void))), n : UNat, pn : P(n)
) :=
  match bounded_least_search(P, dec, n) return (
    exists i : UNat. ((i <= n) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
  ) {
    left witness_ => witness_;
    right empty_ => typed(
      (
        exists i : UNat.
        ((i <= n) and (P(i) and (forall j : UNat. ((succ(j) <= i) -> (P(j) -> Void)))))
      ), absurd(empty_(n, unat_le_refl(n), pn))
    );
  };

// Factorial.
// factorial(0) = 1; factorial(succ(n)) = succ(n) * factorial(n).
// Keep calls folded so a theorem can mention a large factorial without
// first constructing its unary value. Checked conversion still unfolds it.
def factorial(n : UNat) := induction n as k return UNat {
    zero => 1;
    succ h => (succ(k) * h);
  };
