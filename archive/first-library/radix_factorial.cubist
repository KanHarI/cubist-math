                  radix_append(
                    0, base_two_digit_1, radix_append(0, base_two_digit_0, base_two_leading_1)
                  )
                )
              )
            )
          )
        )
      )
    )
  );

def base_two_factorial_6 : radix_factorial(0, 6) = base_two_factorial_value_6 {
