import radix_arithmetic;

// The same radix arithmetic and factorial are checked at radix 2 and radix 10.
// The parameter is radix minus two. Every numeral below is a compact W tree.
def base_two_digit_0 := radix_digit_weaken(1, radix_digit_top(0));

def base_two_digit_1 := radix_digit_top(1);

def base_two_leading_1 := radix_leading(0, radix_digit_top(0));

// 1 in decimal; digits 1 in base 2.
def base_two_factorial_value_1 := radix_positive(0, base_two_leading_1);

def base_two_factorial_1 : radix_factorial(0, 1) = base_two_factorial_value_1 {
  exact radix_factorial_value_step(0, 0, radix_positive(0, radix_one(0)), radix_factorial_zero(0));
}

// 2 in decimal; digits 10 in base 2.
def base_two_factorial_value_2 :=
  radix_positive(0, radix_append(0, base_two_digit_0, base_two_leading_1));

def base_two_factorial_2 : radix_factorial(0, 2) = base_two_factorial_value_2 {
  exact radix_factorial_value_step(0, 1, base_two_factorial_value_1, base_two_factorial_1);
}

// 6 in decimal; digits 110 in base 2.
def base_two_factorial_value_3 :=
  radix_positive(
    0, radix_append(0, base_two_digit_0, radix_append(0, base_two_digit_1, base_two_leading_1))
  );

def base_two_factorial_3 : radix_factorial(0, 3) = base_two_factorial_value_3 {
  exact radix_factorial_value_step(0, 2, base_two_factorial_value_2, base_two_factorial_2);
}

// 24 in decimal; digits 11000 in base 2.
def base_two_factorial_value_4 :=
  radix_positive(
    0,
    radix_append(
      0, base_two_digit_0,
      radix_append(
        0, base_two_digit_0,
        radix_append(0, base_two_digit_0, radix_append(0, base_two_digit_1, base_two_leading_1))
      )
    )
  );

def base_two_factorial_4 : radix_factorial(0, 4) = base_two_factorial_value_4 {
  exact radix_factorial_value_step(0, 3, base_two_factorial_value_3, base_two_factorial_3);
}

// 120 in decimal; digits 1111000 in base 2.
def base_two_factorial_value_5 :=
  radix_positive(
    0,
    radix_append(
      0, base_two_digit_0,
      radix_append(
        0, base_two_digit_0,
        radix_append(
          0, base_two_digit_0,
          radix_append(
            0, base_two_digit_1,
            radix_append(0, base_two_digit_1, radix_append(0, base_two_digit_1, base_two_leading_1))
          )
        )
      )
    )
  );

def base_two_factorial_5 : radix_factorial(0, 5) = base_two_factorial_value_5 {
  exact radix_factorial_value_step(0, 4, base_two_factorial_value_4, base_two_factorial_4);
}

// 720 in decimal; digits 1011010000 in base 2.
