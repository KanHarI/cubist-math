import nat;
import radix_naturals;

def radix_positive_induction(
  extra : Nat, P : RadixPositive(extra) -> U0,
  leading : (forall d : RadixDigit(succ(extra)). P(radix_leading(extra, d))),
  append : (
    forall d : RadixDigit(succ(succ(extra))). forall p : RadixPositive(extra). P(p)
    -> P(radix_append(extra, d, p))
  ), p : RadixPositive(extra)
) :
  P(p) := match p {
    radix_leading_digit(d) => leading(d);
    radix_appended_digit(d, child) => append(
      d, child, radix_positive_induction(extra, P, leading, append, child)
    );
  };
