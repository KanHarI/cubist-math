import curve_sample_sums;
import contour_sums;

// Right scalar multiplication, using commutativity of the coefficient ring.
def contour_sum_scale(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), f : F -> F, coefficient : F, n : Nat,
  vertices : SampleVertices(F, n), tags : SampleTags(F, n)
) :
  contour_sum(
    F, zero, addF, mulF, negF, (fun (x : F) => mulF(f(x), coefficient)), n, vertices, tags
  ) = mulF(contour_sum(F, zero, addF, mulF, negF, f, n, vertices, tags), coefficient) {
  let original := contour_edge(F, addF, mulF, negF, f);
  let scaled := contour_edge(F, addF, mulF, negF, (fun (x : F) => mulF(f(x), coefficient)));
  let mapping := mulF(coefficient);
  let mapped := (fun (a, b, tag : F) => mapping(original(a, b, tag)));
  have edgePath : forall a : F. forall b : F. forall tag : F. scaled(a, b, tag) = mapped(a, b, tag) {
    intro a, b, tag;
    let difference := coordinate_difference(F, addF, negF, a, b);
    exact trans(
      cong(
        (fun (v : F) => mulF(v, difference)),
        ring_mul_comm(F, zero, one, addF, mulF, negF, ring, f(tag), coefficient)
      ), ring_mul_assoc(F, zero, one, addF, mulF, negF, ring, coefficient, f(tag), difference)
    );
  }
  exact trans(
    sample_sum_cong(F, F, zero, addF, scaled, mapped, edgePath, n, vertices, tags),
    trans(
      sym(
        sample_sum_map(
          F, F, zero, addF, F, zero, addF, mapping,
          ring_mul_zero(F, zero, one, addF, mulF, negF, ring, coefficient),
          ring_distribute(F, zero, one, addF, mulF, negF, ring, coefficient), original, n, vertices,
          tags
        )
      ),
      ring_mul_comm(
        F, zero, one, addF, mulF, negF, ring, coefficient,
        contour_sum(F, zero, addF, mulF, negF, f, n, vertices, tags)
      )
    )
  );
}

def curve_subdivision_samples_add(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  curve : FieldUnitInterval(F, zero, one, lt) -> Complex(F), f, g : Complex(F) -> Complex(F),
  a, b : FieldUnitInterval(F, zero, one, lt),
  piece : SampleSubdivision(FieldUnitInterval(F, zero, one, lt), a, b)
) :
  curve_subdivision_samples(
    F, zero, one, addF, mulF, negF, lt, curve,
    (fun (x : Complex(F)) => complex_add(F, addF, f(x), g(x))), a, b, piece
  ) = complex_add(
    F, addF, curve_subdivision_samples(F, zero, one, addF, mulF, negF, lt, curve, f, a, b, piece),
    curve_subdivision_samples(F, zero, one, addF, mulF, negF, lt, curve, g, a, b, piece)
  ) {
  let I := FieldUnitInterval(F, zero, one, lt);
  let n := subdivision_count(I, a, b, piece);
  exact contour_sum_add(
    Complex(F), complex_zero(F, zero), complex_one(F, zero, one), complex_add(F, addF),
    complex_mul(F, addF, mulF, negF), complex_neg(F, negF),
    complex_commutative_ring(F, zero, one, addF, mulF, negF, ring), f, g, n,
    map_sample_vertices(I, Complex(F), curve, n, subdivision_vertices(I, a, b, piece)),
    map_sample_tags(I, Complex(F), curve, n, subdivision_tags(I, a, b, piece))
  );
}

def curve_subdivision_samples_scale(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  curve : FieldUnitInterval(F, zero, one, lt) -> Complex(F), f : Complex(F) -> Complex(F),
  coefficient : Complex(F), a, b : FieldUnitInterval(F, zero, one, lt),
  piece : SampleSubdivision(FieldUnitInterval(F, zero, one, lt), a, b)
) :
  curve_subdivision_samples(
    F, zero, one, addF, mulF, negF, lt, curve,
    (fun (x : Complex(F)) => complex_mul(F, addF, mulF, negF, f(x), coefficient)), a, b, piece
  ) = complex_mul(
    F, addF, mulF, negF,
    curve_subdivision_samples(F, zero, one, addF, mulF, negF, lt, curve, f, a, b, piece),
    coefficient
  ) {
  let I := FieldUnitInterval(F, zero, one, lt);
  let n := subdivision_count(I, a, b, piece);
  exact contour_sum_scale(
    Complex(F), complex_zero(F, zero), complex_one(F, zero, one), complex_add(F, addF),
    complex_mul(F, addF, mulF, negF), complex_neg(F, negF),
    complex_commutative_ring(F, zero, one, addF, mulF, negF, ring), f, coefficient, n,
    map_sample_vertices(I, Complex(F), curve, n, subdivision_vertices(I, a, b, piece)),
    map_sample_tags(I, Complex(F), curve, n, subdivision_tags(I, a, b, piece))
  );
}

// Only values on the curve matter; no equality of the whole functions is
// required, and no function-extensionality axiom is used.
def curve_subdivision_samples_cong(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  curve : FieldUnitInterval(F, zero, one, lt) -> Complex(F), f, g : Complex(F) -> Complex(F),
  same : (forall t : FieldUnitInterval(F, zero, one, lt). f(curve(t)) = g(curve(t))),
  a, b : FieldUnitInterval(F, zero, one, lt),
  piece : SampleSubdivision(FieldUnitInterval(F, zero, one, lt), a, b)
) :
  curve_subdivision_samples(F, zero, one, addF, mulF, negF, lt, curve, f, a, b, piece) = curve_subdivision_samples(
    F, zero, one, addF, mulF, negF, lt, curve, g, a, b, piece
  ) {
  let I := FieldUnitInterval(F, zero, one, lt);
  let addC := complex_add(F, addF);
  let mulC := complex_mul(F, addF, mulF, negF);
  let negC := complex_neg(F, negF);
  let zeroC := complex_zero(F, zero);
  let edgeF :=
    parameter_contour_edge(I, Complex(F), addC, mulC, negC, curve, (fun (t : I) => f(curve(t))));
  let edgeG :=
    parameter_contour_edge(I, Complex(F), addC, mulC, negC, curve, (fun (t : I) => g(curve(t))));
  have edges : forall x : I. forall y : I. forall tag : I. edgeF(x, y, tag) = edgeG(x, y, tag) {
    intro x, y, tag;
    exact cong(
      (
        fun (v : Complex(F)) => mulC(
          v, coordinate_difference(Complex(F), addC, negC, curve(x), curve(y))
        )
      ), same(tag)
    );
  }
  let sums :=
    sample_sum_cong(
      I, Complex(F), zeroC, addC, edgeF, edgeG, edges, subdivision_count(I, a, b, piece),
      subdivision_vertices(I, a, b, piece), subdivision_tags(I, a, b, piece)
    );
  exact trans(
    sym(curve_subdivision_sum_is_mapped(F, zero, one, addF, mulF, negF, lt, curve, f, a, b, piece)),
    trans(
      sums,
      curve_subdivision_sum_is_mapped(F, zero, one, addF, mulF, negF, lt, curve, g, a, b, piece)
    )
  );
}
