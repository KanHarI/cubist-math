import interval_weights;
import complete_fields;

// Inclusive endpoint bounds allow left and right endpoint tags.
def IntervalTagWithin(
  F : U1, zero one : F, lt : F -> F -> U0, a b tag : FieldUnitInterval(F, zero, one, lt)
) :=
  FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt, a),
    field_interval_coordinate(F, zero, one, lt, tag)
  )
  and FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt, tag),
    field_interval_coordinate(F, zero, one, lt, b)
  );

def field_between_close(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), a b x y : F,
  lowerX : FieldLe(F, lt, a, x), upperX : FieldLe(F, lt, x, b), lowerY : FieldLe(F, lt, a, y),
  upperY : FieldLe(F, lt, y, b), radius : F,
  small : lt(coordinate_difference(F, addF, negF, a, b), radius)
) :
  FieldClose(F, addF, lt, x, y, radius) {
  obtain (positiveOne, translate, scale, weakScale, ltLe, leLt, splitPositive) := arithmetic;
  let delta := coordinate_difference(F, addF, negF, a, b);
  obtain (forward, backward) := translate(delta, radius, a);
  let leftIdentity :=
    trans(
      ring_add_comm(F, zero, one, addF, mulF, negF, ring, delta, a),
      difference_add_back(F, zero, one, addF, mulF, negF, ring, a, b)
    );
  let shifted := along((fun (v : F) => lt(v, addF(radius, a)))) by leftIdentity from forward(small);
  let gap :=
    along lt(b) by ring_add_comm(F, zero, one, addF, mulF, negF, ring, radius, a) from shifted;
  let xBelow := leLt(x, b, addF(a, radius), upperX, gap);
  let yBelow := leLt(y, b, addF(a, radius), upperY, gap);
  exact (
    ltLe(
      x, addF(a, radius), addF(y, radius), xBelow,
      order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, a, y, radius, lowerY)
    ),
    ltLe(
      y, addF(a, radius), addF(x, radius), yBelow,
      order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, a, x, radius, lowerX)
    )
  );
}

def interval_tags_close(
  F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  a b x y : FieldUnitInterval(F, zero, one, lt),
  withinX : IntervalTagWithin(F, zero, one, lt, a, b, x),
  withinY : IntervalTagWithin(F, zero, one, lt, a, b, y), radius : F,
  small : lt(interval_difference(F, zero, one, addF, negF, lt, a, b), radius)
) :
  FieldClose(
    F, addF, lt, field_interval_coordinate(F, zero, one, lt, x),
    field_interval_coordinate(F, zero, one, lt, y), radius
  ) {
  obtain (lowerX, upperX) := withinX;
  obtain (lowerY, upperY) := withinY;
  let coordinate := field_interval_coordinate(F, zero, one, lt);
  exact field_between_close(
    F, zero, one, addF, mulF, negF, lt, ring, arithmetic, coordinate(a), coordinate(b),
    coordinate(x), coordinate(y), lowerX, upperX, lowerY, upperY, radius, small
  );
}
