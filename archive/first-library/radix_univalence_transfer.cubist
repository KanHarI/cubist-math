import radix_binary_equivalence;
import binary_univalence_transfer;
import radix_factorial;

// Compatibility identifies each transported algorithm with the already proved
// factorial on its target representation, rather than silently redefining it.
def binary_to_radix_factorial(extra n : Nat) :
  binary_to_radix(extra, binary_factorial(n)) = radix_factorial(extra, n) {
  exact radix_injective(
    extra, binary_to_radix(extra, binary_factorial(n)), radix_factorial(extra, n),
    trans(
      binary_radix_correct(extra, binary_factorial(n)),
      trans(binary_factorial_correct(n), sym(radix_factorial_correct(extra, n)))
    )
  );
}

def radix_to_binary_factorial(extra n : Nat) :
  radix_to_binary(extra, radix_factorial(extra, n)) = binary_factorial(n) {
  exact binary_injective(
    radix_to_binary(extra, radix_factorial(extra, n)), binary_factorial(n),
    trans(
      radix_binary_correct(extra, radix_factorial(extra, n)),
      trans(radix_factorial_correct(extra, n), sym(binary_factorial_correct(n)))
    )
  );
}

// Binary -> arbitrary radix, using the same binary proof for every radix.
def factorial_ten_binary_to_radix(extra : Nat) :
  radix_factorial(extra, 10) = binary_to_radix(extra, 0b1101110101111100000000) {
  exact trans(
    sym(binary_to_radix_factorial(extra, 10)),
    univalence_transfer_equality(
      BinaryNat, RadixNat(extra), binary_radix_equiv(extra), binary_factorial(10),
      0b1101110101111100000000, binary_factorial_ten
    )
  );
}

// Arbitrary radix -> binary, for any checked factorial value in that radix.
def factorial_ten_radix_to_binary(
  extra : Nat, value : RadixNat(extra), same : radix_factorial(extra, 10) = value
) :
  binary_factorial(10) = radix_to_binary(extra, value) {
  exact trans(
    sym(radix_to_binary_factorial(extra, 10)),
    univalence_transfer_equality(
      RadixNat(extra), BinaryNat, radix_binary_equiv(extra), radix_factorial(extra, 10), value, same
    )
  );
}

// Arbitrary radix -> unary Nat. The endpoint remains an unevaluated expression.
def factorial_ten_radix_to_nat(
  extra : Nat, value : RadixNat(extra), same : radix_factorial(extra, 10) = value
) :
  factorial(10) = radix_to_nat(extra, value) {
  exact trans(
    sym(radix_factorial_correct(extra, 10)),
    univalence_transfer_equality(
      RadixNat(extra), Nat, radix_nat_equiv(extra), radix_factorial(extra, 10), value, same
    )
  );
}

// Concrete manual decimal and generic-binary proofs transported to unary Nat.
def factorial_ten_from_base_ten : factorial(10) = radix_to_nat(8, base_ten_factorial_value_10) {
  exact factorial_ten_radix_to_nat(8, base_ten_factorial_value_10, radix_factorial_ten_base_ten);
}

def factorial_ten_from_base_two : factorial(10) = radix_to_nat(0, base_two_factorial_value_10) {
  exact factorial_ten_radix_to_nat(0, base_two_factorial_value_10, radix_factorial_ten_base_two);
}

// Digit certificates are independent of the factorial proofs.

def converted_ten_prefix_1 := base_ten_leading_3;

def converted_ten_value_1 : radix_positive_to_binary(8, converted_ten_prefix_1) = 0b11 {
  exact radix_binary_leading_beta(
    8,
    radix_digit_weaken(
      8,
      radix_digit_weaken(
        7,
        radix_digit_weaken(
          6, radix_digit_weaken(5, radix_digit_weaken(4, radix_digit_weaken(3, radix_digit_top(2))))
        )
      )
    )
  );
}

def converted_ten_prefix_2 := radix_append(8, base_ten_digit_6, converted_ten_prefix_1);

def converted_ten_value_2 : radix_positive_to_binary(8, converted_ten_prefix_2) = 0b100100 {
  exact radix_binary_append_value(
    8, base_ten_digit_6, converted_ten_prefix_1, 0b11, converted_ten_value_1
  );
}

def converted_ten_prefix_3 := radix_append(8, base_ten_digit_2, converted_ten_prefix_2);

def converted_ten_value_3 : radix_positive_to_binary(8, converted_ten_prefix_3) = 0b101101010 {
  exact radix_binary_append_value(
    8, base_ten_digit_2, converted_ten_prefix_2, 0b100100, converted_ten_value_2
  );
}

def converted_ten_prefix_4 := radix_append(8, base_ten_digit_8, converted_ten_prefix_3);

def converted_ten_value_4 : radix_positive_to_binary(8, converted_ten_prefix_4) = 0b111000101100 {
  exact radix_binary_append_value(
    8, base_ten_digit_8, converted_ten_prefix_3, 0b101101010, converted_ten_value_3
  );
}

def converted_ten_prefix_5 := radix_append(8, base_ten_digit_8, converted_ten_prefix_4);

def converted_ten_value_5 : radix_positive_to_binary(8, converted_ten_prefix_5) = 0b1000110111000000 {
  exact radix_binary_append_value(
    8, base_ten_digit_8, converted_ten_prefix_4, 0b111000101100, converted_ten_value_4
  );
}

def converted_ten_prefix_6 := radix_append(8, base_ten_digit_0, converted_ten_prefix_5);

def converted_ten_value_6 :
  radix_positive_to_binary(8, converted_ten_prefix_6) = 0b1011000100110000000 {
  exact radix_binary_append_value(
    8, base_ten_digit_0, converted_ten_prefix_5, 0b1000110111000000, converted_ten_value_5
  );
}

def converted_ten_prefix_7 := radix_append(8, base_ten_digit_0, converted_ten_prefix_6);

def converted_ten_value_7 :
  radix_positive_to_binary(8, converted_ten_prefix_7) = 0b1101110101111100000000 {
  exact radix_binary_append_value(
    8, base_ten_digit_0, converted_ten_prefix_6, 0b1011000100110000000, converted_ten_value_6
  );
}

def base_ten_3628800_to_binary :
  radix_to_binary(8, base_ten_factorial_value_10) = 0b1101110101111100000000 {
  exact trans(radix_binary_positive_beta(8, converted_ten_prefix_7), converted_ten_value_7);
}

def factorial_ten_base_ten_to_binary : binary_factorial(10) = 0b1101110101111100000000 {
  exact trans(
    factorial_ten_radix_to_binary(8, base_ten_factorial_value_10, radix_factorial_ten_base_ten),
    base_ten_3628800_to_binary
  );
}

def factorial_ten_binary_to_base_ten : radix_factorial(8, 10) = base_ten_factorial_value_10 {
  exact trans(
    factorial_ten_binary_to_radix(8),
    trans(
      cong(binary_to_radix(8), sym(base_ten_3628800_to_binary)),
      radix_binary_roundtrip(8, base_ten_factorial_value_10)
    )
  );
}

