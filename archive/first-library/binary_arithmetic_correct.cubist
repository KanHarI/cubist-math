import binary_equivalence;

// Small scalar identities used to check the four digit-addition cases.
def nat_add_one(n : Nat) : n + 1 = succ(n) {
  exact trans(nat_add_succ(n, 0), cong(succ, nat_add_zero(n)));
}

def nat_double_add(a, b : Nat) : (a + b) + (a + b) = (a + a) + (b + b) {
  calc {
    (a + b) + (a + b) = a + (b + (a + b)) by nat_add_assoc(a, b, a + b);
    _ = a + (a + (b + b)) by cong(add(a), nat_add_shuffle(b, a, b));
    _ = (a + a) + (b + b) by sym(nat_add_assoc(a, a, b + b));
  }
}

def BinaryAddCorrect(p, q : BinaryPositive) :=
  binary_positive_to_nat(binary_positive_add(p, q)) = binary_positive_to_nat(p) + binary_positive_to_nat(
    q
  );

def binary_add_right_one(
  p : BinaryPositive, same : binary_positive_add(p, binary_one) = binary_positive_succ(p)
) :
  BinaryAddCorrect(p, binary_one) {
  exact trans(
    cong(binary_positive_to_nat, same),
    trans(binary_decode_positive_succ(p), sym(nat_add_one(binary_positive_to_nat(p))))
  );
}

def binary_add_even_even(p, q : BinaryPositive, ih : BinaryAddCorrect(p, q)) :
  BinaryAddCorrect(binary_bit0(p), binary_bit0(q)) {
  exact trans(
    binary_decode_even(binary_positive_add(p, q)),
    trans(
      cong((fun (v : Nat) => v + v), ih),
      nat_double_add(binary_positive_to_nat(p), binary_positive_to_nat(q))
    )
  );
}

def binary_add_even_odd(p, q : BinaryPositive, ih : BinaryAddCorrect(p, q)) :
  BinaryAddCorrect(binary_bit0(p), binary_bit1(q)) {
  exact trans(
    binary_decode_odd(binary_positive_add(p, q)),
    trans(
      cong((fun (v : Nat) => succ(v + v)), ih),
      trans(
        cong(succ, nat_double_add(binary_positive_to_nat(p), binary_positive_to_nat(q))),
        sym(
          nat_add_succ(
            binary_positive_to_nat(p) + binary_positive_to_nat(p),
            binary_positive_to_nat(q) + binary_positive_to_nat(q)
          )
        )
      )
    )
  );
}

def binary_add_odd_even(p, q : BinaryPositive, ih : BinaryAddCorrect(p, q)) :
  BinaryAddCorrect(binary_bit1(p), binary_bit0(q)) {
  exact trans(
    binary_decode_odd(binary_positive_add(p, q)),
    trans(
      cong((fun (v : Nat) => succ(v + v)), ih),
      cong(succ, nat_double_add(binary_positive_to_nat(p), binary_positive_to_nat(q)))
    )
  );
}

def binary_add_odd_odd(p, q : BinaryPositive, ih : BinaryAddCorrect(p, q)) :
  BinaryAddCorrect(binary_bit1(p), binary_bit1(q)) {
  let a := binary_positive_to_nat(p);
  let b := binary_positive_to_nat(q);
  let sum := binary_positive_to_nat(binary_positive_add(p, q));
  exact trans(
    binary_decode_even(binary_positive_succ(binary_positive_add(p, q))),
    trans(
      cong((fun (v : Nat) => v + v), binary_decode_positive_succ(binary_positive_add(p, q))),
      trans(
        cong(succ, nat_add_succ(sum, sum)),
        trans(
          cong((fun (v : Nat) => succ(succ(v + v))), ih),
          trans(
            cong((fun (v : Nat) => succ(succ(v))), nat_double_add(a, b)),
            cong(succ, sym(nat_add_succ(a + a, b + b)))
          )
        )
      )
    )
  );
}

def binary_decode_add_even(
  p : BinaryPositive, ih : forall q : BinaryPositive. BinaryAddCorrect(p, q), q : BinaryPositive
) :
  BinaryAddCorrect(binary_bit0(p), q) {
  exact binary_positive_induction(
    BinaryAddCorrect(binary_bit0(p)),
    binary_add_right_one(binary_bit0(p), refl(binary_positive_succ(binary_bit0(p)))),
    (
      fun (r : BinaryPositive, ignored : BinaryAddCorrect(binary_bit0(p), r)) => binary_add_even_even(
        p, r, ih(r)
      )
    ),
    (
      fun (r : BinaryPositive, ignored : BinaryAddCorrect(binary_bit0(p), r)) => binary_add_even_odd(
        p, r, ih(r)
      )
    ), q
  );
}

def binary_decode_add_odd(
  p : BinaryPositive, ih : forall q : BinaryPositive. BinaryAddCorrect(p, q), q : BinaryPositive
) :
  BinaryAddCorrect(binary_bit1(p), q) {
  exact binary_positive_induction(
    BinaryAddCorrect(binary_bit1(p)),
    binary_add_right_one(binary_bit1(p), refl(binary_positive_succ(binary_bit1(p)))),
    (
      fun (r : BinaryPositive, ignored : BinaryAddCorrect(binary_bit1(p), r)) => binary_add_odd_even(
        p, r, ih(r)
      )
    ),
    (
      fun (r : BinaryPositive, ignored : BinaryAddCorrect(binary_bit1(p), r)) => binary_add_odd_odd(
        p, r, ih(r)
      )
    ), q
  );
}

def binary_decode_positive_add(p : BinaryPositive) :
  forall q : BinaryPositive. BinaryAddCorrect(p, q) {
  exact binary_positive_induction(
    (fun (a : BinaryPositive) => forall b : BinaryPositive. BinaryAddCorrect(a, b)),
    binary_decode_positive_succ, binary_decode_add_even, binary_decode_add_odd, p
  );
}

def binary_decode_add(a, b : BinaryNat) :
  binary_to_nat(binary_add(a, b)) = binary_to_nat(a) + binary_to_nat(b) {
  exact match a as x return (binary_to_nat(binary_add(x, b)) = binary_to_nat(x) + binary_to_nat(b)) {
    left zero => refl(binary_to_nat(b));
    right p => match b as y return (
      binary_to_nat(binary_add(binary_positive(p), y)) = binary_positive_to_nat(p) + binary_to_nat(
        y
      )
    ) {
      left zero => sym(nat_add_zero(binary_positive_to_nat(p)));
      right q => binary_decode_positive_add(p, q);
    };
  };
}

def BinaryMulCorrect(p, q : BinaryPositive) :=
  binary_positive_to_nat(binary_positive_mul(p, q)) = binary_positive_to_nat(p) * binary_positive_to_nat(
    q
  );

def binary_mul_even(p, q : BinaryPositive, ih : BinaryMulCorrect(p, q)) :
  BinaryMulCorrect(binary_bit0(p), q) {
  exact trans(
    binary_decode_even(binary_positive_mul(p, q)),
    trans(
      cong((fun (v : Nat) => v + v), ih),
      sym(
        nat_mul_add(binary_positive_to_nat(p), binary_positive_to_nat(p), binary_positive_to_nat(q))
      )
    )
  );
}

def binary_mul_odd(p, q : BinaryPositive, ih : BinaryMulCorrect(p, q)) :
  BinaryMulCorrect(binary_bit1(p), q) {
  exact trans(
    binary_decode_positive_add(q, binary_bit0(binary_positive_mul(p, q))),
    cong(
      add(binary_positive_to_nat(q)),
      trans(
        binary_decode_even(binary_positive_mul(p, q)),
        trans(
          cong((fun (v : Nat) => v + v), ih),
          sym(
            nat_mul_add(
              binary_positive_to_nat(p), binary_positive_to_nat(p), binary_positive_to_nat(q)
            )
          )
        )
      )
    )
  );
}

def binary_decode_positive_mul(p, q : BinaryPositive) : BinaryMulCorrect(p, q) {
  exact binary_positive_induction(
    (fun (a : BinaryPositive) => BinaryMulCorrect(a, q)),
    sym(nat_add_zero(binary_positive_to_nat(q))),
    (fun (a : BinaryPositive, ih : BinaryMulCorrect(a, q)) => binary_mul_even(a, q, ih)),
    (fun (a : BinaryPositive, ih : BinaryMulCorrect(a, q)) => binary_mul_odd(a, q, ih)), p
  );
}

def binary_decode_mul(a, b : BinaryNat) :
  binary_to_nat(binary_mul(a, b)) = binary_to_nat(a) * binary_to_nat(b) {
  exact match a as x return (binary_to_nat(binary_mul(x, b)) = binary_to_nat(x) * binary_to_nat(b)) {
    left zero => refl(0);
    right p => match b as y return (
      binary_to_nat(binary_mul(binary_positive(p), y)) = binary_positive_to_nat(p) * binary_to_nat(
        y
      )
    ) {
      left zero => sym(nat_mul_zero(binary_positive_to_nat(p)));
      right q => binary_decode_positive_mul(p, q);
    };
  };
}

def binary_factorial_correct(n : Nat) : binary_to_nat(binary_factorial(n)) = factorial(n) {
  exact induction n as k return (binary_to_nat(binary_factorial(k)) = factorial(k)) {
    zero => refl(1);
    succ previous => trans(
      cong(binary_to_nat, binary_factorial_step(k)),
      trans(
        binary_decode_mul(binary_of_nat(succ(k)), binary_factorial(k)),
        trans(
          cong(
            (fun (v : Nat) => v * binary_to_nat(binary_factorial(k))), binary_nat_roundtrip(succ(k))
          ), cong(mul(succ(k)), previous)
        )
      )
    );
  };
}

// The right side denotes 3628800 in unary Nat but remains a compact expression.
// This manual transfer uses the proved compatibility theorem. It is not yet
// the computational cubical-univalence transport regression.
def nat_3628800 := binary_to_nat(0b1101110101111100000000);

def factorial_ten_from_binary : factorial(10) = nat_3628800 {
  exact trans(sym(binary_factorial_correct(10)), cong(binary_to_nat, binary_factorial_ten));
}
