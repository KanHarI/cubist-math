import nat;
import polynomial_division_unique;

// Ideals are proposition-valued subsets, with explicit closure evidence.
def PolynomialIdealLaws(K : AlgebraicField, P : Polynomial(K) -> U0) :=
  (forall p : Polynomial(K). Proposition(P(p))) and P(polynomial_zero(K))
  and (
    forall p : Polynomial(K). forall q : Polynomial(K). P(p) -> P(q) -> P(polynomial_add(K, p, q))
  ) and (forall a : Polynomial(K). forall p : Polynomial(K). P(p) -> P(polynomial_mul(K, a, p)));

def PolynomialIdeal(K : AlgebraicField) :=
  exists P : Polynomial(K) -> U0. PolynomialIdealLaws(K, P);

def polynomial_ideal_members(K : AlgebraicField, I : PolynomialIdeal(K)) :=
  field_first((Polynomial(K) -> U0), PolynomialIdealLaws(K), I);

def polynomial_ideal_laws(K : AlgebraicField, I : PolynomialIdeal(K)) :=
  field_second((Polynomial(K) -> U0), PolynomialIdealLaws(K), I);

def polynomial_ideal_prop(K : AlgebraicField, I : PolynomialIdeal(K)) :
  forall p : Polynomial(K). Proposition(polynomial_ideal_members(K, I, p)) {
  obtain (prop_, zero, add, mul) := polynomial_ideal_laws(K, I);
  exact prop_;
}

def polynomial_ideal_zero(K : AlgebraicField, I : PolynomialIdeal(K)) :
  polynomial_ideal_members(K, I, polynomial_zero(K)) {
  obtain (prop_, zero, add, mul) := polynomial_ideal_laws(K, I);
  exact zero;
}

def polynomial_ideal_add(K : AlgebraicField, I : PolynomialIdeal(K)) :
  forall p : Polynomial(K). forall q : Polynomial(K). polynomial_ideal_members(K, I, p)
  -> polynomial_ideal_members(K, I, q) -> polynomial_ideal_members(K, I, polynomial_add(K, p, q)) {
  obtain (prop_, zero, add, mul) := polynomial_ideal_laws(K, I);
  exact add;
}

def polynomial_ideal_mul(K : AlgebraicField, I : PolynomialIdeal(K)) :
  forall a : Polynomial(K). forall p : Polynomial(K). polynomial_ideal_members(K, I, p)
  -> polynomial_ideal_members(K, I, polynomial_mul(K, a, p)) {
  obtain (prop_, zero, add, mul) := polynomial_ideal_laws(K, I);
  exact mul;
}

def PolynomialNonzero(K : AlgebraicField, p : Polynomial(K)) := (p = polynomial_zero(K)) -> Void;

def PolynomialDivides(K : AlgebraicField, divisor, p : Polynomial(K)) :=
  Mere(exists q : Polynomial(K). p = polynomial_mul(K, divisor, q));

def polynomial_divides_prop(K : AlgebraicField, divisor, p : Polynomial(K)) :=
  mere_is_prop(exists q : Polynomial(K). p = polynomial_mul(K, divisor, q));

def polynomial_ideal_neg(
  K : AlgebraicField, I : PolynomialIdeal(K), p : Polynomial(K),
  member : polynomial_ideal_members(K, I, p)
) :
  polynomial_ideal_members(K, I, polynomial_neg(K, p)) {
  let minusOne := polynomial_neg(K, polynomial_one(K));
  exact transport polynomial_ideal_mul(K, I, minusOne, p, member) along trans(
    polynomial_neg_mul(K, polynomial_one(K), p), cong(polynomial_neg(K), polynomial_mul_one(K, p))
  ) in polynomial_ideal_members(K, I);
}

def polynomial_ideal_remainder(
  K : AlgebraicField, I : PolynomialIdeal(K), p, divisor, q, r : Polynomial(K),
  equation : p = polynomial_add(K, polynomial_mul(K, q, divisor), r),
  memberP : polynomial_ideal_members(K, I, p), memberD : polynomial_ideal_members(K, I, divisor)
) :
  polynomial_ideal_members(K, I, r) {
  let product := polynomial_mul(K, q, divisor);
  let difference := polynomial_subtract(K, p, product);
  let recombine : polynomial_add(K, product, difference) = p :=
    trans(
      cong(polynomial_add(K, product), polynomial_add_comm(K, p, polynomial_neg(K, product))),
      polynomial_add_cancel_prefix(K, product, p)
    );
  let same :=
    group_cancel_left(
      PolynomialAdditiveGroup(K), product, difference, r, trans(recombine, equation)
    );
  exact transport polynomial_ideal_add(
    K, I, p, polynomial_neg(K, product), memberP,
    polynomial_ideal_neg(K, I, product, polynomial_ideal_mul(K, I, q, divisor, memberD))
  ) along same in polynomial_ideal_members(K, I);
}

def ideal_minimal_divides(
  K : AlgebraicField, I : PolynomialIdeal(K), g : Polynomial(K),
  memberG : polynomial_ideal_members(K, I, g), nonzero : PolynomialNonzero(K, g),
  minimal : (
    forall r : Polynomial(K). polynomial_ideal_members(K, I, r) -> PolynomialNonzero(K, r)
    -> le(polynomial_cutoff(K, g), polynomial_cutoff(K, r))
  ), p : Polynomial(K), member : polynomial_ideal_members(K, I, p)
) :
  PolynomialDivides(K, g, p) {
  obtain (d, degree) := polynomial_nonzero_degree(K, g, nonzero);
  obtain (q, r, equation, support) := divide_by_degree(K, p, g, d, degree);
  let memberR := polynomial_ideal_remainder(K, I, p, g, q, r, equation, member, memberG);
  let zero : r = polynomial_zero(K) {
    let impossible : PolynomialNonzero(K, r) -> Void {
      intro nr;
      let below :=
        nat_le_trans(
          polynomial_cutoff(K, g), polynomial_cutoff(K, r), d, minimal(r, memberR, nr),
          polynomial_cutoff_least(K, r, d, support)
        );
      exact successor_not_le_self(d, transport below along degree in ((fun (n : Nat) => le(n, d))));
    }
    exact double_negation(
      r = polynomial_zero(K), polynomial_set(K, r, polynomial_zero(K)), impossible
    );
  }
  exact merely(
    (exists a : Polynomial(K). p = polynomial_mul(K, g, a)),
    typed(
      (exists a : Polynomial(K). p = polynomial_mul(K, g, a)),
      (
        q,
        trans(
          equation,
          trans(
            cong(polynomial_add(K, polynomial_mul(K, q, g)), zero),
            trans(
              polynomial_add_zero_right(K, polynomial_mul(K, q, g)), polynomial_mul_comm(K, q, g)
            )
          )
        )
      )
    )
  );
}

def IdealPrincipalGenerator(K : AlgebraicField, I : PolynomialIdeal(K)) :=
  exists g : Polynomial(K). polynomial_ideal_members(K, I, g) and PolynomialNonzero(K, g)
  and (forall p : Polynomial(K). polynomial_ideal_members(K, I, p) -> PolynomialDivides(K, g, p));

def IdealCutoffWitness(K : AlgebraicField, I : PolynomialIdeal(K), n : Nat) :=
  exists g : Polynomial(K). polynomial_ideal_members(K, I, g) and PolynomialNonzero(K, g)
  and (polynomial_cutoff(K, g) = n);

// A nonzero ideal is generated by a polynomial of least positive cutoff.
// Division proves generation; it is not included as an assumption.
def polynomial_ideal_principal(
  K : AlgebraicField, I : PolynomialIdeal(K),
  inhabited : Mere(
    exists g : Polynomial(K). polynomial_ideal_members(K, I, g) and PolynomialNonzero(K, g)
  )
) :
  Mere(IdealPrincipalGenerator(K, I)) {
  let P := fun (n : Nat) => Mere(IdealCutoffWitness(K, I, n));
  let candidate :
    (exists g : Polynomial(K). polynomial_ideal_members(K, I, g) and PolynomialNonzero(K, g))
    -> (exists n : Nat. P(n)) {
    intro witness_;
    obtain (g, member, nonzero) := witness_;
    exact (
      polynomial_cutoff(K, g),
      merely(
        IdealCutoffWitness(K, I, polynomial_cutoff(K, g)),
        typed(
          IdealCutoffWitness(K, I, polynomial_cutoff(K, g)),
          (g, member, nonzero, refl(polynomial_cutoff(K, g)))
        )
      )
    );
  }
  let minima :=
    natural_minimum(
      P, (fun (n : Nat) => mere_is_prop(IdealCutoffWitness(K, I, n))),
      mere_map(
        (exists g : Polynomial(K). polynomial_ideal_members(K, I, g) and PolynomialNonzero(K, g)),
        (exists n : Nat. P(n)), candidate, inhabited
      )
    );
  obtain (n, pn, least) := minima;
  let generate : IdealCutoffWitness(K, I, n) -> IdealPrincipalGenerator(K, I) {
    intro witness_;
    obtain (g, member, nonzero, same) := witness_;
    let minimal :
      forall r : Polynomial(K). polynomial_ideal_members(K, I, r) -> PolynomialNonzero(K, r)
      -> le(polynomial_cutoff(K, g), polynomial_cutoff(K, r)) {
      intro r, mr, nr;
      let cr := polynomial_cutoff(K, r);
      let candidateR :=
        merely(
          IdealCutoffWitness(K, I, cr), typed(IdealCutoffWitness(K, I, cr), (r, mr, nr, refl(cr)))
        );
      exact transport least(cr, candidateR) along sym(same) in ((fun (k : Nat) => le(k, cr)));
    }
    exact (g, member, nonzero, ideal_minimal_divides(K, I, g, member, nonzero, minimal));
  }
  exact mere_map(IdealCutoffWitness(K, I, n), IdealPrincipalGenerator(K, I), generate, pn);
}
