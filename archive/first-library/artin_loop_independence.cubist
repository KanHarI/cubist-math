import artin_finite_relations;
import artin_fixed_embeddings;

def extension_loop_embedding_action(
  K : AlgebraicField, E : FieldExt(K), p : E =[FieldExt(K)] E, x : extension_carrier(K, E)
) :
  field_embedding_map(
    extension_field(K, E), extension_field(K, E),
    galois_field_embedding(K, E, extension_path_iso(K, E, E, p)), x
  ) = (along extension_carrier(K) by p from x) {
  exact with unfolding [galois_field_embedding, field_embedding_map] {
    sym(extension_transport_forward(K, E, E, p, x))
  };
}

def extension_loop_embeddings_distinct(
  K : AlgebraicField, E : FieldExt(K), p, q : E =[FieldExt(K)] E, different : (p = q) -> Void
) :
  (
    galois_field_embedding(K, E, extension_path_iso(K, E, E, p)) = galois_field_embedding(
      K, E, extension_path_iso(K, E, E, q)
    )
  ) -> Void {
  intro same;
  exact different(
    trans(
      sym(extension_path_roundtrip(K, E, E, p)),
      trans(
        cong(
          extension_iso_path(K, E, E),
          galois_field_embedding_injective(
            K, E, extension_path_iso(K, E, E, p), extension_path_iso(K, E, E, q), same
          )
        ), extension_path_roundtrip(K, E, E, q)
      )
    )
  );
}

def extension_loop_embedding_injective(
  K : AlgebraicField, E : FieldExt(K), p, q : E =[FieldExt(K)] E,
  same : galois_field_embedding(K, E, extension_path_iso(K, E, E, p)) = galois_field_embedding(
    K, E, extension_path_iso(K, E, E, q)
  )
) :
  p = q {
  exact trans(
    sym(extension_path_roundtrip(K, E, E, p)),
    trans(
      cong(
        extension_iso_path(K, E, E),
        galois_field_embedding_injective(
          K, E, extension_path_iso(K, E, E, p), extension_path_iso(K, E, E, q), same
        )
      ), extension_path_roundtrip(K, E, E, q)
    )
  );
}

def extension_loop_relation_to_embeddings(
  K : AlgebraicField, E : FieldExt(K), p, q : E =[FieldExt(K)] E, a, b : extension_carrier(K, E),
  relation : forall x : extension_carrier(K, E).
  field_add(
    extension_field(K, E),
    field_mul(extension_field(K, E), a, along extension_carrier(K) by p from x),
    field_mul(extension_field(K, E), b, along extension_carrier(K) by q from x)
  ) = field_zero(extension_field(K, E)), x : extension_carrier(K, E)
) :
  field_add(
    extension_field(K, E),
    field_mul(
      extension_field(K, E), a,
      field_embedding_map(
        extension_field(K, E), extension_field(K, E),
        galois_field_embedding(K, E, extension_path_iso(K, E, E, p)), x
      )
    ),
    field_mul(
      extension_field(K, E), b,
      field_embedding_map(
        extension_field(K, E), extension_field(K, E),
        galois_field_embedding(K, E, extension_path_iso(K, E, E, q)), x
      )
    )
  ) = field_zero(extension_field(K, E)) {
  let F := extension_field(K, E);
  let g := galois_field_embedding(K, E, extension_path_iso(K, E, E, q));
  exact trans(
    cong(
      (
        fun (y : af_carrier(F)) => field_add(
          F, field_mul(F, a, y), field_mul(F, b, field_embedding_map(F, F, g, x))
        )
      ), extension_loop_embedding_action(K, E, p, x)
    ),
    trans(
      cong(
        (
          fun (y : af_carrier(F)) => field_add(
            F, field_mul(F, a, along extension_carrier(K) by p from x), field_mul(F, b, y)
          )
        ), extension_loop_embedding_action(K, E, q, x)
      ), relation(x)
    )
  );
}

// Two genuinely different extension loops act as linearly independent field
// maps on the extension carrier. The action is transport in FieldExt(K).
def distinct_extension_loops_two_independent(
  K : AlgebraicField, E : FieldExt(K), p, q : E =[FieldExt(K)] E, different : (p = q) -> Void,
  a, b : extension_carrier(K, E), relation : forall x : extension_carrier(K, E).
  field_add(
    extension_field(K, E),
    field_mul(extension_field(K, E), a, along extension_carrier(K) by p from x),
    field_mul(extension_field(K, E), b, along extension_carrier(K) by q from x)
  ) = field_zero(extension_field(K, E))
) :
  (a = field_zero(extension_field(K, E))) and (b = field_zero(extension_field(K, E))) {
  let F := extension_field(K, E);
  let e := extension_path_iso(K, E, E, p);
  let d := extension_path_iso(K, E, E, q);
  let f := galois_field_embedding(K, E, e);
  let g := galois_field_embedding(K, E, d);
  let distinct := extension_loop_embeddings_distinct(K, E, p, q, different);
  have embeddingRelation :
    forall x : af_carrier(F).
    field_add(
      F, field_mul(F, a, field_embedding_map(F, F, f, x)),
      field_mul(F, b, field_embedding_map(F, F, g, x))
    ) = field_zero(F) {
    intro x;
    exact extension_loop_relation_to_embeddings(K, E, p, q, a, b, relation, x);
  }
  exact distinct_embeddings_two_independent(F, F, f, g, distinct, a, b, embeddingRelation);
}

// Dedekind independence in the loop presentation, for any finite family.
// The loop action is the actual carrier transport, with no truncation of paths.
def distinct_extension_loops_independent(
  n : Nat, K : AlgebraicField, E : FieldExt(K), loops : Fin(n) -> (E =[FieldExt(K)] E),
  distinct : forall i : Fin(n). forall j : Fin(n). loops(i) = loops(j) -> i = j,
  coefficients : Fin(n) -> extension_carrier(K, E), relation : forall x : extension_carrier(K, E).
  field_sum(
    extension_field(K, E), n,
    (
      fun (i : Fin(n)) => field_mul(
        extension_field(K, E), coefficients(i), along extension_carrier(K) by loops(i) from x
      )
    )
  ) = field_zero(extension_field(K, E))
) :
  forall i : Fin(n). coefficients(i) = field_zero(extension_field(K, E)) {
  let F := extension_field(K, E);
  let maps :=
    fun (i : Fin(n)) => galois_field_embedding(K, E, extension_path_iso(K, E, E, loops(i)));
  have mapsDistinct : PairwiseDistinctEmbeddings(F, F, n, maps) {
    intro i, j, same;
    exact distinct(i, j, extension_loop_embedding_injective(K, E, loops(i), loops(j), same));
  }
  have embeddingRelation :
    forall x : af_carrier(F). hom_family_sum(F, F, n, maps, coefficients, x) = field_zero(F) {
    intro x;
    exact trans(
      field_sum_cong(
        F, n,
        (fun (i : Fin(n)) => field_mul(F, coefficients(i), field_embedding_map(F, F, maps(i), x))),
        (
          fun (i : Fin(n)) => field_mul(
            F, coefficients(i), along extension_carrier(K) by loops(i) from x
          )
        ),
        (
          fun (i : Fin(n)) => cong(
            field_mul(F, coefficients(i)), extension_loop_embedding_action(K, E, loops(i), x)
          )
        )
      ), relation(x)
    );
  }
  exact distinct_field_embeddings_independent(
    n, F, F, maps, mapsDistinct, coefficients, embeddingRelation
  );
}
