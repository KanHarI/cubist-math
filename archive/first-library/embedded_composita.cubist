import subfield_composita;
import field_embedding_image;

// A compositum depends on the two specified embeddings into a common field.
// Its carrier is the subtype of the ambient field generated by their images.
def embedded_compositum_subfield(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)
) :=
  compositum(
    O, subfield_image(K, O, ko, subfield_top(K)), subfield_image(L, O, lo, subfield_top(L))
  );

def EmbeddedCompositum(K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)) :=
  subfield_as_field(O, embedded_compositum_subfield(K, L, O, ko, lo));

def embedded_compositum_left_lands(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O), x : af_carrier(K)
) :
  subfield_members(
    O, embedded_compositum_subfield(K, L, O, ko, lo), field_embedding_map(K, O, ko, x)
  ) {
  exact compositum_contains_left(
    O, subfield_image(K, O, ko, subfield_top(K)), subfield_image(L, O, lo, subfield_top(L)),
    field_embedding_map(K, O, ko, x), field_embedding_lands_in_image(K, O, ko, x)
  );
}

def embedded_compositum_right_lands(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O), x : af_carrier(L)
) :
  subfield_members(
    O, embedded_compositum_subfield(K, L, O, ko, lo), field_embedding_map(L, O, lo, x)
  ) {
  exact compositum_contains_right(
    O, subfield_image(K, O, ko, subfield_top(K)), subfield_image(L, O, lo, subfield_top(L)),
    field_embedding_map(L, O, lo, x), field_embedding_lands_in_image(L, O, lo, x)
  );
}

def embedded_compositum_left(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)
) :=
  field_embedding_factor(
    K, O, ko, embedded_compositum_subfield(K, L, O, ko, lo),
    embedded_compositum_left_lands(K, L, O, ko, lo)
  );

def embedded_compositum_right(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)
) :=
  field_embedding_factor(
    L, O, lo, embedded_compositum_subfield(K, L, O, ko, lo),
    embedded_compositum_right_lands(K, L, O, ko, lo)
  );

def embedded_compositum_inclusion(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)
) :=
  subfield_inclusion(O, embedded_compositum_subfield(K, L, O, ko, lo));

def embedded_compositum_left_triangle(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)
) :
  FieldTower(
    K, EmbeddedCompositum(K, L, O, ko, lo), O, embedded_compositum_left(K, L, O, ko, lo),
    embedded_compositum_inclusion(K, L, O, ko, lo), ko
  ) {
  exact field_embedding_factor_triangle(
    K, O, ko, embedded_compositum_subfield(K, L, O, ko, lo),
    embedded_compositum_left_lands(K, L, O, ko, lo)
  );
}

def embedded_compositum_right_triangle(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)
) :
  FieldTower(
    L, EmbeddedCompositum(K, L, O, ko, lo), O, embedded_compositum_right(K, L, O, ko, lo),
    embedded_compositum_inclusion(K, L, O, ko, lo), lo
  ) {
  exact field_embedding_factor_triangle(
    L, O, lo, embedded_compositum_subfield(K, L, O, ko, lo),
    embedded_compositum_right_lands(K, L, O, ko, lo)
  );
}

// If the two ambient embeddings agree on a common base, the embeddings into
// the compositum agree there too. Compatibility is an explicit hypothesis.
def embedded_compositum_base_agreement(
  B, K, L, O : AlgebraicField, bk : FieldEmbedding(B, K), bl : FieldEmbedding(B, L),
  bo : FieldEmbedding(B, O), ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O),
  leftTower : FieldTower(B, K, O, bk, ko, bo), rightTower : FieldTower(B, L, O, bl, lo, bo)
) :
  field_embedding_compose(
    B, K, EmbeddedCompositum(K, L, O, ko, lo), bk, embedded_compositum_left(K, L, O, ko, lo)
  ) =[FieldEmbedding(B, EmbeddedCompositum(K, L, O, ko, lo))] field_embedding_compose(
    B, L, EmbeddedCompositum(K, L, O, ko, lo), bl, embedded_compositum_right(K, L, O, ko, lo)
  ) {
  let C := EmbeddedCompositum(K, L, O, ko, lo);
  let S := embedded_compositum_subfield(K, L, O, ko, lo);
  let viaK := field_embedding_compose(B, K, C, bk, embedded_compositum_left(K, L, O, ko, lo));
  let viaL := field_embedding_compose(B, L, C, bl, embedded_compositum_right(K, L, O, ko, lo));
  exact field_embedding_ext(
    B, C, viaK, viaL,
    (
      fun (x : af_carrier(B)) => subfield_value_ext(
        O, S, field_embedding_map(B, C, viaK, x), field_embedding_map(B, C, viaL, x),
        trans(
          cong((fun (e : FieldEmbedding(B, O)) => field_embedding_map(B, O, e, x)), leftTower),
          sym(cong((fun (e : FieldEmbedding(B, O)) => field_embedding_map(B, O, e, x)), rightTower))
        )
      )
    )
  );
}

// The chosen base embedding uses the left factor; the preceding theorem
// makes this independent of that choice whenever the ambient square commutes.
def embedded_compositum_base(
  B, K, L, O : AlgebraicField, bk : FieldEmbedding(B, K), ko : FieldEmbedding(K, O),
  lo : FieldEmbedding(L, O)
) :=
  field_embedding_compose(
    B, K, EmbeddedCompositum(K, L, O, ko, lo), bk, embedded_compositum_left(K, L, O, ko, lo)
  );

def embedded_compositum_base_triangle(
  B, K, L, O : AlgebraicField, bk : FieldEmbedding(B, K), bo : FieldEmbedding(B, O),
  ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O), commute : FieldTower(B, K, O, bk, ko, bo)
) :
  FieldTower(
    B, EmbeddedCompositum(K, L, O, ko, lo), O, embedded_compositum_base(B, K, L, O, bk, ko, lo),
    embedded_compositum_inclusion(K, L, O, ko, lo), bo
  ) {
  let M := EmbeddedCompositum(K, L, O, ko, lo);
  let bm := embedded_compositum_base(B, K, L, O, bk, ko, lo);
  let mo := embedded_compositum_inclusion(K, L, O, ko, lo);
  exact field_embedding_ext(
    B, O, field_embedding_compose(B, M, O, bm, mo), bo,
    (
      fun (x : af_carrier(B)) => cong(
        (fun (e : FieldEmbedding(B, O)) => field_embedding_map(B, O, e, x)), commute
      )
    )
  );
}

def embedded_compositum_least(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O), S : Subfield(O),
  containsK : (forall x : af_carrier(K). subfield_members(O, S, field_embedding_map(K, O, ko, x))),
  containsL : (forall x : af_carrier(L). subfield_members(O, S, field_embedding_map(L, O, lo, x)))
) :
  SubfieldIncluded(O, embedded_compositum_subfield(K, L, O, ko, lo), S) {
  have imageK : SubfieldIncluded(O, subfield_image(K, O, ko, subfield_top(K)), S) {
    intro y, member;
    obtain (x, inTop, same) := typed(SubfieldImage(K, O, ko, subfield_top(K), y), member);
    exact along subfield_members(O, S) by same from containsK(x);
  }
  have imageL : SubfieldIncluded(O, subfield_image(L, O, lo, subfield_top(L)), S) {
    intro y, member;
    obtain (x, inTop, same) := typed(SubfieldImage(L, O, lo, subfield_top(L), y), member);
    exact along subfield_members(O, S) by same from containsL(x);
  }
  exact compositum_least(
    O, subfield_image(K, O, ko, subfield_top(K)), subfield_image(L, O, lo, subfield_top(L)), S,
    imageK, imageL
  );
}

// Leastness also gives the specified field embedding into every ambient
// subfield containing both factors, with its commuting triangle.
def embedded_compositum_factor(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O), S : Subfield(O),
  containsK : (forall x : af_carrier(K). subfield_members(O, S, field_embedding_map(K, O, ko, x))),
  containsL : (forall x : af_carrier(L). subfield_members(O, S, field_embedding_map(L, O, lo, x)))
) :=
  field_embedding_factor(
    EmbeddedCompositum(K, L, O, ko, lo), O, embedded_compositum_inclusion(K, L, O, ko, lo), S,
    (
      fun (x : af_carrier(EmbeddedCompositum(K, L, O, ko, lo))) => embedded_compositum_least(
        K, L, O, ko, lo, S, containsK, containsL,
        subfield_value(O, embedded_compositum_subfield(K, L, O, ko, lo), x),
        subfield_evidence(O, embedded_compositum_subfield(K, L, O, ko, lo), x)
      )
    )
  );

def embedded_compositum_factor_triangle(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O), S : Subfield(O),
  containsK : (forall x : af_carrier(K). subfield_members(O, S, field_embedding_map(K, O, ko, x))),
  containsL : (forall x : af_carrier(L). subfield_members(O, S, field_embedding_map(L, O, lo, x)))
) :
  FieldTower(
    EmbeddedCompositum(K, L, O, ko, lo), subfield_as_field(O, S), O,
    embedded_compositum_factor(K, L, O, ko, lo, S, containsK, containsL), subfield_inclusion(O, S),
    embedded_compositum_inclusion(K, L, O, ko, lo)
  ) {
  exact field_embedding_factor_triangle(
    EmbeddedCompositum(K, L, O, ko, lo), O, embedded_compositum_inclusion(K, L, O, ko, lo), S,
    (
      fun (x : af_carrier(EmbeddedCompositum(K, L, O, ko, lo))) => embedded_compositum_least(
        K, L, O, ko, lo, S, containsK, containsL,
        subfield_value(O, embedded_compositum_subfield(K, L, O, ko, lo), x),
        subfield_evidence(O, embedded_compositum_subfield(K, L, O, ko, lo), x)
      )
    )
  );
}

// The universal property identifies the fields after swapping the factors.
// This is equality of structured fields, not equality of their presentations.
def embedded_compositum_commutative(
  K, L, O : AlgebraicField, ko : FieldEmbedding(K, O), lo : FieldEmbedding(L, O)
) :
  EmbeddedCompositum(K, L, O, ko, lo) =[AlgebraicField] EmbeddedCompositum(L, K, O, lo, ko) {
  exact with unfolding [AlgebraicField, EmbeddedCompositum, embedded_compositum_subfield] {
    cong(
      subfield_as_field(O),
      compositum_commutative(
        O, subfield_image(K, O, ko, subfield_top(K)), subfield_image(L, O, lo, subfield_top(L))
      )
    )
  };
}
