import interval_tag_bounds;
import sample_tagged;

def IntervalAdmissibleTags(F : U1, zero one : F, lt : F -> F -> U0, n : Nat) =
  SampleTagged(FieldUnitInterval(F, zero, one, lt), IntervalTagWithin(F, zero, one, lt), n);

def IntervalMeshBelow(
  F : U1, zero one : F, addF : F -> F -> F, negF : F -> F, lt : F -> F -> U0, radius : F, n : Nat
) =
  SampleAdjacent(
    FieldUnitInterval(F, zero, one, lt),
    (
      fun (a b : FieldUnitInterval(F, zero, one, lt)) => lt(
        interval_difference(F, zero, one, addF, negF, lt, a, b), radius
      )
    ), n
  );

def interval_tag_orders_endpoints(
  F : U1, zero one : F, addF mulF : F -> F -> F, lt : F -> F -> U0,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  a b tag : FieldUnitInterval(F, zero, one, lt),
  within : IntervalTagWithin(F, zero, one, lt, a, b, tag)
) :
  FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt, a),
    field_interval_coordinate(F, zero, one, lt, b)
  ) {
  obtain (lower, upper) = within;
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  exact order_le_trans(
    F, zero, one, addF, mulF, lt, arithmetic, coordinate(a), coordinate(tag), coordinate(b), lower,
    upper
  );
}

def interval_admissible_samples_ordered(
  F : U1, zero one : F, addF mulF : F -> F -> F, lt : F -> F -> U0,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), n : Nat,
  vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n),
  tags : SampleTags(FieldUnitInterval(F, zero, one, lt), n),
  valid : IntervalAdmissibleTags(F, zero, one, lt, n, vertices, tags)
) :
  SampleAdjacent(
    FieldUnitInterval(F, zero, one, lt),
    (
      fun (a b : FieldUnitInterval(F, zero, one, lt)) => FieldLe(
        F, lt, field_interval_coordinate(F, zero, one, lt, a),
        field_interval_coordinate(F, zero, one, lt, b)
      )
    ), n, vertices
  ) {
  let I = FieldUnitInterval(F, zero, one, lt);
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  exact sample_tagged_adjacent(
    I, IntervalTagWithin(F, zero, one, lt),
    (fun (a b : I) => FieldLe(F, lt, coordinate(a), coordinate(b))),
    (
      fun (a b tag : I) => interval_tag_orders_endpoints(
        F, zero, one, addF, mulF, lt, arithmetic, a, b, tag
      )
    ), n, vertices, tags, valid
  );
}

def interval_endpoint_tags_admissible(
  F : U1, zero one : F, lt : F -> F -> U0, order : StrictOrder(F, lt), n : Nat,
  vertices : SampleVertices(FieldUnitInterval(F, zero, one, lt), n),
  ordered : SampleAdjacent(
    FieldUnitInterval(F, zero, one, lt),
    (
      fun (a b : FieldUnitInterval(F, zero, one, lt)) => FieldLe(
        F, lt, field_interval_coordinate(F, zero, one, lt, a),
        field_interval_coordinate(F, zero, one, lt, b)
      )
    ), n, vertices
  )
) :
  IntervalAdmissibleTags(
    F, zero, one, lt, n, vertices,
    sample_left_tags(FieldUnitInterval(F, zero, one, lt), n, vertices)
  )
  and IntervalAdmissibleTags(
    F, zero, one, lt, n, vertices,
    sample_right_tags(FieldUnitInterval(F, zero, one, lt), n, vertices)
  ) {
  let I = FieldUnitInterval(F, zero, one, lt);
  let coordinate = field_interval_coordinate(F, zero, one, lt);
  let related = (fun (a b : I) => FieldLe(F, lt, coordinate(a), coordinate(b)));
  have leftAllowed :
    forall a : I, forall b : I, related(a, b) -> IntervalTagWithin(F, zero, one, lt, a, b, a) {
    intro a b ab;
    exact (order_le_refl(F, lt, order, coordinate(a)), ab);
  }
  have rightAllowed :
    forall a : I, forall b : I, related(a, b) -> IntervalTagWithin(F, zero, one, lt, a, b, b) {
    intro a b ab;
    exact (ab, order_le_refl(F, lt, order, coordinate(b)));
  }
  exact (
    sample_left_tags_valid(
      I, IntervalTagWithin(F, zero, one, lt), related, leftAllowed, n, vertices, ordered
    ),
    sample_right_tags_valid(
      I, IntervalTagWithin(F, zero, one, lt), related, rightAllowed, n, vertices, ordered
    )
  );
}
