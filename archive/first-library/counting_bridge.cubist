// The library's counting results, for this archive's finite types. Here
// Fin(n) is Unit or Fin(n - 1), over unary n, and finite types count by
// Bijection records; the library's Fin(n) is the binary numbers below n,
// counted by contractible maps. fin_bridge carries one to the other, so the
// counting statements below, which the archive's linear algebra and Galois
// theory use, are the library's theorems carried along it: uniqueness of
// cardinality (finite_cardinality), products (finite_arithmetic), the
// permutations of a three-element set (permutations) and fibered counting
// (finite_choice). The swaps of Unit or A and the cardinality vocabulary
// moved here unchanged from the archive's counting modules, which the
// library replaced on 2026-11-02 (docs/roadmaps/archive-retirement.md).
// This module retires with its consumers.
import finite_choice;
import permutations;
import finite;
import surjections;
import bijection_equality;
import unat;
use unat;

// Swap the first alternative with a given alternative.
def head(A : U0) := typed(Unit or A, left(tt));

def tail(A : U0, a : A) := typed(Unit or A, right(a));

def swap_tail(A : U0, a, b : A, d : Decidable(U0, a = b)) := match d return (Unit or A) {
    left p => head(A);
    right no => tail(A, b);
  };

def swap_tail_equal(A : U0, a, b : A, d : Decidable(U0, a = b), p : a = b) :=
  match d as decision return (swap_tail(A, a, b, decision) = head(A)) {
    left yes => refl(head(A));
    right no => typed(
      (swap_tail(A, a, b, typed(Decidable(U0, a = b), right(no))) = head(A)), absurd(no(p))
    );
  };

def swap_tail_different(A : U0, a, b : A, d : Decidable(U0, a = b), no : (a = b) -> Void) :=
  match d as decision return (swap_tail(A, a, b, decision) = tail(A, b)) {
    left yes => typed(
      (swap_tail(A, a, b, typed(Decidable(U0, a = b), left(yes))) = tail(A, b)), absurd(no(yes))
    );
    right impossible => refl(tail(A, b));
  };

def swap_right(
  A : U0, decide : (forall a : A. forall b : A. Decidable(U0, a = b)), a : A, x : Unit or A
) :=
  match x return (Unit or A) {
    left u => tail(A, a);
    right b => swap_tail(A, a, b, decide(a, b));
  };

def swap_right_twice(
  A : U0, decide : (forall a : A. forall b : A. Decidable(U0, a = b)), a : A, x : Unit or A
) :=
  match x as z return (swap_right(A, decide, a, swap_right(A, decide, a, z)) = z) {
    left u => trans(
      swap_tail_equal(A, a, a, decide(a, a), refl(a)),
      cong((fun (v : Unit) => typed(Unit or A, left(v))), unit_equal(u))
    );
    right b => match decide(a, b) return (
      swap_right(A, decide, a, swap_right(A, decide, a, tail(A, b))) = tail(A, b)
    ) {
      left p => trans(
        cong(swap_right(A, decide, a), swap_tail_equal(A, a, b, decide(a, b), p)),
        cong(tail(A), typed((a = b), p))
      );
      right no => trans(
        cong(swap_right(A, decide, a), swap_tail_different(A, a, b, decide(a, b), no)),
        swap_tail_different(A, a, b, decide(a, b), no)
      );
    };
  };

def swap(A : U0, decide : (forall a : A. forall b : A. Decidable(U0, a = b)), target, x : Unit or A) :=
  match target return (Unit or A) {
    left u => x;
    right a => swap_right(A, decide, a, x);
  };

def swap_twice(
  A : U0, decide : (forall a : A. forall b : A. Decidable(U0, a = b)), target, x : Unit or A
) :=
  match target as c return (swap(A, decide, c, swap(A, decide, c, x)) = x) {
    left u => refl(x);
    right a => swap_right_twice(A, decide, a, x);
  };

def swap_head(
  A : U0, decide : (forall a : A. forall b : A. Decidable(U0, a = b)), target : Unit or A
) :=
  match target as c return (swap(A, decide, c, head(A)) = c) {
    left u => cong((fun (v : Unit) => typed(Unit or A, left(v))), unit_equal(u));
    right a => refl(tail(A, a));
  };

def swap_bijection(
  A : U0, decide : (forall a : A. forall b : A. Decidable(U0, a = b)), target : Unit or A
) :=
  typed(
    Bijection(Unit or A, Unit or A),
    (
      swap(A, decide, target), swap(A, decide, target), swap_twice(A, decide, target),
      swap_twice(A, decide, target)
    )
  );

def inverse_injective(
  A, B : U0, f : A -> B, g : B -> A, eta : (forall x : A. g(f(x)) = x), x, y : A, p : f(x) = f(y)
) :=
  trans(sym(eta(x)), trans(cong(g, p), eta(y)));

// Cardinality forgets the enumeration, retaining only its finite size.
def HasCardinality(A : U0, n : UNat) := Mere(Bijection(Fin(n), A));

def has_cardinality_prop(A : U0, n : UNat) := mere_is_prop(Bijection(Fin(n), A));

def bijective_map_bijection(
  A, B : U0, setB : IsSet(U0, B), f : A -> B, injective : Injective(A, B, f),
  onto : Surjective(A, B, f)
) :
  Bijection(A, B) {
  let fiber := Fiber(A, B, f);
  let preimage := fun (y : B) => mere_eliminate(
    fiber(y), fiber(y), injection_is_embedding(A, B, setB, f, injective, y),
    (fun (w : fiber(y)) => w), onto(y)
  );
  let g := fun (y : B) => sigma_first(A, (fun (x : A) => f(x) = y), preimage(y));
  let right_ := fun (y : B) => sigma_second(A, (fun (x : A) => f(x) = y), preimage(y));
  exact (f, g, (fun (x : A) => injective(g(f(x)), x, right_(f(x)))), right_);
}

// Transport finite counts along a type equality, including one built by ua.
def cardinality_path(A, B : U0, same : A =[U0] B, n : UNat, count : HasCardinality(A, n)) :=
  transport count along same in (fun (X : U0) => HasCardinality(X, n));

// An indexed family of pairwise different elements, without an exhaustion claim.
def DistinctFamily(A : U0, n : UNat) := exists f : Fin(n) -> A. Injective(Fin(n), A, f);

// A Bijection record is an equivalence, and an equivalence is a record.
def bijection_contr_equiv(A, B : U0, e : Bijection(A, B)) : ContrEquiv(U0, A, B) := inverse_equiv(
  U0, A, B, forward(A, B, e), backward(A, B, e), right_inverse(A, B, e), left_inverse(A, B, e)
);

def contr_equiv_bijection(A, B : U0, e : ContrEquiv(U0, A, B)) : Bijection(A, B) := (
  e.1, fun (y : B) => equiv_inverse(U0, A, B, e, y),
  fun (x : A) => equiv_inverse_retraction(U0, A, B, e, x),
  fun (y : B) => equiv_inverse_section(U0, A, B, e, y)
);

// Between sets the two are equivalent: each is determined by its function.
def bijections_contr_equivs(A, B : U0, setA : IsSet(U0, A), setB : IsSet(U0, B)) :
  ContrEquiv(U0, Bijection(A, B), ContrEquiv(U0, A, B)) := inverse_equiv(
    U0, Bijection(A, B), ContrEquiv(U0, A, B),
    fun (b : Bijection(A, B)) => bijection_contr_equiv(A, B, b),
    fun (e : ContrEquiv(U0, A, B)) => contr_equiv_bijection(A, B, e),
    fun (e : ContrEquiv(U0, A, B)) => equiv_path(
      U0, A, B, bijection_contr_equiv(A, B, contr_equiv_bijection(A, B, e)), e,
      fun (x : A) => refl(e.1(x))
    ),
    fun (b : Bijection(A, B)) => bijection_ext(
      A, B, setA, setB, contr_equiv_bijection(A, B, bijection_contr_equiv(A, B, b)), b,
      FunExt(
        U0, A, (fun (x : A) => B),
        forward(A, B, contr_equiv_bijection(A, B, bijection_contr_equiv(A, B, b))),
        forward(A, B, b), (fun (x : A) => refl(forward(A, B, b, x)))
      )
    )
  );

// This archive's Fin(n) and the library's Fin of n's binary value: the
// first alternative is the library's top element.
def fin_bridge(n : UNat) : ContrEquiv(U0, Fin(n), finite_sets::Fin(bnat_of_unat(n))) := match n {
    zero => empty_equiv(
      U0, Fin(zero), finite_sets::Fin(bnat_of_unat(zero)), fun (x : Void) => x, fin_zero_empty
    );
    succ(k) => equiv_compose(
      U0, Unit or Fin(k), finite_sets::Fin(bnat_of_unat(k)) or Unit,
      finite_sets::Fin(bnat_succ(bnat_of_unat(k))),
      equiv_compose(
        U0, Unit or Fin(k), Fin(k) or Unit, finite_sets::Fin(bnat_of_unat(k)) or Unit,
        sum_commute(U0, Unit, Fin(k)),
        sum_equiv(
          U0, Fin(k), Unit, finite_sets::Fin(bnat_of_unat(k)), Unit, fin_bridge(k),
          id_contr_equiv(U0, Unit)
        )
      ), fin_succ_equiv(bnat_of_unat(k))
    );
  };

// Counts carried both ways along the bridge.
def library_count(A : U0, n : UNat, count : HasCardinality(A, n)) :
  finite_cardinality::HasCardinality(A, bnat_of_unat(n)) := mere_map(
    Bijection(Fin(n), A), ContrEquiv(U0, finite_sets::Fin(bnat_of_unat(n)), A),
    fun (e : Bijection(Fin(n), A)) => equiv_compose(
      U0, finite_sets::Fin(bnat_of_unat(n)), Fin(n), A,
      equiv_symm(U0, Fin(n), finite_sets::Fin(bnat_of_unat(n)), fin_bridge(n)),
      bijection_contr_equiv(Fin(n), A, e)
    ), count
  );

def archive_count(A : U0, n : UNat, count : finite_cardinality::HasCardinality(A, bnat_of_unat(n))) :
  HasCardinality(A, n) := mere_map(
    ContrEquiv(U0, finite_sets::Fin(bnat_of_unat(n)), A), Bijection(Fin(n), A),
    fun (e : ContrEquiv(U0, finite_sets::Fin(bnat_of_unat(n)), A)) => contr_equiv_bijection(
      Fin(n), A, equiv_compose(U0, Fin(n), finite_sets::Fin(bnat_of_unat(n)), A, fin_bridge(n), e)
    ), count
  );

// Unary numbers with equal binary values are equal.
def unary_from_binary(n, m : UNat, same : bnat_of_unat(n) = bnat_of_unat(m)) : n = m := trans(
  sym(bnat_unat_roundtrip(n)), trans(cong(bnat_to_unat, same), bnat_unat_roundtrip(m))
);

// Uniqueness of finite cardinality, from the library's.
def cardinality_unique(A : U0, n, m : UNat, hn : HasCardinality(A, n), hm : HasCardinality(A, m)) :
  n = m := unary_from_binary(
    n, m,
    finite_cardinality::cardinality_unique(
      A, bnat_of_unat(n), bnat_of_unat(m), library_count(A, n, hn), library_count(A, m, hm)
    )
  );

// Fin(n) and Fin(m) has n * m elements, from the library's products.
def fin_product(n, m : UNat) :
  Bijection(Fin(n) and Fin(m), Fin(mul(n, m))) := contr_equiv_bijection(
    Fin(n) and Fin(m), Fin(mul(n, m)),
    equiv_compose(
      U0, Fin(n) and Fin(m), finite_sets::Fin(bnat_of_unat(n))
      and finite_sets::Fin(bnat_of_unat(m)), Fin(mul(n, m)),
      product_equiv(
        U0, Fin(n), Fin(m), finite_sets::Fin(bnat_of_unat(n)), finite_sets::Fin(bnat_of_unat(m)),
        fin_bridge(n), fin_bridge(m)
      ),
      equiv_compose(
        U0, finite_sets::Fin(bnat_of_unat(n)) and finite_sets::Fin(bnat_of_unat(m)),
        finite_sets::Fin(bnat_mul(bnat_of_unat(n), bnat_of_unat(m))), Fin(mul(n, m)),
        finite_arithmetic::fin_product(bnat_of_unat(n), bnat_of_unat(m)),
        equiv_compose(
          U0, finite_sets::Fin(bnat_mul(bnat_of_unat(n), bnat_of_unat(m))),
          finite_sets::Fin(bnat_of_unat(mul(n, m))), Fin(mul(n, m)),
          fin_cast(
            bnat_mul(bnat_of_unat(n), bnat_of_unat(m)), bnat_of_unat(mul(n, m)),
            sym(bnat_encode_mul(n, m))
          ),
          equiv_symm(
            U0, Fin(mul(n, m)), finite_sets::Fin(bnat_of_unat(mul(n, m))), fin_bridge(mul(n, m))
          )
        )
      )
    )
  );

// Bijection records count permutations themselves: a three-element set has
// six, from the library's count of self-equivalences.
def Permutations(n : UNat) := Bijection(Fin(n), Fin(n));

def three_permutations : Bijection(Permutations(3), Fin(6)) := contr_equiv_bijection(
  Permutations(3), Fin(6),
  equiv_compose(
    U0, Permutations(3), ContrEquiv(U0, Fin(3), Fin(3)), Fin(6),
    bijections_contr_equivs(Fin(3), Fin(3), fin_is_set(3), fin_is_set(3)),
    equiv_compose(
      U0, ContrEquiv(U0, Fin(3), Fin(3)),
      ContrEquiv(U0, finite_sets::Fin(bnat_of_unat(3)), finite_sets::Fin(bnat_of_unat(3))), Fin(6),
      equiv_equiv(
        U0, Fin(3), finite_sets::Fin(bnat_of_unat(3)), Fin(3), finite_sets::Fin(bnat_of_unat(3)),
        fin_bridge(3), fin_bridge(3)
      ),
      equiv_compose(
        U0, ContrEquiv(U0, finite_sets::Fin(bnat_of_unat(3)), finite_sets::Fin(bnat_of_unat(3))),
        finite_sets::Fin(factorial(bnat_of_unat(3))), Fin(6), fin_permutations(bnat_of_unat(3)),
        equiv_compose(
          U0, finite_sets::Fin(factorial(bnat_of_unat(3))), finite_sets::Fin(bnat_of_unat(6)),
          Fin(6), fin_cast(factorial(bnat_of_unat(3)), bnat_of_unat(6), refl(bnat_of_unat(6))),
          equiv_symm(U0, Fin(6), finite_sets::Fin(bnat_of_unat(6)), fin_bridge(6))
        )
      )
    )
  )
);

// A type fibered over an n-element base with m-element fibers has n * m
// elements, from the library's fibered counting, which needs no set
// hypotheses.
def UniformFiberCount(A : U0, n, m : UNat) :=
  forall B : A -> U0. (forall a : A. HasCardinality(B(a), m))
  -> HasCardinality((exists a : A. B(a)), mul(n, m));

def uniform_fiber_count(A : U0, n, m : UNat, countA : HasCardinality(A, n)) :
  UniformFiberCount(A, n, m) {
  intro B, counts;
  exact archive_count(
    (exists a : A. B(a)), mul(n, m),
    mere_map(
      ContrEquiv(
        U0, finite_sets::Fin(bnat_mul(bnat_of_unat(n), bnat_of_unat(m))), exists a : A. B(a)
      ), ContrEquiv(U0, finite_sets::Fin(bnat_of_unat(mul(n, m))), exists a : A. B(a)),
      fun (
        e : ContrEquiv(
          U0, finite_sets::Fin(bnat_mul(bnat_of_unat(n), bnat_of_unat(m))), exists a : A. B(a)
        )
      ) => equiv_compose(
        U0, finite_sets::Fin(bnat_of_unat(mul(n, m))),
        finite_sets::Fin(bnat_mul(bnat_of_unat(n), bnat_of_unat(m))), exists a : A. B(a),
        fin_cast(
          bnat_of_unat(mul(n, m)), bnat_mul(bnat_of_unat(n), bnat_of_unat(m)), bnat_encode_mul(n, m)
        ), e
      ),
      fibered_cardinality(
        A, bnat_of_unat(n), library_count(A, n, countA), B, bnat_of_unat(m),
        fun (a : A) => library_count(B(a), m, counts(a))
      )
    )
  );
}
