import field_embeddings;
import subfield_carriers;

// An embedding whose values lie in S factors through S as an actual field.
def field_embedding_lift(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L),
  lands : (forall x : af_carrier(K). subfield_members(L, S, field_embedding_map(K, L, e, x))),
  x : af_carrier(K)
) :
  SubfieldCarrier(L, S) {
  exact (field_embedding_map(K, L, e, x), lands(x));
}

def field_embedding_lift_preserves(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L),
  lands : (forall x : af_carrier(K). subfield_members(L, S, field_embedding_map(K, L, e, x)))
) :
  FieldOpsPreserved(
    af_carrier(K), SubfieldCarrier(L, S), field_embedding_lift(K, L, e, S, lands), af_operations(K),
    subfield_carrier_ops(L, S)
  ) {
  let A := af_carrier(K);
  let B := SubfieldCarrier(L, S);
  let opsA := af_operations(K);
  let opsB := subfield_carrier_ops(L, S);
  let lift := field_embedding_lift(K, L, e, S, lands);
  obtain (p0, p1, pn, pa, pm) := field_embedding_preserves(K, L, e);
  exact (
    subfield_value_ext(L, S, lift(af_zero(A, opsA)), af_zero(B, opsB), p0),
    subfield_value_ext(L, S, lift(af_one(A, opsA)), af_one(B, opsB), p1),
    (
      fun (x : A) => subfield_value_ext(
        L, S, lift(af_neg(A, opsA, x)), af_neg(B, opsB, lift(x)), pn(x)
      )
    ),
    (
      fun (x, y : A) => subfield_value_ext(
        L, S, lift(af_add(A, opsA, x, y)), af_add(B, opsB, lift(x), lift(y)), pa(x, y)
      )
    ),
    (
      fun (x, y : A) => subfield_value_ext(
        L, S, lift(af_mul(A, opsA, x, y)), af_mul(B, opsB, lift(x), lift(y)), pm(x, y)
      )
    )
  );
}

def field_embedding_factor(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L),
  lands : (forall x : af_carrier(K). subfield_members(L, S, field_embedding_map(K, L, e, x)))
) :
  FieldEmbedding(K, subfield_as_field(L, S)) {
  exact (
    field_embedding_lift(K, L, e, S, lands), field_embedding_lift_preserves(K, L, e, S, lands),
    (
      fun (
        x, y : af_carrier(K),
        same : field_embedding_lift(K, L, e, S, lands, x) = field_embedding_lift(
          K, L, e, S, lands, y
        )
      ) => field_embedding_injective(K, L, e, x, y, cong(subfield_value(L, S), same))
    )
  );
}

def field_embedding_factor_triangle(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L),
  lands : (forall x : af_carrier(K). subfield_members(L, S, field_embedding_map(K, L, e, x)))
) :
  FieldTower(
    K, subfield_as_field(L, S), L, field_embedding_factor(K, L, e, S, lands),
    subfield_inclusion(L, S), e
  ) {
  exact field_embedding_ext(
    K, L,
    field_embedding_compose(
      K, subfield_as_field(L, S), L, field_embedding_factor(K, L, e, S, lands),
      subfield_inclusion(L, S)
    ), e, (fun (x : af_carrier(K)) => refl(field_embedding_map(K, L, e, x)))
  );
}

def field_embedding_factor_unique(
  K, L : AlgebraicField, e : FieldEmbedding(K, L), S : Subfield(L),
  lands : (forall x : af_carrier(K). subfield_members(L, S, field_embedding_map(K, L, e, x))),
  d : FieldEmbedding(K, subfield_as_field(L, S)),
  triangle : (
    forall x : af_carrier(K).
    subfield_value(L, S, field_embedding_map(K, subfield_as_field(L, S), d, x)) = field_embedding_map(
      K, L, e, x
    )
  )
) :
  d = field_embedding_factor(K, L, e, S, lands) {
  exact field_embedding_ext(
    K, subfield_as_field(L, S), d, field_embedding_factor(K, L, e, S, lands),
    (
      fun (x : af_carrier(K)) => subfield_value_ext(
        L, S, field_embedding_map(K, subfield_as_field(L, S), d, x),
        field_embedding_lift(K, L, e, S, lands, x), triangle(x)
      )
    )
  );
}
