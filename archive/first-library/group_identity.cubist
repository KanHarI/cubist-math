import groups;
import bijection_equality;

// A left inverse and a right inverse of the same element agree:
// y = y·1 = y·(x·z) = (y·x)·z = 1·z = z.
def group_inverse_unique(
  A : U0, unit : A, multiply : A -> A -> A, laws : GroupLaws(A, unit, multiply), x, y, z : A,
  leftLaw : multiply(y, x) = unit, rightLaw : multiply(x, z) = unit
) :
  y = z {
  exact trans(
    sym(group_right_unit_law(A, unit, multiply, laws, y)),
    trans(
      cong(multiply(y), sym(rightLaw)),
      trans(
        sym(group_associative_law(A, unit, multiply, laws, y, x, z)),
        trans(
          cong((fun (w : A) => multiply(w, z)), leftLaw),
          group_left_unit_law(A, unit, multiply, laws, z)
        )
      )
    )
  );
}

def group_inverse_evidence_prop(
  A : U0, unit : A, multiply : A -> A -> A, laws : GroupLaws(A, unit, multiply), x : A,
  p, q : (exists y : A. GroupInverseLaws(A, unit, multiply, x, y))
) :
  p = q {
  let y := sigma_first(A, GroupInverseLaws(A, unit, multiply, x), p);
  let z := sigma_first(A, GroupInverseLaws(A, unit, multiply, x), q);
  let py := sigma_second(A, GroupInverseLaws(A, unit, multiply, x), p);
  let qz := sigma_second(A, GroupInverseLaws(A, unit, multiply, x), q);
  let setA := group_set_law(A, unit, multiply, laws);
  exact subtype_ext(
    A, GroupInverseLaws(A, unit, multiply, x),
    (
      fun (w : A) => product_prop(
        (multiply(w, x) = unit), (multiply(x, w) = unit), setA(multiply(w, x), unit),
        setA(multiply(x, w), unit)
      )
    ), p, q,
    group_inverse_unique(
      A, unit, multiply, laws, x, y, z, fst((multiply(y, x) = unit), (multiply(x, y) = unit), py),
      snd((multiply(z, x) = unit), (multiply(x, z) = unit), qz)
    )
  );
}

// Once the carrier, unit and multiplication are fixed, the law evidence
// carries no further information. Function extensionality compares laws.
def group_laws_prop(A : U0, unit : A, multiply : A -> A -> A, p, q : GroupLaws(A, unit, multiply)) :
  p = q {
  let setA := group_set_law(A, unit, multiply, p);
  let assocProp :=
    forall_prop(
      A,
      (
        fun (x : A) => forall y : A. forall z : A.
        multiply(multiply(x, y), z) = multiply(x, multiply(y, z))
      ),
      (
        fun (x : A) => forall_prop(
          A,
          (fun (y : A) => forall z : A. multiply(multiply(x, y), z) = multiply(x, multiply(y, z))),
          (
            fun (y : A) => forall_prop(
              A, (fun (z : A) => multiply(multiply(x, y), z) = multiply(x, multiply(y, z))),
              (fun (z : A) => setA(multiply(multiply(x, y), z), multiply(x, multiply(y, z))))
            )
          )
        )
      )
    );
  let leftProp :=
    forall_prop(
      A, (fun (x : A) => multiply(unit, x) = x), (fun (x : A) => setA(multiply(unit, x), x))
    );
  let rightProp :=
    forall_prop(
      A, (fun (x : A) => multiply(x, unit) = x), (fun (x : A) => setA(multiply(x, unit), x))
    );
  let inverseProp :=
    forall_prop(
      A, (fun (x : A) => exists y : A. GroupInverseLaws(A, unit, multiply, x, y)),
      group_inverse_evidence_prop(A, unit, multiply, p)
    );
  exact product_prop(
    IsSet(A),
    (
      GroupAssociative(A, multiply) and GroupLeftUnit(A, unit, multiply)
      and GroupRightUnit(A, unit, multiply) and GroupInverses(A, unit, multiply)
    ), is_set_prop(A),
    product_prop(
      GroupAssociative(A, multiply),
      (
        GroupLeftUnit(A, unit, multiply) and GroupRightUnit(A, unit, multiply)
        and GroupInverses(A, unit, multiply)
      ), assocProp,
      product_prop(
        GroupLeftUnit(A, unit, multiply),
        (GroupRightUnit(A, unit, multiply) and GroupInverses(A, unit, multiply)), leftProp,
        product_prop(
          GroupRightUnit(A, unit, multiply), (GroupInverses(A, unit, multiply)), rightProp,
          inverseProp
        )
      )
    )
  )(p, q);
}

def group_carrier_transport(A, B : U0, p : A = B, x : A) := along((fun (T : U0) => T)) by p from x;

// Multiplication-preserving equivalences preserve units; this is derived, not required.
def group_isomorphism_preserves_unit(
  A : U0, unitA : A, multiplyA : A -> A -> A, lawsA : GroupLaws(A, unitA, multiplyA), B : U0,
  unitB : B, multiplyB : B -> B -> B, lawsB : GroupLaws(B, unitB, multiplyB), f : A -> B, g : B
  -> A, rightLaw : (forall y : B. f(g(y)) = y),
  preserves : (forall x : A. forall y : A. f(multiplyA(x, y)) = multiplyB(f(x), f(y)))
) :
  f(unitA) = unitB {
  exact trans(
    sym(group_right_unit_law(B, unitB, multiplyB, lawsB, f(unitA))),
    trans(
      cong(multiplyB(f(unitA)), sym(rightLaw(unitB))),
      trans(
        sym(preserves(unitA, g(unitB))),
        trans(cong(f, group_left_unit_law(A, unitA, multiplyA, lawsA, g(unitB))), rightLaw(unitB))
      )
    )
  );
}
