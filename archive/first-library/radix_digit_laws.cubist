import radix_naturals;
import paths;

// Increment either produces the next digit or certifies that the old digit
// was the maximum. This is constructive, with no decidability axiom.
def RadixDigitStepLaw(n : Nat, d : RadixDigit(n), result : RadixDigit(n) or Unit) =
  match result return U0 {
    left next => radix_digit_value(n, next) = succ(radix_digit_value(n, d));
    right carry => succ(radix_digit_value(n, d)) = n;
  };

def radix_digit_lift_step(n : Nat, result : RadixDigit(n) or Unit) =
  match result return (RadixDigit(succ(n)) or Unit) {
    left next => left(radix_digit_weaken(n, next));
    right carry => left(radix_digit_top(n));
  };

def radix_digit_lift_law(n : Nat, d : RadixDigit(n), result : RadixDigit(n) or Unit) :
  RadixDigitStepLaw(n, d, result)
  -> RadixDigitStepLaw(succ(n), radix_digit_weaken(n, d), radix_digit_lift_step(n, result)) {
  exact match result as r return (
    RadixDigitStepLaw(n, d, r)
    -> RadixDigitStepLaw(succ(n), radix_digit_weaken(n, d), radix_digit_lift_step(n, r))
  ) {
    left next => fun (same : radix_digit_value(n, next) = succ(radix_digit_value(n, d))) => same;
    right carry => fun (same : succ(radix_digit_value(n, d)) = n) => sym(same);
  };
}

def radix_digit_succ_law(n : Nat) :
  forall d : RadixDigit(n), RadixDigitStepLaw(n, d, radix_digit_succ(n, d)) {
  exact induction n as k return (
    forall d : RadixDigit(k), RadixDigitStepLaw(k, d, radix_digit_succ(k, d))
  ) {
    zero => fun (d : Void) => typed(RadixDigitStepLaw(0, d, radix_digit_succ(0, d)), absurd(d));
    succ previous => fun (d : RadixDigit(succ(k))) => match typed(Unit or RadixDigit(k), d) as digit return RadixDigitStepLaw(
      succ(k), digit, radix_digit_succ(succ(k), digit)
    ) {
      left top => refl(succ(k));
      right lower => radix_digit_lift_law(k, lower, radix_digit_succ(k, lower), previous(lower));
    };
  };
}

def radix_digit_zero_value(n : Nat) : radix_digit_value(succ(n), radix_digit_zero(n)) = 0 {
  exact induction n as k return (radix_digit_value(succ(k), radix_digit_zero(k)) = 0) {
    zero => refl(0);
    succ previous => previous;
  };
}
