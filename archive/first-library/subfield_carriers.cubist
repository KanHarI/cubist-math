import subfields;
import field_extensions;

// Realize a predicate subfield as an actual small field. Membership proofs
// do not distinguish elements: equality is determined by the ambient value.
def SubfieldCarrier(F : AlgebraicField, S : Subfield(F)) :=
  exists x : af_carrier(F). subfield_members(F, S, x);

def subfield_value(F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S)) :=
  sigma_first(af_carrier(F), subfield_members(F, S), x);

def subfield_evidence(F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S)) :
  subfield_members(F, S, subfield_value(F, S, x)) {
  exact sigma_second(af_carrier(F), subfield_members(F, S), x);
}

def subfield_value_ext(
  F : AlgebraicField, S : Subfield(F), x, y : SubfieldCarrier(F, S),
  same : subfield_value(F, S, x) = subfield_value(F, S, y)
) :
  x = y {
  exact subtype_ext(
    af_carrier(F), subfield_members(F, S),
    subfield_prop(F, subfield_members(F, S), subfield_laws(F, S)), x, y, same
  );
}

def subfield_carrier_is_set(F : AlgebraicField, S : Subfield(F)) : IsSet(SubfieldCarrier(F, S)) {
  exact subtype_is_set(
    af_carrier(F), subfield_members(F, S), af_set(F),
    subfield_prop(F, subfield_members(F, S), subfield_laws(F, S))
  );
}

def subfield_carrier_zero(F : AlgebraicField, S : Subfield(F)) : SubfieldCarrier(F, S) {
  exact (
    af_zero(af_carrier(F), af_operations(F)),
    subfield_zero(F, subfield_members(F, S), subfield_laws(F, S))
  );
}

def subfield_carrier_one(F : AlgebraicField, S : Subfield(F)) : SubfieldCarrier(F, S) {
  exact (
    af_one(af_carrier(F), af_operations(F)),
    subfield_one(F, subfield_members(F, S), subfield_laws(F, S))
  );
}

def subfield_carrier_neg(F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S)) :
  SubfieldCarrier(F, S) {
  exact (
    af_neg(af_carrier(F), af_operations(F), subfield_value(F, S, x)),
    subfield_neg(
      F, subfield_members(F, S), subfield_laws(F, S), subfield_value(F, S, x),
      subfield_evidence(F, S, x)
    )
  );
}

def subfield_carrier_add(F : AlgebraicField, S : Subfield(F), x, y : SubfieldCarrier(F, S)) :
  SubfieldCarrier(F, S) {
  exact (
    af_add(af_carrier(F), af_operations(F), subfield_value(F, S, x), subfield_value(F, S, y)),
    subfield_add(
      F, subfield_members(F, S), subfield_laws(F, S), subfield_value(F, S, x),
      subfield_value(F, S, y), subfield_evidence(F, S, x), subfield_evidence(F, S, y)
    )
  );
}

def subfield_carrier_mul(F : AlgebraicField, S : Subfield(F), x, y : SubfieldCarrier(F, S)) :
  SubfieldCarrier(F, S) {
  exact (
    af_mul(af_carrier(F), af_operations(F), subfield_value(F, S, x), subfield_value(F, S, y)),
    subfield_mul(
      F, subfield_members(F, S), subfield_laws(F, S), subfield_value(F, S, x),
      subfield_value(F, S, y), subfield_evidence(F, S, x), subfield_evidence(F, S, y)
    )
  );
}

def subfield_carrier_ops(F : AlgebraicField, S : Subfield(F)) :=
  field_ops(
    SubfieldCarrier(F, S), subfield_carrier_zero(F, S), subfield_carrier_one(F, S),
    subfield_carrier_neg(F, S), subfield_carrier_add(F, S), subfield_carrier_mul(F, S)
  );

def subfield_carrier_add_assoc(F : AlgebraicField, S : Subfield(F), x, y, z : SubfieldCarrier(F, S)) :
  subfield_carrier_add(F, S, subfield_carrier_add(F, S, x, y), z) = subfield_carrier_add(
    F, S, x, subfield_carrier_add(F, S, y, z)
  ) {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_add(F, S, subfield_carrier_add(F, S, x, y), z),
    subfield_carrier_add(F, S, x, subfield_carrier_add(F, S, y, z)),
    assocAdd(subfield_value(F, S, x), subfield_value(F, S, y), subfield_value(F, S, z))
  );
}

def subfield_carrier_add_comm(F : AlgebraicField, S : Subfield(F), x, y : SubfieldCarrier(F, S)) :
  subfield_carrier_add(F, S, x, y) = subfield_carrier_add(F, S, y, x) {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_add(F, S, x, y), subfield_carrier_add(F, S, y, x),
    commAdd(subfield_value(F, S, x), subfield_value(F, S, y))
  );
}

def subfield_carrier_add_zero(F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S)) :
  subfield_carrier_add(F, S, subfield_carrier_zero(F, S), x) = x {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_add(F, S, subfield_carrier_zero(F, S), x), x,
    zeroAdd(subfield_value(F, S, x))
  );
}

def subfield_carrier_add_inverse(F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S)) :
  subfield_carrier_add(F, S, subfield_carrier_neg(F, S, x), x) = subfield_carrier_zero(F, S) {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_add(F, S, subfield_carrier_neg(F, S, x), x), subfield_carrier_zero(F, S),
    inverseAdd(subfield_value(F, S, x))
  );
}

def subfield_carrier_mul_assoc(F : AlgebraicField, S : Subfield(F), x, y, z : SubfieldCarrier(F, S)) :
  subfield_carrier_mul(F, S, subfield_carrier_mul(F, S, x, y), z) = subfield_carrier_mul(
    F, S, x, subfield_carrier_mul(F, S, y, z)
  ) {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_mul(F, S, subfield_carrier_mul(F, S, x, y), z),
    subfield_carrier_mul(F, S, x, subfield_carrier_mul(F, S, y, z)),
    assocMul(subfield_value(F, S, x), subfield_value(F, S, y), subfield_value(F, S, z))
  );
}

def subfield_carrier_mul_comm(F : AlgebraicField, S : Subfield(F), x, y : SubfieldCarrier(F, S)) :
  subfield_carrier_mul(F, S, x, y) = subfield_carrier_mul(F, S, y, x) {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_mul(F, S, x, y), subfield_carrier_mul(F, S, y, x),
    commMul(subfield_value(F, S, x), subfield_value(F, S, y))
  );
}

def subfield_carrier_mul_one(F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S)) :
  subfield_carrier_mul(F, S, subfield_carrier_one(F, S), x) = x {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_mul(F, S, subfield_carrier_one(F, S), x), x,
    oneMul(subfield_value(F, S, x))
  );
}

def subfield_carrier_distribute(F : AlgebraicField, S : Subfield(F), x, y, z : SubfieldCarrier(F, S)) :
  subfield_carrier_mul(F, S, x, subfield_carrier_add(F, S, y, z)) = subfield_carrier_add(
    F, S, subfield_carrier_mul(F, S, x, y), subfield_carrier_mul(F, S, x, z)
  ) {
  obtain (addLaws, mulLaws) := typed(
    FieldRingLaws(af_carrier(F), af_operations(F)),
    field_ring_data(af_carrier(F), af_operations(F), af_laws(F))
  );
  obtain (assocAdd, commAdd, zeroAdd, inverseAdd) := addLaws;
  obtain (assocMul, commMul, oneMul, distributeMul) := mulLaws;
  exact subfield_value_ext(
    F, S, subfield_carrier_mul(F, S, x, subfield_carrier_add(F, S, y, z)),
    subfield_carrier_add(F, S, subfield_carrier_mul(F, S, x, y), subfield_carrier_mul(F, S, x, z)),
    distributeMul(subfield_value(F, S, x), subfield_value(F, S, y), subfield_value(F, S, z))
  );
}

def subfield_carrier_ring_laws(F : AlgebraicField, S : Subfield(F)) :
  FieldRingLaws(SubfieldCarrier(F, S), subfield_carrier_ops(F, S)) {
  exact (
    (
      subfield_carrier_add_assoc(F, S), subfield_carrier_add_comm(F, S),
      subfield_carrier_add_zero(F, S), subfield_carrier_add_inverse(F, S)
    ), subfield_carrier_mul_assoc(F, S), subfield_carrier_mul_comm(F, S),
    subfield_carrier_mul_one(F, S), subfield_carrier_distribute(F, S)
  );
}

// Inequality with zero passes to the ambient field because equality of
// subtype elements is determined by equality of their ambient values.
def subfield_carrier_nonzero(
  F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S),
  nonzero : FieldNonzero(SubfieldCarrier(F, S), subfield_carrier_ops(F, S), x)
) :
  FieldNonzero(af_carrier(F), af_operations(F), subfield_value(F, S, x)) {
  intro same;
  exact nonzero(subfield_value_ext(F, S, x, subfield_carrier_zero(F, S), same));
}

def subfield_carrier_nontrivial(F : AlgebraicField, S : Subfield(F)) :
  FieldNonzero(SubfieldCarrier(F, S), subfield_carrier_ops(F, S), subfield_carrier_one(F, S)) {
  intro same;
  obtain (ring, nontrivial, inverses) := typed(
    AlgebraicFieldLaws(af_carrier(F), af_operations(F)), af_laws(F)
  );
  exact nontrivial(cong(subfield_value(F, S), same));
}

// Ambient inverse witnesses lie in the subfield by its inverse-closure law.
def subfield_carrier_inverse(
  F : AlgebraicField, S : Subfield(F), x : SubfieldCarrier(F, S),
  nonzero : FieldNonzero(SubfieldCarrier(F, S), subfield_carrier_ops(F, S), x)
) :
  exists y : SubfieldCarrier(F, S). subfield_carrier_mul(F, S, x, y) = subfield_carrier_one(F, S) {
  obtain (ring, nontrivial, inverses) := typed(
    AlgebraicFieldLaws(af_carrier(F), af_operations(F)), af_laws(F)
  );
  let value := subfield_value(F, S, x);
  obtain (ambientInverse, inverseLaw) := inverses(value, subfield_carrier_nonzero(F, S, x, nonzero));
  have result : SubfieldCarrier(F, S) := (
    ambientInverse,
    subfield_inverse(
      F, subfield_members(F, S), subfield_laws(F, S), value, ambientInverse,
      subfield_evidence(F, S, x), inverseLaw
    )
  );
  exact (
    result,
    subfield_value_ext(
      F, S, subfield_carrier_mul(F, S, x, result), subfield_carrier_one(F, S), inverseLaw
    )
  );
}

def subfield_carrier_field_laws(F : AlgebraicField, S : Subfield(F)) :
  AlgebraicFieldLaws(SubfieldCarrier(F, S), subfield_carrier_ops(F, S)) {
  exact (
    subfield_carrier_ring_laws(F, S), subfield_carrier_nontrivial(F, S),
    subfield_carrier_inverse(F, S)
  );
}

def subfield_as_field(F : AlgebraicField, S : Subfield(F)) :=
  algebraic_field(
    SubfieldCarrier(F, S), subfield_carrier_ops(F, S), subfield_carrier_is_set(F, S),
    subfield_carrier_field_laws(F, S)
  );

// The actual embedding into the ambient field, including operation preservation
// and injectivity. It is the first projection of the subtype.
def subfield_inclusion(F : AlgebraicField, S : Subfield(F)) :
  FieldEmbeddingData(subfield_as_field(F, S), af_carrier(F), structure_data(FieldData, F)) {
  let A := af_carrier(F);
  let ops := af_operations(F);
  exact (
    subfield_value(F, S),
    (
      refl(af_zero(A, ops)), refl(af_one(A, ops)),
      (fun (x : SubfieldCarrier(F, S)) => refl(af_neg(A, ops, subfield_value(F, S, x)))),
      (
        fun (x, y : SubfieldCarrier(F, S)) => refl(
          af_add(A, ops, subfield_value(F, S, x), subfield_value(F, S, y))
        )
      ),
      (
        fun (x, y : SubfieldCarrier(F, S)) => refl(
          af_mul(A, ops, subfield_value(F, S, x), subfield_value(F, S, y))
        )
      )
    ), subfield_value_ext(F, S)
  );
}
