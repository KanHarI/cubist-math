import unat;
import finite_basis_search;

// A least natural satisfying a proposition is unique, so it can be recovered
// from mere existence without a choice function.
def natural_order_prop(n : UNat) :=
  induction n as k return (forall m : UNat. Proposition(le(k, m))) {
    zero => fun (m : UNat, a, b : Unit) => trans(sym(unit_equal(a)), unit_equal(b));
    succ previous => fun (m : UNat) => induction m as j return Proposition(le(succ(k), j)) {
      zero => fun (a, b : Void) => typed((a = b), absurd(a));
      succ ignored => previous(j);
    };
  };

def MinimumAt(P : UNat -> U0, n : UNat) := P(n) and (forall m : UNat. P(m) -> le(n, m));

def NaturalMinimum(P : UNat -> U0) := exists n : UNat. MinimumAt(P, n);

def minimum_at_prop(P : UNat -> U0, prop_ : (forall n : UNat. Proposition(P(n))), n : UNat) :=
  product_prop(
    P(n), (forall m : UNat. P(m) -> le(n, m)), prop_(n),
    forall_prop(
      UNat, (fun (m : UNat) => P(m) -> le(n, m)),
      (
        fun (m : UNat) => forall_prop(
          P(m), (fun (p : P(m)) => le(n, m)), (fun (p : P(m)) => natural_order_prop(n, m))
        )
      )
    )
  );

def natural_minimum_prop(P : UNat -> U0, prop_ : (forall n : UNat. Proposition(P(n)))) :
  Proposition(NaturalMinimum(P)) {
  intro u, v;
  let n := sigma_first(UNat, MinimumAt(P), u);
  let m := sigma_first(UNat, MinimumAt(P), v);
  obtain (pn, ln) := sigma_second(UNat, MinimumAt(P), u);
  obtain (pm, lm) := sigma_second(UNat, MinimumAt(P), v);
  exact subtype_ext(
    UNat, MinimumAt(P), minimum_at_prop(P, prop_), u, v,
    dimension_order_antisymmetric(n, m, ln(m, pm), lm(n, pn))
  );
}

def natural_minimum_from_witness(
  P : UNat -> U0, prop_ : (forall n : UNat. Proposition(P(n))), witness_ : (exists n : UNat. P(n))
) :
  NaturalMinimum(P) {
  obtain (n, pn) := witness_;
  obtain (m, bound, pm, noLess) := least_bounded_witness(
    P, (fun (k : UNat) => excluded_middle(P(k), prop_(k))), n, pn
  );
  let least : forall k : UNat. P(k) -> le(m, k) {
    intro k, pk;
    exact match unat_le_total(m, k) return le(m, k) {
      left yes => yes;
      right smaller => absurd(noLess(k, smaller, pk));
    };
  }
  exact (m, pm, least);
}

def natural_minimum(
  P : UNat -> U0, prop_ : (forall n : UNat. Proposition(P(n))),
  inhabited : Mere(exists n : UNat. P(n))
) :
  NaturalMinimum(P) {
  exact mere_eliminate(
    (exists n : UNat. P(n)), NaturalMinimum(P), natural_minimum_prop(P, prop_),
    natural_minimum_from_witness(P, prop_), inhabited
  );
}
