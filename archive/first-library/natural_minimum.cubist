import finite_basis_search;

// A least natural satisfying a proposition is unique, so it can be recovered
// from mere existence without a choice function.
def natural_order_prop(n : Nat) = induction n as k return (forall m : Nat, Proposition(le(k, m))) {
    zero => fun (m : Nat, a b : Unit) => trans(sym(unit_equal(a)), unit_equal(b));
    succ previous => fun (m : Nat) => induction m as j return Proposition(le(succ(k), j)) {
      zero => fun (a b : Void) => typed((a = b), absurd(a));
      succ ignored => previous(j);
    };
  };

def MinimumAt(P : Nat -> U0, n : Nat) = P(n) and (forall m : Nat, P(m) -> le(n, m));

def NaturalMinimum(P : Nat -> U0) = exists n : Nat, MinimumAt(P, n);

def minimum_at_prop(P : Nat -> U0, prop : (forall n : Nat, Proposition(P(n))), n : Nat) =
  product_prop(
    P(n), (forall m : Nat, P(m) -> le(n, m)), prop(n),
    forall_prop(
      Nat, (fun (m : Nat) => P(m) -> le(n, m)),
      (
        fun (m : Nat) => forall_prop(
          P(m), (fun (p : P(m)) => le(n, m)), (fun (p : P(m)) => natural_order_prop(n, m))
        )
      )
    )
  );

def natural_minimum_prop(P : Nat -> U0, prop : (forall n : Nat, Proposition(P(n)))) :
  Proposition(NaturalMinimum(P)) {
  intro u v;
  let n = sigma_first(Nat, MinimumAt(P), u);
  let m = sigma_first(Nat, MinimumAt(P), v);
  obtain (pn, ln) = sigma_second(Nat, MinimumAt(P), u);
  obtain (pm, lm) = sigma_second(Nat, MinimumAt(P), v);
  exact subtype_ext(
    Nat, MinimumAt(P), minimum_at_prop(P, prop), u, v,
    dimension_order_antisymmetric(n, m, ln(m, pm), lm(n, pn))
  );
}

def natural_minimum_from_witness(
  P : Nat -> U0, prop : (forall n : Nat, Proposition(P(n))), witness : (exists n : Nat, P(n))
) :
  NaturalMinimum(P) {
  obtain (n, pn) = witness;
  obtain (m, bound, pm, noLess) = least_bounded_witness(
    P, (fun (k : Nat) => excluded_middle(P(k), prop(k))), n, pn
  );
  have least : forall k : Nat, P(k) -> le(m, k) {
    intro k pk;
    exact match nat_le_total(m, k) return le(m, k) {
      left yes => yes;
      right smaller => absurd(noLess(k, smaller, pk));
    };
  }
  exact (m, pm, least);
}

def natural_minimum(
  P : Nat -> U0, prop : (forall n : Nat, Proposition(P(n))), inhabited : Mere(exists n : Nat, P(n))
) :
  NaturalMinimum(P) {
  exact mere_eliminate(
    (exists n : Nat, P(n)), NaturalMinimum(P), natural_minimum_prop(P, prop),
    natural_minimum_from_witness(P, prop), inhabited
  );
}
