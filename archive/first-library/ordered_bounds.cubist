import ordered_squares;

// Weak inequalities derived from the constructive ordered-ring interface.
def order_le_refl(F : U1, lt : F -> F -> U0, order : StrictOrder(F, lt), x : F) :
  FieldLe(F, lt, x, x) {
  obtain (prop_, irreflexive, transitive, cotransitive, antisymmetric) := order;
  exact irreflexive(x);
}

def order_le_trans(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, lt : F -> F -> U0,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), x, y, z : F,
  xy : FieldLe(F, lt, x, y), yz : FieldLe(F, lt, y, z)
) :
  FieldLe(F, lt, x, z) {
  obtain (positiveOne, translate, scale, weakScale, ltLe, leLt, splitPositive) := arithmetic;
  intro zx;
  exact yz(ltLe(z, x, y, zx, xy));
}

def order_le_translate(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, lt : F -> F -> U0,
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), x, y, z : F,
  xy : FieldLe(F, lt, x, y)
) :
  FieldLe(F, lt, addF(x, z), addF(y, z)) {
  obtain (positiveOne, translate, scale, weakScale, ltLe, leLt, splitPositive) := arithmetic;
  obtain (forward, backward) := translate(y, x, z);
  intro reversed;
  exact xy(backward(reversed));
}

def order_le_add(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), x, y, u, v : F,
  xy : FieldLe(F, lt, x, y), uv : FieldLe(F, lt, u, v)
) :
  FieldLe(F, lt, addF(x, u), addF(y, v)) {
  let first := order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, x, y, u, xy);
  let shifted := order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, u, v, y, uv);
  let second :=
    transport shifted along ring_add_comm(F, zero, one, addF, mulF, negF, ring, u, y) in (
      (fun (a : F) => FieldLe(F, lt, a, addF(v, y)))
    );
  let third :=
    transport second along ring_add_comm(F, zero, one, addF, mulF, negF, ring, v, y) in FieldLe(
      F, lt, addF(y, u)
    );
  exact order_le_trans(
    F, zero, one, addF, mulF, lt, arithmetic, addF(x, u), addF(y, u), addF(y, v), first, third
  );
}

def order_le_add_nonnegative(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), x, y : F,
  aboveZeroWeak : FieldLe(F, lt, zero, y)
) :
  FieldLe(F, lt, x, addF(x, y)) {
  let shifted :=
    order_le_translate(F, zero, one, addF, mulF, lt, arithmetic, zero, y, x, aboveZeroWeak);
  let first :=
    transport shifted along ring_add_zero(F, zero, one, addF, mulF, negF, ring, x) in (
      (fun (a : F) => FieldLe(F, lt, a, addF(y, x)))
    );
  exact transport first along ring_add_comm(F, zero, one, addF, mulF, negF, ring, y, x) in FieldLe(
    F, lt, x
  );
}

def order_mul_nonnegative(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), x, y : F,
  nx : FieldLe(F, lt, zero, x), ny : FieldLe(F, lt, zero, y)
) :
  FieldLe(F, lt, zero, mulF(x, y)) {
  obtain (positiveOne, translate, scale, weakScale, ltLe, leLt, splitPositive) := arithmetic;
  exact transport weakScale(zero, x, y, nx, ny) along ring_zero_mul(
    F, zero, one, addF, mulF, negF, ring, y
  ) in ((fun (a : F) => FieldLe(F, lt, a, mulF(x, y))));
}
