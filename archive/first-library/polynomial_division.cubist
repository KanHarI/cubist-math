import polynomial_arithmetic;

// The remainder bound is strict: coefficients at d and above vanish.
// Thus a divisor with top degree d leaves a remainder of degree below d,
// including the zero remainder and division by a nonzero constant.
def DivisionResult(K : AlgebraicField, p, divisor : Polynomial(K), d : Nat) :=
  exists q : Polynomial(K). exists r : Polynomial(K).
  p = polynomial_add(K, polynomial_mul(K, q, divisor), r)
  and SeriesSupport(K, polynomial_coefficients(K, r), d);

def DivisionAdjustment(K : AlgebraicField, divisor : Polynomial(K), d : Nat, p : Polynomial(K)) :=
  exists a : af_carrier(K). exists r : Polynomial(K).
  p = polynomial_add(K, polynomial_scale(K, a, divisor), r)
  and SeriesSupport(K, polynomial_coefficients(K, r), d);

def division_adjust(
  K : AlgebraicField, divisor : Polynomial(K), d : Nat, b : af_carrier(K),
  inverse : field_mul(K, polynomial_coefficients(K, divisor, d), b) = field_one(K),
  sd : SeriesSupport(K, polynomial_coefficients(K, divisor), succ(d)), p : Polynomial(K),
  sp : SeriesSupport(K, polynomial_coefficients(K, p), succ(d))
) :
  DivisionAdjustment(K, divisor, d, p) {
  let lead := polynomial_coefficients(K, divisor, d);
  let last := polynomial_coefficients(K, p, d);
  let a := field_mul(K, b, last);
  let scaled := polynomial_scale(K, a, divisor);
  let r := polynomial_add(K, p, polynomial_neg(K, scaled));
  have remainder_top : polynomial_coefficients(K, r, d) = field_zero(K) := trans(
    cong(
      (fun (c : af_carrier(K)) => field_add(K, last, field_neg(K, c))),
      polynomial_scale_coefficient(K, a, divisor, d)
    ),
    trans(
      cong(
        (fun (c : af_carrier(K)) => field_add(K, last, field_neg(K, c))),
        scalar_pivot_cancel(K, lead, b, inverse, last)
      ), scalar_add_inverse_right(K, last)
    )
  );
  have equation : p = polynomial_add(K, scaled, r) := sym(
    trans(
      cong(polynomial_add(K, scaled), polynomial_add_comm(K, p, polynomial_neg(K, scaled))),
      polynomial_add_cancel_prefix(K, scaled, p)
    )
  );
  let support :=
    support_add_same(
      K, polynomial_coefficients(K, p), polynomial_coefficients(K, polynomial_neg(K, scaled)),
      succ(d), sp,
      polynomial_neg_support(
        K, scaled, succ(d), polynomial_scale_support(K, a, divisor, succ(d), sd)
      )
    );
  exact (
    a, r, equation, support_predecessor(K, polynomial_coefficients(K, r), d, support, remainder_top)
  );
}

def division_horner_identity(
  K : AlgebraicField, p, divisor, q, r : Polynomial(K),
  tailEquation : polynomial_tail(K, p) = polynomial_add(K, polynomial_mul(K, q, divisor), r),
  a : af_carrier(K), remainder : Polynomial(K),
  adjustment : polynomial_add(
    K, polynomial_constant(K, polynomial_coefficients(K, p, 0)), polynomial_shift(K, r)
  ) = polynomial_add(K, polynomial_scale(K, a, divisor), remainder)
) :
  p = polynomial_add(
    K,
    polynomial_mul(K, polynomial_add(K, polynomial_shift(K, q), polynomial_constant(K, a)), divisor),
    remainder
  ) {
  let C := polynomial_constant(K, polynomial_coefficients(K, p, 0));
  let A := polynomial_mul(K, polynomial_shift(K, q), divisor);
  let B := polynomial_shift(K, r);
  let scaled := polynomial_scale(K, a, divisor);
  exact trans(
    polynomial_decompose(K, p),
    trans(
      cong((fun (s : Polynomial(K)) => polynomial_add(K, C, polynomial_shift(K, s))), tailEquation),
      trans(
        cong(polynomial_add(K, C), polynomial_shift_add(K, polynomial_mul(K, q, divisor), r)),
        trans(
          cong(
            (fun (s : Polynomial(K)) => polynomial_add(K, C, polynomial_add(K, s, B))),
            polynomial_shift_mul(K, q, divisor)
          ),
          trans(
            polynomial_add_swap(K, C, A, B),
            trans(
              cong(polynomial_add(K, A), adjustment),
              trans(
                sym(polynomial_add_assoc(K, A, scaled, remainder)),
                cong(
                  (fun (s : Polynomial(K)) => polynomial_add(K, s, remainder)),
                  sym(
                    polynomial_distribute_left(
                      K, polynomial_shift(K, q), polynomial_constant(K, a), divisor
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  );
}

def division_horner_step(
  K : AlgebraicField, divisor : Polynomial(K), d : Nat, b : af_carrier(K),
  inverse : field_mul(K, polynomial_coefficients(K, divisor, d), b) = field_one(K),
  sd : SeriesSupport(K, polynomial_coefficients(K, divisor), succ(d)), p : Polynomial(K),
  tailResult : DivisionResult(K, polynomial_tail(K, p), divisor, d)
) :
  DivisionResult(K, p, divisor, d) {
  obtain (q, r, equation, support) := tailResult;
  let constant := polynomial_constant(K, polynomial_coefficients(K, p, 0));
  let temporary := polynomial_add(K, constant, polynomial_shift(K, r));
  let constantSupport :=
    support_weaken(
      K, polynomial_coefficients(K, constant), 1, succ(d), tt,
      support_constant(K, polynomial_coefficients(K, p, 0))
    );
  let temporarySupport :=
    support_add_same(
      K, polynomial_coefficients(K, constant), polynomial_coefficients(K, polynomial_shift(K, r)),
      succ(d), constantSupport, support_shift(K, polynomial_coefficients(K, r), d, support)
    );
  obtain (a, remainder, adjustment, remainderSupport) := division_adjust(
    K, divisor, d, b, inverse, sd, temporary, temporarySupport
  );
  exact (
    polynomial_add(K, polynomial_shift(K, q), polynomial_constant(K, a)), remainder,
    division_horner_identity(K, p, divisor, q, r, equation, a, remainder, adjustment),
    remainderSupport
  );
}

def division_zero(
  K : AlgebraicField, divisor : Polynomial(K), d : Nat, p : Polynomial(K),
  support : SeriesSupport(K, polynomial_coefficients(K, p), 0)
) :
  DivisionResult(K, p, divisor, d) {
  have product : polynomial_mul(K, polynomial_zero(K), divisor) = polynomial_zero(K) := trans(
    polynomial_mul_comm(K, polynomial_zero(K), divisor), polynomial_mul_zero(K, divisor)
  );
  exact (
    polynomial_zero(K), polynomial_zero(K),
    trans(
      support_zero_polynomial(K, p, support),
      sym(
        trans(
          cong((fun (s : Polynomial(K)) => polynomial_add(K, s, polynomial_zero(K))), product),
          polynomial_add_zero(K, polynomial_zero(K))
        )
      )
    ), (fun (k : Nat, above : le(d, k)) => refl(field_zero(K)))
  );
}

// Horner recursion divides by an arbitrary nonzero leading coefficient.
// Each recursive call removes one coefficient of the dividend.
def divide_with_bound(
  K : AlgebraicField, divisor : Polynomial(K), d : Nat, b : af_carrier(K),
  inverse : field_mul(K, polynomial_coefficients(K, divisor, d), b) = field_one(K),
  sd : SeriesSupport(K, polynomial_coefficients(K, divisor), succ(d)), n : Nat
) :=
  induction n as k return (
    forall p : Polynomial(K). SeriesSupport(K, polynomial_coefficients(K, p), k)
    -> DivisionResult(K, p, divisor, d)
  ) {
    zero => division_zero(K, divisor, d);
    succ previous => fun (
      p : Polynomial(K), support : SeriesSupport(K, polynomial_coefficients(K, p), succ(k))
    ) => division_horner_step(
      K, divisor, d, b, inverse, sd, p,
      previous(polynomial_tail(K, p), (fun (j : Nat, above : le(k, j)) => support(succ(j), above)))
    );
  };

def divide_by_degree(
  K : AlgebraicField, p, divisor : Polynomial(K), d : Nat,
  degree : polynomial_cutoff(K, divisor) = succ(d)
) :
  DivisionResult(K, p, divisor, d) {
  obtain (ring, nontrivial, inverses) := af_laws(K);
  obtain (b, inverse) := inverses(
    polynomial_coefficients(K, divisor, d), polynomial_leading_nonzero(K, divisor, d, degree)
  );
  let sd :=
    along SeriesSupport(K, polynomial_coefficients(K, divisor)) by degree from polynomial_cutoff_support(
      K, divisor
    );
  exact divide_with_bound(
    K, divisor, d, b, inverse, sd, polynomial_cutoff(K, p), p, polynomial_cutoff_support(K, p)
  );
}

def natural_predecessor(n : Nat) := induction n as k return Nat {
    zero => 0;
    succ ignored => k;
  };

def polynomial_degree(K : AlgebraicField, p : Polynomial(K)) :=
  natural_predecessor(polynomial_cutoff(K, p));

def PolynomialDivision(K : AlgebraicField, p, divisor : Polynomial(K)) :=
  DivisionResult(K, p, divisor, polynomial_degree(K, divisor));

// Division with remainder, for every nonzero formal polynomial over a field.
// The numerical degree convention at zero is unused for the divisor.
def polynomial_division(
  K : AlgebraicField, p, divisor : Polynomial(K), nonzero : (divisor = polynomial_zero(K)) -> Void
) :
  PolynomialDivision(K, p, divisor) {
  exact (
    induction polynomial_cutoff(K, divisor) as k return (
      (polynomial_cutoff(K, divisor) = k) -> PolynomialDivision(K, p, divisor)
    ) {
      zero => fun (degree : polynomial_cutoff(K, divisor) = 0) => typed(
        PolynomialDivision(K, p, divisor),
        absurd(nonzero(polynomial_cutoff_zero(K, divisor, degree)))
      );
      succ ignored => fun (degree : polynomial_cutoff(K, divisor) = succ(k)) => along(
        (fun (n : Nat) => DivisionResult(K, p, divisor, n))
      ) by sym(cong(natural_predecessor, degree)) from divide_by_degree(K, p, divisor, k, degree);
    }
  )(refl(polynomial_cutoff(K, divisor)));
}
