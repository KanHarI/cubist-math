import sample_chains;
import field_closeness;

// Bounds are required only for the finitely sampled edges. A positive slack
// radius makes the strict inequality valid also for the empty sum.

def SampleCloseBounds(
  C F : U1, addF : F -> F -> F, lt : F -> F -> U0, edge other radius : C -> C -> C -> F, n : Nat
) =
  induction n as k return (SampleVertices(C, k) -> SampleTags(C, k) -> U0) {
    zero => fun (vertices : C, tags : Unit) => Unit;
    succ previous => fun (vertices : SampleVertices(C, succ(k)), tags : SampleTags(C, succ(k))) => FieldClose(
      F, addF, lt,
      edge(
        field_fst(C, SampleVertices(C, k), vertices),
        sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
        field_fst(C, SampleTags(C, k), tags)
      ),
      other(
        field_fst(C, SampleVertices(C, k), vertices),
        sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
        field_fst(C, SampleTags(C, k), tags)
      ),
      radius(
        field_fst(C, SampleVertices(C, k), vertices),
        sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
        field_fst(C, SampleTags(C, k), tags)
      )
    )
    and previous(field_snd(C, SampleVertices(C, k), vertices), field_snd(C, SampleTags(C, k), tags));
  };

def sample_sum_error_bound(
  C F : U1, zero one : F, addF mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), edge other radius : C -> C -> C
  -> F, n : Nat
) :
  forall vertices : SampleVertices(C, n), forall tags : SampleTags(C, n),
  SampleCloseBounds(C, F, addF, lt, edge, other, radius, n, vertices, tags) -> forall epsilon : F,
  lt(zero, epsilon)
  -> FieldClose(
    F, addF, lt, sample_sum(C, F, zero, addF, edge, n, vertices, tags),
    sample_sum(C, F, zero, addF, other, n, vertices, tags),
    addF(sample_sum(C, F, zero, addF, radius, n, vertices, tags), epsilon)
  ) {
  exact induction n as k return (
    forall vertices : SampleVertices(C, k), forall tags : SampleTags(C, k),
    SampleCloseBounds(C, F, addF, lt, edge, other, radius, k, vertices, tags) -> forall epsilon : F,
    lt(zero, epsilon)
    -> FieldClose(
      F, addF, lt, sample_sum(C, F, zero, addF, edge, k, vertices, tags),
      sample_sum(C, F, zero, addF, other, k, vertices, tags),
      addF(sample_sum(C, F, zero, addF, radius, k, vertices, tags), epsilon)
    )
  ) {
    zero => fun (vertices : C, tags bounds : Unit, epsilon : F, positive : lt(zero, epsilon)) => along(
      (fun (r : F) => FieldClose(F, addF, lt, zero, zero, r))
    ) by sym(ring_add_zero(F, zero, one, addF, mulF, negF, ring, epsilon)) from field_close_self(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, zero, epsilon, positive
    );
    succ previous => fun (
      vertices : SampleVertices(C, succ(k)), tags : SampleTags(C, succ(k)),
      bounds : SampleCloseBounds(C, F, addF, lt, edge, other, radius, succ(k), vertices, tags),
      epsilon : F, positive : lt(zero, epsilon)
    ) => along(
      (
        fun (r : F) => FieldClose(
          F, addF, lt, sample_sum(C, F, zero, addF, edge, succ(k), vertices, tags),
          sample_sum(C, F, zero, addF, other, succ(k), vertices, tags), r
        )
      )
    ) by sym(
      ring_add_assoc(
        F, zero, one, addF, mulF, negF, ring,
        radius(
          field_fst(C, SampleVertices(C, k), vertices),
          sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
          field_fst(C, SampleTags(C, k), tags)
        ),
        sample_sum(
          C, F, zero, addF, radius, k, field_snd(C, SampleVertices(C, k), vertices),
          field_snd(C, SampleTags(C, k), tags)
        ), epsilon
      )
    ) from field_close_add(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic,
      edge(
        field_fst(C, SampleVertices(C, k), vertices),
        sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
        field_fst(C, SampleTags(C, k), tags)
      ),
      other(
        field_fst(C, SampleVertices(C, k), vertices),
        sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
        field_fst(C, SampleTags(C, k), tags)
      ),
      sample_sum(
        C, F, zero, addF, edge, k, field_snd(C, SampleVertices(C, k), vertices),
        field_snd(C, SampleTags(C, k), tags)
      ),
      sample_sum(
        C, F, zero, addF, other, k, field_snd(C, SampleVertices(C, k), vertices),
        field_snd(C, SampleTags(C, k), tags)
      ),
      radius(
        field_fst(C, SampleVertices(C, k), vertices),
        sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
        field_fst(C, SampleTags(C, k), tags)
      ),
      addF(
        sample_sum(
          C, F, zero, addF, radius, k, field_snd(C, SampleVertices(C, k), vertices),
          field_snd(C, SampleTags(C, k), tags)
        ), epsilon
      ),
      field_fst(
        FieldClose(
          F, addF, lt,
          edge(
            field_fst(C, SampleVertices(C, k), vertices),
            sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
            field_fst(C, SampleTags(C, k), tags)
          ),
          other(
            field_fst(C, SampleVertices(C, k), vertices),
            sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
            field_fst(C, SampleTags(C, k), tags)
          ),
          radius(
            field_fst(C, SampleVertices(C, k), vertices),
            sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
            field_fst(C, SampleTags(C, k), tags)
          )
        ),
        SampleCloseBounds(
          C, F, addF, lt, edge, other, radius, k, field_snd(C, SampleVertices(C, k), vertices),
          field_snd(C, SampleTags(C, k), tags)
        ), bounds
      ),
      previous(
        field_snd(C, SampleVertices(C, k), vertices), field_snd(C, SampleTags(C, k), tags),
        field_snd(
          FieldClose(
            F, addF, lt,
            edge(
              field_fst(C, SampleVertices(C, k), vertices),
              sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
              field_fst(C, SampleTags(C, k), tags)
            ),
            other(
              field_fst(C, SampleVertices(C, k), vertices),
              sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
              field_fst(C, SampleTags(C, k), tags)
            ),
            radius(
              field_fst(C, SampleVertices(C, k), vertices),
              sample_first(C, k, field_snd(C, SampleVertices(C, k), vertices)),
              field_fst(C, SampleTags(C, k), tags)
            )
          ),
          SampleCloseBounds(
            C, F, addF, lt, edge, other, radius, k, field_snd(C, SampleVertices(C, k), vertices),
            field_snd(C, SampleTags(C, k), tags)
          ), bounds
        ), epsilon, positive
      )
    );
  };
}
