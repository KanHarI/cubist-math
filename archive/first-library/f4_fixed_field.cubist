import f4_galois_group;
import galois_fixing_subgroups;

// The whole automorphism group; no decision about an arbitrary subgroup occurs.
def F4AllAutomorphisms(e : F4Automorphism) := Unit;

def F4Fixed(x : F4Carrier) := GaloisFixed(F2, F4OverF2, F4AllAutomorphisms, x);

def F2Image(x : F4Carrier) := exists k : F2Carrier, f2_into_f4(k) = x;

// Frobenius exchanges alpha and alpha+1. A point fixed by Frobenius
// must therefore be 0 or 1. The proof returns its actual base-field preimage.
def f4_frobenius_fixed_in_base(x : F4Carrier) : (f4_frobenius(x) = x) -> F2Image(x) {
  exact f4_induction(
    (fun (x : F4Carrier) => (f4_frobenius(x) = x) -> F2Image(x)),
    (fun (fixed : (f4_frobenius(f4_0) = f4_0)) => typed(F2Image(f4_0), (f2_0, refl(f4_0)))),
    (fun (fixed : (f4_frobenius(f4_1) = f4_1)) => typed(F2Image(f4_1), (f2_1, refl(f4_1)))),
    (fun (fixed : (f4_frobenius(f4_2) = f4_2)) => typed(F2Image(f4_2), absurd(f4_3_not_2(fixed)))),
    (
      fun (fixed : (f4_frobenius(f4_3) = f4_3)) => typed(
        F2Image(f4_3), absurd(f4_3_not_2(sym(fixed)))
      )
    ), x
  );
}

def f4_fixed_in_base(x : F4Carrier, fixed : F4Fixed(x)) : F2Image(x) {
  exact f4_frobenius_fixed_in_base(x, fixed(f4_frobenius_automorphism, tt));
}

def f4_base_is_fixed(x : F4Carrier, member : F2Image(x)) : F4Fixed(x) {
  obtain (k, same) := member;
  exact along F4Fixed by same from galois_fixed_contains_base(F2, F4OverF2, F4AllAutomorphisms, k);
}

// The fixed elements of Gal(F4/F2) are exactly the embedded base field.
// Both implications are constructive, without LEM, choice, or univalence.
def f4_fixed_field_is_base(x : F4Carrier) :
  (F4Fixed(x) -> F2Image(x)) and (F2Image(x) -> F4Fixed(x)) {
  exact (f4_fixed_in_base(x), f4_base_is_fixed(x));
}

// The embedding is injective, so its actual fibers are propositions. No
// truncation is required when expressing membership in this base-field image.
def f2_image_prop(x : F4Carrier, p q : F2Image(x)) : p = q {
  let fiber := (fun (k : F2Carrier) => f2_into_f4(k) = x);
  let k := sigma_first(F2Carrier, fiber, p);
  let l := sigma_first(F2Carrier, fiber, q);
  have pk : f2_into_f4(k) = x := sigma_second(F2Carrier, fiber, p);
  have ql : f2_into_f4(l) = x := sigma_second(F2Carrier, fiber, q);
  exact subtype_ext(
    F2Carrier, fiber, (fun (a : F2Carrier) => fin_is_set(4, f2_into_f4(a), x)), p, q,
    f2_inclusion_injective(k, l, trans(pk, sym(ql)))
  );
}

def f4_fixed_predicate_is_base : F4Fixed = F2Image {
  exact field_predicate_ext(
    F4Carrier, F4Fixed, F2Image, galois_fixed_prop(F2, F4OverF2, F4AllAutomorphisms), f2_image_prop,
    f4_fixed_field_is_base
  );
}

// Transport the fixed-field laws across the equality of membership predicates.
def f4_base_intermediate : IntermediateField(F2, F4OverF2) {
  let fixedLaws :=
    intermediate_laws(F2, F4OverF2, galois_fixed_field(F2, F4OverF2, F4AllAutomorphisms));
  exact (
    F2Image,
    along((fun (P : F4Carrier -> U0) => IntermediateFieldLaws(F2, F4OverF2, P))) by f4_fixed_predicate_is_base from fixedLaws
  );
}

def f4_fixed_intermediate_is_base :
  galois_fixed_field(F2, F4OverF2, F4AllAutomorphisms) =[IntermediateField(F2, F4OverF2)] f4_base_intermediate {
  exact intermediate_ext(
    F2, F4OverF2, galois_fixed_field(F2, F4OverF2, F4AllAutomorphisms), f4_base_intermediate,
    f4_fixed_predicate_is_base
  );
}
