import affine_integrals;
import complex_scalar_continuity;
import curve_integrand_sums;

// These are computed continuity witnesses, not extra assumptions on f+g or f*c.
def affine_integrand_add_uniform(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  inverses : FieldInverses(F, zero, one, mulF, lt), z, slope : Complex(F),
  f, g : Complex(F) -> Complex(F),
  uniformF : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => f(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ),
  uniformG : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => g(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  )
) :=
  complex_uniform_curve_add(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => f(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    ),
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => g(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    ), uniformF, uniformG
  );

def affine_integrand_scale_uniform(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt),
  inverses : FieldInverses(F, zero, one, mulF, lt), minF, maxF : F -> F -> F,
  lattice : FieldLattice(F, lt, minF, maxF), coefficient, z, slope : Complex(F),
  f : Complex(F) -> Complex(F),
  uniformF : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => f(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  )
) :=
  complex_uniform_curve_scale(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, minF, maxF, lattice,
    coefficient,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => f(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    ), uniformF
  );

// Finite-sum linearity and limit uniqueness prove integral linearity.
def affine_dyadic_integral_add(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), minF, maxF : F -> F -> F,
  lattice : FieldLattice(F, lt, minF, maxF), inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F. addF(half(x), half(x)) = x), z, slope : Complex(F), f, g : Complex(F)
  -> Complex(F),
  uniformF : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => f(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ),
  uniformG : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => g(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), a, b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt)
) :
  affine_dyadic_integral(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, (fun (x : Complex(F)) => complex_add(F, addF, f(x), g(x))),
    affine_integrand_add_uniform(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, z, slope, f, g,
      uniformF, uniformG
    ), a, b, ordered, complete
  ) = complex_add(
    F, addF,
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
    ),
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, g, uniformG, a, b, ordered, complete
    )
  ) {
  let curve := complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope);
  let combined := (fun (x : Complex(F)) => complex_add(F, addF, f(x), g(x)));
  let uniformSum :=
    affine_integrand_add_uniform(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, z, slope, f, g,
      uniformF, uniformG
    );
  let xs :=
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope, f, a, b,
      ordered
    );
  let ys :=
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope, g, a, b,
      ordered
    );
  let summed := (fun (n : Nat) => complex_add(F, addF, xs(n), ys(n)));
  let samples :=
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope,
      combined, a, b, ordered
    );
  let leftValue :=
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
    );
  let rightValue :=
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, g, uniformG, a, b, ordered, complete
    );
  let value := complex_add(F, addF, leftValue, rightValue);
  let halving :=
    ordered_field_halving(F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses);
  let convergence :=
    complex_converges_add(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, halving, xs, ys, leftValue,
      rightValue,
      affine_dyadic_integral_converges(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
        bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
      ),
      affine_dyadic_integral_converges(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
        bounds, half, halfSum, z, slope, g, uniformG, a, b, ordered, complete
      )
    );
  have computes : forall n : Nat. summed(n) = samples(n) {
    intro n;
    exact sym(
      curve_subdivision_samples_add(
        F, zero, one, addF, mulF, negF, lt, ring, curve, f, g, a, b,
        dyadic_piece(
          F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, n, a, b,
          ordered
        )
      )
    );
  }
  exact affine_dyadic_integral_unique(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, combined, uniformSum, a, b, ordered, complete, value,
    complex_converges_pointwise(F, zero, addF, lt, summed, samples, computes, value, convergence)
  );
}

def affine_dyadic_integral_scale(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), minF, maxF : F -> F -> F,
  lattice : FieldLattice(F, lt, minF, maxF), inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F. addF(half(x), half(x)) = x), z, slope : Complex(F), f : Complex(F)
  -> Complex(F), coefficient : Complex(F),
  uniformF : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => f(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ), a, b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt)
) :
  affine_dyadic_integral(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope,
    (fun (x : Complex(F)) => complex_mul(F, addF, mulF, negF, f(x), coefficient)),
    affine_integrand_scale_uniform(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, minF, maxF, lattice,
      coefficient, z, slope, f, uniformF
    ), a, b, ordered, complete
  ) = complex_mul(
    F, addF, mulF, negF,
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
    ), coefficient
  ) {
  let curve := complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope);
  let scaled := (fun (x : Complex(F)) => complex_mul(F, addF, mulF, negF, f(x), coefficient));
  let uniformScaled :=
    affine_integrand_scale_uniform(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, minF, maxF, lattice,
      coefficient, z, slope, f, uniformF
    );
  let original :=
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope, f, a, b,
      ordered
    );
  let products := (fun (n : Nat) => complex_mul(F, addF, mulF, negF, original(n), coefficient));
  let samples :=
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope, scaled,
      a, b, ordered
    );
  let originalValue :=
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
    );
  let value := complex_mul(F, addF, mulF, negF, originalValue, coefficient);
  let convergence :=
    complex_converges_scale(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, inverses, minF, maxF, lattice,
      coefficient, original, originalValue,
      affine_dyadic_integral_converges(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
        bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
      )
    );
  have computes : forall n : Nat. products(n) = samples(n) {
    intro n;
    exact sym(
      curve_subdivision_samples_scale(
        F, zero, one, addF, mulF, negF, lt, ring, curve, f, coefficient, a, b,
        dyadic_piece(
          F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, n, a, b,
          ordered
        )
      )
    );
  }
  exact affine_dyadic_integral_unique(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, scaled, uniformScaled, a, b, ordered, complete, value,
    complex_converges_pointwise(F, zero, addF, lt, products, samples, computes, value, convergence)
  );
}

def affine_dyadic_integral_cong(
  F : U1, zero, one : F, addF, mulF : F -> F -> F, negF : F -> F, lt : F -> F -> U0,
  ring : CommutativeRing(F, zero, one, addF, mulF, negF), order : StrictOrder(F, lt),
  arithmetic : OrderedArithmetic(F, zero, one, addF, mulF, lt), minF, maxF : F -> F -> F,
  lattice : FieldLattice(F, lt, minF, maxF), inverses : FieldInverses(F, zero, one, mulF, lt),
  bounds : ArchimedeanBounds(F, zero, one, addF, lt), half : F -> F,
  halfSum : (forall x : F. addF(half(x), half(x)) = x), z, slope : Complex(F), f, g : Complex(F)
  -> Complex(F),
  uniformF : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => f(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ),
  uniformG : ComplexUniformCurve(
    F, zero, one, addF, lt,
    (
      fun (t : FieldUnitInterval(F, zero, one, lt)) => g(
        complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
      )
    )
  ),
  same : (
    forall t : FieldUnitInterval(F, zero, one, lt).
    f(complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)) = g(
      complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope)(t)
    )
  ), a, b : FieldUnitInterval(F, zero, one, lt),
  ordered : FieldLe(
    F, lt, field_interval_coordinate(F, zero, one, lt)(a),
    field_interval_coordinate(F, zero, one, lt)(b)
  ), complete : CauchyComplete(F, zero, addF, lt)
) :
  affine_dyadic_integral(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
  ) = affine_dyadic_integral(
    F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
    bounds, half, halfSum, z, slope, g, uniformG, a, b, ordered, complete
  ) {
  let curve := complex_interval_deformation(F, zero, one, addF, mulF, lt, z, slope);
  let xs :=
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope, f, a, b,
      ordered
    );
  let ys :=
    affine_dyadic_sum(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, z, slope, g, a, b,
      ordered
    );
  let value :=
    affine_dyadic_integral(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
    );
  have computes : forall n : Nat. xs(n) = ys(n) {
    intro n;
    exact curve_subdivision_samples_cong(
      F, zero, one, addF, mulF, negF, lt, curve, f, g, same, a, b,
      dyadic_piece(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, half, halfSum, n, a, b, ordered
      )
    );
  }
  let converges :=
    complex_converges_pointwise(
      F, zero, addF, lt, xs, ys, computes, value,
      affine_dyadic_integral_converges(
        F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
        bounds, half, halfSum, z, slope, f, uniformF, a, b, ordered, complete
      )
    );
  exact sym(
    affine_dyadic_integral_unique(
      F, zero, one, addF, mulF, negF, lt, ring, order, arithmetic, minF, maxF, lattice, inverses,
      bounds, half, halfSum, z, slope, g, uniformG, a, b, ordered, complete, value, converges
    )
  );
}
