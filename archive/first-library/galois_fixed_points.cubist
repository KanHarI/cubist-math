import galois_paths;
import order_maps;

// Elements fixed by every automorphism belonging to H.
def GaloisFixed(
  K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0, x : extension_carrier(K, E)
) :=
  forall e : Galois(K, E), H(e) -> (extension_iso_forward(K, E, E, e, x) = x);

// Automorphisms fixing every element belonging to P, pointwise.
def GaloisFixing(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0, e : Galois(K, E)
) :=
  forall x : extension_carrier(K, E), P(x) -> (extension_iso_forward(K, E, E, e, x) = x);

// H fixes P exactly when every element of P is fixed by H. This is the
// order-reversing Galois connection, before any finiteness or Galois hypothesis.
def GaloisConnection(
  K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0, P : extension_carrier(K, E) -> U0
) :=
  (
    PredicateIncluded(Galois(K, E), H, GaloisFixing(K, E, P))
    -> PredicateIncluded(extension_carrier(K, E), P, GaloisFixed(K, E, H))
  )
  and (
    PredicateIncluded(extension_carrier(K, E), P, GaloisFixed(K, E, H))
    -> PredicateIncluded(Galois(K, E), H, GaloisFixing(K, E, P))
  );

def galois_connection(
  K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0, P : extension_carrier(K, E) -> U0
) :
  GaloisConnection(K, E, H, P) {
  exact (
    (
      fun (
        fixes : PredicateIncluded(Galois(K, E), H, GaloisFixing(K, E, P)),
        x : extension_carrier(K, E), px : P(x), e : Galois(K, E), he : H(e)
      ) => typed(GaloisFixing(K, E, P, e), fixes(e, he))(x, px)
    ),
    (
      fun (
        fixed : PredicateIncluded(extension_carrier(K, E), P, GaloisFixed(K, E, H)),
        e : Galois(K, E), he : H(e), x : extension_carrier(K, E), px : P(x)
      ) => typed(GaloisFixed(K, E, H, x), fixed(x, px))(e, he)
    )
  );
}

// Enlarging a family of automorphisms can only shrink its fixed elements.
def galois_fixed_antitone(
  K : AlgebraicField, E : FieldExt(K), H J : Galois(K, E) -> U0,
  included : PredicateIncluded(Galois(K, E), H, J)
) :
  PredicateIncluded(extension_carrier(K, E), GaloisFixed(K, E, J), GaloisFixed(K, E, H)) {
  exact (
    fun (
      x : extension_carrier(K, E), fixed : GaloisFixed(K, E, J, x), e : Galois(K, E), member : H(e)
    ) => fixed(e, included(e, member))
  );
}

// Enlarging the subset to be fixed can only shrink its fixing automorphisms.
def galois_fixing_antitone(
  K : AlgebraicField, E : FieldExt(K), P Q : extension_carrier(K, E) -> U0,
  included : PredicateIncluded(extension_carrier(K, E), P, Q)
) :
  PredicateIncluded(Galois(K, E), GaloisFixing(K, E, Q), GaloisFixing(K, E, P)) {
  exact (
    fun (
      e : Galois(K, E), fixes : GaloisFixing(K, E, Q, e), x : extension_carrier(K, E), member : P(x)
    ) => fixes(x, included(x, member))
  );
}

def galois_fixed_fixing_contains(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0
) :
  PredicateIncluded(extension_carrier(K, E), P, GaloisFixed(K, E, GaloisFixing(K, E, P))) {
  exact (
    fun (
      x : extension_carrier(K, E), member : P(x), e : Galois(K, E), fixes : GaloisFixing(K, E, P, e)
    ) => fixes(x, member)
  );
}

def galois_fixing_fixed_contains(K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0) :
  PredicateIncluded(Galois(K, E), H, GaloisFixing(K, E, GaloisFixed(K, E, H))) {
  exact (
    fun (
      e : Galois(K, E), member : H(e), x : extension_carrier(K, E), fixed : GaloisFixed(K, E, H, x)
    ) => fixed(e, member)
  );
}

// Fixing a fixed set and then taking fixed elements adds nothing further.
// Together with containment above this gives idempotence of the closure.
def galois_fixed_closure_idempotent(K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0) :
  PredicateIncluded(
    extension_carrier(K, E), GaloisFixed(K, E, GaloisFixing(K, E, GaloisFixed(K, E, H))),
    GaloisFixed(K, E, H)
  ) {
  exact galois_fixed_antitone(
    K, E, H, GaloisFixing(K, E, GaloisFixed(K, E, H)), galois_fixing_fixed_contains(K, E, H)
  );
}

def galois_fixing_closure_idempotent(
  K : AlgebraicField, E : FieldExt(K), P : extension_carrier(K, E) -> U0
) :
  PredicateIncluded(
    Galois(K, E), GaloisFixing(K, E, GaloisFixed(K, E, GaloisFixing(K, E, P))),
    GaloisFixing(K, E, P)
  ) {
  exact galois_fixing_antitone(
    K, E, P, GaloisFixed(K, E, GaloisFixing(K, E, P)), galois_fixed_fixing_contains(K, E, P)
  );
}

// The same invariant stated using transport around the corresponding HoTT loops.
def GaloisLoopInvariant(
  K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0, x : extension_carrier(K, E)
) :=
  forall e : Galois(K, E), H(e)
  -> ((along extension_carrier(K) by extension_iso_path(K, E, E, e) from x) = x);

def galois_fixed_is_loop_invariant(
  K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0, x : extension_carrier(K, E),
  fixed : GaloisFixed(K, E, H, x)
) :
  GaloisLoopInvariant(K, E, H, x) {
  intro e member;
  exact trans(galois_loop_action(K, E, e, x), fixed(e, member));
}

def galois_loop_invariant_is_fixed(
  K : AlgebraicField, E : FieldExt(K), H : Galois(K, E) -> U0, x : extension_carrier(K, E),
  invariant : GaloisLoopInvariant(K, E, H, x)
) :
  GaloisFixed(K, E, H, x) {
  intro e member;
  exact trans(sym(galois_loop_action(K, E, e, x)), invariant(e, member));
}
