import finite_remainders;
import span_subspace;

// Closure under negation follows from multiplication by -1.
def subspace_neg(
  K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V), x : vector_carrier(K, V),
  member : subspace_members(K, V, S, x)
) :
  subspace_members(K, V, S, vector_neg(K, V, x)) {
  let minusOne := af_neg(af_carrier(K), af_operations(K), af_one(af_carrier(K), af_operations(K)));
  exact along subspace_members(K, V, S) by vector_minus_one_scale(K, V, x) from subspace_scale(
    K, V, S, minusOne, x, member
  );
}

// If a*x + y = 0, a is nonzero, and y belongs to a subspace, then x

// belongs to it as well. The inverse is actual field data, not an axiom.
def subspace_solve_nonzero(
  K : AlgebraicField, V : VectorSpace(K), S : Subspace(K, V), a : af_carrier(K),
  nonzero : FieldNonzero(af_carrier(K), af_operations(K), a), x y : vector_carrier(K, V),
  member : subspace_members(K, V, S, y),
  vanishes : vector_add(K, V, vector_scale(K, V, a, x), y) = vector_zero(K, V)
) :
  subspace_members(K, V, S, x) {
  obtain (ring, nontrivial, inverses) := af_laws(K);
  obtain (addLaws, mulLaws) := ring;
  obtain (assoc, comm, one, distribute) := mulLaws;
  obtain (b, inverse) := inverses(a, nonzero);
  let leftInverse := trans(comm(b, a), inverse);
  let G := vector_group(K, V);
  let scaled := vector_scale(K, V, a, x);
  have solve : scaled = vector_neg(K, V, y) := group_inverse_unique(
    vector_carrier(K, V), vector_zero(K, V), vector_add(K, V), group_laws(G), y, scaled,
    vector_neg(K, V, y), vanishes, group_inverse_right(G, y)
  );
  have unscaled : vector_scale(K, V, b, vector_neg(K, V, y)) = x := trans(
    sym(cong(vector_scale(K, V, b), solve)), vector_scale_undo(K, V, a, b, leftInverse, x)
  );
  exact along subspace_members(K, V, S) by unscaled from subspace_scale(
    K, V, S, b, vector_neg(K, V, y), subspace_neg(K, V, S, y, member)
  );
}

// Isolate any selected coefficient, not just the first one. Repeated

// vectors elsewhere are allowed; the proof does not decide their equality.
def nonzero_coefficient_in_span(
  K : AlgebraicField, V : VectorSpace(K), P : vector_carrier(K, V) -> U0, n : Nat, v : Fin(n)
  -> vector_carrier(K, V), a : Fin(n) -> af_carrier(K), i : Fin(n),
  others : (forall j : Fin(n), ((j = i) -> Void) -> P(v(j))),
  nonzero : FieldNonzero(af_carrier(K), af_operations(K), a(i)),
  vanishes : linear_combination(K, V, n, v, a) = vector_zero(K, V)
) :
  Span(K, V, P, v(i)) {
  let S := SpanSubspace(K, V, P);
  let rest := linear_remainder(K, V, n, v, a, i);
  exact subspace_solve_nonzero(
    K, V, S, a(i), nonzero, v(i), rest,
    remainder_in_subspace(
      K, V, S, n, v, a, i,
      (
        fun (j : Fin(n), different : (j = i) -> Void) => span_generator(
          K, V, P, v(j), others(j, different)
        )
      )
    ), trans(sym(linear_combination_split(K, V, n, v, a, i)), vanishes)
  );
}
