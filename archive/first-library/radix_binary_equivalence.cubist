import radix_equivalence;
import radix_arithmetic_correct;
import binary_arithmetic_correct;

// Direct digit conversion computes in binary. It does not first construct a
// unary natural number; unary evaluation is used only in the correctness proof.
opaque def radix_positive_to_binary(extra : Nat, p : RadixPositive(extra)) =
  radix_positive_rec(
    extra, BinaryNat,
    (
      fun (first : RadixDigit(succ(extra))) => binary_of_nat(
        succ(radix_digit_value(succ(extra), first))
      )
    ),
    (
      fun (digit : RadixDigit(succ(succ(extra))), child : RadixPositive(extra), ih : BinaryNat) => binary_add(
        binary_mul(binary_of_nat(succ(succ(extra))), ih),
        binary_of_nat(radix_digit_value(succ(succ(extra)), digit))
      )
    ), p
  );

opaque def radix_to_binary(extra : Nat, n : RadixNat(extra)) = match n return BinaryNat {
    left zero => binary_zero;
    right p => radix_positive_to_binary(extra, p);
  };

def radix_binary_leading_correct(extra : Nat, d : RadixDigit(succ(extra))) :
  binary_to_nat(radix_positive_to_binary(extra, radix_leading(extra, d))) = radix_positive_to_nat(
    extra, radix_leading(extra, d)
  ) {
  exact binary_nat_roundtrip(succ(radix_digit_value(succ(extra), d)));
}

def radix_binary_append_correct(
  extra : Nat, d : RadixDigit(succ(succ(extra))), p : RadixPositive(extra),
  ih : binary_to_nat(radix_positive_to_binary(extra, p)) = radix_positive_to_nat(extra, p)
) :
  binary_to_nat(radix_positive_to_binary(extra, radix_append(extra, d, p))) = radix_positive_to_nat(
    extra, radix_append(extra, d, p)
  ) {
  let base = succ(succ(extra));
  let digit = radix_digit_value(base, d);
  let converted = radix_positive_to_binary(extra, p);
  exact trans(
    binary_decode_add(binary_mul(binary_of_nat(base), converted), binary_of_nat(digit)),
    trans(
      cong(
        (fun (v : Nat) => v + binary_to_nat(binary_of_nat(digit))),
        binary_decode_mul(binary_of_nat(base), converted)
      ),
      trans(
        cong(
          (fun (v : Nat) => v * binary_to_nat(converted) + binary_to_nat(binary_of_nat(digit))),
          binary_nat_roundtrip(base)
        ),
        trans(
          cong((fun (v : Nat) => base * v + binary_to_nat(binary_of_nat(digit))), ih),
          cong(add(base * radix_positive_to_nat(extra, p)), binary_nat_roundtrip(digit))
        )
      )
    )
  );
}

def radix_binary_positive_correct(extra : Nat, p : RadixPositive(extra)) :
  binary_to_nat(radix_positive_to_binary(extra, p)) = radix_positive_to_nat(extra, p) {
  exact radix_positive_induction(
    extra,
    (
      fun (q : RadixPositive(extra)) => binary_to_nat(radix_positive_to_binary(extra, q)) = radix_positive_to_nat(
        extra, q
      )
    ), radix_binary_leading_correct(extra), radix_binary_append_correct(extra), p
  );
}

def radix_binary_correct(extra : Nat, n : RadixNat(extra)) :
  binary_to_nat(radix_to_binary(extra, n)) = radix_to_nat(extra, n) {
  exact match n as x return (binary_to_nat(radix_to_binary(extra, x)) = radix_to_nat(extra, x)) {
    left zero => refl(0);
    right p => radix_binary_positive_correct(extra, p);
  };
}

// Conversion in the other direction doubles/adds digits in the target radix.
opaque def binary_positive_to_radix(extra : Nat, p : BinaryPositive) =
  binary_positive_rec(
    RadixNat(extra), radix_positive(extra, radix_one(extra)),
    (fun (child : BinaryPositive, ih : RadixNat(extra)) => radix_add(extra, ih, ih)),
    (
      fun (child : BinaryPositive, ih : RadixNat(extra)) => radix_succ(
        extra, radix_add(extra, ih, ih)
      )
    ), p
  );

opaque def binary_to_radix(extra : Nat, n : BinaryNat) = match n return RadixNat(extra) {
    left zero => radix_zero(extra);
    right p => binary_positive_to_radix(extra, p);
  };

def binary_radix_even_correct(
  extra : Nat, p : BinaryPositive,
  ih : radix_to_nat(extra, binary_positive_to_radix(extra, p)) = binary_positive_to_nat(p)
) :
  radix_to_nat(extra, binary_positive_to_radix(extra, binary_bit0(p))) = binary_positive_to_nat(
    binary_bit0(p)
  ) {
  exact trans(
    radix_decode_add(extra, binary_positive_to_radix(extra, p), binary_positive_to_radix(extra, p)),
    cong((fun (v : Nat) => v + v), ih)
  );
}

def binary_radix_odd_correct(
  extra : Nat, p : BinaryPositive,
  ih : radix_to_nat(extra, binary_positive_to_radix(extra, p)) = binary_positive_to_nat(p)
) :
  radix_to_nat(extra, binary_positive_to_radix(extra, binary_bit1(p))) = binary_positive_to_nat(
    binary_bit1(p)
  ) {
  exact trans(
    radix_decode_succ(
      extra,
      radix_add(extra, binary_positive_to_radix(extra, p), binary_positive_to_radix(extra, p))
    ),
    cong(
      succ,
      trans(
        radix_decode_add(
          extra, binary_positive_to_radix(extra, p), binary_positive_to_radix(extra, p)
        ), cong((fun (v : Nat) => v + v), ih)
      )
    )
  );
}

def binary_radix_positive_correct(extra : Nat, p : BinaryPositive) :
  radix_to_nat(extra, binary_positive_to_radix(extra, p)) = binary_positive_to_nat(p) {
  exact binary_positive_induction(
    (
      fun (q : BinaryPositive) => radix_to_nat(extra, binary_positive_to_radix(extra, q)) = binary_positive_to_nat(
        q
      )
    ), radix_decode_one(extra), binary_radix_even_correct(extra), binary_radix_odd_correct(extra), p
  );
}

def binary_radix_correct(extra : Nat, n : BinaryNat) :
  radix_to_nat(extra, binary_to_radix(extra, n)) = binary_to_nat(n) {
  exact match n as x return (radix_to_nat(extra, binary_to_radix(extra, x)) = binary_to_nat(x)) {
    left zero => refl(0);
    right p => binary_radix_positive_correct(extra, p);
  };
}

def binary_injective(a b : BinaryNat, same : binary_to_nat(a) = binary_to_nat(b)) : a = b {
  exact trans(sym(binary_roundtrip(a)), trans(cong(binary_of_nat, same), binary_roundtrip(b)));
}

def radix_binary_roundtrip(extra : Nat, n : RadixNat(extra)) :
  binary_to_radix(extra, radix_to_binary(extra, n)) = n {
  exact radix_injective(
    extra, binary_to_radix(extra, radix_to_binary(extra, n)), n,
    trans(binary_radix_correct(extra, radix_to_binary(extra, n)), radix_binary_correct(extra, n))
  );
}

def binary_radix_roundtrip(extra : Nat, n : BinaryNat) :
  radix_to_binary(extra, binary_to_radix(extra, n)) = n {
  exact binary_injective(
    radix_to_binary(extra, binary_to_radix(extra, n)), n,
    trans(radix_binary_correct(extra, binary_to_radix(extra, n)), binary_radix_correct(extra, n))
  );
}

def radix_binary_equiv(extra : Nat) =
  equiv_from_inverse(
    U0, RadixNat(extra), BinaryNat, radix_to_binary(extra), binary_to_radix(extra),
    radix_binary_roundtrip(extra), binary_radix_roundtrip(extra)
  );

def binary_radix_equiv(extra : Nat) =
  equiv_from_inverse(
    U0, BinaryNat, RadixNat(extra), binary_to_radix(extra), radix_to_binary(extra),
    binary_radix_roundtrip(extra), radix_binary_roundtrip(extra)
  );

// Small conversion certificates permit evaluation one digit at a time.
// The checked evaluator need never expand all recursive calls simultaneously.
def radix_binary_leading_beta(extra : Nat, d : RadixDigit(succ(extra))) :
  radix_positive_to_binary(extra, radix_leading(extra, d)) = binary_of_nat(
    succ(radix_digit_value(succ(extra), d))
  ) {
  rfl;
}

def radix_binary_append_beta(
  extra : Nat, d : RadixDigit(succ(succ(extra))), p : RadixPositive(extra)
) :
  radix_positive_to_binary(extra, radix_append(extra, d, p)) = binary_add(
    binary_mul(binary_of_nat(succ(succ(extra))), radix_positive_to_binary(extra, p)),
    binary_of_nat(radix_digit_value(succ(succ(extra)), d))
  ) {
  rfl;
}

def radix_binary_append_value(
  extra : Nat, d : RadixDigit(succ(succ(extra))), p : RadixPositive(extra), value : BinaryNat,
  previous : radix_positive_to_binary(extra, p) = value
) :
  radix_positive_to_binary(extra, radix_append(extra, d, p)) = binary_add(
    binary_mul(binary_of_nat(succ(succ(extra))), value),
    binary_of_nat(radix_digit_value(succ(succ(extra)), d))
  ) {
  exact trans(
    radix_binary_append_beta(extra, d, p),
    cong(
      (
        fun (v : BinaryNat) => binary_add(
          binary_mul(binary_of_nat(succ(succ(extra))), v),
          binary_of_nat(radix_digit_value(succ(succ(extra)), d))
        )
      ), previous
    )
  );
}

def radix_binary_positive_beta(extra : Nat, p : RadixPositive(extra)) :
  radix_to_binary(extra, radix_positive(extra, p)) = radix_positive_to_binary(extra, p) {
  rfl;
}
