import field_extensionality;

// Construct a function on a type from fiber-constant values on a merely
// surjective presentation. Only the unique VALUE is extracted, never a
// representative. The presented type B need not be a set.
def DescentValue(A B G : U1, present : A -> B, value : A -> G, b : B, v : G) =
  forall a : A, (present(a) = b) -> value(a) = v;

def DescentData(A B G : U1, present : A -> B, value : A -> G, b : B) =
  exists v : G, DescentValue(A, B, G, present, value, b, v);

def descent_value_prop(
  A B G : U1, setG : FieldSet(G), present : A -> B, value : A -> G, b : B, v : G
) :
  FieldProp(DescentValue(A, B, G, present, value, b, v)) {
  exact field_forall_prop(
    A, (fun (a : A) => typed(U1, (present(a) = b) -> value(a) = v)),
    (
      fun (a : A) => field_forall_prop(
        (present(a) = b), (fun (same : present(a) = b) => typed(U1, value(a) = v)),
        (fun (same : present(a) = b) => setG(value(a), v))
      )
    )
  );
}

def descent_data_prop(
  A B G : U1, setG : FieldSet(G), present : A -> B, value : A -> G, b : B,
  covered : FieldExists(exists a : A, present(a) = b)
) :
  FieldProp(DescentData(A, B, G, present, value, b)) {
  intro u v;
  let family = DescentValue(A, B, G, present, value, b);
  let first = field_first(G, family, u);
  let second = field_first(G, family, v);
  have firstLaw : forall a : A, (present(a) = b) -> value(a) = first := field_second(G, family, u);
  have secondLaw : forall a : A, (present(a) = b)
  -> value(a) = second := field_second(G, family, v);
  have same : first = second := field_exists_elim(
    (exists a : A, present(a) = b), (first = second), setG(first, second),
    (
      fun (witness : (exists a : A, present(a) = b)) => unpack witness as (a, represents) return (
        first = second
      ) {
        trans(sym(firstLaw(a, represents)), secondLaw(a, represents));
      }
    ), covered
  );
  exact field_subtype_ext(
    G, family, descent_value_prop(A, B, G, setG, present, value, b), u, v, same
  );
}

def surjective_descent_data(
  A B G : U1, setG : FieldSet(G), present : A -> B, value : A -> G,
  covered : (forall b : B, FieldExists(exists a : A, present(a) = b)),
  consistent : (forall a : A, forall a2 : A, (present(a) = present(a2)) -> value(a) = value(a2)),
  b : B
) :
  DescentData(A, B, G, present, value, b) {
  exact field_exists_elim(
    (exists a : A, present(a) = b), DescentData(A, B, G, present, value, b),
    descent_data_prop(A, B, G, setG, present, value, b, covered(b)),
    (
      fun (witness : (exists a : A, present(a) = b)) => unpack witness as (a, represents) return DescentData(
        A, B, G, present, value, b
      ) {
        (
          value(a),
          (fun (a2 : A, same : present(a2) = b) => consistent(a2, a, trans(same, sym(represents))))
        );
      }
    ), covered(b)
  );
}

def surjective_descent(
  A B G : U1, setG : FieldSet(G), present : A -> B, value : A -> G,
  covered : (forall b : B, FieldExists(exists a : A, present(a) = b)),
  consistent : (forall a : A, forall a2 : A, (present(a) = present(a2)) -> value(a) = value(a2)),
  b : B
) =
  field_first(
    G, DescentValue(A, B, G, present, value, b),
    surjective_descent_data(A, B, G, setG, present, value, covered, consistent, b)
  );

def surjective_descent_beta(
  A B G : U1, setG : FieldSet(G), present : A -> B, value : A -> G,
  covered : (forall b : B, FieldExists(exists a : A, present(a) = b)),
  consistent : (forall a : A, forall a2 : A, (present(a) = present(a2)) -> value(a) = value(a2)),
  a : A
) :
  surjective_descent(A, B, G, setG, present, value, covered, consistent, present(a)) = value(a) {
  let data =
    surjective_descent_data(A, B, G, setG, present, value, covered, consistent, present(a));
  have law : forall a2 : A, (present(a2) = present(a))
  -> value(a2) = field_first(G, DescentValue(A, B, G, present, value, present(a)), data) := field_second(
    G, DescentValue(A, B, G, present, value, present(a)), data
  );
  exact sym(law(a, refl(present(a))));
}
