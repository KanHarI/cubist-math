import puncture_graph;

// An auxiliary family whose fiber is the existing loop space. Its meridians
// act by appending generators. This is not an assertion of freeness.
def bouquet_code_edges(A : U0, label : Unit or A) =
  match label return (BouquetLoops(A) = BouquetLoops(A)) {
    left u => refl(BouquetLoops(A));
    right a => ua(
      U0, BouquetLoops(A), BouquetLoops(A),
      append_path_equivalence(
        Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a)
      )
    );
  };

def bouquet_code(A : U0) =
  suspension_rec(Unit or A, U0, BouquetLoops(A), BouquetLoops(A), bouquet_code_edges(A));

def bouquet_univalent_action(A : U0, a : A, p : BouquetLoops(A)) :
  (
    along((fun (T : U0) => T)) by ua(
      U0, BouquetLoops(A), BouquetLoops(A),
      append_path_equivalence(
        Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a)
      )
    ) from p
  ) = trans(p, bouquet_generator(A, a)) {
  exact UnivalenceBeta(
    U0, BouquetLoops(A), BouquetLoops(A),
    append_path_equivalence(
      Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a)
    ), p
  );
}

def bouquet_spoke_action(A : U0, p : BouquetLoops(A)) :
  (along bouquet_code(A) by bouquet_spoke(A) from p) = p {
  exact trans(
    trans(
      transport_ap(
        Bouquet(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A), p
      ),
      cong(
        (fun (q : BouquetLoops(A) = BouquetLoops(A)) => along((fun (T : U0) => T)) by q from p),
        suspension_rec_beta(
          Unit or A, U0, BouquetLoops(A), BouquetLoops(A), bouquet_code_edges(A),
          typed(Unit or A, left(tt))
        )
      )
    ),
    transport_constant(
      U0, BouquetLoops(A), BouquetLoops(A), BouquetLoops(A), refl(BouquetLoops(A)), p
    )
  );
}

def bouquet_edge_action(A : U0, a : A, p : BouquetLoops(A)) :
  (along bouquet_code(A) by bouquet_edge(A, a) from p) = trans(p, bouquet_generator(A, a)) {
  exact trans(
    transport_ap(
      Bouquet(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A), bouquet_edge(A, a), p
    ),
    trans(
      cong(
        (fun (q : BouquetLoops(A) = BouquetLoops(A)) => along((fun (T : U0) => T)) by q from p),
        suspension_rec_beta(
          Unit or A, U0, BouquetLoops(A), BouquetLoops(A), bouquet_code_edges(A),
          typed(Unit or A, right(a))
        )
      ), bouquet_univalent_action(A, a, p)
    )
  );
}

def bouquet_spoke_backward(A : U0, p : BouquetLoops(A)) :
  (along bouquet_code(A) by sym(bouquet_spoke(A)) from p) = p {
  let before = along bouquet_code(A) by sym(bouquet_spoke(A)) from p;
  exact trans(
    sym(bouquet_spoke_action(A, before)),
    transport_after_inverse(
      Bouquet(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A), bouquet_spoke(A), p
    )
  );
}

def bouquet_edge_backward(A : U0, a : A, p : BouquetLoops(A)) :
  (along bouquet_code(A) by sym(bouquet_edge(A, a)) from p) = trans(p, sym(bouquet_generator(A, a))) {
  let before = along bouquet_code(A) by sym(bouquet_edge(A, a)) from p;
  let undo = fun (q : BouquetLoops(A)) => trans(q, sym(bouquet_generator(A, a)));
  let forwardSame =
    trans(
      sym(bouquet_edge_action(A, a, before)),
      transport_after_inverse(
        Bouquet(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A), bouquet_edge(A, a), p
      )
    );
  exact trans(
    sym(
      append_path_left_inverse(
        Bouquet(A), bouquet_base(A), bouquet_base(A), bouquet_base(A), bouquet_generator(A, a),
        before
      )
    ), cong(undo, forwardSame)
  );
}

def bouquet_south_decoder(A : U0, p : BouquetLoops(A)) = trans(p, bouquet_spoke(A));

def bouquet_decoder_edge(A : U0, a : A, p : BouquetLoops(A)) :
  trans(trans(p, sym(bouquet_generator(A, a))), bouquet_edge(A, a)) = bouquet_south_decoder(A, p) {
  let X = Bouquet(A);
  let n = bouquet_base(A);
  let s = bouquet_tip(A);
  let g = bouquet_generator(A, a);
  let r = bouquet_spoke(A);
  let before = trans(p, sym(g));
  exact trans(
    cong(
      (fun (q : n = n) => trans(q, bouquet_edge(A, a))), append_path_agrees(X, n, n, n, p, sym(g))
    ),
    trans(
      cong((fun (q : n = s) => trans(before, q)), sym(bouquet_generator_spoke(A, a))),
      trans(
        sym(path_associative(X, n, n, n, s, before, g, r)),
        cong((fun (q : n = n) => trans(q, r)), append_inverse_cancel(X, n, n, n, p, g))
      )
    )
  );
}

def bouquet_decoder_family(A : U0, x : Bouquet(A)) = bouquet_code(A, x) -> (bouquet_base(A) = x);

def bouquet_decoder_spoke(A : U0) :
  (along bouquet_decoder_family(A) by bouquet_spoke(A) from(fun (p : BouquetLoops(A)) => p)) = bouquet_south_decoder(
    A
  ) {
  ext p;
  exact trans(
    transport_decoder(
      Bouquet(A), bouquet_base(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A),
      bouquet_spoke(A), (fun (q : BouquetLoops(A)) => q), p
    ),
    cong((fun (q : BouquetLoops(A)) => bouquet_south_decoder(A, q)), bouquet_spoke_backward(A, p))
  );
}

def bouquet_decoder_meridian(A : U0, a : A) :
  (along bouquet_decoder_family(A) by bouquet_edge(A, a) from(fun (p : BouquetLoops(A)) => p)) = bouquet_south_decoder(
    A
  ) {
  ext p;
  exact trans(
    transport_decoder(
      Bouquet(A), bouquet_base(A), bouquet_code(A), bouquet_base(A), bouquet_tip(A),
      bouquet_edge(A, a), (fun (q : BouquetLoops(A)) => q), p
    ),
    trans(
      cong(
        (fun (q : BouquetLoops(A)) => trans(q, bouquet_edge(A, a))), bouquet_edge_backward(A, a, p)
      ), bouquet_decoder_edge(A, a, p)
    )
  );
}

def bouquet_decoder_edges(A : U0, label : Unit or A) =
  match label as e return (
    (along bouquet_decoder_family(A) by meridian(Unit or A, e) from(fun (p : BouquetLoops(A)) => p)) = bouquet_south_decoder(
      A
    )
  ) {
    left u => unit_induction(
      (
        fun (v : Unit) => (
          along bouquet_decoder_family(A) by meridian(Unit or A, typed(Unit or A, left(v))) from(
            fun (p : BouquetLoops(A)) => p
          )
        ) = bouquet_south_decoder(A)
      ), bouquet_decoder_spoke(A), u
    );
    right a => bouquet_decoder_meridian(A, a);
  };

def bouquet_decode(A : U0, x : Bouquet(A)) =
  suspension_induction(
    (Unit or A), bouquet_decoder_family(A), (fun (p : BouquetLoops(A)) => p),
    bouquet_south_decoder(A), bouquet_decoder_edges(A), x
  );

def bouquet_encode(A : U0, x : Bouquet(A), p : bouquet_base(A) = x) =
  along bouquet_code(A) by p from refl(bouquet_base(A));

def bouquet_decode_encode(A : U0, x : Bouquet(A), p : bouquet_base(A) = x) :
  bouquet_decode(A, x, bouquet_encode(A, x, p)) = p {
  exact based_induction(
    U1, U0, Bouquet(A), bouquet_base(A),
    (
      fun (point : Bouquet(A)) (path : bouquet_base(A) = point) => bouquet_decode(
        A, point, bouquet_encode(A, point, path)
      ) = path
    ),
    transport_constant(
      Bouquet(A), BouquetLoops(A), bouquet_base(A), bouquet_base(A), refl(bouquet_base(A)),
      refl(bouquet_base(A))
    ), x, p
  );
}
