import polynomial_ideals;

// Divisibility and invertibility are propositions: no arbitrary quotient or
// inverse is chosen by the mathematical statement.
def PolynomialUnit(K : AlgebraicField, p : Polynomial(K)) :=
  Mere(exists u : Polynomial(K), polynomial_mul(K, p, u) = polynomial_one(K));

def polynomial_unit_prop(K : AlgebraicField, p : Polynomial(K)) :=
  mere_is_prop(exists u : Polynomial(K), polynomial_mul(K, p, u) = polynomial_one(K));

def BezoutCombination(K : AlgebraicField, p q r : Polynomial(K)) :=
  exists a : Polynomial(K), exists b : Polynomial(K),
  r = polynomial_add(K, polynomial_mul(K, a, p), polynomial_mul(K, b, q));

def GeneratedPair(K : AlgebraicField, p q r : Polynomial(K)) := Mere(BezoutCombination(K, p, q, r));

def polynomial_zero_mul(K : AlgebraicField, p : Polynomial(K)) :=
  trans(polynomial_mul_comm(K, polynomial_zero(K), p), polynomial_mul_zero(K, p));

def bezout_zero(K : AlgebraicField, p q : Polynomial(K)) :
  BezoutCombination(K, p, q, polynomial_zero(K)) {
  exact (
    polynomial_zero(K), polynomial_zero(K),
    sym(
      trans(
        cong(
          (
            fun (r : Polynomial(K)) => polynomial_add(
              K, r, polynomial_mul(K, polynomial_zero(K), q)
            )
          ), polynomial_zero_mul(K, p)
        ),
        trans(
          polynomial_add_zero(K, polynomial_mul(K, polynomial_zero(K), q)),
          polynomial_zero_mul(K, q)
        )
      )
    )
  );
}

def bezout_add(
  K : AlgebraicField, p q x y : Polynomial(K), hx : BezoutCombination(K, p, q, x),
  hy : BezoutCombination(K, p, q, y)
) :
  BezoutCombination(K, p, q, polynomial_add(K, x, y)) {
  obtain (a, b, ex) := hx;
  obtain (c, d, ey) := hy;
  let ap := polynomial_mul(K, a, p);
  let bq := polynomial_mul(K, b, q);
  let cp := polynomial_mul(K, c, p);
  let dq := polynomial_mul(K, d, q);
  exact (
    polynomial_add(K, a, c), polynomial_add(K, b, d),
    trans(
      cong((fun (z : Polynomial(K)) => polynomial_add(K, z, y)), ex),
      trans(
        cong(polynomial_add(K, polynomial_add(K, ap, bq)), ey),
        trans(
          polynomial_add_shuffle(K, ap, bq, cp, dq),
          trans(
            cong(
              (fun (z : Polynomial(K)) => polynomial_add(K, z, polynomial_add(K, bq, dq))),
              sym(polynomial_distribute_left(K, a, c, p))
            ),
            cong(
              polynomial_add(K, polynomial_mul(K, polynomial_add(K, a, c), p)),
              sym(polynomial_distribute_left(K, b, d, q))
            )
          )
        )
      )
    )
  );
}

def bezout_mul(K : AlgebraicField, p q x c : Polynomial(K), hx : BezoutCombination(K, p, q, x)) :
  BezoutCombination(K, p, q, polynomial_mul(K, c, x)) {
  obtain (a, b, ex) := hx;
  exact (
    polynomial_mul(K, c, a), polynomial_mul(K, c, b),
    trans(
      cong(polynomial_mul(K, c), ex),
      trans(
        polynomial_distribute(K, c, polynomial_mul(K, a, p), polynomial_mul(K, b, q)),
        trans(
          cong(
            (
              fun (z : Polynomial(K)) => polynomial_add(
                K, z, polynomial_mul(K, c, polynomial_mul(K, b, q))
              )
            ), sym(polynomial_mul_assoc(K, c, a, p))
          ),
          cong(
            polynomial_add(K, polynomial_mul(K, polynomial_mul(K, c, a), p)),
            sym(polynomial_mul_assoc(K, c, b, q))
          )
        )
      )
    )
  );
}

def GeneratedPairIdeal(K : AlgebraicField, p q : Polynomial(K)) : PolynomialIdeal(K) {
  let P := GeneratedPair(K, p, q);
  have add :
    forall x : Polynomial(K), forall y : Polynomial(K), P(x) -> P(y) -> P(polynomial_add(K, x, y)) {
    intro x y hx hy;
    exact mere_eliminate(
      BezoutCombination(K, p, q, x), P(polynomial_add(K, x, y)),
      mere_is_prop(BezoutCombination(K, p, q, polynomial_add(K, x, y))),
      (
        fun (a : BezoutCombination(K, p, q, x)) => mere_map(
          BezoutCombination(K, p, q, y), BezoutCombination(K, p, q, polynomial_add(K, x, y)),
          bezout_add(K, p, q, x, y, a), hy
        )
      ), hx
    );
  }
  exact (
    P, (fun (r : Polynomial(K)) => mere_is_prop(BezoutCombination(K, p, q, r))),
    merely(BezoutCombination(K, p, q, polynomial_zero(K)), bezout_zero(K, p, q)), add,
    (
      fun (c x : Polynomial(K), hx : P(x)) => mere_map(
        BezoutCombination(K, p, q, x), BezoutCombination(K, p, q, polynomial_mul(K, c, x)),
        bezout_mul(K, p, q, x, c), hx
      )
    )
  );
}

def generated_pair_left(K : AlgebraicField, p q : Polynomial(K)) : GeneratedPair(K, p, q, p) {
  exact merely(
    BezoutCombination(K, p, q, p),
    typed(
      BezoutCombination(K, p, q, p),
      (
        polynomial_one(K), polynomial_zero(K),
        sym(
          trans(
            cong(
              (
                fun (r : Polynomial(K)) => polynomial_add(
                  K, r, polynomial_mul(K, polynomial_zero(K), q)
                )
              ), polynomial_mul_one(K, p)
            ),
            trans(
              cong(polynomial_add(K, p), polynomial_zero_mul(K, q)), polynomial_add_zero_right(K, p)
            )
          )
        )
      )
    )
  );
}

def generated_pair_right(K : AlgebraicField, p q : Polynomial(K)) : GeneratedPair(K, p, q, q) {
  exact merely(
    BezoutCombination(K, p, q, q),
    typed(
      BezoutCombination(K, p, q, q),
      (
        polynomial_zero(K), polynomial_one(K),
        sym(
          trans(
            cong(
              (
                fun (r : Polynomial(K)) => polynomial_add(
                  K, r, polynomial_mul(K, polynomial_one(K), q)
                )
              ), polynomial_zero_mul(K, p)
            ),
            trans(
              polynomial_add_zero(K, polynomial_mul(K, polynomial_one(K), q)),
              polynomial_mul_one(K, q)
            )
          )
        )
      )
    )
  );
}

def PolynomialCoprime(K : AlgebraicField, p q : Polynomial(K)) :=
  forall g : Polynomial(K), PolynomialDivides(K, g, p) -> PolynomialDivides(K, g, q)
  -> PolynomialUnit(K, g);

// The principal-ideal theorem supplies the coefficients. Coprimality is only
// a condition on common divisors, not an assumed Bezout identity.
def polynomial_bezout(
  K : AlgebraicField, p q : Polynomial(K), nonzero : PolynomialNonzero(K, p),
  coprime : PolynomialCoprime(K, p, q)
) :
  GeneratedPair(K, p, q, polynomial_one(K)) {
  let I := GeneratedPairIdeal(K, p, q);
  let Result := GeneratedPair(K, p, q, polynomial_one(K));
  have fromGenerator : IdealPrincipalGenerator(K, I) -> Result {
    intro witness;
    obtain (g, member, nz, divides) := witness;
    let unit :=
      coprime(
        g, divides(p, generated_pair_left(K, p, q)), divides(q, generated_pair_right(K, p, q))
      );
    have fromInverse :
      (exists u : Polynomial(K), polynomial_mul(K, g, u) = polynomial_one(K)) -> Result {
      intro inverse;
      obtain (u, equation) := inverse;
      let ug := polynomial_mul(K, u, g);
      exact along GeneratedPair(K, p, q) by trans(polynomial_mul_comm(K, u, g), equation) from polynomial_ideal_mul(
        K, I, u, g, member
      );
    }
    exact mere_eliminate(
      (exists u : Polynomial(K), polynomial_mul(K, g, u) = polynomial_one(K)), Result,
      mere_is_prop(BezoutCombination(K, p, q, polynomial_one(K))), fromInverse, unit
    );
  }
  let inhabited :=
    merely(
      (exists g : Polynomial(K), polynomial_ideal_members(K, I, g) and PolynomialNonzero(K, g)),
      typed(
        (exists g : Polynomial(K), polynomial_ideal_members(K, I, g) and PolynomialNonzero(K, g)),
        (p, generated_pair_left(K, p, q), nonzero)
      )
    );
  exact mere_eliminate(
    IdealPrincipalGenerator(K, I), Result,
    mere_is_prop(BezoutCombination(K, p, q, polynomial_one(K))), fromGenerator,
    polynomial_ideal_principal(K, I, inhabited)
  );
}
